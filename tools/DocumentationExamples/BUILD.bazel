# Writes the documentation's ```swift blocks as tests; see main.swift.

load("//tools:swift_rules.bzl", "swift_binary")

swift_binary(
    name = "DocumentationExamples",
    srcs = ["main.swift"],
    visibility = ["//Tests:__subpackages__"],
    deps = [
        "@swiftpkg_swift_syntax//:SwiftParser",
        "@swiftpkg_swift_syntax//:SwiftSyntax",
    ],
)
