# GENERATED by scripts/modules.py — edit the table there, then run `just modules`.

load("@rules_apple//apple:macos.bzl", "macos_unit_test")
load("//tools:swift_rules.bzl", "swift_library", "swift_test")

# SystemMacros's sources as a library of the same module, for these tests to link (MACROS in
# scripts/modules.py). Its `@main` entry point is renamed, as swift_compiler_plugin renames
# the plugin's, so it doesn't clash with the test runner's.
swift_library(
    name = "SystemMacrosLibrary",
    testonly = True,
    srcs = ["//Sources/SystemMacros:srcs"],
    module_name = "SystemMacros",
    copts = [
        "-Xfrontend",
        "-entry-point-function-name",
        "-Xfrontend",
        "SystemMacros_main",
    ],
    tags = ["debug-only"],
    deps = [
        "@swiftpkg_swift_syntax//:SwiftSyntax",
        "@swiftpkg_swift_syntax//:SwiftSyntaxBuilder",
        "@swiftpkg_swift_syntax//:SwiftSyntaxMacros",
        "@swiftpkg_swift_syntax//:SwiftCompilerPlugin",
        "@swiftpkg_swift_syntax//:SwiftDiagnostics",
    ],
)

# The tests, built once and linked into two runners.
# Tagged `debug-only`: none of these relies on speed, so
# `--config=release` neither builds nor runs them (.bazelrc).
swift_library(
    name = "SystemMacrosTestsLibrary",
    testonly = True,
    # Tests are found through metadata the linker would otherwise drop, since nothing
    # references them by name.
    alwayslink = True,
    srcs = glob(["**/*.swift"]),
    module_name = "SystemMacrosTests",
    tags = ["debug-only"],
    # Read by //:package_swift_test, which checks Package.swift against the Bazel graph.
    visibility = ["//:__pkg__"],
    deps = [
        ":SystemMacrosLibrary",
        "@swiftpkg_swift_syntax//:SwiftSyntax",
        "@swiftpkg_swift_syntax//:SwiftSyntaxMacros",
        "@swiftpkg_swift_syntax//:SwiftSyntaxMacroExpansion",
        "@swiftpkg_swift_syntax//:SwiftSyntaxMacrosGenericTestSupport",
    ],
)

# `bazel test` / `just test`: a standalone executable, fast to start and run in Bazel's sandbox.
swift_test(
    name = "SystemMacrosTests",
    size = "small",
    tags = ["debug-only"],
    deps = [":SystemMacrosTestsLibrary"],
)

# The generated Xcode project: a real .xctest bundle (an MH_BUNDLE), which is what Xcode's test
# runner loads. `manual` keeps it out of `bazel test //...`; it runs through xcodebuild, so it
# is only for Xcode. XCTest refuses exit tests in a sandboxed host, hence `no-sandbox`.
macos_unit_test(
    name = "SystemMacrosTestsBundle",
    bundle_name = "SystemMacrosTests",
    size = "small",
    minimum_os_version = "15.0",
    tags = ["manual", "no-sandbox"],
    # Visible so `//:xcodeproj` can name it as a top-level target.
    visibility = ["//visibility:public"],
    deps = [":SystemMacrosTestsLibrary"],
)
