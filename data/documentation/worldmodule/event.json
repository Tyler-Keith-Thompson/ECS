{"schemaVersion":{"major":0,"patch":0,"minor":3},"abstract":[{"type":"text","text":"A type that describes a message one part of a program sends and other parts read later."}],"hierarchy":{"paths":[["doc:\/\/WorldModule\/documentation\/WorldModule"]]},"metadata":{"navigatorTitle":[{"kind":"identifier","text":"Event"}],"modules":[{"name":"WorldModule"}],"symbolKind":"protocol","title":"Event","roleHeading":"Protocol","role":"symbol","remoteSource":{"url":"https:\/\/github.com\/Tyler-Keith-Thompson\/ECS\/blob\/main\/Sources\/WorldModule\/Events.swift#L27","fileName":"Events.swift"},"fragments":[{"text":"protocol","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Event","kind":"identifier"}],"externalID":"s:11WorldModule5EventP"},"kind":"symbol","primaryContentSections":[{"kind":"declarations","declarations":[{"tokens":[{"text":"protocol","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Event","kind":"identifier"},{"text":" : ","kind":"text"},{"text":"Sendable","kind":"typeIdentifier","preciseIdentifier":"s:s8SendableP"}],"platforms":["Linux"],"languages":["swift"]}]},{"mentions":["doc:\/\/WorldModule\/documentation\/WorldModule\/ReactingToChanges"],"kind":"mentions"},{"kind":"content","content":[{"level":2,"type":"heading","text":"Overview","anchor":"overview"},{"type":"paragraph","inlineContent":[{"text":"Use events to decouple the code that notices something from the code that responds to it:","type":"text"},{"text":" ","type":"text"},{"text":"a physics step sends a collision, and separate damage and sound systems each read it. Declare","type":"text"},{"text":" ","type":"text"},{"text":"an event as a type that conforms to ","type":"text"},{"type":"codeVoice","code":"Event"},{"text":", send it with ","type":"text"},{"type":"reference","identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/World\/send(_:)","isActive":true},{"text":", and read it","type":"text"},{"text":" ","type":"text"},{"text":"with ","type":"text"},{"type":"reference","identifier":"