{"hierarchy":{"paths":[["doc:\/\/WorldModule\/documentation\/WorldModule"]]},"schemaVersion":{"major":0,"minor":3,"patch":0},"variants":[{"paths":["\/documentation\/worldmodule\/event"],"traits":[{"interfaceLanguage":"swift"}]}],"kind":"symbol","identifier":{"url":"doc:\/\/WorldModule\/documentation\/WorldModule\/Event","interfaceLanguage":"swift"},"seeAlsoSections":[{"generated":true,"anchor":"Sending-Events","identifiers":["doc:\/\/WorldModule\/documentation\/WorldModule\/Events","doc:\/\/WorldModule\/documentation\/WorldModule\/EventsView"],"title":"Sending Events"}],"metadata":{"externalID":"s:11WorldModule5EventP","fragments":[{"kind":"keyword","text":"protocol"},{"kind":"text","text":" "},{"kind":"identifier","text":"Event"}],"modules":[{"name":"WorldModule"}],"remoteSource":{"fileName":"Events.swift","url":"https:\/\/github.com\/Tyler-Keith-Thompson\/ECS\/blob\/main\/Sources\/WorldModule\/Events.swift#L27"},"roleHeading":"Protocol","title":"Event","navigatorTitle":[{"kind":"identifier","text":"Event"}],"role":"symbol","symbolKind":"protocol"},"sections":[],"relationshipsSections":[{"type":"inheritsFrom","kind":"relationships","identifiers":["doc:\/\/WorldModule\/s8SendableP","doc:\/\/WorldModule\/s16SendableMetatypeP"],"title":"Inherits From"},{"type":"conformingTypes","kind":"relationships","identifiers":["doc:\/\/WorldModule\/documentation\/WorldModule\/RemovedComponent"],"title":"Conforming Types"}],"abstract":[{"type":"text","text":"A type that describes a message one part of a program sends and other parts read later."}],"primaryContentSections":[{"kind":"declarations","declarations":[{"languages":["swift"],"tokens":[{"kind":"keyword","text":"protocol"},{"kind":"text","text":" "},{"kind":"identifier","text":"Event"},{"kind":"text","text":" : "},{"preciseIdentifier":"s:s8SendableP","kind":"typeIdentifier","text":"Sendable"}],"platforms":["Linux"]}]},{"content":[{"level":2,"text":"Overview","anchor":"overview","type":"heading"},{"inlineContent":[{"type":"text","text":"Use events to decouple the code that notices something from the code that responds to it:"},{"type":"text","text":" "},{"type":"text","text":"a physics step sends a collision, and separate damage and sound systems each read it. Declare"},{"type":"text","text":" "},{"type":"text","text":"an event as a type that conforms to "},{"type":"codeVoice","code":"Event"},{"text":", send it with ","type":"text"},{"type":"reference","identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/World\/send(_:)","isActive":true},{"text":", and read it","type":"text"},{"text":" ","type":"text"},{"text":"with ","type":"text"},{"type":"reference","identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/World\/readEvents(_:by:)","isActive":true},{"text":":","type":"text"}],"type":"paragraph"},{"syntax":"swift","code":["struct Collision: Event { var first: Entity, second: Entity }","enum DamageReader {}","","var world = World()","let ship = world.spawn(Health(current: 3))","let asteroid = world.spawn(Health(current: 1))","world.send(Collision(first: ship, second: asteroid))","","for collision in world.readEvents(Collision.self, by: DamageReader.self) {","    world[Health.self, of: collision.first].current -= 1","}","print(world[Health.self, of: ship])","\/\/ Prints \"Health(current: 2)\""],"type":"codeListing"},{"inlineContent":[{"type":"text","text":"Events wait in the world’s "},{"identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/Events","type":"reference","isActive":true},{"type":"text","text":" resource until "},{"identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/World\/updateEvents()","type":"reference","isActive":true},{"type":"text","text":" drops them,"},{"type":"text","text":" "},{"type":"text","text":"so senders and readers don’t need to run at the same moment. Unlike an "},{"identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/EntityEvent","type":"reference","isActive":true},{"type":"text","text":", an"},{"type":"text","text":" "},{"type":"text","text":"event isn’t aimed at an entity and runs no code when sent."}],"type":"paragraph"}],"kind":"content"}],"references":{"doc://WorldModule/documentation/WorldModule":{"kind":"symbol","abstract":[{"text":"Store the state of a game or simulation as entities and components, and read and change it with","type":"text"},{"text":" ","type":"text"},{"text":"queries, updates, and commands.","type":"text"}],"identifier":"doc:\/\/WorldModule\/documentation\/WorldModule","url":"\/documentation\/worldmodule","title":"WorldModule","role":"collection","type":"topic"},"doc://WorldModule/documentation/WorldModule/World/updateEvents()":{"url":"\/documentation\/worldmodule\/world\/updateevents()","type":"topic","abstract":[{"type":"text","text":"Ends an update for every event type, dropping the events sent before the previous"},{"type":"text","text":" "},{"type":"text","text":"update."}],"kind":"symbol","identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/World\/updateEvents()","title":"updateEvents()","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"updateEvents"},{"kind":"text","text":"()"}],"role":"symbol"},"doc://WorldModule/documentation/WorldModule/RemovedComponent":{"type":"topic","abstract":[{"type":"text","text":"The event a world sends when an entity loses a component of type "},{"type":"codeVoice","code":"C"},{"type":"text","text":"."}],"role":"symbol","navigatorTitle":[{"kind":"identifier","text":"RemovedComponent"}],"identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/RemovedComponent","url":"\/documentation\/worldmodule\/removedcomponent","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"RemovedComponent"}],"kind":"symbol","title":"RemovedComponent"},"doc://WorldModule/documentation/WorldModule/World/send(_:)":{"url":"\/documentation\/worldmodule\/world\/send(_:)","type":"topic","kind":"symbol","identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/World\/send(_:)","abstract":[{"type":"text","text":"Sends an event for readers of its type."}],"title":"send(_:)","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"send","kind":"identifier"},{"text":"<","kind":"text"},{"text":"E","kind":"genericParameter"},{"text":">(","kind":"text"},{"kind":"typeIdentifier","text":"E"},{"kind":"text","text":")"}],"role":"symbol"},"doc://WorldModule/documentation/WorldModule/EntityEvent":{"type":"topic","abstract":[{"type":"text","text":"A type that describes something that happens to a particular entity, which its observers"},{"type":"text","text":" "},{"type":"text","text":"respond to at once."}],"role":"symbol","navigatorTitle":[{"kind":"identifier","text":"EntityEvent"}],"identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/EntityEvent","url":"\/documentation\/worldmodule\/entityevent","fragments":[{"kind":"keyword","text":"protocol"},{"kind":"text","text":" "},{"kind":"identifier","text":"EntityEvent"}],"kind":"symbol","title":"EntityEvent"},"doc://WorldModule/documentation/WorldModule/Event":{"url":"\/documentation\/worldmodule\/event","type":"topic","navigatorTitle":[{"kind":"identifier","text":"Event"}],"kind":"symbol","identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/Event","abstract":[{"type":"text","text":"A type that describes a message one part of a program sends and other parts read later."}],"title":"Event","fragments":[{"kind":"keyword","text":"protocol"},{"kind":"text","text":" "},{"kind":"identifier","text":"Event"}],"role":"symbol"},"doc://WorldModule/documentation/WorldModule/EventsView":{"kind":"symbol","abstract":[{"text":"A collection of events of one type, oldest first.","type":"text"}],"identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/EventsView","url":"\/documentation\/worldmodule\/eventsview","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"EventsView"}],"title":"EventsView","navigatorTitle":[{"kind":"identifier","text":"EventsView"}],"role":"symbol","type":"topic"},"doc://WorldModule/s16SendableMetatypeP":{"title":"Swift.SendableMetatype","type":"unresolvable","identifier":"doc:\/\/WorldModule\/s16SendableMetatypeP"},"doc://WorldModule/s8SendableP":{"title":"Swift.Sendable","identifier":"doc:\/\/WorldModule\/s8SendableP","type":"unresolvable"},"doc://WorldModule/documentation/WorldModule/Events":{"type":"topic","abstract":[{"text":"The resource that holds a world’s events of one type.","type":"text"}],"role":"symbol","navigatorTitle":[{"text":"Events","kind":"identifier"}],"identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/Events","url":"\/documentation\/worldmodule\/events","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Events","kind":"identifier"}],"kind":"symbol","title":"Events"},"doc://WorldModule/documentation/WorldModule/World/readEvents(_:by:)":{"url":"\/documentation\/worldmodule\/world\/readevents(_:by:)","type":"topic","identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/World\/readEvents(_:by:)","kind":"symbol","abstract":[{"type":"text","text":"Returns the events of a type that a reader hasn’t read yet, oldest first, and marks them"},{"type":"text","text":" "},{"type":"text","text":"as read by that reader."}],"title":"readEvents(_:by:)","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"readEvents"},{"kind":"text","text":"<"},{"text":"E","kind":"genericParameter"},{"text":", ","kind":"text"},{"text":"Reader","kind":"genericParameter"},{"text":">(","kind":"text"},{"text":"E","kind":"typeIdentifier"},{"text":".Type, ","kind":"text"},{"text":"by","kind":"externalParam"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"Reader"},{"kind":"text","text":".Type) -> "},{"preciseIdentifier":"s:11WorldModule10EventsViewV","kind":"typeIdentifier","text":"EventsView"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","text":"E"},{"kind":"text","text":">"}],"role":"symbol"}}}