{"relationshipsSections":[{"kind":"relationships","title":"Inherits From","identifiers":["doc:\/\/WorldModule\/s8SendableP","doc:\/\/WorldModule\/s16SendableMetatypeP"],"type":"inheritsFrom"},{"kind":"relationships","title":"Conforming Types","identifiers":["doc:\/\/WorldModule\/documentation\/WorldModule\/RemovedComponent"],"type":"conformingTypes"}],"abstract":[{"type":"text","text":"A type that describes a message one part of a program sends and other parts read later."}],"metadata":{"remoteSource":{"fileName":"Events.swift","url":"https:\/\/github.com\/Tyler-Keith-Thompson\/ECS\/blob\/main\/Sources\/WorldModule\/Events.swift#L27"},"roleHeading":"Protocol","fragments":[{"text":"protocol","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Event","kind":"identifier"}],"modules":[{"name":"WorldModule"}],"externalID":"s:11WorldModule5EventP","role":"symbol","title":"Event","symbolKind":"protocol","navigatorTitle":[{"kind":"identifier","text":"Event"}]},"seeAlsoSections":[{"anchor":"Sending-Events","title":"Sending Events","identifiers":["doc:\/\/WorldModule\/documentation\/WorldModule\/Events","doc:\/\/WorldModule\/documentation\/WorldModule\/EventsView"],"generated":true}],"sections":[],"schemaVersion":{"minor":3,"major":0,"patch":0},"kind":"symbol","identifier":{"url":"doc:\/\/WorldModule\/documentation\/WorldModule\/Event","interfaceLanguage":"swift"},"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/worldmodule\/event"]}],"hierarchy":{"paths":[["doc:\/\/WorldModule\/documentation\/WorldModule"]]},"primaryContentSections":[{"kind":"declarations","declarations":[{"platforms":["Linux"],"tokens":[{"kind":"keyword","text":"protocol"},{"kind":"text","text":" "},{"kind":"identifier","text":"Event"},{"kind":"text","text":" : "},{"kind":"typeIdentifier","preciseIdentifier":"s:s8SendableP","text":"Sendable"}],"languages":["swift"]}]},{"kind":"content","content":[{"anchor":"overview","level":2,"type":"heading","text":"Overview"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Use events to decouple the code that notices something from the code that responds to it:"},{"type":"text","text":" "},{"type":"text","text":"a physics step sends a collision, and separate damage and sound systems each read it. Declare"},{"type":"text","text":" "},{"type":"text","text":"an event as a type that conforms to "},{"type":"codeVoice","code":"Event"},{"type":"text","text":", send it with "},{"identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/World\/send(_:)","isActive":true,"type":"reference"},{"type":"text","text":", and read it"},{"type":"text","text":" "},{"type":"text","text":"with "},{"identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/World\/readEvents(_:by:)","isActive":true,"type":"reference"},{"type":"text","text":":"}]},{"code":["struct Collision: Event { var first: Entity, second: Entity }","enum DamageReader {}","","var world = World()","let ship = world.spawn(Health(current: 3))","let asteroid = world.spawn(Health(current: 1))","world.send(Collision(first: ship, second: asteroid))","","for collision in world.readEvents(Collision.self, by: DamageReader.self) {","    world[Health.self, of: collision.first].current -= 1","}","print(world[Health.self, of: ship])","\/\/ Prints \"Health(current: 2)\""],"syntax":"swift","type":"codeListing"},{"type":"paragraph","inlineContent":[{"text":"Events wait in the world’s ","type":"text"},{"identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/Events","isActive":true,"type":"reference"},{"text":" resource until ","type":"text"},{"identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/World\/updateEvents()","isActive":true,"type":"reference"},{"text":" drops them,","type":"text"},{"text":" ","type":"text"},{"text":"so senders and readers don’t need to run at the same moment. Unlike an ","type":"text"},{"identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/EntityEvent","isActive":true,"type":"reference"},{"text":", an","type":"text"},{"text":" ","type":"text"},{"text":"event isn’t aimed at an entity and runs no code when sent.","type":"text"}]}]}],"references":{"doc://WorldModule/documentation/WorldModule/World/send(_:)":{"type":"topic","title":"send(_:)","role":"symbol","abstract":[{"type":"text","text":"Sends an event for readers of its type."}],"fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"send"},{"kind":"text","text":"<"},{"kind":"genericParameter","text":"E"},{"kind":"text","text":">("},{"kind":"typeIdentifier","text":"E"},{"kind":"text","text":")"}],"kind":"symbol","url":"\/documentation\/worldmodule\/world\/send(_:)","identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/World\/send(_:)"},"doc://WorldModule/documentation/WorldModule/Events":{"type":"topic","kind":"symbol","title":"Events","url":"\/documentation\/worldmodule\/events","role":"symbol","identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/Events","abstract":[{"text":"The resource that holds a world’s events of one type.","type":"text"}],"navigatorTitle":[{"text":"Events","kind":"identifier"}],"fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Events","kind":"identifier"}]},"doc://WorldModule/documentation/WorldModule/Event":{"kind":"symbol","title":"Event","fragments":[{"kind":"keyword","text":"protocol"},{"kind":"text","text":" "},{"kind":"identifier","text":"Event"}],"identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/Event","navigatorTitle":[{"kind":"identifier","text":"Event"}],"role":"symbol","abstract":[{"type":"text","text":"A type that describes a message one part of a program sends and other parts read later."}],"type":"topic","url":"\/documentation\/worldmodule\/event"},"doc://WorldModule/documentation/WorldModule/World/readEvents(_:by:)":{"type":"topic","kind":"symbol","title":"readEvents(_:by:)","url":"\/documentation\/worldmodule\/world\/readevents(_:by:)","role":"symbol","identif