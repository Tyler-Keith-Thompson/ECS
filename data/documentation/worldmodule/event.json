{"hierarchy":{"paths":[["doc:\/\/WorldModule\/documentation\/WorldModule"]]},"schemaVersion":{"minor":3,"major":0,"patch":0},"seeAlsoSections":[{"title":"Sending Events","generated":true,"identifiers":["doc:\/\/WorldModule\/documentation\/WorldModule\/Events","doc:\/\/WorldModule\/documentation\/WorldModule\/EventsView"],"anchor":"Sending-Events"}],"metadata":{"symbolKind":"protocol","roleHeading":"Protocol","externalID":"s:11WorldModule5EventP","title":"Event","fragments":[{"text":"protocol","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Event","kind":"identifier"}],"modules":[{"name":"WorldModule"}],"remoteSource":{"url":"https:\/\/github.com\/Tyler-Keith-Thompson\/ECS\/blob\/main\/Sources\/WorldModule\/Events.swift#L27","fileName":"Events.swift"},"navigatorTitle":[{"kind":"identifier","text":"Event"}],"role":"symbol"},"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/worldmodule\/event"]}],"sections":[],"kind":"symbol","identifier":{"url":"doc:\/\/WorldModule\/documentation\/WorldModule\/Event","interfaceLanguage":"swift"},"abstract":[{"type":"text","text":"A type that describes a message one part of a program sends and other parts read later."}],"primaryContentSections":[{"kind":"declarations","declarations":[{"platforms":["Linux"],"tokens":[{"kind":"keyword","text":"protocol"},{"kind":"text","text":" "},{"kind":"identifier","text":"Event"},{"kind":"text","text":" : "},{"preciseIdentifier":"s:s8SendableP","kind":"typeIdentifier","text":"Sendable"}],"languages":["swift"]}]},{"kind":"content","content":[{"level":2,"anchor":"overview","text":"Overview","type":"heading"},{"inlineContent":[{"text":"Use events to decouple the code that notices something from the code that responds to it:","type":"text"},{"text":" ","type":"text"},{"text":"a physics step sends a collision, and separate damage and sound systems each read it. Declare","type":"text"},{"text":" ","type":"text"},{"text":"an event as a type that conforms to ","type":"tex