{"sections":[],"relationshipsSections":[{"title":"Inherits From","type":"inheritsFrom","kind":"relationships","identifiers":["doc:\/\/WorldModule\/s8SendableP","doc:\/\/WorldModule\/s16SendableMetatypeP"]},{"title":"Conforming Types","type":"conformingTypes","kind":"relationships","identifiers":["doc:\/\/WorldModule\/documentation\/WorldModule\/RemovedComponent"]}],"schemaVersion":{"minor":3,"major":0,"patch":0},"abstract":[{"text":"A type that describes a message one part of a program sends and other parts read later.","type":"text"}],"metadata":{"symbolKind":"protocol","modules":[{"name":"WorldModule"}],"fragments":[{"kind":"keyword","text":"protocol"},{"kind":"text","text":" "},{"kind":"identifier","text":"Event"}],"externalID":"s:11WorldModule5EventP","title":"Event","remoteSource":{"url":"https:\/\/github.com\/Tyler-Keith-Thompson\/ECS\/blob\/main\/Sources\/WorldModule\/Events.swift#L27","fileName":"Events.swift"},"navigatorTitle":[{"text":"Event","kind":"identifier"}],"roleHeading":"Protocol","role":"symbol"},"hierarchy":{"paths":[["doc:\/\/WorldModule\/documentation\/WorldModule"]]},"kind":"symbol","seeAlsoSections":[{"anchor":"Sending-Events","title":"Sending Events","generated":true,"identifiers":["doc:\/\/WorldModule\/documentation\/WorldModule\/Events","doc:\/\/WorldModule\/documentation\/WorldModule\/EventsView"]}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/worldmodule\/event"]}],"identifier":{"url":"doc:\/\/WorldModule\/documentation\/WorldModule\/Event","interfaceLanguage":"swift"},"primaryContentSections":[{"kind":"declarations","declarations":[{"platforms":["Linux"],"languages":["swift"],"tokens":[{"kind":"keyword","text":"protocol"},{"kind":"text","text":" "},{"kind":"identifier","text":"Event"},{"kind":"text","text":" : "},{"kind":"typeIdentifier","text":"Sendable","preciseIdentifier":"s:s8SendableP"}]}]},{"content":[{"anchor":"overview","type":"heading","level":2,"text":"Overview"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Use events to decouple the code that notices something from the code that responds to it:"},{"type":"text","text":" "},{"type":"text","text":"a physics step sends a collision, and separate damage and sound systems each read it. Declare"},{"type":"text","text":" "},{"type":"text","text":"an event as a type that conforms to "},{"type":"codeVoice","code":"Event"},{"type":"text","text":", send it with "},{"type":"reference","isActive":true,"identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/World\/send(_:)"},{"type":"text","text":", and read it"},{"type":"text","text":" "},{"type":"text","text":"with "},{"type":"reference","isActive":true,"identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/World\/readEvents(_:by:)"},{"type":"text","text":":"}]},{"syntax":"swift","type":"codeListing","code":["struct Collision: Event { var first: Entity, second: Entity }","enum DamageReader {}","","var world = World()","let ship = world.spawn(Health(current: 3))","let asteroid = world.spawn(Health(current: 1))","world.send(Collision(first: ship, second: asteroid))","","for collision in world.readEvents(Collision.self, by: DamageReader.self) {","    world[Health.self, of: collision.first].current -= 1","}","print(world[Health.self, of: ship])","\/\/ Prints \"Health(current: 2)\""]},{"type":"paragraph","inlineContent":[{"text":"Events wait in the world’s ","type":"text"},{"identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/Events","type":"reference","isActive":true},{"text":" resource until ","type":"text"},{"identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/World\/updateEvents()","type":"reference","isActive":true},{"text":" drops them,","type":"text"},{"text":" ","type":"text"},{"text":"so senders and readers don’t need to run at the same moment. Unlike an ","type":"text"},{"identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/EntityEvent","type":"reference","isActive":true},{"text":", an","type":"text"},{"text":" ","type":"text"},{"text":"event isn’t aimed at an entity and runs no code when sent.","type":"text"}]}],"kind":"content"}],"references":{"doc://WorldModule/documentation/WorldModule/Events":{"title":"Events","type":"topic","url":"\/documentation\/worldmodule\/events","identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/Events","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"Events"}],"abstract":[{"text":"The resource that holds a world’s events of one type.","type":"text"}],"role":"symbol","navigatorTitle":[{"kind":"identifier","text":"Events"}],"kind":"symbol"},"doc://WorldModule/documentation/WorldModule/World/updateEvents()":{"title":"updateEvents()","role":"symbol","identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/World\/updateEvents()","kind":"symbol","url":"\/documentation\/worldmodule\/world\/updateevents()","abstract":[{"type":"text","text":"Ends an update for every event type, dropping the events sent before the previous"},{"type":"text","text":" "},{"type":"text","text":"update."}],"fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"updateEvents","kind":"identifier"},{"text":"()","kind":"text"}],"type":"topic"},"doc://WorldModule/s8SendableP":{"type":"unresolvable","title":"Swift.Sendable","identifier":"doc:\/\/WorldModule\/s8SendableP"},"doc://WorldModule/s16SendableMetatypeP":{"type":"unresolvable","identifier":"doc:\/\/WorldModule\/s16SendableMetatypeP","title":"Swift.SendableMetatype"},"doc://WorldModule/documentation/WorldModule":{"abstract":[{"type":"text","text":"Store the state of a game or simulation as entities and components, and read and change it with"},{"type":"text","text":" "},{"type":"text","text":"queries, updates, and commands."}],"role":"collection","identifier":"doc:\/\/WorldModule\/documentation\/WorldModule","url":"\/documentation\/worldmodule","title":"WorldModule","kind":"symbol","type":"topic"},"doc://WorldModule/documentation/WorldModule/RemovedComponent":{"type":"topic","url":"\/documentation\/worldmodule\/removedcomponent","role":"symbol","kind":"symbol","title":"RemovedComponent","abstract":[{"type":"text","text":"The event a world sends when an entity loses a component of type "},{"type":"codeVoice","code":"C"},{"type":"text","text":"."}],"fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"RemovedComponent","kind":"identifier"}],"identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/RemovedComponent","navigatorTitle":[{"text":"RemovedComponent","kind":"identifier"}]},"doc://WorldModule/documentation/WorldModule/EventsView":{"title":"EventsView","role":"symbol","kind":"symbol","identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/EventsView","navigatorTitle":[{"kind":"identifier","text":"EventsView"}],"url":"\/documentation\/worldmodule\/eventsview","abstract":[{"type":"text","text":"A collection of events of one type, oldest first."}],"fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"EventsView"}],"type":"topic"},"doc://WorldModule/documentation/WorldModule/World/readEvents(_:by:)":{"fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"readEvents"},{"kind":"text","text":"<"},{"text":"E","kind":"genericParameter"},{"text":", ","kind":"text"},{"text":"Reader","kind":"genericParameter"},{"text":">(","kind":"text"},{"text":"E","kind":"typeIdentifier"},{"text":".Type, ","kind":"text"},{"text":"by","kind":"externalParam"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"Reader"},{"kind":"text","text":".Type) -> "},{"preciseIdentifier":"s:11WorldModule10EventsViewV","kind":"typeIdentifier","text":"EventsView"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","text":"E"},{"kind":"text","text":">"}],"abstract":[{"text":"Returns the events of a type that a reader hasn’t read yet, oldest first, and marks them","type":"text"},{"text":" ","type":"text"},{"text":"as read by that reader.","type":"text"}],"role":"symbol","identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/World\/readEvents(_:by:)","url":"\/documentation\/worldmodule\/world\/readevents(_:by:)","title":"readEvents(_:by:)","kind":"symbol","type":"topic"},"doc://WorldModule/documentation/WorldModule/World/send(_:)":{"role":"symbol","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"send","kind":"identifier"},{"text":"<","kind":"text"},{"text":"E","kind":"genericParameter"},{"text":">(","kind":"text"},{"text":"E","kind":"typeIdentifier"},{"text":")","kind":"text"}],"kind":"symbol","type":"topic","identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/World\/send(_:)","title":"send(_:)","url":"\/documentation\/worldmodule\/world\/send(_:)","abstract":[{"text":"Sends an event for readers of its type.","type":"text"}]},"doc://WorldModule/documentation/WorldModule/EntityEvent":{"role":"symbol","fragments":[{"kind":"keyword","text":"protocol"},{"kind":"text","text":" "},{"kind":"identifier","text":"EntityEvent"}],"kind":"symbol","type":"topic","identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/EntityEvent","title":"EntityEvent","navigatorTitle":[{"kind":"identifier","text":"EntityEvent"}],"url":"\/documentation\/worldmodule\/entityevent","abstract":[{"type":"text","text":"A type that describes something that happens to a particular entity, which its observers"},{"type":"text","text":" "},{"type":"text","text":"respond to at once."}]},"doc://WorldModule/documentation/WorldModule/Event":{"title":"Event","role":"symbol","identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/Event","kind":"symbol","navigatorTitle":[{"kind":"identifier","text":"Event"}],"url":"\/documentation\/worldmodule\/event","abstract":[{"type":"text","text":"A type that describes a message one part of a program sends and other parts read later."}],"fragments":[{"kind":"keyword","text":"prot