{"variants":[{"paths":["\/documentation\/worldmodule\/event"],"traits":[{"interfaceLanguage":"swift"}]}],"seeAlsoSections":[{"generated":true,"title":"Sending Events","anchor":"Sending-Events","identifiers":["doc:\/\/WorldModule\/documentation\/WorldModule\/Events","doc:\/\/WorldModule\/documentation\/WorldModule\/EventsView"]}],"sections":[],"schemaVersion":{"major":0,"patch":0,"minor":3},"primaryContentSections":[{"kind":"declarations","declarations":[{"tokens":[{"text":"protocol","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Event","kind":"identifier"},{"text":" : ","kind":"text"},{"text":"Sendable","preciseIdentifier":"s:s8SendableP","kind":"typeIdentifier"}],"languages":["swift"],"platforms":["Linux"]}]},{"content":[{"type":"heading","text":"Overview","level":2,"anchor":"overview"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Use events to decouple the code that notices something from the code that responds to it:"},{"type":"text","text":" "},{"type":"text","text":"a physics step sends a collision, and separate damage and sound systems each read it. Declare"},{"type":"text","text":" "},{"type":"text","text":"an event as a type that conforms to "},{"type":"codeVoice","code":"Event"},{"type":"text","text":", send it with "},{"identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/World\/send(_:)","type":"reference","isActive":true},{"type":"text","text":", and read it"},{"type":"text","text":" "},{"type":"text","text":"with "},{"identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/World\/readEvents(_:by:)","type":"reference","isActive":true},{"type":"text","text":":"}]},{"type":"codeListing","syntax":"swift","code":["struct Collision: Event { var first: Entity, second: Entity }","enum DamageReader {}","","var world = World()","let ship = world.spawn(Health(current: 3))","let asteroid = world.spawn(Health(current: 1))","world.send(Collision(first: ship, second: asteroid))","","for collision in world.readEvents(Collision.self, by: DamageReader.self) {","    world[Health.self, of: collision.first].current -= 1","}","print(world[Health.self, of: ship])","\/\/ Prints \"Health(current: 2)\""]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Events wait in the world’s "},{"identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/Events","type":"reference","isActive":true},{"type":"text","text":" resource until "},{"identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/World\/updateEvents()","type":"reference","isActive":true},{"type":"text","text":" drops them,"},{"type":"text","text":" "},{"type":"text","text":"so senders and readers don’t need to run at the same moment. Unlike an "},{"identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/EntityEvent","type":"reference","isActive":true},{"type":"text","text":", an"},{"type":"text","text":" "},{"type":"text","text":"event isn’t aimed at an entity and runs no code when sent."}]}],"kind":"content"}],"hierarchy":{"paths":[["doc:\/\/WorldModule\/documentation\/WorldModule"]]},"kind":"symbol","abstract":[{"text":"A type that describes a message one part of a program sends and other parts read later.","type":"text"}],"relationshipsSections":[{"type":"inheritsFrom","kind":"relationships","title":"Inherits From","identifiers":["doc:\/\/WorldModule\/s8SendableP","doc:\/\/WorldModule\/s16SendableMetatypeP"]},{"type":"conformingTypes","kind":"relationships","title":"Conforming Types","identifiers":["doc:\/\/WorldModule\/documentation\/WorldModule\/RemovedComponent"]}],"metadata":{"navigatorTitle":[{"kind":"identifier","text":"Event"}],"remoteSource":{"fileName":"Events.swift","url":"https:\/\/github.com\/Tyler-Keith-Thompson\/ECS\/blob\/main\/Sources\/WorldModule\/Events.swift#L27"},"externalID":"s:11WorldModule5EventP","modules":[{"name":"WorldModule"}],"roleHeading":"Protocol","fragments":[{"text":"protocol","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Event","kind":"identifier"}],"role":"symbol","title":"Event","symbolKind":"protocol"},"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/WorldModule\/documentation\/WorldModule\/Event"},"references":{"doc://WorldModule/s16SendableMetatypeP":{"title":"Swift.SendableMetatype","type":"unresolvable","identifier":"doc:\/\/WorldModule\/s16SendableMetatypeP"},"doc://WorldModule/documentation/WorldModule/EventsView":{"kind":"symbol","type":"topic","title":"EventsView","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"EventsView","kind":"identifier"}],"url":"\/documentation\/worldmodule\/eventsview","abstract":[{"type":"text","text":"A collection of events of one type, oldest first."}],"role":"symbol","navigatorTitle":[{"text":"EventsView","kind":"identifier"}],"identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/EventsView"},"doc://WorldModule/documentation/WorldModule/EntityEvent":{"type":"topic","role":"symbol","abstract":[{"type":"text","text":"A type that describes something that happens to a particular entity, which its observers"},{"type":"text","text":" "},{"type":"text","text":"respond to at once."}],"fragments":[{"kind":"keyword","text":"protocol"},{"kind":"text","text":" "},{"kind":"identifier","text":"EntityEvent"}],"navigatorTitle":[{"kind":"identifier","text":"EntityEvent"}],"kind":"symbol","title":"EntityEvent","url":"\/documentation\/worldmodule\/entityevent","identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/EntityEvent"},"doc://WorldModule/documentation/WorldModule/World/send(_:)":{"title":"send(_:)","url":"\/documentation\/worldmodule\/world\/send(_:)","role":"symbol","abstract":[{"text":"Sends an event for readers of its type.","type":"text"}],"fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"send"},{"kind":"text","text":"<"},{"kind":"genericParameter","text":"E"},{"kind":"text","text":">("},{"kind":"typeIdentifier","text":"E"},{"kind":"text","text":")"}],"identifier":"doc:\/\/WorldModule\/documentat