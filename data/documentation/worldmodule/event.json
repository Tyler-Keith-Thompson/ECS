{"abstract":[{"type":"text","text":"A type that describes a message one part of a program sends and other parts read later."}],"primaryContentSections":[{"declarations":[{"tokens":[{"kind":"keyword","text":"protocol"},{"kind":"text","text":" "},{"kind":"identifier","text":"Event"},{"kind":"text","text":" : "},{"kind":"typeIdentifier","text":"Sendable","preciseIdentifier":"s:s8SendableP"}],"platforms":["Linux"],"languages":["swift"]}],"kind":"declarations"},{"kind":"content","content":[{"type":"heading","text":"Overview","anchor":"overview","level":2},{"type":"paragraph","inlineContent":[{"text":"Use events to decouple the code that notices something from the code that responds to it:","type":"text"},{"text":" ","type":"text"},{"text":"a physics step sends a collision, and separate damage and sound systems each read it. Declare","type":"text"},{"text":" ","type":"text"},{"text":"an event as a type that conforms to ","type":"text"},{"code":"Event","type":"codeVoice"},{"type":"text","text":", send it with "},{"type":"reference","isActive":true,"identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/World\/send(_:)"},{"type":"text","text":", and read it"},{"type":"text","text":" "},{"type":"text","text":"with "},{"type":"reference","isActive":true,"identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/World\/readEvents(_:by:)"},{"type":"text","text":":"}]},{"type":"codeListing","syntax":"swift","code":["struct Collision: Event { var first: Entity, second: Entity }","enum DamageReader {}","","var world = World()","let ship = world.spawn(Health(current: 3))","let asteroid = world.spawn(Health(current: 1))","world.send(Collision(first: ship, second: asteroid))","","for collision in world.readEvents(Collision.self, by: DamageReader.self) {","    world[Health.self, of: collision.first].current -= 1","}","print(world[Health.self, of: ship])","\/\/ Prints \"Health(current: 2)\""]},{"type":"paragraph","inlineContent":[{"text":"Events wait in the world’s ","type":"text"},{"identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/Events","isActive":true,"type":"reference"},{"text":" resource until ","type":"text"},{"identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/World\/updateEvents()","isActive":true,"type":"reference"},{"text":" drops them,","type":"text"},{"type":"text","text":" "},{"type":"text","text":"so senders and readers don’t need to run at the same moment. Unlike an "},{"type":"reference","identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/EntityEvent","isActive":true},{"type":"text","text":", an"},{"type":"text","text":" "},{"type":"text","text":"event isn’t aimed at an entity and runs no code when sent."}]}]}],"schemaVersion":{"patch":0,"minor":3,"major":0},"identifier":{"url":"doc:\/\/WorldModule\/documentation\/WorldModule\/Event","interfaceLanguage":"swift"},"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/worldmodule\/event"]}],"hierarchy":{"paths":[["doc:\/\/WorldModule\/documentation\/WorldModule"]]},"seeAlsoSections":[{"identifiers":["doc:\/\/WorldModule\/documentation\/WorldModule\/Events","doc:\/\/WorldModule\/documentation\/WorldModule\/EventsView"],"anchor":"Sending-Events","generated":true,"title":"Sending Events"}],"kind":"symbol","sections":[],"metadata":{"remoteSource":{"fileName":"Events.swift","url":"https:\/\/github.com\/Tyler-Keith-Thompson\/ECS\/blob\/main\/Sources\/WorldModule\/Events.swift#L27"},"symbolKind":"protocol","modules":[{"name":"WorldModule"}],"role":"symbol","roleHeading":"Protocol","fragments":[{"text":"protocol","kind":"keyword"},{"text":" ","kind":"text"},{"kind":"identifier","text":"Event"}],"externalID":"s:11WorldModule5EventP","title":"Event","navigatorTitle":[{"kind":"identifier","text":"Event"}]},"relationshipsSections":[{"kind":"relationships","identifiers":["doc:\/\/WorldModule\/s8SendableP","doc:\/\/WorldModule\/s16SendableMetatypeP"],"type":"inheritsFrom","title":"Inherits From"},{"kind":"relationships","ide