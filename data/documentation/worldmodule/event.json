{"kind":"symbol","metadata":{"remoteSource":{"url":"https:\/\/github.com\/Tyler-Keith-Thompson\/ECS\/blob\/main\/Sources\/WorldModule\/Events.swift#L27","fileName":"Events.swift"},"externalID":"s:11WorldModule5EventP","fragments":[{"kind":"keyword","text":"protocol"},{"kind":"text","text":" "},{"text":"Event","kind":"identifier"}],"role":"symbol","modules":[{"name":"WorldModule"}],"roleHeading":"Protocol","symbolKind":"protocol","title":"Event","navigatorTitle":[{"text":"Event","kind":"identifier"}]},"hierarchy":{"paths":[["doc:\/\/WorldModule\/documentation\/WorldModule"]]},"primaryContentSections":[{"kind":"declarations","declarations":[{"tokens":[{"kind":"keyword","text":"protocol"},{"kind":"text","text":" "},{"kind":"identifier","text":"Event"},{"kind":"text","text":" : "},{"kind":"typeIdentifier","text":"Sendable","preciseIdentifier":"s:s8SendableP"}],"platforms":["Linux"],"languages":["swift"]}]},{"kind":"content","content":[{"text":"Overview","level":2,"anchor":"overview","type":"heading"},{"type":"paragraph","inlineContent":[{"text":"Use events to decouple the code that notices something from the code that responds to it:","type":"text"},{"text":" ","type":"text"},{"text":"a physics step sends a collision, and separate damage and sound systems each read it. Declare","type":"text"},{"text":" ","type":"text"},{"text":"an event as a type that conforms to ","type":"text"},{"code":"Event","type":"codeVoice"},{"type":"text","text":", send it with "},{"type":"reference","identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/World\/send(_:)","isActive":true},{"type":"text","text":", and read it"},{"type":"text","text":" "},{"type":"text","text":"with "},{"type":"reference","identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/World\/readEvents(_:by:)","isActive":true},{"type":"text","text":":"}]},{"type":"codeListing","code":["struct Collision: Event { var first: Entity, second: Entity }","enum DamageReader {}","","var world = World()","let ship = world.spawn(Health(current: 3))","let asteroid = world.spawn(Health(current: 1))","world.send(Collision(first: ship, second: asteroid))","","for collision in world.readEvents(Collision.self, by: DamageReader.self) {","    world[Health.self, of: collision.first].current -= 1","}","print(world[Health.self, of: ship])","\/\/ Prints \"Health(current: 2)\""],"syntax":"swift"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Events wait in the world’s "},{"isActive":true,"identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/Events","type":"reference"},{"type":"text","text":" resource until "},{"isActive":true,"identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/World\/updateEvents()","type":"reference"},{"type":"text","text":" drops them,"},{"type":"text","text":" "},{"type":"text","text":"so senders and readers don’t need to run at the same moment. Unlike an "},{"isActive":true,"identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/EntityEvent","type":"reference"},{"type":"text","text":", an"},{"type":"text","text":" "},{"type":"text","text":"event isn’t aimed at an entity and runs no code when sent."}]}]}],"variants":[{"paths":["\/documentation\/worldmodule\/event"],"traits":[{"interfaceLanguage":"swift"}]}],"relationshipsSections":[{"title":"Inherits From","kind":"relationships","identifiers":["doc:\/\/WorldModule\/s8SendableP","doc:\/\/WorldModule\/s16SendableMetatypeP"],"type":"inheritsFrom"},{"title":"Conforming Types","kind":"relationships","identifiers":["doc:\/\/WorldModule\/documentation\/WorldModule\/RemovedComponent"],"type":"conformingTypes"}],"schemaVersion":{"minor":3,"major":0,"patch":0},"abstract":[{"text":"A type that describes a message one part of a program sends and other parts read later.","type":"text"}],"seeAlsoSections":[{"generated":true,"title":"Sending Events","identifiers":["doc:\/\/WorldModule\/documentation\/WorldModule\/Events","doc:\/\/WorldModule\/documentation\/WorldModule\/EventsView"],"anchor":"Send