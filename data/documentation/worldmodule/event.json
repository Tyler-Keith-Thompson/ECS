{"abstract":[{"text":"A type that describes a message one part of a program sends and other parts read later.","type":"text"}],"hierarchy":{"paths":[["doc:\/\/WorldModule\/documentation\/WorldModule"]]},"relationshipsSections":[{"kind":"relationships","identifiers":["doc:\/\/WorldModule\/s8SendableP","doc:\/\/WorldModule\/s16SendableMetatypeP"],"title":"Inherits From","type":"inheritsFrom"},{"kind":"relationships","identifiers":["doc:\/\/WorldModule\/documentation\/WorldModule\/RemovedComponent"],"title":"Conforming Types","type":"conformingTypes"}],"seeAlsoSections":[{"identifiers":["doc:\/\/WorldModule\/documentation\/WorldModule\/Events","doc:\/\/WorldModule\/documentation\/WorldModule\/EventsView"],"generated":true,"title":"Sending Events","anchor":"Sending-Events"}],"schemaVersion":{"minor":3,"major":0,"patch":0},"kind":"symbol","primaryContentSections":[{"kind":"declarations","declarations":[{"tokens":[{"text":"protocol","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Event","kind":"identifier"},{"text":" : ","kind":"text"},{"text":"Sendable","preciseIdentifier":"s:s8SendableP","kind":"typeIdentifier"}],"platforms":["Linux"],"languages":["swift"]}]},{"kind":"mentions","mentions":["doc:\/\/WorldModule\/documentation\/WorldModule\/ReactingToChanges"]},{"kind":"content","content":[{"anchor":"overview","type":"heading","level":2,"text":"Overview"},{"inlineContent":[{"type":"text","text":"Use events to decouple the code that notices something from the code that responds to it:"},{"type":"text","text":" "},{"type":"text","text":"a physics step sends a collision, and separate damage and sound systems each read it. Declare"},{"type":"text","text":" "},{"type":"text","text":"an event as a type that conforms to "},{"type":"codeVoice","code":"Event"},{"text":", send it with ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/World\/send(_:)"},{"text":", and read it","type":"text"},{"text":" ","type":"text"},{"text":"with ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/World\/readEvents(_:by:)"},{"text":":","type":"text"}],"type":"paragraph"},{"code":["struct Collision: Event { var first: Entity, second: Entity }","enum DamageReader {}","","var world = World()","let ship = world.spawn(Health(current: 3))","let asteroid = world.spawn(Health(current: 1))","world.send(Collision(first: ship, second: asteroid))","","for collision in world.readEvents(Collision.self, by: DamageReader.self) {","    world[Health.self, of: collision.first].current -= 1","}","print(world[Health.self, of: ship])","\/\/ Prints \"Health(current: 2)\""],"type":"codeListing","syntax":"swift"},{"inlineContent":[{"type":"text","text":"Events wait in the world’s "},{"type":"reference","isActive":true,"identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/Events"},{"type":"text","text":" resource until "},{"type":"reference","isActive":true,"identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/World\/updateEvents()"},{"type":"text","text":" drops them,"},{"text":" ","type":"text"},{"text":"so senders and readers don’t need to run at the same moment. Unlike an ","type":"text"},{"identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/EntityEvent","type":"reference","isActive":true},{"text":", an","type":"text"},{"text":" ","type":"text"},{"text":"event isn’t aimed at an entity and runs no code when sent.","type":"text"}],"type":"paragraph"}]}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/worldmodule\/event"]}],"identifier":{"url":"doc:\/\/WorldModule\/documentation\/WorldModule\/Event","interfaceLanguage":"swift"},"metadata":{"modules":[{"name":"WorldModule"}],"roleHeading":"Protocol","role":"symbol","remoteSource":{"url":"https:\/\/github.com\/Tyler-Keith-Thompson\/ECS\/blob\/main\/Sources\/WorldModule\/Events.swift#L27","fileName":"Events.swift"},"symbolKind":"protocol","fra