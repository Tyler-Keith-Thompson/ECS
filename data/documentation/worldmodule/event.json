{"sections":[],"seeAlsoSections":[{"anchor":"Sending-Events","title":"Sending Events","identifiers":["doc:\/\/WorldModule\/documentation\/WorldModule\/Events","doc:\/\/WorldModule\/documentation\/WorldModule\/EventsView"],"generated":true}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/worldmodule\/event"]}],"primaryContentSections":[{"kind":"declarations","declarations":[{"tokens":[{"kind":"keyword","text":"protocol"},{"kind":"text","text":" "},{"kind":"identifier","text":"Event"},{"kind":"text","text":" : "},{"preciseIdentifier":"s:s8SendableP","kind":"typeIdentifier","text":"Sendable"}],"languages":["swift"],"platforms":["Linux"]}]},{"kind":"content","content":[{"type":"heading","level":2,"text":"Overview","anchor":"overview"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Use events to decouple the code that notices something from the code that responds to it:"},{"type":"text","text":" "},{"type":"text","text":"a physics step sends a collision, and separate damage and sound systems each read it. Declare"},{"type":"text","text":" "},{"type":"text","text":"an event as a type that conforms to "},{"type":"codeVoice","code":"Event"},{"text":", send it with ","type":"text"},{"identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/World\/send(_:)","isActive":true,"type":"reference"},{"text":", and read it","type":"text"},{"text":" ","type":"text"},{"text":"with ","type":"text"},{"identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/World\/readEvents(_:by:)","isActive":true,"type":"reference"},{"text":":","type":"text"}]},{"type":"codeListing","syntax":"swift","code":["struct Collision: Event { var first: Entity, second: Entity }","enum DamageReader {}","","var world = World()","let ship = world.spawn(Health(current: 3))","let asteroid = world.spawn(Health(current: 1))","world.send(Collision(first: ship, second: asteroid))","","for collision in world.readEvents(Collision.self, by: DamageReader.self) {","    world[Health.self, of: collision.first].current -= 1","}","print(world[Health.self, of: ship])","\/\/ Prints \"Health(current: 2)\""]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Events wait in the world’s "},{"type":"reference","identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/Events","isActive":true},{"type":"text","text":" resource until "},{"type":"reference","identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/World\/updateEvents()","isActive":true},{"type":"text","text":" drops them,"},{"type":"text","text":" "},{"type":"text","text":"so senders and readers don’t need to run at the same moment. Unlike an "},{"identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/EntityEvent","type":"reference","isActive":true},{"type":"text","text":", an"},{"type":"text","text":" "},{"type":"text","text":"event isn’t aimed at an entity and runs no code when sent."}]}]}],"schemaVersion":{"minor":3,"patch":0,"major":0},"kind":"symbol","metadata":{"role":"symbol","symbolKind":"protocol","modules":[{"name":"WorldModule"}],"title":"Event","roleHeading":"Protocol","fragments":[{"kind":"keyword","text":"protocol"},{"kind":"text","text":" "},{"kind":"identifier","text":"Event"}],"externalID":"s:11WorldModule5EventP","navigatorTitle":[{"kind":"identifier","text":"Event"}],"remoteSource":{"url":"https:\/\/github.com\/Tyler-Keith-Thompson\/ECS\/blob\/main\/Sources\/WorldModule\/Events.swift#L27","fileName":"Events.swift"}},"identifier":{"url":"doc:\/\/WorldModule\/documentation\/WorldModule\/Event","interfaceLanguage":"swift"},"hierarchy":{"paths":[["doc:\/\/WorldModule\/documentation\/WorldModule"]]},"relationshipsSections":[{"kind":"relationships","title":"Inherits From","identifiers":["doc:\/\/WorldModule\/s8SendableP","doc:\/\/WorldModule\/s16SendableMetatypeP"],"type":"inheritsFrom"},{"kind":"relationships","title":"Conforming Types","identifiers":["doc:\/\/WorldModule\/documentation\/WorldModule\/RemovedComponent"],"type":"conformingT