{"abstract":[{"text":"A type that describes a message one part of a program sends and other parts read later.","type":"text"}],"relationshipsSections":[{"kind":"relationships","type":"inheritsFrom","title":"Inherits From","identifiers":["doc:\/\/WorldModule\/s8SendableP","doc:\/\/WorldModule\/s16SendableMetatypeP"]},{"kind":"relationships","type":"conformingTypes","title":"Conforming Types","identifiers":["doc:\/\/WorldModule\/documentation\/WorldModule\/RemovedComponent"]}],"sections":[],"seeAlsoSections":[{"generated":true,"anchor":"Sending-Events","title":"Sending Events","identifiers":["doc:\/\/WorldModule\/documentation\/WorldModule\/Events","doc:\/\/WorldModule\/documentation\/WorldModule\/EventsView"]}],"primaryContentSections":[{"kind":"declarations","declarations":[{"languages":["swift"],"platforms":["Linux"],"tokens":[{"kind":"keyword","text":"protocol"},{"kind":"text","text":" "},{"kind":"identifier","text":"Event"},{"kind":"text","text":" : "},{"preciseIdentifier":"s:s8SendableP","kind":"typeIdentifier","text":"Sendable"}]}]},{"kind":"content","content":[{"text":"Overview","type":"heading","anchor":"overview","level":2},{"inlineContent":[{"type":"text","text":"Use events to decouple the code that notices something from the code that responds to it:"},{"type":"text","text":" "},{"type":"text","text":"a physics step sends a collision, and separate damage and sound systems each read it. Declare"},{"type":"text","text":" "},{"type":"text","text":"an event as a type that conforms to "},{"type":"codeVoice","code":"Event"},{"type":"text","text":", send it with "},{"type":"reference","identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/World\/send(_:)","isActive":true},{"type":"text","text":", and read it"},{"type":"text","text":" "},{"type":"text","text":"with "},{"type":"reference","identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/World\/readEvents(_:by:)","isActive":true},{"type":"text","text":":"}],"type":"paragraph"},{"code":["struct Collision: Event { var first: Entity, second: Entity }","enum DamageReader {}","","var world = World()","let ship = world.spawn(Health(current: 3))","let asteroid = world.spawn(Health(current: 1))","world.send(Collision(first: ship, second: asteroid))","","for collision in world.readEvents(Collision.self, by: DamageReader.self) {","    world[Health.self, of: collision.first].current -= 1","}","print(world[Health.self, of: ship])","\/\/ Prints \"Health(current: 2)\""],"syntax":"swift","type":"codeListing"},{"inlineContent":[{"type":"text","text":"Events wait in the world’s "},{"identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/Events","isActive":true,"type":"reference"},{"text":" resource until ","type":"text"},{"identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/World\/updateEvents()","isActive":true,"type":"reference"},{"text":" drops them,","type":"text"},{"text":" ","type":"text"},{"text":"so senders and readers don’t need to run at the same moment. Unlike an ","type":"text"},{"identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/EntityEvent","isActive":true,"type":"reference"},{"text":", an","type":"text"},{"text":" ","type":"text"},{"text":"event isn’t aimed at an entity and runs no code when sent.","type":"text"}],"type":"paragraph"}]}],"kind":"symbol","hierarchy":{"paths":[["doc:\/\/WorldModule\/documentation\/WorldModule"]]},"identifier":{"url":"doc:\/\/WorldModule\/documentation\/WorldModule\/Event","interfaceLanguage":"swift"},"schemaVersion":{"minor":3,"major":0,"patch":0},"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/worldmodule\/event"]}],"metadata":{"title":"Event","modules":[{"name":"WorldModule"}],"symbolKind":"protocol","externalID":"s:11WorldModule5EventP","fragments":[{"kind":"keyword","text":"protocol"},{"kind":"text","text":" "},{"kind":"identifier","text":"Event"}],"remoteSource":{"fileName":"Events.swift","url":"https:\/\/github.com\/Tyler-Keith-Thompson\/ECS\/blob\/main\/Sourc