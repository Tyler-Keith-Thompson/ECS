n of events of one type, oldest first."}],"fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"EventsView","kind":"identifier"}]},"doc://WorldModule/documentation/WorldModule/World/readEvents(_:by:)":{"title":"readEvents(_:by:)","abstract":[{"type":"text","text":"Returns the events of a type that a reader hasn’t read yet, oldest first, and marks them"},{"type":"text","text":" "},{"type":"text","text":"as read by that reader."}],"fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"readEvents","kind":"identifier"},{"text":"<","kind":"text"},{"text":"E","kind":"genericParameter"},{"text":", ","kind":"text"},{"text":"Reader","kind":"genericParameter"},{"text":">(","kind":"text"},{"text":"E","kind":"typeIdentifier"},{"text":".Type, ","kind":"text"},{"text":"by","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"Reader","kind":"typeIdentifier"},{"text":".Type) -> ","kind":"text"},{"preciseIdentifier":"s:11WorldModule10EventsViewV","text":"EventsView","kind":"typeIdentifier"},{"text":"<","kind":"text"},{"text":"E","kind":"typeIdentifier"},{"text":">","kind":"text"}],"role":"symbol","url":"\/documentation\/worldmodule\/world\/readevents(_:by:)","kind":"symbol","type":"topic","identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/World\/readEvents(_:by:)"},"doc://WorldModule/s8SendableP":{"title":"Swift.Sendable","identifier":"doc:\/\/WorldModule\/s8SendableP","type":"unresolvable"},"doc://WorldModule/documentation/WorldModule/World/updateEvents()":{"title":"updateEvents()","abstract":[{"type":"text","text":"Ends an update for every event type, dropping the events sent before the previous"},{"type":"text","text":" "},{"type":"text","text":"update."}],"fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"updateEvents"},{"kind":"text","text":"()"}],"role":"symbol","url":"\/documentation\/worldmodule\/world\/updateevents()","kind":"symbol","type":"topic"