{"topicSections":[{"identifiers":["doc:\/\/WorldModule\/documentation\/WorldModule\/QueryView\/Iterator"],"title":"Structures","anchor":"Structures","generated":true},{"identifiers":["doc:\/\/WorldModule\/documentation\/WorldModule\/QueryView\/count","doc:\/\/WorldModule\/documentation\/WorldModule\/QueryView\/filter","doc:\/\/WorldModule\/documentation\/WorldModule\/QueryView\/first"],"title":"Instance Properties","anchor":"Instance-Properties","generated":true},{"identifiers":["doc:\/\/WorldModule\/documentation\/WorldModule\/QueryView\/added(_:since:)","doc:\/\/WorldModule\/documentation\/WorldModule\/QueryView\/allowing(_:)","doc:\/\/WorldModule\/documentation\/WorldModule\/QueryView\/anyOf(_:)","doc:\/\/WorldModule\/documentation\/WorldModule\/QueryView\/changed(_:since:)","doc:\/\/WorldModule\/documentation\/WorldModule\/QueryView\/filtered(by:)","doc:\/\/WorldModule\/documentation\/WorldModule\/QueryView\/makeIterator()","doc:\/\/WorldModule\/documentation\/WorldModule\/QueryView\/related(_:to:)","doc:\/\/WorldModule\/documentation\/WorldModule\/QueryView\/with(_:)","doc:\/\/WorldModule\/documentation\/WorldModule\/QueryView\/without(_:)"],"title":"Instance Methods","anchor":"Instance-Methods","generated":true},{"identifiers":["doc:\/\/WorldModule\/documentation\/WorldModule\/QueryView\/Sequence-Implementations"],"title":"Default Implementations","anchor":"Default-Implementations","generated":true}],"kind":"symbol","seeAlsoSections":[{"title":"Querying and Updating Entities","identifiers":["doc:\/\/WorldModule\/documentation\/WorldModule\/QueryingAWorld","doc:\/\/WorldModule\/documentation\/WorldModule\/Query","doc:\/\/WorldModule\/documentation\/WorldModule\/EntityQueryView","doc:\/\/WorldModule\/documentation\/WorldModule\/QueryRow","doc:\/\/WorldModule\/documentation\/WorldModule\/QueryTerm","doc:\/\/WorldModule\/documentation\/WorldModule\/AnyOf","doc:\/\/WorldModule\/documentation\/WorldModule\/EntitiesView"],"generated":true,"anchor":"Querying-and-Updating-Entities"}],"primaryContentSections":[{"kind":"declarations","declarations":[{"tokens":[{"text":"@frozen","kind":"attribute"},{"text":" ","kind":"text"},{"text":"struct","kind":"keyword"},{"kind":"text","text":" "},{"kind":"identifier","text":"QueryView"},{"kind":"text","text":"<each "},{"kind":"genericParameter","text":"C"},{"kind":"text","text":">"}],"languages":["swift"],"platforms":["Linux"]}]},{"content":[{"level":2,"text":"Overview","type":"heading","anchor":"overview"},{"inlineContent":[{"text":"You get a view from a world’s ","type":"text"},{"code":"query(_:)","type":"codeVoice"},{"text":" methods. Each row is a tuple of the entity, labeled","type":"text"},{"text":" ","type":"text"},{"code":"entity","type":"codeVoice"},{"text":", followed by the values of the query’s terms in the order the query lists them, so a","type":"text"},{"text":" ","type":"text"},{"text":"loop can name them all:","type":"text"}],"type":"paragraph"},{"code":["var world = World()","world.spawn(Name(value: \"comet\"), Velocity(dx: 3, dy: 4))","world.spawn(Name(value: \"statue\"), Velocity(dx: 1, dy: 1), Frozen())","","for (_, name, velocity) in world.query(Name.self, Velocity.self).without(Frozen.self) {","    print(name.value, velocity.dx)","    \/\/ Prints \"comet 3.0\"","}"],"syntax":"swift","type":"codeListing"},{"inlineContent":[{"type":"text","text":"A view is a snapshot of the world it came from: changing the world while you iterate doesn’t"},{"type":"text","text":" "},{"type":"text","text":"change what the view shows, though the first write to each component type copies that type’s"},{"type":"text","text":" "},{"type":"text","text":"storage. To change components while you visit them, use one of the world’s "},{"code":"update","type":"codeVoice"},{"type":"text","text":" methods"},{"type":"text","text":" "},{"type":"text","text":"instead."}],"type":"paragraph"},{"inlineContent":[{"text":"Narrow a view with the same methods a ","type":"text"},{"identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/Query","isActive":true,"type":"reference"},{"text":" offers, such as ","type":"text"},{"isActive":true,"identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/QueryView\/with(_:)","type":"reference"},{"text":" and","type":"text"},{"type":"text","text":" "},{"isActive":true,"type":"reference","identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/QueryView\/without(_:)"},{"type":"text","text":". Each returns a new view."}],"type":"paragraph"},{"inlineContent":[{"text":"Rows come in the order of the list the view walks: the storage of the queried or required type","type":"text"},{"text":" ","type":"text"},{"text":"that the fewest entities hold, or a shorter list where one applies, such as a target’s sources","type":"text"},{"text":" ","type":"text"},{"text":"for ","type":"text"},{"identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/QueryView\/related(_:to:)","type":"reference","isActive":true},{"text":" or a cached query’s entities. That order depends only on the steps that","type":"text"},{"text":" ","type":"text"},{"text":"built the world, so it’s the same every time you run the same steps.","type":"text"}],"type":"paragraph"}],"kind":"content"}],"hierarchy":{"paths":[["doc:\/\/WorldModule\/documentation\/WorldModule"]]},"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/worldmodule\/queryview"]}],"relationshipsSections":[{"title":"Conforms To","kind":"relationships","identifiers":["doc:\/\/WorldModule\/s8SendableP","doc:\/\/WorldModule\/s16SendableMetatypeP","doc:\/\/WorldModule\/ST"],"type":"conformsTo"}],"sections":[],"metadata":{"fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"QueryView","kind":"identifier"}],"remoteSource":{"fileName":"QueryView.swift","url":"https:\/\/github.com\/Tyler-Keith-Thompson\/ECS\/blob\/main\/Sources\/WorldModule\/QueryView.swift#L70"},"navigatorTitle":[{"kind":"identifier","text":"QueryView"}],"role":"symbol","module