o a"},{"type":"text","text":" "},{"type":"text","text":"loop can name them all:"}],"type":"paragraph"},{"code":["var world = World()","world.spawn(Name(value: \"comet\"), Velocity(dx: 3, dy: 4))","world.spawn(Name(value: \"statue\"), Velocity(dx: 1, dy: 1), Frozen())","","for (_, name, velocity) in world.query(Name.self, Velocity.self).without(Frozen.self) {","    print(name.value, velocity.dx)","    \/\/ Prints \"comet 3.0\"","}"],"syntax":"swift","type":"codeListing"},{"inlineContent":[{"text":"A view is a snapshot of the world it came from: changing the world while you iterate doesn’t","type":"text"},{"text":" ","type":"text"},{"text":"change what the view shows, though the first write to each component type copies that type’s","type":"text"},{"text":" ","type":"text"},{"text":"storage. To change components while you visit them, use one of the world’s ","type":"text"},{"type":"codeVoice","code":"update"},{"text":" methods","type":"text"},{"text":" ","type":"text"},{"text":"instead.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"Narrow a view with the same methods a "},{"isActive":true,"type":"reference","identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/Query"},{"type":"text","text":" offers, such as "},{"isActive":true,"type":"reference","identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/QueryView\/with(_:)"},{"type":"text","text":" and"},{"type":"text","text":" "},{"isActive":true,"type":"reference","identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/QueryView\/without(_:)"},{"type":"text","text":". Each returns a new view."}],"type":"paragraph"},{"inlineContent":[{"text":"Rows come in the storage order of the type that the fewest matching candidates hold, among the","type":"text"},{"text":" ","type":"text"},{"text":"queried and required types. That order depends only on the history of insertions and removals,","type":"text"},{"text":" ","type":"text"},{"text":"so it’s the same every time you run