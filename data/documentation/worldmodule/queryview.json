ty(dx: 3, dy: 4))","world.spawn(Name(value: \"statue\"), Velocity(dx: 1, dy: 1), Frozen())","","for (_, name, velocity) in world.query(Name.self, Velocity.self).without(Frozen.self) {","    print(name.value, velocity.dx)","    \/\/ Prints \"comet 3.0\"","}"],"type":"codeListing"},{"inlineContent":[{"text":"A view is a snapshot of the world it came from: changing the world while you iterate doesn’t","type":"text"},{"text":" ","type":"text"},{"text":"change what the view shows, though the first write to each component type copies that type’s","type":"text"},{"text":" ","type":"text"},{"text":"storage. To change components while you visit them, use one of the world’s ","type":"text"},{"code":"update","type":"codeVoice"},{"text":" methods","type":"text"},{"text":" ","type":"text"},{"text":"instead.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"Narrow a view with the same methods a "},{"type":"reference","identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/Query","isActive":true},{"type":"text","text":" offers, such as "},{"type":"reference","identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/QueryView\/with(_:)","isActive":true},{"type":"text","text":" and"},{"type":"text","text":" "},{"type":"reference","identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/QueryView\/without(_:)","isActive":true},{"type":"text","text":". Each returns a new view."}],"type":"paragraph"},{"inlineContent":[{"text":"Rows come in the order of the list the view walks: the storage of the queried or required type","type":"text"},{"text":" ","type":"text"},{"text":"that the fewest entities hold, or a shorter list where one applies, such as a target’s sources","type":"text"},{"text":" ","type":"text"},{"text":"for ","type":"text"},{"identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/QueryView\/related(_:to:)","isActive":true,"type":"reference"},{"text":" or a cached query’s entities. That order depends only on the steps that","type":"text"},{"text":" ","type":"text"},{"text":"built the world, so it’s the same every time you run the same steps.","type":"text"}],"type":"paragraph"}]}],"schemaVersion":{"minor":3,"patch":0,"major":0},"relationshipsSections":[{"title":"Conforms To","kind":"relationships","identifiers":["doc:\/\/WorldModule\/s8SendableP","doc:\/\/WorldModule\/s16SendableMetatypeP","doc:\/\/WorldModule\/ST"],"type":"conformsTo"}],"references":{"doc://WorldModule/documentation/WorldModule/QueryTerm":{"url":"\/documentation\/worldmodule\/queryterm","kind":"symbol","role":"symbol","title":"QueryTerm","identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/QueryTerm","fragments":[{"text":"protocol","kind":"keyword"},{"text":" ","kind":"text"},{"text":"QueryTerm","kind":"identifier"}],"navigatorTitle":[{"text":"QueryTerm","kind":"identifier"}],"type":"topic","abstract":[{"type":"text","text":"A type that can be a term of a query, deciding which entities match and what the query reads"},{"type":"text","text":" "},{"type":"text","text":"from each."}]},"doc://WorldModule/documentation/WorldModule/QueryView/first":{"identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/QueryView\/first","kind":"symbol","abstract":[{"text":"The first row of the view, or ","type":"text"},{"code":"nil","type":"codeVoice"},{"text":" if the view is empty.","type":"text"}],"url":"\/documentation\/worldmodule\/queryview\/first","type":"topic","role":"symbol","fragments":[{"kind":"keyword","text":"var"},{"kind":"text","text":" "},{"kind":"identifier","text":"first"},{"kind":"text","text":": (entity"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:11WorldModule6EntityV","text":"Entity"},{"kind":"text","text":", repeat each "},{"kind":"typeIdentifier","text":"C"},{"kind":"text","text":")?"}],"title":"first"},"doc://WorldModule/documentation/WorldModule/QueryView/added(_:since:)":{"title":"added(_:since:)","identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/