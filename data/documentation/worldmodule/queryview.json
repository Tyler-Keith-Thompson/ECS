(Name(value: \"comet\"), Velocity(dx: 3, dy: 4))","world.spawn(Name(value: \"statue\"), Velocity(dx: 1, dy: 1), Frozen())","","for (_, name, velocity) in world.query(Name.self, Velocity.self).without(Frozen.self) {","    print(name.value, velocity.dx)","    \/\/ Prints \"comet 3.0\"","}"],"type":"codeListing","syntax":"swift"},{"inlineContent":[{"type":"text","text":"A view is a snapshot of the world it came from: changing the world while you iterate doesn’t"},{"type":"text","text":" "},{"type":"text","text":"change what the view shows, though the first write to each component type copies that type’s"},{"type":"text","text":" "},{"type":"text","text":"storage. To change components while you visit them, use one of the world’s "},{"type":"codeVoice","code":"update"},{"type":"text","text":" methods"},{"type":"text","text":" "},{"type":"text","text":"instead."}],"type":"paragraph"},{"inlineContent":[{"text":"Narrow a view with the same methods a ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/Query"},{"text":" offers, such as ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/QueryView\/with(_:)"},{"text":" and","type":"text"},{"text":" ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/QueryView\/without(_:)"},{"text":". Each returns a new view.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"Rows come in the order of the list the view walks: the storage of the queried or required type"},{"type":"text","text":" "},{"type":"text","text":"that the fewest entities hold, or a shorter list where one applies, such as a target’s sources"},{"type":"text","text":" "},{"type":"text","text":"for "},{"identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/QueryView\/related(_:to:)","type":"reference","isActive":true},{"type":"text","text":" or a cach