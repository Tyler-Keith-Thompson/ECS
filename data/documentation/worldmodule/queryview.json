{"kind":"symbol","identifier":{"url":"doc:\/\/WorldModule\/documentation\/WorldModule\/QueryView","interfaceLanguage":"swift"},"abstract":[{"text":"A lazy sequence of the entities that match a query, with the components the query reads.","type":"text"}],"seeAlsoSections":[{"anchor":"Querying-and-Updating-Entities","generated":true,"identifiers":["doc:\/\/WorldModule\/documentation\/WorldModule\/QueryingAWorld","doc:\/\/WorldModule\/documentation\/WorldModule\/Query","doc:\/\/WorldModule\/documentation\/WorldModule\/EntityQueryView","doc:\/\/WorldModule\/documentation\/WorldModule\/QueryRow","doc:\/\/WorldModule\/documentation\/WorldModule\/QueryTerm","doc:\/\/WorldModule\/documentation\/WorldModule\/AnyOf","doc:\/\/WorldModule\/documentation\/WorldModule\/EntitiesView"],"title":"Querying and Updating Entities"}],"schemaVersion":{"minor":3,"major":0,"patch":0},"metadata":{"fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"QueryView","kind":"identifier"}],"externalID":"s:11WorldModule9QueryViewV","title":"QueryView","remoteSource":{"url":"https:\/\/github.com\/Tyler-Keith-Thompson\/ECS\/blob\/main\/Sources\/WorldModule\/QueryView.swift#L70","fileName":"QueryView.swift"},"navigatorTitle":[{"text":"QueryView","kind":"identifier"}],"modules":[{"name":"WorldModule"}],"symbolKind":"struct","roleHeading":"Structure","role":"symbol"},"topicSections":[{"anchor":"Structures","generated":true,"identifiers":["doc:\/\/WorldModule\/documentation\/WorldModule\/QueryView\/Iterator"],"title":"Structures"},{"anchor":"Instance-Properties","generated":true,"identifiers":["doc:\/\/WorldModule\/documentation\/WorldModule\/QueryView\/count","doc:\/\/WorldModule\/documentation\/WorldModule\/QueryView\/filter","doc:\/\/WorldModule\/documentation\/WorldModule\/QueryView\/first"],"title":"Instance Properties"},{"anchor":"Instance-Methods","generated":true,"identifiers":["doc:\/\/WorldModule\/documentation\/WorldModule\/QueryView\/added(_:since:)","doc:\/\/WorldModule\/documentation\/WorldModule\/QueryView\/allowing(_:)","doc:\/\/WorldModule\/documentation\/WorldModule\/QueryView\/anyOf(_:)","doc:\/\/WorldModule\/documentation\/WorldModule\/QueryView\/changed(_:since:)","doc:\/\/WorldModule\/documentation\/WorldModule\/QueryView\/filtered(by:)","doc:\/\/WorldModule\/documentation\/WorldModule\/QueryView\/makeIterator()","doc:\/\/WorldModule\/documentation\/WorldModule\/QueryView\/related(_:to:)","doc:\/\/WorldModule\/documentation\/WorldModule\/QueryView\/with(_:)","doc:\/\/WorldModule\/documentation\/WorldModule\/QueryView\/without(_:)"],"title":"Instance Methods"},{"anchor":"Default-Implementations","generated":true,"identifiers":["doc:\/\/WorldModule\/documentation\/WorldModule\/QueryView\/Sequence-Implementations"],"title":"Default Implementations"}],"hierarchy":{"paths":[["doc:\/\/WorldModule\/documentation\/WorldModule"]]},"relationshipsSections":[{"type":"conformsTo","kind":"relationships","identifiers":["doc:\/\/WorldModule\/s8SendableP","doc:\/\/WorldModule\/s16SendableMetatypeP","doc:\/\/WorldModule\/ST"],"title":"Conforms To"}],"primaryContentSections":[{"kind":"declarations","declarations":[{"platforms":["Linux"],"tokens":[{"kind":"attribute","text":"@frozen"},{"kind":"text","text":" "},{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"QueryView"},{"kind":"text","text":"<each "},{"kind":"genericParameter","text":"C"},{"kind":"text","text":">"}],"languages":["swift"]}]},{"kind":"content","content":[{"type":"heading","text":"Overview","anchor":"overview","level":2},{"inlineContent":[{"text":"You get a view from a world’s ","type":"text"},{"type":"codeVoice","code":"query(_:)"},{"text":" methods. Each row is a tuple of the entity, labeled","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"entity"},{"text":", followed by the values of the query’s terms in the order the query lists them, so a","type":"text"},{"text":" ","type":"text"},{"text":"loop can name them all:","type":"text"}],"type":"paragraph"},{"type":"codeListing","syntax":"swift","code":["var world = World()","world.spawn(Name(value: \"comet\"), Velocity(dx: 3, dy: 4))","world.spawn(Name(value: \"statue\"), Velocity(dx: 1, dy: 1), Frozen())","","for (_, name, velocity) in world.query(Name.self, Velocity.self).without(Frozen.self) {","    print(name.value, velocity.dx)","    \/\/ Prints \"comet 3.0\"","}"]},{"inlineContent":[{"text":"A view is a snapshot of the world it came from: changing the world while you iterate doesn’t","type":"text"},{"text":" ","type":"text"},{"text":"change what the view shows, though the first write to each component type copies that type’s","type":"text"},{"text":" ","type":"text"},{"text":"storage. To change components while you visit them, use one of the world’s ","type":"text"},{"code":"update","type":"codeVoice"},{"text":" methods","type":"text"},{"text":" ","type":"text"},{"text":"instead.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"Narrow a view with the same methods a ","type":"text"},{"identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/Query","isActive":true,"type":"reference"},{"text":" offers, such as ","type":"text"},{"identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/QueryView\/with(_:)","isActive":true,"type":"reference"},{"text":" and","type":"text"},{"text":" ","type":"text"},{"identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/QueryView\/without(_:)","isActive":true,"type":"reference"},{"text":". Each returns a new view.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"Rows come in the order of the list the view walks: the storage of the queried or required type"},{"type":"text","text":" "},{"type":"text","text":"that the fewest entities hold, or a shorter list where one applies, such as a target’s sources"},{"type":"text","text":" "},{"type":"text","text":"for "},{"isActive":true,"type":"reference","identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/QueryView\/related(_:to:)"},{"type":"text","text":" or a cached query’s entities. That order depends only on the steps that"},{"type":"text","text":" "},{"type":"text","text":"built the world, so it’s the same every time you run the same steps."}],"type":"paragraph"}]}],"variants":[{"paths":["\/documentation\/worldmodule\/queryview"],"traits":[{"interfaceLanguage":"swift"}]}],"sections":[],"references":{"doc://WorldModule/documentation/WorldModule/QueryView/filter":{"url":"\/documentation\/worldmodule\/queryview\/filter","type":"topic","fragments":[{"kind":"keyword","text":"let"},{"kind":"text","text":" "},{"kind":"identifier","text":"filter"},{"kind":"text","text":": "},{"preciseIdentifier":"s:11WorldModule11QueryFilterV","kind":"typeIdentifier","text":"QueryFilter"}],"role":"symbol","title":"filter","identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/QueryView\/filter","abstract":[{"text":"The conditions an entity must meet, beyond holding the components the rows carry.","type":"text"}],"kind":"symbol"},"doc://WorldModule/documentation/WorldModule/QueryView/Iterator":{"navigatorTitle":[{"kind":"identifier","text":"Iterator"}],"kind":"symbol","role":"symbol","type":"topic","title":"QueryView.Iterator","url":"\/documentation\/worldmodule\/queryview\/iterator","identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/QueryView\/Iterator","abstract":[{"text":"An iterator over the rows of a query view.","type":"text"}],"fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"Iterator"}]},"doc://WorldModule/documentation/WorldModule/QueryView/without(_:)":{"kind":"symbol","role":"symbol","type":"topic","title":"without(_:)","url":"\/documentation\/worldmodule\/queryview\/without(_:)","identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/QueryView\/without(_:)","abstract":[{"text":"Returns a view that also excludes entities holding any of the given component types.","ty