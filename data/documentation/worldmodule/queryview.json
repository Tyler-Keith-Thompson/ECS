{"metadata":{"externalID":"s:11WorldModule9QueryViewV","title":"QueryView","roleHeading":"Structure","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"QueryView"}],"navigatorTitle":[{"text":"QueryView","kind":"identifier"}],"modules":[{"name":"WorldModule"}],"remoteSource":{"fileName":"QueryView.swift","url":"https:\/\/github.com\/Tyler-Keith-Thompson\/ECS\/blob\/main\/Sources\/WorldModule\/QueryView.swift#L70"},"symbolKind":"struct","role":"symbol"},"sections":[],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/WorldModule\/documentation\/WorldModule\/QueryView"},"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/worldmodule\/queryview"]}],"relationshipsSections":[{"type":"conformsTo","identifiers":["doc:\/\/WorldModule\/s8SendableP","doc:\/\/WorldModule\/s16SendableMetatypeP","doc:\/\/WorldModule\/ST"],"kind":"relationships","title":"Conforms To"}],"hierarchy":{"paths":[["doc:\/\/WorldModule\/documentation\/WorldModule"]]},"kind":"symbol","seeAlsoSections":[{"identifiers":["doc:\/\/WorldModule\/documentation\/WorldModule\/QueryingAWorld","doc:\/\/WorldModule\/documentation\/WorldModule\/Query","doc:\/\/WorldModule\/documentation\/WorldModule\/EntityQueryView","doc:\/\/WorldModule\/documentation\/WorldModule\/QueryRow","doc:\/\/WorldModule\/documentation\/WorldModule\/QueryTerm","doc:\/\/WorldModule\/documentation\/WorldModule\/AnyOf","doc:\/\/WorldModule\/documentation\/WorldModule\/EntitiesView"],"anchor":"Querying-and-Updating-Entities","generated":true,"title":"Querying and Updating Entities"}],"topicSections":[{"identifiers":["doc:\/\/WorldModule\/documentation\/WorldModule\/QueryView\/Iterator"],"anchor":"Structures","generated":true,"title":"Structures"},{"identifiers":["doc:\/\/WorldModule\/documentation\/WorldModule\/QueryView\/count","doc:\/\/WorldModule\/documentation\/WorldModule\/QueryView\/filter","doc:\/\/WorldModule\/documentation\/WorldModule\/QueryView\/first"],"anchor":"Instance-Properties","generated":true,"title":"Instance Properties"},{"identifiers":["doc:\/\/WorldModule\/documentation\/WorldModule\/QueryView\/added(_:since:)","doc:\/\/WorldModule\/documentation\/WorldModule\/QueryView\/allowing(_:)","doc:\/\/WorldModule\/documentation\/WorldModule\/QueryView\/anyOf(_:)","doc:\/\/WorldModule\/documentation\/WorldModule\/QueryView\/changed(_:since:)","doc:\/\/WorldModule\/documentation\/WorldModule\/QueryView\/filtered(by:)","doc:\/\/WorldModule\/documentation\/WorldModule\/QueryView\/makeIterator()","doc:\/\/WorldModule\/documentation\/WorldModule\/QueryView\/related(_:to:)","doc:\/\/WorldModule\/documentation\/WorldModule\/QueryView\/with(_:)","doc:\/\/WorldModule\/documentation\/WorldModule\/QueryView\/without(_:)"],"anchor":"Instance-Methods","generated":true,"title":"Instance Methods"},{"identifiers":["doc:\/\/WorldModule\/documentation\/WorldModule\/QueryView\/Sequence-Implementations"],"anchor":"Default-Implementations","generated":true,"title":"Default Implementations"}],"abstract":[{"text":"A lazy sequence of the entities that match a query, with the components the query reads.","type":"text"}],"primaryContentSections":[{"declarations":[{"tokens":[{"text":"@frozen","kind":"attribute"},{"text":" ","kind":"text"},{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"QueryView","kind":"identifier"},{"text":"<each ","kind":"text"},{"text":"C","kind":"genericParameter"},{"text":">","kind":"text"}],"languages":["swift"],"platforms":["Linux"]}],"kind":"declarations"},{"content":[{"text":"Overview","level":2,"type":"heading","anchor":"overview"},{"type":"paragraph","inlineContent":[{"type":"text","text":"You get a view from a world’s "},{"type":"codeVoice","code":"query(_:)"},{"type":"text","text":" methods. Each row is a tuple of the entity, labeled"},{"type":"text","text":" "},{"type":"codeVoice","code":"entity"},{"type":"text","text":", followed by the values of the query’s terms in the order the query lists them, so a"},{"type":"text","text":" "},{"type":"text","text":"loop can name them all:"}]},{"type":"codeListing","syntax":"swift","code":["var world = World()","world.spawn(Name(value: \"comet\"), Velocity(dx: 3, dy: 4))","world.spawn(Name(value: \"statue\"), Velocity(dx: 1, dy: 1), Frozen())","","for (_, name, velocity) in world.query(Name.self, Velocity.self).without(Frozen.self) {","    print(name.value, velocity.dx)","    \/\/ Prints \"comet 3.0\"","}"]},{"type":"paragraph","inlineContent":[{"type":"text","text":"A view is a snapshot of the world it came from: changing the world while you iterate doesn’t"},{"type":"text","text":" "},{"type":"text","text":"change what the view shows, though the first write to each component type copies that type’s"},{"type":"text","text":" "},{"type":"text","text":"storage. To change components while you visit them, use one of the world’s "},{"type":"codeVoice","code":"update"},{"type":"text","text":" methods"},{"type":"text","text":" "},{"type":"text","text":"instead."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Narrow a view with the same methods a "},{"type":"reference","identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/Query","isActive":true},{"type":"text","text":" offers, such as "},{"type":"reference","identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/QueryView\/with(_:)","isActive":true},{"type":"text","text":" and"},{"type":"text","text":" "},{"type":"reference","identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/QueryView\/without(_:)","isActive":true},{"type":"text","text":". Each returns a new view."}]},{"type":"paragraph","inlineContent":[{"text":"Rows come in the order of the list the view walks: the storage of the queried or required type","type":"text"},{"text":" ","type":"text"},{"text":"that the fewest entities hold, or a shorter list where one applies, such as a target’s sources","type":"text"},{"text":" ","type":"text"},{"text":"for ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/QueryView\/related(_:to:)"},{"text":" or a cached query’s entities. That order depends only on the steps that","type":"text"},{"text":" ","type":"text"},{"text":"built the world, so it’s the same every time you run the same steps.","type":"text"}]}],"kind":"content"}],"schemaVersion":{"major":0,"patch":0,"minor":3},"references":{"doc://WorldModule/ST":{"title":"Swift.Sequence","identifier":"doc:\/\/WorldModule\/ST","type":"unresolvable"},"doc://WorldModule/documentation/WorldModule":{"abstract":[{"type":"text","text":"Store the state of a game or simulation as entities and components, and read and change it with"},{"type":"text","text":" "},{"type":"text","text":"queries, updates, and commands."}],"role":"collection","identifier":"doc:\/\/WorldModule\/documentation\/WorldModule","url":"\/documentation\/worldmodule","title":"WorldModule","kind":"symbol","type":"topic"},"doc://WorldModule/documentation/WorldModule/QueryView/first":{"abstract":[{"text":"The first row of the view, or ","type":"text"},{"code":"nil","type":"codeVoice"},{"text":" if the view is empty.","type":"text"}],"title":"first","fragments":[{"text":"var","kind":"keyword"},{"text":" ","kind":"text"},{"text":"first","kind":"identifier"},{"text":": (entity","kind":"text"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:11WorldModule6EntityV","text":"Entity","kind":"typeIdentifier"},{"text":", repeat each ","kind":"text"},{"text":"C","kind":"typeIdentifier"},{"text":")?","kind":"text"}],"identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/QueryView\/first","type":"topic","kind":"symbol","role":"symbol","url":"\/documentation\/worldmodule\/queryview\/first"},"doc://WorldModule/documentation/WorldModule/QueryView/count":{"type":"topic","url":"\/documentation\/worldmodule\/queryview\/count","role":"symbol","kind":"symbol","title":"count","abstract":[{"type":"text","text":"The number of ro