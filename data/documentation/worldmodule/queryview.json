{"sections":[],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/worldmodule\/queryview"]}],"hierarchy":{"paths":[["doc:\/\/WorldModule\/documentation\/WorldModule"]]},"schemaVersion":{"major":0,"minor":3,"patch":0},"identifier":{"url":"doc:\/\/WorldModule\/documentation\/WorldModule\/QueryView","interfaceLanguage":"swift"},"metadata":{"fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"QueryView","kind":"identifier"}],"roleHeading":"Structure","title":"QueryView","remoteSource":{"url":"https:\/\/github.com\/Tyler-Keith-Thompson\/ECS\/blob\/main\/Sources\/WorldModule\/QueryView.swift#L70","fileName":"QueryView.swift"},"modules":[{"name":"WorldModule"}],"externalID":"s:11WorldModule9QueryViewV","role":"symbol","symbolKind":"struct","navigatorTitle":[{"kind":"identifier","text":"QueryView"}]},"kind":"symbol","abstract":[{"type":"text","text":"A lazy sequence of the entities that match a query, with the components the query reads."}],"topicSections":[{"title":"Structures","anchor":"Structures","generated":true,"identifiers":["doc:\/\/WorldModule\/documentation\/WorldModule\/QueryView\/Iterator"]},{"title":"Instance Properties","anchor":"Instance-Properties","generated":true,"identifiers":["doc:\/\/WorldModule\/documentation\/WorldModule\/QueryView\/count","doc:\/\/WorldModule\/documentation\/WorldModule\/QueryView\/filter","doc:\/\/WorldModule\/documentation\/WorldModule\/QueryView\/first"]},{"title":"Instance Methods","anchor":"Instance-Methods","generated":true,"identifiers":["doc:\/\/WorldModule\/documentation\/WorldModule\/QueryView\/added(_:since:)","doc:\/\/WorldModule\/documentation\/WorldModule\/QueryView\/allowing(_:)","doc:\/\/WorldModule\/documentation\/WorldModule\/QueryView\/anyOf(_:)","doc:\/\/WorldModule\/documentation\/WorldModule\/QueryView\/changed(_:since:)","doc:\/\/WorldModule\/documentation\/WorldModule\/QueryView\/filtered(by:)","doc:\/\/WorldModule\/documentation\/WorldModule\/QueryView\/makeIterator()","doc:\/\/WorldModule\/documentation\/WorldModule\/QueryView\/related(_:to:)","doc:\/\/WorldModule\/documentation\/WorldModule\/QueryView\/with(_:)","doc:\/\/WorldModule\/documentation\/WorldModule\/QueryView\/without(_:)"]},{"title":"Default Implementations","anchor":"Default-Implementations","generated":true,"identifiers":["doc:\/\/WorldModule\/documentation\/WorldModule\/QueryView\/Sequence-Implementations"]}],"relationshipsSections":[{"title":"Conforms To","kind":"relationships","type":"conformsTo","identifiers":["doc:\/\/WorldModule\/s8SendableP","doc:\/\/WorldModule\/s16SendableMetatypeP","doc:\/\/WorldModule\/ST"]}],"primaryContentSections":[{"declarations":[{"tokens":[{"text":"@frozen","kind":"attribute"},{"text":" ","kind":"text"},{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"QueryView","kind":"identifier"},{"text":"<each ","kind":"text"},{"text":"C","kind":"genericParameter"},{"text":">","kind":"text"}],"platforms":["Linux"],"languages":["swift"]}],"kind":"declarations"},{"kind":"content","content":[{"type":"heading","level":2,"text":"Overview","anchor":"overview"},{"type":"paragraph","inlineContent":[{"text":"You get a view from a world’s ","type":"text"},{"code":"query(_:)","type":"codeVoice"},{"text":" methods. Each row is a tuple of the entity, labeled","type":"text"},{"text":" ","type":"text"},{"code":"entity","type":"codeVoice"},{"text":", followed by the values of the query’s terms in the order the query lists them, so a","type":"text"},{"text":" ","type":"text"},{"text":"loop can name them all:","type":"text"}]},{"type":"codeListing","code":["var world = World()","world.spawn(Name(value: \"comet\"), Velocity(dx: 3, dy: 4))","world.spawn(Name(value: \"statue\"), Velocity(dx: 1, dy: 1), Frozen())","","for (_, name, velocity) in world.query(Name.self, Velocity.self).without(Frozen.self) {","    print(name.value, velocity.dx)","    \/\/ Prints \"comet 3.0\"","}"],"syntax":"swift"},{"type":"paragraph","inlineContent":[{"type":"text","text":"A view is a snapshot of the world it came from: changing the world while you iterate doesn’t"},{"type":"text","text":" "},{"type":"text","text":"change what the view shows, though the first write to each component type copies that type’s"},{"type":"text","text":" "},{"type":"text","text":"storage. To change components while you visit them, use one of the world’s "},{"type":"codeVoice","code":"update"},{"type":"text","text":" methods"},{"type":"text","text":" "},{"type":"text","text":"instead."}]},{"type":"paragraph","inlineContent":[{"text":"Narrow a view with the same methods a ","type":"text"},{"identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/Query","isActive":true,"type":"reference"},{"text":" offers, such as ","type":"text"},{"identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/QueryView\/with(_:)","isActive":true,"type":"reference"},{"text":" and","type":"text"},{"text":" ","type":"text"},{"identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/QueryView\/without(_:)","isActive":true,"type":"reference"},{"text":". Each returns a new view.","type":"text"}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Rows come in the order of the list the view walks: the storage of the queried or required type"},{"type":"text","text":" "},{"type":"text","text":"that the fewest entities hold, or a shorter list where one applies, such as a target’s sources"},{"type":"text","text":" "},{"type":"text","text":"for "},{"type":"reference","isActive":true,"identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/QueryView\/related(_:to:)"},{"type":"text","text":" or a cached query’s entities. That order depends only on the steps that"},{"type":"text","text":" "},{"type":"text","text":"built the world, so it’s the same every time you run the same steps."}]}]}],"seeAlsoSections":[{"title":"Querying and Updating Entities","anchor":"Querying-and-Updating-Entities","generated":true,"identifiers":["doc:\/\/Wo