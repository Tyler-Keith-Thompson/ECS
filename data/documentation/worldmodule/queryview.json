{"metadata":{"fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"QueryView","kind":"identifier"}],"symbolKind":"struct","navigatorTitle":[{"text":"QueryView","kind":"identifier"}],"remoteSource":{"fileName":"QueryView.swift","url":"https:\/\/github.com\/Tyler-Keith-Thompson\/ECS\/blob\/main\/Sources\/WorldModule\/QueryView.swift#L70"},"externalID":"s:11WorldModule9QueryViewV","title":"QueryView","role":"symbol","modules":[{"name":"WorldModule"}],"roleHeading":"Structure"},"identifier":{"url":"doc:\/\/WorldModule\/documentation\/WorldModule\/QueryView","interfaceLanguage":"swift"},"hierarchy":{"paths":[["doc:\/\/WorldModule\/documentation\/WorldModule"]]},"sections":[],"topicSections":[{"generated":true,"anchor":"Structures","identifiers":["doc:\/\/WorldModule\/documentation\/WorldModule\/QueryView\/Iterator"],"title":"Structures"},{"generated":true,"anchor":"Instance-Properties","identifiers":["doc:\/\/WorldModule\/documentation\/WorldModule\/QueryView\/count","doc:\/\/WorldModule\/documentation\/WorldModule\/QueryView\/filter","doc:\/\/WorldModule\/documentation\/WorldModule\/QueryView\/first"],"title":"Instance Properties"},{"generated":true,"anchor":"Instance-Methods","identifiers":["doc:\/\/WorldModule\/documentation\/WorldModule\/QueryView\/added(_:since:)","doc:\/\/WorldModule\/documentation\/WorldModule\/QueryView\/allowing(_:)","doc:\/\/WorldModule\/documentation\/WorldModule\/QueryView\/anyOf(_:)","doc:\/\/WorldModule\/documentation\/WorldModule\/QueryView\/changed(_:since:)","doc:\/\/WorldModule\/documentation\/WorldModule\/QueryView\/filtered(by:)","doc:\/\/WorldModule\/documentation\/WorldModule\/QueryView\/makeIterator()","doc:\/\/WorldModule\/documentation\/WorldModule\/QueryView\/related(_:to:)","doc:\/\/WorldModule\/documentation\/WorldModule\/QueryView\/with(_:)","doc:\/\/WorldModule\/documentation\/WorldModule\/QueryView\/without(_:)"],"title":"Instance Methods"},{"generated":true,"anchor":"Default-Implementations","identifiers":["doc:\/\/WorldModule\/documentation\/WorldModule\/QueryView\/Sequence-Implementations"],"title":"Default Implementations"}],"abstract":[{"text":"A lazy sequence of the entities that match a query, with the components the query reads.","type":"text"}],"relationshipsSections":[{"title":"Conforms To","type":"conformsTo","identifiers":["doc:\/\/WorldModule\/s8SendableP","doc:\/\/WorldModule\/s16SendableMetatypeP","doc:\/\/WorldModule\/ST"],"kind":"relationships"}],"seeAlsoSections":[{"generated":true,"anchor":"Querying-and-Updating-Entities","identifiers":["doc:\/\/WorldModule\/documentation\/WorldModule\/QueryingAWorld","doc:\/\/WorldModule\/documentation\/WorldModule\/Query","doc:\/\/WorldModule\/documentation\/WorldModule\/EntityQueryView","doc:\/\/WorldModule\/documentation\/WorldModule\/QueryRow","doc:\/\/WorldModule\/documentation\/WorldModule\/QueryTerm","doc:\/\/WorldModule\/documentation\/WorldModule\/AnyOf","doc:\/\/WorldModule\/documentation\/WorldModule\/EntitiesView"],"title":"Querying and Updating Entities"}],"primaryContentSections":[{"declarations":[{"tokens":[{"text":"@frozen","kind":"attribute"},{"text":" ","kind":"text"},{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"QueryView","kind":"identifier"},{"text":"<each ","kind":"text"},{"text":"C","kind":"genericParameter"},{"text":">","kind":"text"}],"platforms":["Linux"],"languages":["swift"]}],"kind":"declarations"},{"content":[{"level":2,"text":"Overview","type":"heading","anchor":"overview"},{"type":"paragraph","inlineContent":[{"type":"text","text":"You get a view from a world’s "},{"type":"codeVoice","code":"query(_:)"},{"type":"text","text":" methods. Each row is a tuple of the entity, labeled"},{"type":"text","text":" "},{"type":"codeVoice","code":"entity"},{"type":"text","text":", followed by the values of the query’s terms in the order the query lists them, so a"},{"type":"text","text":" "},{"type":"text","text":"loop can name them all:"}]},{"type":"codeListing","code":["var world = World()","world.spawn(Name(value: \"comet\"), Velocity(dx: 3, dy: 4))","world.spawn(Name(value: \"statue\"), Velocity(dx: 1, dy: 1), Frozen())","","for (_, name, velocity) in world.query(Name.self, Velocity.self).without(Frozen.self) {","    print(name.value, velocity.dx)","    \/\/ Prints \"comet 3.0\"","}"],"syntax":"swift"},{"type":"paragraph","inlineContent":[{"type":"text","text":"A view is a snapshot of the world it came from: changing the world while you iterate doesn’t"},{"type":"text","text":" "},{"type":"text","text":"change what the view shows, though the first write to each component type copies that type’s"},{"type":"text","text":" "},{"type":"text","text":"storage. To change components while you visit them, use one of the world’s "},{"type":"codeVoice","code":"update"},{"type":"text","text":" methods"},{"type":"text","text":" "},{"type":"text","text":"instead."}]},{"type":"paragraph","inlineContent":[{"text":"Narrow a view with the same methods a ","type":"text"},{"type":"reference","identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/Query","isActive":true},{"text":" offers, such as ","type":"text"},{"type":"reference","identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/QueryView\/with(_:)","isActive":true},{"text":" and","type":"text"},{"text":" ","type":"text"},{"type":"reference","identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/QueryView\/without(_:)","isActive":true},{"text":". Each returns a new view.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"Rows come in the order of the list the view walks: the storage of the queried or required type","type":"text"},{"text":" ","type":"text"},{"text":"that the fewest entities hold, or a shorter list where one applies, such as a target’s sources","type":"text"},{"text":" ","type":"text"},{"text":"for ","type":"text"},{"type":"reference","identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/QueryView\/related(_:to:)","isActive":true},{"text":" or a cached query’s entities. That order depends only on the steps that","type":"text"},{"text":" ","type":"text"},{"text":"built the world, so it’s the same every time you run the same steps.","type":"text"}]}],"kind":"content"}],"schemaVersion":{"major":0,"minor":3,"patch":0},"variants":[{"paths":["\/documentation\/worldmodule\/queryview"],"traits":[{"interfaceLanguage":"swift"}]}],"kind":"symbol","references":{"doc://WorldModule/documentation/WorldModule/QueryView/related(_:to:)":{"type":"topic","url":"\/documentation\/worldmodule\/queryview\/related(_:to:)","title":"related(_:to:)","role":"symbol","identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/QueryView\/related(_:to:)","kind":"symbol","abstract":[{"text":"Returns a view that also requires a relation to the given target.","type":"text"}],"fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"related","kind":"identifier"},{"text":"<","kind":"text"},{"text":"R","kind":"genericParameter"},{"text":">(","kind":"text"},{"text":"R","kind":"typeIdentifier"},{"text":".Type, ","kind":"text"},{"text":"to","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"Entity","kind":"typeIdentifier","preciseIdentifier":"s:11WorldModule6EntityV"},{"text":") -> ","kind":"text"},{"text":"QueryView","kind":"typeIdentifier","preciseIdentifier":"s:11WorldModule9QueryViewV"},{"text":"<repeat each ","kind":"text"},{"text":"C","kind":"typeIdentifier"},{"text":">","kind":"text"}]},"doc://WorldModule/documentation/WorldModule/QueryView/Sequence-Implementations":{"type":"topic","url":"\/documentation\/worldmodule\/queryview\/sequence-implementations","title":"Sequence Implementations","role":"collectionGroup","identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/QueryView\/Sequence-Implementations","kind":"article","abstract":[]},"doc://WorldModule/documentation/WorldModule/EntitiesView":{"navigatorTitle":[{"kind":"identifier","text":"EntitiesView"}],"title":"Entiti