{"kind":"symbol","identifier":{"url":"doc:\/\/WorldModule\/documentation\/WorldModule\/QueryView","interfaceLanguage":"swift"},"topicSections":[{"generated":true,"identifiers":["doc:\/\/WorldModule\/documentation\/WorldModule\/QueryView\/Iterator"],"anchor":"Structures","title":"Structures"},{"generated":true,"identifiers":["doc:\/\/WorldModule\/documentation\/WorldModule\/QueryView\/count","doc:\/\/WorldModule\/documentation\/WorldModule\/QueryView\/filter"],"anchor":"Instance-Properties","title":"Instance Properties"},{"generated":true,"identifiers":["doc:\/\/WorldModule\/documentation\/WorldModule\/QueryView\/added(_:since:)","doc:\/\/WorldModule\/documentation\/WorldModule\/QueryView\/allowing(_:)","doc:\/\/WorldModule\/documentation\/WorldModule\/QueryView\/anyOf(_:)","doc:\/\/WorldModule\/documentation\/WorldModule\/QueryView\/changed(_:since:)","doc:\/\/WorldModule\/documentation\/WorldModule\/QueryView\/filtered(by:)","doc:\/\/WorldModule\/documentation\/WorldModule\/QueryView\/makeIterator()","doc:\/\/WorldModule\/documentation\/WorldModule\/QueryView\/related(_:to:)","doc:\/\/WorldModule\/documentation\/WorldModule\/QueryView\/with(_:)","doc:\/\/WorldModule\/documentation\/WorldModule\/QueryView\/without(_:)"],"anchor":"Instance-Methods","title":"Instance Methods"},{"generated":true,"identifiers":["doc:\/\/WorldModule\/documentation\/WorldModule\/QueryView\/Sequence-Implementations"],"anchor":"Default-Implementations","title":"Default Implementations"}],"relationshipsSections":[{"type":"conformsTo","kind":"relationships","identifiers":["doc:\/\/WorldModule\/s8SendableP","doc:\/\/WorldModule\/s16SendableMetatypeP","doc:\/\/WorldModule\/ST"],"title":"Conforms To"}],"seeAlsoSections":[{"generated":true,"identifiers":["doc:\/\/WorldModule\/documentation\/WorldModule\/QueryingAWorld","doc:\/\/WorldModule\/documentation\/WorldModule\/Query","doc:\/\/WorldModule\/documentation\/WorldModule\/EntityQueryView","doc:\/\/WorldModule\/documentation\/WorldModule\/QueryR