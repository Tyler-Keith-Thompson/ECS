:11WorldModule9QueryViewV","roleHeading":"Structure","role":"symbol","symbolKind":"struct","navigatorTitle":[{"text":"QueryView","kind":"identifier"}]},"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/WorldModule\/documentation\/WorldModule\/QueryView"},"primaryContentSections":[{"kind":"declarations","declarations":[{"platforms":["Linux"],"languages":["swift"],"tokens":[{"text":"@frozen","kind":"attribute"},{"text":" ","kind":"text"},{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"QueryView","kind":"identifier"},{"text":"<each ","kind":"text"},{"text":"C","kind":"genericParameter"},{"text":">","kind":"text"}]}]},{"kind":"content","content":[{"text":"Overview","anchor":"overview","type":"heading","level":2},{"type":"paragraph","inlineContent":[{"text":"You get a view from a world’s ","type":"text"},{"code":"query(_:)","type":"codeVoice"},{"text":" methods. Each row is a tuple of the entity, labeled","type":"text"},{"text":" ","type":"text"},{"code":"entity","type":"codeVoice"},{"text":", followed by the values of the query’s terms in the order the query lists them, so a","type":"text"},{"text":" ","type":"text"},{"text":"loop can name them all:","type":"text"}]},{"syntax":"swift","code":["var world = World()","world.spawn(Name(value: \"comet\"), Velocity(dx: 3, dy: 4))","world.spawn(Name(value: \"statue\"), Velocity(dx: 1, dy: 1), Frozen())","","for (_, name, velocity) in world.query(Name.self, Velocity.self).without(Frozen.self) {","    print(name.value, velocity.dx)","    \/\/ Prints \"comet 3.0\"","}"],"type":"codeListing"},{"type":"paragraph","inlineContent":[{"text":"A view is a snapshot of the world it came from: changing the world while you iterate doesn’t","type":"text"},{"text":" ","type":"text"},{"text":"change what the view shows, though the first write to each component type copies that type’s","type":"text"},{"text":" ","type":"text"},{"text":"storage. To change components while you visit them, use one of the world’s ","type":"text"},{"code":"update","type":"codeVoice"},{"text":" methods","type":"text"},{"text":" ","type":"text"},{"text":"instead.","type":"text"}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Narrow a view with the same methods a "},{"type":"reference","identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/Query","isActive":true},{"type":"text","text":" offers, such as "},{"type":"reference","identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/QueryView\/with(_:)","isActive":true},{"type":"text","text":" and"},{"type":"text","text":" "},{"type":"reference","identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/QueryView\/without(_:)","isActive":true},{"type":"text","text":". Each returns a new view."}]},{"type":"paragraph","inlineContent":[{"text":"Rows come in the order of the list the view walks: the storage of the queried or required type","type":"text"},{"text":" ","type":"text"},{"text":"that the fewest entities hold, or a shorter list where one applies, such as a target’s sources","type":"text"},{"text":" ","type":"text"},{"text":"for ","type":"text"},{"identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/QueryView\/related(_:to:)","isActive":true,"type":"reference"},{"text":" or a cached query’s entities. That order depends only on the steps that","type":"text"},{"text":" ","type":"text"},{"text":"built the world, so it’s the same every time you run the same steps.","type":"text"}]}]}],"seeAlsoSections":[{"identifiers":["doc:\/\/WorldModule\/documentation\/WorldModule\/QueryingAWorld","doc:\/\/WorldModule\/documentation\/WorldModule\/Query","doc:\/\/WorldModule\/documentation\/WorldModule\/EntityQueryView","doc:\/\/WorldModule\/documentation\/WorldModule\/QueryRow","doc:\/\/WorldModule\/documentation\/WorldModule\/QueryTerm","doc:\/\/WorldModule\/documentation\/WorldModule\/AnyOf","doc:\/\/WorldModule\/documentation\/WorldModule\/EntitiesView"],"generated":true,"anchor":"Querying-and-Updating-Entities","title":