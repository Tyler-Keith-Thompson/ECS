rldModule\/documentation\/WorldModule\/QueryView\/makeIterator()","doc:\/\/WorldModule\/documentation\/WorldModule\/QueryView\/related(_:to:)","doc:\/\/WorldModule\/documentation\/WorldModule\/QueryView\/with(_:)","doc:\/\/WorldModule\/documentation\/WorldModule\/QueryView\/without(_:)"],"generated":true,"anchor":"Instance-Methods"},{"title":"Default Implementations","identifiers":["doc:\/\/WorldModule\/documentation\/WorldModule\/QueryView\/Sequence-Implementations"],"generated":true,"anchor":"Default-Implementations"}],"variants":[{"paths":["\/documentation\/worldmodule\/queryview"],"traits":[{"interfaceLanguage":"swift"}]}],"metadata":{"fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"kind":"identifier","text":"QueryView"}],"roleHeading":"Structure","role":"symbol","title":"QueryView","remoteSource":{"url":"https:\/\/github.com\/Tyler-Keith-Thompson\/ECS\/blob\/main\/Sources\/WorldModule\/QueryView.swift#L70","fileName":"QueryView.swift"},"navigatorTitle":[{"text":"QueryView","kind":"identifier"}],"symbolKind":"struct","externalID":"s:11WorldModule9QueryViewV","modules":[{"name":"WorldModule"}]},"primaryContentSections":[{"declarations":[{"platforms":["Linux"],"tokens":[{"kind":"attribute","text":"@frozen"},{"kind":"text","text":" "},{"kind":"keyword","text":"struct"},{"text":" ","kind":"text"},{"text":"QueryView","kind":"identifier"},{"text":"<each ","kind":"text"},{"text":"C","kind":"genericParameter"},{"text":">","kind":"text"}],"languages":["swift"]}],"kind":"declarations"},{"content":[{"type":"heading","text":"Overview","level":2,"anchor":"overview"},{"type":"paragraph","inlineContent":[{"type":"text","text":"You get a view from a world’s "},{"type":"codeVoice","code":"query(_:)"},{"type":"text","text":" methods. Each row is a tuple of the entity, labeled"},{"type":"text","text":" "},{"type":"codeVoice","code":"entity"},{"type":"text","text":", followed by the values of the query’s terms in the order the query lists them, so a"},{"type":"text","text":" "},{"type":"text","text":"loop can name them all:"}]},{"type":"codeListing","syntax":"swift","code":["var world = World()","world.spawn(Name(value: \"comet\"), Velocity(dx: 3, dy: 4))","world.spawn(Name(value: \"statue\"), Velocity(dx: 1, dy: 1), Frozen())","","for (_, name, velocity) in world.query(Name.self, Velocity.self).without(Frozen.self) {","    print(name.value, velocity.dx)","    \/\/ Prints \"comet 3.0\"","}"]},{"type":"paragraph","inlineContent":[{"text":"A view is a snapshot of the world it came from: changing the world while you iterate doesn’t","type":"text"},{"text":" ","type":"text"},{"text":"change what the view shows, though the first write to each component type copies that type’s","type":"text"},{"type":"text","text":" "},{"type":"text","text":"storage. To change components while you visit them, use one of the world’s "},{"code":"update","type":"codeVoice"},{"type":"text","text":" methods"},{"type":"text","text":" "},{"type":"text","text":"instead."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Narrow a view with the same methods a "},{"type":"reference","identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/Query","isActive":true},{"type":"text","text":" offers, such as "},{"type":"reference","identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/QueryView\/with(_:)","isActive":true},{"type":"text","text":" and"},{"type":"text","text":" "},{"type":"reference","identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/QueryView\/without(_:)","isActive":true},{"type":"text","text":". Each returns a new view."}]},{"type":"paragraph","inlineContent":[{"text":"Rows come in the order of the list the view walks: the storage of the queried or required type","type":"text"},{"text":" ","type":"text"},{"text":"that the fewest entities hold, or a shorter list where one applies, such as a target’s sources","type":"text"},{"text":" ","type":"text"},{"text":"for ","type":"text"},{"isActive":true,"identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/QueryView\/related(_:to:)","type":"reference"},{"type":"text","text":" or a cached query’s entities. That order depends only on the steps that"},{"type":"text","text":" "},{"type":"text","text":"built the world, so it’s the same every time you run the same steps."}]}],"kind":"content"}],"sections":[],"schemaVersion":{"major":0,"minor":3,"patch":0},"kind":"symbol","references":{"doc://WorldModule/documentation/WorldModule/Query":{"role":"symbol","type":"topic","abstract":[{"type":"text","text":"A description of the entities to visit and the components to read from each."}],"identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/Query","url":"\/documentation\/worldmodule\/query","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"Query"}],"kind":"symbol","navigatorTitle":[{"kind":"identifier","text":"Query"}],"title":"Query"},"doc://WorldModule/documentation/WorldModule/QueryView/filtered(by:)":{"identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/QueryView\/filtered(by:)","title":"filtered(by:)","kind":"symbol","role":"symbol","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"filtered","kind":"identifier"},{"text":"(","kind":"text"},{"text":"by","kind":"externalParam"},{"text":": ","kind":"text"},{"kind":"typeIdentifier","preciseIdentifier":"s:11WorldModule11QueryFilterV","text":"QueryFilter"},{"kind":"text","text":") -> "},{"kind":"typeIdentifier","preciseIdentifier":"s:11WorldModule9QueryViewV","text":"QueryView"},{"kind":"text","text":"<repeat each "},{"kind":"typeIdentifier","text":"C"},{"kind":"text","text":">"}],"abstract":[{"type":"text","text":"Returns a view that also requires every condition of the given filter."}],"url":"\/documentation\/worldmodule\/queryview\/filtered(by:)","type":"topic"},"doc://WorldModule/documentation/WorldModule/AnyOf":{"role":"symbol","type":"topic","abstract":[{"text":"A gro