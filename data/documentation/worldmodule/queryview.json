orld = World()","world.spawn(Name(value: \"comet\"), Velocity(dx: 3, dy: 4))","world.spawn(Name(value: \"statue\"), Velocity(dx: 1, dy: 1), Frozen())","","for (_, name, velocity) in world.query(Name.self, Velocity.self).without(Frozen.self) {","    print(name.value, velocity.dx)","    \/\/ Prints \"comet 3.0\"","}"],"type":"codeListing"},{"inlineContent":[{"text":"A view is a snapshot of the world it came from: changing the world while you iterate doesn’t","type":"text"},{"text":" ","type":"text"},{"text":"change what the view shows, though the first write to each component type copies that type’s","type":"text"},{"text":" ","type":"text"},{"text":"storage. To change components while you visit them, use one of the world’s ","type":"text"},{"type":"codeVoice","code":"update"},{"text":" methods","type":"text"},{"text":" ","type":"text"},{"text":"instead.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"Narrow a view with the same methods a "},{"identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/Query","type":"reference","isActive":true},{"type":"text","text":" offers, such as "},{"identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/QueryView\/with(_:)","type":"reference","isActive":true},{"type":"text","text":" and"},{"type":"text","text":" "},{"identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/QueryView\/without(_:)","type":"reference","isActive":true},{"type":"text","text":". Each returns a new view."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"Rows come in the order of the list the view walks: the storage of the queried or required type"},{"type":"text","text":" "},{"type":"text","text":"that the fewest entities hold, or a shorter list where one applies, such as a target’s sources"},{"type":"text","text":" "},{"type":"text","text":"for "},{"type":"reference","isActive":true,"identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/QueryView\/related(_:to:)"},{"type":"text","text":" or a cached query’s entities. That order depends only on the steps that"},{"type":"text","text":" "},{"type":"text","text":"built the world, so it’s the same every time you run the same steps."}],"type":"paragraph"}]}],"hierarchy":{"paths":[["doc:\/\/WorldModule\/documentation\/WorldModule"]]},"abstract":[{"text":"A lazy sequence of the entities that match a query, with the components the query reads.","type":"text"}],"references":{"doc://WorldModule/documentation/WorldModule/AnyOf":{"type":"topic","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"AnyOf"}],"kind":"symbol","role":"symbol","title":"AnyOf","url":"\/documentation\/worldmodule\/anyof","abstract":[{"type":"text","text":"A group of types an entity matches by matching at least one of them."}],"identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/AnyOf","navigatorTitle":[{"kind":"identifier","text":"AnyOf"}]},"doc://WorldModule/s8SendableP":{"title":"Swift.Sendable","identifier":"doc:\/\/WorldModule\/s8SendableP","type":"unresolvable"},"doc://WorldModule/documentation/WorldModule/EntitiesView":{"type":"topic","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"EntitiesView"}],"kind":"symbol","role":"symbol","title":"EntitiesView","url":"\/documentation\/worldmodule\/entitiesview","abstract":[{"text":"A sequence of the live entities of a world, in slot order.","type":"text"}],"identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/EntitiesView","navigatorTitle":[{"kind":"identifier","text":"EntitiesView"}]},"doc://WorldModule/documentation/WorldModule/QueryView/allowing(_:)":{"abstract":[{"type":"text","text":"Returns a view that also includes the entities holding the given disabling components."}],"fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"allowing"},{"kind":"text","text":"<each "},{"kind":"genericParameter","text":"F"},{"kind":