ng","code":["var world = World()","world.spawn(Name(value: \"comet\"), Velocity(dx: 3, dy: 4))","world.spawn(Name(value: \"statue\"), Velocity(dx: 1, dy: 1), Frozen())","","for (_, name, velocity) in world.query(Name.self, Velocity.self).without(Frozen.self) {","    print(name.value, velocity.dx)","    \/\/ Prints \"comet 3.0\"","}"],"syntax":"swift"},{"type":"paragraph","inlineContent":[{"type":"text","text":"A view is a snapshot of the world it came from: changing the world while you iterate doesn’t"},{"type":"text","text":" "},{"type":"text","text":"change what the view shows, though the first write to each component type copies that type’s"},{"type":"text","text":" "},{"type":"text","text":"storage. To change components while you visit them, use one of the world’s "},{"code":"update","type":"codeVoice"},{"type":"text","text":" methods"},{"type":"text","text":" "},{"type":"text","text":"instead."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Narrow a view with the same methods a "},{"type":"reference","isActive":true,"identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/Query"},{"type":"text","text":" offers, such as "},{"type":"reference","isActive":true,"identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/QueryView\/with(_:)"},{"type":"text","text":" and"},{"type":"text","text":" "},{"type":"reference","isActive":true,"identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/QueryView\/without(_:)"},{"type":"text","text":". Each returns a new view."}]},{"type":"paragraph","inlineContent":[{"text":"Rows come in the order of the list the view walks: the storage of the queried or required type","type":"text"},{"text":" ","type":"text"},{"text":"that the fewest entities hold, or a shorter list where one applies, such as a target’s sources","type":"text"},{"text":" ","type":"text"},{"text":"for ","type":"text"},{"isActive":true,"identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/QueryView\/related(_:to:)","type":"reference"},{"text":" or a cached query’s entities. That order depends only on the steps that","type":"text"},{"text":" ","type":"text"},{"text":"built the world, so it’s the same every time you run the same steps.","type":"text"}]}]}],"sections":[],"abstract":[{"type":"text","text":"A lazy sequence of the entities that match a query, with the components the query reads."}],"schemaVersion":{"major":0,"patch":0,"minor":3},"references":{"doc://WorldModule/documentation/WorldModule/QueryView/changed(_:since:)":{"fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"changed"},{"kind":"text","text":"<"},{"kind":"genericParameter","text":"F"},{"kind":"text","text":">("},{"text":"F","kind":"typeIdentifier"},{"text":".Type, ","kind":"text"},{"text":"since","kind":"externalParam"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:11WorldModule10ChangeTickV","text":"ChangeTick","kind":"typeIdentifier"},{"text":"?) -> ","kind":"text"},{"preciseIdentifier":"s:11WorldModule9QueryViewV","text":"QueryView","kind":"typeIdentifier"},{"text":"<repeat each ","kind":"text"},{"text":"C","kind":"typeIdentifier"},{"text":">","kind":"text"}],"abstract":[{"text":"Returns a view that also requires a component added or changed after the given tick.","type":"text"}],"type":"topic","url":"\/documentation\/worldmodule\/queryview\/changed(_:since:)","title":"changed(_:since:)","role":"symbol","identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/QueryView\/changed(_:since:)","kind":"symbol"},"doc://WorldModule/s8SendableP":{"identifier":"doc:\/\/WorldModule\/s8SendableP","title":"Swift.Sendable","type":"unresolvable"},"doc://WorldModule/documentation/WorldModule/QueryView/added(_:since:)":{"abstract":[{"text":"Returns a view that also requires a component added after the given tick.","type":"text"}],"role":"symbol","kind":"symbol","type":"topic","identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/QueryView\/added(_:since:)","titl