"text"},{"text":"matter:","type":"text"}],"type":"paragraph"},{"syntax":"swift","code":["var recorded = World()","let first = recorded.spawn(Position(x: 0, y: 0))","recorded.spawn(Position(x: 5, y: 5))","","var replayed = recorded","replayed.remove(Position.self, from: first)","replayed.insert(Position(x: 0, y: 0), into: first)","","print(replayed.snapshot(Position.self) == recorded.snapshot(Position.self))","\/\/ Prints \"true\""],"type":"codeListing"},{"inlineContent":[{"type":"text","text":"Two snapshots are equal only if their slots, generations and order of vacated slots"},{"type":"text","text":" "},{"type":"text","text":"match, so equal worlds also hand out the same handles from later spawns. Children must be"},{"type":"text","text":" "},{"type":"text","text":"in the same order."}],"type":"paragraph"},{"name":"Complexity","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"O("},{"type":"emphasis","inlineContent":[{"text":"n","type":"text"}]},{"type":"text","text":" log "},{"type":"emphasis","inlineContent":[{"text":"n","type":"text"}]},{"type":"text","text":"), where "},{"type":"emphasis","inlineContent":[{"type":"text","text":"n"}]},{"type":"text","text":" is the number of entities and components."}]}],"type":"aside","style":"note"}],"kind":"content"}],"references":{"doc://WorldModule/documentation/WorldModule/WorldSnapshot":{"title":"WorldSnapshot","kind":"symbol","url":"\/documentation\/worldmodule\/worldsnapshot","type":"topic","abstract":[{"type":"text","text":"A saved copy of a world’s entities, hierarchy and the components of the listed types."}],"role":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"WorldSnapshot","kind":"identifier"}],"navigatorTitle":[{"text":"WorldSnapshot","kind":"identifier"}],"identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/WorldSnapshot"},"doc://WorldModule/documentation/WorldModule/WorldSnapshot/==(_:_:)":{"fragments":[{"kind":"keyword","text":"static