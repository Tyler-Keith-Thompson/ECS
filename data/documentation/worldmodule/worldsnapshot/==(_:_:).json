 into: first)","","print(replayed.snapshot(Position.self) == recorded.snapshot(Position.self))","\/\/ Prints \"true\""],"type":"codeListing"},{"inlineContent":[{"type":"text","text":"Two snapshots are equal only if their slots, generations and order of vacated slots"},{"type":"text","text":" "},{"type":"text","text":"match, so equal worlds also hand out the same handles from later spawns. Children must be"},{"type":"text","text":" "},{"type":"text","text":"in the same order."}],"type":"paragraph"},{"style":"note","name":"Complexity","content":[{"type":"paragraph","inlineContent":[{"text":"O(","type":"text"},{"inlineContent":[{"type":"text","text":"n"}],"type":"emphasis"},{"text":" log ","type":"text"},{"inlineContent":[{"type":"text","text":"n"}],"type":"emphasis"},{"text":"), where ","type":"text"},{"inlineContent":[{"type":"text","text":"n"}],"type":"emphasis"},{"text":" is the number of entities and components.","type":"text"}]}],"type":"aside"}]}],"variants":[{"paths":["\/documentation\/worldmodule\/worldsnapshot\/==(_:_:)"],"traits":[{"interfaceLanguage":"swift"}]}],"sections":[],"abstract":[{"type":"text","text":"Returns a Boolean value indicating whether two snapshots hold the same entities,"},{"type":"text","text":" "},{"type":"text","text":"hierarchy and components."}],"references":{"doc://WorldModule/documentation/WorldModule/WorldSnapshot":{"url":"\/documentation\/worldmodule\/worldsnapshot","kind":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"WorldSnapshot","kind":"identifier"}],"type":"topic","identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/WorldSnapshot","title":"WorldSnapshot","navigatorTitle":[{"text":"WorldSnapshot","kind":"identifier"}],"role":"symbol","abstract":[{"type":"text","text":"A saved copy of a world’s entities, hierarchy and the components of the listed types."}]},"doc://WorldModule/documentation/WorldModule":{"kind":"symbol","abstract":[{"text":"Store the state of a game or si