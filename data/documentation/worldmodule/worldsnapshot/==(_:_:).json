","type":"text"},{"text":" ","type":"text"},{"text":"matter:","type":"text"}]},{"type":"codeListing","code":["var recorded = World()","let first = recorded.spawn(Position(x: 0, y: 0))","recorded.spawn(Position(x: 5, y: 5))","","var replayed = recorded","replayed.remove(Position.self, from: first)","replayed.insert(Position(x: 0, y: 0), into: first)","","print(replayed.snapshot(Position.self) == recorded.snapshot(Position.self))","\/\/ Prints \"true\""],"syntax":"swift"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Two snapshots are equal only if their slots, generations and order of vacated slots"},{"type":"text","text":" "},{"type":"text","text":"match, so equal worlds also hand out the same handles from later spawns. Children must be"},{"type":"text","text":" "},{"type":"text","text":"in the same order."}]},{"name":"Complexity","content":[{"type":"paragraph","inlineContent":[{"text":"O(","type":"text"},{"inlineContent":[{"text":"n","type":"text"}],"type":"emphasis"},{"text":" log ","type":"text"},{"inlineContent":[{"type":"text","text":"n"}],"type":"emphasis"},{"text":"), where ","type":"text"},{"inlineContent":[{"type":"text","text":"n"}],"type":"emphasis"},{"text":" is the number of entities and components.","type":"text"}]}],"type":"aside","style":"note"}]}],"references":{"doc://WorldModule/documentation/WorldModule/WorldSnapshot":{"abstract":[{"type":"text","text":"A saved copy of a world’s entities, hierarchy and the components of the listed types."}],"kind":"symbol","url":"\/documentation\/worldmodule\/worldsnapshot","role":"symbol","navigatorTitle":[{"text":"WorldSnapshot","kind":"identifier"}],"identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/WorldSnapshot","type":"topic","title":"WorldSnapshot","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"WorldSnapshot","kind":"identifier"}]},"doc://WorldModule/documentation/WorldModule/WorldSnapshot/==(_:_:)":{"url":"\/documentation\/worldmodule\/worldsna