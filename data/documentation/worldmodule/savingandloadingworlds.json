{"variants":[{"paths":["\/documentation\/worldmodule\/savingandloadingworlds"],"traits":[{"interfaceLanguage":"swift"}]}],"sections":[],"hierarchy":{"paths":[["doc:\/\/WorldModule\/documentation\/WorldModule"]]},"schemaVersion":{"major":0,"patch":0,"minor":3},"seeAlsoSections":[{"title":"Saving and Loading Worlds","generated":true,"identifiers":["doc:\/\/WorldModule\/documentation\/WorldModule\/WorldSnapshot","doc:\/\/WorldModule\/documentation\/WorldModule\/Scene","doc:\/\/WorldModule\/documentation\/WorldModule\/TypeRegistry","doc:\/\/WorldModule\/documentation\/WorldModule\/TypeRegistryError","doc:\/\/WorldModule\/documentation\/WorldModule\/TypeRegistryLookupError","doc:\/\/WorldModule\/documentation\/WorldModule\/MapEntities"],"anchor":"Saving-and-Loading-Worlds"}],"kind":"article","metadata":{"roleHeading":"Article","role":"article","title":"Saving and Loading Worlds","modules":[{"name":"WorldModule"}]},"primaryContentSections":[{"content":[{"text":"Overview","anchor":"Overview","type":"heading","level":2},{"inlineContent":[{"text":"A ","type":"text"},{"identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/World","type":"reference","isActive":true},{"text":" is a value, so keeping a copy in memory is as simple as assigning it to another","type":"text"},{"text":" ","type":"text"},{"text":"variable. To keep a world beyond the life of your program, such as in a save file, or to send it","type":"text"},{"text":" ","type":"text"},{"text":"somewhere else, encode it. WorldModule offers two ways to do that:","type":"text"}],"type":"paragraph"},{"items":[{"content":[{"inlineContent":[{"text":"A ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/WorldSnapshot"},{"text":" saves the components of the types you list each time you take one. It’s the","type":"text"},{"text":" ","type":"text"},{"text":"quickest way to save a few types, and to compare two worlds.","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"A "},{"type":"reference","identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/Scene","isActive":true},{"type":"text","text":" saves the components and resources of the types a "},{"type":"reference","identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/TypeRegistry","isActive":true},{"type":"text","text":" names, so you"},{"type":"text","text":" "},{"type":"text","text":"list your types once. A scene can also be spawned into another world as new entities."}],"type":"paragraph"}]}],"type":"unorderedList"},{"inlineContent":[{"type":"text","text":"Both save every entity, live or stale, and the hierarchy ("},{"identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/ChildOf","type":"reference","isActive":true},{"type":"text","text":"). Neither saves hooks,"},{"type":"text","text":" "},{"type":"text","text":"observers, caches, indexes or change ticks."}],"type":"paragraph"},{"text":"Make Your Types Codable","anchor":"Make-Your-Types-Codable","type":"heading","level":3},{"inlineContent":[{"type":"text","text":"Every component and resource type you save must conform to "},{"type":"codeVoice","code":"Codable"},{"type":"text","text":". Swift synthesizes the"},{"type":"text","text":" "},{"type":"text","text":"conformance for most types, so declaring it is usually enough:"}],"type":"paragraph"},{"syntax":"swift","code":["extension Position: Codable, Equatable {}","extension Health: Codable {}","extension Name: Codable {}","","struct Treasury: Resource, Codable { var gold: Int }"],"type":"codeListing"},{"text":"Take a Snapshot","anchor":"Take-a-Snapshot","type":"heading","level":3},{"inlineContent":[{"text":"Call ","type":"text"},{"identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/World\/snapshot(_:)","type":"reference","isActive":true},{"text":" with the component types to save. The snapshot is ","type":"text"},{"type":"codeVoice","code":"Codable"},{"text":", so any","type":"text"},{"text":" ","type":"text"},{"text":"encoder can write it, and ","type":"text"},{"type":"codeVoice","code":"World(restoring:)"},{"text":" rebuilds the world from it:","type":"text"}],"type":"paragraph"},{"syntax":"swift","code":["import Foundation","","var world = World()","let knight = world.spawn(Name(value: \"Knight\"), Health(current: 10))","let data = try JSONEncoder().encode(world.snapshot(Name.self, Health.self))","","let snapshot = try JSONDecoder().decode(WorldSnapshot<Name, Health>.self, from: data)","let restored = World(restoring: snapshot)","print(restored[Health.self, of: knight])","\/\/ Prints \"Health(current: 10)\""],"type":"codeListing"},{"inlineContent":[{"text":"Entity handles mean the same in the restored world as in the original, so ","type":"text"},{"type":"codeVoice","code":"knight"},{"text":" still names","type":"text"},{"text":" ","type":"text"},{"text":"the knight. Components of types you didn’t list are left out.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"When every saved type is "},{"type":"codeVoice","code":"Equatable"},{"type":"text","text":", so is the snapshot. Comparing two snapshots compares the"},{"type":"text","text":" "},{"type":"text","text":"worlds they were taken of, which is useful for checking that a replay reproduces a recording:"}],"type":"paragraph"},{"syntax":"swift","code":["var recorded = World()","let runner = recorded.spawn(Position(x: 0, y: 0))","recorded[Position.self, of: runner].x += 1","","var replayed = World()","let replayedRunner = replayed.spawn(Position(x: 0, y: 0))","replayed[Position.self, of: replayedRunner].x += 1","","print(replayed.snapshot(Position.self) == recorded.snapshot(Position.self))","\/\/ Prints \"true\""],"type":"codeListing"},{"text":"Save Whole Worlds with Scenes","anchor":"Save-Whole-Worlds-with-Scenes","type":"heading","level":3},{"inlineContent":[{"type":"text","text":"Register the types your program saves in a "},{"identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/TypeRegistry","isActive":true,"type":"reference"},{"type":"text","text":", once, under names of your choosing."},{"type":"text","text":" "},{"type":"text","text":"Then "},{"identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/World\/scene(_:)","isActive":true,"type":"reference"},{"type":"text","text":" saves every registered type a world holds. Decoding a scene needs the"},{"type":"text","text":" "},{"type":"text","text":"same registry, passed in the decoder’s "},{"code":"userInfo","type":"codeVoice"},{"type":"text","text":" under "},{"code":"CodingUserInfoKey.typeRegistry","type":"codeVoice"},{"type":"text","text":":"}],"type":"paragraph"},{"syntax":"swift","code":["import Foundation","","var registry = TypeRegistry()","try registry.register(Name.self, named: \"Name\")","try registry.register(Health.self, named: \"Health\")","try registry.register(resource: Treasury.self, named: \"Treasury\")","","var world = World()","world.resources.insert(Treasury(gold: 250))","let castle = world.spawn(Name(value: \"Castle\"))","let guardian = world.spawn(Name(value: \"Guard\"), Health(current: 12))","try world.addChild(guardian, to: castle)","let data = try JSONEncoder().encode(world.scene(registry))","","let decoder = JSONDecoder()","decoder.userInfo[.typeRegistry] = registry","let restored = World(restoring: try decoder.decode(Scene.self, from: data))","print(restored.children(of: castle) == [guardian])","\/\/ Prints \"true\"","print(restored.resources[Treasury.self].gold)","\/\/ Prints \"250\""],"type":"codeListing"},{"inlineContent":[{"type":"text","text":"The names identify the types in saved data. Choose names of your own rather than relying on the"},{"type":"text","text":" "},{"type":"text","text":"default, the type’s full name, so that saved data stays readable after you rename a type or its"},{"type":"text","text":" "},{"type":"text","text":"module."}],"type":"paragraph"},{"text":"Save Relations","anchor":"Save-Relations","type":"heading","level":3},{"inlineContent":[{"type":"text","text":"A scene saves the hierarchy without being asked. To save another "},{"type":"reference","identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/Relation","isActive":true},{"type":"text","text":", make it "},{"type":"codeVoice","code":"Codable"},{"type":"text","text":" "},{"type":"text","text":"and register its "},{"type":"reference","identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/Targets","isActive":true},{"type":"text","text":" component:"}],"type":"paragraph"},{"syntax":"swift","code":["import Foundation","","extension Likes: Codable {}","","var registry = TypeRegistry()","try registry.register(Targets<Likes>.self, named: \"Likes\")","","var world = World()","let alice = world.spawn()","let bob = world.spawn()","world.relate(alice, Likes(), to: bob)","let data = try JSONEncoder().encode(world.scene(registry))","","let decoder = JSONDecoder()","decoder.userInfo[.typeRegistry] = registry","let restored = World(restoring: try decoder.decode(Scene.self, from: data))","print(restored.sources(Likes.self, of: bob) == [alice])","\/\/ Prints \"true\""],"type":"codeListing"},{"text":"Spawn Saved Entities into a World","anchor":"Spawn-Saved-Entities-into-a-World","type":"heading","level":3},{"inlineContent":[{"type":"text","text":"Restoring a scene replaces a whole world. To add a scene’s entities to an existing world instead,"},{"type":"text","text":" "},{"type":"text","text":"as you would to place a saved enemy squad or a room of a level, call"},{"type":"text","text":" "},{"identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/World\/spawn(contentsOf:)-7g753","type":"reference","isActive":true},{"type":"text","text":". Each of the scene’s live entities is spawned as a new entity, and"},{"type":"text","text":" "},{"type":"text","text":"the method returns the new entity for each of the scene’s:"}],"type":"paragraph"},{"syntax":"swift","code":["var registry = TypeRegistry()","try registry.register(Name.self, named: \"Name\")","try registry.register(Health.self, named: \"Health\")","","var prefab = World()","let goblin = prefab.spawn(Name(value: \"Goblin\"), Health(current: 4))","let saved = prefab.scene(registry)","","var world = World()","let first = world.spawn(contentsOf: saved)","let second = world.spawn(contentsOf: saved)","print(world.count)","\/\/ Prints \"2\"","print(first[goblin] == second[goblin])","\/\/ Prints \"false\""],"type":"codeListing"},{"inlineContent":[{"type":"text","text":"Components that store entity handles must point at the new entities, not the scene’s. Relations"},{"type":"text","text":" "},{"type":"text","text":"and the hierarchy are updated for you. Conform your own components that store handles to"},{"type":"text","text":" "},{"identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/MapEntities","type":"reference","isActive":true},{"type":"text","text":" so that "},{"type":"codeVoice","code":"spawn(contentsOf:)"},{"type":"text","text":" can update them too."}],"type":"paragraph"},{"text":"Reach Components and Resources by Name","anchor":"Reach-Components-and-Resources-by-Name","type":"heading","level":3},{"inlineContent":[{"type":"text","text":"A registry also lets code that knows only names read and write single values: a scripting host"},{"type":"text","text":" "},{"type":"text","text":"that exposes components to scripts, a debugger, or an inspector. Read a component with"},{"type":"text","text":" "},{"type":"reference","identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/TypeRegistry\/component(named:of:in:)","isActive":true},{"type":"text","text":", which returns it as a "},{"type":"codeVoice","code":"Codable"},{"type":"text","text":" value, and insert one"},{"type":"text","text":" "},{"type":"text","text":"with "},{"type":"reference","identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/TypeRegistry\/insert(componentNamed:into:in:decode:)","isActive":true},{"type":"text","text":", whose closure decodes the"},{"type":"text","text":" "},{"type":"text","text":"registered type with any decoder:"}],"type":"paragraph"},{"syntax":"swift","code":["import Foundation","","var registry = TypeRegistry()","try registry.register(Health.self, named: \"Health\")","","var world = World()","let goblin = world.spawn(Health(current: 4))","","let health = registry.component(named: \"Health\", of: goblin, in: world)","let data = try JSONEncoder().encode(health)","print(String(decoding: data, as: UTF8.self))","\/\/ Prints \"{\"current\":4}\"","","let healed = Data(#\"{\"current\": 9}\"#.utf8)","try registry.insert(componentNamed: \"Health\", into: goblin, in: &world) { type in","    try JSONDecoder().decode(type, from: healed)","}","print(world[Health.self, of: goblin].current)","\/\/ Prints \"9\""],"type":"codeListing"},{"inlineContent":[{"text":"When the name comes from outside your program, use the checked spellings, such as","type":"text"},{"text":" ","type":"text"},{"isActive":true,"identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/TypeRegistry\/component(checkedNamed:of:in:)","type":"reference"},{"text":", which throw a ","type":"text"},{"isActive":true,"identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/TypeRegistryLookupError","type":"reference"},{"text":" for a","type":"text"},{"text":" ","type":"text"},{"text":"name that isn’t registered, a stale entity or a missing value. Resources have the same pair:","type":"text"},{"text":" ","type":"text"},{"isActive":true,"identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/TypeRegistry\/resource(named:in:)","type":"reference"},{"text":" and ","type":"text"},{"isActive":true,"identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/TypeRegistry\/insert(resourceNamed:into:decode:)","type":"reference"},{"text":".","type":"text"}],"type":"paragraph"}],"kind":"content"}],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/WorldModule\/documentation\/WorldModule\/SavingAndLoadingWorlds"},"abstract":[{"type":"text","text":"Save a world’s entities and components, restore them later, and spawn saved groups of entities"},{"type":"text","text":" "},{"type":"text","text":"into other worlds."}],"references":{"doc://WorldModule/documentation/WorldModule":{"abstract":[{"type":"text","text":"Store the state of a game or simulation as entities and components, and read and change it with"},{"type":"text","text":" "},{"type":"text","text":"queries, updates, and commands."}],"role":"collection","title":"WorldModule","kind":"symbol","identifier":"doc:\/\/WorldModule\/documentation\/WorldModule","url":"\/documentation\/worldmodule","type":"topic"},"doc://WorldModule/documentation/WorldModule/TypeRegistry/insert(resourceNamed:into:decode:)":{"abstract":[{"text":"Decodes a resource of the type registered under a name and inserts it, replacing any of","type":"text"},{"text":" ","type":"text"},{"text":"the same type.","type":"text"}],"url":"\/documentation\/worldmodule\/typeregistry\/insert(resourcenamed:into:decode:)","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"insert"},{"kind":"text","text":"("},{"text":"resourceNamed","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"String","preciseIdentifier":"s:SS","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"into","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"inout","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Resources","kind":"typeIdentifier","preciseIdentifier":"s:11WorldModule9ResourcesV"},{"text":", ","kind":"text"},{"text":"decode","kind":"externalParam"},{"text":": (any ","kind":"text"},{"text":"Decodable","kind":"typeIdentifier","preciseIdentifier":"s:Se"},{"text":".Type) ","kind":"text"},{"text":"throws","kind":"keyword"},{"text":" -> any ","kind":"text"},{"text":"Decodable","preciseIdentifier":"s:Se","kind":"typeIdentifier"},{"text":") ","kind":"text"},{"text":"rethrows","kind":"keyword"}],"role":"symbol","type":"topic","kind":"symbol","identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/TypeRegistry\/insert(resourceNamed:into:decode:)","title":"insert(resourceNamed:into:decode:)"},"doc://WorldModule/documentation/WorldModule/TypeRegistry/component(named:of:in:)":{"role":"symbol","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"component","kind":"identifier"},{"text":"(","kind":"text"},{"text":"named","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"String","preciseIdentifier":"s:SS","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"of","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"Entity","preciseIdentifier":"s:11WorldModule6EntityV","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"in","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"World","preciseIdentifier":"s:11WorldModule0A0V","kind":"typeIdentifier"},{"text":") -> any ","kind":"text"},{"text":"Component","preciseIdentifier":"s:11WorldModule9ComponentP","kind":"typeIdentifier"},{"text":" & ","kind":"text"},{"text":"Codable","preciseIdentifier":"s:s7Codablea","kind":"typeIdentifier"}],"type":"topic","title":"component(named:of:in:)","kind":"symbol","url":"\/documentation\/worldmodule\/typeregistry\/component(named:of:in:)","abstract":[{"type":"text","text":"Returns the component of the type registered under a name that an entity holds."}],"identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/TypeRegistry\/component(named:of:in:)"},"doc://WorldModule/documentation/WorldModule/TypeRegistry/insert(componentNamed:into:in:decode:)":{"abstract":[{"text":"Decodes a component of the type registered under a name and inserts it into an entity.","type":"text"}],"identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/TypeRegistry\/insert(componentNamed:into:in:decode:)","type":"topic","role":"symbol","title":"insert(componentNamed:into:in:decode:)","kind":"symbol","url":"\/documentation\/worldmodule\/typeregistry\/insert(componentnamed:into:in:decode:)","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"insert"},{"kind":"text","text":"("},{"kind":"externalParam","text":"componentNamed"},{"kind":"text","text":": "},{"preciseIdentifier":"s:SS","kind":"typeIdentifier","text":"String"},{"kind":"text","text":", "},{"kind":"externalParam","text":"into"},{"kind":"text","text":": "},{"preciseIdentifier":"s:11WorldModule6EntityV","kind":"typeIdentifier","text":"Entity"},{"kind":"text","text":", "},{"kind":"externalParam","text":"in"},{"kind":"text","text":": "},{"kind":"keyword","text":"inout"},{"kind":"text","text":" "},{"preciseIdentifier":"s:11WorldModule0A0V","kind":"typeIdentifier","text":"World"},{"kind":"text","text":", "},{"kind":"externalParam","text":"decode"},{"kind":"text","text":": (any "},{"preciseIdentifier":"s:Se","kind":"typeIdentifier","text":"Decodable"},{"kind":"text","text":".Type) "},{"kind":"keyword","text":"throws"},{"kind":"text","text":" -> any "},{"preciseIdentifier":"s:Se","kind":"typeIdentifier","text":"Decodable"},{"kind":"text","text":") "},{"kind":"keyword","text":"rethrows"}]},"doc://WorldModule/documentation/WorldModule/MapEntities":{"identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/MapEntities","fragments":[{"kind":"keyword","text":"protocol"},{"kind":"text","text":" "},{"kind":"identifier","text":"MapEntities"}],"kind":"symbol","type":"topic","abstract":[{"text":"A type whose values name other entities, which can be pointed at different entities.","type":"text"}],"role":"symbol","title":"MapEntities","url":"\/documentation\/worldmodule\/mapentities","navigatorTitle":[{"kind":"identifier","text":"MapEntities"}]},"doc://WorldModule/documentation/WorldModule/World/snapshot(_:)":{"abstract":[{"type":"text","text":"Returns a snapshot of the world’s entities, hierarchy and the components of the given"},{"type":"text","text":" "},{"type":"text","text":"types."}],"identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/World\/snapshot(_:)","type":"topic","role":"symbol","title":"snapshot(_:)","kind":"symbol","url":"\/documentation\/worldmodule\/world\/snapshot(_:)","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"snapshot"},{"kind":"text","text":"<each "},{"kind":"genericParameter","text":"C"},{"kind":"text","text":">(repeat (each "},{"kind":"typeIdentifier","text":"C"},{"kind":"text","text":").Type) -> "},{"kind":"typeIdentifier","preciseIdentifier":"s:11WorldModule0A8SnapshotV","text":"WorldSnapshot"},{"kind":"text","text":"<repeat each "},{"kind":"typeIdentifier","text":"C"},{"kind":"text","text":">"}]},"doc://WorldModule/documentation/WorldModule/TypeRegistry":{"abstract":[{"text":"A list of the component and resource types that a scene saves, each under a name that","type":"text"},{"text":" ","type":"text"},{"text":"identifies it in saved data.","type":"text"}],"identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/TypeRegistry","type":"topic","role":"symbol","navigatorTitle":[{"text":"TypeRegistry","kind":"identifier"}],"title":"TypeRegistry","kind":"symbol","url":"\/documentation\/worldmodule\/typeregistry","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"TypeRegistry","kind":"identifier"}]},"doc://WorldModule/documentation/WorldModule/Relation":{"abstract":[{"type":"text","text":"A type that describes a kind of link from one entity to others."}],"role":"symbol","title":"Relation","fragments":[{"text":"protocol","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Relation","kind":"identifier"}],"kind":"symbol","identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/Relation","navigatorTitle":[{"text":"Relation","kind":"identifier"}],"url":"\/documentation\/worldmodule\/relation","type":"topic"},"doc://WorldModule/documentation/WorldModule/Scene":{"abstract":[{"text":"A saved copy of a world’s entities, hierarchy, and the components and resources of the types","type":"text"},{"text":" ","type":"text"},{"text":"a registry names.","type":"text"}],"url":"\/documentation\/worldmodule\/scene","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"Scene"}],"role":"symbol","navigatorTitle":[{"kind":"identifier","text":"Scene"}],"type":"topic","kind":"symbol","identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/Scene","title":"Scene"},"doc://WorldModule/documentation/WorldModule/WorldSnapshot":{"abstract":[{"type":"text","text":"A saved copy of a world’s entities, hierarchy and the components of the listed types."}],"identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/WorldSnapshot","type":"topic","role":"symbol","navigatorTitle":[{"text":"WorldSnapshot","kind":"identifier"}],"title":"WorldSnapshot","kind":"symbol","url":"\/documentation\/worldmodule\/worldsnapshot","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"WorldSnapshot","kind":"identifier"}]},"doc://WorldModule/documentation/WorldModule/World":{"identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/World","title":"World","type":"topic","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"World","kind":"identifier"}],"abstract":[{"text":"A collection of entities, the components they hold, and resources.","type":"text"}],"role":"symbol","kind":"symbol","navigatorTitle":[{"text":"World","kind":"identifier"}],"url":"\/documentation\/worldmodule\/world"},"doc://WorldModule/documentation/WorldModule/ChildOf":{"abstract":[{"type":"text","text":"The relation that links a child entity to its parent."}],"role":"symbol","title":"ChildOf","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"ChildOf"}],"kind":"symbol","identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/ChildOf","navigatorTitle":[{"kind":"identifier","text":"ChildOf"}],"url":"\/documentation\/worldmodule\/childof","type":"topic"},"doc://WorldModule/documentation/WorldModule/World/scene(_:)":{"abstract":[{"text":"Returns a scene of the world’s entities, hierarchy, and the components and resources of","type":"text"},{"text":" ","type":"text"},{"text":"the types a registry names.","type":"text"}],"url":"\/documentation\/worldmodule\/world\/scene(_:)","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"scene"},{"kind":"text","text":"("},{"preciseIdentifier":"s:11WorldModule12TypeRegistryV","text":"TypeRegistry","kind":"typeIdentifier"},{"text":") -> ","kind":"text"},{"preciseIdentifier":"s:11WorldModule5SceneV","text":"Scene","kind":"typeIdentifier"}],"role":"symbol","type":"topic","kind":"symbol","identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/World\/scene(_:)","title":"scene(_:)"},"doc://WorldModule/documentation/WorldModule/TypeRegistryLookupError":{"abstract":[{"type":"text","text":"An error that indicates why a "},{"identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/TypeRegistry","isActive":true,"type":"reference"},{"type":"text","text":" couldn’t reach a component or resource by"},{"type":"text","text":" "},{"type":"text","text":"name."}],"identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/TypeRegistryLookupError","type":"topic","role":"symbol","navigatorTitle":[{"kind":"identifier","text":"TypeRegistryLookupError"}],"kind":"symbol","title":"TypeRegistryLookupError","url":"\/documentation\/worldmodule\/typeregistrylookuperror","fragments":[{"kind":"keyword","text":"enum"},{"kind":"text","text":" "},{"kind":"identifier","text":"TypeRegistryLookupError"}]},"doc://WorldModule/documentation/WorldModule/Targets":{"navigatorTitle":[{"kind":"identifier","text":"Targets"}],"kind":"symbol","role":"symbol","url":"\/documentation\/worldmodule\/targets","type":"topic","title":"Targets","identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/Targets","abstract":[{"type":"text","