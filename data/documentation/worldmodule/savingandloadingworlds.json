nd":"typeIdentifier","text":"C"},{"text":">","kind":"text"}],"type":"topic","role":"symbol","kind":"symbol","abstract":[{"type":"text","text":"Returns a snapshot of the world’s entities, hierarchy and the components of the given"},{"type":"text","text":" "},{"type":"text","text":"types."}],"title":"snapshot(_:)","identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/World\/snapshot(_:)"},"doc://WorldModule/documentation/WorldModule/TypeRegistryLookupError":{"kind":"symbol","url":"\/documentation\/worldmodule\/typeregistrylookuperror","identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/TypeRegistryLookupError","title":"TypeRegistryLookupError","role":"symbol","navigatorTitle":[{"kind":"identifier","text":"TypeRegistryLookupError"}],"type":"topic","fragments":[{"text":"enum","kind":"keyword"},{"text":" ","kind":"text"},{"kind":"identifier","text":"TypeRegistryLookupError"}],"abstract":[{"text":"An error that indicates why a ","type":"text"},{"identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/TypeRegistry","type":"reference","isActive":true},{"text":" couldn’t reach a component or resource by","type":"text"},{"text":" ","type":"text"},{"text":"name.","type":"text"}]},"doc://WorldModule/documentation/WorldModule/World":{"role":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"World","kind":"identifier"}],"abstract":[{"text":"A collection of entities, the components they hold, and resources.","type":"text"}],"url":"\/documentation\/worldmodule\/world","type":"topic","navigatorTitle":[{"text":"World","kind":"identifier"}],"title":"World","kind":"symbol","identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/World"},"doc://WorldModule/documentation/WorldModule/World/scene(_:)":{"url":"\/documentation\/worldmodule\/world\/scene(_:)","title":"scene(_:)","abstract":[{"type":"text","text":"Returns a scene of the world’s entities, hierarchy, and the components and resources of"},{"type":"text","te