"}],"abstract":[{"type":"text","text":"An error that indicates why a type couldn’t be registered in a "},{"identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/TypeRegistry","type":"reference","isActive":true},{"type":"text","text":"."}],"identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/TypeRegistryError","title":"TypeRegistryError","role":"symbol","url":"\/documentation\/worldmodule\/typeregistryerror","navigatorTitle":[{"text":"TypeRegistryError","kind":"identifier"}],"type":"topic","kind":"symbol"},"doc://WorldModule/documentation/WorldModule/World/spawn(contentsOf:)-7g753":{"fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"spawn"},{"kind":"text","text":"("},{"text":"contentsOf","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"Scene","kind":"typeIdentifier","preciseIdentifier":"s:11WorldModule5SceneV"},{"text":") -> [","kind":"text"},{"text":"Entity","kind":"typeIdentifier","preciseIdentifier":"s:11WorldModule6EntityV"},{"text":" : ","kind":"text"},{"text":"Entity","kind":"typeIdentifier","preciseIdentifier":"s:11WorldModule6EntityV"},{"text":"]","kind":"text"}],"abstract":[{"text":"Adds the entities of a scene to the world as new entities, and inserts the scene’s","type":"text"},{"text":" ","type":"text"},{"text":"resources.","type":"text"}],"identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/World\/spawn(contentsOf:)-7g753","title":"spawn(contentsOf:)","role":"symbol","url":"\/documentation\/worldmodule\/world\/spawn(contentsof:)-7g753","type":"topic","kind":"symbol"},"doc://WorldModule/documentation/WorldModule/TypeRegistry/component(named:of:in:)":{"fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"component","kind":"identifier"},{"text":"(","kind":"text"},{"text":"named","kind":"externalParam"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:SS","text":"String","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"of","kind":"externalParam"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:11WorldModule6EntityV","text":"Entity","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"in","kind":"externalParam"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:11WorldModule0A0V","text":"World","kind":"typeIdentifier"},{"text":") -> any ","kind":"text"},{"preciseIdentifier":"s:11WorldModule9ComponentP","text":"Component","kind":"typeIdentifier"},{"text":" & ","kind":"text"},{"preciseIdentifier":"s:s7Codablea","text":"Codable","kind":"typeIdentifier"}],"abstract":[{"type":"text","text":"Returns the component of the type registered under a name that an entity holds."}],"identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/TypeRegistry\/component(named:of:in:)","title":"component(named:of:in:)","role":"symbol","url":"\/documentation\/worldmodule\/typeregistry\/component(named:of:in:)","type":"topic","kind":"symbol"},"doc://WorldModule/documentation/WorldModule/TypeRegistry/insert(componentNamed:into:in:decode:)":{"fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"insert","kind":"identifier"},{"text":"(","kind":"text"},{"text":"componentNamed","kind":"externalParam"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:SS","text":"String","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"into","kind":"externalParam"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:11WorldModule6EntityV","text":"Entity","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"in","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"inout","kind":"keyword"},{"text":" ","kind":"text"},{"preciseIdentifier":"s:11WorldModule0A0V","text":"World","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"decode","kind":"externalParam"},{"text":": (any ","kind":"text"},{"preciseIdentifier":"s:Se","text":"Decodable","kind":"typeIdentifier"},{"text":".Type) ","kind":"text"},{"text":"throws","kind":"keyword"},{"text":" -> any ","kind":"text"},{"preciseIdentifier":"s:Se","text":"Decodable","kind":"typeIdentifier"},{"text":") ","kind":"text"},{"text":"rethrows","kind":"keyword"}],"identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/TypeRegistry\/insert(componentNamed:into:in:decode:)","kind":"symbol","abstract":[{"type":"text","text":"Decodes a component of the type registered under a name and inserts it into an entity."}],"url":"\/documentation\/worldmodule\/typeregistry\/insert(componentnamed:into:in:decode:)","title":"insert(componentNamed:into:in:decode:)","type":"topic","role":"symbol"},"doc://WorldModule/documentation/WorldModule/Targets":{"role":"symbol","type":"topic","abstract":[{"type":"text","text":"The component that holds a source entity’s targets of a relation, with the relation’s value"},{"type":"text","text":" "},{"type":"text","text":"for each."}],"identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/Targets","url":"\/documentation\/worldmodule\/targets","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"Targets"}],"kind":"symbol","navigatorTitle":[{"kind":"identifier","text":"Targets"}],"title":"Targets"},"doc://WorldModule/documentation/WorldModule/TypeRegistry/component(checkedNamed:of:in:)":{"abstract":[{"type":"text","text":"Returns the component of the type registered under a name that an entity holds, throwing"},{"type":"text","text":" "},{"type":"text","text":"an error if there is none."}],"role":"symbol","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"component"},{"kind":"text","text":"("},{"text":"checkedNamed","kind":"externalParam"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:SS","text":"String","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"of","kind":"externalParam"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:11WorldModule6EntityV","text":"Entity","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"in","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"World","preciseIdentifier":"s:11WorldModule0A0V","kind":"typeIdentifier"},{"text":") ","kind":"text"},{"text":"throws","kind":"keyword"},{"text":"(","kind":"text"},{"text":"TypeRegistryLookupError","kind":"typeIdentifier","preciseIdentifier":"s:11WorldModule23TypeRegistryLookupErrorO"},{"text":") -> any ","kind":"text"},{"text":"Component","kind":"typeIdentifier","preciseIdentifier":"s:11WorldModule9ComponentP"},{"text":" & ","kind":"text"},{"text":"Codable","kind":"typeIdentifier","preciseIdentifier":"s:s7Codablea"}],"identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/TypeRegistry\/component(checkedNamed:of:in:)","type":"topic","kind":"symbol","title":"component(checkedNamed:of:in:)","url":"\/documentation\/worldmodule\/typeregistry\/component(checkednamed:of:in:)"},"doc://WorldModule/documentation/WorldModule/MapEntities":{"fragments":[{"text":"protocol","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MapEntities","kind":"identifier"}],"abstract":[{"text":"A type whose values name other entities, which can be pointed at different entities.","type":"text"}],"identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/MapEntities","title":"MapEntities","role":"symbol","url":"\/documentation\/worldmodule\/mapentities","navigatorTitle":[{"text":"MapEntities","kind":"identifier"}],"type":"topic","kind":"symbol"},"doc://WorldModule/documentation/WorldModule/Relation":{"role":"symbol","abstract":[{"text":"A type that describes a kind of link from one entity to others.","type":"text"}],"type":"topic","identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/Relation","url":"\/documentation\/worldmodule\/relation","fragments":[{"text":"protocol","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Relation","kind":"identifier"}],"kind":"symbol","navigatorTitle":[{"text":"Relation","kind":"identifier"}],"title":"Relation"},"doc://WorldModule/documentation/WorldModule/TypeRegistry/insert(re