eIdentifier":"s:s7Codablea"}],"title":"component(named:of:in:)"},"doc://WorldModule/documentation/WorldModule":{"type":"topic","kind":"symbol","role":"collection","title":"WorldModule","abstract":[{"type":"text","text":"Store the state of a game or simulation as entities and components, and read and change it with"},{"type":"text","text":" "},{"type":"text","text":"queries, updates, and commands."}],"url":"\/documentation\/worldmodule","identifier":"doc:\/\/WorldModule\/documentation\/WorldModule"},"doc://WorldModule/documentation/WorldModule/MapEntities":{"url":"\/documentation\/worldmodule\/mapentities","kind":"symbol","role":"symbol","identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/MapEntities","title":"MapEntities","fragments":[{"text":"protocol","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MapEntities","kind":"identifier"}],"navigatorTitle":[{"text":"MapEntities","kind":"identifier"}],"type":"topic","abstract":[{"text":"A type whose values name other entities, which can be pointed at different entities.","type":"text"}]},"doc://WorldModule/documentation/WorldModule/Targets":{"navigatorTitle":[{"kind":"identifier","text":"Targets"}],"kind":"symbol","type":"topic","role":"symbol","title":"Targets","abstract":[{"type":"text","text":"The component that holds a source entity’s targets of a relation, with the relation’s value"},{"type":"text","text":" "},{"type":"text","text":"for each."}],"url":"\/documentation\/worldmodule\/targets","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"Targets"}],"identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/Targets"},"doc://WorldModule/documentation/WorldModule/Scene":{"role":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Scene","kind":"identifier"}],"url":"\/documentation\/worldmodule\/scene","identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/Scene","title":"Scene","abstract":[{"text"