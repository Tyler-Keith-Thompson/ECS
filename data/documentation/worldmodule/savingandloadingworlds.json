{"seeAlsoSections":[{"generated":true,"identifiers":["doc:\/\/WorldModule\/documentation\/WorldModule\/WorldSnapshot","doc:\/\/WorldModule\/documentation\/WorldModule\/Scene","doc:\/\/WorldModule\/documentation\/WorldModule\/TypeRegistry","doc:\/\/WorldModule\/documentation\/WorldModule\/TypeRegistryError","doc:\/\/WorldModule\/documentation\/WorldModule\/MapEntities"],"title":"Saving and Loading Worlds","anchor":"Saving-and-Loading-Worlds"}],"primaryContentSections":[{"content":[{"text":"Overview","level":2,"anchor":"Overview","type":"heading"},{"inlineContent":[{"text":"A ","type":"text"},{"identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/World","isActive":true,"type":"reference"},{"text":" is a value, so keeping a copy in memory is as simple as assigning it to another","type":"text"},{"text":" ","type":"text"},{"text":"variable. To keep a world beyond the life of your program, such as in a save file, or to send it","type":"text"},{"text":" ","type":"text"},{"text":"somewhere else, encode it. WorldModule offers two ways to do that:","type":"text"}],"type":"paragraph"},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"A "},{"type":"reference","isActive":true,"identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/WorldSnapshot"},{"type":"text","text":" saves the components of the types you list each time you take one. It’s the"},{"type":"text","text":" "},{"type":"text","text":"quickest way to save a few types, and to compare two worlds."}]}]},{"content":[{"inlineContent":[{"type":"text","text":"A "},{"identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/Scene","type":"reference","isActive":true},{"type":"text","text":" saves the components and resources of the types a "},{"identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/TypeRegistry","type":"reference","isActive":true},{"type":"text","text":" names, so you"},{"type":"text","text":" "},{"type":"text","text":"list your types once. A scene can also be spawned into another world as new entities."}],"type":"paragraph"}]}]},{"inlineContent":[{"type":"text","text":"Both save every entity, live or stale, and the hierarchy ("},{"isActive":true,"type":"reference","identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/ChildOf"},{"type":"text","text":"). Neither saves hooks,"},{"type":"text","text":" "},{"type":"text","text":"observers, caches, indexes or change ticks."}],"type":"paragraph"},{"text":"Make Your Types Codable","level":3,"anchor":"Make-Your-Types-Codable","type":"heading"},{"inlineContent":[{"text":"Every component and resource type you save must conform to ","type":"text"},{"code":"Codable","type":"codeVoice"},{"text":". Swift synthesizes the","type":"text"},{"text":" ","type":"text"},{"text":"conformance for most types, so declaring it is usually enough:","type":"text"}],"type":"paragraph"},{"code":["extension Position: Codable, Equatable {}","extension Health: Codable {}","extension Name: Codable {}","","struct Treasury: Resource, Codable { var gold: Int }"],"type":"codeListing","syntax":"swift"},{"text":"Take a Snapshot","level":3,"anchor":"Take-a-Snapshot","type":"heading"},{"inlineContent":[{"type":"text","text":"Call "},{"type":"reference","identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/World\/snapshot(_:)","isActive":true},{"type":"text","text":" with the component types to save. The snapshot is "},{"type":"codeVoice","code":"Codable"},{"type":"text","text":", so any"},{"type":"text","text":" "},{"type":"text","text":"encoder can write it, and "},{"type":"codeVoice","code":"World(restoring:)"},{"type":"text","text":" rebuilds the world from it:"}],"type":"paragraph"},{"code":["import Foundation","","var world = World()","let knight = world.spawn(Name(value: \"Knight\"), Health(current: 10))","let data = try JSONEncoder().encode(world.snapshot(Name.self, Health.self))","","let snapshot = try JSONDecoder().decode(WorldSnapshot<Name, Health>.self, from: data)","let restored = World(restoring: snapshot)","print(restored[Health.self, of: knight])","\/\/ Prints \"Health(current: 10)\""],"type":"codeListing","syntax":"swift"},{"inlineContent":[{"type":"text","text":"Entity handles mean the same in the restored world as in the original, so "},{"code":"knight","type":"codeVoice"},{"type":"text","text":" still names"},{"type":"text","text":" "},{"type":"text","text":"the knight. Components of types you didn’t list are left out."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"When every saved type is "},{"type":"codeVoice","code":"Equatable"},{"type":"text","text":", so is the snapshot. Comparing two snapshots compares the"},{"type":"text","text":" "},{"type":"text","text":"worlds they were taken of, which is useful for checking that a replay reproduces a recording:"}],"type":"paragraph"},{"code":["var recorded = World()","let runner = recorded.spawn(Position(x: 0, y: 0))","recorded[Position.self, of: runner].x += 1","","var replayed = World()","let replayedRunner = replayed.spawn(Position(x: 0, y: 0))","replayed[Position.self, of: replayedRunner].x += 1","","print(replayed.snapshot(Position.self) == recorded.snapshot(Position.self))","\/\/ Prints \"true\""],"type":"codeListing","syntax":"swift"},{"text":"Save Whole Worlds with Scenes","level":3,"anchor":"Save-Whole-Worlds-with-Scenes","type":"heading"},{"inlineContent":[{"text":"Register the types your program saves in a ","type":"text"},{"identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/TypeRegistry","isActive":true,"type":"reference"},{"text":", once, under names of your choosing.","type":"text"},{"text":" ","type":"text"},{"text":"Then ","type":"text"},{"identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/World\/scene(_:)","isActive":true,"type":"reference"},{"text":" saves every registered type a world holds. Decoding a scene needs the","type":"text"},{"text":" ","type":"text"},{"text":"same registry, passed in the decoder’s ","type":"text"},{"code":"userInfo","type":"codeVoice"},{"text":" under ","type":"text"},{"code":"CodingUserInfoKey.typeRegistry","type":"codeVoice"},{"text":":","type":"text"}],"type":"paragraph"},{"code":["import Foundation","","var registry = TypeRegistry()","try registry.register(Name.self, named: \"Name\")","try registry.register(Health.self, named: \"Health\")","try registry.register(resource: Treasury.self, named: \"Treasury\")","","var world = World()","world.resources.insert(Treasury(gold: 250))","let castle = world.spawn(Name(value: \"Castle\"))","let guardian = world.spawn(Name(value: \"Guard\"), Health(current: 12))","try world.addChild(guardian, to: castle)","let data = try JSONEncoder().encode(world.scene(registry))","","let decoder = JSONDecoder()","decoder.userInfo[.typeRegistry] = registry","let restored = World(restoring: try decoder.decode(Scene.self, from: data))","print(restored.children(of: castle) == [guardian])","\/\/ Prints \"true\"","print(restored.resources[Treasury.self].gold)","\/\/ Prints \"250\""],"type":"codeListing","syntax":"swift"},{"inlineContent":[{"text":"The names identify the types in saved data. Choose names of your own rather than relying on the","type":"text"},{"text":" ","type":"text"},{"text":"default, the type’s full name, so that saved data stays readable after you rename a type or its","type":"text"},{"text":" ","type":"text"},{"text":"module.","type":"text"}],"type":"paragraph"},{"text":"Save Relations","level":3,"anchor":"Save-Relations","type":"heading"},{"inlineContent":[{"text":"A scene saves the hierarchy without being asked. To save another ","type":"text"},{"identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/Relation","isActive":true,"type":"reference"},{"text":", make it ","type":"text"},{"code":"Codable","type":"codeVoice"},{"text":" ","type":"text"},{"text":"and register its ","type":"text"},{"identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/Targets","isActive":true,"type":"reference"},{"text":" component:","type":"text"}],"type":"paragraph"},{"code":["import Foundation","","extension Likes: Codable {}","","var registry = TypeRegistry()","try registry.register(Targets<Likes>.self, named: \"Likes\")","","var world = World()","let alice = world.spawn()","let bob = world.spawn()","world.relate(alice, Likes(), to: bob)","let data = try JSONEncoder().encode(world.scene(registry))","","let decoder = JSONDecoder()","decoder.userInfo[.typeRegistry] = registry","let restored = World(restoring: try decoder.decode(Scene.self, from: data))","print(restored.sources(Likes.self, of: bob) == [alice])","\/\/ Prints \"true\""],"type":"codeListing","syntax":"swift"},{"text":"Spawn Saved Entities into a World","level":3,"anchor":"Spawn-Saved-Entities-into-a-World","type":"heading"},{"inlineContent":[{"type":"text","text":"Restoring a scene replaces a whole world. To add a scene’s entities to an existing world instead,"},{"type":"text","text":" "},{"type":"text","text":"as you would to place a saved enemy squad or a room of a level, call"},{"type":"text","text":" "},{"identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/World\/spawn(contentsOf:)","type":"reference","isActive":true},{"type":"text","text":". Each of the scene’s live entities is spawned as a new entity, and"},{"type":"text","text":" "},{"type":"text","text":"the method returns the new entity for each of the scene’s:"}],"type":"paragraph"},{"code":["var registry = TypeRegistry()","try registry.register(Name.self, named: \"Name\")","try registry.register(Health.self, named: \"Health\")","","var prefab = World()","let goblin = prefab.spawn(Name(value: \"Goblin\"), Health(current: 4))","let saved = prefab.scene(registry)","","var world = World()","let first = world.spawn(contentsOf: saved)","let second = world.spawn(contentsOf: saved)","print(world.count)","\/\/ Prints \"2\"","print(first[goblin] == second[goblin])","\/\/ Prints \"false\""],"type":"codeListing","syntax":"swift"},{"inlineContent":[{"type":"text","text":"Components that store entity handles must point at the new entities, not the scene’s. Relations"},{"type":"text","text":" "},{"type":"text","text":"and the hierarchy are updated for you. Conform your own components that store handles to"},{"type":"text","text":" "},{"isActive":true,"type":"reference","identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/MapEntities"},{"type":"text","text":" so that "},{"type":"codeVoice","code":"spawn(contentsOf:)"},{"type":"text","text":" can update them too."}],"type":"paragraph"}],"kind":"content"}],"hierarchy":{"paths":[["doc:\/\/WorldModule\/documentation\/WorldModule"]]},"metadata":{"title":"Saving and Loading Worlds","modules":[{"name":"WorldModule"}],"role":"article","roleHeading":"Article"},"sections":[],"kind":"article","abstract":[{"type":"text","text":"Save a world’s entities and components, restore them later, and spawn saved groups of entities"},{"type":"text","text":" "},{"type":"text","text":"into other worlds."}],"variants":[{"paths":["\/documentation\/worldmodule\/savingandloadingworlds"],"traits":[{"interfaceLanguage":"swift"}]}],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/WorldModule\/documentation\/WorldModule\/SavingAndLoadingWorlds"},"schemaVersion":{"minor":3,"patch":0,"major":0},"references":{"doc://WorldModule/documentation/WorldModule/World/scene(_:)":{"identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/World\/scene(_:)","url":"\/documentation\/worldmodule\/world\/scene(_:)","kind":"symbol","type":"topic","title":"scene(_:)","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"scene"},{"kind":"text","text":"("},{"kind":"typeIdentifier","text":"TypeRegistry","preciseIdentifier":"s:11WorldModule12TypeRegistryV"},{"kind":"text","text":") -> "},{"kind":"typeIdentifier","text":"Scene","preciseIdentifier":"s:11WorldModule5SceneV"}],"abstract":[{"type":"text","text":"Returns a scene of the world’s entities, hierarchy, and the components and resources of"},{"type":"text","text":" "},{"type":"text","text":"the types a registry names."}],"role":"symbol"},"doc://WorldModule/documentation/WorldModule/Relation":{"navigatorTitle":[{"kind":"identifier","text":"Relation"}],"fragments":[{"kind":"keyword","text":"protocol"},{"kind":"text","text":" "},{"kind":"identifier","text":"Relation"}],"kind":"symbol","abstract":[{"type":"text","text":"A type that describes a kind of link from one entity to others."}],"url":"\/documentation\/worldmodule\/relation","title":"Relation","identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/Relation","role":"symbol","type":"topic"},"doc://WorldModule/documentation/WorldModule/World/spawn(contentsOf:)":{"kind":"symbol","type":"topic","identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/World\/spawn(contentsOf:)","title":"spawn(contentsOf:)","url":"\/documentation\/worldmodule\/world\/spawn(contentsof:)","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"spawn"},{"kind":"text","text":"("},{"text":"contentsOf","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"Scene","preciseIdentifier":"s:11WorldModule5SceneV","kind":"typeIdentifier"},{"text":") -> [","kind":"text"},{"text":"Entity","preciseIdentifier":"s:11WorldModule6EntityV","kind":"typeIdentifier"},{"text":" : ","kind":"text"},{"text":"Entity","preciseIdentifier":"s:11WorldModule6EntityV","kind":"typeIdentifier"},{"kind":"text","text":"]"}],"abstract":[{"type":"text","text":"Adds the entities of a scene to the world as new entities, and inserts the scene’s"},{"type":"text","text":" "},{"type":"text","text":"resources."}],"role":"symbol"},"doc://WorldModule/documentation/WorldModule/MapEntities":{"type":"topic","navigatorTitle":[{"kind":"identifier","text":"MapEntities"}],"fragments":[{"kind":"keyword","text":"protocol"},{"kind":"text","text":" "},{"kind":"identifier","text":"MapEntities"}],"abstract":[{"type":"text","text":"A type whose values name other entities, which can be pointed at different entities."}],"role":"symbol","title":"MapEntities","identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/MapEntities","url":"\/documentation\/worldmodule\/mapentities","kind":"symbol"},"doc://WorldModule/documentation/WorldModule":{"type":"topic","identifier":"doc:\/\/WorldModule\/documentation\/WorldModule","url":"\/documentation\/worldmodule","role":"collection","title":"WorldModule","kind":"symbol","abstract":[{"text":"Store the state of a game or simulation as entities and components, and read and change it with","type":"text"},{"text":" ","type":"text"},{"text":"queries, updates, and commands.","type":"text"}]},"doc://WorldModule/documentation/WorldModule/WorldSnapshot":{"url":"\/documentation\/worldmodule\/worldsnapshot","kind":"symbol","type":"topic","title":"WorldSnapshot","identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/WorldSnapshot","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"WorldSnapshot"}],"abstract":[{"text":"A saved copy of a world’s entities, hierarchy and the components of the listed types.","type":"text"}],"role":"symbol","navigatorTitle":[{"kind":"identifier","text":"WorldSnapshot"}]},"doc://WorldModule/documentation/WorldModule/World/snapshot(_:)":{"title":"snapshot(_:)","role":"symbol","identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/World\/snapshot(_:)","abstract":[{"text":"Returns a snapshot of the world’s entities, hierarchy and the components of the given","type":"text"},{"text":" ","type":"text"},{"text":"types.","type":"text"}],"fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"snapshot"},{"kind":"text","text":"<each "},{"kind":"genericParameter","text":"C"},{"kind":"text","text":">(repeat (each "},{"kind":"typeIdentifier","text":"C"},{"kind":"text","text":").Type) -> "},{"kind":"typeIdentifier","preciseIdentifi