{"hierarchy":{"paths":[["doc:\/\/WorldModule\/documentation\/WorldModule"]]},"sections":[],"primaryContentSections":[{"content":[{"text":"Overview","type":"heading","anchor":"Overview","level":2},{"type":"paragraph","inlineContent":[{"type":"text","text":"A "},{"type":"reference","identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/World","isActive":true},{"type":"text","text":" is a value, so keeping a copy in memory is as simple as assigning it to another"},{"type":"text","text":" "},{"type":"text","text":"variable. To keep a world beyond the life of your program, such as in a save file, or to send it"},{"type":"text","text":" "},{"type":"text","text":"somewhere else, encode it. WorldModule offers two ways to do that:"}]},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"text":"A ","type":"text"},{"type":"reference","identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/WorldSnapshot","isActive":true},{"text":" saves the components of the types you list each time you take one. It’s the","type":"text"},{"text":" ","type":"text"},{"text":"quickest way to save a few types, and to compare two worlds.","type":"text"}]}]},{"content":[{"inlineContent":[{"type":"text","text":"A "},{"type":"reference","isActive":true,"identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/Scene"},{"type":"text","text":" saves the components and resources of the types a "},{"type":"reference","isActive":true,"identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/TypeRegistry"},{"type":"text","text":" names, so you"},{"type":"text","text":" "},{"type":"text","text":"list your types once. A scene can also be spawned into another world as new entities."}],"type":"paragraph"}]}]},{"type":"paragraph","inlineContent":[{"text":"Both save every entity, live or stale, and the hierarchy (","type":"text"},{"identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/ChildOf","isActive":true,"type":"reference"},{"text":"). Neither saves hooks,","type":"text"},{"text":" ","type":"text"},{"text":"observers, caches, indexes or change ticks.","type":"text"}]},{"text":"Make Your Types Codable","type":"heading","anchor":"Make-Your-Types-Codable","level":3},{"type":"paragraph","inlineContent":[{"type":"text","text":"Every component and resource type you save must conform to "},{"type":"codeVoice","code":"Codable"},{"type":"text","text":". Swift synthesizes the"},{"type":"text","text":" "},{"type":"text","text":"conformance for most types, so declaring it is usually enough:"}]},{"type":"codeListing","code":["extension Position: Codable, Equatable {}","extension Health: Codable {}","extension Name: Codable {}","","struct Treasury: Resource, Codable { var gold: Int }"],"syntax":"swift"},{"text":"Take a Snapshot","type":"heading","anchor":"Take-a-Snapshot","level":3},{"type":"paragraph","inlineContent":[{"type":"text","text":"Call "},{"type":"reference","isActive":true,"identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/World\/snapshot(_:)"},{"type":"text","text":" with the component types to save. The snapshot is "},{"code":"Codable","type":"codeVoice"},{"type":"text","text":", so any"},{"type":"text","text":" "},{"type":"text","text":"encoder can write it, and "},{"code":"World(restoring:)","type":"codeVoice"},{"type":"text","text":" rebuilds the world from it:"}]},{"type":"codeListing","code":["import Foundation","","var world = World()","let knight = world.spawn(Name(value: \"Knight\"), Health(current: 10))","let data = try JSONEncoder().encode(world.snapshot(Name.self, Health.self))","","let snapshot = try JSONDecoder().decode(WorldSnapshot<Name, Health>.self, from: data)","let restored = World(restoring: snapshot)","print(restored[Health.self, of: knight])","\/\/ Prints \"Health(current: 10)\""],"syntax":"swift"},{"type":"paragraph","inlineContent":[{"text":"Entity handles mean the same in the restored world as in the original, so ","type":"text"},{"code":"knight","type":"codeVoice"},{"text":" still names","type":"text"},{"text":" ","type":"text"},{"text":"the knight. Components of types you didn’t list are left out.","type":"text"}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"When every saved type is "},{"type":"codeVoice","code":"Equatable"},{"type":"text","text":", so is the snapshot. Comparing two snapshots compares the"},{"type":"text","text":" "},{"type":"text","text":"worlds they were taken of, which is useful for checking that a replay reproduces a recording:"}]},{"type":"codeListing","code":["var recorded = World()","let runner = recorded.spawn(Position(x: 0, y: 0))","recorded[Position.self, of: runner].x += 1","","var replayed = World()","let replayedRunner = replayed.spawn(Position(x: 0, y: 0))","replayed[Position.self, of: replayedRunner].x += 1","","print(replayed.snapshot(Position.self) == recorded.snapshot(Position.self))","\/\/ Prints \"true\""],"syntax":"swift"},{"text":"Save Whole Worlds with Scenes","type":"heading","anchor":"Save-Whole-Worlds-with-Scenes","level":3},{"type":"paragraph","inlineContent":[{"type":"text","text":"Register the types your program saves in a "},{"type":"reference","identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/TypeRegistry","isActive":true},{"type":"text","text":", once, under names of your choosing."},{"type":"text","text":" "},{"type":"text","text":"Then "},{"type":"reference","identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/World\/scene(_:)","isActive":true},{"type":"text","text":" saves every registered type a world holds. Decoding a scene needs the"},{"type":"text","text":" "},{"type":"text","text":"same registry, passed in the decoder’s "},{"type":"codeVoice","code":"userInfo"},{"type":"text","text":" under "},{"type":"codeVoice","code":"CodingUserInfoKey.typeRegistry"},{"type":"text","text":":"}]},{"type":"codeListing","code":["import Foundation","","var registry = TypeRegistry()","try registry.register(Name.self, named: \"Name\")","try registry.register(Health.self, named: \"Health\")","try registry.register(resource: Treasury.self, named: \"Treasury\")","","var world = World()","world.resources.insert(Treasury(gold: 250))","let castle = world.spawn(Name(value: \"Castle\"))","let guardian = world.spawn(Name(value: \"Guard\"), Health(current: 12))","try world.addChild(guardian, to: castle)","let data = try JSONEncoder().encode(world.scene(registry))","","let decoder = JSONDecoder()","decoder.userInfo[.typeRegistry] = registry","let restored = World(restoring: try decoder.decode(Scene.self, from: data))","print(restored.children(of: castle) == [guardian])","\/\/ Prints \"true\"","print(restored.resources[Treasury.self].gold)","\/\/ Prints \"250\""],"syntax":"swift"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The names identify the types in saved data. Choose names of your own rather than relying on the"},{"type":"text","text":" "},{"type":"text","text":"default, the type’s full name, so that saved data stays readable after you rename a type or its"},{"type":"text","text":" "},{"type":"text","text":"module."}]},{"text":"Save Relations","type":"heading","anchor":"Save-Relations","level":3},{"type":"paragraph","inlineContent":[{"text":"A scene saves the hierarchy without being asked. To save another ","type":"text"},{"identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/Relation","isActive":true,"type":"reference"},{"text":", make it ","type":"text"},{"type":"codeVoice","code":"Codable"},{"text":" ","type":"text"},{"text":"and register its ","type":"text"},{"identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/Targets","isActive":true,"type":"reference"},{"text":" component:","type":"text"}]},{"type":"codeListing","code":["import Foundation","","extension Likes: Codable {}","","var registry = TypeRegistry()","try registry.register(Targets<Likes>.self, named: \"Likes\")","","var world = World()","let alice = world.spawn()","let bob = world.spawn()","world.relate(alice, Likes(), to: bob)","let data = try JSONEncoder().encode(world.scene(registry))","","let decoder = JSONDecoder()","decoder.userInfo[.typeRegistry] = registry","let restored = World(restoring: try decoder.decode(Scene.self, from: data))","print(restored.sources(Likes.self, of: bob) == [alice])","\/\/ Prints \"true\""],"syntax":"swift"},{"text":"Spawn Saved Entities into a World","type":"heading","anchor":"Spawn-Saved-Entities-into-a-World","level":3},{"type":"paragraph","inlineContent":[{"type":"text","text":"Restoring a scene replaces a whole world. To add a scene’s entities to an existing world instead,"},{"type":"text","text":" "},{"type":"text","text":"as you would to place a saved enemy squad or a room of a level, call"},{"type":"text","text":" "},{"type":"reference","identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/World\/spawn(contentsOf:)","isActive":true},{"type":"text","text":". Each of the scene’s live entities is spawned as a new entity, and"},{"type":"text","text":" "},{"type":"text","text":"the method returns the new entity for each of the scene’s:"}]},{"type":"codeListing","code":["var registry = TypeRegistry()","try registry.register(Name.self, named: \"Name\")","try registry.register(Health.self, named: \"Health\")","","var prefab = World()","let goblin = prefab.spawn(Name(value: \"Goblin\"), Health(current: 4))","let saved = prefab.scene(registry)","","var world = World()","let first = world.spawn(contentsOf: saved)","let second = world.spawn(contentsOf: saved)","print(world.count)","\/\/ Prints \"2\"","print(first[goblin] == second[goblin])","\/\/ Prints \"false\""],"syntax":"swift"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Components that store entity handles must point at the new entities, not the scene’s. Relations"},{"type":"text","text":" "},{"type":"text","text":"and the hierarchy are updated for you. Conform your own components that store handles to"},{"type":"text","text":" "},{"identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/MapEntities","type":"reference","isActive":true},{"type":"text","text":" so that "},{"type":"codeVoice","code":"spawn(contentsOf:)"},{"type":"text","text":" can update them too."}]}],"kind":"content"}],"seeAlsoSections":[{"identifiers":["doc:\/\/WorldModule\/documentation\/WorldModule\/WorldSnapshot","doc:\/\/WorldModule\/documentation\/WorldModule\/Scene","doc:\/\/WorldModule\/documentation\/WorldModule\/TypeRegistry","doc:\/\/WorldModule\/documentation\/WorldModule\/TypeRegistryError","doc:\/\/WorldModule\/documentation\/WorldModule\/MapEntities"],"generated":true,"anchor":"Saving-and-Loading-Worlds","title":"Saving and Loading Worlds"}],"metadata":{"role":"article","roleHeading":"Article","modules":[{"name":"WorldModule"}],"title":"Saving and Loading Worlds"},"schemaVersion":{"patch":0,"minor":3,"major":0},"identifier":{"url":"doc:\/\/WorldModule\/documentation\/WorldModule\/SavingAndLoadingWorlds","interfaceLanguage":"swift"},"variants":[{"paths":["\/documentation\/worldmodule\/savingandloadingworlds"],"traits":[{"interfaceLanguage":"swift"}]}],"abstract":[{"type":"text","text":"Save a world’s entities and components, restore them later, and spawn saved groups of entities"},{"type":"text","text":" "},{"type":"text","text":"into other worlds."}],"kind":"article","references":{"doc://WorldModule/documentation/WorldModule/WorldSnapshot":{"url":"\/documentation\/worldmodule\/worldsnapshot","identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/WorldSnapshot","navigatorTitle":[{"kind":"identifier","text":"WorldSnapshot"}],"role":"symbol","title":"WorldSnapshot","abstract":[{"type":"text","text":"A saved copy of a world’s entities, hierarchy and the components of the listed types."}],"kind":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"WorldSnapshot"}],"type":"topic"},"doc://WorldModule/documentation/WorldModule":{"abstract":[{"text":"Store the state of a game or simulation as entities and components, and read and change it with","type":"text"},{"text":" ","type":"text"},{"text":"queries, updates, and commands.","type":"text"}],"type":"topic","title":"WorldModule","url":"\/documentation\/worldmodule","kind":"symbol","role":"collection","identifier":"doc:\/\/WorldModule\/documentation\/WorldModule"},"doc://WorldModule/documentation/WorldModule/Relation":{"url":"\/documentation\/worldmodule\/relation","identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/Relation","navigatorTitle":[{"text":"Relation","kind":"identifier"}],"role":"symbol","title":"Relation","abstract":[{"text":"A type that describes a kind of link from one entity to others.","type":"text"}],"kind":"symbol","fragments":[{"text":"protocol","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Relation","kind":"identifier"}],"type":"topic"},"doc://WorldModule/documentation/WorldModule/Scene":{"fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Scene","kind":"identifier"}],"navigatorTitle":[{"text":"Scene","kind":"identifier"}],"title":"Scene","abstract":[{"type":"text","text":"A saved copy of a world’s entities, hierarchy, and the components and resources of the types"},{"type":"text","text":" "},{"type":"text","text":"a registry names."}],"url":"\/documentation\/worldmodule\/scene","kind":"symbol","role":"symbol","type":"topic","identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/Scene"},"doc://WorldModule/documentation/WorldModule/MapEntities":{"fragments":[{"text":"protocol","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MapEntities","kind":"identifier"}],"navigatorTitle":[{"text":"MapEntities","kind":"identifier"}],"title":"MapEntities","abstract":[{"text":"A type whose values name other entities, which can be pointed at different entities.","type":"text"}],"url":"\/documentation\/worldmodule\/mapentities","kind":"symbol","role":"symbol","type":"topic","identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/MapEntities"},"doc://WorldModule/documentation/WorldModule/World/spawn(contentsOf:)":{"fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"spawn","kind":"identifier"},{"text":"(","kind":"text"},{"text":"contentsOf","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"Scene","kind":"typeIdentifier","preciseIdentifier":"s:11WorldModule5SceneV"},{"text":") -> [","kind":"text"},{"text":"Entity","kind":"typeIdentifier","preciseIdentifier":"s:11WorldModule6EntityV"},{"text":" : ","kind":"text"},{"text":"Entity","kind":"typeIdentifier","preciseIdentifier":"s:11WorldModule6EntityV"},{"text":"]","kind":"text"}],"identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/World\/spawn(contentsOf:)","url":"\/documentation\/worldmodule\/world\/spawn(contentsof:)","role":"symbol","title":"spawn(contentsOf:)","type":"topic","abstract":[{"type":"text","text":"Adds the entities of a scene to the world as new entities, and inserts the scene’s"},{"type":"text","text":" "},{"type":"text","text":"resources."}],"kind":"symbol"},"doc://WorldModule/documentation/WorldModule/TypeRegistry":{"url":"\/documentation\/worldmodule\/typeregistry","role":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"TypeRegistry"}],"title":"TypeRegistry","kind":"symbol","navigatorTitle":[{"kind":"identifier","text":"TypeRegistry"}],"type":"topic","abstract":[{"type":"text","text":"A list of the component and resource types that a scene saves, each under a name that"},{"type":"text","text":" "},{"type":"text","text":"identifies it in saved data."}],"identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/TypeRegistry"},"doc://WorldModule/documentation/WorldModule/World/scene(_:)":{"identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/World\/scene(_:)","kind":"symbol","type":"topic","title":"scene(_:)","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"scene"},{"kind":"text","text":"("},{"kind":"typeIdentifier","text":"TypeRegistry","preciseIdentifier":"s:11WorldModule12TypeRegistryV"},{"kind":"text","text":") -> "},{"kind":"typeIdentifier","text":"Scene","preciseIdentifier":"s:11WorldModule5SceneV"}],"role":"symbol","url":"\/documentation\/worldmodule\/world\/scene(_:)","abstract":[{"type":"text","text":"Returns a scene of the world’s entities, hierarchy, and the components and resources of"},{"type":"text","text":" "},{"type":"text","text":"the types a registry names."}]},"doc://WorldModule/documentation/WorldModule/World":{"url":"\/documentation\/worldmodule\/world","identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/World","navigatorTitle":[{"text":"World","kind":"identifier"}],"role":"symbol","title":"World","abstract":[{"type":"text","text":"A collection of entities, the components they hold, and resources."}],"kind":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"World","kind":"identifier"}],"type":"topic"},"doc://WorldModule/documentation/WorldModule/Targets":{"fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"Targets"}],"url":"\/documentation\/worldmodule\/targets","identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/Targets","navigatorTitle":[{"kind":"identifier","text":"Targets"}],"role":"symbol","title":"Targets","type":"topic","kind":"symbol","abstract":[{"text":"The component that holds a source entity’s targets of a relation, with the relation’s value","type":"text"},{"text":" ","type":"text"},{"text":"for each.","type":"text"}]},"doc://WorldModule/documentation/WorldModule/TypeRegistryError":{"identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/TypeRegistryError","role":"symbol","fragments":[{"text":"enum","kind":"keyword"},{"text":" ","kind":"text"},{"text":"TypeRegistryError","kind":"identifier"}],"title":"TypeRegistryError","kind":"symbol","navigatorTitle":[{"text":"TypeRegistryError","kind":"identifier"}],"type":"topic","abstract":[{"type":"text","text":"An error that indicates why a type couldn’t be registered in a "},{"isActive":true,"type":"reference","identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/TypeRegistry"},{"type":"text","text":"."}],"url":"\/documentation\/worldmodule\/typeregistryerror"},"doc://WorldModule/documentation/WorldModule/World/snapshot(_:)":{"fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"snapshot"},{"kind":"text","text":"<each "},{"kind":"genericParameter","text":"C"},{"kind":"text","text":">(repeat (each "},{"kind":"typeIdentifier","text":"C"},{"kind":"text","text":").Type) -> "},{"kind":"typeIdentifier","text":"WorldSnapshot","preciseIdentifier":"s:11WorldModule0A8SnapshotV"},{"kind":"text","text":"<repeat each "},{"kind":"typeIdentifier","text":"C"},{"kind":"text","text":">"}],"identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/World\/snapshot(_:)","url":"\/documentation\/worldmodule\/world\/snapshot(_:)","role":"symbol","title":"snapshot(_:)","type":"topic","kind":"symbol","abstract":[{"text":"Returns a snapshot of the world’s entities, hierarchy and the components of the given","type":"text"},{"text":" ","type":"text"},{"text":"types.","type":"text"}]},"doc://WorldModule/documentation/WorldModule/ChildOf":{"fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"ChildOf"}],"identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/ChildOf","url":"\/documentation\/worldmodule\/childof","navigatorTitle":[{"kind":"identifier","text":"ChildOf"}],"role":"symbol","title":"ChildOf","type":"topic","kind":"symbol","abstract":[{"text":"The relation that links a child entity to its parent.","type":"text"}]}}}