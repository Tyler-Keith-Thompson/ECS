{"schemaVersion":{"major":0,"patch":0,"minor":3},"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/worldmodule\/savingandloadingworlds"]}],"seeAlsoSections":[{"identifiers":["doc:\/\/WorldModule\/documentation\/WorldModule\/WorldSnapshot","doc:\/\/WorldModule\/documentation\/WorldModule\/Scene","doc:\/\/WorldModule\/documentation\/WorldModule\/TypeRegistry","doc:\/\/WorldModule\/documentation\/WorldModule\/TypeRegistryError","doc:\/\/WorldModule\/documentation\/WorldModule\/TypeRegistryLookupError","doc:\/\/WorldModule\/documentation\/WorldModule\/MapEntities"],"title":"Saving and Loading Worlds","generated":true,"anchor":"Saving-and-Loading-Worlds"}],"metadata":{"title":"Saving and Loading Worlds","roleHeading":"Article","modules":[{"name":"WorldModule"}],"role":"article"},"primaryContentSections":[{"kind":"content","content":[{"type":"heading","level":2,"text":"Overview","anchor":"Overview"},{"inlineContent":[{"text":"A ","type":"text"},{"isActive":true,"identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/World","type":"reference"},{"text":" is a value, so keeping a copy in memory is as simple as assigning it to another","type":"text"},{"text":" ","type":"text"},{"text":"variable. To keep a world beyond the life of your program, such as in a save file, or to send it","type":"text"},{"text":" ","type":"text"},{"text":"somewhere else, encode it. WorldModule offers two ways to do that:","type":"text"}],"type":"paragraph"},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"text":"A ","type":"text"},{"identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/WorldSnapshot","type":"reference","isActive":true},{"text":" saves the components of the types you list each time you take one. It’s the","type":"text"},{"text":" ","type":"text"},{"text":"quickest way to save a few types, and to compare two worlds.","type":"text"}]}]},{"content":[{"inlineContent":[{"text":"A ","type":"text"},{"identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/Scene","type":"reference","isActive":true},{"text":" saves the components and resources of the types a ","type":"text"},{"identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/TypeRegistry","type":"reference","isActive":true},{"text":" names, so you","type":"text"},{"text":" ","type":"text"},{"text":"list your types once. A scene can also be spawned into another world as new entities.","type":"text"}],"type":"paragraph"}]}],"type":"unorderedList"},{"inlineContent":[{"text":"Both save every entity, live or stale, and the hierarchy (","type":"text"},{"identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/ChildOf","isActive":true,"type":"reference"},{"text":"). Neither saves hooks,","type":"text"},{"text":" ","type":"text"},{"text":"observers, caches, indexes or change ticks.","type":"text"}],"type":"paragraph"},{"type":"heading","level":3,"text":"Make Your Types Codable","anchor":"Make-Your-Types-Codable"},{"inlineContent":[{"type":"text","text":"Every component and resource type you save must conform to "},{"type":"codeVoice","code":"Codable"},{"type":"text","text":". Swift synthesizes the"},{"type":"text","text":" "},{"type":"text","text":"conformance for most types, so declaring it is usually enough:"}],"type":"paragraph"},{"syntax":"swift","type":"codeListing","code":["extension Position: Codable, Equatable {}","extension Health: Codable {}","extension Name: Codable {}","","struct Treasury: Resource, Codable { var gold: Int }"]},{"type":"heading","level":3,"text":"Take a Snapshot","anchor":"Take-a-Snapshot"},{"inlineContent":[{"type":"text","text":"Call "},{"type":"reference","isActive":true,"identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/World\/snapshot(_:)"},{"type":"text","text":" with the component types to save. The snapshot is "},{"type":"codeVoice","code":"Codable"},{"type":"text","text":", so any"},{"type":"text","text":" "},{"type":"text","text":"encoder can write it, and "},{"type":"codeVoice","code":"World(restoring:)"},{"type":"text","text":" rebuilds the world from it:"}],"type":"paragraph"},{"syntax":"swift","type":"codeListing","code":["import Foundation","","var world = World()","let knight = world.spawn(Name(value: \"Knight\"), Health(current: 10))","let data = try JSONEncoder().encode(world.snapshot(Name.self, Health.self))","","let snapshot = try JSONDecoder().decode(WorldSnapshot<Name, Health>.self, from: data)","let restored = World(restoring: snapshot)","print(restored[Health.self, of: knight])","\/\/ Prints \"Health(current: 10)\""]},{"inlineContent":[{"text":"Entity handles mean the same in the restored world as in the original, so ","type":"text"},{"type":"codeVoice","code":"knight"},{"text":" still names","type":"text"},{"text":" ","type":"text"},{"text":"the knight. Components of types you didn’t list are left out.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"When every saved type is ","type":"text"},{"code":"Equatable","type":"codeVoice"},{"text":", so is the snapshot. Comparing two snapshots compares the","type":"text"},{"text":" ","type":"text"},{"text":"worlds they were taken of, which is useful for checking that a replay reproduces a recording:","type":"text"}],"type":"paragraph"},{"syntax":"swift","type":"codeListing","code":["var recorded = World()","let runner = recorded.spawn(Position(x: 0, y: 0))","recorded[Position.self, of: runner].x += 1","","var replayed = World()","let replayedRunner = replayed.spawn(Position(x: 0, y: 0))","replayed[Position.self, of: replayedRunner].x += 1","","print(replayed.snapshot(Position.self) == recorded.snapshot(Position.self))","\/\/ Prints \"true\""]},{"type":"heading","level":3,"text":"Save Whole Worlds with Scenes","anchor":"Save-Whole-Worlds-with-Scenes"},{"inlineContent":[{"type":"text","text":"Register the types your program saves in a "},{"type":"reference","identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/TypeRegistry","isActive":true},{"type":"text","text":", once, under names of your choosing."},{"type":"text","text":" "},{"type":"text","text":"Then "},{"type":"reference","identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/World\/scene(_:)","isActive":true},{"type":"text","text":" saves every registered type a world holds. Decoding a scene needs the"},{"type":"text","text":" "},{"type":"text","text":"same registry, passed in the decoder’s "},{"type":"codeVoice","code":"userInfo"},{"type":"text","text":" under "},{"type":"codeVoice","code":"CodingUserInfoKey.typeRegistry"},{"type":"text","text":":"}],"type":"paragraph"},{"syntax":"swift","type":"codeListing","code":["import Foundation","","var registry = TypeRegistry()","try registry.register(Name.self, named: \"Name\")","try registry.register(Health.self, named: \"Health\")","try registry.register(resource: Treasury.self, named: \"Treasury\")","","var world = World()","world.resources.insert(Treasury(gold: 250))","let castle = world.spawn(Name(value: \"Castle\"))","let guardian = world.spawn(Name(value: \"Guard\"), Health(current: 12))","try world.addChild(guardian, to: castle)","let data = try JSONEncoder().encode(world.scene(registry))","","let decoder = JSONDecoder()","decoder.userInfo[.typeRegistry] = registry","let restored = World(restoring: try decoder.decode(Scene.self, from: data))","print(restored.children(of: castle) == [guardian])","\/\/ Prints \"true\"","print(restored.resources[Treasury.self].gold)","\/\/ Prints \"250\""]},{"inlineContent":[{"type":"text","text":"The names identify the types in saved data. Choose names of your own rather than relying on the"},{"type":"text","text":" "},{"type":"text","text":"default, the type’s full name, so that saved data stays readable after you rename a type or its"},{"type":"text","text":" "},{"type":"text","text":"module."}],"type":"paragraph"},{"type":"heading","level":3,"text":"Save Relations","anchor":"Save-Relations"},{"inlineContent":[{"type":"text","text":"A scene saves the hierarchy without being asked. To save another "},{"type":"reference","identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/Relation","isActive":true},{"type":"text","text":", make it "},{"code":"Codable","type":"codeVoice"},{"type":"text","text":" "},{"type":"text","text":"and register its "},{"type":"reference","identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/Targets","isActive":true},{"type":"text","text":" component:"}],"type":"paragraph"},{"syntax":"swift","type":"codeListing","code":["import Foundation","","extension Likes: Codable {}","","var registry = TypeRegistry()","try registry.register(Targets<Likes>.self, named: \"Likes\")","","var world = World()","let alice = world.spawn()","let bob = world.spawn()","world.relate(alice, Likes(), to: bob)","let data = try JSONEncoder().encode(world.scene(registry))","","let decoder = JSONDecoder()","decoder.userInfo[.typeRegistry] = registry","let restored = World(restoring: try decoder.decode(Scene.self, from: data))","print(restored.sources(Likes.self, of: bob) == [alice])","\/\/ Prints \"true\""]},{"type":"heading","level":3,"text":"Spawn Saved Entities into a World","anchor":"Spawn-Saved-Entities-into-a-World"},{"inlineContent":[{"text":"Restoring a scene replaces a whole world. To add a scene’s entities to an existing world instead,","type":"text"},{"text":" ","type":"text"},{"text":"as you would to place a saved enemy squad or a room of a level, call","type":"text"},{"text":" ","type":"text"},{"isActive":true,"identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/World\/spawn(contentsOf:)","type":"reference"},{"text":". Each of the scene’s live entities is spawned as a new entity, and","type":"text"},{"text":" ","type":"text"},{"text":"the method returns the new entity for each of the scene’s:","type":"text"}],"type":"paragraph"},{"syntax":"swift","type":"codeListing","code":["var registry = TypeRegistry()","try registry.register(Name.self, named: \"Name\")","try registry.register(Health.self, named: \"Health\")","","var prefab = World()","let goblin = prefab.spawn(Name(value: \"Goblin\"), Health(current: 4))","let saved = prefab.scene(registry)","","var world = World()","let first = world.spawn(contentsOf: saved)","let second = world.spawn(contentsOf: saved)","print(world.count)","\/\/ Prints \"2\"","print(first[goblin] == second[goblin])","\/\/ Prints \"false\""]},{"inlineContent":[{"text":"Components that store entity handles must point at the new entities, not the scene’s. Relations","type":"text"},{"text":" ","type":"text"},{"text":"and the hierarchy are updated for you. Conform your own components that store handles to","type":"text"},{"text":" ","type":"text"},{"type":"reference","isActive":true,"identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/MapEntities"},{"text":" so that ","type":"text"},{"type":"codeVoice","code":"spawn(contentsOf:)"},{"text":" can update them too.","type":"text"}],"type":"paragraph"},{"type":"heading","level":3,"text":"Reach Components and Resources by Name","anchor":"Reach-Components-and-Resources-by-Name"},{"inlineContent":[{"text":"A registry also lets code that knows only names read and write single values: a scripting host","type":"text"},{"text":" ","type":"text"},{"text":"that exposes components to scripts, a debugger, or an inspector. Read a component with","type":"text"},{"text":" ","type":"text"},{"identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/TypeRegistry\/component(named:of:in:)","type":"reference","isActive":true},{"text":", which returns it as a ","type":"text"},{"type":"codeVoice","code":"Codable"},{"text":" value, and insert one","type":"text"},{"text":" ","type":"text"},{"text":"with ","type":"text"},{"identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/TypeRegistry\/insert(componentNamed:into:in:decode:)","type":"reference","isActive":true},{"text":", whose closure decodes the","type":"text"},{"text":" ","type":"text"},{"text":"registered type with any decoder:","type":"text"}],"type":"paragraph"},{"syntax":"swift","type":"codeListing","code":["import Foundation","","var registry = TypeRegistry()","try registry.register(Health.self, named: \"Health\")","","var world = World()","let goblin = world.spawn(Health(current: 4))","","let health = registry.component(named: \"Health\", of: goblin, in: world)","let data = try JSONEncoder().encode(health)","print(String(decoding: data, as: UTF8.self))","\/\/ Prints \"{\"current\":4}\"","","let healed = Data(#\"{\"current\": 9}\"#.utf8)","try registry.insert(componentNamed: \"Health\", into: goblin, in: &world) { type in","    try JSONDecoder().decode(type, from: healed)","}","print(world[Health.self, of: goblin].current)","\/\/ Prints \"9\""]},{"inlineContent":[{"text":"When the name comes from outside your program, use the checked spellings, such as","type":"text"},{"text":" ","type":"text"},{"identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/TypeRegistry\/component(checkedNamed:of:in:)","isActive":true,"type":"reference"},{"text":", which throw a ","type":"text"},{"identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/TypeRegistryLookupError","isActive":true,"type":"reference"},{"text":" for a","type":"text"},{"text":" ","type":"text"},{"text":"name that isn’t registered, a stale entity or a missing value. Resources have the same pair:","type":"text"},{"text":" ","type":"text"},{"identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/TypeRegistry\/resource(named:in:)","isActive":true,"type":"reference"},{"text":" and ","type":"text"},{"identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/TypeRegistry\/insert(resourceNamed:into:decode:)","isActive":true,"type":"reference"},{"text":".","type":"text"}],"type":"paragraph"}]}],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/WorldModule\/documentation\/WorldModule\/SavingAndLoadingWorlds"},"hierarchy":{"paths":[["doc:\/\/WorldModule\/documentation\/WorldModule"]]},"kind":"article","sections":[],"abstract":[{"te