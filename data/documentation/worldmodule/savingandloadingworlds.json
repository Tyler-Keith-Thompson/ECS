\/Relation"},"doc://WorldModule/documentation/WorldModule/TypeRegistry/insert(componentNamed:into:in:decode:)":{"type":"topic","role":"symbol","title":"insert(componentNamed:into:in:decode:)","identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/TypeRegistry\/insert(componentNamed:into:in:decode:)","url":"\/documentation\/worldmodule\/typeregistry\/insert(componentnamed:into:in:decode:)","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"insert"},{"kind":"text","text":"("},{"kind":"externalParam","text":"componentNamed"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:SS","text":"String"},{"kind":"text","text":", "},{"kind":"externalParam","text":"into"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:11WorldModule6EntityV","text":"Entity"},{"kind":"text","text":", "},{"kind":"externalParam","text":"in"},{"kind":"text","text":": "},{"kind":"keyword","text":"inout"},{"kind":"text","text":" "},{"kind":"typeIdentifier","preciseIdentifier":"s:11WorldModule0A0V","text":"World"},{"kind":"text","text":", "},{"kind":"externalParam","text":"decode"},{"kind":"text","text":": (any "},{"kind":"typeIdentifier","preciseIdentifier":"s:Se","text":"Decodable"},{"kind":"text","text":".Type) "},{"kind":"keyword","text":"throws"},{"kind":"text","text":" -> any "},{"kind":"typeIdentifier","preciseIdentifier":"s:Se","text":"Decodable"},{"kind":"text","text":") "},{"kind":"keyword","text":"rethrows"}],"kind":"symbol","abstract":[{"type":"text","text":"Decodes a component of the type registered under a name and inserts it into an entity."}]},"doc://WorldModule/documentation/WorldModule/TypeRegistryError":{"role":"symbol","type":"topic","abstract":[{"text":"An error that indicates why a type couldn’t be registered in a ","type":"text"},{"identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/TypeRegistry","type":"reference","isActive":true},{"text":".","type":"text"}],"