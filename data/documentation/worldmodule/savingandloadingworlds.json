c","identifier":"doc:\/\/WorldModule\/documentation\/WorldModule","url":"\/documentation\/worldmodule","abstract":[{"type":"text","text":"Store the state of a game or simulation as entities and components, and read and change it with"},{"type":"text","text":" "},{"type":"text","text":"queries, updates, and commands."}],"kind":"symbol","title":"WorldModule"},"doc://WorldModule/documentation/WorldModule/WorldSnapshot":{"url":"\/documentation\/worldmodule\/worldsnapshot","kind":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"WorldSnapshot"}],"identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/WorldSnapshot","type":"topic","title":"WorldSnapshot","abstract":[{"text":"A saved copy of a world’s entities, hierarchy and the components of the listed types.","type":"text"}],"role":"symbol","navigatorTitle":[{"kind":"identifier","text":"WorldSnapshot"}]},"doc://WorldModule/documentation/WorldModule/World":{"role":"symbol","url":"\/documentation\/worldmodule\/world","navigatorTitle":[{"kind":"identifier","text":"World"}],"title":"World","type":"topic","abstract":[{"text":"A collection of entities, the components they hold, and resources.","type":"text"}],"kind":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"World"}],"identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/World"},"doc://WorldModule/documentation/WorldModule/Targets":{"role":"symbol","type":"topic","identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/Targets","kind":"symbol","abstract":[{"text":"The component that holds a source entity’s targets of a relation, with the relation’s value","type":"text"},{"text":" ","type":"text"},{"text":"for each.","type":"text"}],"url":"\/documentation\/worldmodule\/targets","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Targets","kind":"identifier"}],"navigatorTitle":[{"text":"Targets",