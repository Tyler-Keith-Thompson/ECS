, replacing any of","type":"text"},{"text":" ","type":"text"},{"text":"the same type.","type":"text"}]},"doc://WorldModule/documentation/WorldModule/TypeRegistry/component(named:of:in:)":{"kind":"symbol","url":"\/documentation\/worldmodule\/typeregistry\/component(named:of:in:)","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"component"},{"kind":"text","text":"("},{"kind":"externalParam","text":"named"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"String","preciseIdentifier":"s:SS"},{"kind":"text","text":", "},{"kind":"externalParam","text":"of"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"Entity","preciseIdentifier":"s:11WorldModule6EntityV"},{"kind":"text","text":", "},{"kind":"externalParam","text":"in"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"World","preciseIdentifier":"s:11WorldModule0A0V"},{"kind":"text","text":") -> any "},{"kind":"typeIdentifier","text":"Component","preciseIdentifier":"s:11WorldModule9ComponentP"},{"kind":"text","text":" & "},{"kind":"typeIdentifier","text":"Codable","preciseIdentifier":"s:s7Codablea"}],"role":"symbol","type":"topic","title":"component(named:of:in:)","identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/TypeRegistry\/component(named:of:in:)","abstract":[{"type":"text","text":"Returns the component of the type registered under a name that an entity holds."}]},"doc://WorldModule/documentation/WorldModule/TypeRegistry/insert(componentNamed:into:in:decode:)":{"kind":"symbol","url":"\/documentation\/worldmodule\/typeregistry\/insert(componentnamed:into:in:decode:)","type":"topic","title":"insert(componentNamed:into:in:decode:)","role":"symbol","identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/TypeRegistry\/insert(componentNamed:into:in:decode:)","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"insert"},{"kind":"text","text":"("},{"kind":"externalPara