{"variants":[{"paths":["\/documentation\/worldmodule\/savingandloadingworlds"],"traits":[{"interfaceLanguage":"swift"}]}],"seeAlsoSections":[{"generated":true,"anchor":"Saving-and-Loading-Worlds","identifiers":["doc:\/\/WorldModule\/documentation\/WorldModule\/WorldSnapshot","doc:\/\/WorldModule\/documentation\/WorldModule\/Scene","doc:\/\/WorldModule\/documentation\/WorldModule\/TypeRegistry","doc:\/\/WorldModule\/documentation\/WorldModule\/TypeRegistryError","doc:\/\/WorldModule\/documentation\/WorldModule\/MapEntities"],"title":"Saving and Loading Worlds"}],"sections":[],"schemaVersion":{"minor":3,"patch":0,"major":0},"primaryContentSections":[{"kind":"content","content":[{"text":"Overview","anchor":"Overview","type":"heading","level":2},{"type":"paragraph","inlineContent":[{"type":"text","text":"A "},{"identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/World","isActive":true,"type":"reference"},{"type":"text","text":" is a value, so keeping a copy in memory is as simple as assigning it to another"},{"type":"text","text":" "},{"type":"text","text":"variable. To keep a world beyond the life of your program, such as in a save file, or to send it"},{"type":"text","text":" "},{"type":"text","text":"somewhere else, encode it. WorldModule offers two ways to do that:"}]},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"type":"text","text":"A "},{"type":"reference","identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/WorldSnapshot","isActive":true},{"type":"text","text":" saves the components of the types you list each time you take one. It’s the"},{"type":"text","text":" "},{"type":"text","text":"quickest way to save a few types, and to compare two worlds."}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"A ","type":"text"},{"identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/Scene","type":"reference","isActive":true},{"text":" saves the components and resources of the types a ","type":"text"},{"identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/TypeRegistry","type":"reference","isActive":true},{"text":" names, so you","type":"text"},{"text":" ","type":"text"},{"text":"list your types once. A scene can also be spawned into another world as new entities.","type":"text"}]}]}]},{"type":"paragraph","inlineContent":[{"text":"Both save every entity, live or stale, and the hierarchy (","type":"text"},{"identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/ChildOf","isActive":true,"type":"reference"},{"text":"). Neither saves hooks,","type":"text"},{"text":" ","type":"text"},{"text":"observers, caches, indexes or change ticks.","type":"text"}]},{"text":"Make Your Types Codable","anchor":"Make-Your-Types-Codable","type":"heading","level":3},{"type":"paragraph","inlineContent":[{"type":"text","text":"Every component and resource type you save must conform to "},{"type":"codeVoice","code":"Codable"},{"type":"text","text":". Swift synthesizes the"},{"type":"text","text":" "},{"type":"text","text":"conformance for most types, so declaring it is usually enough:"}]},{"syntax":"swift","code":["extension Position: Codable, Equatable {}","extension Health: Codable {}","extension Name: Codable {}","","struct Treasury: Resource, Codable { var gold: Int }"],"type":"codeListing"},{"text":"Take a Snapshot","anchor":"Take-a-Snapshot","type":"heading","level":3},{"type":"paragraph","inlineContent":[{"type":"text","text":"Call "},{"identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/World\/snapshot(_:)","type":"reference","isActive":true},{"type":"text","text":" with the component types to save. The snapshot is "},{"type":"codeVoice","code":"Codable"},{"type":"text","text":", so any"},{"type":"text","text":" "},{"type":"text","text":"encoder can write it, and "},{"type":"codeVoice","code":"World(restoring:)"},{"type":"text","text":" rebuilds the world from it:"}]},{"syntax":"swift","code":["import Foundation","","var world = World()","let knight = world.spawn(Name(value: \"Knight\"), Health(current: 10))","let data = try JSONEncoder().encode(world.snapshot(Name.self, Health.self))","","let snapshot = try JSONDecoder().decode(WorldSnapshot<Name, Health>.self, from: data)","let restored = World(restoring: snapshot)","print(restored[Health.self, of: knight])","\/\/ Prints \"Health(current: 10)\""],"type":"codeListing"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Entity handles mean the same in the restored world as in the original, so "},{"type":"codeVoice","code":"knight"},{"type":"text","text":" still names"},{"type":"text","text":" "},{"type":"text","text":"the knight. Components of types you didn’t list are left out."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"When every saved type is "},{"type":"codeVoice","code":"Equatable"},{"type":"text","text":", so is the snapshot. Comparing two snapshots compares the"},{"type":"text","text":" "},{"type":"text","text":"worlds they were taken of, which is useful for checking that a replay reproduces a recording:"}]},{"syntax":"swift","code":["var recorded = World()","let runner = recorded.spawn(Position(x: 0, y: 0))","recorded[Position.self, of: runner].x += 1","","var replayed = World()","let replayedRunner = replayed.spawn(Position(x: 0, y: 0))","replayed[Position.self, of: replayedRunner].x += 1","","print(replayed.snapshot(Position.self) == recorded.snapshot(Position.self))","\/\/ Prints \"true\""],"type":"codeListing"},{"text":"Save Whole Worlds with Scenes","anchor":"Save-Whole-Worlds-with-Scenes","type":"heading","level":3},{"type":"paragraph","inlineContent":[{"text":"Register the types your program saves in a ","type":"text"},{"isActive":true,"identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/TypeRegistry","type":"reference"},{"text":", once, under names of your choosing.","type":"text"},{"text":" ","type":"text"},{"text":"Then ","type":"text"},{"isActive":true,"identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/World\/scene(_:)","type":"reference"},{"text":" saves every registered type a world holds. Decoding a scene needs the","type":"text"},{"text":" ","type":"text"},{"text":"same registry, passed in the decoder’s ","type":"text"},{"type":"codeVoice","code":"userInfo"},{"text":" under ","type":"text"},{"type":"codeVoice","code":"CodingUserInfoKey.typeRegistry"},{"text":":","type":"text"}]},{"syntax":"swift","code":["import Foundation","","var registry = TypeRegistry()","try registry.register(Name.self, named: \"Name\")","try registry.register(Health.self, named: \"Health\")","try registry.register(resource: Treasury.self, named: \"Treasury\")","","var world = World()","world.resources.insert(Treasury(gold: 250))","let castle = world.spawn(Name(value: \"Castle\"))","let guardian = world.spawn(Name(value: \"Guard\"), Health(current: 12))","try world.addChild(guardian, to: castle)","let data = try JSONEncoder().encode(world.scene(registry))","","let decoder = JSONDecoder()","decoder.userInfo[.typeRegistry] = registry","let restored = World(restoring: try decoder.decode(Scene.self, from: data))","print(restored.children(of: castle) == [guardian])","\/\/ Prints \"true\"","print(restored.resources[Treasury.self].gold)","\/\/ Prints \"250\""],"type":"codeListing"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The names identify the types in saved data. Choose names of your own rather than relying on the"},{"type":"text","text":" "},{"type":"text","text":"default, the type’s full name, so that saved data stays readable after you rename a type or its"},{"type":"text","text":" "},{"type":"text","text":"module."}]},{"text":"Save Relations","anchor":"Save-Relations","type":"heading","level":3},{"type":"paragraph","inlineContent":[{"text":"A scene saves the hierarchy without being asked. To save another ","type":"text"},{"isActive":true,"identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/Relation","type":"reference"},{"text":", make it ","type":"text"},{"code":"Codable","type":"codeVoice"},{"text":" ","type":"text"},{"text":"and register its ","type":"text"},{"isActive":true,"identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/Targets","type":"reference"},{"text":" component:","type":"text"}]},{"syntax":"swift","code":["import Foundation","","extension Likes: Codable {}","","var registry = TypeRegistry()","try registry.register(Targets<Likes>.self, named: \"Likes\")","","var world = World()","let alice = world.spawn()","let bob = world.spawn()","world.relate(alice, Likes(), to: bob)","let data = try JSONEncoder().encode(world.scene(registry))","","let decoder = JSONDecoder()","decoder.userInfo[.typeRegistry] = registry","let restored = World(restoring: try decoder.decode(Scene.self, from: data))","print(restored.sources(Likes.self, of: bob) == [alice])","\/\/ Prints \"true\""],"type":"codeListing"},{"text":"Spawn Saved Entities into a World","anchor":"Spawn-Saved-Entities-into-a-World","type":"heading","level":3},{"type":"paragraph","inlineContent":[{"type":"text","text":"Restoring a scene replaces a whole world. To add a scene’s entities to an existing world instead,"},{"type":"text","text":" "},{"type":"text","text":"as you would to place a saved enemy squad or a room of a level, call"},{"type":"text","text":" "},{"isActive":true,"type":"reference","identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/World\/spawn(contentsOf:)"},{"type":"text","text":". Each of the scene’s live entities is spawned as a new entity, and"},{"type":"text","text":" "},{"type":"text","text":"the method returns the new entity for each of the scene’s:"}]},{"syntax":"swift","code":["var registry = TypeRegistry()","try registry.register(Name.self, named: \"Name\")","try registry.register(Health.self, named: \"Health\")","","var prefab = World()","let goblin = prefab.spawn(Name(value: \"Goblin\"), Health(current: 4))","let saved = prefab.scene(registry)","","var world = World()","let first = world.spawn(contentsOf: saved)","let second = world.spawn(contentsOf: saved)","print(world.count)","\/\/ Prints \"2\"","print(first[goblin] == second[goblin])","\/\/ Prints \"false\""],"type":"codeListing"},{"type":"paragraph","inlineContent":[{"text":"Components that store entity handles must point at the new entities, not the scene’s. Relations","type":"text"},{"text":" ","type":"text"},{"text":"and the hierarchy are updated for you. Conform your own components that store handles to","type":"text"},{"text":" ","type":"text"},{"isActive":true,"identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/MapEntities","type":"reference"},{"text":" so that ","type":"text"},{"code":"spawn(contentsOf:)","type":"codeVoice"},{"text":" can update them too.","type":"text"}]}]}],"kind":"article","hierarchy":{"paths":[["doc:\/\/WorldModule\/documentation\/WorldModule"]]},"abstract":[{"text":"Save a world’s entities and components, restore them later, and spawn saved groups of entities","type":"text"},{"text":" ","type":"text"},{"text":"into other worlds.","type":"text"}],"metadata":{"roleHeading":"Article","modules":[{"name":"WorldModule"}],"role":"article","title":"Saving and Loading Worlds"},"identifier":{"url":"doc:\/\/WorldModule\/documentation\/WorldModule\/SavingAndLoadingWorlds","interfaceLanguage":"swift"},"references":{"doc://WorldModule/documentation/WorldModule/World":{"type":"topic","role":"symbol","abstract":[{"text":"A collection of entities, the components they hold, and resources.","type":"text"}],"fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"World","kind":"identifier"}],"navigatorTitle":[{"text":"World","kind":"identifier"}],"kind":"symbol","title":"World","url":"\/documentation\/worldmodule\/world","identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/World"},"doc://WorldModule/documentation/WorldModule/MapEntities":{"type":"topic","role":"symbol","abstract":[{"type":"text","text":"A type whose values name other entities, which can be pointed at different entities."}],"fragments":[{"text":"protocol","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MapEntities","kind":"identifier"}],"navigatorTitle":[{"text":"MapEntities","kind":"identifier"}],"kind":"symbol","title":"MapEntities","url":"\/documentation\/worldmodule\/mapentities","identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/MapEntities"},"doc://WorldModule/documentation/WorldModule/Relation":{"type":"topic","role":"symbol","abstract":[{"type":"text","text":"A type that describes a kind of link from one entity to others."}],"fragments":[{"kind":"keyword","text":"protocol"},{"kind":"text","text":" "},{"kind":"identifier","text":"Relation"}],"navigatorTitle":[{"kind":"identifier","text":"Relation"}],"kind":"symbol","title":"Relation","url":"\/documentation\/worldmodule\/relation","identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/Relation"},"doc://WorldModule/documentation/WorldModule/Targets":{"abstract":[{"type":"text","text":"The component that holds a source entity’s targets of a relation, with the relation’s value"},{"type":"text","text":" "},{"type":"text","text":"for each."}],"type":"topic","kind":"symbol","role":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Targets","kind":"identifier"}],"title":"Targets","navigatorTitle":[{"text":"Targets","kind":"identifier"}],"identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/Targets","url":"\/documentation\/worldmodule\/targets"},"doc://WorldModule/documentation/WorldModule/TypeRegistry":{"type":"topic","role":"symbol","abstract":[{"text":"A list of the component and resource types that a scene saves, each under a name that","type":"text"},{"text":" ","type":"text"},{"text":"identifies it in saved data.","type":"text"}],"fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"TypeRegistry","kind":"identifier"}],"navigatorTitle":[{"text":"TypeRegistry","kind":"identifier"}],"kind":"symbol","title":"TypeRegistry","url":"\/documentation\/worldmodule\/typeregistry","identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/TypeRegistry"},"doc://WorldModule/documentation/WorldModule":{"abstract":[{"type":"text","text":"Store the state of a game or simulation as entities and components, and read and change it with"},{"type":"text","text":" "},{"type":"text","text":"queries, updates, and commands."}],"url":"\/documentation\/worldmodule","identifier":"doc:\/\/WorldModule\/documentation\/WorldModule","role":"collection","type":"topic","title":"WorldModule","kind":"symbol"},"doc://WorldModule/documentation/WorldModule/Scene":{"kind":"symbol","type":"topic","title":"Scene","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"Scene"}],"url":"\/documentation\/worldmodule\/scene","abstract":[{"type":"text","text":"A saved copy of a world’s entities, hierarchy, and the components and resources of the types"},{"type":"text","text":" "},{"type":"text","text":"a registry names."}],"role":"symbol","navigatorTitle":[{"kind":"identifier","text":"Scene"}],"identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/Scene"},"doc://WorldModule/documentation/WorldModule/World/spawn(contentsOf:)":{"fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"spawn","kind":"identifier"},{"text":"(","kind":"text"},{"text":"contentsOf","kind":"externalParam"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:11WorldModule5SceneV","text":"Scene","kind":"typeIdentifier"},{"text":") -> [","kind":"text"},{"preciseIdentifier":"s:11WorldModule6EntityV","text":"Entity","kind":"typeIdentifier"},{"text":" : ","kind":"text"},{"preciseIdentifier":"s:11WorldModule6EntityV","text":"Entity","kind":"typeIdentifier"},{"kind":"text","text":"]"}],"abstract":[{"type":"text","text":"Adds the entities of a scene to the world as new entities, and inserts the scene’s"},{"type":"text","text":" "},{"type":"text","text":"resources."}],"identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/World\/spawn(contentsOf:)","url":"\/documentation\/worldmodule\/world\/spawn(contentsof:)","role":"symbol","type":"topic","title":"spawn(contentsOf:)","kind":"symbol"},"doc://WorldModule/documentation/WorldModule/World/scene(_:)":{"kind":"symbol","type":"topic","title":"scene(_:)","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"scene","kind":"identifier"},{"text":"(","kind":"text"},{"kind":"typeIdentifier","text":"TypeRegistry","preciseIdentifier":"s:11WorldModule12TypeRegistryV"},{"kind":"text","text":") -> "},{"kind":"typeIdentifier","text":"Scene","preciseIdentifier":"s:11WorldModule5SceneV"}],"url":"\/documentation\/worldmodule\/world\/scene(_:)","abstract":[{"type":"text","text":"Returns a scene of the world’s entities, hierarchy, and the components and resources of"},{"type":"text","text":" "},{"type":"text","text":"the types a registry names."}],"role":"symbol","identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/World\/scene(_:)"},"doc://WorldModule/documentation/WorldModule/TypeRegistryError":{"type":"topic","title":"TypeRegistryError","kind":"symbol","role":"symbol","fragments":[{"kind":"keyword","text":"enum"},{"kind":"text","text":" "},{"kind":"identifier","text":"TypeRegistryError"}],"navigatorTitle":[{"kind":"identifier","text":"TypeRegistryError"}],"url":"\/documentation\/worldmodule\/typeregistryerror","identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/TypeRegistryError","abstract":[{"type":"text","text":"An error that indicates why a type couldn’t be registered in a "},{"type":"reference","identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/TypeRegistry","isActive":true},{"type":"text","text":"."}]},"doc://WorldModule/documentation/WorldModule/ChildOf":{"kind":"symbol","type":"topic","title":"ChildOf","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"ChildOf"}],"url":"\/documentation\/worldmodule\/childof","abstract":[{"text":"The relation that links a child entity to its parent.","type":"text"}],"role":"symbol","navigatorTitle":[{"kind":"identifier","text":"ChildOf"}],"identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/ChildOf"},"doc://WorldModule/documentation/WorldModule/WorldSnapshot":{"type":"topic","role":"symbol","abstract":[{"type":"text","text":"A saved copy of a world’s entities, hierarchy and the components of the listed types."}],"fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"WorldSnapshot","kind":"identifier"}],"navigatorTitle":[{"text":"WorldSnapshot","kind":"identifier"}],"kind":"symbol","title":"WorldSnapshot","url":"\/documentation\/worldmodule\/worldsnapshot","identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/WorldSnapshot"},"doc://WorldModule/documentation/WorldModule/World/snapshot(_:)":{"fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"snapshot"},{"kind":"text","text":"<each "},{"kind":"genericParameter","text":"C"},{"kind":"text","text":">(repeat (each "},{"kind":"typeIdentifier","text":"C"},{"kind":"text","text":").Type) -> "},{"kind":"typeIdentifier","preciseIdentifier":"s:11WorldModule0A8SnapshotV","text":"WorldSnapshot"},{"kind":"text","text":"<repeat each "},{"kind":"typeIdentifier","text":"C"},{"kind":"text","text":">"}],"abstract":[{"text":"Returns a snapshot of the world’s entities, hierarchy and the components of the given","type":"text"},{"text":" ","type":"text"},{"text":"types.","type":"text"}],"url":"\/documentation\/worldmodule\/world\/snapshot(_:)","identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/World\/snapshot(_:)","role":"symbol","type":"topic","title":"snapshot(_:)","kind":"symbol"}}}