text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"TypeRegistry","kind":"identifier"}],"kind":"symbol","abstract":[{"type":"text","text":"A list of the component and resource types that a scene saves, each under a name that"},{"type":"text","text":" "},{"type":"text","text":"identifies it in saved data."}],"url":"\/documentation\/worldmodule\/typeregistry","title":"TypeRegistry","identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/TypeRegistry","role":"symbol","type":"topic"},"doc://WorldModule/documentation/WorldModule/Targets":{"navigatorTitle":[{"kind":"identifier","text":"Targets"}],"fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"Targets"}],"kind":"symbol","abstract":[{"type":"text","text":"The component that holds a source entity’s targets of a relation, with the relation’s value"},{"type":"text","text":" "},{"type":"text","text":"for each."}],"url":"\/documentation\/worldmodule\/targets","identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/Targets","title":"Targets","role":"symbol","type":"topic"},"doc://WorldModule/documentation/WorldModule/TypeRegistryError":{"type":"topic","fragments":[{"kind":"keyword","text":"enum"},{"kind":"text","text":" "},{"kind":"identifier","text":"TypeRegistryError"}],"identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/TypeRegistryError","url":"\/documentation\/worldmodule\/typeregistryerror","role":"symbol","title":"TypeRegistryError","kind":"symbol","abstract":[{"text":"An error that indicates why a type couldn’t be registered in a ","type":"text"},{"type":"reference","identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/TypeRegistry","isActive":true},{"text":".","type":"text"}],"navigatorTitle":[{"kind":"identifier","text":"TypeRegistryError"}]}}}