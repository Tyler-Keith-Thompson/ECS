{"seeAlsoSections":[{"identifiers":["doc:\/\/WorldModule\/documentation\/WorldModule\/WorldSnapshot","doc:\/\/WorldModule\/documentation\/WorldModule\/Scene","doc:\/\/WorldModule\/documentation\/WorldModule\/TypeRegistry","doc:\/\/WorldModule\/documentation\/WorldModule\/TypeRegistryError","doc:\/\/WorldModule\/documentation\/WorldModule\/TypeRegistryLookupError","doc:\/\/WorldModule\/documentation\/WorldModule\/MapEntities"],"anchor":"Saving-and-Loading-Worlds","generated":true,"title":"Saving and Loading Worlds"}],"primaryContentSections":[{"kind":"content","content":[{"anchor":"Overview","level":2,"type":"heading","text":"Overview"},{"inlineContent":[{"text":"A ","type":"text"},{"type":"reference","identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/World","isActive":true},{"text":" is a value, so keeping a copy in memory is as simple as assigning it to another","type":"text"},{"text":" ","type":"text"},{"text":"variable. To keep a world beyond the life of your program, such as in a save file, or to send it","type":"text"},{"text":" ","type":"text"},{"text":"somewhere else, encode it. WorldModule offers two ways to do that:","type":"text"}],"type":"paragraph"},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"text":"A ","type":"text"},{"identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/WorldSnapshot","type":"reference","isActive":true},{"text":" saves the components of the types you list each time you take one. It’s the","type":"text"},{"text":" ","type":"text"},{"text":"quickest way to save a few types, and to compare two worlds.","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"A ","type":"text"},{"identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/Scene","type":"reference","isActive":true},{"text":" saves the components and resources of the types a ","type":"text"},{"identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/TypeRegistry","type":"reference","isActive":true},{"text":" names, so you","type":"text"},{"text":" ","type":"text"},{"text":"list your types once. A scene can also be spawned into another world as new entities.","type":"text"}]}]}],"type":"unorderedList"},{"inlineContent":[{"type":"text","text":"Both save every entity, live or stale, and the hierarchy ("},{"type":"reference","isActive":true,"identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/ChildOf"},{"type":"text","text":"). Neither saves hooks,"},{"type":"text","text":" "},{"type":"text","text":"observers, caches, indexes or change ticks."}],"type":"paragraph"},{"anchor":"Make-Your-Types-Codable","level":3,"type":"heading","text":"Make Your Types Codable"},{"inlineContent":[{"text":"Every component and resource type you save must conform to ","type":"text"},{"code":"Codable","type":"codeVoice"},{"text":". Swift synthesizes the","type":"text"},{"text":" ","type":"text"},{"text":"conformance for most types, so declaring it is usually enough:","type":"text"}],"type":"paragraph"},{"syntax":"swift","code":["extension Position: Codable, Equatable {}","extension Health: Codable {}","extension Name: Codable {}","","struct Treasury: Resource, Codable { var gold: Int }"],"type":"codeListing"},{"anchor":"Take-a-Snapshot","level":3,"type":"heading","text":"Take a Snapshot"},{"inlineContent":[{"type":"text","text":"Call "},{"isActive":true,"type":"reference","identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/World\/snapshot(_:)"},{"type":"text","text":" with the component types to save. The snapshot is "},{"code":"Codable","type":"codeVoice"},{"type":"text","text":", so any"},{"type":"text","text":" "},{"type":"text","text":"encoder can write it, and "},{"code":"World(restoring:)","type":"codeVoice"},{"type":"text","text":" rebuilds the world from it:"}],"type":"paragraph"},{"syntax":"swift","code":["import Foundation","","var world = World()","let knight = world.spawn(Name(value: \"Knight\"), Health(current: 10))","let data = try JSONEncoder().encode(world.snapshot(Name.self, Health.self))","","let snapshot = try JSONDecoder().decode(WorldSnapshot<Name, Health>.self, from: data)","let restored = World(restoring: snapshot)","print(restored[Health.self, of: knight])","\/\/ Prints \"Health(current: 10)\""],"type":"codeListing"},{"inlineContent":[{"type":"text","text":"Entity handles mean the same in the restored world as in the original, so "},{"type":"codeVoice","code":"knight"},{"type":"text","text":" still names"},{"type":"text","text":" "},{"type":"text","text":"the knight. Components of types you didn’t list are left out."}],"type":"paragraph"},{"inlineContent":[{"text":"When every saved type is ","type":"text"},{"type":"codeVoice","code":"Equatable"},{"text":", so is the snapshot. Comparing two snapshots compares the","type":"text"},{"text":" ","type":"text"},{"text":"worlds they were taken of, which is useful for checking that a replay reproduces a recording:","type":"text"}],"type":"paragraph"},{"syntax":"swift","code":["var recorded = World()","let runner = recorded.spawn(Position(x: 0, y: 0))","recorded[Position.self, of: runner].x += 1","","var replayed = World()","let replayedRunner = replayed.spawn(Position(x: 0, y: 0))","replayed[Position.self, of: replayedRunner].x += 1","","print(replayed.snapshot(Position.self) == recorded.snapshot(Position.self))","\/\/ Prints \"true\""],"type":"codeListing"},{"anchor":"Save-Whole-Worlds-with-Scenes","level":3,"type":"heading","text":"Save Whole Worlds with Scenes"},{"inlineContent":[{"type":"text","text":"Register the types your program saves in a "},{"identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/TypeRegistry","type":"reference","isActive":true},{"type":"text","text":", once, under names of your choosing."},{"type":"text","text":" "},{"type":"text","text":"Then "},{"identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/World\/scene(_:)","type":"reference","isActive":true},{"type":"text","text":" saves every registered type a world holds. Decoding a scene needs the"},{"type":"text","text":" "},{"type":"text","text":"same registry, passed in the decoder’s "},{"code":"userInfo","type":"codeVoice"},{"type":"text","text":" under "},{"code":"CodingUserInfoKey.typeRegistry","type":"codeVoice"},{"type":"text","text":":"}],"type":"paragraph"},{"syntax":"swift","code":["import Foundation","","var registry = TypeRegistry()","try registry.register(Name.self, named: \"Name\")","try registry.register(Health.self, named: \"Health\")","try registry.register(resource: Treasury.self, named: \"Treasury\")","","var world = World()","world.resources.insert(Treasury(gold: 250))","let castle = world.spawn(Name(value: \"Castle\"))","let guardian = world.spawn(Name(value: \"Guard\"), Health(current: 12))","try world.addChild(guardian, to: castle)","let data = try JSONEncoder().encode(world.scene(registry))","","let decoder = JSONDecoder()","decoder.userInfo[.typeRegistry] = registry","let restored = World(restoring: try decoder.decode(Scene.self, from: data))","print(restored.children(of: castle) == [guardian])","\/\/ Prints \"true\"","print(restored.resources[Treasury.self].gold)","\/\/ Prints \"250\""],"type":"codeListing"},{"inlineContent":[{"text":"The names identify the types in saved data. Choose names of your own rather than relying on the","type":"text"},{"text":" ","type":"text"},{"text":"default, the type’s full name, so that saved data stays readable after you rename a type or its","type":"text"},{"text":" ","type":"text"},{"text":"module.","type":"text"}],"type":"paragraph"},{"anchor":"Save-Relations","level":3,"type":"heading","text":"Save Relations"},{"inlineContent":[{"type":"text","text":"A scene saves the hierarchy without being asked. To save another "},{"isActive":true,"type":"reference","identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/Relation"},{"type":"text","text":", make it "},{"code":"Codable","type":"codeVoice"},{"type":"text","text":" "},{"type":"text","text":"and register its "},{"isActive":true,"type":"reference","identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/Targets"},{"type":"text","text":" component:"}],"type":"paragraph"},{"syntax":"swift","code":["import Foundation","","extension Likes: Codable {}","","var registry = TypeRegistry()","try registry.register(Targets<Likes>.self, named: \"Likes\")","","var world = World()","let alice = world.spawn()","let bob = world.spawn()","world.relate(alice, Likes(), to: bob)","let data = try JSONEncoder().encode(world.scene(registry))","","let decoder = JSONDecoder()","decoder.userInfo[.typeRegistry] = registry","let restored = World(restoring: try decoder.decode(Scene.self, from: data))","print(restored.sources(Likes.self, of: bob) == [alice])","\/\/ Prints \"true\""],"type":"codeListing"},{"anchor":"Spawn-Saved-Entities-into-a-World","level":3,"type":"heading","text":"Spawn Saved Entities into a World"},{"inlineContent":[{"text":"Restoring a scene replaces a whole world. To add a scene’s entities to an existing world instead,","type":"text"},{"text":" ","type":"text"},{"text":"as you would to place a saved enemy squad or a room of a level, call","type":"text"},{"text":" ","type":"text"},{"identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/World\/spawn(contentsOf:)-7g753","isActive":true,"type":"reference"},{"text":". Each of the scene’s live entities is spawned as a new entity, and","type":"text"},{"text":" ","type":"text"},{"text":"the method returns the new entity for each of the scene’s:","type":"text"}],"type":"paragraph"},{"syntax":"swift","code":["var registry = TypeRegistry()","try registry.register(Name.self, named: \"Name\")","try registry.register(Health.self, named: \"Health\")","","var prefab = World()","let goblin = prefab.spawn(Name(value: \"Goblin\"), Health(current: 4))","let saved = prefab.scene(registry)","","var world = World()","let first = world.spawn(contentsOf: saved)","let second = world.spawn(contentsOf: saved)","print(world.count)","\/\/ Prints \"2\"","print(first[goblin] == second[goblin])","\/\/ Prints \"false\""],"type":"codeListing"},{"inlineContent":[{"text":"Components that store entity handles must point at the new entities, not the scene’s. Relations","type":"text"},{"text":" ","type":"text"},{"text":"and the hierarchy are updated for you. Conform your own components that store handles to","type":"text"},{"text":" ","type":"text"},{"isActive":true,"identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/MapEntities","type":"reference"},{"text":" so that ","type":"text"},{"code":"spawn(contentsOf:)","type":"codeVoice"},{"text":" can update them too.","type":"text"}],"type":"paragraph"},{"anchor":"Reach-Components-and-Resources-by-Name","level":3,"type":"heading","text":"Reach Components and Resources by Name"},{"inlineContent":[{"text":"A registry also lets code that knows only names read and write single values: a scripting host","type":"text"},{"text":" ","type":"text"},{"text":"that exposes components to scripts, a debugger, or an inspector. Read a component with","type":"text"},{"text":" ","type":"text"},{"identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/TypeRegistry\/component(named:of:in:)","type":"reference","isActive":true},{"text":", which returns it as a ","type":"text"},{"type":"codeVoice","code":"Codable"},{"text":" value, and insert one","type":"text"},{"text":" ","type":"text"},{"text":"with ","type":"text"},{"identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/TypeRegistry\/insert(componentNamed:into:in:decode:)","type":"reference","isActive":true},{"text":", whose closure decodes the","type":"text"},{"text":" ","type":"text"},{"text":"registered type with any decoder:","type":"text"}],"type":"paragraph"},{"syntax":"swift","code":["import Foundation","","var registry = TypeRegistry()","try registry.register(Health.self, named: \"Health\")","","var world = World()","let goblin = world.spawn(Health(current: 4))","","let health = registry.component(named: \"Health\", of: goblin, in: world)","let data = try JSONEncoder().encode(health)","print(String(decoding: data, as: UTF8.self))","\/\/ Prints \"{\"current\":4}\"","","let healed = Data(#\"{\"current\": 9}\"#.utf8)","try registry.insert(componentNamed: \"Health\", into: goblin, in: &world) { type in","    try JSONDecoder().decode(type, from: healed)","}","print(world[Health.self, of: goblin].current)","\/\/ Prints \"9\""],"type":"codeListing"},{"inlineContent":[{"text":"When the name comes from outside your program, use the checked spellings, such as","type":"text"},{"text":" ","type":"text"},{"isActive":true,"identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/TypeRegistry\/component(checkedNamed:of:in:)","type":"reference"},{"text":", which throw a ","type":"text"},{"isActive":true,"identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/TypeRegistryLookupError","type":"reference"},{"text":" for a","type":"text"},{"text":" ","type":"text"},{"text":"name that isn’t registered, a stale entity or a missing value. Resources have the same pair:","type":"text"},{"text":" ","type":"text"},{"isActive":true,"identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/TypeRegistry\/resource(named:in:)","type":"reference"},{"text":" and ","type":"text"},{"isActive":true,"identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/TypeRegistry\/insert(resourceNamed:into:decode:)","type":"reference"},{"text":".","type":"text"}],"type":"paragraph"}]}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/worldmodule\/savingandloadingworlds"]}],"hierarchy":{"paths":[["doc:\/\/WorldModule\/documentation\/WorldModule"]]},"kind":"article","identifier":{"url":"doc:\/\/WorldModule\/documentation\/WorldModule\/SavingAndLoadingWorlds","interfaceLanguage":"swift"},"metadata":{"role":"article","roleHeading":"Article","title":"Saving and Loading Worlds","modules":[{"name":"WorldModule"}]},"schemaVersion":{"major":0,"minor":3,"patch":0},"sections":[],"abstract"