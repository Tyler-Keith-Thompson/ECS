{"sections":[],"topicSections":[{"anchor":"Initializers","generated":true,"title":"Initializers","identifiers":["doc:\/\/WorldModule\/documentation\/WorldModule\/Scene\/init(from:)"]},{"anchor":"Instance-Properties","generated":true,"title":"Instance Properties","identifiers":["doc:\/\/WorldModule\/documentation\/WorldModule\/Scene\/componentNames","doc:\/\/WorldModule\/documentation\/WorldModule\/Scene\/count","doc:\/\/WorldModule\/documentation\/WorldModule\/Scene\/resourceNames"]},{"anchor":"Instance-Methods","title":"Instance Methods","identifiers":["doc:\/\/WorldModule\/documentation\/WorldModule\/Scene\/encode(to:)"],"generated":true}],"primaryContentSections":[{"kind":"declarations","declarations":[{"tokens":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"text":"Scene","kind":"identifier"}],"languages":["swift"],"platforms":["Linux"]}]},{"kind":"mentions","mentions":["doc:\/\/WorldModule\/documentation\/WorldModule\/SavingAndLoadingWorlds"]},{"content":[{"level":2,"type":"heading","text":"Overview","anchor":"overview"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Use a scene to save and load whole worlds, such as a game’s save file or a level made in an"},{"type":"text","text":" "},{"type":"text","text":"editor, or to store a group of entities you spawn many times, such as an enemy squad. Take a"},{"type":"text","text":" "},{"type":"text","text":"scene with "},{"type":"reference","identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/World\/scene(_:)","isActive":true},{"type":"text","text":", passing a "},{"type":"reference","identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/TypeRegistry","isActive":true},{"type":"text","text":" of the types to save. Then either"},{"type":"text","text":" "},{"type":"text","text":"rebuild the whole world with "},{"type":"codeVoice","code":"World(restoring:)"},{"type":"text","text":", or add the scene’s entities to another"},{"type":"text","text":" "},{"type":"text","text":"world as new ones with "},{"type":"reference","identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/World\/spawn(contentsOf:)","isActive":true},{"type":"text","text":"."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"A scene is "},{"type":"codeVoice","code":"Codable"},{"type":"text","text":". Encoding needs nothing more; decoding needs the registry in the"},{"type":"text","text":" "},{"type":"text","text":"decoder’s "},{"type":"codeVoice","code":"userInfo"},{"type":"text","text":" under "},{"type":"codeVoice","code":"CodingUserInfoKey.typeRegistry"},{"type":"text","text":":"}]},{"type":"codeListing","code":["import Foundation","","var registry = TypeRegistry()","try registry.register(Name.self, named: \"Name\")","","var world = World()","let ship = world.spawn(Name(value: \"Ship\"))","let turret = world.spawn(Name(value: \"Turret\"))","try world.addChild(turret, to: ship)","let data = try JSONEncoder().encode(world.scene(registry))","","let decoder = JSONDecoder()","decoder.userInfo[.typeRegistry] = registry","let scene = try decoder.decode(Scene.self, from: data)","print(scene.count)","\/\/ Prints \"2\"","","let restored = World(restoring: scene)","print(restored.parent(of: turret) == ship)","\/\/ Prints \"true\""],"syntax":"swift"},{"type":"paragraph","inlineContent":[{"text":"Restoring keeps every entity handle, live or stale, meaning the same as in the original","type":"text"},{"text":" ","type":"text"},{"text":"world, and the restored world hands out the same handles from later spawns. Types the","type":"text"},{"text":" ","type":"text"},{"text":"registry names but the data doesn’t are left out.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"A scene holds no hooks, observers, caches, indexes or change ticks, and the restored world’s","type":"text"},{"text":" ","type":"text"},{"text":"components are all added at its first tick.","type":"text"}]},{"type":"aside","name":"Note","content":[{"inlineContent":[{"type":"text","text":"Decoding throws "},{"type":"codeVoice","code":"DecodingError.dataCorrupted"},{"type":"text","text":" when the decoder’s "},{"type":"codeVoice","code":"userInfo"},{"type":"text","text":" has no"},{"type":"text","text":" "},{"type":"text","text":"registry, when the data names a type the registry doesn’t, or for data that no world could"},{"type":"text","text":" "},{"type":"text","text":"have produced."}],"type":"paragraph"}],"style":"note"}],"kind":"content"}],"abstract":[{"type":"text","text":"A saved copy of a world’s entities, hierarchy, and the components and resources of the types"},{"type":"text","text":" "},{"type":"text","text":"a registry names."}],"metadata":{"roleHeading":"Structure","externalID":"s:11WorldModule5SceneV","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Scene","kind":"identifier"}],"remoteSource":{"fileName":"Scene.swift","url":"https:\/\/github.com\/Tyler-Keith-Thompson\/ECS\/blob\/main\/Sources\/WorldModule\/Scene.swift#L350"},"role":"symbol","symbolKind":"struct","title":"Scene","modules":[{"name":"WorldModule"}],"navigatorTitle":[{"kind":"identifier","text":"Scene"}]},"seeAlsoSections":[{"anchor":"Saving-and-Loading-Worlds","title":"Saving and Loading Worlds","identifiers":["doc:\/\/WorldModule\/documentation\/WorldModule\/SavingAndLoadingWorlds","doc:\/\/WorldModule\/documentation\/WorldModule\/WorldSnapshot","doc:\/\/WorldModule\/documentation\/WorldModule\/TypeRegistry","doc:\/\/WorldModule\/documentation\/WorldModule\/TypeRegistryError","doc:\/\/WorldModule\/documentation\/WorldModule\/MapEntities"],"generated":true}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/worldmodule\/scene"]}],"relationshipsSections":[{"kind":"relationships","title":"Conforms To","type":"conformsTo","identifiers":["doc:\/\/WorldModule\/Se","doc:\/\/WorldModule\/SE","doc:\/\/WorldModule\/s8SendableP","doc:\/\/WorldModule\/s16SendableMetatypeP"]}],"schemaVersion":{"patch":0,"minor":3,"ma