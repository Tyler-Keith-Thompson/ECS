{"sections":[],"metadata":{"externalID":"s:11WorldModule5SceneV","title":"Scene","roleHeading":"Structure","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"kind":"identifier","text":"Scene"}],"navigatorTitle":[{"kind":"identifier","text":"Scene"}],"modules":[{"name":"WorldModule"}],"remoteSource":{"fileName":"Scene.swift","url":"https:\/\/github.com\/Tyler-Keith-Thompson\/ECS\/blob\/main\/Sources\/WorldModule\/Scene.swift#L664"},"symbolKind":"struct","role":"symbol"},"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/WorldModule\/documentation\/WorldModule\/Scene"},"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/worldmodule\/scene"]}],"relationshipsSections":[{"kind":"relationships","type":"conformsTo","identifiers":["doc:\/\/WorldModule\/Se","doc:\/\/WorldModule\/SE","doc:\/\/WorldModule\/s8SendableP","doc:\/\/WorldModule\/s16SendableMetatypeP"],"title":"Conforms To"}],"hierarchy":{"paths":[["doc:\/\/WorldModule\/documentation\/WorldModule"]]},"kind":"symbol","seeAlsoSections":[{"identifiers":["doc:\/\/WorldModule\/documentation\/WorldModule\/SavingAndLoadingWorlds","doc:\/\/WorldModule\/documentation\/WorldModule\/WorldSnapshot","doc:\/\/WorldModule\/documentation\/WorldModule\/TypeRegistry","doc:\/\/WorldModule\/documentation\/WorldModule\/TypeRegistryError","doc:\/\/WorldModule\/documentation\/WorldModule\/TypeRegistryLookupError","doc:\/\/WorldModule\/documentation\/WorldModule\/MapEntities"],"generated":true,"anchor":"Saving-and-Loading-Worlds","title":"Saving and Loading Worlds"}],"topicSections":[{"anchor":"Initializers","identifiers":["doc:\/\/WorldModule\/documentation\/WorldModule\/Scene\/init(from:)"],"title":"Initializers","generated":true},{"anchor":"Instance-Properties","identifiers":["doc:\/\/WorldModule\/documentation\/WorldModule\/Scene\/componentNames","doc:\/\/WorldModule\/documentation\/WorldModule\/Scene\/count","doc:\/\/WorldModule\/documentation\/WorldModule\/Scene\/resourceNames"],"title":"Instance Properties","generated":true},{"identifiers":["doc:\/\/WorldModule\/documentation\/WorldModule\/Scene\/encode(to:)"],"generated":true,"anchor":"Instance-Methods","title":"Instance Methods"}],"abstract":[{"type":"text","text":"A saved copy of a world’s entities, hierarchy, and the components and resources of the types"},{"type":"text","text":" "},{"type":"text","text":"a registry names."}],"primaryContentSections":[{"kind":"declarations","declarations":[{"platforms":["Linux"],"tokens":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"kind":"identifier","text":"Scene"}],"languages":["swift"]}]},{"kind":"mentions","mentions":["doc:\/\/WorldModule\/documentation\/WorldModule\/SavingAndLoadingWorlds"]},{"kind":"content","content":[{"type":"heading","anchor":"overview","level":2,"text":"Overview"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Use a scene to save and load whole worlds, such as a game’s save file or a level made in an"},{"type":"text","text":" "},{"type":"text","text":"editor, or to store a group of entities you spawn many times, such as an enemy squad. Take a"},{"type":"text","text":" "},{"type":"text","text":"scene with "},{"type":"reference","identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/World\/scene(_:)","isActive":true},{"type":"text","text":", passing a "},{"type":"reference","identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/TypeRegistry","isActive":true},{"type":"text","text":" of the types to save. Then either"},{"type":"text","text":" "},{"type":"text","text":"rebuild the whole world with "},{"type":"codeVoice","code":"World(restoring:)"},{"type":"text","text":", or add the scene’s entities to another"},{"type":"text","text":" "},{"type":"text","text":"world as new ones with "},{"type":"reference","identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/World\/spawn(contentsOf:)-7g753","isActive":true},{"type":"text","text":"."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"A scene is "},{"type":"codeVoice","code":"Codable"},{"type":"text","text":". Encoding needs nothing more; decoding needs the registry in the"},{"type":"text","text":" "},{"type":"text","text":"decoder’s "},{"type":"codeVoice","code":"userInfo"},{"type":"text","text":" under "},{"type":"codeVoice","code":"CodingUserInfoKey.typeRegistry"},{"type":"text","text":":"}]},{"type":"codeListing","code":["import Foundation","","var registry = TypeRegistry()","try registry.register(Name.self, named: \"Name\")","","var world = World()","let ship = world.spawn(Name(value: \"Ship\"))","let turret = world.spawn(Name(value: \"Turret\"))","try world.addChild(turret, to: ship)","let data = try JSONEncoder().encode(world.scene(registry))","","let decoder = JSONDecoder()","decoder.userInfo[.typeRegistry] = registry","let scene = try decoder.decode(Scene.self, from: data)","print(scene.count)","\/\/ Prints \"2\"","","let restored = World(restoring: scene)","print(restored.parent(of: turret) == ship)","\/\/ Prints \"true\""],"syntax":"swift"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Restoring keeps every entity handle, live or stale, meaning the same as in the original"},{"type":"text","text":" "},{"type":"text","text":"world, and the restored world hands out the same handles from later spawns. Types the"},{"type":"text","text":" "},{"type":"text","text":"registry names but the data doesn’t are left out."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"A scene holds no hooks, observers, caches, indexes or change ticks, and the restored world’s"},{"type":"text","text":" "},{"type":"text","text":"components are all added at its first tick."}]},{"type":"aside","name":"Note","style":"note","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Decoding throws "},{"code":"DecodingError.dataCorrupted","type":"codeVoice"},{"type":"text","text":" when the decoder’s "},{"code":"userInfo","type":"codeVoice"},{"type":"text","text":" has no"},{"type":"text","text":" "},{"type":"text","text":"registry, when the data names a type the registry doesn’t, or for data that no world could"},{"type":"text","text":" "},{"type":"text","text":"have produced."}]}]}]}],"schemaVersion":{"minor":3,"patch":0,"major":0},"references":{"doc://WorldModule/documentation/WorldModule/Scene/resourceNames":{"role":"symbol","fragments":[{"kind":"keyword","text":"var"},{"kind":"text","text":" "},{"kind":"identifier","text":"resourceNames"},{"kind":"text","text":": ["},{"kind":"typeIdentifier","text":"String","preciseIdentifier":"s:SS"},{"kind":"text","text":"]"}],"kind":"symbol","type":"topic","identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/Scene\/resourceNames","title":"resourceNames","url":"\/documentation\/worldmodule\/scene\/resourcenames","abstract":[{"type":"text","text":"The names of the resource types saved, in registration order."}]},"doc://WorldModule/documentation/WorldModule/TypeRegistry":{"title":"TypeRegistry","url":"\/documentation\/worldmodule\/typeregistry","type":"topic","identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/TypeRegistry","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"TypeRegistry","kind":"identifier"}],"abstract":[{"text":"A list of the component and resource types that a scene saves, each under a name that","type":"text"},{"text":" ","type":"text"},{"text":"identifies it in saved data.","type":"text"}],"role":"symbol","navigatorTitle":[{"text":"TypeRegistry","kind":"identifier"}],"kind":"symbol"},"doc://WorldModule/documentation/WorldModule/World/scene(_:)":{"role":"symbol","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"scene","kind":"identifier"},{"text":"(","kind":"text"},{"kind":"typeIdentifier","text":"TypeRegistry","preciseIdentifier":"s:11WorldModule12TypeRegistryV"},{"kind":"text","text":") -> "},{"kind":"typeIdentifier","text":"Scene","preciseIdentifier":"s:11WorldModule5SceneV"}],"kind":"symbol","title":"scene(_:)","type":"topic","identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/World\/scene(_:)","url":"\/documentation\/worldmodule\/world\/scene(_:)","abstract":[{"text":"Returns a scene of the world’s entities, hierarchy, and the components and resources of","type":"text"},{"text":" ","type":"text"},{"text":"the types a registry names.","type":"text"}]},"doc://WorldModule/SE":{"type":"unresolvable","title":"Swift.Encodable","identifier":"doc:\/\/WorldModule\/SE"},"doc://WorldModule/s8SendableP":{"identifier":"doc:\/\/WorldModule\/s8SendableP","title":"Swift.Sendable","type":"unresolvable"},"doc://WorldModule/documentation/WorldModule/Scene/encode(to:)":{"type":"topic","url":"\/documentation\/worldmodule\/scene\/encode(to:)","role":"symbol","kind":"symbol","title":"encode(to:)","abstract":[{"type":"text","text":"Encodes the scene into the given encoder."}],"fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"encode","kind":"identifier"},{"text":"(","kind":"text"},{"text":"to","kind":"externalParam"},{"text":": any ","kind":"text"},{"kind":"typeIdentifier","preciseIdentifier":"s:s7EncoderP","text":"Encoder"},{"kind":"text","text":") "},{"kind":"keyword","text":"throws"}],"identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/Scene\/encode(to:)"},"doc://WorldModule/documentation/WorldModule/Scene/count":{"type":"topic","url":"\/documentation\/worldmodule\/scene\/count","role":"symbol","kind":"symbol","title":"count","abstract":[{"type":"text","text":"The number of live entities."}],"fragments":[{"kind":"keyword","text":"var"},{"kind":"text","text":" "},{"kind":"identifier","text":"count"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"Int","preciseIdentifier":"s:Si"}],"identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/Scene\/count"},"doc://WorldModule/documentation/WorldModule/Scene/init(from:)":{"abstract":[{"type":"text","text":"Creates a scene by decoding from the given decoder, whose "},{"type":"codeVoice","code":"userInfo"},{"type":"text","text":" holds the type"},{"type":"text","text":" "},{"type":"text","text":"registry under "},{"type":"codeVoice","code":"CodingUserInfoKey.typeRegistry"},{"type":"text","text":"."}],"role":"symbol","type":"topic","identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/Scene\/init(from:)","title":"init(from:)","fragments":[{"text":"init","kind":"identifier"},{"text":"(","kind":"text"},{"text":"from","kind":"externalParam"},{"text":": any ","kind":"text"},{"preciseIdentifier":"s:s7DecoderP","text":"Decoder","kind":"typeIdentifier"},{"text":") ","kind":"text"},{"text":"throws","kind":"keyword"}],"kind":"symbol","url":"\/documentation\/worldmodule\/scene\/init(from:)"},"doc://WorldModule/documentation/WorldModule/TypeRegistryLookupError":{"fragments":[{"kind":"keyword","text":"enum"},{"kind":"text","text":" "},{"kind":"identifier","text":"TypeRegistryLookupError"}],"url":"\/documentation\/worldmodule\/typeregistrylookuperror","identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/TypeRegistryLookupError","kind":"symbol","title":"TypeRegistryLookupError","role":"symbol","abstract":[{"text":"An error that indicates why a ","type":"text"},{"type":"reference","isActive":true,"identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/TypeRegistry"},{"text":" couldn’t reach a component or resource by","type":"text"},{"text":" ","type":"text"},{"text":"name.","type":"text"}],"type":"topic","navigatorTitle":[{"kind":"identifier","text":"TypeRegistryLookupError"}]},"doc://WorldModule/documentation/WorldModule/World/spawn(contentsOf:)-7g753":{"title":"spawn(contentsOf:)","role":"symbol","kind":"symbol","identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/World\/spawn(contentsOf:)-7g753","url":"\/documentation\/worldmodule\/world\/spawn(contentsof:)-7g753","abstract":[{"text":"Adds the entities of a scene to the world as new entities, and inserts the scene’s","type":"