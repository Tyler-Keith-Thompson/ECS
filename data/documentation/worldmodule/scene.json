{"seeAlsoSections":[{"generated":true,"anchor":"Saving-and-Loading-Worlds","identifiers":["doc:\/\/WorldModule\/documentation\/WorldModule\/SavingAndLoadingWorlds","doc:\/\/WorldModule\/documentation\/WorldModule\/WorldSnapshot","doc:\/\/WorldModule\/documentation\/WorldModule\/TypeRegistry","doc:\/\/WorldModule\/documentation\/WorldModule\/TypeRegistryError","doc:\/\/WorldModule\/documentation\/WorldModule\/TypeRegistryLookupError","doc:\/\/WorldModule\/documentation\/WorldModule\/MapEntities"],"title":"Saving and Loading Worlds"}],"hierarchy":{"paths":[["doc:\/\/WorldModule\/documentation\/WorldModule"]]},"identifier":{"url":"doc:\/\/WorldModule\/documentation\/WorldModule\/Scene","interfaceLanguage":"swift"},"schemaVersion":{"patch":0,"major":0,"minor":3},"sections":[],"metadata":{"symbolKind":"struct","roleHeading":"Structure","remoteSource":{"url":"https:\/\/github.com\/Tyler-Keith-Thompson\/ECS\/blob\/main\/Sources\/WorldModule\/Scene.swift#L664","fileName":"Scene.swift"},"title":"Scene","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Scene","kind":"identifier"}],"modules":[{"name":"WorldModule"}],"externalID":"s:11WorldModule5SceneV","navigatorTitle":[{"kind":"identifier","text":"Scene"}],"role":"symbol"},"variants":[{"paths":["\/documentation\/worldmodule\/scene"],"traits":[{"interfaceLanguage":"swift"}]}],"topicSections":[{"generated":true,"anchor":"Initializers","identifiers":["doc:\/\/WorldModule\/documentation\/WorldModule\/Scene\/init(from:)"],"title":"Initializers"},{"generated":true,"anchor":"Instance-Properties","identifiers":["doc:\/\/WorldModule\/documentation\/WorldModule\/Scene\/componentNames","doc:\/\/WorldModule\/documentation\/WorldModule\/Scene\/count","doc:\/\/WorldModule\/documentation\/WorldModule\/Scene\/resourceNames"],"title":"Instance Properties"},{"generated":true,"anchor":"Instance-Methods","identifiers":["doc:\/\/WorldModule\/documentation\/WorldModule\/Scene\/encode(to:)"],"title":"Instance Methods"}],"relationshipsSections":[{"type":"conformsTo","kind":"relationships","identifiers":["doc:\/\/WorldModule\/Se","doc:\/\/WorldModule\/SE","doc:\/\/WorldModule\/s8SendableP","doc:\/\/WorldModule\/s16SendableMetatypeP"],"title":"Conforms To"}],"kind":"symbol","primaryContentSections":[{"declarations":[{"platforms":["Linux"],"tokens":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Scene","kind":"identifier"}],"languages":["swift"]}],"kind":"declarations"},{"kind":"mentions","mentions":["doc:\/\/WorldModule\/documentation\/WorldModule\/SavingAndLoadingWorlds"]},{"kind":"content","content":[{"level":2,"anchor":"overview","type":"heading","text":"Overview"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Use a scene to save and load whole worlds, such as a game’s save file or a level made in an"},{"type":"text","text":" "},{"type":"text","text":"editor, or to store a group of entities you spawn many times, such as an enemy squad. Take a"},{"type":"text","text":" "},{"type":"text","text":"scene with "},{"identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/World\/scene(_:)","isActive":true,"type":"reference"},{"type":"text","text":", passing a "},{"identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/TypeRegistry","isActive":true,"type":"reference"},{"type":"text","text":" of the types to save. Then either"},{"type":"text","text":" "},{"type":"text","text":"rebuild the whole world with "},{"code":"World(restoring:)","type":"codeVoice"},{"type":"text","text":", or add the scene’s entities to another"},{"type":"text","text":" "},{"type":"text","text":"world as new ones with "},{"identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/World\/spawn(contentsOf:)","isActive":true,"type":"reference"},{"type":"text","text":"."}]},{"type":"paragraph","inlineContent":[{"text":"A scene is ","type":"text"},{"type":"codeVoice","code":"Codable"},{"text":". Encoding needs nothing more; decoding needs the registry in the","type":"text"},{"text":" ","type":"text"},{"text":"decoder’s ","type":"text"},{"type":"codeVoice","code":"userInfo"},{"text":" under ","type":"text"},{"type":"codeVoice","code":"CodingUserInfoKey.typeRegistry"},{"text":":","type":"text"}]},{"syntax":"swift","type":"codeListing","code":["import Foundation","","var registry = TypeRegistry()","try registry.register(Name.self, named: \"Name\")","","var world = World()","let ship = world.spawn(Name(value: \"Ship\"))","let turret = world.spawn(Name(value: \"Turret\"))","try world.addChild(turret, to: ship)","let data = try JSONEncoder().encode(world.scene(registry))","","let decoder = JSONDecoder()","decoder.userInfo[.typeRegistry] = registry","let scene = try decoder.decode(Scene.self, from: data)","print(scene.count)","\/\/ Prints \"2\"","","let restored = World(restoring: scene)","print(restored.parent(of: turret) == ship)","\/\/ Prints \"true\""]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Restoring keeps every entity handle, live or stale, meaning the same as in the original"},{"type":"text","text":" "},{"type":"text","text":"world, and the restored world hands out the same handles from later spawns. Types the"},{"type":"text","text":" "},{"type":"text","text":"registry names but the data doesn’t are left out."}]},{"type":"paragraph","inlineContent":[{"text":"A scene holds no hooks, observers, caches, indexes or change ticks, and the restored world’s","type":"text"},{"text":" ","type":"text"},{"text":"components are all added at its first tick.","type":"text"}]},{"style":"note","name":"Note","type":"aside","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Decoding throws "},{"type":"codeVoice","code":"DecodingError.dataCorrupted"},{"type":"text","text":" when the decoder’s "},{"type":"codeVoice","code":"userInfo"},{"type":"text","text":" has no"},{"type":"text","text":" "},{"type":"text","text":"registry, when the data names a type the registry doesn’t, or for data that no world could"},{"type":"text","text":" "},{"type":"text","text":"have produced."}]}]}]}],"abstract":[{"type":"text","text":"A saved copy of a world’s entities, hierarchy, and the components and resources of the types"},{"type":"text","text":" "},{"type":"text","text":"a registry names."}],"references":{"doc://WorldModule/documentation/WorldModule/TypeRegistryError":{"type":"topic","url":"\/documentation\/worldmodule\/typeregistryerror","identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/TypeRegistryError","title":"TypeRegistryError","fragments":[{"kind":"keyword","text":"enum"},{"kind":"text","text":" "},{"kind":"identifier","text":"TypeRegistryError"}],"navigatorTitle":[{"kind":"identifier","text":"TypeRegistryError"}],"kind":"symbol","role":"symbol","abstract":[{"type":"text","text":"An error that indicates why a type couldn’t be registered in a "},{"type":"reference","isActive":true,"identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/TypeRegistry"},{"type":"text","text":"."}]},"doc://WorldModule/documentation/WorldModule/Scene/count":{"fragments":[{"text":"var","kind":"keyword"},{"text":" ","kind":"text"},{"text":"count","kind":"identifier"},{"text":": ","kind":"text"},{"text":"Int","kind":"typeIdentifier","preciseIdentifier":"s:Si"}],"url":"\/documentation\/worldmodule\/scene\/count","role":"symbol","identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/Scene\/count","abstract":[{"type":"text","text":"The number of live entities."}],"title":"count","type":"topic","kind":"symbol"},"doc://WorldModule/documentation/WorldModule/WorldSnapshot":{"url":"\/documentation\/worldmodule\/worldsnapshot","role":"symbol","identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/WorldSnapshot","title":"WorldSnapshot","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"WorldSnapshot","kind":"identifier"}],"abstract":[{"type":"text","text":"A saved copy of a world’s entities, hierarchy and the components of the listed type