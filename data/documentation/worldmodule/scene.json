{"abstract":[{"type":"text","text":"A saved copy of a world’s entities, hierarchy, and the components and resources of the types"},{"type":"text","text":" "},{"type":"text","text":"a registry names."}],"sections":[],"seeAlsoSections":[{"generated":true,"identifiers":["doc:\/\/WorldModule\/documentation\/WorldModule\/SavingAndLoadingWorlds","doc:\/\/WorldModule\/documentation\/WorldModule\/WorldSnapshot","doc:\/\/WorldModule\/documentation\/WorldModule\/TypeRegistry","doc:\/\/WorldModule\/documentation\/WorldModule\/TypeRegistryError","doc:\/\/WorldModule\/documentation\/WorldModule\/TypeRegistryLookupError","doc:\/\/WorldModule\/documentation\/WorldModule\/MapEntities"],"anchor":"Saving-and-Loading-Worlds","title":"Saving and Loading Worlds"}],"identifier":{"url":"doc:\/\/WorldModule\/documentation\/WorldModule\/Scene","interfaceLanguage":"swift"},"schemaVersion":{"major":0,"patch":0,"minor":3},"hierarchy":{"paths":[["doc:\/\/WorldModule\/documentation\/WorldModule"]]},"kind":"symbol","metadata":{"modules":[{"name":"WorldModule"}],"role":"symbol","roleHeading":"Structure","externalID":"s:11WorldModule5SceneV","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Scene","kind":"identifier"}],"symbolKind":"struct","navigatorTitle":[{"text":"Scene","kind":"identifier"}],"title":"Scene","remoteSource":{"url":"https:\/\/github.com\/Tyler-Keith-Thompson\/ECS\/blob\/main\/Sources\/WorldModule\/Scene.swift#L664","fileName":"Scene.swift"}},"primaryContentSections":[{"declarations":[{"tokens":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"kind":"identifier","text":"Scene"}],"platforms":["Linux"],"languages":["swift"]}],"kind":"declarations"},{"mentions":["doc:\/\/WorldModule\/documentation\/WorldModule\/SavingAndLoadingWorlds"],"kind":"mentions"},{"content":[{"level":2,"text":"Overview","anchor":"overview","type":"heading"},{"inlineContent":[{"text":"Use a scene to save and load whole worlds, such as a game’s save file or a level made in an","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"editor, or to store a group of entities you spawn many times, such as an enemy squad. Take a"},{"type":"text","text":" "},{"type":"text","text":"scene with "},{"isActive":true,"type":"reference","identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/World\/scene(_:)"},{"type":"text","text":", passing a "},{"isActive":true,"type":"reference","identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/TypeRegistry"},{"type":"text","text":" of the types to save. Then either"},{"type":"text","text":" "},{"type":"text","text":"rebuild the whole world with "},{"code":"World(restoring:)","type":"codeVoice"},{"type":"text","text":", or add the scene’s entities to another"},{"type":"text","text":" "},{"type":"text","text":"world as new ones with "},{"identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/World\/spawn(contentsOf:)-7g753","type":"reference","isActive":true},{"text":".","type":"text"}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"A scene is "},{"type":"codeVoice","code":"Codable"},{"type":"text","text":". Encoding needs nothing more; decoding needs the registry in the"},{"type":"text","text":" "},{"type":"text","text":"decoder’s "},{"type":"codeVoice","code":"userInfo"},{"type":"text","text":" under "},{"type":"codeVoice","code":"CodingUserInfoKey.typeRegistry"},{"type":"text","text":":"}],"type":"paragraph"},{"syntax":"swift","code":["import Foundation","","var registry = TypeRegistry()","try registry.register(Name.self, named: \"Name\")","","var world = World()","let ship = world.spawn(Name(value: \"Ship\"))","let turret = world.spawn(Name(value: \"Turret\"))","try world.addChild(turret, to: ship)","let data = try JSONEncoder().encode(world.scene(registry))","","let decoder = JSONDecoder()","decoder.userInfo[.typeRegistry] = registry","let scene = try decoder.decode(Scene.self, from: data)","print(scene.count)","\/\/ Prints \"2\"","","let restored = World(restoring: scene)","print(restored.parent(of: turret) == ship)","\/\/ Prints \"true\""],"type":"codeListing"},{"inlineContent":[{"type":"text","text":"Restoring keeps every entity handle, live or stale, meaning the same as in the original"},{"type":"text","text":" "},{"type":"text","text":"world, and the restored world hands out the same handles from later spawns. Types the"},{"type":"text","text":" "},{"type":"text","text":"registry names but the data doesn’t are left out."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"A scene holds no hooks, observers, caches, indexes or change ticks, and the restored world’s"},{"type":"text","text":" "},{"type":"text","text":"components are all added at its first tick."}],"type":"paragraph"},{"style":"note","content":[{"type":"paragraph","inlineContent":[{"text":"Decoding throws ","type":"text"},{"code":"DecodingError.dataCorrupted","type":"codeVoice"},{"text":" when the decoder’s ","type":"text"},{"code":"userInfo","type":"codeVoice"},{"text":" has no","type":"text"},{"text":" ","type":"text"},{"text":"registry, when the data names a type the registry doesn’t, or for data that no world could","type":"text"},{"text":" ","type":"text"},{"text":"have produced.","type":"text"}]}],"name":"Note","type":"aside"}],"kind":"content"}],"variants":[{"paths":["\/documentation\/worldmodule\/scene"],"traits":[{"interfaceLanguage":"swift"}]}],"topicSections":[{"title":"Initializers","anchor":"Initializers","identifiers":["doc:\/\/WorldModule\/documentation\/WorldModule\/Scene\/init(from:)"],"generated":true},{"title":"Instance Properties","anchor":"Instance-Properties","identifiers":["doc:\/\/WorldModule\/documentation\/WorldModule\/Scene\/componentNames","doc:\/\/WorldModule\/documentation\/WorldModule\/Scene\/count","doc:\/\/WorldModule\/documentation\/WorldModule\/Scene\/resourceNames"],"generated":true},{"generated":true,"identifiers":["doc:\/\/WorldModule\/documentation\/WorldModule\/Scene\/encode(to:)"],"anchor":"