{"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/WorldModule\/documentation\/WorldModule\/Scene"},"topicSections":[{"identifiers":["doc:\/\/WorldModule\/documentation\/WorldModule\/Scene\/init(from:)"],"generated":true,"title":"Initializers","anchor":"Initializers"},{"identifiers":["doc:\/\/WorldModule\/documentation\/WorldModule\/Scene\/componentNames","doc:\/\/WorldModule\/documentation\/WorldModule\/Scene\/count","doc:\/\/WorldModule\/documentation\/WorldModule\/Scene\/resourceNames"],"generated":true,"title":"Instance Properties","anchor":"Instance-Properties"},{"identifiers":["doc:\/\/WorldModule\/documentation\/WorldModule\/Scene\/encode(to:)"],"generated":true,"title":"Instance Methods","anchor":"Instance-Methods"}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/worldmodule\/scene"]}],"kind":"symbol","metadata":{"title":"Scene","roleHeading":"Structure","externalID":"s:11WorldModule5SceneV","modules":[{"name":"WorldModule"}],"role":"symbol","symbolKind":"struct","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Scene","kind":"identifier"}],"navigatorTitle":[{"text":"Scene","kind":"identifier"}],"remoteSource":{"fileName":"Scene.swift","url":"https:\/\/github.com\/Tyler-Keith-Thompson\/ECS\/blob\/main\/Sources\/WorldModule\/Scene.swift#L664"}},"schemaVersion":{"minor":3,"patch":0,"major":0},"relationshipsSections":[{"identifiers":["doc:\/\/WorldModule\/Se","doc:\/\/WorldModule\/SE","doc:\/\/WorldModule\/s8SendableP","doc:\/\/WorldModule\/s16SendableMetatypeP"],"kind":"relationships","title":"Conforms To","type":"conformsTo"}],"seeAlsoSections":[{"identifiers":["doc:\/\/WorldModule\/documentation\/WorldModule\/SavingAndLoadingWorlds","doc:\/\/WorldModule\/documentation\/WorldModule\/WorldSnapshot","doc:\/\/WorldModule\/documentation\/WorldModule\/TypeRegistry","doc:\/\/WorldModule\/documentation\/WorldModule\/TypeRegistryError","doc:\/\/WorldModule\/documentation\/WorldModule\/TypeRegistryLookupError","doc:\/\/WorldModule\/documentation\/WorldModule\/MapEntities"],"generated":true,"title":"Saving and Loading Worlds","anchor":"Saving-and-Loading-Worlds"}],"abstract":[{"text":"A saved copy of a world’s entities, hierarchy, and the components and resources of the types","type":"text"},{"text":" ","type":"text"},{"text":"a registry names.","type":"text"}],"primaryContentSections":[{"kind":"declarations","declarations":[{"platforms":["Linux"],"tokens":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Scene","kind":"identifier"}],"languages":["swift"]}]},{"kind":"mentions","mentions":["doc:\/\/WorldModule\/documentation\/WorldModule\/DisablingEntitiesAndUsingPrefabs","doc:\/\/WorldModule\/documentation\/WorldModule\/SavingAndLoadingWorlds"]},{"kind":"content","content":[{"type":"heading","level":2,"text":"Overview","anchor":"overview"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Use a scene to save and load whole worlds, such as a game’s save file or a level made in an"},{"type":"text","text":" "},{"type":"text","text":"editor, or to store a group of entities you spawn many times, such as an enemy squad. Take a"},{"type":"text","text":" "},{"type":"text","text":"scene with "},{"identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/World\/scene(_:)","isActive":true,"type":"reference"},{"type":"text","text":", passing a "},{"identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/TypeRegistry","isActive":true,"type":"reference"},{"type":"text","text":" of the types to save. Then either"},{"type":"text","text":" "},{"type":"text","text":"rebuild the whole world with "},{"code":"World(restoring:)","type":"codeVoice"},{"type":"text","text":", or add the scene’s entities to another"},{"type":"text","text":" "},{"type":"text","text":"world as new ones with "},{"identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/World\/spawn(contentsOf:)-7g753","isActive":true,"type":"reference"},{"type":"text","text":"."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"A scene is "},{"type":"codeVoice","code":"Codable"},{"type":"text","text":". Encoding needs nothing more; decoding needs the registry in the"},{"type":"text","text":" "},{"type":"text","text":"decoder’s "},{"type":"codeVoice","code":"userInfo"},{"type":"text","text":" under "},{"type":"codeVoice","code":"CodingUserInfoKey.typeRegistry"},{"type":"text","text":":"}]},{"type":"codeListing","code":["import Foundation","","var registry = TypeRegistry()","try registry.register(Name.self, named: \"Name\")","","var world = World()","let ship = world.spawn(Name(value: \"Ship\"))","let turret = world.spawn(Name(value: \"Turret\"))","try world.addChild(turret, to: ship)","let data = try JSONEncoder().encode(world.scene(registry))","","let decoder = JSONDecoder()","decoder.userInfo[.typeRegistry] = registry","let scene = try decoder.decode(Scene.self, from: data)","print(scene.count)","\/\/ Prints \"2\"","","let restored = World(restoring: scene)","print(restored.parent(of: turret) == ship)","\/\/ Prints \"true\""],"syntax":"swift"},{"type":"paragraph","inlineContent":[{"text":"Restoring keeps every entity handle, live or stale, meaning the same as in the original","type":"text"},{"text":" ","type":"text"},{"text":"world, and the restored world hands out the same handles from later spawns. Types the","type":"text"},{"text":" ","type":"text"},{"text":"registry names but the data doesn’t are left out.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"A scene holds no hooks, observers, caches, indexes or change ticks, and the restored world’s","type":"text"},{"text":" ","type":"text"},{"text":"components are all added at its first tick.","type":"text"}]},{"type":"aside","style":"note","name":"Note","content":[{"inlineContent":[{"text":"Decoding throws ","type":"text"},{"code":"DecodingError.dataCorrupted","type":"codeVoice"},{"text":" when the decoder’s ","type":"text"},{"code":"userInfo","type":"codeVoice"},{"text":" has no","type":"text"},{"text":" ","type":"text"},{"text":"registry, when the data names a type the registry doesn’t, or for data that no world could","type":"text"},{"text":" ","type":"text"},{"text":"have produced.","type":"text"}],"type":"paragraph"}]}]}],"hierarchy":{"paths":[["doc:\/\/WorldModule\/documentation\/WorldModule"]]},"sections":[],"references":{"doc://WorldModule/documentation/WorldModule/World/scene(_:)":{"type":"topic","kind":"symbol","title":"scene(_:)","identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/World\/scene(_:)","abstract":[{"type":"text","text":"Returns a scene of the world’s entities, hierarchy, and the components and resources of"},{"type":"text","text":" "},{"type":"text","text":"the types a registry names."}],"role":"symbol","url":"\/documentation\/worldmodule\/world\/scene(_:)","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"scene"},{"kind":"text","text":"("},{"kind":"typeIdentifier","text":"TypeRegistry","preciseIdentifier":"s:11WorldModule12TypeRegistryV"},{"kind":"text","text":") -> "},{"kind":"typeIdentifier","text":"Scene","preciseIdentifier":"s:11WorldModule5SceneV"}]},"doc://WorldModule/Se":{"title":"Swift.Decodable","identifier":"doc:\/\/WorldModule\/Se","type":"unresolvable"},"doc://WorldModule/documentation/WorldModule/TypeRegistryError":{"url":"\/documentation\/worldmodule\/typeregistryerror","identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/TypeRegistryError","fragments":[{"text":"enum","kind":"keyword"},{"text":" ","kind":"text"},{"text":"TypeRegistryError","kind":"identifier"}],"kind":"symbol","abstract":[{"text":"An error that indicates why a type couldn’t be registered in a ","type":"text"},{"identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/TypeRegistry","isActive":true,"type":"reference"},{"text":".","type":"text"}],"title":"TypeRegistryError","type":"topic","role":"symbol","navigatorTitle":[{"text":"Typ