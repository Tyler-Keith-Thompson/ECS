{"topicSections":[{"anchor":"Initializers","title":"Initializers","identifiers":["doc:\/\/WorldModule\/documentation\/WorldModule\/Scene\/init(from:)"],"generated":true},{"anchor":"Instance-Properties","title":"Instance Properties","identifiers":["doc:\/\/WorldModule\/documentation\/WorldModule\/Scene\/componentNames","doc:\/\/WorldModule\/documentation\/WorldModule\/Scene\/count","doc:\/\/WorldModule\/documentation\/WorldModule\/Scene\/resourceNames"],"generated":true},{"anchor":"Instance-Methods","title":"Instance Methods","identifiers":["doc:\/\/WorldModule\/documentation\/WorldModule\/Scene\/encode(to:)"],"generated":true}],"kind":"symbol","hierarchy":{"paths":[["doc:\/\/WorldModule\/documentation\/WorldModule"]]},"relationshipsSections":[{"type":"conformsTo","kind":"relationships","title":"Conforms To","identifiers":["doc:\/\/WorldModule\/Se","doc:\/\/WorldModule\/SE","doc:\/\/WorldModule\/s8SendableP","doc:\/\/WorldModule\/s16SendableMetatypeP"]}],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/WorldModule\/documentation\/WorldModule\/Scene"},"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/worldmodule\/scene"]}],"sections":[],"schemaVersion":{"patch":0,"minor":3,"major":0},"metadata":{"fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Scene","kind":"identifier"}],"roleHeading":"Structure","modules":[{"name":"WorldModule"}],"remoteSource":{"fileName":"Scene.swift","url":"https:\/\/github.com\/Tyler-Keith-Thompson\/ECS\/blob\/main\/Sources\/WorldModule\/Scene.swift#L664"},"symbolKind":"struct","role":"symbol","title":"Scene","externalID":"s:11WorldModule5SceneV","navigatorTitle":[{"text":"Scene","kind":"identifier"}]},"seeAlsoSections":[{"anchor":"Saving-and-Loading-Worlds","title":"Saving and Loading Worlds","identifiers":["doc:\/\/WorldModule\/documentation\/WorldModule\/SavingAndLoadingWorlds","doc:\/\/WorldModule\/documentation\/WorldModule\/WorldSnapshot","doc:\/\/WorldModule\/documentation\/WorldModule\/TypeRegistry","doc:\/\/WorldModule\/documentation\/WorldModule\/TypeRegistryError","doc:\/\/WorldModule\/documentation\/WorldModule\/TypeRegistryLookupError","doc:\/\/WorldModule\/documentation\/WorldModule\/MapEntities"],"generated":true}],"abstract":[{"text":"A saved copy of a world’s entities, hierarchy, and the components and resources of the types","type":"text"},{"text":" ","type":"text"},{"text":"a registry names.","type":"text"}],"primaryContentSections":[{"kind":"declarations","declarations":[{"languages":["swift"],"tokens":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"Scene"}],"platforms":["Linux"]}]},{"kind":"mentions","mentions":["doc:\/\/WorldModule\/documentation\/WorldModule\/SavingAndLoadingWorlds"]},{"kind":"content","content":[{"level":2,"type":"heading","text":"Overview","anchor":"overview"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Use a scene to save and load whole worlds, such as a game’s save file or a level made in an"},{"type":"text","text":" "},{"type":"text","text":"editor, or to store a group of entities you spawn many times, such as an enemy squad. Take a"},{"type":"text","text":" "},{"type":"text","text":"scene with "},{"type":"reference","isActive":true,"identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/World\/scene(_:)"},{"type":"text","text":", passing a "},{"type":"reference","isActive":true,"identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/TypeRegistry"},{"type":"text","text":" of the types to save. Then either"},{"type":"text","text":" "},{"type":"text","text":"rebuild the whole world with "},{"type":"codeVoice","code":"World(restoring:)"},{"type":"text","text":", or add the scene’s entities to another"},{"type":"text","text":" "},{"type":"text","text":"world as new ones with "},{"type":"reference","isActive":true,"identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/World\/spawn(contentsOf:)-7g753"},{"type":"text","text":"."}]},{"type":"paragraph","inlineContent":[{"text":"A scene is ","type":"text"},{"code":"Codable","type":"codeVoice"},{"text":". Encoding needs nothing more; decoding needs the registry in the","type":"text"},{"text":" ","type":"text"},{"text":"decoder’s ","type":"text"},{"code":"userInfo","type":"codeVoice"},{"text":" under ","type":"text"},{"code":"CodingUserInfoKey.typeRegistry","type":"codeVoice"},{"text":":","type":"text"}]},{"syntax":"swift","type":"codeListing","code":["import Foundation","","var registry = TypeRegistry()","try registry.register(Name.self, named: \"Name\")","","var world = World()","let ship = world.spawn(Name(value: \"Ship\"))","let turret = world.spawn(Name(value: \"Turret\"))","try world.addChild(turret, to: ship)","let data = try JSONEncoder().encode(world.scene(registry))","","let decoder = JSONDecoder()","decoder.userInfo[.typeRegistry] = registry","let scene = try decoder.decode(Scene.self, from: data)","print(scene.count)","\/\/ Prints \"2\"","","let restored = World(restoring: scene)","print(restored.parent(of: turret) == ship)","\/\/ Prints \"true\""]},{"type":"paragraph","inlineContent":[{"text":"Restoring keeps every entity handle, live or stale, meaning the same as in the original","type":"text"},{"text":" ","type":"text"},{"text":"world, and the restored world hands out the same handles from later spawns. Types the","type":"text"},{"text":" ","type":"text"},{"text":"registry names but the data doesn’t are left out.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"A scene holds no hooks, observers, caches, indexes or change ticks, and the restored world’s","type":"text"},{"text":" ","type":"text"},{"text":"components are all added at its first tick.","type":"text"}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"Decoding throws ","type":"text"},{"type":"codeVoice","code":"DecodingError.dataCorrupted"},{"text":" when the decoder’s ","type":"text"},{"type":"codeVoice","code":"userInfo"},{"text":" has no","type":"text"},{"text":" ","type":"text"},{"text":"registry, when the data names a type the registry doesn’t, or for data that no world could","type":"text"},{"text":" ","type":"text"},{"text":"have produced.","type":"text"}]}],"type":"aside","style":"note","name":"Note"}]}],"references":{"doc://WorldModule/documentation/WorldModule/Scene/encode(to:)":{"title":"encode(to:)","url":"\/documentation\/worldmodule\/scene\/encode(to:)","role":"symbol","kind":"symbol","type":"topic","abstract":[{"text":"Encodes the scene into the given encoder.","type":"text"}],"identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/Scene\/encode(to:)","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"encode"},{"kind":"text","text":"("},{"kind":"externalParam","text":"to"},{"kind":"text","text":": any "},{"kind":"typeIdentifier","text":"Encoder","preciseIdentifier":"s:s7EncoderP"},{"kind":"text","text":") "},{"kind":"keyword","text":"throws"}]},"doc://WorldModule/documentation/WorldModule/World/spawn(contentsOf:)-7g753":{"title":"spawn(contentsOf:)","url":"\/documentation\/worldmodule\/world\/spawn(contentsof:)-7g753","role":"symbol","kind":"symbol","type":"topic","identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/World\/spawn(contentsOf:)-7g753","abstract":[{"type":"text","text":"Adds the entities of a scene to the world as new entities, and inserts the scene’s"},{"type":"text","text":" "},{"type":"text","text":"resources."}],"fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"spawn","kind":"identifier"},{"text":"(","kind":"text"},{"text":"contentsOf","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"Scene","preciseIdentifier":"s:11WorldModule5SceneV","kind":"typeIdentifier"},{"text":") -> [","kind":"text"},{"text":"Entity","preciseIdentifier":"s:11WorldModule6EntityV","kind":"typeIdentifier"},{"text":" : ","kind":"text"},{"text":"Entity","preciseIdentifier":"s:11Worl