{"kind":"symbol","identifier":{"url":"doc:\/\/WorldModule\/documentation\/WorldModule\/Scene","interfaceLanguage":"swift"},"primaryContentSections":[{"declarations":[{"platforms":["Linux"],"tokens":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Scene","kind":"identifier"}],"languages":["swift"]}],"kind":"declarations"},{"kind":"mentions","mentions":["doc:\/\/WorldModule\/documentation\/WorldModule\/SavingAndLoadingWorlds"]},{"content":[{"level":2,"text":"Overview","type":"heading","anchor":"overview"},{"type":"paragraph","inlineContent":[{"text":"Use a scene to save and load whole worlds, such as a game’s save file or a level made in an","type":"text"},{"text":" ","type":"text"},{"text":"editor, or to store a group of entities you spawn many times, such as an enemy squad. Take a","type":"text"},{"text":" ","type":"text"},{"text":"scene with ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/World\/scene(_:)"},{"text":", passing a ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/TypeRegistry"},{"text":" of the types to save. Then either","type":"text"},{"text":" ","type":"text"},{"text":"rebuild the whole world with ","type":"text"},{"code":"World(restoring:)","type":"codeVoice"},{"text":", or add the scene’s entities to another","type":"text"},{"text":" ","type":"text"},{"text":"world as new ones with ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/World\/spawn(contentsOf:)-7g753"},{"text":".","type":"text"}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"A scene is "},{"type":"codeVoice","code":"Codable"},{"type":"text","text":". Encoding needs nothing more; decoding needs the registry in the"},{"type":"text","text":" "},{"type":"text","text":"decoder’s "},{"type":"codeVoice","code":"userInfo"},{"type":"text","text":" under "},{"type":"codeVoice","code":"CodingUserInfoKey.typeRegistry"},{"type":"text","text":":"}]},{"type":"codeListing","syntax":"swift","code":["import Foundation","","var registry = TypeRegistry()","try registry.register(Name.self, named: \"Name\")","","var world = World()","let ship = world.spawn(Name(value: \"Ship\"))","let turret = world.spawn(Name(value: \"Turret\"))","try world.addChild(turret, to: ship)","let data = try JSONEncoder().encode(world.scene(registry))","","let decoder = JSONDecoder()","decoder.userInfo[.typeRegistry] = registry","let scene = try decoder.decode(Scene.self, from: data)","print(scene.count)","\/\/ Prints \"2\"","","let restored = World(restoring: scene)","print(restored.parent(of: turret) == ship)","\/\/ Prints \"true\""]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Restoring keeps every entity handle, live or stale, meaning the same as in the original"},{"type":"text","text":" "},{"type":"text","text":"world, and the restored world hands out the same handles from later spawns. Types the"},{"type":"text","text":" "},{"type":"text","text":"registry names but the data doesn’t are left out."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"A scene holds no hooks, observers, caches, indexes or change ticks, and the restored world’s"},{"type":"text","text":" "},{"type":"text","text":"components are all added at its first tick."}]},{"style":"note","name":"Note","type":"aside","content":[{"type":"paragraph","inlineContent":[{"text":"Decoding throws ","type":"text"},{"code":"DecodingError.dataCorrupted","type":"codeVoice"},{"text":" when the decoder’s ","type":"text"},{"code":"userInfo","type":"codeVoice"},{"text":" has no","type":"text"},{"text":" ","type":"text"},{"text":"registry, when the data names a type the registry doesn’t, or for data that no world could","type":"text"},{"text":" ","type":"text"},{"text":"have produced.","type":"text"}]}]}],"kind":"content"}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/worldmodule\/scene"]}],"metadata":{"role":"symbol","modules":[{"name":"WorldModule"}],"navigatorTitle":[{"text":"Scene","kind":"identifier"}],"externalID":"s:11WorldModule5SceneV","symbolKind":"struct","roleHeading":"Structure","title":"Scene","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"Scene"}],"remoteSource":{"url":"https:\/\/github.com\/Tyler-Keith-Thompson\/ECS\/blob\/main\/Sources\/WorldModule\/Scene.swift#L664","fileName":"Scene.swift"}},"schemaVersion":{"major":0,"patch":0,"minor":3},"hierarchy":{"paths":[["doc:\/\/WorldModule\/documentation\/WorldModule"]]},"sections":[],"abstract":[{"text":"A saved copy of a world’s entities, hierarchy, and the components and resources of the types","type":"text"},{"text":" ","type":"text"},{"text":"a registry names.","type":"text"}],"relationshipsSections":[{"identifiers":["doc:\/\/WorldModule\/Se","doc:\/\/WorldModule\/SE","doc:\/\/WorldModule\/s8SendableP","doc:\/\/WorldModule\/s16SendableMetatypeP"],"type":"conformsTo","kind":"relationships","title":"Conforms To"}],"seeAlsoSections":[{"anchor":"Saving-and-Loading-Worlds","generated":true,"identifiers":["doc:\/\/WorldModule\/documentation\/WorldModule\/SavingAndLoadingWorlds","doc:\/\/WorldModule\/documentation\/WorldModule\/WorldSnapshot","doc:\/\/WorldModule\/documentation\/WorldModule\/TypeRegistry","doc:\/\/WorldModule\/documentation\/WorldModule\/TypeRegistryError","doc:\/\/WorldModule\/documentation\/WorldModule\/TypeRegistryLookupError","doc:\/\/WorldModule\/documentation\/WorldModule\/MapEntities"],"title":"Saving and Loading Worlds"}],"topicSections":[{"anchor":"Initializers","generated":true,"identifiers":["doc:\/\/WorldModule\/documentation\/WorldModule\/Scene\/init(from:)"],"title":"Initializers"},{"anchor":"Instance-Properties","generated":true,"identifiers":["doc:\/\/WorldModule\/documentation\/WorldModule\/Scene\/componentNames","doc:\/\/WorldModule\/documentation\/World