{"schemaVersion":{"major":0,"patch":0,"minor":3},"metadata":{"roleHeading":"Structure","externalID":"s:11WorldModule5SceneV","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"kind":"identifier","text":"Scene"}],"navigatorTitle":[{"kind":"identifier","text":"Scene"}],"role":"symbol","symbolKind":"struct","remoteSource":{"url":"https:\/\/github.com\/Tyler-Keith-Thompson\/ECS\/blob\/main\/Sources\/WorldModule\/Scene.swift#L664","fileName":"Scene.swift"},"title":"Scene","modules":[{"name":"WorldModule"}]},"relationshipsSections":[{"kind":"relationships","identifiers":["doc:\/\/WorldModule\/Se","doc:\/\/WorldModule\/SE","doc:\/\/WorldModule\/s8SendableP","doc:\/\/WorldModule\/s16SendableMetatypeP"],"type":"conformsTo","title":"Conforms To"}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/worldmodule\/scene"]}],"kind":"symbol","topicSections":[{"identifiers":["doc:\/\/WorldModule\/documentation\/WorldModule\/Scene\/init(from:)"],"generated":true,"anchor":"Initializers","title":"Initializers"},{"identifiers":["doc:\/\/WorldModule\/documentation\/WorldModule\/Scene\/componentNames","doc:\/\/WorldModule\/documentation\/WorldModule\/Scene\/count","doc:\/\/WorldModule\/documentation\/WorldModule\/Scene\/resourceNames"],"generated":true,"anchor":"Instance-Properties","title":"Instance Properties"},{"identifiers":["doc:\/\/WorldModule\/documentation\/WorldModule\/Scene\/encode(to:)"],"generated":true,"anchor":"Instance-Methods","title":"Instance Methods"}],"sections":[],"abstract":[{"type":"text","text":"A saved copy of a world’s entities, hierarchy, and the components and resources of the types"},{"type":"text","text":" "},{"type":"text","text":"a registry names."}],"primaryContentSections":[{"kind":"declarations","declarations":[{"tokens":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"Scene"}],"languages":["swift"],"platforms":["Linux"]}]},{"kind":"mentions","mentions":["doc:\/\/WorldModule\/documentation\/WorldModule\/SavingAndLoadingWorlds"]},{"kind":"content","content":[{"anchor":"overview","type":"heading","level":2,"text":"Overview"},{"type":"paragraph","inlineContent":[{"text":"Use a scene to save and load whole worlds, such as a game’s save file or a level made in an","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"editor, or to store a group of entities you spawn many times, such as an enemy squad. Take a"},{"type":"text","text":" "},{"type":"text","text":"scene with "},{"identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/World\/scene(_:)","isActive":true,"type":"reference"},{"type":"text","text":", passing a "},{"identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/TypeRegistry","isActive":true,"type":"reference"},{"type":"text","text":" of the types to save. Then either"},{"text":" ","type":"text"},{"text":"rebuild the whole world with ","type":"text"},{"code":"World(restoring:)","type":"codeVoice"},{"text":", or add the scene’s entities to another","type":"text"},{"text":" ","type":"text"},{"text":"world as new ones with ","type":"text"},{"isActive":true,"identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/World\/spawn(contentsOf:)","type":"reference"},{"text":".","type":"text"}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"A scene is "},{"type":"codeVoice","code":"Codable"},{"type":"text","text":". Encoding needs nothing more; decoding needs the registry in the"},{"type":"text","text":" "},{"type":"text","text":"decoder’s "},{"type":"codeVoice","code":"userInfo"},{"type":"text","text":" under "},{"type":"codeVoice","code":"CodingUserInfoKey.typeRegistry"},{"type":"text","text":":"}]},{"code":["import Foundation","","var registry = TypeRegistry()","try registry.register(Name.self, named: \"Name\")","","var world = World()","let ship = world.spawn(Name(value: \"Ship\"))","let turret = world.spawn(Name(value: \"Turret\"))","try world.addChild(turret, to: ship)","let data = try JSONEncoder().encode(world.scene(registry))","","let decoder = JSONDecoder()","decoder.userInfo[.typeRegistry] = registry","let scene = try decoder.decode(Scene.self, from: data)","print(scene.count)","\/\/ Prints \"2\"","","let restored = World(restoring: scene)","print(restored.parent(of: turret) == ship)","\/\/ Prints \"true\""],"type":"codeListing","syntax":"swift"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Restoring keeps every entity handle, live or stale, meaning the same as in the original"},{"type":"text","text":" "},{"type":"text","text":"world, and the restored world hands out the same handles from later spawns. Types the"},{"type":"text","text":" "},{"type":"text","text":"registry names but the data doesn’t are left out."}]},{"type":"paragraph","inlineContent":[{"text":"A scene holds no hooks, observers, caches, indexes or change ticks, and the restored world’s","type":"text"},{"text":" ","type":"text"},{"text":"components are all added at its first tick.","type":"text"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Decoding throws "},{"code":"DecodingError.dataCorrupted","type":"codeVoice"},{"type":"text","text":" when the decoder’s "},{"code":"userInfo","type":"codeVoice"},{"type":"text","text":" has no"},{"type":"text","text":" "},{"type":"text","text":"registry, when the data names a type the registry doesn’t, or for data that no world could"},{"type":"text","text":" "},{"type":"text","text":"have produced."}]}],"type":"aside","name":"Note","style":"note"}]}],"hierarchy":{"paths":[["doc:\/\/WorldModule\/documentation\/WorldModule"]]},"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/WorldModule\/documentation\/WorldModule\/Scene"},"seeAlsoSections":[{"identifiers":["doc:\/\/WorldModule\/documentation\/WorldModule\/SavingAndLoadingWorlds","doc:\/\/WorldModule\/documentation\/WorldModule\/WorldSnapshot","doc:\/\/WorldModule\/documentation\/WorldModule\/TypeRegistry","doc:\/\/WorldModule\/documentation\/WorldModule\/TypeRegistryError","doc:\/\/WorldModule\/documentation\/WorldModule\/TypeRegistryLookupError","doc:\/\/WorldModule\/documentation\/WorldModule\/MapEntities"],"generated":true,"anchor":"Saving-and-Loading-Worlds","title":"Saving and Loading Worlds"}],"references":{"doc://WorldModule/documentation/WorldModule/WorldSnapshot":{"role":"symbol","type":"topic","abstract":[{"type":"text","text":"A saved copy of a world’s entities, hierarchy and the components of the listed types."}],"kind":"symbol","title":"WorldSnapshot","url":"\/documentation\/worldmodule\/worldsnapshot","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"WorldSnapshot"}],"navigatorTitle":[{"kind":"identifier","text":"WorldSnapshot"}],"identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/WorldSnapshot"},"doc://WorldModule/documentation/WorldModule/World/scene(_:)":{"url":"\/documentation\/worldmodule\/world\/scene(_:)","title":"scene(_:)","abstract":[{"type":"text","text":"Returns a scene of the world’s entities, hierarchy, and the components and resources of"},{"type":"text","text":" "},{"type":"text","text":"the types a registry names."}],"kind":"symbol","identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/World\/scene(_:)","type":"topic","role":"symbol","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"scene","kind":"identifier"},{"text":"(","kind":"text"},{"text":"TypeRegistry","kind":"typeIdentifier","preciseIdentifier":"s:11WorldModule12TypeRegistryV"},{"text":") -> ","kind":"text"},{"text":"Scene","kind":"typeIdentifier","preciseIdentifier":"s:11WorldModule5SceneV"}]},"doc://WorldModule/documentation/WorldModule/Scene/resourceNames":{"identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/Scene\/resourceNames","kind":"symbol","url":"\/documentation\/worldmodule\/scene\/resourcenames","type":"topic","abstract":[{"text":"The names of the resource types saved, in