{"kind":"symbol","identifier":{"interfaceLanguage":"swift","url":"doc:\/\/WorldModule\/documentation\/WorldModule\/Scene"},"abstract":[{"type":"text","text":"A saved copy of a world’s entities, hierarchy, and the components and resources of the types"},{"type":"text","text":" "},{"type":"text","text":"a registry names."}],"seeAlsoSections":[{"title":"Saving and Loading Worlds","anchor":"Saving-and-Loading-Worlds","generated":true,"identifiers":["doc:\/\/WorldModule\/documentation\/WorldModule\/SavingAndLoadingWorlds","doc:\/\/WorldModule\/documentation\/WorldModule\/WorldSnapshot","doc:\/\/WorldModule\/documentation\/WorldModule\/TypeRegistry","doc:\/\/WorldModule\/documentation\/WorldModule\/TypeRegistryError","doc:\/\/WorldModule\/documentation\/WorldModule\/TypeRegistryLookupError","doc:\/\/WorldModule\/documentation\/WorldModule\/MapEntities"]}],"schemaVersion":{"patch":0,"minor":3,"major":0},"metadata":{"fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Scene","kind":"identifier"}],"externalID":"s:11WorldModule5SceneV","title":"Scene","remoteSource":{"fileName":"Scene.swift","url":"https:\/\/github.com\/Tyler-Keith-Thompson\/ECS\/blob\/main\/Sources\/WorldModule\/Scene.swift#L664"},"navigatorTitle":[{"kind":"identifier","text":"Scene"}],"modules":[{"name":"WorldModule"}],"symbolKind":"struct","role":"symbol","roleHeading":"Structure"},"topicSections":[{"title":"Initializers","anchor":"Initializers","generated":true,"identifiers":["doc:\/\/WorldModule\/documentation\/WorldModule\/Scene\/init(from:)"]},{"title":"Instance Properties","anchor":"Instance-Properties","generated":true,"identifiers":["doc:\/\/WorldModule\/documentation\/WorldModule\/Scene\/componentNames","doc:\/\/WorldModule\/documentation\/WorldModule\/Scene\/count","doc:\/\/WorldModule\/documentation\/WorldModule\/Scene\/resourceNames"]},{"title":"Instance Methods","anchor":"Instance-Methods","generated":true,"identifiers":["doc:\/\/WorldModule\/documentation\/WorldModule\/Scene\/encode(to:)"]}],"hierarchy":{"paths":[["doc:\/\/WorldModule\/documentation\/WorldModule"]]},"relationshipsSections":[{"kind":"relationships","type":"conformsTo","title":"Conforms To","identifiers":["doc:\/\/WorldModule\/Se","doc:\/\/WorldModule\/SE","doc:\/\/WorldModule\/s8SendableP","doc:\/\/WorldModule\/s16SendableMetatypeP"]}],"primaryContentSections":[{"kind":"declarations","declarations":[{"tokens":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Scene","kind":"identifier"}],"languages":["swift"],"platforms":["Linux"]}]},{"kind":"mentions","mentions":["doc:\/\/WorldModule\/documentation\/WorldModule\/DisablingEntitiesAndUsingPrefabs","doc:\/\/WorldModule\/documentation\/WorldModule\/SavingAndLoadingWorlds"]},{"kind":"content","content":[{"anchor":"overview","type":"heading","text":"Overview","level":2},{"type":"paragraph","inlineContent":[{"text":"Use a scene to save and load whole worlds, such as a game’s save file or a level made in an","type":"text"},{"text":" ","type":"text"},{"text":"editor, or to store a group of entities you spawn many times, such as an enemy squad. Take a","type":"text"},{"text":" ","type":"text"},{"text":"scene with ","type":"text"},{"identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/World\/scene(_:)","isActive":true,"type":"reference"},{"text":", passing a ","type":"text"},{"identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/TypeRegistry","isActive":true,"type":"reference"},{"text":" of the types to save. Then either","type":"text"},{"text":" ","type":"text"},{"text":"rebuild the whole world with ","type":"text"},{"code":"World(restoring:)","type":"codeVoice"},{"text":", or add the scene’s entities to another","type":"text"},{"text":" ","type":"text"},{"text":"world as new ones with ","type":"text"},{"identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/World\/spawn(contentsOf:)-7g753","isActive":true,"type":"reference"},{"text":".","type":"text"}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"A scene is "},{"type":"codeVoice","code":"Codable"},{"type":"text","text":". Encoding needs nothing more; decoding needs the registry in the"},{"type":"text","text":" "},{"type":"text","text":"decoder’s "},{"type":"codeVoice","code":"userInfo"},{"type":"text","text":" under "},{"type":"codeVoice","code":"CodingUserInfoKey.typeRegistry"},{"type":"text","text":":"}]},{"type":"codeListing","syntax":"swift","code":["import Foundation","","var registry = TypeRegistry()","try registry.register(Name.self, named: \"Name\")","","var world = World()","let ship = world.spawn(Name(value: \"Ship\"))","let turret = world.spawn(Name(value: \"Turret\"))","try world.addChild(turret, to: ship)","let data = try JSONEncoder().encode(world.scene(registry))","","let decoder = JSONDecoder()","decoder.userInfo[.typeRegistry] = registry","let scene = try decoder.decode(Scene.self, from: data)","print(scene.count)","\/\/ Prints \"2\"","","let restored = World(restoring: scene)","print(restored.parent(of: turret) == ship)","\/\/ Prints \"true\""]},{"type":"paragraph","inlineContent":[{"text":"Restoring keeps every entity handle, live or stale, meaning the same as in the original","type":"text"},{"text":" ","type":"text"},{"text":"world, and the restored world hands out the same handles from later spawns. Types the","type":"text"},{"text":" ","type":"text"},{"text":"registry names but the data doesn’t are left out.","type":"text"}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"A scene holds no hooks, observers, caches, indexes or change ticks, and the restored world’s"},{"type":"text","text":" "},{"type":"text","text":"components are all added at its first tick."}]},{"content":[{"inlineContent":[{"type":"text","text":"Decoding throws "},{"code":"DecodingError.dataCorrupted","type":"codeVoice"},{"type":"text","text":" when the decoder’s "},{"code":"userInfo","type":"codeVoice"},{"type":"text","text":" has no"},{"type":"text","text":" "},{"type":"text","text":"registry, when the data names a type the registry doesn’t, or for data that no world could"},{"type":"text","text":" "},{"type":"text","text":"have produced."}],"type":"paragraph"}],"type":"aside","name":"Note","style":"note"}]}],"variants":[{"paths":["\/documentation\/worldmodule\/scene"],"traits":[{"interfaceLanguage":"swift"}]}],"sections":[],"references":{"doc://WorldModule/documentation/WorldModule/Scene/resourceNames":{"title":"resourceNames","abstract":[{"text":"The names of the resource types saved, in registration order.","type":"text"}],"identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/Scene\/resourceNames","kind":"symbol","url":"\/documentation\/worldmodule\/scene\/resourcenames","role":"symbol","fragments":[{"kind":"keyword","text":"var"},{"kind":"text","text":" "},{"kind":"identifier","text":"resourceNames"},{"kind":"text","text":": ["},{"preciseIdentifier":"s:SS","kind":"typeIdentifier","text":"String"},{"kind":"text","text":"]"}],"type":"topic"},"doc://WorldModule/s8SendableP":{"type":"unresolvable","title":"Swift.Sendable","identifier":"doc:\/\/WorldModule\/s8SendableP"},"doc://WorldModule/documentation/WorldModule/DisablingEntitiesAndUsingPrefabs":{"abstract":[{"type":"text","text":"Take entities out of play without despawning them, and spawn copies of entities and templates."}],"url":"\/documentation\/worldmodule\/disablingentitiesandusingprefabs","role":"article","type":"topic","kind":"article","identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/DisablingEntitiesAndUsingPrefabs","title":"Disabling Entities and Using Prefabs"},"doc://WorldModule/documentation/WorldModule/Scene/encode(to:)":{"kind":"symbol","role":"symbol","url":"\/documentation\/worldmodule\/scene\/encode(to:)","type":"topic","title":"encode(to:)","identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/Scene\/encode(to:)","abstract":[{"type":"text","text":"Encodes the scene into the given encoder."}],"fragments":[{"text":"func",