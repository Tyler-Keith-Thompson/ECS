{"abstract":[{"type":"text","text":"A saved copy of a world’s entities, hierarchy and the components of the listed types."}],"primaryContentSections":[{"declarations":[{"languages":["swift"],"tokens":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"WorldSnapshot","kind":"identifier"},{"text":"<each ","kind":"text"},{"text":"C","kind":"genericParameter"},{"text":"> ","kind":"text"},{"text":"where","kind":"keyword"},{"text":" repeat each ","kind":"text"},{"text":"C","kind":"typeIdentifier"},{"text":" : ","kind":"text"},{"text":"Decodable","kind":"typeIdentifier","preciseIdentifier":"s:Se"},{"text":", repeat each ","kind":"text"},{"text":"C","kind":"typeIdentifier"},{"text":" : ","kind":"text"},{"text":"Encodable","kind":"typeIdentifier","preciseIdentifier":"s:SE"},{"text":", repeat each ","kind":"text"},{"text":"C","kind":"typeIdentifier"},{"text":" : ","kind":"text"},{"text":"Component","identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/Component","kind":"typeIdentifier","preciseIdentifier":"s:11WorldModule9ComponentP"}],"platforms":["Linux"]}],"kind":"declarations"},{"mentions":["doc:\/\/WorldModule\/documentation\/WorldModule\/SavingAndLoadingWorlds"],"kind":"mentions"},{"content":[{"anchor":"overview","type":"heading","text":"Overview","level":2},{"inlineContent":[{"text":"Use a snapshot to save a world and restore it later, or to compare two worlds. A snapshot","type":"text"},{"text":" ","type":"text"},{"text":"is ","type":"text"},{"code":"Codable","type":"codeVoice"},{"text":", so you can encode it with any encoder, such as ","type":"text"},{"code":"JSONEncoder","type":"codeVoice"},{"text":". Take one with","type":"text"},{"text":" ","type":"text"},{"isActive":true,"identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/World\/snapshot(_:)","type":"reference"},{"text":", listing the component types to save, and rebuild a world from it","type":"text"},{"text":" ","type":"text"},{"text":"with ","type":"text"},{"code":"World(restoring:)","type":"codeVoice"},{"text":". Each component type you save must conform to ","type":"text"},{"code":"Codable","type":"codeVoice"},{"text":".","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"The following example saves a world as JSON and restores it:","type":"text"}],"type":"paragraph"},{"syntax":"swift","type":"codeListing","code":["import Foundation","","var world = World()","let ship = world.spawn(Position(x: 1, y: 2), Health(current: 3))","let data = try JSONEncoder().encode(world.snapshot(Position.self, Health.self))","","let decoded = try JSONDecoder().decode(WorldSnapshot<Position, Health>.self, from: data)","let restored = World(restoring: decoded)","print(restored[Position.self, of: ship])","\/\/ Prints \"Position(x: 1.0, y: 2.0)\""]},{"inlineContent":[{"text":"Every entity handle, live or stale, means the same in the restored world as in the original,","type":"text"},{"text":" ","type":"text"},{"text":"so handles you saved elsewhere stay valid. The restored world also hands out the same handles","type":"text"},{"text":" ","type":"text"},{"text":"from later spawns.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"A snapshot holds no resources, hooks or change ticks, and the restored world’s components","type":"text"},{"text":" ","type":"text"},{"text":"are all added at its first tick. To save resources too, or to save a world without listing","type":"text"},{"text":" ","type":"text"},{"text":"its types at each call, use a ","type":"text"},{"type":"reference","isActive":true,"identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/Scene"},{"text":".","type":"text"}],"type":"paragraph"},{"name":"Note","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Decoding throws "},{"type":"codeVoice","code":"DecodingError.dataCorrupted"},{"type":"text","text":" for data that no world could have"},{"type":"text","text":" "},{"type":"text","text":"produced, such as a component of an entity that isn’t 