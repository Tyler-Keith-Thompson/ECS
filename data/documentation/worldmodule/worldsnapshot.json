{"abstract":[{"type":"text","text":"A saved copy of a world’s entities, hierarchy and the components of the listed types."}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/worldmodule\/worldsnapshot"]}],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/WorldModule\/documentation\/WorldModule\/WorldSnapshot"},"kind":"symbol","schemaVersion":{"patch":0,"major":0,"minor":3},"seeAlsoSections":[{"anchor":"Saving-and-Loading-Worlds","title":"Saving and Loading Worlds","generated":true,"identifiers":["doc:\/\/WorldModule\/documentation\/WorldModule\/SavingAndLoadingWorlds","doc:\/\/WorldModule\/documentation\/WorldModule\/Scene","doc:\/\/WorldModule\/documentation\/WorldModule\/TypeRegistry","doc:\/\/WorldModule\/documentation\/WorldModule\/TypeRegistryError","doc:\/\/WorldModule\/documentation\/WorldModule\/TypeRegistryLookupError","doc:\/\/WorldModule\/documentation\/WorldModule\/MapEntities"]}],"topicSections":[{"title":"Initializers","anchor":"Initializers","generated":true,"identifiers":["doc:\/\/WorldModule\/documentation\/WorldModule\/WorldSnapshot\/init(from:)"]},{"title":"Instance Properties","anchor":"Instance-Properties","generated":true,"identifiers":["doc:\/\/WorldModule\/documentation\/WorldModule\/WorldSnapshot\/count"]},{"title":"Instance Methods","anchor":"Instance-Methods","generated":true,"identifiers":["doc:\/\/WorldModule\/documentation\/WorldModule\/WorldSnapshot\/encode(to:)"]},{"title":"Default Implementations","anchor":"Default-Implementations","generated":true,"identifiers":["doc:\/\/WorldModule\/documentation\/WorldModule\/WorldSnapshot\/Equatable-Implementations"]}],"hierarchy":{"paths":[["doc:\/\/WorldModule\/documentation\/WorldModule"]]},"sections":[],"primaryContentSections":[{"declarations":[{"tokens":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"WorldSnapshot"},{"text":"<each ","kind":"text"},{"text":"C","kind":"genericParameter"},{"text":"> ","kind":"text"},{"text":"where","kind":"keyword"},{"text":" repeat each ","kind":"text"},{"text":"C","kind":"typeIdentifier"},{"text":" : ","kind":"text"},{"kind":"typeIdentifier","preciseIdentifier":"s:Se","text":"Decodable"},{"kind":"text","text":", repeat each "},{"kind":"typeIdentifier","text":"C"},{"kind":"text","text":" : "},{"kind":"typeIdentifier","preciseIdentifier":"s:SE","text":"Encodable"},{"kind":"text","text":", repeat each "},{"kind":"typeIdentifier","text":"C"},{"text":" : ","kind":"text"},{"identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/Component","text":"Component","kind":"typeIdentifier","preciseIdentifier":"s:11WorldModule9ComponentP"}],"platforms":["Linux"],"languages":["swift"]}],"kind":"declarations"},{"mentions":["doc:\/\/WorldModule\/documentation\/WorldModule\/SavingAndLoadingWorlds"],"kind":"mentions"},{"content":[{"level":2,"text":"Overview","anchor":"overview","type":"heading"},{"inlineContent":[{"type":"text","text":"Use a snapshot to save a world and restore it later, or to compare two worlds. A snapshot"},{"text":" ","type":"text"},{"text":"is ","type":"text"},{"type":"codeVoice","code":"Codable"},{"text":", so you can encode it with any encoder, such as ","type":"text"},{"type":"codeVoice","code":"JSONEncoder"},{"text":". Take one with","type":"text"},{"text":" ","type":"text"},{"type":"reference","identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/World\/snapshot(_:)","isActive":true},{"text":", listing the component types to save, and rebuild a world from it","type":"text"},{"text":" ","type":"text"},{"text":"with ","type":"text"},{"code":"World(restoring:)","type":"codeVoice"},{"text":". Each component type you save must conform to ","type":"text"},{"code":"Codable","type":"codeVoice"},{"text":".","type":"text"}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"The following example saves a world as JSON and restores it:"}],"type":"paragraph"},{"code":["import Foundation","","var world = World()","let ship = world.spawn(Position(x: 1, y: 2), Health(current: 3))","let data = try JSONEncoder().encode(world.snapshot(Position.self, Health.self))","","let decoded = try JSONDecoder().decode(WorldSnapshot<Position, Health>.self, from: data)","let restored = World(restoring: decoded)","print(restored[Position.self, of: ship])","\/\/ Prints \"Position(x: 1.0, y: 2.0)\""],"syntax":"swift","type":"codeListing"},{"inlineContent":[{"type":"text","text":"Every entity handle, live or stale, means the same in the restored world as in the original,"},{"type":"text","text":" "},{"type":"text","text":"so handles you saved elsewhere stay valid. The restored world also hands out the same handles"},{"type":"text","text":" "},{"type":"text","text":"from later spawns."}],"type":"paragraph"},{"inlineContent":[{"text":"A snapshot holds no resources, hooks or change ticks, and the restored world’s components","type":"text"},{"type":"text","text":" "},{"type":"text","text":"are all added at its first tick. To save resources too, or to save a world without listing"},{"text":" ","type":"text"},{"type":"text","text":"its types at each call, use a "},{"type":"reference","isActive":true,"identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/Scene"},{"text":".","type":"text"}],"type":"paragraph"},{"style":"note","name":"Note","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Decoding throws "},{"type":"codeVoice","code":"DecodingError.dataCorrupted"},{"type":"text","text":" for data that no world could have"},{"type":"text","text":" "},{"type":"text","text":"produced, such as a component of an entity that isn’t live."}]}],"type":"aside"}],"kind":"content"}],"relationshipsSections":[{"type":"conformsTo","title":"Conforms To","kind":"relationships","identifiers":["doc:\/\/WorldModule\/s8CopyableP","doc:\/\/WorldModule\/Se","doc:\/\/WorldModule\/SE","doc:\/\/WorldModule\/SQ","doc:\/\/WorldModule\/s9EscapableP","doc:\/\/WorldModule\/s8SendableP","doc:\/\/WorldModule\/s16Sen