{"primaryContentSections":[{"declarations":[{"platforms":["Linux"],"tokens":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"WorldSnapshot"},{"kind":"text","text":"<each "},{"kind":"genericParameter","text":"C"},{"kind":"text","text":"> "},{"kind":"keyword","text":"where"},{"kind":"text","text":" repeat each "},{"kind":"typeIdentifier","text":"C"},{"kind":"text","text":" : "},{"preciseIdentifier":"s:Se","kind":"typeIdentifier","text":"Decodable"},{"kind":"text","text":", repeat each "},{"kind":"typeIdentifier","text":"C"},{"kind":"text","text":" : "},{"preciseIdentifier":"s:SE","kind":"typeIdentifier","text":"Encodable"},{"kind":"text","text":", repeat each "},{"kind":"typeIdentifier","text":"C"},{"kind":"text","text":" : "},{"identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/Component","preciseIdentifier":"s:11WorldModule9ComponentP","kind":"typeIdentifier","text":"Component"}],"languages":["swift"]}],"kind":"declarations"},{"mentions":["doc:\/\/WorldModule\/documentation\/WorldModule\/SavingAndLoadingWorlds"],"kind":"mentions"},{"content":[{"type":"heading","level":2,"anchor":"overview","text":"Overview"},{"type":"paragraph","inlineContent":[{"text":"Use a snapshot to save a world and restore it later, or to compare two worlds. A snapshot","type":"text"},{"text":" ","type":"text"},{"text":"is ","type":"text"},{"code":"Codable","type":"codeVoice"},{"text":", so you can encode it with any encoder, such as ","type":"text"},{"code":"JSONEncoder","type":"codeVoice"},{"text":". Take one with","type":"text"},{"text":" ","type":"text"},{"isActive":true,"identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/World\/snapshot(_:)","type":"reference"},{"text":", listing the component types to save, and rebuild a world from it","type":"text"},{"text":" ","type":"text"},{"text":"with ","type":"text"},{"code":"World(restoring:)","type":"codeVoice"},{"text":". Each component type you save must conform to ","type":"text"},{"code":"Codable","type":"codeVoice"},{"text":".","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"The following example saves a world as JSON and restores it:","type":"text"}]},{"type":"codeListing","syntax":"swift","code":["import Foundation","","var world = World()","let ship = world.spawn(Position(x: 1, y: 2), Health(current: 3))","let data = try JSONEncoder().encode(world.snapshot(Position.self, Health.self))","","let decoded = try JSONDecoder().decode(WorldSnapshot<Position, Health>.self, from: data)","let restored = World(restoring: decoded)","print(restored[Position.self, of: ship])","\/\/ Prints \"Position(x: 1.0, y: 2.0)\""]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Every entity handle, live or stale, means the same in the restored world as in the original,"},{"type":"text","text":" "},{"type":"text","text":"so handles you saved elsewhere stay valid. The restored world also hands out the same handles"},{"type":"text","text":" "},{"type":"text","text":"from later spawns."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"A snapshot holds no resources, hooks or change ticks, and the restored world’s components"},{"type":"text","text":" "},{"type":"text","text":"are all added at its first tick. To save resources too, or to save a world without listing"},{"type":"text","text":" "},{"type":"text","text":"its types at each call, use a "},{"identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/Scene","isActive":true,"type":"reference"},{"type":"text","text":"."}]},{"type":"aside","style":"note","content":[{"inlineContent":[{"type":"text","text":"Decoding throws "},{"type":"codeVoice","code":"DecodingError.dataCorrupted"},{"type":"text","text":" for data that no world could have"},{"type":"text","text":" "},{"type":"text","text":"produced, such as a component of an entity that isn’t live."}],"type":"paragraph"}],"name":"Note"}],"kind":"content"}],"abstract":[{"text":"A saved copy of a world’s entities, hierarchy and the components of the listed types.","type":"text"}],"topicSections":[{"generated":true,"anchor":"Initializers","identifiers":["doc:\/\/WorldModule\/documentation\/WorldModule\/WorldSnapshot\/init(from:)"],"title":"Initializers"},{"generated":true,"anchor":"Instance-Properties","identifiers":["doc:\/\/WorldModule\/documentation\/WorldModule\/WorldSnapshot\/count"],"title":"Instance Properties"},{"generated":true,"anchor":"Instance-Methods","identifiers":["doc:\/\/WorldModule\/documentation\/WorldModule\/WorldSnapshot\/encode(to:)"],"title":"Instance Methods"},{"generated":true,"anchor":"Default-Implementations","identifiers":["doc:\/\/WorldModule\/documentation\/WorldModule\/WorldSnapshot\/Equatable-Implementations"],"title":"Default Implementations"}],"schemaVersion":{"patch":0,"major":0,"minor":3},"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/worldmodule\/worldsnapshot"]}],"kind":"symbol","hierarchy":{"paths":[["doc:\/\/WorldModule\/documentation\/WorldModule"]]},"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/WorldModule\/documentation\/WorldModule\/WorldSnapshot"},"relationshipsSections":[{"type":"conformsTo","identifiers":["doc:\/\/WorldModule\/s8CopyableP","doc:\/\/WorldModule\/Se","doc:\/\/WorldModule\/SE","doc:\/\/WorldModule\/SQ","doc:\/\/WorldModule\/s9EscapableP","doc:\/\/WorldModule\/s8SendableP","doc:\/\/WorldModule\/s16SendableMetatypeP"],"kind":"relationships","title":"Conforms To"}],"metadata":{"role":"symbol","externalID":"s:11WorldModule0A8SnapshotV","symbolKind":"struct","roleHeading":"Structure","remoteSource":{"fileName":"Snapshot.swift","url":"https:\/\/github.com\/Tyler-Keith-Thompson\/ECS\/blob\/main\/Sources\/WorldModule\/Snapshot.swift#L33"},"title":"WorldSnapshot","navigatorTitle":[{"kind":"identifier","text":"WorldSnapshot"}],"fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"kind":"identifier","text":"WorldSnapshot"}],"modules":[{"name":"WorldModule"}]},"secti