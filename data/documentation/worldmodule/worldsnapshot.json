{"schemaVersion":{"minor":3,"patch":0,"major":0},"relationshipsSections":[{"kind":"relationships","title":"Conforms To","identifiers":["doc:\/\/WorldModule\/Se","doc:\/\/WorldModule\/SE","doc:\/\/WorldModule\/SQ","doc:\/\/WorldModule\/s8SendableP","doc:\/\/WorldModule\/s16SendableMetatypeP"],"type":"conformsTo"}],"hierarchy":{"paths":[["doc:\/\/WorldModule\/documentation\/WorldModule"]]},"seeAlsoSections":[{"title":"Saving and Loading Worlds","identifiers":["doc:\/\/WorldModule\/documentation\/WorldModule\/SavingAndLoadingWorlds","doc:\/\/WorldModule\/documentation\/WorldModule\/Scene","doc:\/\/WorldModule\/documentation\/WorldModule\/TypeRegistry","doc:\/\/WorldModule\/documentation\/WorldModule\/TypeRegistryError","doc:\/\/WorldModule\/documentation\/WorldModule\/TypeRegistryLookupError","doc:\/\/WorldModule\/documentation\/WorldModule\/MapEntities"],"generated":true,"anchor":"Saving-and-Loading-Worlds"}],"kind":"symbol","variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/worldmodule\/worldsnapshot"]}],"metadata":{"symbolKind":"struct","navigatorTitle":[{"text":"WorldSnapshot","kind":"identifier"}],"role":"symbol","roleHeading":"Structure","title":"WorldSnapshot","remoteSource":{"url":"https:\/\/github.com\/Tyler-Keith-Thompson\/ECS\/blob\/main\/Sources\/WorldModule\/Snapshot.swift#L33","fileName":"Snapshot.swift"},"externalID":"s:11WorldModule0A8SnapshotV","modules":[{"name":"WorldModule"}],"fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"WorldSnapshot"}]},"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/WorldModule\/documentation\/WorldModule\/WorldSnapshot"},"abstract":[{"text":"A saved copy of a world’s entities, hierarchy and the components of the listed types.","type":"text"}],"topicSections":[{"title":"Initializers","identifiers":["doc:\/\/WorldModule\/documentation\/WorldModule\/WorldSnapshot\/init(from:)"],"generated":true,"anchor":"Initializers"},{"title":"Instance Properties","identifiers":["doc:\/\/WorldModule\/documentation\/WorldModule\/WorldSnapshot\/count"],"generated":true,"anchor":"Instance-Properties"},{"title":"Instance Methods","identifiers":["doc:\/\/WorldModule\/documentation\/WorldModule\/WorldSnapshot\/encode(to:)"],"generated":true,"anchor":"Instance-Methods"},{"title":"Default Implementations","identifiers":["doc:\/\/WorldModule\/documentation\/WorldModule\/WorldSnapshot\/Equatable-Implementations"],"generated":true,"anchor":"Default-Implementations"}],"primaryContentSections":[{"kind":"declarations","declarations":[{"tokens":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"WorldSnapshot"},{"kind":"text","text":"<each "},{"kind":"genericParameter","text":"C"},{"kind":"text","text":"> "},{"kind":"keyword","text":"where"},{"kind":"text","text":" repeat each "},{"kind":"typeIdentifier","text":"C"},{"kind":"text","text":" : "},{"kind":"typeIdentifier","preciseIdentifier":"s:Se","text":"Decodable"},{"kind":"text","text":", repeat each "},{"kind":"typeIdentifier","text":"C"},{"kind":"text","text":" : "},{"kind":"typeIdentifier","preciseIdentifier":"s:SE","text":"Encodable"},{"kind":"text","text":", repeat each "},{"kind":"typeIdentifier","text":"C"},{"kind":"text","text":" : "},{"kind":"typeIdentifier","identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/Component","preciseIdentifier":"s:11WorldModule9ComponentP","text":"Component"}],"platforms":["Linux"],"languages":["swift"]}]},{"mentions":["doc:\/\/WorldModule\/documentation\/WorldModule\/SavingAndLoadingWorlds"],"kind":"mentions"},{"content":[{"text":"Overview","level":2,"anchor":"overview","type":"heading"},{"inlineContent":[{"text":"Use a snapshot to save a world and restore it later, or to compare two worlds. A snapshot","type":"text"},{"text":" ","type":"text"},{"text":"is ","type":"text"},{"code":"Codable","type":"codeVoice"},{"text":", so you can encode it with any encoder, such as ","type":"text"},{"code":"JSONEncoder","type":"codeVoice"},{"text":". Take one with","type":"text"},{"text":" ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/World\/snapshot(_:)"},{"text":", listing the component types to save, and rebuild a world from it","type":"text"},{"text":" ","type":"text"},{"text":"with ","type":"text"},{"code":"World(restoring:)","type":"codeVoice"},{"text":". Each component type you save must conform to ","type":"text"},{"code":"Codable","type":"codeVoice"},{"text":".","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"The following example saves a world as JSON and restores it:","type":"text"}],"type":"paragraph"},{"syntax":"swift","code":["import Foundation","","var world = World()","let ship = world.spawn(Position(x: 1, y: 2), Health(current: 3))","let data = try JSONEncoder().encode(world.snapshot(Position.self, Health.self))","","let decoded = try JSONDecoder().decode(WorldSnapshot<Position, Health>.self, from: data)","let restored = World(restoring: decoded)","print(restored[Position.self, of: ship])","\/\/ Prints \"Position(x: 1.0, y: 2.0)\""],"type":"codeListing"},{"inlineContent":[{"type":"text","text":"Every entity handle, live or stale, means the same in the restored world as in the original,"},{"type":"text","text":" "},{"type":"text","text":"so handles you saved elsewhere stay valid. The restored world also hands out the same handles"},{"type":"text","text":" "},{"type":"text","text":"from later spawns."}],"type":"paragraph"},{"inlineContent":[{"text":"A snapshot holds no resources, hooks or change ticks, and the restored world’s components","type":"text"},{"text":" ","type":"text"},{"text":"are all added at its first tick. To save resources too, or to save a world without listing","type":"text"},{"text":" ","type":"text"},{"text":"its types at each call, use a ","type":"text"},{"isActive":true,"identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/Scene","type":"reference"},{"text":".","type":"text"}],"type":"paragraph"},{"content":[{"inlineContent":[{"type":"text","text":"Decoding throws "},{"type":"codeVoice","code":"DecodingError.dataCorrupted"},{"type":"text","text":" for data that no world could have"},{"type":"text","text":" "},{"type":"text","text":"produced, such as a component of an entity that isn’t live."}],"type":"paragraph"}],"style":"note","name":"Note","type":"aside"}],"kind":"content"}],"sections":[],"references":{"doc://WorldModule/SQ":{"title":"Swift.Equatable","type":"unresolvable","identifier":"doc:\/\/WorldModule\/SQ"},"doc://WorldModule/documentation/WorldModule/WorldSnapshot/count":{"title":"count","url":"\/documentation\/worldmodule\/worldsnapshot\/count","fragments":[{"text":"var","kind":"keyword"},{"text":" ","kind":"text"},{"text":"count","kind":"identifier"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:Si","text":"Int","kind":"typeIdentifier"}],"abstract":[{"text":"The number of live entities.","type":"text"}],"type":"topic","role":"symbol","kind":"symbol","identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/WorldSnapshot\/count"},"doc://WorldModule/s16SendableMetatypeP":{"type":"unresolvable","identifier":"doc:\/\/WorldModule\/s16SendableMetatypeP","title":"Swift.SendableMetatype"},"doc://WorldModule/documentation/WorldModule/MapEntities":{"title":"MapEntities","url":"\/documentation\/worldmodule\/mapentities","fragments":[{"text":"protocol","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MapEntities","kind":"identifier"}],"abstract":[{"type":"text","text":"A type whose values name other entities, which can be pointed at different entities."}],"type":"topic","role":"symbol","navigatorTitle":[{"text":"MapEntities","kind":"identifier"}],"kind":"symbol","identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/MapEntities"},"doc://WorldModule/documentation/WorldModule/WorldSnapshot/Equatable-Implementations":{"url":"\/documentation\/worldmodule\/worldsnapshot\/equata