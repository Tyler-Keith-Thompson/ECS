{"identifier":{"url":"doc:\/\/WorldModule\/documentation\/WorldModule\/WorldSnapshot","interfaceLanguage":"swift"},"sections":[],"topicSections":[{"generated":true,"title":"Initializers","identifiers":["doc:\/\/WorldModule\/documentation\/WorldModule\/WorldSnapshot\/init(from:)"],"anchor":"Initializers"},{"generated":true,"title":"Instance Properties","identifiers":["doc:\/\/WorldModule\/documentation\/WorldModule\/WorldSnapshot\/count"],"anchor":"Instance-Properties"},{"generated":true,"title":"Instance Methods","identifiers":["doc:\/\/WorldModule\/documentation\/WorldModule\/WorldSnapshot\/encode(to:)"],"anchor":"Instance-Methods"},{"generated":true,"title":"Default Implementations","identifiers":["doc:\/\/WorldModule\/documentation\/WorldModule\/WorldSnapshot\/Equatable-Implementations"],"anchor":"Default-Implementations"}],"seeAlsoSections":[{"generated":true,"title":"Saving and Loading Worlds","identifiers":["doc:\/\/WorldModule\/documentation\/WorldModule\/SavingAndLoadingWorlds","doc:\/\/WorldModule\/documentation\/WorldModule\/Scene","doc:\/\/WorldModule\/documentation\/WorldModule\/TypeRegistry","doc:\/\/WorldModule\/documentation\/WorldModule\/TypeRegistryError","doc:\/\/WorldModule\/documentation\/WorldModule\/TypeRegistryLookupError","doc:\/\/WorldModule\/documentation\/WorldModule\/MapEntities"],"anchor":"Saving-and-Loading-Worlds"}],"variants":[{"paths":["\/documentation\/worldmodule\/worldsnapshot"],"traits":[{"interfaceLanguage":"swift"}]}],"hierarchy":{"paths":[["doc:\/\/WorldModule\/documentation\/WorldModule"]]},"kind":"symbol","metadata":{"roleHeading":"Structure","modules":[{"name":"WorldModule"}],"title":"WorldSnapshot","remoteSource":{"url":"https:\/\/github.com\/Tyler-Keith-Thompson\/ECS\/blob\/main\/Sources\/WorldModule\/Snapshot.swift#L33","fileName":"Snapshot.swift"},"externalID":"s:11WorldModule0A8SnapshotV","symbolKind":"struct","role":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"WorldSnapshot","kind":"identifier"}],"navigatorTitle":[{"kind":"identifier","text":"WorldSnapshot"}]},"abstract":[{"text":"A saved copy of a world’s entities, hierarchy and the components of the listed types.","type":"text"}],"primaryContentSections":[{"kind":"declarations","declarations":[{"platforms":["Linux"],"tokens":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"WorldSnapshot"},{"kind":"text","text":"<each "},{"kind":"genericParameter","text":"C"},{"kind":"text","text":"> "},{"kind":"keyword","text":"where"},{"kind":"text","text":" repeat each "},{"kind":"typeIdentifier","text":"C"},{"kind":"text","text":" : "},{"kind":"typeIdentifier","preciseIdentifier":"s:Se","text":"Decodable"},{"kind":"text","text":", repeat each "},{"kind":"typeIdentifier","text":"C"},{"kind":"text","text":" : "},{"kind":"typeIdentifier","preciseIdentifier":"s:SE","text":"Encodable"},{"kind":"text","text":", repeat each "},{"kind":"typeIdentifier","text":"C"},{"kind":"text","text":" : "},{"kind":"typeIdentifier","identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/Component","preciseIdentifier":"s:11WorldModule9ComponentP","text":"Component"}],"languages":["swift"]}]},{"kind":"mentions","mentions":["doc:\/\/WorldModule\/documentation\/WorldModule\/SavingAndLoadingWorlds"]},{"kind":"content","content":[{"level":2,"text":"Overview","type":"heading","anchor":"overview"},{"inlineContent":[{"text":"Use a snapshot to save a world and restore it later, or to compare two worlds. A snapshot","type":"text"},{"text":" ","type":"text"},{"text":"is ","type":"text"},{"type":"codeVoice","code":"Codable"},{"text":", so you can encode it with any encoder, such as ","type":"text"},{"type":"codeVoice","code":"JSONEncoder"},{"text":". Take one with","type":"text"},{"text":" ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/World\/snapshot(_:)"},{"text":", listing the component types to save, and rebuild a world from it","type":"text"},{"text":" ","type":"text"},{"text":"with ","type":"text"},{"type":"codeVoice","code":"World(restoring:)"},{"text":". Each component type you save must conform to ","type":"text"},{"type":"codeVoice","code":"Codable"},{"text":".","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"The following example saves a world as JSON and restores it:","type":"text"}],"type":"paragraph"},{"code":["import Foundation","","var world = World()","let ship = world.spawn(Position(x: 1, y: 2), Health(current: 3))","let data = try JSONEncoder().encode(world.snapshot(Position.self, Health.self))","","let decoded = try JSONDecoder().decode(WorldSnapshot<Position, Health>.self, from: data)","let restored = World(restoring: decoded)","print(restored[Position.self, of: ship])","\/\/ Prints \"Position(x: 1.0, y: 2.0)\""],"type":"codeListing","syntax":"swift"},{"inlineContent":[{"type":"text","text":"Every entity handle, live or stale, means the same in the restored world as in the original,"},{"type":"text","text":" "},{"type":"text","text":"so handles you saved elsewhere stay valid. The restored world also hands out the same handles"},{"type":"text","text":" "},{"type":"text","text":"from later spawns."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"A snapshot holds no resources, hooks or change ticks, and the restored world’s components"},{"type":"text","text":" "},{"type":"text","text":"are all added at its first tick. To save resources too, or to save a world without listing"},{"type":"text","text":" "},{"type":"text","text":"its types at each call, use a "},{"isActive":true,"identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/Scene","type":"reference"},{"type":"text","text":"."}],"type":"paragraph"},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Decoding throws "},{"code":"DecodingError.dataCorrupted","type":"codeVoice"},{"type":"text","text":" for data that no world could have"},{"type":"text","text":" "},{"type":"text","text":"produced, such as a component of an entity that isn’t live."}]}],"type":"aside","name":"Note","style":"note"}]}],"schemaVersion":{"major":0,"minor":3,"patch":0},"relationshipsSections":[{"type":"conformsTo","kind":"relationships","title":"Conforms To","identifiers":["doc:\/\/WorldModule\/s8CopyableP","doc:\/\/WorldModule\/Se","doc:\/\/WorldModule\/SE","doc:\/\/WorldModule\/SQ","doc:\/\/WorldModule\/s9EscapableP","doc:\/\/WorldModule\/s8SendableP","doc:\/\/WorldModule\/s16SendableMetatypeP"]}],"references":{"doc://WorldModule/documentation/WorldModule":{"type":"topic","kind":"symbol","role":"collection","title":"WorldModule","abstract":[{"type":"text","text":"Store the state of a game or simulation as entities and components, and read and change it with"},{"type":"text","text":" "},{"type":"text","text":"queries, updates, and commands."}],"url":"\/documentation\/worldmodule","identifier":"doc:\/\/WorldModule\/documentation\/WorldModule"},"doc://WorldModule/SQ":{"identifier":"doc:\/\/WorldModule\/SQ","title":"Swift.Equatable","type":"unresolvable"},"doc://WorldModule/Se":{"title":"Swift.Decodable","identifier":"doc:\/\/WorldModule\/Se","type":"unresolvable"},"doc://WorldModule/documentation/WorldModule/WorldSnapshot/encode(to:)":{"title":"encode(to:)","identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/WorldSnapshot\/encode(to:)","abstract":[{"type":"text","text":"Encodes the snapshot into the given encoder."}],"url":"\/documentation\/worldmodule\/worldsnapshot\/encode(to:)","role":"symbol","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"encode","kind":"identifier"},{"text":"(","kind":"text"},{"text":"to","kind":"externalParam"},{"text":": any ","kind":"text"},{"kind":"typeIdentifier","text":"Encoder","preciseIdentifier":"s:s7EncoderP"},{"kind":"text","text":") "},{"kind":"keyword","text":"throws"}],"kind":"symbol","type":"topic"},"doc://WorldModule/documentation/WorldModule/Component