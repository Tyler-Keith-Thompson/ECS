ind":"keyword"},{"text":" ","kind":"text"},{"text":"WorldSnapshot","kind":"identifier"}],"remoteSource":{"fileName":"Snapshot.swift","url":"https:\/\/github.com\/Tyler-Keith-Thompson\/ECS\/blob\/main\/Sources\/WorldModule\/Snapshot.swift#L33"},"externalID":"s:11WorldModule0A8SnapshotV","roleHeading":"Structure","title":"WorldSnapshot","modules":[{"name":"WorldModule"}],"role":"symbol","navigatorTitle":[{"text":"WorldSnapshot","kind":"identifier"}],"symbolKind":"struct"},"variants":[{"paths":["\/documentation\/worldmodule\/worldsnapshot"],"traits":[{"interfaceLanguage":"swift"}]}],"sections":[],"primaryContentSections":[{"kind":"declarations","declarations":[{"tokens":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"WorldSnapshot"},{"kind":"text","text":"<each "},{"kind":"genericParameter","text":"C"},{"kind":"text","text":"> "},{"kind":"keyword","text":"where"},{"kind":"text","text":" repeat each "},{"kind":"typeIdentifier","text":"C"},{"kind":"text","text":" : "},{"preciseIdentifier":"s:Se","kind":"typeIdentifier","text":"Decodable"},{"kind":"text","text":", repeat each "},{"kind":"typeIdentifier","text":"C"},{"kind":"text","text":" : "},{"preciseIdentifier":"s:SE","kind":"typeIdentifier","text":"Encodable"},{"kind":"text","text":", repeat each "},{"kind":"typeIdentifier","text":"C"},{"kind":"text","text":" : "},{"preciseIdentifier":"s:11WorldModule9ComponentP","identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/Component","kind":"typeIdentifier","text":"Component"}],"languages":["swift"],"platforms":["Linux"]}]},{"kind":"mentions","mentions":["doc:\/\/WorldModule\/documentation\/WorldModule\/SavingAndLoadingWorlds"]},{"content":[{"type":"heading","anchor":"overview","text":"Overview","level":2},{"type":"paragraph","inlineContent":[{"type":"text","text":"Use a snapshot to save a world and restore it later, or to compare two worlds. A snapshot"},{"type":"text","text":" "},{"type":"text","text":"is "},{"type":"codeVoice","code":"Codable"},{"type":"text","text":", so you can encode it with any encoder, such as "},{"type":"codeVoice","code":"JSONEncoder"},{"type":"text","text":". Take one with"},{"type":"text","text":" "},{"isActive":true,"identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/World\/snapshot(_:)","type":"reference"},{"type":"text","text":", listing the component types to save, and rebuild a world from it"},{"type":"text","text":" "},{"type":"text","text":"with "},{"type":"codeVoice","code":"World(restoring:)"},{"type":"text","text":". Each component type you save must conform to "},{"type":"codeVoice","code":"Codable"},{"type":"text","text":"."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"The following example saves a world as JSON and restores it:"}]},{"type":"codeListing","code":["import Foundation","","var world = World()","let ship = world.spawn(Position(x: 1, y: 2), Health(current: 3))","let data = try JSONEncoder().encode(world.snapshot(Position.self, Health.self))","","let decoded = try JSONDecoder().decode(WorldSnapshot<Position, Health>.self, from: data)","let restored = World(restoring: decoded)","print(restored[Position.self, of: ship])","\/\/ Prints \"Position(x: 1.0, y: 2.0)\""],"syntax":"swift"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Every entity handle, live or stale, means the same in the restored world as in the original,"},{"type":"text","text":" "},{"type":"text","text":"so handles you saved elsewhere stay valid. The restored world also hands out the same handles"},{"type":"text","text":" "},{"type":"text","text":"from later spawns."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"A snapshot holds no resources, hooks or change ticks, and the restored world’s components"},{"type":"text","text":" "},{"type":"text","text":"are all added at its first tick. To save resources too, or to save a world without listing"},{"type":"text","text":" "},{"type":"text","text":"its types at each call, use a "},{"type":"reference","isActive":true,"identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/Scene"},{"type":"text","text":"."}]},{"type":"aside","name":"Note","style":"note","content":[{"inlineContent":[{"type":"text","text":"Decoding throws "},{"type":"codeVoice","code":"DecodingError.dataCorrupted"},{"type":"text","text":" for data that no world could have"},{"type":"text","text":" "},{"type":"text","text":"produced, such as a component of an entity that isn’t live."}],"type":"paragraph"}]}],"kind":"content"}],"references":{"doc://WorldModule/documentation/WorldModule/TypeRegistryError":{"fragments":[{"text":"enum","kind":"keyword"},{"text":" ","kind":"text"},{"text":"TypeRegistryError","kind":"identifier"}],"abstract":[{"type":"text","text":"An error that indicates why a type couldn’t be registered in a "},{"identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/TypeRegistry","type":"reference","isActive":true},{"type":"text","text":"."}],"identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/TypeRegistryError","title":"TypeRegistryError","role":"symbol","url":"\/documentation\/worldmodule\/typeregistryerror","navigatorTitle":[{"text":"TypeRegistryError","kind":"identifier"}],"type":"topic","kind":"symbol"},"doc://WorldModule/documentation/WorldModule/WorldSnapshot/count":{"abstract":[{"type":"text","text":"The number of live entities."}],"role":"symbol","fragments":[{"kind":"keyword","text":"var"},{"kind":"text","text":" "},{"kind":"identifier","text":"count"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"Int","preciseIdentifier":"s:Si"}],"identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/WorldSnapshot\/count","type":"topic","kind":"symbol","title":"count","url":"\/documentation\/worldmodule\/worldsnapshot\/count"},"doc://WorldModule/documentation/WorldModule/World/snapshot(_:)":{"abstract":[{"type":"text","text":"Returns a snapshot of the world’s entities, hierarchy and the components of the given"},