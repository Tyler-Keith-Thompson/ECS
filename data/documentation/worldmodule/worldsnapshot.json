t":", so you can encode it with any encoder, such as ","type":"text"},{"type":"codeVoice","code":"JSONEncoder"},{"text":". Take one with","type":"text"},{"text":" ","type":"text"},{"type":"reference","isActive":true,"identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/World\/snapshot(_:)"},{"text":", listing the component types to save, and rebuild a world from it","type":"text"},{"text":" ","type":"text"},{"text":"with ","type":"text"},{"type":"codeVoice","code":"World(restoring:)"},{"text":". Each component type you save must conform to ","type":"text"},{"type":"codeVoice","code":"Codable"},{"text":".","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"The following example saves a world as JSON and restores it:","type":"text"}]},{"type":"codeListing","code":["import Foundation","","var world = World()","let ship = world.spawn(Position(x: 1, y: 2), Health(current: 3))","let data = try JSONEncoder().encode(world.snapshot(Position.self, Health.self))","","let decoded = try JSONDecoder().decode(WorldSnapshot<Position, Health>.self, from: data)","let restored = World(restoring: decoded)","print(restored[Position.self, of: ship])","\/\/ Prints \"Position(x: 1.0, y: 2.0)\""],"syntax":"swift"},{"type":"paragraph","inlineContent":[{"text":"Every entity handle, live or stale, means the same in the restored world as in the original,","type":"text"},{"text":" ","type":"text"},{"text":"so handles you saved elsewhere stay valid. The restored world also hands out the same handles","type":"text"},{"text":" ","type":"text"},{"text":"from later spawns.","type":"text"}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"A snapshot holds no resources, hooks or change ticks, and the restored world’s components"},{"type":"text","text":" "},{"type":"text","text":"are all added at its first tick. To save resources too, or to save a world without listing"},{"type":"text","text":" "},{"type":"text","text":"its types at each call, use a "},{"type":"reference","isActive":true,"identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/Scene"},{"type":"text","text":"."}]},{"type":"aside","style":"note","name":"Note","content":[{"inlineContent":[{"text":"Decoding throws ","type":"text"},{"type":"codeVoice","code":"DecodingError.dataCorrupted"},{"text":" for data that no world could have","type":"text"},{"text":" ","type":"text"},{"text":"produced, such as a component of an entity that isn’t live.","type":"text"}],"type":"paragraph"}]}]}],"schemaVersion":{"patch":0,"minor":3,"major":0},"references":{"doc://WorldModule/documentation/WorldModule/World/snapshot(_:)":{"role":"symbol","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"snapshot","kind":"identifier"},{"text":"<each ","kind":"text"},{"text":"C","kind":"genericParameter"},{"text":">(repeat (each ","kind":"text"},{"text":"C","kind":"typeIdentifier"},{"text":").Type) -> ","kind":"text"},{"text":"WorldSnapshot","kind":"typeIdentifier","preciseIdentifier":"s:11WorldModule0A8SnapshotV"},{"text":"<repeat each ","kind":"text"},{"text":"C","kind":"typeIdentifier"},{"kind":"text","text":">"}],"kind":"symbol","type":"topic","title":"snapshot(_:)","identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/World\/snapshot(_:)","url":"\/documentation\/worldmodule\/world\/snapshot(_:)","abstract":[{"type":"text","text":"Returns a snapshot of the world’s entities, hierarchy and the components of the given"},{"type":"text","text":" "},{"type":"text","text":"types."}]},"doc://WorldModule/documentation/WorldModule/MapEntities":{"title":"MapEntities","role":"symbol","kind":"symbol","identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/MapEntities","navigatorTitle":[{"kind":"identifier","text":"MapEntities"}],"url":"\/documentation\/worldmodule\/mapentities","abstract":[{"text":"A type whose values name other entities, which can be pointed at different entities.","type":"text"}],"fragments":[{"kind":"keyword","text":"protocol"},{"kind":"t