,"kind":"genericParameter"},{"text":">(repeat each ","kind":"text"},{"kind":"typeIdentifier","text":"B"},{"kind":"text","text":", "},{"kind":"externalParam","text":"childOf"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:11WorldModule6EntityV","text":"Entity"},{"kind":"text","text":") -> "},{"kind":"typeIdentifier","preciseIdentifier":"s:11WorldModule6EntityV","text":"Entity"}],"kind":"symbol","url":"\/documentation\/worldmodule\/world\/spawn(_:childof:)","type":"topic","role":"symbol","title":"spawn(_:childOf:)","identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/World\/spawn(_:childOf:)","abstract":[{"text":"Spawns an entity holding the given components as the last child of a parent.","type":"text"}]},"doc://WorldModule/documentation/WorldModule/Commands":{"role":"symbol","type":"topic","identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/Commands","url":"\/documentation\/worldmodule\/commands","abstract":[{"text":"A buffer of changes to a world, recorded now and applied later in the order they were","type":"text"},{"text":" ","type":"text"},{"text":"recorded.","type":"text"}],"kind":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"Commands"}],"navigatorTitle":[{"kind":"identifier","text":"Commands"}],"title":"Commands"},"doc://WorldModule/documentation/WorldModule/World/targets(_:of:)":{"fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"targets","kind":"identifier"},{"text":"<","kind":"text"},{"text":"R","kind":"genericParameter"},{"text":">(","kind":"text"},{"kind":"typeIdentifier","text":"R"},{"kind":"text","text":".Type, "},{"kind":"externalParam","text":"of"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"Entity","preciseIdentifier":"s:11WorldModule6EntityV"},{"kind":"text","text":") -> ["},{"kind":"typeIdentifier","text":"Entity","preciseIdentifier":"s:11WorldModule6EntityV"},{"text":"]","kind":"text"