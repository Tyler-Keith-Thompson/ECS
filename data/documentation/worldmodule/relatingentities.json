{"metadata":{"role":"article","title":"Relating Entities","roleHeading":"Article","modules":[{"name":"WorldModule"}]},"variants":[{"paths":["\/documentation\/worldmodule\/relatingentities"],"traits":[{"interfaceLanguage":"swift"}]}],"identifier":{"url":"doc:\/\/WorldModule\/documentation\/WorldModule\/RelatingEntities","interfaceLanguage":"swift"},"hierarchy":{"paths":[["doc:\/\/WorldModule\/documentation\/WorldModule"]]},"schemaVersion":{"major":0,"patch":0,"minor":3},"kind":"article","abstract":[{"type":"text","text":"Link entities to one another, build trees of parents and children, and query entities by what"},{"type":"text","text":" "},{"type":"text","text":"they’re linked to."}],"seeAlsoSections":[{"identifiers":["doc:\/\/WorldModule\/documentation\/WorldModule\/ChildOf","doc:\/\/WorldModule\/documentation\/WorldModule\/AncestorsView","doc:\/\/WorldModule\/documentation\/WorldModule\/DescendantsView","doc:\/\/WorldModule\/documentation\/WorldModule\/CyclicHierarchy","doc:\/\/WorldModule\/documentation\/WorldModule\/HierarchyError"],"anchor":"Building-Hierarchies","title":"Building Hierarchies","generated":true}],"primaryContentSections":[{"content":[{"type":"heading","text":"Overview","level":2,"anchor":"Overview"},{"type":"paragraph","inlineContent":[{"text":"Some state belongs to a pair of entities rather than to one: a unit likes another, a turret aims","type":"text"},{"text":" ","type":"text"},{"text":"at a ship, a button sits on a panel. A ","type":"text"},{"inlineContent":[{"type":"text","text":"relation"}],"type":"emphasis"},{"text":" stores that kind of link, and the ","type":"text"},{"inlineContent":[{"type":"text","text":"hierarchy"}],"type":"emphasis"},{"text":" is","type":"text"},{"text":" ","type":"text"},{"text":"the relation that makes trees of parents and children.","type":"text"}]},{"type":"heading","text":"Link Entities with Relations","level":3,"anchor":"Link-Entities-with-Relations"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Declare a relation as a type that conforms to "},{"identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/Relation","isActive":true,"type":"reference"},{"type":"text","text":", then link a source entity to a target"},{"type":"text","text":" "},{"type":"text","text":"with "},{"identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/World\/relate(_:_:to:)","isActive":true,"type":"reference"},{"type":"text","text":" and unlink it with "},{"identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/World\/unrelate(_:_:from:)","isActive":true,"type":"reference"},{"type":"text","text":". Read the links in"},{"type":"text","text":" "},{"type":"text","text":"either direction: "},{"identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/World\/targets(_:of:)","isActive":true,"type":"reference"},{"type":"text","text":" lists what a source relates to, and"},{"type":"text","text":" "},{"identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/World\/sources(_:of:)","isActive":true,"type":"reference"},{"type":"text","text":" lists what relates to a target."}]},{"type":"paragraph","inlineContent":[{"text":"A relation can carry values, one per link, such as the amount one entity owes another. It","type":"text"},{"text":" ","type":"text"},{"text":"chooses two behaviors with static properties:","type":"text"}]},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"isActive":true,"type":"reference","identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/Relation\/isExclusive"},{"text":" limits a source to one target, so relating it to a new target","type":"text"},{"text":" ","type":"text"},{"text":"replaces the old one.","type":"text"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/Relation\/onTargetDespawn","type":"reference","isActive":true},{"text":" says what despawning a target does to its sources: remove their","type":"text"},{"text":" ","type":"text"},{"text":"links, the default, or despawn them too.","type":"text"}]}]}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"A source holds its links in a "},{"isActive":true,"type":"reference","identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/Targets"},{"type":"text","text":" component, which you read and filter on like any other"},{"type":"text","text":" "},{"type":"text","text":"component. To visit only the sources of one target, filter a query with "},{"type":"codeVoice","code":".related(_:to:)"},{"type":"text","text":", which"},{"type":"text","text":" "},{"type":"text","text":"uses the world’s index of each target’s sources rather than walking every source."}]},{"type":"heading","text":"Build a Hierarchy","level":3,"anchor":"Build-a-Hierarchy"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The hierarchy is the "},{"isActive":true,"type":"reference","identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/ChildOf"},{"type":"text","text":" relation: exclusive, so each entity has at most one parent, and"},{"type":"text","text":" "},{"type":"text","text":"despawning a parent despawns its children, and theirs in turn. Spawn an entity under a parent"},{"type":"text","text":" "},{"type":"text","text":"with "},{"isActive":true,"type":"reference","identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/World\/spawn(_:childOf:)"},{"type":"text","text":", or move an existing one with "},{"isActive":true,"type":"reference","identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/World\/addChild(_:to:)"},{"type":"text","text":", which"},{"type":"text","text":" "},{"type":"text","text":"throws "},{"isActive":true,"type":"reference","identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/CyclicHierarchy"},{"type":"text","text":" rather than make an entity its own ancestor. Walk the tree with"},{"type":"text","text":" "},{"isActive":true,"type":"reference","identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/World\/parent(of:)"},{"type":"text","text":", "},{"isActive":true,"type":"reference","identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/World\/children(of:)"},{"type":"text","text":", "},{"isActive":true,"type":"reference","identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/World\/ancestors(of:)"},{"type":"text","text":" and"},{"type":"text","text":" "},{"isActive":true,"type":"reference","identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/World\/descendants(of:)"},{"type":"text","text":"."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Because the hierarchy is a relation, the same query filters work on it:"},{"type":"text","text":" "},{"type":"codeVoice","code":".related(ChildOf.self, to: ship)"},{"type":"text","text":" visits the children of "},{"type":"codeVoice","code":"ship"},{"type":"text","text":", and"},{"type":"text","text":" "},{"type":"codeVoice","code":".without(Targets<ChildOf>.self)"},{"type":"text","text":" visits the roots."}]},{"type":"paragraph","inlineContent":[{"text":"The following example aims a ship’s turret at a comet, then at a moon, and despawns the ship","type":"text"},{"text":" ","type":"text"},{"text":"with its turret:","type":"text"}]},{"type":"codeListing","code":["struct AimsAt: Relation {","    static var isExclusive: Bool { true }","}","","var world = World()","let ship = world.spawn(Name(value: \"ship\"))","let turret = world.spawn(Name(value: \"turret\"), childOf: ship)","let comet = world.spawn(Name(value: \"comet\"))","let moon = world.spawn(Name(value: \"moon\"))","","world.relate(turret, AimsAt(), to: comet)","world.relate(turret, AimsAt(), to: moon)","print(world.targets(AimsAt.self, of: turret) == [moon])","\/\/ Prints \"true\"","","world.despawn(ship)","print(world.contains(turret), world.sources(AimsAt.self, of: moon).isEmpty)","\/\/ Prints \"false true\""],"syntax":"swift"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Observers of an "},{"type":"reference","identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/EntityEvent","isActive":true},{"type":"text","text":" that propagates also use the hierarchy: the event moves from the"},{"type":"text","text":" "},{"type":"text","text":"entity it was triggered on up to each of its ancestors. "},{"type":"reference","identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/Commands","isActive":true},{"type":"text","text":" record changes to relations"},{"type":"text","text":" "},{"type":"text","text":"and to the hierarchy, to apply after a query or update."}]}],"kind":"content"}],"sections":[],"references":{"doc://WorldModule/documentation/WorldModule/Relation":{"url":"\/documentation\/worldmodule\/relation","navigatorTitle":[{"kind":"identifier","text":"Relation"}],"title":"Relation","abstract":[{"type":"text","text":"A type that describes a kind of link from one entity to others."}],"role":"symbol","kind":"symbol","identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/Relation","fragments":[{"kind":"keyword","text":"protocol"},{"kind":"text","text":" "},{"kind":"identifier","text":"Relation"}],"type":"topic"},"doc://WorldModule/documentation/WorldModule/EntityEvent":{"title":"EntityEvent","url":"\/documentation\/worldmodule\/entityevent","abstract":[{"text":"A type that describes something that happens to a particular entity, which its observers","type":"text"},{"text":" ","type":"text"},{"text":"respond to at once.","type":"text"}],"identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/EntityEvent","type":"topic","kind":"symbol","role":"symbol","fragments":[{"kind":"keyword","text":"protocol"},{"kind":"text","text":" "},{"kind":"identifier","text":"EntityEvent"}],"navigatorTitle":[{"kind":"identifier","text":"EntityEvent"}]},"doc://WorldModule/documentation/WorldModule/Targets":{"type":"topic","kind":"symbol","navigatorTitle":[{"text":"Targets","kind":"identifier"}],"title":"Targets","identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/Targets","abstract":[{"text":"The component that holds a source entity’s targets of a relation, with the relation’s value","type":"text"},{"text":" ","type":"text"},{"text":"for each.","type":"text"}],"role":"symbol","url":"\/documentation\/worldmodule\/targets","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Targets","kind":"identifier"}]},"doc://WorldModule/documentation/WorldModule/Commands":{"title":"Commands","url":"\/documentation\/worldmodule\/commands","role":"symbol","kind":"symbol","abstract":[{"type":"text","text":"A buffer of changes to a world, recorded now and applied later in the order they were"},{"type":"text","text":" "},{"type":"text","text":"recorded."}],"navigatorTitle":[{"text":"Commands","kind":"identifier"}],"identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/Commands","type":"topic","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Commands","kind":"identifier"}]},"doc://WorldModule/documentation/WorldModule/World/targets(_:of:)":{"url":"\/documentation\/worldmodule\/world\/targets(_:of:)","type":"topic","abstract":[{"type":"text","text":"Returns the entities a source relates to by a relation, in the order they were related."}],"role":"symbol","title":"targets(_:of:)","identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/World\/targets(_:of:)","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"targets","kind":"identifier"},{"text":"<","kind":"text"},{"text":"R","kind":"genericParameter"},{"text":">(","kind":"text"},{"text":"R","kind":"typeIdentifier"},{"text":".Type, ","kind":"text"},{"text":"of","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"Entity","preciseIdentifier":"s:11WorldModule6EntityV","kind":"typeIdentifier"},{"text":") -> [","kind":"text"},{"text":"Entity","preciseIdentifier":"s:11WorldModule6EntityV","kind":"typeIdentifier"},{"text":"]","kind":"text"}],"kind":"symbol"},"doc://WorldModule/documentation/WorldModule/World/sources(_:of:)":{"abstract":[{"text":"Returns the entities that relate to a target by a relation, in the order they were","type":"text"},{"text":" ","type":"text"},{"text":"related.","type":"text"}],"type":"topic","kind":"symbol","role":"symbol","title":"sources(_:of:)","identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/World\/sources(_:of:)","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"sources","kind":"identifier"},{"text":"<","kind":"text"},{"text":"R","kind":"genericParameter"},{"text":">(","kind":"text"},{"text":"R","kind":"typeIdentifier"},{"text":".Type, ","kind":"text"},{"text":"of","kind":"externalParam"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:11WorldModule6EntityV","text":"Entity","kind":"typeIdentifier"},{"text":") -> [","kind":"text"},{"preciseIdentifier":"s:11WorldModule6EntityV","text":"Entity","kind":"typeIdentifier"},{"text":"]","kind":"text"}],"url":"\/documentation\/worldmodule\/world\/sources(_:of:)"},"doc://WorldModule/documentation/WorldModule":{"identifier":"doc:\/\/WorldModule\/documentation\/WorldModule","type":"topic","title":"WorldModule","kind":"symbol","role":"collection","abstract":[{"text":"Store the state of a game or simulation as entities and components, and read and change it with","type":"text"},{"text":" ","type":"text"},{"text":"queries, updates, and commands.","type":"text"}],"url":"\/documentation\/worldmodule"},"doc://WorldModule/documentation/WorldModule/HierarchyError":{"identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/HierarchyError","type":"topic","title":"HierarchyError","kind":"symbol","fragments":[{"text":"enum","kind":"keyword"},{"text":" ","kind":"text"},{"text":"HierarchyError","kind":"identifier"}],"role":"symbol","abstract":[{"type":"text","text":"An error that indicates why "},{"isActive":true,"type":"reference","identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/World\/addChild(_:checkedTo:)"},{"ty