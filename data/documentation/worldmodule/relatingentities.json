h"},{"type":"text","text":" "},{"type":"text","text":"queries, updates, and commands."}],"role":"collection","title":"WorldModule","kind":"symbol","identifier":"doc:\/\/WorldModule\/documentation\/WorldModule","url":"\/documentation\/worldmodule","type":"topic"}}}