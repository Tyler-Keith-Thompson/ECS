tityV"},{"kind":"text","text":") "},{"kind":"keyword","text":"throws"},{"text":"(","kind":"text"},{"text":"HierarchyError","kind":"typeIdentifier","preciseIdentifier":"s:11WorldModule14HierarchyErrorO"},{"text":")","kind":"text"}]},"doc://WorldModule/documentation/WorldModule/World/parent(of:)":{"kind":"symbol","url":"\/documentation\/worldmodule\/world\/parent(of:)","type":"topic","abstract":[{"type":"text","text":"Returns the parent of an entity."}],"title":"parent(of:)","role":"symbol","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"parent","kind":"identifier"},{"text":"(","kind":"text"},{"text":"of","kind":"externalParam"},{"text":": ","kind":"text"},{"kind":"typeIdentifier","text":"Entity","preciseIdentifier":"s:11WorldModule6EntityV"},{"kind":"text","text":") -> "},{"kind":"typeIdentifier","text":"Entity","preciseIdentifier":"s:11WorldModule6EntityV"},{"kind":"text","text":"?"}],"identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/World\/parent(of:)"},"doc://WorldModule/documentation/WorldModule/World/relate(_:_:to:)":{"url":"\/documentation\/worldmodule\/world\/relate(_:_:to:)","abstract":[{"text":"Links a source entity to a target entity by a relation.","type":"text"}],"identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/World\/relate(_:_:to:)","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"relate","kind":"identifier"},{"text":"<","kind":"text"},{"text":"R","kind":"genericParameter"},{"text":">(","kind":"text"},{"preciseIdentifier":"s:11WorldModule6EntityV","kind":"typeIdentifier","text":"Entity"},{"kind":"text","text":", "},{"kind":"typeIdentifier","text":"R"},{"kind":"text","text":", "},{"kind":"externalParam","text":"to"},{"kind":"text","text":": "},{"preciseIdentifier":"s:11WorldModule6EntityV","kind":"typeIdentifier","text":"Entity"},{"text":")","kind":"text"}],"title":"relate(_:_:to:)","kind":"symbol","type":"topic","role":"symbol"},"doc://WorldModule/documentation