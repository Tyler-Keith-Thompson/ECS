e6EntityV","kind":"typeIdentifier","text":"Entity"},{"kind":"text","text":"]"}],"title":"sources(_:of:)","kind":"symbol","identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/World\/sources(_:of:)"},"doc://WorldModule/documentation/WorldModule/EntityEvent":{"navigatorTitle":[{"text":"EntityEvent","kind":"identifier"}],"identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/EntityEvent","abstract":[{"text":"A type that describes something that happens to a particular entity, which its observers","type":"text"},{"text":" ","type":"text"},{"text":"respond to at once.","type":"text"}],"type":"topic","kind":"symbol","fragments":[{"text":"protocol","kind":"keyword"},{"text":" ","kind":"text"},{"text":"EntityEvent","kind":"identifier"}],"title":"EntityEvent","url":"\/documentation\/worldmodule\/entityevent","role":"symbol"},"doc://WorldModule/documentation/WorldModule/Relation/isExclusive":{"abstract":[{"text":"A Boolean value indicating whether a source relates to at most one target.","type":"text"}],"identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/Relation\/isExclusive","fragments":[{"kind":"keyword","text":"static"},{"kind":"text","text":" "},{"kind":"keyword","text":"var"},{"kind":"text","text":" "},{"kind":"identifier","text":"isExclusive"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:Sb","text":"Bool"}],"title":"isExclusive","kind":"symbol","required":true,"url":"\/documentation\/worldmodule\/relation\/isexclusive","type":"topic","defaultImplementations":1,"role":"symbol"},"doc://WorldModule/documentation/WorldModule/HierarchyError":{"navigatorTitle":[{"text":"HierarchyError","kind":"identifier"}],"abstract":[{"type":"text","text":"An error that indicates why "},{"isActive":true,"type":"reference","identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/World\/addChild(_:checkedTo:)"},{"type":"text","text":" could not link two entities."}],"identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/HierarchyError","type":"topic","kind":"symbol","fragments":[{"text":"enum","kind":"keyword"},{"text":" ","kind":"text"},{"text":"HierarchyError","kind":"identifier"}],"title":"HierarchyError","url":"\/documentation\/worldmodule\/hierarchyerror","role":"symbol"}}}