module\/targets","navigatorTitle":[{"text":"Targets","kind":"identifier"}],"type":"topic"},"doc://WorldModule/documentation/WorldModule/Relation/onTargetDespawn":{"defaultImplementations":1,"kind":"symbol","identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/Relation\/onTargetDespawn","type":"topic","role":"symbol","title":"onTargetDespawn","abstract":[{"text":"What despawning a target does to the sources related to it.","type":"text"}],"url":"\/documentation\/worldmodule\/relation\/ontargetdespawn","required":true,"fragments":[{"kind":"keyword","text":"static"},{"kind":"text","text":" "},{"kind":"keyword","text":"var"},{"kind":"text","text":" "},{"kind":"identifier","text":"onTargetDespawn"},{"kind":"text","text":": "},{"preciseIdentifier":"s:11WorldModule13CleanupActionO","kind":"typeIdentifier","text":"CleanupAction"}]},"doc://WorldModule/documentation/WorldModule/Relation/isExclusive":{"required":true,"title":"isExclusive","role":"symbol","url":"\/documentation\/worldmodule\/relation\/isexclusive","defaultImplementations":1,"kind":"symbol","identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/Relation\/isExclusive","type":"topic","abstract":[{"type":"text","text":"A Boolean value indicating whether a source relates to at most one target."}],"fragments":[{"text":"static","kind":"keyword"},{"text":" ","kind":"text"},{"text":"var","kind":"keyword"},{"text":" ","kind":"text"},{"text":"isExclusive","kind":"identifier"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:Sb","text":"Bool","kind":"typeIdentifier"}]},"doc://WorldModule/documentation/WorldModule/HierarchyError":{"title":"HierarchyError","navigatorTitle":[{"text":"HierarchyError","kind":"identifier"}],"abstract":[{"text":"An error that indicates why ","type":"text"},{"isActive":true,"identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/World\/addChild(_:checkedTo:)","type":"reference"},{"text":" could not link two entities.","type":"text"}],"identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/HierarchyError","role":"symbol","fragments":[{"text":"enum","kind":"keyword"},{"text":" ","kind":"text"},{"text":"HierarchyError","kind":"identifier"}],"kind":"symbol","url":"\/documentation\/worldmodule\/hierarchyerror","type":"topic"}}}