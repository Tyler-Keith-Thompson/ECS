\/WorldModule\/World\/ancestors(of:)","type":"topic","kind":"symbol","role":"symbol","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"ancestors","kind":"identifier"},{"text":"(","kind":"text"},{"text":"of","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"Entity","kind":"typeIdentifier","preciseIdentifier":"s:11WorldModule6EntityV"},{"text":") -> ","kind":"text"},{"text":"AncestorsView","kind":"typeIdentifier","preciseIdentifier":"s:11WorldModule13AncestorsViewV"}]},"doc://WorldModule/documentation/WorldModule/ChildOf":{"title":"ChildOf","url":"\/documentation\/worldmodule\/childof","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"ChildOf","kind":"identifier"}],"abstract":[{"type":"text","text":"The relation that links a child entity to its parent."}],"type":"topic","role":"symbol","navigatorTitle":[{"text":"ChildOf","kind":"identifier"}],"kind":"symbol","identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/ChildOf"},"doc://WorldModule/documentation/WorldModule/World/unrelate(_:_:from:)":{"identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/World\/unrelate(_:_:from:)","type":"topic","title":"unrelate(_:_:from:)","kind":"symbol","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"unrelate"},{"kind":"text","text":"<"},{"kind":"genericParameter","text":"R"},{"kind":"text","text":">("},{"kind":"typeIdentifier","text":"Entity","preciseIdentifier":"s:11WorldModule6EntityV"},{"kind":"text","text":", "},{"kind":"typeIdentifier","text":"R"},{"kind":"text","text":".Type, "},{"kind":"externalParam","text":"from"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"Entity","preciseIdentifier":"s:11WorldModule6EntityV"},{"kind":"text","text":") -> "},{"kind":"typeIdentifier","text":"R"},{"kind":"text","text":"?"}],"role":"symbol","abstract":[{"type":"text","text":"Removes the link between a source entity and a target entity and returns its value."}],"url":"\/documentation\/worldmodule\/world\/unrelate(_:_:from:)"},"doc://WorldModule/documentation/WorldModule/World/parent(of:)":{"title":"parent(of:)","url":"\/documentation\/worldmodule\/world\/parent(of:)","abstract":[{"text":"Returns the parent of an entity.","type":"text"}],"identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/World\/parent(of:)","type":"topic","kind":"symbol","role":"symbol","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"parent"},{"kind":"text","text":"("},{"kind":"externalParam","text":"of"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:11WorldModule6EntityV","text":"Entity"},{"kind":"text","text":") -> "},{"kind":"typeIdentifier","preciseIdentifier":"s:11WorldModule6EntityV","text":"Entity"},{"kind":"text","text":"?"}]},"doc://WorldModule/documentation/WorldModule/CyclicHierarchy":{"type":"topic","kind":"symbol","navigatorTitle":[{"text":"CyclicHierarchy","kind":"identifier"}],"title":"CyclicHierarchy","identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/CyclicHierarchy","abstract":[{"type":"text","text":"An error that indicates a link would make an entity its own ancestor."}],"role":"symbol","url":"\/documentation\/worldmodule\/cyclichierarchy","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"CyclicHierarchy","kind":"identifier"}]},"doc://WorldModule/documentation/WorldModule/World/descendants(of:)":{"identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/World\/descendants(of:)","type":"topic","title":"descendants(of:)","kind":"symbol","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"descendants"},{"kind":"text","text":"("},{"kind":"externalParam","text":"of"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"Entity","preciseIdentifier":"s:11WorldModule6EntityV"},{"kind":"text","text":") -> "},{"kind":"typeIdentifier","text":"DescendantsView","preciseIdentifier":"s:11WorldModule15DescendantsViewV"}],"role":"symbol","abstract":[{"text":"Returns the descendants of an entity, depth-first.","type":"text"}],"url":"\/documentation\/worldmodule\/world\/descendants(of:)"}}}