{"abstract":[{"text":"Registers a closure to run whenever an entity stops matching a query.","type":"text"}],"primaryContentSections":[{"declarations":[{"languages":["swift"],"tokens":[{"text":"mutating","kind":"keyword"},{"text":" ","kind":"text"},{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"onRemove","kind":"identifier"},{"text":"<each ","kind":"text"},{"text":"T","kind":"genericParameter"},{"text":">(","kind":"text"},{"text":"_","kind":"externalParam"},{"text":" ","kind":"text"},{"text":"query","kind":"internalParam"},{"text":": ","kind":"text"},{"text":"Query","preciseIdentifier":"s:11WorldModule5QueryV","kind":"typeIdentifier","identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/Query"},{"text":"<repeat each ","kind":"text"},{"text":"T","kind":"typeIdentifier"},{"text":">, ","kind":"text"},{"text":"perform","kind":"externalParam"},{"text":" ","kind":"text"},{"text":"hook","kind":"internalParam"},{"text":": ","kind":"text"},{"text":"@escaping ","kind":"attribute"},{"text":"@Sendable","kind":"attribute"},{"text":" (","kind":"text"},{"text":"inout","kind":"keyword"},{"text":" ","kind":"text"},{"text":"World","preciseIdentifier":"s:11WorldModule0A0V","kind":"typeIdentifier","identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/World"},{"text":", ","kind":"text"},{"text":"Entity","preciseIdentifier":"s:11WorldModule6EntityV","kind":"typeIdentifier","identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/Entity"},{"text":") -> ","kind":"text"},{"text":"Void","preciseIdentifier":"s:s4Voida","kind":"typeIdentifier"},{"text":") ","kind":"text"},{"text":"where","kind":"keyword"},{"text":" repeat each ","kind":"text"},{"text":"T","kind":"typeIdentifier"},{"text":" : ","kind":"text"},{"text":"QueryTerm","preciseIdentifier":"s:11WorldModule9QueryTermP","kind":"typeIdentifier","identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/QueryTerm"}],"platforms":["Linux"]}],"kind":"declarations"},{"kind":"parameters","parameters":[{"name":"query","content":[{"inlineContent":[{"type":"text","text":"The query whose matches to watch."}],"type":"paragraph"}]},{"name":"hook","content":[{"inlineContent":[{"text":"The closure to run, given the world and the entity that stopped matching.","type":"text"}],"type":"paragraph"}]}]},{"kind":"content","content":[{"type":"heading","anchor":"discussion","level":2,"text":"Discussion"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The hook runs when inserting, removing, despawning or applying a command makes an entity"},{"type":"text","text":" "},{"type":"text","text":"stop matching the query’s structural conditions, as the query "},{"type":"codeVoice","code":"onAdd(_:perform:)"},{"type":"text","text":" "},{"type":"text","text":"describes. After a despawn, the entity is no longer live when the hook runs."}]},{"type":"paragraph","inlineContent":[{"text":"The following example counts the movers that are frozen in place:","type":"text"}]},{"type":"codeListing","code":["struct StoppedCount: Resource { var count = 0 }","","var world = World()","world.resources.insert(StoppedCount())","world.onRemove(Query(Position.self, Velocity.self).without(Frozen.self)) { world, _ in","    world.resources[StoppedCount.self].count += 1","}","","let rock = world.spawn(Position(x: 0, y: 0), Velocity(dx: 1, dy: 0))","world.insert(Frozen(), into: rock)","print(world.resources[StoppedCount.self].count)","\/\/ Prints \"1\""],"syntax":"swift"},{"type":"aside","name":"Complexity","content":[{"inlineContent":[{"type":"text","text":"That of "},{"isActive":true,"type":"reference","identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/World\/cache(_:)"},{"type":"text","text":" when the world keeps no cache of the query’s"},{"type":"text","text":" "},{"type":"text","text":"conditions; otherwise, O(1) amortized."}],"type":"paragraph"}],"style":"note"}]}],"seeAlsoSections":[{"anchor":"Responding-to-Component-Changes-with-Hooks","identifiers":["doc:\/\/WorldModule\/d