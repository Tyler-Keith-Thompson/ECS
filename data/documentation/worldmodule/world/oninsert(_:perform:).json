ation\/WorldModule\/ReactingToChanges"],"kind":"mentions"},{"content":[{"level":2,"text":"Discussion","type":"heading","anchor":"discussion"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Insert hooks run at the same point add hooks do (see "},{"code":"onAdd(_:perform:)","type":"codeVoice"},{"type":"text","text":"). For a new"},{"type":"text","text":" "},{"type":"text","text":"component, the add hooks run first."}]},{"type":"paragraph","inlineContent":[{"text":"The following example counts every insert of a ","type":"text"},{"code":"Health","type":"codeVoice"},{"text":" component, and shows that a","type":"text"},{"text":" ","type":"text"},{"text":"change made in place doesn’t run the hook:","type":"text"}]},{"syntax":"swift","type":"codeListing","code":["struct HealthWrites: Resource { var count = 0 }","","var world = World()","world.resources.insert(HealthWrites())","world.onInsert(Health.self) { world, _ in","    world.resources[HealthWrites.self].count += 1","}","","let knight = world.spawn(Health(current: 10))","world.insert(Health(current: 8), into: knight)","world[Health.self, of: knight].current -= 1","print(world.resources[HealthWrites.self].count)","\/\/ Prints \"2\""]},{"name":"Complexity","type":"aside","content":[{"inlineContent":[{"type":"text","text":"O(1) amortized."}],"type":"paragraph"}],"style":"note"}],"kind":"content"}],"sections":[],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/worldmodule\/world\/oninsert(_:perform:)"]}],"abstract":[{"text":"Registers a closure to run whenever an entity is given a component of the given type,","type":"text"},{"text":" ","type":"text"},{"text":"whether it’s new or replaces one the entity held.","type":"text"}],"hierarchy":{"paths":[["doc:\/\/WorldModule\/documentation\/WorldModule","doc:\/\/WorldModule\/documentation\/WorldModule\/World"]]},"references":{"doc://WorldModule/documentation/WorldModule":{"kind":"symbol","identifier":"doc:\/\/WorldModule\/documentatio