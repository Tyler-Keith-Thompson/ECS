,"type":"paragraph"}],"kind":"content"},{"content":[{"type":"heading","text":"Discussion","level":2,"anchor":"discussion"},{"type":"paragraph","inlineContent":[{"type":"text","text":"A reader is any type you choose to identify the code reading, such as the system’s own"},{"type":"text","text":" "},{"type":"text","text":"type. The world keeps each reader’s place in the events, so readers don’t affect one"},{"type":"text","text":" "},{"type":"text","text":"another, and a copy of the world keeps the places its original had:"}]},{"type":"codeListing","syntax":"swift","code":["enum SoundReader {}","","var world = World()","let ship = world.spawn(Health(current: 3))","let asteroid = world.spawn(Health(current: 1))","world.send(Collision(first: ship, second: asteroid))","","let heard = world.readEvents(Collision.self, by: SoundReader.self)","print(heard.count)","\/\/ Prints \"1\"","","let heardAgain = world.readEvents(Collision.self, by: SoundReader.self)","print(heardAgain.count)","\/\/ Prints \"0\"","","let damaging = world.readEvents(Collision.self, by: DamageReader.self)","print(damaging.count)","\/\/ Prints \"1\""]},{"type":"aside","style":"important","name":"Important","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"A reader that doesn’t read for two updates misses the events dropped in"},{"type":"text","text":" "},{"type":"text","text":"between."}]}]},{"type":"aside","style":"note","name":"Complexity","content":[{"type":"paragraph","inlineContent":[{"text":"O(1). The view shares the events’ storage.","type":"text"}]}]}],"kind":"content"}],"sections":[],"schemaVersion":{"minor":3,"major":0,"patch":0},"kind":"symbol","references":{"doc://WorldModule/documentation/WorldModule/Event":{"role":"symbol","type":"topic","abstract":[{"text":"A type that describes a message one part of a program sends and other parts read later.","type":"text"}],"identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/Event","url":"\/documentation\/worldmodule\/eve