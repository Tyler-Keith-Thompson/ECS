:"content","content":[{"anchor":"discussion","level":2,"text":"Discussion","type":"heading"},{"inlineContent":[{"type":"text","text":"A reader is any type you choose to identify the code reading, such as the system’s own"},{"type":"text","text":" "},{"type":"text","text":"type. The world keeps each reader’s place in the events, so readers don’t affect one"},{"type":"text","text":" "},{"type":"text","text":"another, and a copy of the world keeps the places its original had:"}],"type":"paragraph"},{"code":["enum SoundReader {}","","var world = World()","let ship = world.spawn(Health(current: 3))","let asteroid = world.spawn(Health(current: 1))","world.send(Collision(first: ship, second: asteroid))","","let heard = world.readEvents(Collision.self, by: SoundReader.self)","print(heard.count)","\/\/ Prints \"1\"","","let heardAgain = world.readEvents(Collision.self, by: SoundReader.self)","print(heardAgain.count)","\/\/ Prints \"0\"","","let damaging = world.readEvents(Collision.self, by: DamageReader.self)","print(damaging.count)","\/\/ Prints \"1\""],"syntax":"swift","type":"codeListing"},{"name":"Important","content":[{"inlineContent":[{"type":"text","text":"A reader that doesn’t read for two updates misses the events dropped in"},{"type":"text","text":" "},{"type":"text","text":"between."}],"type":"paragraph"}],"style":"important","type":"aside"},{"name":"Complexity","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"O(1). The view shares the events’ storage."}]}],"style":"note","type":"aside"}]}],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/WorldModule\/documentation\/WorldModule\/World\/readEvents(_:by:)"},"references":{"doc://WorldModule/documentation/WorldModule/World/events(_:)":{"type":"topic","abstract":[{"type":"text","text":"Returns every event of a type that the world holds, oldest first, without marking any as"},{"type":"text","text":" "},{"type":"text","text":"read."}],"kind":"symbol","identifier":"doc:\/\/WorldModule\/docum