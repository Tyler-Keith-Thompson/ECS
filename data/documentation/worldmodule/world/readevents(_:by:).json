:"discussion"},{"inlineContent":[{"text":"A reader is any type you choose to identify the code reading, such as the system’s own","type":"text"},{"text":" ","type":"text"},{"text":"type. The world keeps each reader’s place in the events, so readers don’t affect one","type":"text"},{"text":" ","type":"text"},{"text":"another, and a copy of the world keeps the places its original had:","type":"text"}],"type":"paragraph"},{"syntax":"swift","code":["enum SoundReader {}","","var world = World()","let ship = world.spawn(Health(current: 3))","let asteroid = world.spawn(Health(current: 1))","world.send(Collision(first: ship, second: asteroid))","","let heard = world.readEvents(Collision.self, by: SoundReader.self)","print(heard.count)","\/\/ Prints \"1\"","","let heardAgain = world.readEvents(Collision.self, by: SoundReader.self)","print(heardAgain.count)","\/\/ Prints \"0\"","","let damaging = world.readEvents(Collision.self, by: DamageReader.self)","print(damaging.count)","\/\/ Prints \"1\""],"type":"codeListing"},{"style":"important","content":[{"type":"paragraph","inlineContent":[{"text":"A reader that doesn’t read for two updates misses the events dropped in","type":"text"},{"text":" ","type":"text"},{"text":"between.","type":"text"}]}],"name":"Important","type":"aside"},{"style":"note","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"O(1). The view shares the events’ storage."}]}],"name":"Complexity","type":"aside"}]}],"abstract":[{"text":"Returns the events of a type that a reader hasn’t read yet, oldest first, and marks them","type":"text"},{"text":" ","type":"text"},{"text":"as read by that reader.","type":"text"}],"references":{"doc://WorldModule/documentation/WorldModule/EventsView":{"type":"topic","url":"\/documentation\/worldmodule\/eventsview","identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/EventsView","title":"EventsView","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text"