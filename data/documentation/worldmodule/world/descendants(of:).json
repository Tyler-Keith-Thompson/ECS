{"sections":[],"schemaVersion":{"minor":3,"patch":0,"major":0},"kind":"symbol","primaryContentSections":[{"declarations":[{"platforms":["Linux"],"tokens":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"descendants","kind":"identifier"},{"text":"(","kind":"text"},{"text":"of","kind":"externalParam"},{"text":" ","kind":"text"},{"text":"entity","kind":"internalParam"},{"text":": ","kind":"text"},{"identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/Entity","text":"Entity","kind":"typeIdentifier","preciseIdentifier":"s:11WorldModule6EntityV"},{"text":") -> ","kind":"text"},{"identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/DescendantsView","text":"DescendantsView","kind":"typeIdentifier","preciseIdentifier":"s:11WorldModule15DescendantsViewV"}],"languages":["swift"]}],"kind":"declarations"},{"parameters":[{"name":"entity","content":[{"inlineContent":[{"text":"The entity whose descendants to walk.","type":"text"}],"type":"paragraph"}]}],"kind":"parameters"},{"content":[{"type":"heading","level":2,"text":"Return Value","anchor":"return-value"},{"type":"paragraph","inlineContent":[{"type":"text","text":"A view of the descendants of "},{"type":"codeVoice","code":"entity"},{"type":"text","text":"; empty if it has no children or isn’t"},{"type":"text","text":" "},{"type":"text","text":"live."}]}],"kind":"content"},{"content":[{"level":2,"anchor":"discussion","text":"Discussion","type":"heading"},{"type":"paragraph","inlineContent":[{"text":"The view visits each descendant before its own children, and siblings in the order they","type":"text"},{"text":" ","type":"text"},{"text":"were added. It reads the world as it was when you called this method, so you can change","type":"text"},{"text":" ","type":"text"},{"text":"the world while iterating. The following example moves a ship’s parts along with it:","type":"text"}]},{"code":["var world = World()","let ship = world.spawn(Position(x: 0, y: 0))","let turret = world.spawn(Position(x: 1, y: 0))","let gun = world.spawn(Position(x: 2, y: 0))","try world.addChild(turret, to: ship)","try world.addChild(gun, to: turret)","","for part in world.descendants(of: ship) {","    world[Position.self, of: part].x += 10","}","print(world[Position.self, of: gun])","\/\/ Prints \"Position(x: 12.0, y: 0.0)\""],"type":"codeListing","syntax":"swift"},{"style":"note","name":"Complexity","content":[{"type":"paragraph","inlineContent":[{"text":"O(1). Walking the view is O(","type":"text"},{"inlineContent":[{"text":"n","type":"text"}],"type":"emphasis"},{"text":"), where ","type":"text"},{"inlineContent":[{"type":"text","text":"n"}],"type":"emphasis"},{"text":" is the number of descendants.","type":"text"}]}],"type":"aside"}],"kind":"content"}],"hierarchy":{"paths":[["doc:\/\/WorldModule\/documentation\/WorldModule","doc:\/\/WorldModule\/documentation\/WorldModule\/World"]]},"seeAlsoSections":[{"generated":true,"identifiers":["doc:\/\/WorldModule\/documentation\/WorldModule\/World\/addChild(_:to:)","doc:\/\/WorldModule\/documentation\/WorldModule\/World\/addChild(_:checkedTo:)","doc:\/\/WorldModule\/documentation\/WorldModule\/World\/removeParent(of:)","doc:\/\/WorldModule\/documentation\/WorldModule\/World\/removeParent(checkedOf:)","doc:\/\/WorldModule\/documentation\/WorldModule\/World\/parent(of:)","doc:\/\/WorldModule\/documentation\/WorldModule\/World\/children(of:)","doc:\/\/WorldModule\/documentation\/WorldModule\/World\/ancestors(of:)"],"title":"Building a Hierarchy","anchor":"Building-a-Hierarchy"}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/worldmodule\/world\/descendants(of:)"]}],"metadata":{"modules":[{"name":"WorldModule"}],"roleHeading":"Instance Method","externalID":"s:11WorldModule0A0V11descendants2ofAA15DescendantsViewVAA6EntityV_tF","symbolKind":"method","title":"descendants(of:)","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"descendants","kind":"identifier"},{"text":"(","kind":"