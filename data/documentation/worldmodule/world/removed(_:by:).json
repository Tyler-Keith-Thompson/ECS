 up after components that are gone, such as removing an","type":"text"},{"text":" ","type":"text"},{"text":"entity’s health bar when it loses its ","type":"text"},{"type":"codeVoice","code":"Health"},{"text":". The first call for a type starts recording","type":"text"},{"text":" ","type":"text"},{"text":"its removals (","type":"text"},{"type":"reference","identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/World\/trackRemovals(of:)","isActive":true},{"text":"), so removals made before it aren’t reported. Each","type":"text"},{"text":" ","type":"text"},{"text":"reader type has its own place in the record, as with ","type":"text"},{"type":"reference","identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/World\/readEvents(_:by:)","isActive":true},{"text":".","type":"text"}],"type":"paragraph"},{"syntax":"swift","code":["enum HealthbarReader {}","","var world = World()","_ = world.removed(Health.self, by: HealthbarReader.self)","","let knight = world.spawn(Health(current: 10))","let archer = world.spawn(Health(current: 6))","world.remove(Health.self, from: archer)","world.despawn(knight)","","let lost = world.removed(Health.self, by: HealthbarReader.self)","print(lost == [archer, knight])","\/\/ Prints \"true\""],"type":"codeListing"},{"inlineContent":[{"type":"text","text":"An entity appears once per removal: an entity whose "},{"type":"codeVoice","code":"C"},{"type":"text","text":" is removed, inserted and removed"},{"type":"text","text":" "},{"type":"text","text":"again appears twice."}],"type":"paragraph"},{"content":[{"type":"paragraph","inlineContent":[{"text":"O(","type":"text"},{"inlineContent":[{"text":"r","type":"text"}],"type":"emphasis"},{"text":"), where ","type":"text"},{"inlineContent":[{"type":"text","text":"r"}],"type":"emphasis"},{"text":" is the number of removals returned.","type":"text"}]}],"style":"note","type":"aside","name":"Complexity"}]}],"references":{"doc://WorldModule/documentation/WorldModule/World":{"type":"topic","fragm