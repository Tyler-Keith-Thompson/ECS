,"text":"The entities that lost a "},{"type":"codeVoice","code":"C"},{"type":"text","text":" since "},{"type":"codeVoice","code":"reader"},{"type":"text","text":" last asked."}]}]},{"kind":"content","content":[{"type":"heading","text":"Discussion","level":2,"anchor":"discussion"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Use this method to clean up after components that are gone, such as removing an"},{"type":"text","text":" "},{"type":"text","text":"entity’s health bar when it loses its "},{"type":"codeVoice","code":"Health"},{"type":"text","text":". The first call for a type starts recording"},{"type":"text","text":" "},{"type":"text","text":"its removals ("},{"type":"reference","identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/World\/trackRemovals(of:)","isActive":true},{"type":"text","text":"), so removals made before it aren’t reported. Each"},{"type":"text","text":" "},{"type":"text","text":"reader type has its own place in the record, as with "},{"type":"reference","identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/World\/readEvents(_:by:)","isActive":true},{"type":"text","text":"."}]},{"type":"codeListing","code":["enum HealthbarReader {}","","var world = World()","_ = world.removed(Health.self, by: HealthbarReader.self)","","let knight = world.spawn(Health(current: 10))","let archer = world.spawn(Health(current: 6))","world.remove(Health.self, from: archer)","world.despawn(knight)","","let lost = world.removed(Health.self, by: HealthbarReader.self)","print(lost == [archer, knight])","\/\/ Prints \"true\""],"syntax":"swift"},{"type":"paragraph","inlineContent":[{"type":"text","text":"An entity appears once per removal: an entity whose "},{"type":"codeVoice","code":"C"},{"type":"text","text":" is removed, inserted and removed"},{"type":"text","text":" "},{"type":"text","text":"again appears twice."}]},{"type":"aside","name":"Complexity","content":[{"inlineContent":[{"text":"O(","type":"text"},{"inlineContent":[{"type":"text","text":"r"}],"type":"emphasis"},{"text":"), where ","type":"text"},{"inlineContent":[{"text":"r","type":"text"}],"type":"emphasis"},{"text":" is the number of removals returned.","type":"text"}],"type":"paragraph"}],"style":"note"}]}],"hierarchy":{"paths":[["doc:\/\/WorldModule\/documentation\/WorldModule","doc:\/\/WorldModule\/documentation\/WorldModule\/World"]]},"seeAlsoSections":[{"title":"Detecting Removals","anchor":"Detecting-Removals","identifiers":["doc:\/\/WorldModule\/documentation\/WorldModule\/World\/trackRemovals(of:)"],"generated":true}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/worldmodule\/world\/removed(_:by:)"]}],"kind":"symbol","sections":[],"identifier":{"url":"doc:\/\/WorldModule\/documentation\/WorldModule\/World\/removed(_:by:)","interfaceLanguage":"swift"},"metadata":{"modules":[{"name":"WorldModule"}],"externalID":"s:11WorldModule0A0V7removed_2bySayAA6EntityVGxm_q_mtAA9ComponentRzr0_lF","role":"symbol","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"removed"},{"text":"<","kind":"text"},{"text":"C","kind":"genericParameter"},{"text":", ","kind":"text"},{"text":"Reader","kind":"genericParameter"},{"text":">(","kind":"text"},{"text":"C","kind":"typeIdentifier"},{"text":".Type, ","kind":"text"},{"text":"by","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"Reader","kind":"typeIdentifier"},{"text":".Type) -> [","kind":"text"},{"text":"Entity","kind":"typeIdentifier","preciseIdentifier":"s:11WorldModule6EntityV"},{"text":"]","kind":"text"}],"symbolKind":"method","remoteSource":{"fileName":"Removals.swift","url":"https:\/\/github.com\/Tyler-Keith-Thompson\/ECS\/blob\/main\/Sources\/WorldModule\/Removals.swift#L90"},"title":"removed(_:by:)","extendedModule":"WorldModule","roleHeading":"Instance Method"},"schemaVersion":{"major":0,"minor":3,"patch":0},"references":{"doc://WorldModule/documentation/WorldModule/World/removed(_:by:)":{"url":