,"level":2,"anchor":"discussion","type":"heading"},{"inlineContent":[{"type":"text","text":"Use this method to clean up after components that are gone, such as removing an"},{"type":"text","text":" "},{"type":"text","text":"entity’s health bar when it loses its "},{"code":"Health","type":"codeVoice"},{"type":"text","text":". The first call for a type starts recording"},{"type":"text","text":" "},{"type":"text","text":"its removals ("},{"isActive":true,"type":"reference","identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/World\/trackRemovals(of:)"},{"type":"text","text":"), so removals made before it aren’t reported. Each"},{"type":"text","text":" "},{"type":"text","text":"reader type has its own place in the record, as with "},{"isActive":true,"type":"reference","identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/World\/readEvents(_:by:)"},{"type":"text","text":"."}],"type":"paragraph"},{"syntax":"swift","code":["enum HealthbarReader {}","","var world = World()","_ = world.removed(Health.self, by: HealthbarReader.self)","","let knight = world.spawn(Health(current: 10))","let archer = world.spawn(Health(current: 6))","world.remove(Health.self, from: archer)","world.despawn(knight)","","let lost = world.removed(Health.self, by: HealthbarReader.self)","print(lost == [archer, knight])","\/\/ Prints \"true\""],"type":"codeListing"},{"inlineContent":[{"type":"text","text":"An entity appears once per removal: an entity whose "},{"type":"codeVoice","code":"C"},{"type":"text","text":" is removed, inserted and removed"},{"type":"text","text":" "},{"type":"text","text":"again appears twice."}],"type":"paragraph"},{"content":[{"inlineContent":[{"text":"O(","type":"text"},{"inlineContent":[{"type":"text","text":"r"}],"type":"emphasis"},{"text":"), where ","type":"text"},{"inlineContent":[{"type":"text","text":"r"}],"type":"emphasis"},{"text":" is the number of removals returned.","type":"text"}],"type":"paragraph"}],"style":"note","name":"Complexity","type":"aside"}]}],"references":{"doc://WorldModule/documentation/WorldModule/World/readEvents(_:by:)":{"role":"symbol","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"readEvents"},{"kind":"text","text":"<"},{"kind":"genericParameter","text":"E"},{"kind":"text","text":", "},{"kind":"genericParameter","text":"Reader"},{"kind":"text","text":">("},{"kind":"typeIdentifier","text":"E"},{"kind":"text","text":".Type, "},{"kind":"externalParam","text":"by"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"Reader"},{"kind":"text","text":".Type) -> "},{"preciseIdentifier":"s:11WorldModule10EventsViewV","kind":"typeIdentifier","text":"EventsView"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","text":"E"},{"kind":"text","text":">"}],"url":"\/documentation\/worldmodule\/world\/readevents(_:by:)","type":"topic","identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/World\/readEvents(_:by:)","kind":"symbol","abstract":[{"text":"Returns the events of a type that a reader hasn’t read yet, oldest first, and marks them","type":"text"},{"text":" ","type":"text"},{"text":"as read by that reader.","type":"text"}],"title":"readEvents(_:by:)"},"doc://WorldModule/documentation/WorldModule":{"identifier":"doc:\/\/WorldModule\/documentation\/WorldModule","type":"topic","title":"WorldModule","kind":"symbol","role":"collection","abstract":[{"text":"Store the state of a game or simulation as entities and components, and read and change it with","type":"text"},{"text":" ","type":"text"},{"text":"queries, updates, and commands.","type":"text"}],"url":"\/documentation\/worldmodule"},"doc://WorldModule/documentation/WorldModule/ReactingToChanges":{"url":"\/documentation\/worldmodule\/reactingtochanges","role":"article","abstract":[{"type":"text","text":"Find the components that changed or went away, run code as changes happen, and pass messages"},{"type":"text","text":" "},{"type":"text","text":"between the parts of a program