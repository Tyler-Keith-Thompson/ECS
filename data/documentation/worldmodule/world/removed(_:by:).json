{"abstract":[{"type":"text","text":"Returns the entities that lost a component of the given type since a reader last asked,"},{"type":"text","text":" "},{"type":"text","text":"oldest first."}],"primaryContentSections":[{"declarations":[{"languages":["swift"],"platforms":["Linux"],"tokens":[{"text":"mutating","kind":"keyword"},{"text":" ","kind":"text"},{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"removed","kind":"identifier"},{"text":"<","kind":"text"},{"text":"C","kind":"genericParameter"},{"text":", ","kind":"text"},{"text":"Reader","kind":"genericParameter"},{"text":">(","kind":"text"},{"text":"_","kind":"externalParam"},{"text":" ","kind":"text"},{"text":"type","kind":"internalParam"},{"text":": ","kind":"text"},{"text":"C","kind":"typeIdentifier"},{"text":".Type, ","kind":"text"},{"text":"by","kind":"externalParam"},{"text":" ","kind":"text"},{"text":"reader","kind":"internalParam"},{"text":": ","kind":"text"},{"text":"Reader","kind":"typeIdentifier"},{"text":".Type) -> [","kind":"text"},{"identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/Entity","text":"Entity","kind":"typeIdentifier","preciseIdentifier":"s:11WorldModule6EntityV"},{"text":"] ","kind":"text"},{"text":"where","kind":"keyword"},{"text":" ","kind":"text"},{"text":"C","kind":"typeIdentifier"},{"text":" : ","kind":"text"},{"identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/Component","text":"Component","kind":"typeIdentifier","preciseIdentifier":"s:11WorldModule9ComponentP"}]}],"kind":"declarations"},{"kind":"parameters","parameters":[{"name":"type","content":[{"inlineContent":[{"type":"text","text":"The component type whose removals to report."}],"type":"paragraph"}]},{"name":"reader","content":[{"inlineContent":[{"type":"text","text":"The type that identifies the reader."}],"type":"paragraph"}]}]},{"kind":"content","content":[{"text":"Return Value","type":"heading","anchor":"return-value","level":2},{"type":"paragraph","inlineContent":[{"text":"The entities that lost a ","type":"text"},{"code":"C","type":"codeVoice"},{"text":" since ","type":"text"},{"code":"reader","type":"codeVoice"},{"text":" last asked.","type":"text"}]}]},{"kind":"content","content":[{"text":"Discussion","anchor":"discussion","type":"heading","level":2},{"type":"paragraph","inlineContent":[{"type":"text","text":"Use this method to clean up after components that are gone, such as removing an"},{"type":"text","text":" "},{"type":"text","text":"entity’s health bar when it loses its "},{"type":"codeVoice","code":"Health"},{"type":"text","text":". The first call for a type starts recording"},{"type":"text","text":" "},{"type":"text","text":"its removals ("},{"type":"reference","identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/World\/trackRemovals(of:)","isActive":true},{"type":"text","text":"), so removals made before it aren’t reported. Each"},{"type":"text","text":" "},{"type":"text","text":"reader type has its own place in the record, as with "},{"type":"reference","identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/World\/readEvents(_:by:)","isActive":true},{"type":"text","text":"."}]},{"code":["enum HealthbarReader {}","","var world = World()","_ = world.removed(Health.self, by: HealthbarReader.self)","","let knight = world.spawn(Health(current: 10))","let archer = world.spawn(Health(current: 6))","world.remove(Health.self, from: archer)","world.despawn(knight)","","let lost = world.removed(Health.self, by: HealthbarReader.self)","print(lost == [archer, knight])","\/\/ Prints \"true\""],"syntax":"swift","type":"codeListing"},{"type":"paragraph","inlineContent":[{"text":"An entity appears once per removal: an entity whose ","type":"text"},{"code":"C","type":"codeVoice"},{"text":" is removed, inserted and removed","type":"text"},{"text":" ","type":"text"},{"text":"again appears twice.","type":"text"}]},{"name":"Complexity","type":"aside","style":"note","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"O("},{"type":"emphasis","inlineContent":[{"text":"r","type":"text"}]},{"type":"text","text":"), where "},{"type":"emphasis","inlineContent":[{"text":"r","type":"text"}]},{"type":"text","text":" is the number of removals returned."}]}]}]}],"seeAlsoSections":[{"identifiers":["doc:\/\/WorldModule\/documentation\/WorldModule\/World\/trackRemovals(of:)"],"anchor":"Detecting-Removals","generated":true,"title":"Detecting Removals"}],"hierarchy":{"paths":[["doc:\/\/WorldModule\/documentation\/WorldModule","doc:\/\/WorldModule\/documentation\/WorldModule\/World"]]},"sections":[],"kind":"symbol","identifier":{"interfaceLanguage":"swift","url":"doc:\/\/WorldModule\/documentation\/WorldModule\/World\/removed(_:by:)"},"metadata":{"modules":[{"name":"WorldModule"}],"extendedModule":"WorldModule","externalID":"s:11WorldModule0A0V7removed_2bySayAA6EntityVGxm_q_mtAA9ComponentRzr0_lF","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"removed","kind":"identifier"},{"text":"<","kind":"text"},{"text":"C","kind":"genericParameter"},{"text":", ","kind":"text"},{"text":"Reader","kind":"genericParameter"},{"text":">(","kind":"text"},{"text":"C","kind":"typeIdentifier"},{"text":".Type, ","kind":"text"},{"text":"by","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"Reader","kind":"typeIdentifier"},{"text":".Type) -> [","kind":"text"},{"text":"Entity","preciseIdentifier":"s:11WorldModule6EntityV","kind":"typeIdentifier"},{"text":"]","kind":"text"}],"role":"symbol","symbolKind":"method","roleHeading":"Instance Method","remoteSource":{"url":"https:\/\/github.com\/Tyler-Keith-Thompson\/ECS\/blob\/main\/Sources\/WorldModule\/Removals.swift#L90","fileName":"Removals.swift"},"title":"removed(_:by:)"},"schemaVersion":{"major":0,"minor":3,"patch":0},"variants":[{"paths":["\/documentation\/worldmodule\/world\/removed(_:by:)"],"traits":[{"interfaceLanguage":"swift"}]}],"references":{"doc://WorldModule/documentation/WorldModule/Component":{"navigatorTitle":