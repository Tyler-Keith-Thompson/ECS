 method to clean up after components that are gone, such as removing an"},{"type":"text","text":" "},{"type":"text","text":"entity’s health bar when it loses its "},{"type":"codeVoice","code":"Health"},{"type":"text","text":". The first call for a type starts recording"},{"type":"text","text":" "},{"type":"text","text":"its removals ("},{"type":"reference","isActive":true,"identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/World\/trackRemovals(of:)"},{"type":"text","text":"), so removals made before it aren’t reported. Each"},{"type":"text","text":" "},{"type":"text","text":"reader type has its own place in the record, as with "},{"type":"reference","isActive":true,"identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/World\/readEvents(_:by:)"},{"type":"text","text":"."}]},{"type":"codeListing","syntax":"swift","code":["enum HealthbarReader {}","","var world = World()","_ = world.removed(Health.self, by: HealthbarReader.self)","","let knight = world.spawn(Health(current: 10))","let archer = world.spawn(Health(current: 6))","world.remove(Health.self, from: archer)","world.despawn(knight)","","let lost = world.removed(Health.self, by: HealthbarReader.self)","print(lost == [archer, knight])","\/\/ Prints \"true\""]},{"type":"paragraph","inlineContent":[{"type":"text","text":"An entity appears once per removal: an entity whose "},{"type":"codeVoice","code":"C"},{"type":"text","text":" is removed, inserted and removed"},{"type":"text","text":" "},{"type":"text","text":"again appears twice."}]},{"style":"note","name":"Complexity","content":[{"inlineContent":[{"text":"O(","type":"text"},{"inlineContent":[{"type":"text","text":"r"}],"type":"emphasis"},{"text":"), where ","type":"text"},{"inlineContent":[{"text":"r","type":"text"}],"type":"emphasis"},{"text":" is the number of removals returned.","type":"text"}],"type":"paragraph"}],"type":"aside"}],"kind":"content"}],"references":{"doc://WorldModule/documentation/WorldModule/World":{"kind":"symbol","abst