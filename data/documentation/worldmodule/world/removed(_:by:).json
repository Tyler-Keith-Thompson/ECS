.despawn(knight)","","let lost = world.removed(Health.self, by: HealthbarReader.self)","print(lost == [archer, knight])","\/\/ Prints \"true\""],"syntax":"swift","type":"codeListing"},{"inlineContent":[{"type":"text","text":"An entity appears once per removal: an entity whose "},{"type":"codeVoice","code":"C"},{"type":"text","text":" is removed, inserted and removed"},{"type":"text","text":" "},{"type":"text","text":"again appears twice."}],"type":"paragraph"},{"name":"Complexity","style":"note","content":[{"type":"paragraph","inlineContent":[{"text":"O(","type":"text"},{"inlineContent":[{"type":"text","text":"r"}],"type":"emphasis"},{"text":"), where ","type":"text"},{"inlineContent":[{"text":"r","type":"text"}],"type":"emphasis"},{"text":" is the number of removals returned.","type":"text"}]}],"type":"aside"}],"kind":"content"}],"hierarchy":{"paths":[["doc:\/\/WorldModule\/documentation\/WorldModule","doc:\/\/WorldModule\/documentation\/WorldModule\/World"]]},"sections":[],"metadata":{"extendedModule":"WorldModule","modules":[{"name":"WorldModule"}],"remoteSource":{"url":"https:\/\/github.com\/Tyler-Keith-Thompson\/ECS\/blob\/main\/Sources\/WorldModule\/Removals.swift#L90","fileName":"Removals.swift"},"externalID":"s:11WorldModule0A0V7removed_2bySayAA6EntityVGxm_q_mtAA9ComponentRzr0_lF","role":"symbol","symbolKind":"method","roleHeading":"Instance Method","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"removed","kind":"identifier"},{"text":"<","kind":"text"},{"text":"C","kind":"genericParameter"},{"text":", ","kind":"text"},{"text":"Reader","kind":"genericParameter"},{"text":">(","kind":"text"},{"text":"C","kind":"typeIdentifier"},{"text":".Type, ","kind":"text"},{"text":"by","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"Reader","kind":"typeIdentifier"},{"text":".Type) -> [","kind":"text"},{"text":"Entity","preciseIdentifier":"s:11WorldModule6EntityV","kind":"typeIdentifier"},{"text":"]","kind":"text"}],"title":"rem