[{"type":"heading","level":2,"text":"Discussion","anchor":"discussion"},{"type":"paragraph","inlineContent":[{"text":"Use this method to clean up after components that are gone, such as removing an","type":"text"},{"text":" ","type":"text"},{"text":"entity’s health bar when it loses its ","type":"text"},{"code":"Health","type":"codeVoice"},{"text":". The first call for a type starts recording","type":"text"},{"text":" ","type":"text"},{"text":"its removals (","type":"text"},{"identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/World\/trackRemovals(of:)","isActive":true,"type":"reference"},{"text":"), so removals made before it aren’t reported. Each","type":"text"},{"text":" ","type":"text"},{"text":"reader type has its own place in the record, as with ","type":"text"},{"identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/World\/readEvents(_:by:)","isActive":true,"type":"reference"},{"text":".","type":"text"}]},{"type":"codeListing","syntax":"swift","code":["enum HealthbarReader {}","","var world = World()","_ = world.removed(Health.self, by: HealthbarReader.self)","","let knight = world.spawn(Health(current: 10))","let archer = world.spawn(Health(current: 6))","world.remove(Health.self, from: archer)","world.despawn(knight)","","let lost = world.removed(Health.self, by: HealthbarReader.self)","print(lost == [archer, knight])","\/\/ Prints \"true\""]},{"type":"paragraph","inlineContent":[{"text":"An entity appears once per removal: an entity whose ","type":"text"},{"code":"C","type":"codeVoice"},{"text":" is removed, inserted and removed","type":"text"},{"text":" ","type":"text"},{"text":"again appears twice.","type":"text"}]},{"type":"aside","name":"Complexity","style":"note","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"O("},{"type":"emphasis","inlineContent":[{"text":"r","type":"text"}]},{"type":"text","text":"), where "},{"type":"emphasis","inlineContent":[{"type":"text","text":"r"}]},{"type":"text","text":" is the num