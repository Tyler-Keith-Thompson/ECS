ints \"false\""],"type":"codeListing"},{"inlineContent":[{"type":"text","text":"Writing to a component the entity holds changes it in place and marks it changed at the"},{"type":"text","text":" "},{"type":"text","text":"current "},{"type":"reference","identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/World\/changeTick","isActive":true},{"type":"text","text":", as the plain subscript does. Inserting runs the component’s insert"},{"type":"text","text":" "},{"type":"text","text":"hooks and adds the components it requires, as "},{"type":"codeVoice","code":"insert(_:into:)"},{"type":"text","text":" does, and removing runs"},{"type":"text","text":" "},{"type":"text","text":"its remove hooks, as "},{"type":"codeVoice","code":"remove(_:from:)"},{"type":"text","text":" does."}],"type":"paragraph"},{"name":"Complexity","style":"note","type":"aside","content":[{"type":"paragraph","inlineContent":[{"text":"O(1), plus a copy of the storage of the component type on the first write","type":"text"},{"text":" ","type":"text"},{"text":"after the world was copied.","type":"text"}]}]},{"name":"Precondition","style":"note","type":"aside","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":""},{"type":"codeVoice","code":"entity"},{"type":"text","text":" is live."}]}]}]}],"identifier":{"url":"doc:\/\/WorldModule\/documentation\/WorldModule\/World\/subscript(_:of:)-o3kh","interfaceLanguage":"swift"},"hierarchy":{"paths":[["doc:\/\/WorldModule\/documentation\/WorldModule","doc:\/\/WorldModule\/documentation\/WorldModule\/World"]]},"kind":"symbol","sections":[],"abstract":[{"type":"text","text":"Accesses the component of the given type that an entity holds, or "},{"type":"codeVoice","code":"nil"},{"type":"text","text":" if it holds none."}],"references":{"doc://WorldModule/documentation/WorldModule/World/subscript(_:of:)-3avyw":{"fragments":[{"kind":"keyword","text":"subscript"},{"kind":"text","text":"<"},{"kind":"genericParameter","text":"C"},{"kind":"text","te