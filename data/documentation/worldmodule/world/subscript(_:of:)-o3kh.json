eListing","code":["var world = World()","let ship = world.spawn(Position(x: 0, y: 0))","","print(world[Velocity?.self, of: ship] == nil)","\/\/ Prints \"true\"","","world[Velocity?.self, of: ship] = Velocity(dx: 1, dy: 0)","world[Velocity?.self, of: ship]?.dx += 1","print(world[Velocity.self, of: ship].dx)","\/\/ Prints \"2.0\"","","world[Velocity?.self, of: ship] = nil","print(world.contains(Velocity.self, in: ship))","\/\/ Prints \"false\""],"syntax":"swift"},{"type":"paragraph","inlineContent":[{"text":"Writing to a component the entity holds changes it in place and marks it changed at the","type":"text"},{"text":" ","type":"text"},{"text":"current ","type":"text"},{"isActive":true,"identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/World\/changeTick","type":"reference"},{"text":", as the plain subscript does. Inserting runs the component’s insert","type":"text"},{"text":" ","type":"text"},{"text":"hooks and adds the components it requires, as ","type":"text"},{"code":"insert(_:into:)","type":"codeVoice"},{"text":" does, and removing runs","type":"text"},{"text":" ","type":"text"},{"text":"its remove hooks, as ","type":"text"},{"code":"remove(_:from:)","type":"codeVoice"},{"text":" does.","type":"text"}]},{"type":"aside","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"O(1), plus a copy of the storage of the component type on the first write"},{"type":"text","text":" "},{"type":"text","text":"after the world was copied."}]}],"name":"Complexity","style":"note"},{"type":"aside","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":""},{"type":"codeVoice","code":"entity"},{"type":"text","text":" is live."}]}],"name":"Precondition","style":"note"}]}],"schemaVersion":{"minor":3,"patch":0,"major":0},"references":{"doc://WorldModule/documentation/WorldModule":{"url":"\/documentation\/worldmodule","type":"topic","role":"collection","kind":"symbol","abstract":[{"type":"text","text":"Store the state of a game or simulation a