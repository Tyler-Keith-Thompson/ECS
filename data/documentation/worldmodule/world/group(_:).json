{"seeAlsoSections":[{"identifiers":["doc:\/\/WorldModule\/documentation\/WorldModule\/World\/group(checked:)","doc:\/\/WorldModule\/documentation\/WorldModule\/World\/cache(_:)","doc:\/\/WorldModule\/documentation\/WorldModule\/World\/index(_:)-u1gw","doc:\/\/WorldModule\/documentation\/WorldModule\/World\/index(_:)-2gtfg","doc:\/\/WorldModule\/documentation\/WorldModule\/World\/lookup(_:)","doc:\/\/WorldModule\/documentation\/WorldModule\/World\/lookup(_:equals:)","doc:\/\/WorldModule\/documentation\/WorldModule\/World\/index(ordered:)","doc:\/\/WorldModule\/documentation\/WorldModule\/World\/lookup(_:in:)","doc:\/\/WorldModule\/documentation\/WorldModule\/World\/entities(sortedBy:)"],"title":"Speeding Up Queries","anchor":"Speeding-Up-Queries","generated":true}],"abstract":[{"type":"text","text":"Keeps the given component types packed in the same order, so that queries and updates of"},{"type":"text","text":" "},{"type":"text","text":"exactly these types visit their entities without lookups."}],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/WorldModule\/documentation\/WorldModule\/World\/group(_:)"},"hierarchy":{"paths":[["doc:\/\/WorldModule\/documentation\/WorldModule","doc:\/\/WorldModule\/documentation\/WorldModule\/World"]]},"variants":[{"paths":["\/documentation\/worldmodule\/world\/group(_:)"],"traits":[{"interfaceLanguage":"swift"}]}],"metadata":{"fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"group"},{"kind":"text","text":"<each "},{"kind":"genericParameter","text":"C"},{"kind":"text","text":">(repeat (each "},{"kind":"typeIdentifier","text":"C"},{"kind":"text","text":").Type)"}],"roleHeading":"Instance Method","role":"symbol","title":"group(_:)","extendedModule":"WorldModule","remoteSource":{"fileName":"Group.swift","url":"https:\/\/github.com\/Tyler-Keith-Thompson\/ECS\/blob\/main\/Sources\/WorldModule\/Group.swift#L70"},"symbolKind":"method","externalID":"s:11WorldModule0A0V5groupyyxmxQpRvzAA9ComponentRzlF","modules":[{"name":"WorldModule"}]},"primaryContentSections":[{"kind":"declarations","declarations":[{"languages":["swift"],"tokens":[{"kind":"keyword","text":"mutating"},{"kind":"text","text":" "},{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"group"},{"kind":"text","text":"<each "},{"kind":"genericParameter","text":"C"},{"kind":"text","text":">("},{"kind":"externalParam","text":"_"},{"kind":"text","text":" "},{"kind":"internalParam","text":"types"},{"kind":"text","text":": repeat (each "},{"kind":"typeIdentifier","text":"C"},{"kind":"text","text":").Type) "},{"kind":"keyword","text":"where"},{"kind":"text","text":" repeat each "},{"kind":"typeIdentifier","text":"C"},{"kind":"text","text":" : "},{"kind":"typeIdentifier","text":"Component","identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/Component","preciseIdentifier":"s:11WorldModule9ComponentP"}],"platforms":["Linux"]}]},{"kind":"parameters","parameters":[{"name":"types","content":[{"type":"paragraph","inlineContent":[{"text":"The component types to keep packed together.","type":"text"}]}]}]},{"content":[{"type":"heading","anchor":"discussion","level":2,"text":"Discussion"},{"type":"paragraph","inlineContent":[{"text":"A query of several types normally walks one type’s storage and looks up the entity in each","type":"text"},{"text":" ","type":"text"},{"text":"of the others. After you group the types, the entities that hold all of them sit at the","type":"text"},{"text":" ","type":"text"},{"text":"front of each type’s storage, at the same positions, and spawning, inserting, removing and","type":"text"},{"text":" ","type":"text"},{"text":"despawning keep them there. A query of the same types in any order, or an update that","type":"text"},{"text":" ","type":"text"},{"text":"writes and reads exactly those types, walks that front directly.","type":"text"}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Use a group for a set of types you visit together on every step, such as position and"},{"type":"text","text":" "},{"type":"text","text":"velocity:"}]},{"type":"codeListing","syntax":"swift","code":["var world = World()","let comet = world.spawn(Position(x: 0, y: 0), Velocity(dx: 1, dy: 2))","world.spawn(Position(x: 9, y: 9))","world.group(Position.self, Velocity.self)","","world.update(Position.self, reading: Velocity.self) { position, row in","    position.x += row.components.dx","    position.y += row.components.dy","}","print(world[Position.self, of: comet])","\/\/ Prints \"Position(x: 1.0, y: 2.0)\""]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Grouping doesn’t change which entities a query or update visits, only how it finds them."},{"type":"text","text":" "},{"type":"text","text":"It does change the order queries list entities in, and makes adding and removing the"},{"type":"text","text":" "},{"type":"text","text":"grouped types a little slower. Each type belongs to at most one group. A copy of the world"},{"type":"text","text":" "},{"type":"text","text":"keeps the group; a snapshot doesn’t."}]},{"type":"aside","style":"note","name":"Complexity","content":[{"inlineContent":[{"type":"text","text":"O("},{"inlineContent":[{"text":"n","type":"text"}],"type":"emphasis"},{"type":"text","text":"·"},{"inlineContent":[{"type":"text","text":"t"}],"type":"emphasis"},{"type":"text","text":") for "},{"inlineContent":[{"text":"n","type":"text"}],"type":"emphasis"},{"type":"text","text":" entities in the smallest of the "},{"inlineContent":[{"text":"t","type":"text"}],"type":"emphasis"},{"type":"text","text":" types."}],"type":"paragraph"}]},{"type":"aside","style":"note","name":"Precondition","content":[{"type":"paragraph","inlineContent":[{"text":"","type":"text"},{"code":"types","type":"codeVoice"},{"text":" lists at least two distinct types, and no other group owns any of","type":"text"},{"text":" ","type":"text"},{"text":"them. The checked spelling, ","type":"text"},{"isActive":true,"identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/World\/group(checked:)","type":"reference"},{"text":", throws instead.","type":"text"}]}]}],"kind":"content"}],"sections":[],"schemaVersion":{"patch":0,"major":0,"minor":3},"kind":"symbol","references":{"doc://WorldModule/documentation/WorldModule/World/lookup(_:equals:)":{"role":"symbol","abstract":[{"text":"Returns the entities holding a component whose property at a key path equals the given","type":"text"},{"text":" ","type":"text"},{"text":"value.","type":"text"}],"type":"topic","identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/World\/lookup(_:equals:)","url":"\/documentation\/worldmodule\/world\/lookup(_:equals:)","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"lookup"},{"kind":"text","text":"<"},{"text":"C","kind":"genericParameter"},{"text":", ","kind":"text"},{"text":"Key","kind":"genericParameter"},{"text":">(any ","kind":"text"},{"preciseIdentifier":"s:s7KeyPathC","text":"KeyPath","kind":"typeIdentifier"},{"text":"<","kind":"text"},{"text":"C","kind":"typeIdentifier"},{"kind":"text","text":", "},{"kind":"typeIdentifier","text":"Key"},{"kind":"text","text":"> & "},{"kind":"typeIdentifier","preciseIdentifier":"s:s8SendableP","text":"Sendable"},{"kind":"text","text":", "},{"kind":"externalParam","text":"equals"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"Key"},{"kind":"text","text":") -> ["},{"kind":"typeIdentifier","preciseIdentifier":"s:11WorldModule6EntityV","text":"Entity"},{"kind":"text","text":"]"}],"kind":"symbol","title":"lookup(_:equals:)"},"doc://WorldModule/documentation/WorldModule/World/cache(_:)":{"role":"symbol","type":"topic","abstract":[{"type":"text","text":"Keeps a list of the entities that match a query’s structure, so that queries and updates"},{"type":"text","text":" "},{"type":"text","text":"with the same conditions visit only those entities."}],"identifier":"doc:\/\/WorldModule\/docume