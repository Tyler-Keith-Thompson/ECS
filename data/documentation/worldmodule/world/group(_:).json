{"schemaVersion":{"patch":0,"minor":3,"major":0},"hierarchy":{"paths":[["doc:\/\/WorldModule\/documentation\/WorldModule","doc:\/\/WorldModule\/documentation\/WorldModule\/World"]]},"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/worldmodule\/world\/group(_:)"]}],"metadata":{"role":"symbol","roleHeading":"Instance Method","title":"group(_:)","externalID":"s:11WorldModule0A0V5groupyyxmxQpRvzAA9ComponentRzlF","symbolKind":"method","extendedModule":"WorldModule","remoteSource":{"fileName":"Group.swift","url":"https:\/\/github.com\/Tyler-Keith-Thompson\/ECS\/blob\/main\/Sources\/WorldModule\/Group.swift#L70"},"fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"group","kind":"identifier"},{"text":"<each ","kind":"text"},{"text":"C","kind":"genericParameter"},{"text":">(repeat (each ","kind":"text"},{"text":"C","kind":"typeIdentifier"},{"text":").Type)","kind":"text"}],"modules":[{"name":"WorldModule"}]},"sections":[],"kind":"symbol","seeAlsoSections":[{"identifiers":["doc:\/\/WorldModule\/documentation\/WorldModule\/World\/group(checked:)","doc:\/\/WorldModule\/documentation\/WorldModule\/World\/cache(_:)","doc:\/\/WorldModule\/documentation\/WorldModule\/World\/index(_:)-u1gw","doc:\/\/WorldModule\/documentation\/WorldModule\/World\/index(_:)-2gtfg","doc:\/\/WorldModule\/documentation\/WorldModule\/World\/lookup(_:)","doc:\/\/WorldModule\/documentation\/WorldModule\/World\/lookup(_:equals:)","doc:\/\/WorldModule\/documentation\/WorldModule\/World\/index(ordered:)","doc:\/\/WorldModule\/documentation\/WorldModule\/World\/lookup(_:in:)","doc:\/\/WorldModule\/documentation\/WorldModule\/World\/entities(sortedBy:)"],"title":"Speeding Up Queries","generated":true,"anchor":"Speeding-Up-Queries"}],"identifier":{"url":"doc:\/\/WorldModule\/documentation\/WorldModule\/World\/group(_:)","interfaceLanguage":"swift"},"abstract":[{"type":"text","text":"Keeps the given component types packed in the same order, so that queries and updates of"},{"type":"text","text":" "},{"type":"text","text":"exactly these types visit their entities without lookups."}],"primaryContentSections":[{"declarations":[{"languages":["swift"],"tokens":[{"text":"mutating","kind":"keyword"},{"text":" ","kind":"text"},{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"group","kind":"identifier"},{"text":"<each ","kind":"text"},{"text":"C","kind":"genericParameter"},{"text":">(","kind":"text"},{"text":"_","kind":"externalParam"},{"text":" ","kind":"text"},{"text":"types","kind":"internalParam"},{"text":": repeat (each ","kind":"text"},{"text":"C","kind":"typeIdentifier"},{"text":").Type) ","kind":"text"},{"text":"where","kind":"keyword"},{"text":" repeat each ","kind":"text"},{"text":"C","kind":"typeIdentifier"},{"text":" : ","kind":"text"},{"identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/Component","text":"Component","kind":"typeIdentifier","preciseIdentifier":"s:11WorldModule9ComponentP"}],"platforms":["Linux"]}],"kind":"declarations"},{"parameters":[{"name":"types","content":[{"type":"paragraph","inlineContent":[{"text":"The component types to keep packed together.","type":"text"}]}]}],"kind":"parameters"},{"kind":"content","content":[{"type":"heading","text":"Discussion","anchor":"discussion","level":2},{"type":"paragraph","inlineContent":[{"text":"A query of several types normally walks one type’s storage and looks up the entity in each","type":"text"},{"text":" ","type":"text"},{"text":"of the others. After you group the types, the entities that hold all of them sit at the","type":"text"},{"text":" ","type":"text"},{"text":"front of each type’s storage, at the same positions, and spawning, inserting, removing and","type":"text"},{"text":" ","type":"text"},{"text":"despawning keep them there. A query of the same types in any order, or an update that","type":"text"},{"text":" ","type":"text"},{"text":"writes and reads exactly those types, walks that front directly.","type":"text"}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Use a group for a set of types you visit together on every step, such as position and"},{"type":"text","text":" "},{"type":"text","text":"velocity:"}]},{"type":"codeListing","syntax":"swift","code":["var world = World()","let comet = world.spawn(Position(x: 0, y: 0), Velocity(dx: 1, dy: 2))","world.spawn(Position(x: 9, y: 9))","world.group(Position.self, Velocity.self)","","world.update(Position.self, reading: Velocity.self) { position, row in","    position.x += row.components.dx","    position.y += row.components.dy","}","print(world[Position.self, of: comet])","\/\/ Prints \"Position(x: 1.0, y: 2.0)\""]},{"type":"paragraph","inlineContent":[{"text":"Grouping doesn’t change which entities a query or update visits, only how it finds them.","type":"text"},{"text":" ","type":"text"},{"text":"It does change the order queries list entities in, and makes adding and removing the","type":"text"},{"text":" ","type":"text"},{"text":"grouped types a little slower. Each type belongs to at most one group. A copy of the world","type":"text"},{"text":" ","type":"text"},{"text":"keeps the group; a snapshot doesn’t.","type":"text"}]},{"type":"aside","style":"note","name":"Complexity","content":[{"type":"paragraph","inlineContent":[{"text":"O(","type":"text"},{"type":"emphasis","inlineContent":[{"text":"n","type":"text"}]},{"text":"·","type":"text"},{"type":"emphasis","inlineContent":[{"type":"text","text":"t"}]},{"text":") for ","type":"text"},{"type":"emphasis","inlineContent":[{"type":"text","text":"n"}]},{"text":" entities in the smallest of the ","type":"text"},{"type":"emphasis","inlineContent":[{"type":"text","text":"t"}]},{"text":" types.","type":"text"}]}]},{"type":"aside","style":"note","name":"Precondition","content":[{"inlineContent":[{"type":"text","text":""},{"type":"codeVoice","code":"types"},{"type":"text","text":" lists at least two distinct types, and no other group owns any of"},{"type":"text","text":" "},{"type":"text","text":"them. The checked spelling, "},{"isActive":true,"type":"reference","identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/World\/group(checked:)"},{"type":"text","text":", throws instead."}],"type":"paragraph"}]}]}],"references":{"doc://WorldModule/documentation/WorldModule/World/lookup(_:equals:)":{"title":"lookup(_:equals:)","identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/World\/lookup(_:equals:)","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"lookup"},{"kind":"text","text":"<"},{"text":"C","kind":"genericParameter"},{"text":", ","kind":"text"},{"text":"Key","kind":"genericParameter"},{"text":">(any ","kind":"text"},{"text":"KeyPath","preciseIdentifier":"s:s7KeyPathC","kind":"typeIdentifier"},{"text":"<","kind":"text"},{"text":"C","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"Key","kind":"typeIdentifier"},{"text":"> & ","kind":"text"},{"text":"Sendable","kind":"typeIdentifier","preciseIdentifier":"s:s8SendableP"},{"text":", ","kind":"text"},{"text":"equals","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"Key","kind":"typeIdentifier"},{"text":") -> [","kind":"text"},{"preciseIdentifier":"s:11WorldModule6EntityV","text":"Entity","kind":"typeIdentifier"},{"text":"]","kind":"text"}],"type":"topic","kind":"symbol","abstract":[{"type":"text","text":"Returns the entities holding a component whose property at a key path equals the given"},{"type":"text","text":" "},{"type":"text","text":"value."}],"url":"\/documentation\/worldmodule\/world\/lookup(_:equals:)","role":"symbol"},"doc://WorldModule/documentation/WorldModule/World/index(_:)-2gtfg":{"fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"index","kind":"identifier"},{"kind":"text","text":"<"},{"kind":"genericParameter","text":"C"},{"kind":"text","text":", "},{"kind":"genericParameter","text":"Key"},{"kind":"text","text":">(any "},{"kind":"typeIdentif