{"sections":[],"metadata":{"symbolKind":"method","remoteSource":{"fileName":"Group.swift","url":"https:\/\/github.com\/Tyler-Keith-Thompson\/ECS\/blob\/main\/Sources\/WorldModule\/Group.swift#L70"},"roleHeading":"Instance Method","externalID":"s:11WorldModule0A0V5groupyyxmxQpRvzAA9ComponentRzlF","modules":[{"name":"WorldModule"}],"title":"group(_:)","role":"symbol","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"group"},{"kind":"text","text":"<each "},{"kind":"genericParameter","text":"C"},{"kind":"text","text":">(repeat (each "},{"kind":"typeIdentifier","text":"C"},{"kind":"text","text":").Type)"}],"extendedModule":"WorldModule"},"seeAlsoSections":[{"title":"Speeding Up Queries","generated":true,"identifiers":["doc:\/\/WorldModule\/documentation\/WorldModule\/World\/group(checked:)","doc:\/\/WorldModule\/documentation\/WorldModule\/World\/cache(_:)","doc:\/\/WorldModule\/documentation\/WorldModule\/World\/index(_:)","doc:\/\/WorldModule\/documentation\/WorldModule\/World\/lookup(_:)"],"anchor":"Speeding-Up-Queries"}],"primaryContentSections":[{"kind":"declarations","declarations":[{"platforms":["Linux"],"languages":["swift"],"tokens":[{"kind":"keyword","text":"mutating"},{"kind":"text","text":" "},{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"group"},{"kind":"text","text":"<each "},{"kind":"genericParameter","text":"C"},{"kind":"text","text":">("},{"kind":"externalParam","text":"_"},{"kind":"text","text":" "},{"kind":"internalParam","text":"types"},{"kind":"text","text":": repeat (each "},{"kind":"typeIdentifier","text":"C"},{"kind":"text","text":").Type) "},{"kind":"keyword","text":"where"},{"kind":"text","text":" repeat each "},{"kind":"typeIdentifier","text":"C"},{"kind":"text","text":" : "},{"preciseIdentifier":"s:11WorldModule9ComponentP","kind":"typeIdentifier","text":"Component","identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/Component"}]}]},{"parameters":[{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The component types to keep packed together."}]}],"name":"types"}],"kind":"parameters"},{"kind":"content","content":[{"type":"heading","text":"Discussion","level":2,"anchor":"discussion"},{"inlineContent":[{"text":"A query of several types normally walks one type’s storage and looks up the entity in each","type":"text"},{"text":" ","type":"text"},{"text":"of the others. After you group the types, the entities that hold all of them sit at the","type":"text"},{"text":" ","type":"text"},{"text":"front of each type’s storage, at the same positions, and spawning, inserting, removing and","type":"text"},{"text":" ","type":"text"},{"text":"despawning keep them there. A query of the same types in any order, or an update that","type":"text"},{"text":" ","type":"text"},{"text":"writes and reads exactly those types, walks that front directly.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"Use a group for a set of types you visit together on every step, such as position and","type":"text"},{"text":" ","type":"text"},{"text":"velocity:","type":"text"}],"type":"paragraph"},{"syntax":"swift","type":"codeListing","code":["var world = World()","let comet = world.spawn(Position(x: 0, y: 0), Velocity(dx: 1, dy: 2))","world.spawn(Position(x: 9, y: 9))","world.group(Position.self, Velocity.self)","","world.update(Position.self, reading: Velocity.self) { position, row in","    position.x += row.components.dx","    position.y += row.components.dy","}","print(world[Position.self, of: comet])","\/\/ Prints \"Position(x: 1.0, y: 2.0)\""]},{"inlineContent":[{"type":"text","text":"Grouping doesn’t change which entities a query or update visits, only how it finds them."},{"type":"text","text":" "},{"type":"text","text":"It does change the order queries list entities in, and makes adding and removing the"},{"type":"text","text":" "},{"type":"text","text":"grouped types a little slower. Each type belongs to at most one group. A copy of the world"},{"type":"text","text":" "},{"type":"text","text":"keeps the group; a snapshot doesn’t."}],"type":"paragraph"},{"style":"note","content":[{"inlineContent":[{"text":"O(","type":"text"},{"inlineContent":[{"text":"n","type":"text"}],"type":"emphasis"},{"text":"·","type":"text"},{"inlineContent":[{"type":"text","text":"t"}],"type":"emphasis"},{"text":") for ","type":"text"},{"inlineContent":[{"text":"n","type":"text"}],"type":"emphasis"},{"text":" entities in the smallest of the ","type":"text"},{"inlineContent":[{"type":"text","text":"t"}],"type":"emphasis"},{"text":" types.","type":"text"}],"type":"paragraph"}],"type":"aside","name":"Complexity"},{"style":"note","content":[{"inlineContent":[{"text":"","type":"text"},{"type":"codeVoice","code":"types"},{"text":" lists at least two distinct types, and no other group owns any of","type":"text"},{"text":" ","type":"text"},{"text":"them. The checked spelling, ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/World\/group(checked:)"},{"text":", throws instead.","type":"text"}],"type":"paragraph"}],"type":"aside","name":"Precondition"}]}],"variants":[{"paths":["\/documentation\/worldmodule\/world\/group(_:)"],"traits":[{"interfaceLanguage":"swift"}]}],"schemaVersion":{"minor":3,"major":0,"patch":0},"hierarchy":{"paths":[["doc:\/\/WorldModule\/documentation\/WorldModule","doc:\/\/WorldModule\/documentation\/WorldModule\/World"]]},"abstract":[{"type":"text","text":"Keeps the given component types packed in the same order, so that queries and updates of"},{"type":"text","text":" "},{"type":"text","text":"exactly these types visit their entities without lookups."}],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/WorldModule\/documentation\/WorldModule\/World\/group(_:)"},"kind":"symbol","references":{"doc://WorldModule/documentation/WorldModule/World":{"kind":"symbol","type":"topic","role":"symbol","title":"World","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"World"}],"url":"\/documentation\/worldmodule\/world","identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/World","navigatorTitle":[{"kind":"identifier","text":"World"}],"abstract":[{"type":"text","text":"A collection of entities, the components they hold, and resources."}]},"doc://WorldModule/documentation/WorldModule/World/lookup(_:)":{"identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/World\/lookup(_:)","role":"symbol","url":"\/documentation\/worldmodule\/world\/lookup(_:)","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"lookup"},{"kind":"text","text":"<"},{"kind":"genericParameter","text":"C"},{"kind":"text","text":">("},{"text":"C","kind":"typeIdentifier"},{"text":") -> [","kind":"text"},{"text":"Entity","kind":"typeIdentifier","preciseIdentifier":"s:11WorldModule6EntityV"},{"text":"]","kind":"text"}],"type":"topic","title":"lookup(_:)","kind":"symbol","abstract":[{"type":"text","text":"Returns the entities holding a component equal to the given value."}]},"doc://WorldModule/documentation/WorldModule/World/index(_:)":{"abstract":[{"type":"text","text":"Keeps a map from each value of a component type to the entities holding it, so that"},{"type":"text","text":" "},{"isActive":true,"type":"reference","identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/World\/lookup(_:)"},{"type":"text","text":" finds them without walking the type’s storage."}],"role":"symbol","url":"\/documentation\/worldmodule\/world\/index(_:)","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"index","kind":"identifier"},{"text":"<","kind":"text"},{"text":"C","kind":"genericParameter"},{"text":">(","kind":"text"},{"text":"C","kind":"typeIdentifier"},{"text":".Type)","kind":"text"}],"type":"topic","title":"index(_:)","kind":"symbol","identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/World\/index(_:)"},"doc://WorldModule/documentation/WorldModule":{"role":"collection","url":"\/documentation\/worldmodule","abstract":[{"text":"Store the state of a game or simulation as entities and components, and read and change it with","type":"text"},{"text":" ","type":"text"},{"text":"queries, updates, and commands.","type":"text"}],"identifier":"doc:\/\/WorldModule\/documentation\/WorldModule","title":"WorldModule","type":"topic","kind":"symbol"},"doc://WorldModule/documentation/WorldModule/Component":{"role":"symbol","url":"\/documentation\/worldmodule\/component","abstract":[{"text":"A type that can be stored as a component of an entity.","type":"text"}],"navigatorTitle":[{"kind":"identifier","text":"Component"}],"title":"Component","identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/Component","type":"topic","kind":"symbol","fragments":[{"kind":"keyword","text":"protocol"},{"kind":"text","text":" "},{"kind":"identifier","text":"Component"}]},"doc://WorldModule/documentation/WorldModule/World/cache(_:)":{"type":"topic","kind":"symbol","role":"symbol","title":"cache(_:)","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"cache","kind":"identifier"},{"text":"<each ","kind":"text"},{"text":"T","kind":"genericParameter"},{"text":">(","kind":"text"},{"text":"Query","kind":"typeIdentifier","preciseIdentifier":"s:11WorldModule5QueryV"},{"text":"<repeat each ","kind":"text"},{"text":"T","kind":"typeIdentifier"},{"text":">)","kind":"text"}],"url":"\/documentation\/worldmodule\/world\/cache(_:)","identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/World\/cache(_:)","abstract":[{"text":"Keeps a list of the entities that match a query’s structure, so that queries and updates","type":"text"},{"text":" ","type":"text"},{"text":"with the same conditions visit only those entities.","type":"text"}]},"doc://WorldModule/documentation/WorldModule/World/group(checked:)":{"type":"topic","kind":"symbol","role":"symbol","title":"group(checked:)","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"group","kind":"identifier"},{"text":"<each ","kind":"text"},{"kind":"genericParameter","text":"C"},{"kind":"text","text":">("},{"kind":"externalParam","text":"checked"},{"kind":"text","text":": repeat (each "},{"kind":"typeIdentifier","text":"C"},{"kind":"text","text":").Type) "},{"kind":"keyword","text":"throws"},{"text":"(","kind":"text"},{"text":"GroupError","kind":"typeIdentifier","preciseIdentifier":"s:11WorldModule10GroupErrorO"},{"text":")","kind":"text"}],"url":"\/documentation\/worldmodule\/world\/group(checked:)","identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/World\/group(checked:)","abstract":[{"text":"Keeps the given component types packed in the same order, throwing an error if they can’t","type":"text"},{"text":" ","type":"text"},{"text":"be grouped.","type":"text"}]},"doc://WorldModule/documentation/WorldModule/World/group(_:)":{"kind":"symbol","abstract":[{"text":"Keeps the given component types packed in the same order, so that queries and updates of","type":"text"},{"text":" ","type":"text"},{"text":"exactly these types visit their entities without lookups.","type":"text"}],"identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/World\/group(_:)","url":"\/documentation\/worldmodule\/world\/group(_:)","type":"topic","title":"group(_:)","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"group"},{"kind":"text","text":"<each "},{"text":"C","kind":"genericParameter"},{"text":">(repeat (each ","kind":"text"},{"text":"C","kind":"typeIdentifier"},{"text":").Type)","kind":"text"}],"role":"symbol"}}}