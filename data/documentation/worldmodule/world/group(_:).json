{"kind":"symbol","schemaVersion":{"patch":0,"major":0,"minor":3},"identifier":{"url":"doc:\/\/WorldModule\/documentation\/WorldModule\/World\/group(_:)","interfaceLanguage":"swift"},"abstract":[{"text":"Keeps the given component types packed in the same order, so that queries and updates of","type":"text"},{"text":" ","type":"text"},{"text":"exactly these types visit their entities without lookups.","type":"text"}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/worldmodule\/world\/group(_:)"]}],"seeAlsoSections":[{"anchor":"Speeding-Up-Queries","title":"Speeding Up Queries","identifiers":["doc:\/\/WorldModule\/documentation\/WorldModule\/World\/group(checked:)","doc:\/\/WorldModule\/documentation\/WorldModule\/World\/cache(_:)","doc:\/\/WorldModule\/documentation\/WorldModule\/World\/index(_:)","doc:\/\/WorldModule\/documentation\/WorldModule\/World\/lookup(_:)"],"generated":true}],"primaryContentSections":[{"kind":"declarations","declarations":[{"tokens":[{"kind":"keyword","text":"mutating"},{"kind":"text","text":" "},{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"group"},{"kind":"text","text":"<each "},{"kind":"genericParameter","text":"C"},{"kind":"text","text":">("},{"kind":"externalParam","text":"_"},{"kind":"text","text":" "},{"kind":"internalParam","text":"types"},{"kind":"text","text":": repeat (each "},{"kind":"typeIdentifier","text":"C"},{"kind":"text","text":").Type) "},{"kind":"keyword","text":"where"},{"kind":"text","text":" repeat each "},{"kind":"typeIdentifier","text":"C"},{"kind":"text","text":" : "},{"identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/Component","kind":"typeIdentifier","text":"Component","preciseIdentifier":"s:11WorldModule9ComponentP"}],"platforms":["Linux"],"languages":["swift"]}]},{"kind":"parameters","parameters":[{"name":"types","content":[{"inlineContent":[{"text":"The component types to keep packed together.","type":"text"}],"type":"paragraph"}]}]},{"kind":"content","content":[{"type":"heading","level":2,"anchor":"discussion","text":"Discussion"},{"type":"paragraph","inlineContent":[{"text":"A query of several types normally walks one type’s storage and looks up the entity in each","type":"text"},{"text":" ","type":"text"},{"text":"of the others. After you group the types, the entities that hold all of them sit at the","type":"text"},{"text":" ","type":"text"},{"text":"front of each type’s storage, at the same positions, and spawning, inserting, removing and","type":"text"},{"text":" ","type":"text"},{"text":"despawning keep them there. A query of the same types in any order, or an update that","type":"text"},{"text":" ","type":"text"},{"text":"writes and reads exactly those types, walks that front directly.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"Use a group for a set of types you visit together on every step, such as position and","type":"text"},{"text":" ","type":"text"},{"text":"velocity:","type":"text"}]},{"type":"codeListing","code":["var world = World()","let comet = world.spawn(Position(x: 0, y: 0), Velocity(dx: 1, dy: 2))","world.spawn(Position(x: 9, y: 9))","world.group(Position.self, Velocity.self)","","world.update(Position.self, reading: Velocity.self) { position, row in","    position.x += row.components.dx","    position.y += row.components.dy","}","print(world[Position.self, of: comet])","\/\/ Prints \"Position(x: 1.0, y: 2.0)\""],"syntax":"swift"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Grouping doesn’t change which entities a query or update visits, only how it finds them."},{"type":"text","text":" "},{"type":"text","text":"It does change the order queries list entities in, and makes adding and removing the"},{"type":"text","text":" "},{"type":"text","text":"grouped types a little slower. Each type belongs to at most one group. A copy of the world"},{"type":"text","text":" "},{"type":"text","text":"keeps the group; a snapshot doesn’t."}]},{"type":"aside","name":"Complexity","style":"note","content":[{"type":"paragraph","inlineContent":[{"text":"O(","type":"text"},{"inlineContent":[{"text":"n","type":"text"}],"type":"emphasis"},{"text":"·","type":"text"},{"inlineContent":[{"type":"text","text":"t"}],"type":"emphasis"},{"text":") for ","type":"text"},{"inlineContent":[{"type":"text","text":"n"}],"type":"emphasis"},{"text":" entities in the smallest of the ","type":"text"},{"inlineContent":[{"type":"text","text":"t"}],"type":"emphasis"},{"text":" types.","type":"text"}]}]},{"type":"aside","name":"Precondition","style":"note","content":[{"type":"paragraph","inlineContent":[{"text":"","type":"text"},{"type":"codeVoice","code":"types"},{"text":" lists at least two distinct types, and no other group owns any of","type":"text"},{"text":" ","type":"text"},{"text":"them. The checked spelling, ","type":"text"},{"type":"reference","identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/World\/group(checked:)","isActive":true},{"text":", throws instead.","type":"text"}]}]}]}],"metadata":{"roleHeading":"Instance Method","remoteSource":{"url":"https:\/\/github.com\/Tyler-Keith-Thompson\/ECS\/blob\/main\/Sources\/WorldModule\/Group.swift#L70","fileName":"Group.swift"},"symbolKind":"method","externalID":"s:11WorldModule0A0V5groupyyxmxQpRvzAA9ComponentRzlF","role":"symbol","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"group","kind":"identifier"},{"text":"<each ","kind":"text"},{"text":"C","kind":"genericParameter"},{"text":">(repeat (each ","kind":"text"},{"text":"C","kind":"typeIdentifier"},{"text":").Type)","kind":"text"}],"extendedModule":"WorldModule","title":"group(_:)","modules":[{"name":"WorldModule"}]},"sections":[],"hierarchy":{"paths":[["doc:\/\/WorldModule\/documentation\/WorldModule","doc:\/\/WorldModule\/documentation\/WorldModule\/World"]]},"references":{"doc://WorldModule/documentation/WorldModule/World":{"url":"\/documentation\/worldmodule\/world","identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/World","navigatorTitle":[{"text":"World","kind":"identifier"}],"role":"symbol","title":"World","abstract":[{"type":"text","text":"A collection of entities, the components they hold, and resources."}],"kind":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"World","kind":"identifier"}],"type":"topic"},"doc://WorldModule/documentation/WorldModule/World/index(_:)":{"identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/World\/index(_:)","type":"topic","kind":"symbol","title":"index(_:)","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"index","kind":"identifier"},{"text":"<","kind":"text"},{"text":"C","kind":"genericParameter"},{"text":">(","kind":"text"},{"text":"C","kind":"typeIdentifier"},{"text":".Type)","kind":"text"}],"role":"symbol","url":"\/documentation\/worldmodule\/world\/index(_:)","abstract":[{"text":"Keeps a map from each value of a component type to the entities holding it, so that","type":"text"},{"text":" ","type":"text"},{"identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/World\/lookup(_:)","isActive":true,"type":"reference"},{"text":" finds them without walking the type’s storage.","type":"text"}]},"doc://WorldModule/documentation/WorldModule/World/cache(_:)":{"identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/World\/cache(_:)","kind":"symbol","type":"topic","title":"cache(_:)","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"cache","kind":"identifier"},{"text":"<each ","kind":"text"},{"text":"T","kind":"genericParameter"},{"text":">(","kind":"text"},{"preciseIdentifier":"s:11WorldModule5QueryV","text":"Query","kind":"typeIdentifier"},{"text":"<repeat each ","kind":"text"},{"text":"T","kind":"typeIdentifier"},{"text":">)","kind":"text"}],"role":"symbol","url":"\/documentation\/worldmodule\/world\/cache(_:)","abstract":[{"type":"text","text":"Keeps a list of the entities that match a query’s structure, so that queries and updates"},{"type":"text","text":" "},{"type":"text","text":"with the same conditions visit only those entities."}]},"doc://WorldModule/documentation/WorldModule/World/lookup(_:)":{"fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"lookup","kind":"identifier"},{"text":"<","kind":"text"},{"text":"C","kind":"genericParameter"},{"text":">(","kind":"text"},{"text":"C","kind":"typeIdentifier"},{"text":") -> [","kind":"text"},{"text":"Entity","kind":"typeIdentifier","preciseIdentifier":"s:11WorldModule6EntityV"},{"text":"]","kind":"text"}],"title":"lookup(_:)","abstract":[{"type":"text","text":"Returns the entities holding a component equal to the given value."}],"url":"\/documentation\/worldmodule\/world\/lookup(_:)","kind":"symbol","role":"symbol","type":"topic","identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/World\/lookup(_:)"},"doc://WorldModule/documentation/WorldModule/World/group(checked:)":{"identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/World\/group(checked:)","kind":"symbol","type":"topic","title":"group(checked:)","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"group"},{"kind":"text","text":"<each "},{"text":"C","kind":"genericParameter"},{"text":">(","kind":"text"},{"text":"checked","kind":"externalParam"},{"text":": repeat (each ","kind":"text"},{"text":"C","kind":"typeIdentifier"},{"text":").Type) ","kind":"text"},{"text":"throws","kind":"keyword"},{"text":"(","kind":"text"},{"text":"GroupError","kind":"typeIdentifier","preciseIdentifier":"s:11WorldModule10GroupErrorO"},{"text":")","kind":"text"}],"role":"symbol","url":"\/documentation\/worldmodule\/world\/group(checked:)","abstract":[{"text":"Keeps the given component types packed in the same order, throwing an error if they can’t","type":"text"},{"text":" ","type":"text"},{"text":"be grouped.","type":"text"}]},"doc://WorldModule/documentation/WorldModule/World/group(_:)":{"fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"group","kind":"identifier"},{"text":"<each ","kind":"text"},{"kind":"genericParameter","text":"C"},{"kind":"text","text":">(repeat (each "},{"kind":"typeIdentifier","text":"C"},{"kind":"text","text":").Type)"}],"url":"\/documentation\/worldmodule\/world\/group(_:)","identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/World\/group(_:)","role":"symbol","title":"group(_:)","type":"topic","abstract":[{"type":"text","text":"Keeps the given component types packed in the same order, so that queries and updates of"},{"type":"text","text":" "},{"type":"text","text":"exactly these types visit their entities without lookups."}],"kind":"symbol"},"doc://WorldModule/documentation/WorldModule":{"abstract":[{"text":"Store the state of a game or simulation as entities and components, and read and change it with","type":"text"},{"text":" ","type":"text"},{"text":"queries, updates, and commands.","type":"text"}],"type":"topic","title":"WorldModule","url":"\/documentation\/worldmodule","kind":"symbol","role":"collection","identifier":"doc:\/\/WorldModule\/documentation\/WorldModule"},"doc://WorldModule/documentation/WorldModule/Component":{"url":"\/documentation\/worldmodule\/component","identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/Component","navigatorTitle":[{"kind":"identifier","text":"Component"}],"role":"symbol","title":"Component","abstract":[{"text":"A type that can be stored as a component of an entity.","type":"text"}],"kind":"symbol","fragments":[{"kind":"keyword","text":"protocol"},{"kind":"text","text":" "},{"kind":"identifier","text":"Component"}],"type":"topic"}}}