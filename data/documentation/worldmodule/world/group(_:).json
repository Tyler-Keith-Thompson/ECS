{"metadata":{"modules":[{"name":"WorldModule"}],"title":"group(_:)","role":"symbol","extendedModule":"WorldModule","roleHeading":"Instance Method","symbolKind":"method","remoteSource":{"url":"https:\/\/github.com\/Tyler-Keith-Thompson\/ECS\/blob\/main\/Sources\/WorldModule\/Group.swift#L70","fileName":"Group.swift"},"externalID":"s:11WorldModule0A0V5groupyyxmxQpRvzAA9ComponentRzlF","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"group"},{"kind":"text","text":"<each "},{"kind":"genericParameter","text":"C"},{"kind":"text","text":">(repeat (each "},{"kind":"typeIdentifier","text":"C"},{"kind":"text","text":").Type)"}]},"schemaVersion":{"minor":3,"patch":0,"major":0},"kind":"symbol","sections":[],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/WorldModule\/documentation\/WorldModule\/World\/group(_:)"},"abstract":[{"type":"text","text":"Keeps the given component types packed in the same order, so that queries and updates of"},{"type":"text","text":" "},{"type":"text","text":"exactly these types visit their entities without lookups."}],"hierarchy":{"paths":[["doc:\/\/WorldModule\/documentation\/WorldModule","doc:\/\/WorldModule\/documentation\/WorldModule\/World"]]},"variants":[{"paths":["\/documentation\/worldmodule\/world\/group(_:)"],"traits":[{"interfaceLanguage":"swift"}]}],"seeAlsoSections":[{"title":"Speeding Up Queries","identifiers":["doc:\/\/WorldModule\/documentation\/WorldModule\/World\/group(checked:)","doc:\/\/WorldModule\/documentation\/WorldModule\/World\/cache(_:)","doc:\/\/WorldModule\/documentation\/WorldModule\/World\/index(_:)-u1gw","doc:\/\/WorldModule\/documentation\/WorldModule\/World\/index(_:)-2gtfg","doc:\/\/WorldModule\/documentation\/WorldModule\/World\/lookup(_:)","doc:\/\/WorldModule\/documentation\/WorldModule\/World\/lookup(_:equals:)","doc:\/\/WorldModule\/documentation\/WorldModule\/World\/index(ordered:)","doc:\/\/WorldModule\/documentation\/WorldModule\/World\/lookup(_:in:)","doc:\/\/WorldModule\/documentation\/WorldModule\/World\/entities(sortedBy:)"],"generated":true,"anchor":"Speeding-Up-Queries"}],"primaryContentSections":[{"kind":"declarations","declarations":[{"tokens":[{"kind":"keyword","text":"mutating"},{"kind":"text","text":" "},{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"group"},{"kind":"text","text":"<each "},{"kind":"genericParameter","text":"C"},{"kind":"text","text":">("},{"kind":"externalParam","text":"_"},{"kind":"text","text":" "},{"kind":"internalParam","text":"types"},{"kind":"text","text":": repeat (each "},{"kind":"typeIdentifier","text":"C"},{"kind":"text","text":").Type) "},{"kind":"keyword","text":"where"},{"kind":"text","text":" repeat each "},{"kind":"typeIdentifier","text":"C"},{"kind":"text","text":" : "},{"kind":"typeIdentifier","text":"Component","preciseIdentifier":"s:11WorldModule9ComponentP","identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/Component"}],"languages":["swift"],"platforms":["Linux"]}]},{"kind":"parameters","parameters":[{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The component types to keep packed together."}]}],"name":"types"}]},{"kind":"content","content":[{"anchor":"discussion","type":"heading","level":2,"text":"Discussion"},{"type":"paragraph","inlineContent":[{"type":"text","text":"A query of several types normally walks one type’s storage and looks up the entity in each"},{"type":"text","text":" "},{"type":"text","text":"of the others. After you group the types, the entities that hold all of them sit at the"},{"type":"text","text":" "},{"type":"text","text":"front of each type’s storage, at the same positions, and spawning, inserting, removing and"},{"type":"text","text":" "},{"type":"text","text":"despawning keep them there. A query of the same types in any order, or an update that"},{"type":"text","text":" "},{"type":"text","text":"writes and reads exactly those types, walks that front directly."}]},{"type":"paragraph","inlineContent":[{"text":"Use a group for a set of types you visit together on every step, such as position and","type":"text"},{"text":" ","type":"text"},{"text":"velocity:","type":"text"}]},{"type":"codeListing","syntax":"swift","code":["var world = World()","let comet = world.spawn(Position(x: 0, y: 0), Velocity(dx: 1, dy: 2))","world.spawn(Position(x: 9, y: 9))","world.group(Position.self, Velocity.self)","","world.update(Position.self, reading: Velocity.self) { position, row in","    position.x += row.components.dx","    position.y += row.components.dy","}","print(world[Position.self, of: comet])","\/\/ Prints \"Position(x: 1.0, y: 2.0)\""]},{"type":"paragraph","inlineContent":[{"text":"Grouping doesn’t change which entities a query or update visits, only how it finds them.","type":"text"},{"text":" ","type":"text"},{"text":"It does change the order queries list entities in, and makes adding and removing the","type":"text"},{"text":" ","type":"text"},{"text":"grouped types a little slower. Each type belongs to at most one group. A copy of the world","type":"text"},{"text":" ","type":"text"},{"text":"keeps the group; a snapshot doesn’t.","type":"text"}]},{"type":"aside","content":[{"type":"paragraph","inlineContent":[{"text":"O(","type":"text"},{"inlineContent":[{"type":"text","text":"n"}],"type":"emphasis"},{"text":"·","type":"text"},{"inlineContent":[{"type":"text","text":"t"}],"type":"emphasis"},{"text":") for ","type":"text"},{"inlineContent":[{"type":"text","text":"n"}],"type":"emphasis"},{"text":" entities in the smallest of the ","type":"text"},{"inlineContent":[{"text":"t","type":"text"}],"type":"emphasis"},{"text":" types.","type":"text"}]}],"style":"note","name":"Complexity"},{"type":"aside","content":[{"inlineContent":[{"type":"text","text":""},{"type":"codeVoice","code":"types"},{"type":"text","text":" lists at least two distinct types, and no other group owns any of"},{"type":"text","text":" "},{"type":"text","text":"them. The checked spelling, "},{"type":"reference","isActive":true,"identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/World\/group(checked:)"},{"type":"text","text":", throws instead."}],"type":"paragraph"}],"style":"note","name":"Precondition"}]}],"references":{"doc://WorldModule/documentation/WorldModule/World/group(checked:)":{"kind":"symbol","title":"group(checked:)","role":"symbol","identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/World\/group(checked:)","url":"\/documentation\/worldmodule\/world\/group(checked:)","type":"topic","abstract":[{"text":"Keeps the given component types packed in the same order, throwing an error if they can’t","type":"text"},{"text":" ","type":"text"},{"text":"be grouped.","type":"text"}],"fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"group","kind":"identifier"},{"text":"<each ","kind":"text"},{"text":"C","kind":"genericParameter"},{"text":">(","kind":"text"},{"text":"checked","kind":"externalParam"},{"text":": repeat (each ","kind":"text"},{"text":"C","kind":"typeIdentifier"},{"text":").Type) ","kind":"text"},{"text":"throws","kind":"keyword"},{"text":"(","kind":"text"},{"text":"GroupError","preciseIdentifier":"s:11WorldModule10GroupErrorO","kind":"typeIdentifier"},{"text":")","kind":"text"}]},"doc://WorldModule/documentation/WorldModule/World/lookup(_:in:)":{"role":"symbol","title":"lookup(_:in:)","type":"topic","identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/World\/lookup(_:in:)","kind":"symbol","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"lookup"},{"kind":"text","text":"<"},{"kind":"genericParameter","text":"C"},{"kind":"text","text":", "},{"kind":"genericParameter","text":"Key"},{"kind":"text","text":">(any "},{"kind":"typeIdentifier","text":"KeyPath","preciseIdentifier":"s:s7KeyPathC"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","text":"C"},{"kind":"text","text":", "},{"kind":"typeIdentifier","