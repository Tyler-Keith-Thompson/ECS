{"hierarchy":{"paths":[["doc:\/\/WorldModule\/documentation\/WorldModule","doc:\/\/WorldModule\/documentation\/WorldModule\/World"]]},"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/worldmodule\/world\/group(_:)"]}],"sections":[],"kind":"symbol","identifier":{"url":"doc:\/\/WorldModule\/documentation\/WorldModule\/World\/group(_:)","interfaceLanguage":"swift"},"metadata":{"title":"group(_:)","modules":[{"name":"WorldModule"}],"extendedModule":"WorldModule","roleHeading":"Instance Method","role":"symbol","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"group"},{"kind":"text","text":"<each "},{"kind":"genericParameter","text":"C"},{"kind":"text","text":">(repeat (each "},{"kind":"typeIdentifier","text":"C"},{"kind":"text","text":").Type)"}],"externalID":"s:11WorldModule0A0V5groupyyxmxQpRvzAA9ComponentRzlF","symbolKind":"method","remoteSource":{"fileName":"Group.swift","url":"https:\/\/github.com\/Tyler-Keith-Thompson\/ECS\/blob\/main\/Sources\/WorldModule\/Group.swift#L70"}},"abstract":[{"type":"text","text":"Keeps the given component types packed in the same order, so that queries and updates of"},{"type":"text","text":" "},{"type":"text","text":"exactly these types visit their entities without lookups."}],"schemaVersion":{"major":0,"minor":3,"patch":0},"seeAlsoSections":[{"anchor":"Speeding-Up-Queries","identifiers":["doc:\/\/WorldModule\/documentation\/WorldModule\/World\/group(checked:)","doc:\/\/WorldModule\/documentation\/WorldModule\/World\/cache(_:)","doc:\/\/WorldModule\/documentation\/WorldModule\/World\/index(_:)","doc:\/\/WorldModule\/documentation\/WorldModule\/World\/lookup(_:)"],"generated":true,"title":"Speeding Up Queries"}],"primaryContentSections":[{"declarations":[{"platforms":["Linux"],"languages":["swift"],"tokens":[{"text":"mutating","kind":"keyword"},{"text":" ","kind":"text"},{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"group","kind":"identifier"},{"text":"<each ","kind":"text"},{"text":"C","kind":"genericParameter"},{"text":">(","kind":"text"},{"text":"_","kind":"externalParam"},{"text":" ","kind":"text"},{"text":"types","kind":"internalParam"},{"text":": repeat (each ","kind":"text"},{"text":"C","kind":"typeIdentifier"},{"text":").Type) ","kind":"text"},{"text":"where","kind":"keyword"},{"text":" repeat each ","kind":"text"},{"text":"C","kind":"typeIdentifier"},{"text":" : ","kind":"text"},{"text":"Component","kind":"typeIdentifier","identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/Component","preciseIdentifier":"s:11WorldModule9ComponentP"}]}],"kind":"declarations"},{"kind":"parameters","parameters":[{"name":"types","content":[{"type":"paragraph","inlineContent":[{"text":"The component types to keep packed together.","type":"text"}]}]}]},{"kind":"content","content":[{"text":"Discussion","anchor":"discussion","level":2,"type":"heading"},{"inlineContent":[{"text":"A query of several types normally walks one type’s storage and looks up the entity in each","type":"text"},{"text":" ","type":"text"},{"text":"of the others. After you group the types, the entities that hold all of them sit at the","type":"text"},{"text":" ","type":"text"},{"text":"front of each type’s storage, at the same positions, and spawning, inserting, removing and","type":"text"},{"text":" ","type":"text"},{"text":"despawning keep them there. A query of the same types in any order, or an update that","type":"text"},{"text":" ","type":"text"},{"text":"writes and reads exactly those types, walks that front directly.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"Use a group for a set of types you visit together on every step, such as position and"},{"type":"text","text":" "},{"type":"text","text":"velocity:"}],"type":"paragraph"},{"syntax":"swift","code":["var world = World()","let comet = world.spawn(Position(x: 0, y: 0), Velocity(dx: 1, dy: 2))","world.spawn(Position(x: 9, y: 9))","world.group(Position.self, Velocity.self)","","world.update(Position.self, reading: Velocity.self) { position, row in","    position.x += row.components.dx","    position.y += row.components.dy","}","print(world[Position.self, of: comet])","\/\/ Prints \"Position(x: 1.0, y: 2.0)\""],"type":"codeListing"},{"inlineContent":[{"type":"text","text":"Grouping doesn’t change which entities a query or update visits, only how it finds them."},{"type":"text","text":" "},{"type":"text","text":"It does change the order queries list entities in, and makes adding and removing the"},{"type":"text","text":" "},{"type":"text","text":"grouped types a little slower. Each type belongs to at most one group. A copy of the world"},{"type":"text","text":" "},{"type":"text","text":"keeps the group; a snapshot doesn’t."}],"type":"paragraph"},{"name":"Complexity","content":[{"type":"paragraph","inlineContent":[{"text":"O(","type":"text"},{"inlineContent":[{"text":"n","type":"text"}],"type":"emphasis"},{"text":"·","type":"text"},{"inlineContent":[{"type":"text","text":"t"}],"type":"emphasis"},{"text":") for ","type":"text"},{"inlineContent":[{"type":"text","text":"n"}],"type":"emphasis"},{"text":" entities in the smallest of the ","type":"text"},{"inlineContent":[{"text":"t","type":"text"}],"type":"emphasis"},{"text":" types.","type":"text"}]}],"style":"note","type":"aside"},{"name":"Precondition","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":""},{"code":"types","type":"codeVoice"},{"type":"text","text":" lists at least two distinct types, and no other group owns any of"},{"type":"text","text":" "},{"type":"text","text":"them. The checked spelling, "},{"identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/World\/group(checked:)","type":"reference","isActive":true},{"type":"text","text":", throws instead."}]}],"style":"note","type":"aside"}]}],"references":{"doc://WorldModule/documentation/WorldModule/World":{"type":"topic","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"World"}],"identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/World","url":"\/documentation\/worldmodule\/world","role":"symbol","kind":"symbol","title":"World","abstract":[{"text":"A collection of entities, the components they hold, and resources.","type":"text"}],"navigatorTitle":[{"kind":"identifier","text":"World"}]},"doc://WorldModule/documentation/WorldModule/World/lookup(_:)":{"identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/World\/lookup(_:)","kind":"symbol","type":"topic","title":"lookup(_:)","url":"\/documentation\/worldmodule\/world\/lookup(_:)","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"lookup","kind":"identifier"},{"text":"<","kind":"text"},{"text":"C","kind":"genericParameter"},{"text":">(","kind":"text"},{"kind":"typeIdentifier","text":"C"},{"kind":"text","text":") -> ["},{"kind":"typeIdentifier","text":"Entity","preciseIdentifier":"s:11WorldModule6EntityV"},{"kind":"text","text":"]"}],"abstract":[{"text":"Returns the entities holding a component equal to the given value.","type":"text"}],"role":"symbol"},"doc://WorldModule/documentation/WorldModule/World/group(checked:)":{"type":"topic","identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/World\/group(checked:)","title":"group(checked:)","role":"symbol","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"group","kind":"identifier"},{"text":"<each ","kind":"text"},{"text":"C","kind":"genericParameter"},{"text":">(","kind":"text"},{"text":"checked","kind":"externalParam"},{"text":": repeat (each ","kind":"text"},{"text":"C","kind":"typeIdentifier"},{"text":").Type) ","kind":"text"},{"text":"throws","kind":"keyword"},{"kind":"text","text":"("},{"preciseIdentifier":"s:11WorldModule10GroupErrorO","kind":"typeIdentifier","text":"GroupError"},{"kind":"text","text":")"}],"kind":"symbol","abstract":[{"text":"Keeps the given component types packed in the same order, throwing an error if they can’t","type":"text"},{"text":" ","type":"text"},{"text":"be grouped.","type":"text"}],"url":"\/documentation\/worldmodule\/world\/group(checked:)"},"doc://WorldModule/documentation/WorldModule/World/cache(_:)":{"url":"\/documentation\/worldmodule\/world\/cache(_:)","type":"topic","identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/World\/cache(_:)","title":"cache(_:)","kind":"symbol","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"cache"},{"kind":"text","text":"<each "},{"text":"T","kind":"genericParameter"},{"text":">(","kind":"text"},{"text":"Query","preciseIdentifier":"s:11WorldModule5QueryV","kind":"typeIdentifier"},{"text":"<repeat each ","kind":"text"},{"text":"T","kind":"typeIdentifier"},{"text":">)","kind":"text"}],"abstract":[{"text":"Keeps a list of the entities that match a query’s structure, so that queries and updates","type":"text"},{"text":" ","type":"text"},{"text":"with the same conditions visit only those entities.","type":"text"}],"role":"symbol"},"doc://WorldModule/documentation/WorldModule":{"type":"topic","identifier":"doc:\/\/WorldModule\/documentation\/WorldModule","url":"\/documentation\/worldmodule","role":"collection","title":"WorldModule","kind":"symbol","abstract":[{"text":"Store the state of a game or simulation as entities and components, and read and change it with","type":"text"},{"text":" ","type":"text"},{"text":"queries, updates, and commands.","type":"text"}]},"doc://WorldModule/documentation/WorldModule/World/group(_:)":{"type":"topic","title":"group(_:)","identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/World\/group(_:)","role":"symbol","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"group"},{"kind":"text","text":"<each "},{"kind":"genericParameter","text":"C"},{"kind":"text","text":">(repeat (each "},{"kind":"typeIdentifier","text":"C"},{"kind":"text","text":").Type)"}],"kind":"symbol","abstract":[{"text":"Keeps the given component types packed in the same order, so that queries and updates of","type":"text"},{"text":" ","type":"text"},{"text":"exactly these types visit their entities without lookups.","type":"text"}],"url":"\/documentation\/worldmodule\/world\/group(_:)"},"doc://WorldModule/documentation/WorldModule/Component":{"type":"topic","fragments":[{"text":"protocol","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Component","kind":"identifier"}],"identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/Component","url":"\/documentation\/worldmodule\/component","role":"symbol","title":"Component","kind":"symbol","abstract":[{"text":"A type that can be stored as a component of an entity.","type":"text"}],"navigatorTitle":[{"text":"Component","kind":"identifier"}]},"doc://WorldModule/documentation/WorldModule/World/index(_:)":{"url":"\/documentation\/worldmodule\/world\/index(_:)","type":"topic","identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/World\/index(_:)","title":"index(_:)","kind":"symbol","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"index"},{"text":"<","kind":"text"},{"text":"C","kind":"genericParameter"},{"text":">(","kind":"text"},{"text":"C","kind":"typeIdentifier"},{"text":".Type)","kind":"text"}],"abstract":[{"type":"text","text":"Keeps a map from each value of a component type to the entities holding it, so that"},{"type":"text","text":" "},{"identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/World\/lookup(_:)","type":"reference","isActive":true},{"type":"text","text":" finds them without walking the type’s storage."}],"role":"symbol"}}}