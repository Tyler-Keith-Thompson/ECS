ries list entities in, and makes adding and removing the"},{"type":"text","text":" "},{"type":"text","text":"owned types a little slower. A copy of the world keeps the group; a snapshot does not."}],"type":"paragraph"},{"style":"note","content":[{"inlineContent":[{"type":"text","text":"O("},{"type":"emphasis","inlineContent":[{"type":"text","text":"n"}]},{"type":"text","text":"·"},{"type":"emphasis","inlineContent":[{"type":"text","text":"t"}]},{"type":"text","text":") for "},{"type":"emphasis","inlineContent":[{"text":"n","type":"text"}]},{"type":"text","text":" entities in the smallest of the "},{"type":"emphasis","inlineContent":[{"text":"t","type":"text"}]},{"type":"text","text":" types."}],"type":"paragraph"}],"name":"Complexity","type":"aside"},{"style":"note","content":[{"inlineContent":[{"text":"At least two distinct types, none owned by another group. Use","type":"text"},{"text":" ","type":"text"},{"identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/World\/group(checked:)","isActive":true,"type":"reference"},{"text":" to throw instead.","type":"text"}],"type":"paragraph"}],"name":"Precondition","type":"aside"}],"kind":"content"}],"variants":[{"paths":["\/documentation\/worldmodule\/world\/group(_:)"],"traits":[{"interfaceLanguage":"swift"}]}],"abstract":[{"text":"Keeps ","type":"text"},{"code":"types","type":"codeVoice"},{"text":" packed in the same order from now on, so queries and updates over exactly","type":"text"},{"text":" ","type":"text"},{"text":"these types visit their entities with no lookups.","type":"text"}],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/WorldModule\/documentation\/WorldModule\/World\/group(_:)"},"kind":"symbol","metadata":{"extendedModule":"WorldModule","modules":[{"name":"WorldModule"}],"role":"symbol","externalID":"s:11WorldModule0A0V5groupyyxmxQpRvzAA9ComponentRzlF","roleHeading":"Instance Method","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"group","kind":"identifier"