{"metadata":{"externalID":"s:11WorldModule0A0V5groupyyxmxQpRvzAA9ComponentRzlF","symbolKind":"method","title":"group(_:)","role":"symbol","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"group","kind":"identifier"},{"kind":"text","text":"<each "},{"kind":"genericParameter","text":"C"},{"kind":"text","text":">(repeat (each "},{"kind":"typeIdentifier","text":"C"},{"kind":"text","text":").Type)"}],"extendedModule":"WorldModule","roleHeading":"Instance Method","modules":[{"name":"WorldModule"}],"remoteSource":{"url":"https:\/\/github.com\/Tyler-Keith-Thompson\/ECS\/blob\/main\/Sources\/WorldModule\/Group.swift#L70","fileName":"Group.swift"}},"hierarchy":{"paths":[["doc:\/\/WorldModule\/documentation\/WorldModule","doc:\/\/WorldModule\/documentation\/WorldModule\/World"]]},"schemaVersion":{"patch":0,"major":0,"minor":3},"kind":"symbol","seeAlsoSections":[{"title":"Speeding Up Queries","identifiers":["doc:\/\/WorldModule\/documentation\/WorldModule\/World\/group(checked:)","doc:\/\/WorldModule\/documentation\/WorldModule\/World\/cache(_:)","doc:\/\/WorldModule\/documentation\/WorldModule\/World\/index(_:)","doc:\/\/WorldModule\/documentation\/WorldModule\/World\/lookup(_:)"],"generated":true,"anchor":"Speeding-Up-Queries"}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/worldmodule\/world\/group(_:)"]}],"primaryContentSections":[{"declarations":[{"tokens":[{"kind":"keyword","text":"mutating"},{"kind":"text","text":" "},{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"group"},{"kind":"text","text":"<each "},{"kind":"genericParameter","text":"C"},{"kind":"text","text":">("},{"kind":"externalParam","text":"_"},{"kind":"text","text":" "},{"kind":"internalParam","text":"types"},{"kind":"text","text":": repeat (each "},{"kind":"typeIdentifier","text":"C"},{"kind":"text","text":").Type) "},{"kind":"keyword","text":"where"},{"kind":"text","text":" repeat each "},{"kind":"typeIdentifier","text":"C"},{"kind":"text","text":" : "},{"identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/Component","preciseIdentifier":"s:11WorldModule9ComponentP","kind":"typeIdentifier","text":"Component"}],"platforms":["Linux"],"languages":["swift"]}],"kind":"declarations"},{"parameters":[{"content":[{"type":"paragraph","inlineContent":[{"text":"The component types to keep packed together.","type":"text"}]}],"name":"types"}],"kind":"parameters"},{"content":[{"anchor":"discussion","type":"heading","level":2,"text":"Discussion"},{"inlineContent":[{"type":"text","text":"A query of several types normally walks one type’s storage and looks up the entity in each"},{"type":"text","text":" "},{"type":"text","text":"of the others. After you group the types, the entities that hold all of them sit at the"},{"type":"text","text":" "},{"type":"text","text":"front of each type’s storage, at the same positions, and spawning, inserting, removing and"},{"type":"text","text":" "},{"type":"text","text":"despawning keep them there. A query of the same types in any order, or an update that"},{"type":"text","text":" "},{"type":"text","text":"writes and reads exactly those types, walks that front directly."}],"type":"paragraph"},{"inlineContent":[{"text":"Use a group for a set of types you visit together on every step, such as position and","type":"text"},{"text":" ","type":"text"},{"text":"velocity:","type":"text"}],"type":"paragraph"},{"type":"codeListing","syntax":"swift","code":["var world = World()","let comet = world.spawn(Position(x: 0, y: 0), Velocity(dx: 1, dy: 2))","world.spawn(Position(x: 9, y: 9))","world.group(Position.self, Velocity.self)","","world.update(Position.self, reading: Velocity.self) { position, row in","    position.x += row.components.dx","    position.y += row.components.dy","}","print(world[Position.self, of: comet])","\/\/ Prints \"Position(x: 1.0, y: 2.0)\""]},{"inlineContent":[{"text":"Grouping doesn’t change which entities a query or update visits, only how it finds them.","type":"text"},{"text":" ","type":"text"},{"text":"It does change the order queries list entities in, and makes adding and removing the","type":"text"},{"text":" ","type":"text"},{"text":"grouped types a little slower. Each type belongs to at most one group. A copy of the world","type":"text"},{"text":" ","type":"text"},{"text":"keeps the group; a snapshot doesn’t.","type":"text"}],"type":"paragraph"},{"content":[{"type":"paragraph","inlineContent":[{"text":"O(","type":"text"},{"inlineContent":[{"type":"text","text":"n"}],"type":"emphasis"},{"text":"·","type":"text"},{"inlineContent":[{"text":"t","type":"text"}],"type":"emphasis"},{"text":") for ","type":"text"},{"inlineContent":[{"type":"text","text":"n"}],"type":"emphasis"},{"text":" entities in the smallest of the ","type":"text"},{"inlineContent":[{"type":"text","text":"t"}],"type":"emphasis"},{"text":" types.","type":"text"}]}],"type":"aside","style":"note","name":"Complexity"},{"content":[{"inlineContent":[{"type":"text","text":""},{"type":"codeVoice","code":"types"},{"type":"text","text":" lists at least two distinct types, and no other group owns any of"},{"type":"text","text":" "},{"type":"text","text":"them. The checked spelling, "},{"type":"reference","identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/World\/group(checked:)","isActive":true},{"type":"text","text":", throws instead."}],"type":"paragraph"}],"type":"aside","style":"note","name":"Precondition"}],"kind":"content"}],"sections":[],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/WorldModule\/documentation\/WorldModule\/World\/group(_:)"},"abstract":[{"type":"text","text":"Keeps the given component types packed in the same order, so that queries and updates of"},{"type":"text","text":" "},{"type":"text","text":"exactly these types visit their entities without lookups."}],"references":{"doc://WorldModule/documentation/WorldModule/World/group(_:)":{"type":"topic","role":"symbol","abstract":[{"text":"Keeps the given component types packed in the same order, so that queries and updates of","type":"text"},{"text":" ","type":"text"},{"text":"exactly these types visit their entities without lookups.","type":"text"}],"fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"group"},{"kind":"text","text":"<each "},{"text":"C","kind":"genericParameter"},{"text":">(repeat (each ","kind":"text"},{"text":"C","kind":"typeIdentifier"},{"text":").Type)","kind":"text"}],"kind":"symbol","title":"group(_:)","url":"\/documentation\/worldmodule\/world\/group(_:)","identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/World\/group(_:)"},"doc://WorldModule/documentation/WorldModule/World/lookup(_:)":{"kind":"symbol","type":"topic","title":"lookup(_:)","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"lookup","kind":"identifier"},{"text":"<","kind":"text"},{"text":"C","kind":"genericParameter"},{"text":">(","kind":"text"},{"text":"C","kind":"typeIdentifier"},{"text":") -> [","kind":"text"},{"text":"Entity","preciseIdentifier":"s:11WorldModule6EntityV","kind":"typeIdentifier"},{"text":"]","kind":"text"}],"url":"\/documentation\/worldmodule\/world\/lookup(_:)","abstract":[{"text":"Returns the entities holding a component equal to the given value.","type":"text"}],"role":"symbol","identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/World\/lookup(_:)"},"doc://WorldModule/documentation/WorldModule/World":{"type":"topic","role":"symbol","abstract":[{"text":"A collection of entities, the components they hold, and resources.","type":"text"}],"fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"World","kind":"identifier"}],"navigatorTitle":[{"text":"World","kind":"identifier"}],"kind":"symbol","title":"World","url":"\/documentation\/worldmodule\/world","identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/World"},"doc://WorldModule/documentation/WorldModule/World/group(checked:)":{"kind":"symbol","type":"topic","title":"group(checked:)","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"group"},{"kind":"text","text":"<each "},{"text":"C","kind":"genericParameter"},{"text":">(","kind":"text"},{"text":"checked","kind":"externalParam"},{"text":": repeat (each ","kind":"text"},{"text":"C","kind":"typeIdentifier"},{"text":").Type) ","kind":"text"},{"text":"throws","kind":"keyword"},{"text":"(","kind":"text"},{"preciseIdentifier":"s:11WorldModule10GroupErrorO","text":"GroupError","kind":"typeIdentifier"},{"text":")","kind":"text"}],"url":"\/documentation\/worldmodule\/world\/group(checked:)","abstract":[{"type":"text","text":"Keeps the given component types packed in the same order, throwing an error if they can’t"},{"type":"text","text":" "},{"type":"text","text":"be grouped."}],"role":"symbol","identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/World\/group(checked:)"},"doc://WorldModule/documentation/WorldModule":{"abstract":[{"type":"text","text":"Store the state of a game or simulation as entities and components, and read and change it with"},{"type":"text","text":" "},{"type":"text","text":"queries, updates, and commands."}],"url":"\/documentation\/worldmodule","identifier":"doc:\/\/WorldModule\/documentation\/WorldModule","role":"collection","type":"topic","title":"WorldModule","kind":"symbol"},"doc://WorldModule/documentation/WorldModule/World/index(_:)":{"kind":"symbol","type":"topic","title":"index(_:)","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"index","kind":"identifier"},{"kind":"text","text":"<"},{"kind":"genericParameter","text":"C"},{"kind":"text","text":">("},{"kind":"typeIdentifier","text":"C"},{"kind":"text","text":".Type)"}],"url":"\/documentation\/worldmodule\/world\/index(_:)","abstract":[{"type":"text","text":"Keeps a map from each value of a component type to the entities holding it, so that"},{"type":"text","text":" "},{"type":"reference","identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/World\/lookup(_:)","isActive":true},{"type":"text","text":" finds them without walking the type’s storage."}],"role":"symbol","identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/World\/index(_:)"},"doc://WorldModule/documentation/WorldModule/World/cache(_:)":{"type":"topic","role":"symbol","abstract":[{"text":"Keeps a list of the entities that match a query’s structure, so that queries and updates","type":"text"},{"text":" ","type":"text"},{"text":"with the same conditions visit only those entities.","type":"text"}],"fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"cache","kind":"identifier"},{"text":"<each ","kind":"text"},{"kind":"genericParameter","text":"T"},{"kind":"text","text":">("},{"kind":"typeIdentifier","text":"Query","preciseIdentifier":"s:11WorldModule5QueryV"},{"kind":"text","text":"<repeat each "},{"kind":"typeIdentifier","text":"T"},{"kind":"text","text":">)"}],"kind":"symbol","title":"cache(_:)","url":"\/documentation\/worldmodule\/world\/cache(_:)","identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/World\/cache(_:)"},"doc://WorldModule/documentation/WorldModule/Component":{"abstract":[{"type":"text","text":"A type that can be stored as a component of an entity."}],"type":"topic","kind":"symbol","role":"symbol","fragments":[{"text":"protocol","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Component","kind":"identifier"}],"title":"Component","navigatorTitle":[{"text":"Component","kind":"identifier"}],"identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/Component","url":"\/documentation\/worldmodule\/component"}}}