{"kind":"symbol","variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/worldmodule\/world\/group(_:)"]}],"sections":[],"hierarchy":{"paths":[["doc:\/\/WorldModule\/documentation\/WorldModule","doc:\/\/WorldModule\/documentation\/WorldModule\/World"]]},"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/WorldModule\/documentation\/WorldModule\/World\/group(_:)"},"seeAlsoSections":[{"anchor":"Speeding-Up-Queries","title":"Speeding Up Queries","generated":true,"identifiers":["doc:\/\/WorldModule\/documentation\/WorldModule\/World\/group(checked:)","doc:\/\/WorldModule\/documentation\/WorldModule\/World\/cache(_:)","doc:\/\/WorldModule\/documentation\/WorldModule\/World\/index(_:)-u1gw","doc:\/\/WorldModule\/documentation\/WorldModule\/World\/index(_:)-2gtfg","doc:\/\/WorldModule\/documentation\/WorldModule\/World\/lookup(_:)","doc:\/\/WorldModule\/documentation\/WorldModule\/World\/lookup(_:equals:)","doc:\/\/WorldModule\/documentation\/WorldModule\/World\/index(ordered:)","doc:\/\/WorldModule\/documentation\/WorldModule\/World\/lookup(_:in:)","doc:\/\/WorldModule\/documentation\/WorldModule\/World\/entities(sortedBy:)"]}],"primaryContentSections":[{"declarations":[{"tokens":[{"kind":"keyword","text":"mutating"},{"kind":"text","text":" "},{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"group"},{"kind":"text","text":"<each "},{"kind":"genericParameter","text":"C"},{"kind":"text","text":">("},{"kind":"externalParam","text":"_"},{"kind":"text","text":" "},{"kind":"internalParam","text":"types"},{"kind":"text","text":": repeat (each "},{"kind":"typeIdentifier","text":"C"},{"kind":"text","text":").Type) "},{"kind":"keyword","text":"where"},{"kind":"text","text":" repeat each "},{"kind":"typeIdentifier","text":"C"},{"kind":"text","text":" : "},{"kind":"typeIdentifier","identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/Component","preciseIdentifier":"s:11WorldModule9ComponentP","text":"Component"}],"platforms":["Linux"],"languages":["swift"]}],"kind":"declarations"},{"parameters":[{"name":"types","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The component types to keep packed together."}]}]}],"kind":"parameters"},{"content":[{"text":"Discussion","type":"heading","anchor":"discussion","level":2},{"inlineContent":[{"type":"text","text":"A query of several types normally walks one type’s storage and looks up the entity in each"},{"type":"text","text":" "},{"type":"text","text":"of the others. After you group the types, the entities that hold all of them sit at the"},{"type":"text","text":" "},{"type":"text","text":"front of each type’s storage, at the same positions, and spawning, inserting, removing and"},{"type":"text","text":" "},{"type":"text","text":"despawning keep them there. A query of the same types in any order, or an update that"},{"type":"text","text":" "},{"type":"text","text":"writes and reads exactly those types, walks that front directly."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"Use a group for a set of types you visit together on every step, such as position and"},{"type":"text","text":" "},{"type":"text","text":"velocity:"}],"type":"paragraph"},{"type":"codeListing","code":["var world = World()","let comet = world.spawn(Position(x: 0, y: 0), Velocity(dx: 1, dy: 2))","world.spawn(Position(x: 9, y: 9))","world.group(Position.self, Velocity.self)","","world.update(Position.self, reading: Velocity.self) { position, row in","    position.x += row.components.dx","    position.y += row.components.dy","}","print(world[Position.self, of: comet])","\/\/ Prints \"Position(x: 1.0, y: 2.0)\""],"syntax":"swift"},{"inlineContent":[{"type":"text","text":"Grouping doesn’t change which entities a query or update visits, only how it finds them."},{"type":"text","text":" "},{"type":"text","text":"It does change the order queries list entities in, and makes adding and removing the"},{"type":"text","text":" "},{"type":"text","text":"grouped types a little slower. Each type belongs to at most one group. A copy of the world"},{"type":"text","text":" "},{"type":"text","text":"keeps the group; a snapshot doesn’t."}],"type":"paragraph"},{"style":"note","type":"aside","name":"Complexity","content":[{"type":"paragraph","inlineContent":[{"text":"O(","type":"text"},{"type":"emphasis","inlineContent":[{"type":"text","text":"n"}]},{"text":"·","type":"text"},{"type":"emphasis","inlineContent":[{"type":"text","text":"t"}]},{"text":") for ","type":"text"},{"type":"emphasis","inlineContent":[{"text":"n","type":"text"}]},{"text":" entities in the smallest of the ","type":"text"},{"type":"emphasis","inlineContent":[{"text":"t","type":"text"}]},{"text":" types.","type":"text"}]}]},{"style":"note","type":"aside","name":"Precondition","content":[{"inlineContent":[{"text":"","type":"text"},{"code":"types","type":"codeVoice"},{"text":" lists at least two distinct types, and no other group owns any of","type":"text"},{"text":" ","type":"text"},{"text":"them. The checked spelling, ","type":"text"},{"identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/World\/group(checked:)","isActive":true,"type":"reference"},{"text":", throws instead.","type":"text"}],"type":"paragraph"}]}],"kind":"content"}],"schemaVersion":{"major":0,"patch":0,"minor":3},"metadata":{"roleHeading":"Instance Method","title":"group(_:)","modules":[{"name":"WorldModule"}],"externalID":"s:11WorldModule0A0V5groupyyxmxQpRvzAA9ComponentRzlF","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"group","kind":"identifier"},{"text":"<each ","kind":"text"},{"text":"C","kind":"genericParameter"},{"text":">(repeat (each ","kind":"text"},{"text":"C","kind":"typeIdentifier"},{"text":").Type)","kind":"text"}],"remoteSource":{"url":"https:\/\/github.com\/Tyler-Keith-Thompson\/ECS\/blob\/main\/Sources\/WorldModule\/Group.swift#L70","fileName":"Group.swift"},"role":"symbol","extendedModule":"WorldModule","symbolKind":"method"},"abstract":[{"type":"text","text":"Keeps the given component types packed in the same order, so that queries and updates of"},{"type":"text","text":" "},{"type":"text","text":"exactly these types visit their entities without lookups."}],"references":{"doc://WorldModule/documentation/WorldModule/World/entities(sortedBy:)":{"title":"entities(sortedBy:)","kind":"symbol","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"entities","kind":"identifier"},{"text":"<","kind":"text"},{"kind":"genericParameter","text":"C"},{"kind":"text","text":", "},{"kind":"genericParameter","text":"Key"},{"kind":"text","text":">("},{"kind":"externalParam","text":"sortedBy"},{"kind":"text","text":": any "},{"preciseIdentifier":"s:s7KeyPathC","kind":"typeIdentifier","text":"KeyPath"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","text":"C"},{"kind":"text","text":", "},{"kind":"typeIdentifier","text":"Key"},{"kind":"text","text":"> & "},{"preciseIdentifier":"s:s8SendableP","kind":"typeIdentifier","text":"Sendable"},{"kind":"text","text":") -> ["},{"preciseIdentifier":"s:11WorldModule6EntityV","kind":"typeIdentifier","text":"Entity"},{"kind":"text","text":"]"}],"identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/World\/entities(sortedBy:)","type":"topic","abstract":[{"text":"Returns the entities holding a component type, in the order of a property of the","type":"text"},{"text":" ","type":"text"},{"text":"component.","type":"text"}],"role":"symbol","url":"\/documentation\/worldmodule\/world\/entities(sortedby:)"},"doc://WorldModule/documentation/WorldModule/World/lookup(_:in:)":{"type":"topic","title":"lookup(_:in:)","role":"symbol","abstract":[{"text":"Returns the entities holding a component whose property at a key path falls in a range,","type":"text"},{"text":" ","type":"text"},{"text":"in the order of that property.","type":"text"}],"fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"lookup","k