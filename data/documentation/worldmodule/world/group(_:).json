{"kind":"symbol","sections":[],"schemaVersion":{"major":0,"minor":3,"patch":0},"hierarchy":{"paths":[["doc:\/\/WorldModule\/documentation\/WorldModule","doc:\/\/WorldModule\/documentation\/WorldModule\/World"]]},"primaryContentSections":[{"declarations":[{"tokens":[{"text":"mutating","kind":"keyword"},{"text":" ","kind":"text"},{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"group","kind":"identifier"},{"text":"<each ","kind":"text"},{"text":"C","kind":"genericParameter"},{"text":">(","kind":"text"},{"text":"_","kind":"externalParam"},{"text":" ","kind":"text"},{"text":"types","kind":"internalParam"},{"text":": repeat (each ","kind":"text"},{"text":"C","kind":"typeIdentifier"},{"text":").Type) ","kind":"text"},{"text":"where","kind":"keyword"},{"text":" repeat each ","kind":"text"},{"text":"C","kind":"typeIdentifier"},{"text":" : ","kind":"text"},{"text":"Component","kind":"typeIdentifier","identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/Component","preciseIdentifier":"s:11WorldModule9ComponentP"}],"platforms":["Linux"],"languages":["swift"]}],"kind":"declarations"},{"kind":"parameters","parameters":[{"content":[{"inlineContent":[{"text":"The component types to keep packed together.","type":"text"}],"type":"paragraph"}],"name":"types"}]},{"content":[{"type":"heading","anchor":"discussion","level":2,"text":"Discussion"},{"type":"paragraph","inlineContent":[{"text":"A query of several types normally walks one type’s storage and looks up the entity in each","type":"text"},{"text":" ","type":"text"},{"text":"of the others. After you group the types, the entities that hold all of them sit at the","type":"text"},{"text":" ","type":"text"},{"text":"front of each type’s storage, at the same positions, and spawning, inserting, removing and","type":"text"},{"text":" ","type":"text"},{"text":"despawning keep them there. A query of the same types in any order, or an update that","type":"text"},{"text":" ","type":"text"},{"text":"writes and reads exactly those types, walks that front directly.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"Use a group for a set of types you visit together on every step, such as position and","type":"text"},{"text":" ","type":"text"},{"text":"velocity:","type":"text"}]},{"syntax":"swift","type":"codeListing","code":["var world = World()","let comet = world.spawn(Position(x: 0, y: 0), Velocity(dx: 1, dy: 2))","world.spawn(Position(x: 9, y: 9))","world.group(Position.self, Velocity.self)","","world.update(Position.self, reading: Velocity.self) { position, row in","    position.x += row.components.dx","    position.y += row.components.dy","}","print(world[Position.self, of: comet])","\/\/ Prints \"Position(x: 1.0, y: 2.0)\""]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Grouping doesn’t change which entities a query or update visits, only how it finds them."},{"type":"text","text":" "},{"type":"text","text":"It does change the order queries list entities in, and makes adding and removing the"},{"type":"text","text":" "},{"type":"text","text":"grouped types a little slower. Each type belongs to at most one group. A copy of the world"},{"type":"text","text":" "},{"type":"text","text":"keeps the group; a snapshot doesn’t."}]},{"style":"note","name":"Complexity","type":"aside","content":[{"inlineContent":[{"text":"O(","type":"text"},{"inlineContent":[{"type":"text","text":"n"}],"type":"emphasis"},{"text":"·","type":"text"},{"inlineContent":[{"text":"t","type":"text"}],"type":"emphasis"},{"text":") for ","type":"text"},{"inlineContent":[{"text":"n","type":"text"}],"type":"emphasis"},{"text":" entities in the smallest of the ","type":"text"},{"inlineContent":[{"type":"text","text":"t"}],"type":"emphasis"},{"text":" types.","type":"text"}],"type":"paragraph"}]},{"style":"note","name":"Precondition","type":"aside","content":[{"type":"paragraph","inlineContent":[{"text":"","type":"text"},{"code":"types","type":"codeVoice"},{"text":" lists at least two distinct types, and no other group owns any of","type":"text"},{"text":" ","type":"text"},{"text":"them. The checked spelling, ","type":"text"},{"identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/World\/group(checked:)","isActive":true,"type":"reference"},{"text":", throws instead.","type":"text"}]}]}],"kind":"content"}],"seeAlsoSections":[{"identifiers":["doc:\/\/WorldModule\/documentation\/WorldModule\/World\/group(checked:)","doc:\/\/WorldModule\/documentation\/WorldModule\/World\/cache(_:)","doc:\/\/WorldModule\/documentation\/WorldModule\/World\/index(_:)-u1gw","doc:\/\/WorldModule\/documentation\/WorldModule\/World\/index(_:)-2gtfg","doc:\/\/WorldModule\/documentation\/WorldModule\/World\/lookup(_:)","doc:\/\/WorldModule\/documentation\/WorldModule\/World\/lookup(_:equals:)","doc:\/\/WorldModule\/documentation\/WorldModule\/World\/index(ordered:)","doc:\/\/WorldModule\/documentation\/WorldModule\/World\/lookup(_:in:)","doc:\/\/WorldModule\/documentation\/WorldModule\/World\/entities(sortedBy:)"],"title":"Speeding Up Queries","generated":true,"anchor":"Speeding-Up-Queries"}],"variants":[{"paths":["\/documentation\/worldmodule\/world\/group(_:)"],"traits":[{"interfaceLanguage":"swift"}]}],"abstract":[{"type":"text","text":"Keeps the given component types packed in the same order, so that queries and updates of"},{"type":"text","text":" "},{"type":"text","text":"exactly these types visit their entities without lookups."}],"identifier":{"url":"doc:\/\/WorldModule\/documentation\/WorldModule\/World\/group(_:)","interfaceLanguage":"swift"},"metadata":{"fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"group"},{"kind":"text","text":"<each "},{"kind":"genericParameter","text":"C"},{"kind":"text","text":">(repeat (each "},{"kind":"typeIdentifier","text":"C"},{"kind":"text","text":").Type)"}],"externalID":"s:11WorldModule0A0V5groupyyxmxQpRvzAA9ComponentRzlF","modules":[{"name":"WorldModule"}],"remoteSource":