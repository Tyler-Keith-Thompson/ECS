 }","","var world = World()","world.resources.insert(MoverCount())","world.onAdd(Query(Position.self, Velocity.self).without(Frozen.self)) { world, _ in","    world.resources[MoverCount.self].count += 1","}","","let rock = world.spawn(Position(x: 0, y: 0))","world.insert(Velocity(dx: 1, dy: 0), into: rock)","print(world.resources[MoverCount.self].count)","\/\/ Prints \"1\""],"syntax":"swift","type":"codeListing"},{"style":"note","name":"Complexity","content":[{"inlineContent":[{"text":"That of ","type":"text"},{"type":"reference","identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/World\/cache(_:)","isActive":true},{"text":" when the world keeps no cache of the query’s","type":"text"},{"text":" ","type":"text"},{"text":"conditions; otherwise, O(1) amortized.","type":"text"}],"type":"paragraph"}],"type":"aside"}]}],"kind":"symbol","schemaVersion":{"minor":3,"patch":0,"major":0},"metadata":{"role":"symbol","externalID":"s:11WorldModule0A0V5onAdd_7performyAA5QueryVyxxQp_QPG_yACz_AA6EntityVtYbctRvzAA0F4TermRzlF","title":"onAdd(_:perform:)","symbolKind":"method","remoteSource":{"fileName":"Observers.swift","url":"https:\/\/github.com\/Tyler-Keith-Thompson\/ECS\/blob\/main\/Sources\/WorldModule\/Observers.swift#L292"},"roleHeading":"Instance Method","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"onAdd"},{"kind":"text","text":"<each "},{"kind":"genericParameter","text":"T"},{"kind":"text","text":">("},{"kind":"typeIdentifier","text":"Query","preciseIdentifier":"s:11WorldModule5QueryV"},{"kind":"text","text":"<repeat each "},{"kind":"typeIdentifier","text":"T"},{"kind":"text","text":">, "},{"kind":"externalParam","text":"perform"},{"kind":"text","text":": ("},{"kind":"keyword","text":"inout"},{"kind":"text","text":" "},{"kind":"typeIdentifier","text":"World","preciseIdentifier":"s:11WorldModule0A0V"},{"kind":"text","text":", "},{"kind":"typeIdentifier","text":"Entity","preciseIdentifier":"s:11WorldModule6Enti