ifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/QueryTerm"}],"platforms":["Linux"],"languages":["swift"]}]},{"kind":"parameters","parameters":[{"name":"query","content":[{"inlineContent":[{"type":"text","text":"The query whose matches to watch."}],"type":"paragraph"}]},{"name":"hook","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The closure to run, given the world and the entity that started matching."}]}]}]},{"kind":"content","content":[{"level":2,"text":"Discussion","type":"heading","anchor":"discussion"},{"type":"paragraph","inlineContent":[{"text":"Use this method to respond when an entity gains the combination of components a query","type":"text"},{"text":" ","type":"text"},{"text":"describes, rather than a single component. The hook runs when spawning, inserting,","type":"text"},{"text":" ","type":"text"},{"text":"removing or applying a command makes an entity match. Entities that already match when","type":"text"},{"text":" ","type":"text"},{"text":"you register the hook don’t run it. Query hooks run at the same point component hooks do","type":"text"},{"text":" ","type":"text"},{"text":"(see the component ","type":"text"},{"code":"onAdd(_:perform:)","type":"codeVoice"},{"text":").","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"Only the query’s structural conditions count: its component terms and the types its","type":"text"},{"text":" ","type":"text"},{"text":"filter requires, excludes or skips by default, the conditions a cache of the query keeps","type":"text"},{"text":" ","type":"text"},{"text":"(","type":"text"},{"identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/World\/cache(_:)","type":"reference","isActive":true},{"text":"). The following example counts the entities that start moving:","type":"text"}]},{"code":["struct MoverCount: Resource { var count = 0 }","","var world = World()","world.resources.insert(MoverCount())","world.onAdd(Query(Position.self, Velocity.self).without(Frozen.self)) { world, _ in","    world.resources[MoverCount.self].count += 1","}","","let rock = world.spawn(Position(x: 0, y: 0))","world.insert(Velocity(dx: 1, dy: 0), into: rock)","print(world.resources[MoverCount.self].count)","\/\/ Prints \"1\""],"type":"codeListing","syntax":"swift"},{"style":"note","type":"aside","name":"Complexity","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"That of "},{"type":"reference","isActive":true,"identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/World\/cache(_:)"},{"type":"text","text":" when the world keeps no cache of the query’s"},{"type":"text","text":" "},{"type":"text","text":"conditions; otherwise, O(1) amortized."}]}]}]}],"seeAlsoSections":[{"anchor":"Responding-to-Component-Changes-with-Hooks","generated":true,"title":"Responding to Component Changes with Hooks","identifiers":["doc:\/\/WorldModule\/documentation\/WorldModule\/World\/onAdd(_:perform:)-27g0l","doc:\/\/WorldModule\/documentation\/WorldModule\/World\/onInsert(_:perform:)","doc:\/\/WorldModule\/documentation\/WorldModule\/World\/onRemove(_:perform:)-2t2p","doc:\/\/WorldModule\/documentation\/WorldModule\/World\/onRemove(_:perform:)-5cn3d","doc:\/\/WorldModule\/documentation\/WorldModule\/World\/removeHooks(of:)"]}],"schemaVersion":{"minor":3,"major":0,"patch":0},"variants":[{"paths":["\/documentation\/worldmodule\/world\/onadd(_:perform:)-8d74u"],"traits":[{"interfaceLanguage":"swift"}]}],"metadata":{"role":"symbol","title":"onAdd(_:perform:)","extendedModule":"WorldModule","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"onAdd","kind":"identifier"},{"text":"<each ","kind":"text"},{"text":"T","kind":"genericParameter"},{"text":">(","kind":"text"},{"text":"Query","kind":"typeIdentifier","preciseIdentifier":"s:11WorldModule5QueryV"},{"text":"<repeat each ","kind":"text"},{"text":"T","kind":"typeIdentifier"},{"text":">, ","kind":"text"},{"text":"perform","kind":"externalParam"},{"text":": (","kind":"text"