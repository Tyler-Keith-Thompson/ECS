ldModule9QueryTermP","kind":"typeIdentifier"}]}],"kind":"declarations"},{"parameters":[{"name":"query","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The query whose matches to watch."}]}]},{"name":"hook","content":[{"inlineContent":[{"type":"text","text":"The closure to run, given the world and the entity that started matching."}],"type":"paragraph"}]}],"kind":"parameters"},{"content":[{"type":"heading","level":2,"anchor":"discussion","text":"Discussion"},{"inlineContent":[{"text":"Use this method to respond when an entity gains the combination of components a query","type":"text"},{"text":" ","type":"text"},{"text":"describes, rather than a single component. The hook runs when spawning, inserting,","type":"text"},{"text":" ","type":"text"},{"text":"removing or applying a command makes an entity match. Entities that already match when","type":"text"},{"text":" ","type":"text"},{"text":"you register the hook don’t run it. Query hooks run at the same point component hooks do","type":"text"},{"text":" ","type":"text"},{"text":"(see the component ","type":"text"},{"type":"codeVoice","code":"onAdd(_:perform:)"},{"text":").","type":"text"}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"Only the query’s structural conditions count: its component terms and the types its"},{"type":"text","text":" "},{"type":"text","text":"filter requires, excludes or skips by default, the conditions a cache of the query keeps"},{"type":"text","text":" "},{"type":"text","text":"("},{"isActive":true,"type":"reference","identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/World\/cache(_:)"},{"type":"text","text":"). The following example counts the entities that start moving:"}],"type":"paragraph"},{"syntax":"swift","type":"codeListing","code":["struct MoverCount: Resource { var count = 0 }","","var world = World()","world.resources.insert(MoverCount())","world.onAdd(Query(Position.self, Velocity.self).without(Frozen.self)) { world, _ in","    wo