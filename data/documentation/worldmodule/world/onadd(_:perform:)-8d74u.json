pe":"text","text":" "},{"type":"text","text":"describes, rather than a single component. The hook runs when spawning, inserting,"},{"type":"text","text":" "},{"type":"text","text":"removing or applying a command makes an entity match. Entities that already match when"},{"type":"text","text":" "},{"type":"text","text":"you register the hook don’t run it. Query hooks run at the same point component hooks do"},{"type":"text","text":" "},{"type":"text","text":"(see the component "},{"type":"codeVoice","code":"onAdd(_:perform:)"},{"type":"text","text":")."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Only the query’s structural conditions count: its component terms and the types its"},{"type":"text","text":" "},{"type":"text","text":"filter requires, excludes or skips by default, the conditions a cache of the query keeps"},{"type":"text","text":" "},{"type":"text","text":"("},{"type":"reference","identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/World\/cache(_:)","isActive":true},{"type":"text","text":"). The following example counts the entities that start moving:"}]},{"code":["struct MoverCount: Resource { var count = 0 }","","var world = World()","world.resources.insert(MoverCount())","world.onAdd(Query(Position.self, Velocity.self).without(Frozen.self)) { world, _ in","    world.resources[MoverCount.self].count += 1","}","","let rock = world.spawn(Position(x: 0, y: 0))","world.insert(Velocity(dx: 1, dy: 0), into: rock)","print(world.resources[MoverCount.self].count)","\/\/ Prints \"1\""],"type":"codeListing","syntax":"swift"},{"content":[{"inlineContent":[{"type":"text","text":"That of "},{"identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/World\/cache(_:)","type":"reference","isActive":true},{"type":"text","text":" when the world keeps no cache of the query’s"},{"type":"text","text":" "},{"type":"text","text":"conditions; otherwise, O(1) amortized."}],"type":"paragraph"}],"type":"aside","style":"note","name":"Complexity"}]}]