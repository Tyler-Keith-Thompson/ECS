xt":"<each ","kind":"text"},{"text":"T","kind":"genericParameter"},{"text":">(","kind":"text"},{"text":"_","kind":"externalParam"},{"text":" ","kind":"text"},{"text":"query","kind":"internalParam"},{"text":": ","kind":"text"},{"text":"Query","kind":"typeIdentifier","identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/Query","preciseIdentifier":"s:11WorldModule5QueryV"},{"text":"<repeat each ","kind":"text"},{"text":"T","kind":"typeIdentifier"},{"text":">, ","kind":"text"},{"text":"perform","kind":"externalParam"},{"text":" ","kind":"text"},{"text":"hook","kind":"internalParam"},{"text":": ","kind":"text"},{"text":"@escaping ","kind":"attribute"},{"text":"@Sendable","kind":"attribute"},{"text":" (","kind":"text"},{"text":"inout","kind":"keyword"},{"text":" ","kind":"text"},{"text":"World","kind":"typeIdentifier","identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/World","preciseIdentifier":"s:11WorldModule0A0V"},{"text":", ","kind":"text"},{"text":"Entity","kind":"typeIdentifier","identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/Entity","preciseIdentifier":"s:11WorldModule6EntityV"},{"text":") -> ","kind":"text"},{"text":"Void","kind":"typeIdentifier","preciseIdentifier":"s:s4Voida"},{"text":") ","kind":"text"},{"text":"where","kind":"keyword"},{"text":" repeat each ","kind":"text"},{"text":"T","kind":"typeIdentifier"},{"text":" : ","kind":"text"},{"text":"QueryTerm","kind":"typeIdentifier","identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/QueryTerm","preciseIdentifier":"s:11WorldModule9QueryTermP"}],"platforms":["Linux"]}]},{"kind":"parameters","parameters":[{"content":[{"type":"paragraph","inlineContent":[{"text":"The query whose matches to watch.","type":"text"}]}],"name":"query"},{"content":[{"inlineContent":[{"text":"The closure to run, given the world and the entity that started matching.","type":"text"}],"type":"paragraph"}],"name":"hook"}]},{"kind":"content","content":[{"type":"heading","level":2,"anchor":"discussion","text":"Discussion"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Use this method to respond when an entity gains the combination of components a query"},{"type":"text","text":" "},{"type":"text","text":"describes, rather than a single component. The hook runs when spawning, inserting,"},{"type":"text","text":" "},{"type":"text","text":"removing or applying a command makes an entity match. Entities that already match when"},{"type":"text","text":" "},{"type":"text","text":"you register the hook don’t run it. Query hooks run at the same point component hooks do"},{"type":"text","text":" "},{"type":"text","text":"(see the component "},{"type":"codeVoice","code":"onAdd(_:perform:)"},{"type":"text","text":")."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Only the query’s structural conditions count: its component terms and the types its"},{"type":"text","text":" "},{"type":"text","text":"filter requires, excludes or skips by default, the conditions a cache of the query keeps"},{"type":"text","text":" "},{"type":"text","text":"("},{"type":"reference","identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/World\/cache(_:)","isActive":true},{"type":"text","text":"). The following example counts the entities that start moving:"}]},{"type":"codeListing","code":["struct MoverCount: Resource { var count = 0 }","","var world = World()","world.resources.insert(MoverCount())","world.onAdd(Query(Position.self, Velocity.self).without(Frozen.self)) { world, _ in","    world.resources[MoverCount.self].count += 1","}","","let rock = world.spawn(Position(x: 0, y: 0))","world.insert(Velocity(dx: 1, dy: 0), into: rock)","print(world.resources[MoverCount.self].count)","\/\/ Prints \"1\""],"syntax":"swift"},{"type":"aside","name":"Complexity","style":"note","content":[{"type":"paragraph","inlineContent":[{"text":"That of ","type":"text"},{"type":"reference","identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/World\/cache(_:)","isActive":true},{"text":" when the world keeps no cache of the query’s","type":"text"},{"text":" ","type":"text"},{"text":"conditions; otherwise, O(1) amortized.","type":"text"}]}]}]}],"sections":[],"hierarchy":{"paths":[["doc:\/\/WorldModule\/documentation\/WorldModule","doc:\/\/WorldModule\/documentation\/WorldModule\/World"]]},"seeAlsoSections":[{"anchor":"Responding-to-Component-Changes-with-Hooks","identifiers":["doc:\/\/WorldModule\/documentation\/WorldModule\/World\/onAdd(_:perform:)-27g0l","doc:\/\/WorldModule\/documentation\/WorldModule\/World\/onInsert(_:perform:)","doc:\/\/WorldModule\/documentation\/WorldModule\/World\/onRemove(_:perform:)-2t2p","doc:\/\/WorldModule\/documentation\/WorldModule\/World\/onRemove(_:perform:)-5cn3d","doc:\/\/WorldModule\/documentation\/WorldModule\/World\/removeHooks(of:)"],"title":"Responding to Component Changes with Hooks","generated":true}],"references":{"doc://WorldModule/documentation/WorldModule/World/onRemove(_:perform:)-2t2p":{"url":"\/documentation\/worldmodule\/world\/onremove(_:perform:)-2t2p","type":"topic","abstract":[{"text":"Registers a closure to run whenever an entity loses a component of the given type.","type":"text"}],"role":"symbol","kind":"symbol","title":"onRemove(_:perform:)","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"onRemove","kind":"identifier"},{"text":"<","kind":"text"},{"text":"C","kind":"genericParameter"},{"text":">(","kind":"text"},{"text":"C","kind":"typeIdentifier"},{"text":".Type, ","kind":"text"},{"text":"perform","kind":"externalParam"},{"text":": (","kind":"text"},{"text":"inout","kind":"keyword"},{"text":" ","kind":"text"},{"text":"World","kind":"typeIdentifier","preciseIdentifier":"s:11WorldModule0A0V"},{"text":", ","kind":"text"},{"text":"Entity","preciseIdentifier":"s:11WorldModule6EntityV","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"C","kind":"typeIdentifier"},{"text":") -> ","kind":"text"},{"text":"Void","preciseIdentifier":"s:s