ift","type":"codeListing","code":["struct MoverCount: Resource { var count = 0 }","","var world = World()","world.resources.insert(MoverCount())","world.onAdd(Query(Position.self, Velocity.self).without(Frozen.self)) { world, _ in","    world.resources[MoverCount.self].count += 1","}","","let rock = world.spawn(Position(x: 0, y: 0))","world.insert(Velocity(dx: 1, dy: 0), into: rock)","print(world.resources[MoverCount.self].count)","\/\/ Prints \"1\""]},{"style":"note","type":"aside","name":"Complexity","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"That of "},{"type":"reference","isActive":true,"identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/World\/cache(_:)"},{"type":"text","text":" when the world keeps no cache of the query’s"},{"type":"text","text":" "},{"type":"text","text":"conditions; otherwise, O(1) amortized."}]}]}],"kind":"content"}],"references":{"doc://WorldModule/documentation/WorldModule/Entity":{"type":"topic","navigatorTitle":[{"kind":"identifier","text":"Entity"}],"url":"\/documentation\/worldmodule\/entity","title":"Entity","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"Entity"}],"identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/Entity","kind":"symbol","role":"symbol","abstract":[{"type":"text","text":"A handle that identifies one entity in a world."}]},"doc://WorldModule/documentation/WorldModule/QueryTerm":{"role":"symbol","type":"topic","abstract":[{"text":"A type that can be a term of a query, deciding which entities match and what the query reads","type":"text"},{"text":" ","type":"text"},{"text":"from each.","type":"text"}],"identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/QueryTerm","url":"\/documentation\/worldmodule\/queryterm","fragments":[{"text":"protocol","kind":"keyword"},{"text":" ","kind":"text"},{"text":"QueryTerm","kind":"identifier"}],"kind":"symbol","navigatorTitle":[{"text":"QueryTerm","kind":"identifier"}],"