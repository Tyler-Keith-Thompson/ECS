{"seeAlsoSections":[{"anchor":"Detecting-Changes","generated":true,"identifiers":["doc:\/\/WorldModule\/documentation\/WorldModule\/World\/changeTick","doc:\/\/WorldModule\/documentation\/WorldModule\/World\/lastRun","doc:\/\/WorldModule\/documentation\/WorldModule\/World\/trackChanges(of:)"],"title":"Detecting Changes"}],"schemaVersion":{"patch":0,"major":0,"minor":3},"primaryContentSections":[{"declarations":[{"tokens":[{"kind":"attribute","text":"@discardableResult"},{"kind":"text","text":" "},{"kind":"keyword","text":"mutating"},{"kind":"text","text":" "},{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"advanceChangeTick"},{"kind":"text","text":"() -> "},{"identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/ChangeTick","kind":"typeIdentifier","text":"ChangeTick","preciseIdentifier":"s:11WorldModule10ChangeTickV"}],"languages":["swift"],"platforms":["Linux"]}],"kind":"declarations"},{"kind":"content","content":[{"anchor":"return-value","level":2,"type":"heading","text":"Return Value"},{"inlineContent":[{"type":"text","text":"The new tick."}],"type":"paragraph"}]},{"kind":"content","content":[{"anchor":"discussion","level":2,"type":"heading","text":"Discussion"},{"inlineContent":[{"text":"Use this method to mark a point in the world’s history. Afterward, a filter such as","type":"text"},{"text":" ","type":"text"},{"identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/QueryFilter\/changed(_:since:)-swift.type.method","type":"reference","isActive":true},{"text":" with the earlier tick finds exactly","type":"text"},{"text":" ","type":"text"},{"text":"the components changed since that point. The following example changes one entity’s","type":"text"},{"text":" ","type":"text"},{"text":"health after a checkpoint and then finds it:","type":"text"}],"type":"paragraph"},{"syntax":"swift","type":"codeListing","code":["var world = World()","world.spawn(Health(current: 10))","let hero = world.spawn(Health(current: 10))","","let checkpoint = world.changeTick","world.advanceChangeTick()","world[Health.self, of: hero].current -= 1","","let changed = world.query(Health.self).changed(Health.self, since: checkpoint)","print(changed.map(\\.entity) == [hero])","\/\/ Prints \"true\""]},{"inlineContent":[{"type":"text","text":"A schedule calls this method before each system it runs."}],"type":"paragraph"},{"name":"Complexity","style":"note","content":[{"type":"paragraph","inlineContent":[{"text":"O(1), plus the cost of refreshing the world’s value indexes, if it has any.","type":"text"}]}],"type":"aside"}]}],"sections":[],"hierarchy":{"paths":[["doc:\/\/WorldModule\/documentation\/WorldModule","doc:\/\/WorldModule\/documentation\/WorldModule\/World"]]},"identifier":{"url":"doc:\/\/WorldModule\/documentation\/WorldModule\/World\/advanceChangeTick()","interfaceLanguage":"swift"},"abstract":[{"text":"Starts a new change tick, so components added or changed from now on are newer than every","type":"text"},{"text":" ","type":"text"},{"text":"earlier tick.","type":"text"}],"kind":"symbol","variants":[{"paths":["\/documentation\/worldmodule\/world\/advancechangetick()"],"traits":[{"interfaceLanguage":"swift"}]}],"metadata":{"symbolKind":"method","title":"advanceChangeTick()","modules":[{"name":"WorldModule"}],"fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"advanceChangeTick","kind":"identifier"},{"text":"() -> ","kind":"text"},{"preciseIdentifier":"s:11WorldModule10ChangeTickV","text":"ChangeTick","kind":"typeIdentifier"}],"remoteSource":{"url":"https:\/\/github.com\/Tyler-Keith-Thompson\/ECS\/blob\/main\/Sources\/WorldModule\/World.swift#L211","fileName":"World.swift"},"role":"symbol","roleHeading":"Instance Method","externalID":"s:11WorldModule0A0V17advanceChangeTickAA0dE0VyF"},"references":{"doc://WorldModule/documentation/WorldModule/World":{"kind":"symbol","abstract":[{"text":"A collection of entities, the components they hold, and resources.","type":"text"