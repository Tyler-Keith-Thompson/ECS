{"seeAlsoSections":[{"anchor":"Detecting-Changes","identifiers":["doc:\/\/WorldModule\/documentation\/WorldModule\/World\/changeTick","doc:\/\/WorldModule\/documentation\/WorldModule\/World\/lastRun","doc:\/\/WorldModule\/documentation\/WorldModule\/World\/trackChanges(of:)"],"generated":true,"title":"Detecting Changes"}],"hierarchy":{"paths":[["doc:\/\/WorldModule\/documentation\/WorldModule","doc:\/\/WorldModule\/documentation\/WorldModule\/World"]]},"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/WorldModule\/documentation\/WorldModule\/World\/advanceChangeTick()"},"schemaVersion":{"major":0,"minor":3,"patch":0},"sections":[],"metadata":{"symbolKind":"method","roleHeading":"Instance Method","remoteSource":{"fileName":"World.swift","url":"https:\/\/github.com\/Tyler-Keith-Thompson\/ECS\/blob\/main\/Sources\/WorldModule\/World.swift#L211"},"title":"advanceChangeTick()","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"advanceChangeTick"},{"kind":"text","text":"() -> "},{"kind":"typeIdentifier","preciseIdentifier":"s:11WorldModule10ChangeTickV","text":"ChangeTick"}],"modules":[{"name":"WorldModule"}],"externalID":"s:11WorldModule0A0V17advanceChangeTickAA0dE0VyF","role":"symbol"},"variants":[{"paths":["\/documentation\/worldmodule\/world\/advancechangetick()"],"traits":[{"interfaceLanguage":"swift"}]}],"kind":"symbol","primaryContentSections":[{"kind":"declarations","declarations":[{"platforms":["Linux"],"tokens":[{"text":"@discardableResult","kind":"attribute"},{"text":" ","kind":"text"},{"text":"mutating","kind":"keyword"},{"text":" ","kind":"text"},{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"advanceChangeTick","kind":"identifier"},{"text":"() -> ","kind":"text"},{"text":"ChangeTick","identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/ChangeTick","preciseIdentifier":"s:11WorldModule10ChangeTickV","kind":"typeIdentifier"}],"languages":["swift"]}]},{"kind":"content","content":[{"type":"heading","level":2,"text":"Return Value","anchor":"return-value"},{"type":"paragraph","inlineContent":[{"text":"The new tick.","type":"text"}]}]},{"kind":"content","content":[{"level":2,"type":"heading","text":"Discussion","anchor":"discussion"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Use this method to mark a point in the world’s history. Afterward, a filter such as"},{"type":"text","text":" "},{"type":"reference","isActive":true,"identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/QueryFilter\/changed(_:since:)-swift.type.method"},{"type":"text","text":" with the earlier tick finds exactly"},{"type":"text","text":" "},{"type":"text","text":"the components changed since that point. The following example changes one entity’s"},{"type":"text","text":" "},{"type":"text","text":"health after a checkpoint and then finds it:"}]},{"type":"codeListing","syntax":"swift","code":["var world = World()","world.spawn(Health(current: 10))","let hero = world.spawn(Health(current: 10))","","let checkpoint = world.changeTick","world.advanceChangeTick()","world[Health.self, of: hero].current -= 1","","let changed = world.query(Health.self).changed(Health.self, since: checkpoint)","print(changed.map(\\.entity) == [hero])","\/\/ Prints \"true\""]},{"type":"paragraph","inlineContent":[{"type":"text","text":"A schedule calls this method before each system it runs."}]},{"style":"note","type":"aside","content":[{"inlineContent":[{"type":"text","text":"O(1), plus the cost of refreshing the world’s value indexes, if it has any."}],"type":"paragraph"}],"name":"Complexity"}]}],"abstract":[{"type":"text","text":"Starts a new change tick, so components added or changed from now on are newer than every"},{"type":"text","text":" "},{"type":"text","text":"earlier tick."}],"references":{"doc://WorldModule/documentation/WorldModule/World/trackChanges(of:)":{"role":"symbol","type":"topic","identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/World\