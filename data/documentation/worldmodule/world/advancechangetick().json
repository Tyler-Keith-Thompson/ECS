{"abstract":[{"type":"text","text":"Starts a new change tick, so components added or changed from now on are newer than every"},{"type":"text","text":" "},{"type":"text","text":"earlier tick."}],"sections":[],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/WorldModule\/documentation\/WorldModule\/World\/advanceChangeTick()"},"variants":[{"paths":["\/documentation\/worldmodule\/world\/advancechangetick()"],"traits":[{"interfaceLanguage":"swift"}]}],"primaryContentSections":[{"kind":"declarations","declarations":[{"languages":["swift"],"tokens":[{"kind":"attribute","text":"@discardableResult"},{"kind":"text","text":" "},{"kind":"keyword","text":"mutating"},{"kind":"text","text":" "},{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"advanceChangeTick"},{"kind":"text","text":"() -> "},{"kind":"typeIdentifier","preciseIdentifier":"s:11WorldModule10ChangeTickV","text":"ChangeTick","identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/ChangeTick"}],"platforms":["Linux"]}]},{"content":[{"anchor":"return-value","type":"heading","level":2,"text":"Return Value"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The new tick."}]}],"kind":"content"},{"content":[{"anchor":"discussion","text":"Discussion","type":"heading","level":2},{"inlineContent":[{"type":"text","text":"Use this method to mark a point in the world’s history. Afterward, a filter such as"},{"type":"text","text":" "},{"type":"reference","identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/QueryFilter\/changed(_:since:)-swift.type.method","isActive":true},{"type":"text","text":" with the earlier tick finds exactly"},{"type":"text","text":" "},{"type":"text","text":"the components changed since that point. The following example changes one entity’s"},{"type":"text","text":" "},{"type":"text","text":"health after a checkpoint and then finds it:"}],"type":"paragraph"},{"code":["var world = World()","world.spawn(Health(current: 10))","let hero