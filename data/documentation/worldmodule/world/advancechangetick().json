{"identifier":{"url":"doc:\/\/WorldModule\/documentation\/WorldModule\/World\/advanceChangeTick()","interfaceLanguage":"swift"},"abstract":[{"type":"text","text":"Starts a new change tick, so components added or changed from now on are newer than every"},{"type":"text","text":" "},{"type":"text","text":"earlier tick."}],"schemaVersion":{"major":0,"patch":0,"minor":3},"primaryContentSections":[{"kind":"declarations","declarations":[{"platforms":["Linux"],"tokens":[{"text":"@discardableResult","kind":"attribute"},{"text":" ","kind":"text"},{"text":"mutating","kind":"keyword"},{"text":" ","kind":"text"},{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"advanceChangeTick","kind":"identifier"},{"text":"() -> ","kind":"text"},{"text":"ChangeTick","kind":"typeIdentifier","preciseIdentifier":"s:11WorldModule10ChangeTickV","identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/ChangeTick"}],"languages":["swift"]}]},{"content":[{"type":"heading","anchor":"return-value","text":"Return Value","level":2},{"type":"paragraph","inlineContent":[{"type":"text","text":"The new tick."}]}],"kind":"content"},{"content":[{"anchor":"discussion","text":"Discussion","level":2,"type":"heading"},{"inlineContent":[{"type":"text","text":"Use this method to mark a point in the world’s history. Afterward, a filter such as"},{"type":"text","text":" "},{"type":"reference","identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/QueryFilter\/changed(_:since:)-swift.type.method","isActive":true},{"type":"text","text":" with the earlier tick finds exactly"},{"type":"text","text":" "},{"type":"text","text":"the components changed since that point. The following example changes one entity’s"},{"type":"text","text":" "},{"type":"text","text":"health after a checkpoint and then finds it:"}],"type":"paragraph"},{"code":["var world = World()","world.spawn(Health(current: 10))","let hero = world.spawn(Health(current: 10))","","let checkpoint = world.changeTick","world.advanceC