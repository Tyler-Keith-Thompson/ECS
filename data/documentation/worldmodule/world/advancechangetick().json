ontent":[{"text":"The new tick.","type":"text"}],"type":"paragraph"}]},{"kind":"content","content":[{"level":2,"text":"Discussion","type":"heading","anchor":"discussion"},{"inlineContent":[{"type":"text","text":"Use this method to mark a point in the world’s history. Afterward, a filter such as"},{"type":"text","text":" "},{"type":"reference","isActive":true,"identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/QueryFilter\/changed(_:since:)-swift.type.method"},{"type":"text","text":" with the earlier tick finds exactly"},{"type":"text","text":" "},{"type":"text","text":"the components changed since that point. The following example changes one entity’s"},{"type":"text","text":" "},{"type":"text","text":"health after a checkpoint and then finds it:"}],"type":"paragraph"},{"code":["var world = World()","world.spawn(Health(current: 10))","let hero = world.spawn(Health(current: 10))","","let checkpoint = world.changeTick","world.advanceChangeTick()","world[Health.self, of: hero].current -= 1","","let changed = world.query(Health.self).changed(Health.self, since: checkpoint)","print(changed.map(\\.entity) == [hero])","\/\/ Prints \"true\""],"syntax":"swift","type":"codeListing"},{"inlineContent":[{"type":"text","text":"A schedule calls this method before each system it runs."}],"type":"paragraph"},{"name":"Complexity","content":[{"inlineContent":[{"text":"O(1), plus the cost of refreshing the world’s value indexes, if it has any.","type":"text"}],"type":"paragraph"}],"style":"note","type":"aside"}]}],"sections":[],"abstract":[{"type":"text","text":"Starts a new change tick, so components added or changed from now on are newer than every"},{"type":"text","text":" "},{"type":"text","text":"earlier tick."}],"references":{"doc://WorldModule/documentation/WorldModule/World/changeTick":{"identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/World\/changeTick","abstract":[{"text":"The tick the world stamps on every component it adds or changes.","type":"text"}