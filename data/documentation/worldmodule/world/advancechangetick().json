{"sections":[],"kind":"symbol","metadata":{"title":"advanceChangeTick()","symbolKind":"method","modules":[{"name":"WorldModule"}],"externalID":"s:11WorldModule0A0V17advanceChangeTickAA0dE0VyF","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"advanceChangeTick","kind":"identifier"},{"text":"() -> ","kind":"text"},{"text":"ChangeTick","kind":"typeIdentifier","preciseIdentifier":"s:11WorldModule10ChangeTickV"}],"role":"symbol","roleHeading":"Instance Method","remoteSource":{"url":"https:\/\/github.com\/Tyler-Keith-Thompson\/ECS\/blob\/main\/Sources\/WorldModule\/World.swift#L211","fileName":"World.swift"}},"schemaVersion":{"major":0,"minor":3,"patch":0},"hierarchy":{"paths":[["doc:\/\/WorldModule\/documentation\/WorldModule","doc:\/\/WorldModule\/documentation\/WorldModule\/World"]]},"identifier":{"url":"doc:\/\/WorldModule\/documentation\/WorldModule\/World\/advanceChangeTick()","interfaceLanguage":"swift"},"abstract":[{"type":"text","text":"Starts a new change tick, so components added or changed from now on are newer than every"},{"type":"text","text":" "},{"type":"text","text":"earlier tick."}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/worldmodule\/world\/advancechangetick()"]}],"primaryContentSections":[{"kind":"declarations","declarations":[{"tokens":[{"text":"@discardableResult","kind":"attribute"},{"text":" ","kind":"text"},{"text":"mutating","kind":"keyword"},{"text":" ","kind":"text"},{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"advanceChangeTick","kind":"identifier"},{"text":"() -> ","kind":"text"},{"text":"ChangeTick","kind":"typeIdentifier","preciseIdentifier":"s:11WorldModule10ChangeTickV","identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/ChangeTick"}],"platforms":["Linux"],"languages":["swift"]}]},{"kind":"content","content":[{"type":"heading","text":"Return Value","level":2,"anchor":"return-value"},{"type":"paragraph","inlineContent":[{"text":"The new tick.","type":"text"}]}]},{"kind":"content","content":[{"anchor":"discussion","level":2,"text":"Discussion","type":"heading"},{"inlineContent":[{"type":"text","text":"Use this method to mark a point in the world’s history. Afterward, a filter such as"},{"type":"text","text":" "},{"type":"reference","identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/QueryFilter\/changed(_:since:)-swift.type.method","isActive":true},{"type":"text","text":" with the earlier tick finds exactly"},{"type":"text","text":" "},{"type":"text","text":"the components changed since that point. The following example changes one entity’s"},{"type":"text","text":" "},{"type":"text","text":"health after a checkpoint and then finds it:"}],"type":"paragraph"},{"code":["var world = World()","world.spawn(Health(current: 10))","let hero = world.spawn(Health(current: 10))","","let checkpoint = world.changeTick","world.advanceChangeTick()","world[Health.self, of: hero].current -= 1","","let changed = world.query(Health.self).changed(Health.self, since: checkpoint)","print(changed.map(\\.entity) == [hero])","\/\/ Prints \"true\""],"syntax":"swift","type":"codeListing"},{"inlineContent":[{"type":"text","text":"A schedule calls this method before each system it runs."}],"type":"paragraph"},{"name":"Complexity","style":"note","content":[{"inlineContent":[{"type":"text","text":"O(1), plus the cost of refreshing the world’s value indexes, if it has any."}],"type":"paragraph"}],"type":"aside"}]}],"seeAlsoSections":[{"generated":true,"anchor":"Detecting-Changes","identifiers":["doc:\/\/WorldModule\/documentation\/WorldModule\/World\/changeTick","doc:\/\/WorldModule\/documentation\/WorldModule\/World\/lastRun","doc:\/\/WorldModule\/documentation\/WorldModule\/World\/trackChanges(of:)"],"title":"Detecting Changes"}],"references":{"doc://WorldModule/documentation/WorldModule/World/advanceChangeTick()":{"url":"\/documentation\/worldmodule\/world\/advancechangetick()","title":"advanceChangeTick()","fr