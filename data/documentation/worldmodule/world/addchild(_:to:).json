Active":true,"type":"reference"},{"text":"). If ","type":"text"},{"type":"codeVoice","code":"child"},{"text":" already has a parent,","type":"text"},{"text":" ","type":"text"},{"text":"it moves to ","type":"text"},{"type":"codeVoice","code":"parent"},{"text":", taking its own descendants with it. Once linked, despawning","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"parent"},{"text":" despawns ","type":"text"},{"type":"codeVoice","code":"child"},{"text":" too.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"The following example attaches a turret to a ship, then moves it to a second ship:"}],"type":"paragraph"},{"syntax":"swift","type":"codeListing","code":["var world = World()","let flagship = world.spawn(Name(value: \"Flagship\"))","let escort = world.spawn(Name(value: \"Escort\"))","let turret = world.spawn(Name(value: \"Turret\"))","","try world.addChild(turret, to: flagship)","try world.addChild(turret, to: escort)","print(world.children(of: flagship).isEmpty)","\/\/ Prints \"true\"","print(world.parent(of: turret) == escort)","\/\/ Prints \"true\""]},{"content":[{"inlineContent":[{"type":"text","text":""},{"identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/CyclicHierarchy","type":"reference","isActive":true},{"type":"text","text":" if "},{"code":"parent","type":"codeVoice"},{"type":"text","text":" is "},{"code":"child","type":"codeVoice"},{"type":"text","text":" or one of its descendants. The world"},{"type":"text","text":" "},{"type":"text","text":"is unchanged."}],"type":"paragraph"}],"style":"note","type":"aside","name":"Throws"},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Both entities are live. The checked spelling,"},{"type":"text","text":" "},{"isActive":true,"type":"reference","identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/World\/addChild(_:checkedTo:)"},{"type":"text","text":", throws instead."}]}],"style":"note","type":"aside","name":"Precond