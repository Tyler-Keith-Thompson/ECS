{"kind":"symbol","seeAlsoSections":[{"generated":true,"anchor":"Saving-and-Restoring","title":"Saving and Restoring","identifiers":["doc:\/\/WorldModule\/documentation\/WorldModule\/World\/snapshot(_:)","doc:\/\/WorldModule\/documentation\/WorldModule\/World\/init(restoring:)-6alog","doc:\/\/WorldModule\/documentation\/WorldModule\/World\/scene(_:)","doc:\/\/WorldModule\/documentation\/WorldModule\/World\/init(restoring:)-7m7do"]}],"schemaVersion":{"major":0,"minor":3,"patch":0},"hierarchy":{"paths":[["doc:\/\/WorldModule\/documentation\/WorldModule","doc:\/\/WorldModule\/documentation\/WorldModule\/World"]]},"identifier":{"url":"doc:\/\/WorldModule\/documentation\/WorldModule\/World\/spawn(contentsOf:)","interfaceLanguage":"swift"},"abstract":[{"type":"text","text":"Adds the entities of a scene to the world as new entities, and inserts the scene’s"},{"type":"text","text":" "},{"type":"text","text":"resources."}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/worldmodule\/world\/spawn(contentsof:)"]}],"sections":[],"metadata":{"role":"symbol","roleHeading":"Instance Method","remoteSource":{"url":"https:\/\/github.com\/Tyler-Keith-Thompson\/ECS\/blob\/main\/Sources\/WorldModule\/Scene.swift#L580","fileName":"Scene.swift"},"fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"spawn","kind":"identifier"},{"kind":"text","text":"("},{"kind":"externalParam","text":"contentsOf"},{"kind":"text","text":": "},{"preciseIdentifier":"s:11WorldModule5SceneV","kind":"typeIdentifier","text":"Scene"},{"kind":"text","text":") -> ["},{"preciseIdentifier":"s:11WorldModule6EntityV","kind":"typeIdentifier","text":"Entity"},{"kind":"text","text":" : "},{"preciseIdentifier":"s:11WorldModule6EntityV","kind":"typeIdentifier","text":"Entity"},{"kind":"text","text":"]"}],"extendedModule":"WorldModule","title":"spawn(contentsOf:)","externalID":"s:11WorldModule0A0V5spawn10contentsOfSDyAA6EntityVAGGAA5SceneV_tF","modules":[{"name":"WorldModule"}],"symbolKind":"method"},"primaryContentSections":[{"declarations":[{"platforms":["Linux"],"tokens":[{"text":"@discardableResult","kind":"attribute"},{"text":" ","kind":"text"},{"text":"mutating","kind":"keyword"},{"text":" ","kind":"text"},{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"spawn","kind":"identifier"},{"text":"(","kind":"text"},{"text":"contentsOf","kind":"externalParam"},{"text":" ","kind":"text"},{"text":"scene","kind":"internalParam"},{"text":": ","kind":"text"},{"text":"Scene","kind":"typeIdentifier","preciseIdentifier":"s:11WorldModule5SceneV","identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/Scene"},{"text":") -> [","kind":"text"},{"text":"Entity","kind":"typeIdentifier","preciseIdentifier":"s:11WorldModule6EntityV","identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/Entity"},{"text":" : ","kind":"text"},{"text":"Entity","kind":"typeIdentifier","preciseIdentifier":"s:11WorldModule6EntityV","identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/Entity"},{"text":"]","kind":"text"}],"languages":["swift"]}],"kind":"declarations"},{"parameters":[{"content":[{"type":"paragraph","inlineContent":[{"text":"The scene whose entities to spawn.","type":"text"}]}],"name":"scene"}],"kind":"parameters"},{"content":[{"anchor":"return-value","type":"heading","text":"Return Value","level":2},{"type":"paragraph","inlineContent":[{"text":"The entity spawned for each live entity of the scene, keyed by the scene’s","type":"text"},{"text":" ","type":"text"},{"text":"entity.","type":"text"}]}],"kind":"content"},{"kind":"mentions","mentions":["doc:\/\/WorldModule\/documentation\/WorldModule\/SavingAndLoadingWorlds"]},{"content":[{"level":2,"type":"heading","text":"Discussion","anchor":"discussion"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Use this method to place a saved group of entities into a world, as many times as you"},{"type":"text","text":" "},{"type":"text","text":"like: a squad of enemies, a room of a level. Each live entity of the scene is spawned as a"},{"type":"text","text":" "},{"type":"text","text":"new entity with its components, hierarchy and relations. The scene’s resources replace"},{"type":"text","text":" "},{"type":"text","text":"any of the same types the world holds."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"A component that conforms to "},{"type":"reference","identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/MapEntities","isActive":true},{"type":"text","text":", such as a relation’s "},{"type":"reference","identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/Targets","isActive":true},{"type":"text","text":", has each"},{"type":"text","text":" "},{"type":"text","text":"of the scene’s entities it names replaced by the entity spawned for it. Entities outside"},{"type":"text","text":" "},{"type":"text","text":"the scene are left as they are. The following example spawns a squad twice, and each"},{"type":"text","text":" "},{"type":"text","text":"copy’s follower follows its own copy’s leader:"}]},{"type":"codeListing","syntax":"swift","code":["var registry = TypeRegistry()","try registry.register(Name.self, named: \"Name\")","try registry.register(Follows.self, named: \"Follows\")","","var squad = World()","let leader = squad.spawn(Name(value: \"Captain\"))","let follower = squad.spawn(Name(value: \"Private\"), Follows(leader: leader))","let saved = squad.scene(registry)","","var world = World()","let alpha = world.spawn(contentsOf: saved)","let bravo = world.spawn(contentsOf: saved)","print(world.count)","\/\/ Prints \"4\"","","let bravoFollower = bravo[follower]!","print(world[Follows.self, of: bravoFollower].leader == bravo[leader])","\/\/ Prints \"true\"","print(alpha[leader] == bravo[leader])","\/\/ Prints \"false\""]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Components are inserted as "},{"type":"codeVoice","code":"insert(_:into:)"},{"type":"text","text":" inserts them, running hooks."}]},{"type":"aside","style":"note","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"O("},{"inlineContent":[{"text":"n","type":"text"}],"type":"emphasis"},{"type":"text","text":"), where "},{"inlineContent":[{"type":"text","text":"n"}],"type":"emphasis"},{"type":"text","text":" is the number of entities and components spawned."}]}],"name":"Complexity"}],"kind":"content"}],"references":{"doc://WorldModule/documentation/WorldModule/World/spawn(contentsOf:)":{"kind":"symbol","type":"topic","identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/World\/spawn(contentsOf:)","title":"spawn(contentsOf:)","url":"\/documentation\/worldmodule\/world\/spawn(contentsof:)","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"spawn"},{"kind":"text","text":"("},{"text":"contentsOf","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"Scene","preciseIdentifier":"s:11WorldModule5SceneV","kind":"typeIdentifier"},{"text":") -> [","kind":"text"},{"text":"Entity","preciseIdentifier":"s:11WorldModule6EntityV","kind":"typeIdentifier"},{"text":" : ","kind":"text"},{"text":"Entity","preciseIdentifier":"s:11WorldModule6EntityV","kind":"typeIdentifier"},{"kind":"text","text":"]"}],"abstract":[{"type":"text","text":"Adds the entities of a scene to the world as new entities, and inserts the scene’s"},{"type":"text","text":" "},{"type":"text","text":"resources."}],"role":"symbol"},"doc://WorldModule/documentation/WorldModule/SavingAndLoadingWorlds":{"kind":"article","type":"topic","identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/SavingAndLoadingWorlds","title":"Saving and Loading Worlds","url":"\/documentation\/worldmodule\/savingandloadingworlds","abstract":[{"text":"Save a world’s entities and components, restore them later, and spawn saved groups of entities","type":"text"},{"text":" ","type":"text"},{"text":"into other worlds.","type":"text"}],"role":"article"},"doc://WorldModul