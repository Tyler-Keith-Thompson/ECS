{"schemaVersion":{"minor":3,"patch":0,"major":0},"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/worldmodule\/world\/spawn(contentsof:)"]}],"seeAlsoSections":[{"title":"Saving and Restoring","identifiers":["doc:\/\/WorldModule\/documentation\/WorldModule\/World\/snapshot(_:)","doc:\/\/WorldModule\/documentation\/WorldModule\/World\/init(restoring:)-6alog","doc:\/\/WorldModule\/documentation\/WorldModule\/World\/scene(_:)","doc:\/\/WorldModule\/documentation\/WorldModule\/World\/init(restoring:)-7m7do"],"anchor":"Saving-and-Restoring","generated":true}],"metadata":{"remoteSource":{"fileName":"Scene.swift","url":"https:\/\/github.com\/Tyler-Keith-Thompson\/ECS\/blob\/main\/Sources\/WorldModule\/Scene.swift#L894"},"roleHeading":"Instance Method","role":"symbol","externalID":"s:11WorldModule0A0V5spawn10contentsOfSDyAA6EntityVAGGAA5SceneV_tF","symbolKind":"method","extendedModule":"WorldModule","title":"spawn(contentsOf:)","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"spawn","kind":"identifier"},{"text":"(","kind":"text"},{"text":"contentsOf","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"Scene","preciseIdentifier":"s:11WorldModule5SceneV","kind":"typeIdentifier"},{"text":") -> [","kind":"text"},{"text":"Entity","preciseIdentifier":"s:11WorldModule6EntityV","kind":"typeIdentifier"},{"text":" : ","kind":"text"},{"text":"Entity","preciseIdentifier":"s:11WorldModule6EntityV","kind":"typeIdentifier"},{"text":"]","kind":"text"}],"modules":[{"name":"WorldModule"}]},"primaryContentSections":[{"declarations":[{"platforms":["Linux"],"tokens":[{"kind":"attribute","text":"@discardableResult"},{"kind":"text","text":" "},{"kind":"keyword","text":"mutating"},{"kind":"text","text":" "},{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"spawn"},{"kind":"text","text":"("},{"kind":"externalParam","text":"contentsOf"},{"kind":"text","text":" "},{"kind":"internalParam","text":"scene"},{"kind":"text","text":": "},{"identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/Scene","kind":"typeIdentifier","text":"Scene","preciseIdentifier":"s:11WorldModule5SceneV"},{"kind":"text","text":") -> ["},{"identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/Entity","kind":"typeIdentifier","text":"Entity","preciseIdentifier":"s:11WorldModule6EntityV"},{"kind":"text","text":" : "},{"identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/Entity","kind":"typeIdentifier","text":"Entity","preciseIdentifier":"s:11WorldModule6EntityV"},{"kind":"text","text":"]"}],"languages":["swift"]}],"kind":"declarations"},{"parameters":[{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The scene whose entities to spawn."}]}],"name":"scene"}],"kind":"parameters"},{"content":[{"anchor":"return-value","level":2,"type":"heading","text":"Return Value"},{"type":"paragraph","inlineContent":[{"text":"The entity spawned for each live entity of the scene, keyed by the scene’s","type":"text"},{"text":" ","type":"text"},{"text":"entity.","type":"text"}]}],"kind":"content"},{"mentions":["doc:\/\/WorldModule\/documentation\/WorldModule\/SavingAndLoadingWorlds"],"kind":"mentions"},{"content":[{"type":"heading","text":"Discussion","anchor":"discussion","level":2},{"inlineContent":[{"text":"Use this method to place a saved group of entities into a world, as many times as you","type":"text"},{"text":" ","type":"text"},{"text":"like: a squad of enemies, a room of a level. Each live entity of the scene is spawned as a","type":"text"},{"text":" ","type":"text"},{"text":"new entity with its components, hierarchy and relations. The scene’s resources replace","type":"text"},{"text":" ","type":"text"},{"text":"any of the same types the world holds.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"A component that conforms to "},{"type":"reference","isActive":true,"identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/MapEntities"},{"type":"text","text":", such as a relation’s "},{"type":"reference","isActive":true,"identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/Targets"},{"type":"text","text":", has each"},{"type":"text","text":" "},{"type":"text","text":"of the scene’s entities it names replaced by the entity spawned for it. Entities outside"},{"type":"text","text":" "},{"type":"text","text":"the scene are left as they are. The following example spawns a squad twice, and each"},{"type":"text","text":" "},{"type":"text","text":"copy’s follower follows its own copy’s leader:"}],"type":"paragraph"},{"type":"codeListing","syntax":"swift","code":["var registry = TypeRegistry()","try registry.register(Name.self, named: \"Name\")","try registry.register(Follows.self, named: \"Follows\")","","var squad = World()","let leader = squad.spawn(Name(value: \"Captain\"))","let follower = squad.spawn(Name(value: \"Private\"), Follows(leader: leader))","let saved = squad.scene(registry)","","var world = World()","let alpha = world.spawn(contentsOf: saved)","let bravo = world.spawn(contentsOf: saved)","print(world.count)","\/\/ Prints \"4\"","","let bravoFollower = bravo[follower]!","print(world[Follows.self, of: bravoFollower].leader == bravo[leader])","\/\/ Prints \"true\"","print(alpha[leader] == bravo[leader])","\/\/ Prints \"false\""]},{"inlineContent":[{"text":"Components are inserted as ","type":"text"},{"code":"insert(_:into:)","type":"codeVoice"},{"text":" inserts them, running hooks.","type":"text"}],"type":"paragraph"},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"O("},{"type":"emphasis","inlineContent":[{"type":"text","text":"n"}]},{"type":"text","text":"), where "},{"type":"emphasis","inlineContent":[{"type":"text","text":"n"}]},{"type":"text","text":" is the number of entities and components spawned."}]}],"type":"aside","style":"note","name":"Complexity"}],"kind":"content"}],"identifier":{"url":"doc:\/\/WorldModule\/documentation\/Wor