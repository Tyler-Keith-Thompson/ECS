m of a level. Each live entity of the scene is spawned as a","type":"text"},{"text":" ","type":"text"},{"text":"new entity with its components, hierarchy and relations. The scene’s resources replace","type":"text"},{"text":" ","type":"text"},{"text":"any of the same types the world holds.","type":"text"}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"A component that conforms to "},{"isActive":true,"type":"reference","identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/MapEntities"},{"type":"text","text":", such as a relation’s "},{"isActive":true,"type":"reference","identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/Targets"},{"type":"text","text":", has each"},{"type":"text","text":" "},{"type":"text","text":"of the scene’s entities it names replaced by the entity spawned for it. Entities outside"},{"type":"text","text":" "},{"type":"text","text":"the scene are left as they are. The following example spawns a squad twice, and each"},{"type":"text","text":" "},{"type":"text","text":"copy’s follower follows its own copy’s leader:"}]},{"type":"codeListing","syntax":"swift","code":["var registry = TypeRegistry()","try registry.register(Name.self, named: \"Name\")","try registry.register(Follows.self, named: \"Follows\")","","var squad = World()","let leader = squad.spawn(Name(value: \"Captain\"))","let follower = squad.spawn(Name(value: \"Private\"), Follows(leader: leader))","let saved = squad.scene(registry)","","var world = World()","let alpha = world.spawn(contentsOf: saved)","let bravo = world.spawn(contentsOf: saved)","print(world.count)","\/\/ Prints \"4\"","","let bravoFollower = bravo[follower]!","print(world[Follows.self, of: bravoFollower].leader == bravo[leader])","\/\/ Prints \"true\"","print(alpha[leader] == bravo[leader])","\/\/ Prints \"false\""]},{"type":"paragraph","inlineContent":[{"text":"Components are inserted as ","type":"text"},{"type":"codeVoice","code":"insert(_:into:)"},{"text":" inserts them, running hooks.","type":"text"}]},{"type":"aside","name":"Complexity","content":[{"type":"paragraph","inlineContent":[{"text":"O(","type":"text"},{"type":"emphasis","inlineContent":[{"type":"text","text":"n"}]},{"text":"), where ","type":"text"},{"type":"emphasis","inlineContent":[{"type":"text","text":"n"}]},{"text":" is the number of entities and components spawned.","type":"text"}]}],"style":"note"}],"kind":"content"}],"references":{"doc://WorldModule/documentation/WorldModule/SavingAndLoadingWorlds":{"role":"article","url":"\/documentation\/worldmodule\/savingandloadingworlds","abstract":[{"type":"text","text":"Save a world’s entities and components, restore them later, and spawn saved groups of entities"},{"type":"text","text":" "},{"type":"text","text":"into other worlds."}],"identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/SavingAndLoadingWorlds","title":"Saving and Loading Worlds","type":"topic","kind":"article"},"doc://WorldModule/documentation/WorldModule/Targets":{"abstract":[{"type":"text","text":"The component that holds a source entity’s targets of a relation, with the relation’s value"},{"type":"text","text":" "},{"type":"text","text":"for each."}],"role":"symbol","url":"\/documentation\/worldmodule\/targets","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Targets","kind":"identifier"}],"type":"topic","title":"Targets","navigatorTitle":[{"text":"Targets","kind":"identifier"}],"kind":"symbol","identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/Targets"},"doc://WorldModule/documentation/WorldModule/World/init(restoring:)-6alog":{"role":"symbol","title":"init(restoring:)","identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/World\/init(restoring:)-6alog","kind":"symbol","url":"\/documentation\/worldmodule\/world\/init(restoring:)-6alog","fragments":[{"text":"init","kind":"identifier"},{"text":"<each ","kind":"text"},{"text":"C","kind":"genericParameter"},{"text":">(","kind":"text"},{"text":"restori