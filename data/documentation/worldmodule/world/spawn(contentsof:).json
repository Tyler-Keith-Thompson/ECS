{"hierarchy":{"paths":[["doc:\/\/WorldModule\/documentation\/WorldModule","doc:\/\/WorldModule\/documentation\/WorldModule\/World"]]},"metadata":{"modules":[{"name":"WorldModule"}],"title":"spawn(contentsOf:)","symbolKind":"method","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"spawn","kind":"identifier"},{"text":"(","kind":"text"},{"text":"contentsOf","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"Scene","kind":"typeIdentifier","preciseIdentifier":"s:11WorldModule5SceneV"},{"text":") -> [","kind":"text"},{"text":"Entity","kind":"typeIdentifier","preciseIdentifier":"s:11WorldModule6EntityV"},{"text":" : ","kind":"text"},{"text":"Entity","kind":"typeIdentifier","preciseIdentifier":"s:11WorldModule6EntityV"},{"text":"]","kind":"text"}],"remoteSource":{"fileName":"Scene.swift","url":"https:\/\/github.com\/Tyler-Keith-Thompson\/ECS\/blob\/main\/Sources\/WorldModule\/Scene.swift#L894"},"role":"symbol","roleHeading":"Instance Method","extendedModule":"WorldModule","externalID":"s:11WorldModule0A0V5spawn10contentsOfSDyAA6EntityVAGGAA5SceneV_tF"},"abstract":[{"text":"Adds the entities of a scene to the world as new entities, and inserts the scene’s","type":"text"},{"text":" ","type":"text"},{"text":"resources.","type":"text"}],"sections":[],"identifier":{"url":"doc:\/\/WorldModule\/documentation\/WorldModule\/World\/spawn(contentsOf:)","interfaceLanguage":"swift"},"seeAlsoSections":[{"generated":true,"anchor":"Saving-and-Restoring","identifiers":["doc:\/\/WorldModule\/documentation\/WorldModule\/World\/snapshot(_:)","doc:\/\/WorldModule\/documentation\/WorldModule\/World\/init(restoring:)-6alog","doc:\/\/WorldModule\/documentation\/WorldModule\/World\/scene(_:)","doc:\/\/WorldModule\/documentation\/WorldModule\/World\/init(restoring:)-7m7do"],"title":"Saving and Restoring"}],"schemaVersion":{"patch":0,"minor":3,"major":0},"kind":"symbol","primaryContentSections":[{"kind":"declarations","declarations":[{"platforms":["Linux"],"languages":["swift"],"tokens":[{"text":"@discardableResult","kind":"attribute"},{"text":" ","kind":"text"},{"text":"mutating","kind":"keyword"},{"text":" ","kind":"text"},{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"spawn","kind":"identifier"},{"text":"(","kind":"text"},{"text":"contentsOf","kind":"externalParam"},{"text":" ","kind":"text"},{"text":"scene","kind":"internalParam"},{"text":": ","kind":"text"},{"identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/Scene","preciseIdentifier":"s:11WorldModule5SceneV","text":"Scene","kind":"typeIdentifier"},{"text":") -> [","kind":"text"},{"identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/Entity","preciseIdentifier":"s:11WorldModule6EntityV","text":"Entity","kind":"typeIdentifier"},{"text":" : ","kind":"text"},{"identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/Entity","preciseIdentifier":"s:11WorldModule6EntityV","text":"Entity","kind":"typeIdentifier"},{"text":"]","kind":"text"}]}]},{"kind":"parameters","parameters":[{"name":"scene","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The scene whose entities to spawn."}]}]}]},{"content":[{"level":2,"text":"Return Value","anchor":"return-value","type":"heading"},{"inlineContent":[{"type":"text","text":"The entity spawned for each live entity of the scene, keyed by the scene’s"},{"type":"text","text":" "},{"type":"text","text":"entity."}],"type":"paragraph"}],"kind":"content"},{"mentions":["doc:\/\/WorldModule\/documentation\/WorldModule\/SavingAndLoadingWorlds"],"kind":"mentions"},{"content":[{"text":"Discussion","type":"heading","anchor":"discussion","level":2},{"inlineContent":[{"type":"text","text":"Use this method to place a saved group of entities into a world, as many times as you"},{"type":"text","text":" "},{"type":"text","text":"like: a squad of enemies, a room of a level. Each live entity of the scene is spawned as a"},{"type":"text","text":" "},{"type":"text","text":"new entity with its components, hierarchy and relations. The scene’s resources replace"},{"type":"text","text":" "},{"type":"text","text":"any of the same types the world holds."}],"type":"paragraph"},{"inlineContent":[{"text":"A component that conforms to ","type":"text"},{"identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/MapEntities","type":"reference","isActive":true},{"text":", such as a relation’s ","type":"text"},{"identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/Targets","type":"reference","isActive":true},{"text":", has each","type":"text"},{"text":" ","type":"text"},{"text":"of the scene’s entities it names replaced by the entity spawned for it. Entities outside","type":"text"},{"text":" ","type":"text"},{"text":"the scene are left as they are. The following example spawns a squad twice, and each","type":"text"},{"text":" ","type":"text"},{"text":"copy’s follower follows its own copy’s leader:","type":"text"}],"type":"paragraph"},{"syntax":"swift","type":"codeListing","code":["var registry = TypeRegistry()","try registry.register(Name.self, named: \"Name\")","try registry.register(Follows.self, named: \"Follows\")","","var squad = World()","let leader = squad.spawn(Name(value: \"Captain\"))","let follower = squad.spawn(Name(value: \"Private\"), Follows(leader: leader))","let saved = squad.scene(registry)","","var world = World()","let alpha = world.spawn(contentsOf: saved)","let bravo = world.spawn(contentsOf: saved)","print(world.count)","\/\/ Prints \"4\"","","let bravoFollower = bravo[follower]!","print(world[Follows.self, of: bravoFollower].leader == bravo[leader])","\/\/ Prints \"true\"","print(alpha[leader] == bravo[leader])","\/\/ Prints \"false\""]},{"inlineContent":[{"type":"text","text":"Components are inserted as "},{"type":"codeVoice","code":"insert(_:into:)"},{"type":"text","text":" inserts them, running hooks."}],"type":"paragraph"},{"type":"aside","name":"Complexity","content":[{"inlineContent":[{"text":"O(","type":"text"},{"type":"emphasis","inlineContent":[{"type":"text","text":"n"}]},{"text":"), where ","type":"text"},{"type":"emphasis","inlineContent":[{"type":"text","text":"n"}]},{"text":" is the number of entities and components spawned.","type":"text"}],"type":"paragraph"}],"style":"note"}],"kind":"content"}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/worldmodule\/world\/spawn(contentsof:)"]}],"references":{"doc://WorldModule/documentation/WorldModule/World/scene(_:)":{"fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"scene","kind":"identifier"},{"text":"(","kind":"text"},{"text":"TypeRegistry","preciseIdentifier":"s:11WorldModule12TypeRegistryV","kind":"typeIdentifier"},{"text":") -> ","kind":"text"},{"text":"Scene","preciseIdentifier":"s:11WorldModule5SceneV","kind":"typeIdentifier"}],"title":"scene(_:)","identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/World\/scene(_:)","abstract":[{"type":"text","text":"Returns a scene of the world’s entities, hierarchy, and the components and resources of"},{"type":"text","text":" "},{"type":"text","text":"the types a registry names."}],"kind":"symbol","type":"topic","url":"\/documentation\/worldmodule\/world\/scene(_:)","role":"symbol"},"doc://WorldModule/documentation/WorldModule/SavingAndLoadingWorlds":{"title":"Saving and Loading Worlds","type":"topic","url":"\/documentation\/worldmodule\/savingandloadingworlds","abstract":[{"type":"text","text":"Save a world’s entities and components, restore them later, and spawn saved groups of entities"},{"type":"text","text":" "},{"type":"text","text":"into other worlds."}],"kind":"article","role":"article","identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/SavingAndLoadingWorlds"},"doc://WorldModule/documentation/WorldModule/MapEntities":{"identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/MapEntities","type":"topic","navigatorTitle":[{"text":"MapEntities","kind":"identifier"}],"url":"\/documentation\/