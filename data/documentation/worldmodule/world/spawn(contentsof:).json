"kind":"keyword"},{"text":" ","kind":"text"},{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"spawn","kind":"identifier"},{"text":"(","kind":"text"},{"text":"contentsOf","kind":"externalParam"},{"text":" ","kind":"text"},{"text":"scene","kind":"internalParam"},{"text":": ","kind":"text"},{"text":"Scene","kind":"typeIdentifier","identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/Scene","preciseIdentifier":"s:11WorldModule5SceneV"},{"text":") -> [","kind":"text"},{"text":"Entity","kind":"typeIdentifier","identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/Entity","preciseIdentifier":"s:11WorldModule6EntityV"},{"text":" : ","kind":"text"},{"text":"Entity","kind":"typeIdentifier","identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/Entity","preciseIdentifier":"s:11WorldModule6EntityV"},{"text":"]","kind":"text"}],"languages":["swift"],"platforms":["Linux"]}],"kind":"declarations"},{"parameters":[{"content":[{"inlineContent":[{"type":"text","text":"The scene whose entities to spawn."}],"type":"paragraph"}],"name":"scene"}],"kind":"parameters"},{"kind":"content","content":[{"type":"heading","anchor":"return-value","level":2,"text":"Return Value"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The entity spawned for each live entity of the scene, keyed by the scene’s"},{"type":"text","text":" "},{"type":"text","text":"entity."}]}]},{"kind":"mentions","mentions":["doc:\/\/WorldModule\/documentation\/WorldModule\/SavingAndLoadingWorlds"]},{"kind":"content","content":[{"type":"heading","text":"Discussion","anchor":"discussion","level":2},{"type":"paragraph","inlineContent":[{"text":"Use this method to place a saved group of entities into a world, as many times as you","type":"text"},{"text":" ","type":"text"},{"text":"like: a squad of enemies, a room of a level. Each live entity of the scene is spawned as a","type":"text"},{"text":" ","type":"text"},{"text":"new entity with its components, hierarchy and relations. The scene’s resources replace","type":"text"},{"text":" ","type":"text"},{"text":"any of the same types the world holds.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"A component that conforms to ","type":"text"},{"isActive":true,"identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/MapEntities","type":"reference"},{"text":", such as a relation’s ","type":"text"},{"isActive":true,"identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/Targets","type":"reference"},{"text":", has each","type":"text"},{"text":" ","type":"text"},{"text":"of the scene’s entities it names replaced by the entity spawned for it. Entities outside","type":"text"},{"text":" ","type":"text"},{"text":"the scene are left as they are. The following example spawns a squad twice, and each","type":"text"},{"text":" ","type":"text"},{"text":"copy’s follower follows its own copy’s leader:","type":"text"}]},{"type":"codeListing","syntax":"swift","code":["var registry = TypeRegistry()","try registry.register(Name.self, named: \"Name\")","try registry.register(Follows.self, named: \"Follows\")","","var squad = World()","let leader = squad.spawn(Name(value: \"Captain\"))","let follower = squad.spawn(Name(value: \"Private\"), Follows(leader: leader))","let saved = squad.scene(registry)","","var world = World()","let alpha = world.spawn(contentsOf: saved)","let bravo = world.spawn(contentsOf: saved)","print(world.count)","\/\/ Prints \"4\"","","let bravoFollower = bravo[follower]!","print(world[Follows.self, of: bravoFollower].leader == bravo[leader])","\/\/ Prints \"true\"","print(alpha[leader] == bravo[leader])","\/\/ Prints \"false\""]},{"type":"paragraph","inlineContent":[{"text":"Components are inserted as ","type":"text"},{"type":"codeVoice","code":"insert(_:into:)"},{"text":" inserts them, running hooks.","type":"text"}]},{"type":"aside","style":"note","name":"Complexity","content":[{"inlineContent":[{"text":"O(","type":"text"},{"inlineContent":[{"type":"text","text":"n"}],"type":"emphasis"},{"text":"), where ","type":"text"},{"inlineContent":[{"text":"n","type":"text"}],"type":"emphasis"},{"text":" is the number of entities and components spawned.","type":"text"}],"type":"paragraph"}]}]}],"abstract":[{"text":"Adds the entities of a scene to the world as new entities, and inserts the scene’s","type":"text"},{"text":" ","type":"text"},{"text":"resources.","type":"text"}],"references":{"doc://WorldModule/documentation/WorldModule/World/spawn(contentsOf:)":{"url":"\/documentation\/worldmodule\/world\/spawn(contentsof:)","title":"spawn(contentsOf:)","type":"topic","abstract":[{"text":"Adds the entities of a scene to the world as new entities, and inserts the scene’s","type":"text"},{"text":" ","type":"text"},{"text":"resources.","type":"text"}],"kind":"symbol","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"spawn","kind":"identifier"},{"text":"(","kind":"text"},{"text":"contentsOf","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"Scene","preciseIdentifier":"s:11WorldModule5SceneV","kind":"typeIdentifier"},{"text":") -> [","kind":"text"},{"text":"Entity","preciseIdentifier":"s:11WorldModule6EntityV","kind":"typeIdentifier"},{"text":" : ","kind":"text"},{"text":"Entity","preciseIdentifier":"s:11WorldModule6EntityV","kind":"typeIdentifier"},{"kind":"text","text":"]"}],"role":"symbol","identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/World\/spawn(contentsOf:)"},"doc://WorldModule/documentation/WorldModule/Entity":{"type":"topic","url":"\/documentation\/worldmodule\/entity","identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/Entity","title":"Entity","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Entity","kind":"identifier"}],"navigatorTitle":[{"text":"Entity","kind":"identifier"}],"kind":"symbol","role":"symbol","abstract":[{"type":"text","text":"A handle that identifies one entity in a world."}]},"doc://WorldModule/documentation/