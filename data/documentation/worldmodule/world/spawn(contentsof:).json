{"seeAlsoSections":[{"title":"Saving and Restoring","identifiers":["doc:\/\/WorldModule\/documentation\/WorldModule\/World\/snapshot(_:)","doc:\/\/WorldModule\/documentation\/WorldModule\/World\/init(restoring:)-6alog","doc:\/\/WorldModule\/documentation\/WorldModule\/World\/scene(_:)","doc:\/\/WorldModule\/documentation\/WorldModule\/World\/init(restoring:)-7m7do"],"anchor":"Saving-and-Restoring","generated":true}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/worldmodule\/world\/spawn(contentsof:)"]}],"primaryContentSections":[{"kind":"declarations","declarations":[{"languages":["swift"],"platforms":["Linux"],"tokens":[{"text":"@discardableResult","kind":"attribute"},{"text":" ","kind":"text"},{"text":"mutating","kind":"keyword"},{"text":" ","kind":"text"},{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"spawn","kind":"identifier"},{"text":"(","kind":"text"},{"text":"contentsOf","kind":"externalParam"},{"text":" ","kind":"text"},{"text":"scene","kind":"internalParam"},{"text":": ","kind":"text"},{"identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/Scene","text":"Scene","preciseIdentifier":"s:11WorldModule5SceneV","kind":"typeIdentifier"},{"text":") -> [","kind":"text"},{"identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/Entity","text":"Entity","preciseIdentifier":"s:11WorldModule6EntityV","kind":"typeIdentifier"},{"text":" : ","kind":"text"},{"identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/Entity","text":"Entity","preciseIdentifier":"s:11WorldModule6EntityV","kind":"typeIdentifier"},{"text":"]","kind":"text"}]}]},{"kind":"parameters","parameters":[{"name":"scene","content":[{"type":"paragraph","inlineContent":[{"text":"The scene whose entities to spawn.","type":"text"}]}]}]},{"kind":"content","content":[{"text":"Return Value","level":2,"type":"heading","anchor":"return-value"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The entity spawned for each live entity of the scene, keyed by the scene’s"},{"type":"text","text":" "},{"type":"text","text":"entity."}]}]},{"kind":"mentions","mentions":["doc:\/\/WorldModule\/documentation\/WorldModule\/SavingAndLoadingWorlds"]},{"kind":"content","content":[{"anchor":"discussion","text":"Discussion","level":2,"type":"heading"},{"inlineContent":[{"type":"text","text":"Use this method to place a saved group of entities into a world, as many times as you"},{"type":"text","text":" "},{"type":"text","text":"like: a squad of enemies, a room of a level. Each live entity of the scene is spawned as a"},{"type":"text","text":" "},{"type":"text","text":"new entity with its components, hierarchy and relations. The scene’s resources replace"},{"type":"text","text":" "},{"type":"text","text":"any of the same types the world holds."}],"type":"paragraph"},{"inlineContent":[{"text":"A component that conforms to ","type":"text"},{"type":"reference","identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/MapEntities","isActive":true},{"text":", such as a relation’s ","type":"text"},{"type":"reference","identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/Targets","isActive":true},{"text":", has each","type":"text"},{"text":" ","type":"text"},{"text":"of the scene’s entities it names replaced by the entity spawned for it. Entities outside","type":"text"},{"text":" ","type":"text"},{"text":"the scene are left as they are. The following example spawns a squad twice, and each","type":"text"},{"text":" ","type":"text"},{"text":"copy’s follower follows its own copy’s leader:","type":"text"}],"type":"paragraph"},{"code":["var registry = TypeRegistry()","try registry.register(Name.self, named: \"Name\")","try registry.register(Follows.self, named: \"Follows\")","","var squad = World()","let leader = squad.spawn(Name(value: \"Captain\"))","let follower = squad.spawn(Name(value: \"Private\"), Follows(leader: leader))","let saved = squad.scene(registry)","","var world = World()","let alpha = world.spawn(contentsOf: saved)","let bravo = world.spawn(contentsOf: saved)","print(world.count)","\/\/ Prints \"4\"","","let bravoFollower = bravo[follower]!","print(world[Follows.self, of: bravoFollower].leader == bravo[leader])","\/\/ Prints \"true\"","print(alpha[leader] == bravo[leader])","\/\/ Prints \"false\""],"syntax":"swift","type":"codeListing"},{"inlineContent":[{"text":"Components are inserted as ","type":"text"},{"code":"insert(_:into:)","type":"codeVoice"},{"text":" inserts them, running hooks.","type":"text"}],"type":"paragraph"},{"content":[{"inlineContent":[{"type":"text","text":"O("},{"type":"emphasis","inlineContent":[{"text":"n","type":"text"}]},{"type":"text","text":"), where "},{"type":"emphasis","inlineContent":[{"text":"n","type":"text"}]},{"type":"text","text":" is the number of entities and components spawned."}],"type":"paragraph"}],"style":"note","name":"Complexity","type":"aside"}]}],"identifier":{"url":"doc:\/\/WorldModule\/documentation\/WorldModule\/World\/spawn(contentsOf:)","interfaceLanguage":"swift"},"hierarchy":{"paths":[["doc:\/\/WorldModule\/documentation\/WorldModule","doc:\/\/WorldModule\/documentation\/WorldModule\/World"]]},"kind":"symbol","abstract":[{"type":"text","text":"Adds the entities of a scene to the world as new entities, and inserts the scene’s"},{"type":"text","text":" "},{"type":"text","text":"resources."}],"schemaVersion":{"minor":3,"major":0,"patch":0},"metadata":{"extendedModule":"WorldModule","title":"spawn(contentsOf:)","role":"symbol","modules":[{"name":"WorldModule"}],"symbolKind":"method","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"spawn"},{"kind":"text","text":"("},{"kind":"externalParam","text":"contentsOf"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"Scene","preciseIdentifier":"s:11WorldModule5SceneV"},{"kind":"text","text":") -> ["},{"kind":"typeIdentifier","text":"Entity","preciseIdentifier":"s:11WorldModule6EntityV"},{"kind":"t