":"text"},{"text":"mutating","kind":"keyword"},{"text":" ","kind":"text"},{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"spawn","kind":"identifier"},{"text":"<each ","kind":"text"},{"text":"B","kind":"genericParameter"},{"text":">(","kind":"text"},{"text":"_","kind":"externalParam"},{"text":" ","kind":"text"},{"text":"bundles","kind":"internalParam"},{"text":": repeat each ","kind":"text"},{"text":"B","kind":"typeIdentifier"},{"text":") -> ","kind":"text"},{"text":"Entity","preciseIdentifier":"s:11WorldModule6EntityV","identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/Entity","kind":"typeIdentifier"},{"text":" ","kind":"text"},{"text":"where","kind":"keyword"},{"text":" repeat each ","kind":"text"},{"text":"B","kind":"typeIdentifier"},{"text":" : ","kind":"text"},{"text":"Bundle","preciseIdentifier":"s:11WorldModule6BundleP","identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/Bundle","kind":"typeIdentifier"}],"platforms":["Linux"],"languages":["swift"]}],"kind":"declarations"},{"kind":"parameters","parameters":[{"name":"bundles","content":[{"type":"paragraph","inlineContent":[{"text":"The components and bundles the new entity holds.","type":"text"}]}]}]},{"content":[{"anchor":"return-value","text":"Return Value","type":"heading","level":2},{"inlineContent":[{"type":"text","text":"The handle of the new entity."}],"type":"paragraph"}],"kind":"content"},{"content":[{"type":"heading","level":2,"text":"Discussion","anchor":"discussion"},{"type":"paragraph","inlineContent":[{"text":"Pass any number of components, or ","type":"text"},{"identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/Bundle","isActive":true,"type":"reference"},{"text":" values that group components together. Each","type":"text"},{"text":" ","type":"text"},{"text":"component is a bundle of itself, so the following example spawns an entity holding both a","type":"text"},{"text":" ","type":"text"},{"text":"position and a velocity:","type":"text"}]},{"t