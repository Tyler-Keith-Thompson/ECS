e\""],"type":"codeListing","syntax":"swift"},{"type":"paragraph","inlineContent":[{"text":"When the bundles hold two components of the same type, the later one is kept. Components","type":"text"},{"text":" ","type":"text"},{"text":"that the spawned components require (","type":"text"},{"type":"reference","identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/Component\/required-u15k","isActive":true},{"text":") are added too, unless","type":"text"},{"text":" ","type":"text"},{"text":"the bundles already include one of the same type.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"The new entity may reuse the slot of a despawned entity, the most recently vacated first,","type":"text"},{"text":" ","type":"text"},{"text":"with a generation one higher than the slot’s last entity, so handles to the despawned","type":"text"},{"text":" ","type":"text"},{"text":"entity stay stale.","type":"text"}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Spawning one, two or three components has overloads specialized for speed."}]},{"name":"Complexity","content":[{"inlineContent":[{"type":"text","text":"O("},{"type":"emphasis","inlineContent":[{"text":"k","type":"text"}]},{"type":"text","text":") amortized, where "},{"type":"emphasis","inlineContent":[{"type":"text","text":"k"}]},{"type":"text","text":" is the number of components."}],"type":"paragraph"}],"type":"aside","style":"note"},{"name":"Precondition","content":[{"type":"paragraph","inlineContent":[{"text":"Fewer than ","type":"text"},{"code":"UInt32.max","type":"codeVoice"},{"text":" slots are in use.","type":"text"}]}],"type":"aside","style":"note"}],"kind":"content"}],"schemaVersion":{"patch":0,"major":0,"minor":3},"variants":[{"paths":["\/documentation\/worldmodule\/world\/spawn(_:)-2slwa"],"traits":[{"interfaceLanguage":"swift"}]}],"references":{"doc://WorldModule/documentation/WorldModule/Bundle":{"role":"symbol","fragments":[{"kind":"keyword","text":"protocol"},{"kind":"text","text":