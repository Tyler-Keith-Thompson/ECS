: 0))","","print(world.contains(Velocity.self, in: ball))","\/\/ Prints \"true\""],"syntax":"swift","type":"codeListing"},{"inlineContent":[{"text":"When the bundles hold two components of the same type, the later one is kept. Components","type":"text"},{"text":" ","type":"text"},{"text":"that the spawned components require (","type":"text"},{"identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/Component\/required-u15k","type":"reference","isActive":true},{"text":") are added too, unless","type":"text"},{"text":" ","type":"text"},{"text":"the bundles already include one of the same type.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"The new entity may reuse the slot of a despawned entity, the most recently vacated first,"},{"type":"text","text":" "},{"type":"text","text":"with a generation one higher than the slot’s last entity, so handles to the despawned"},{"type":"text","text":" "},{"type":"text","text":"entity stay stale."}],"type":"paragraph"},{"inlineContent":[{"text":"Spawning one, two or three components has overloads specialized for speed.","type":"text"}],"type":"paragraph"},{"name":"Complexity","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"O("},{"type":"emphasis","inlineContent":[{"text":"k","type":"text"}]},{"type":"text","text":") amortized, where "},{"type":"emphasis","inlineContent":[{"text":"k","type":"text"}]},{"type":"text","text":" is the number of components."}]}],"style":"note","type":"aside"},{"name":"Precondition","content":[{"inlineContent":[{"type":"text","text":"Fewer than "},{"type":"codeVoice","code":"UInt32.max"},{"type":"text","text":" slots are in use."}],"type":"paragraph"}],"style":"note","type":"aside"}]}],"abstract":[{"type":"text","text":"Creates an entity holding the given components and returns its handle."}],"references":{"doc://WorldModule/documentation/WorldModule/World/spawn(_:)-13jpz":{"role":"symbol","fragments":[{"kind":"keyword","text":"func"},{"kind":"te