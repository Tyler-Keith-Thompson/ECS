odule9QueryTermP","text":"QueryTerm","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"Failure","kind":"typeIdentifier"},{"text":" : ","kind":"text"},{"preciseIdentifier":"s:s5ErrorP","text":"Error","kind":"typeIdentifier"}],"languages":["swift"]}]},{"parameters":[{"name":"type","content":[{"inlineContent":[{"type":"text","text":"The component type to change."}],"type":"paragraph"}]},{"name":"query","content":[{"inlineContent":[{"type":"text","text":"The entities to visit and the components to read from each."}],"type":"paragraph"}]},{"name":"body","content":[{"inlineContent":[{"text":"A closure that changes one entity’s component. If it throws, the visit stops and","type":"text"},{"text":" ","type":"text"},{"text":"the method rethrows the error; changes already made are kept.","type":"text"}],"type":"paragraph"}]}],"kind":"parameters"},{"kind":"content","content":[{"anchor":"discussion","type":"heading","level":2,"text":"Discussion"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The method visits every entity that holds a "},{"type":"codeVoice","code":"W"},{"type":"text","text":" and matches "},{"type":"codeVoice","code":"query"},{"type":"text","text":". For each one, "},{"type":"codeVoice","code":"body"},{"type":"text","text":" "},{"type":"text","text":"receives the entity’s "},{"type":"codeVoice","code":"W"},{"type":"text","text":" to change, and a "},{"type":"reference","isActive":true,"identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/QueryRow"},{"type":"text","text":" carrying the entity and the values"},{"type":"text","text":" "},{"type":"text","text":"of the query’s terms. Every "},{"type":"codeVoice","code":"W"},{"type":"text","text":" visited is marked changed at the world’s current"},{"type":"text","text":" "},{"type":"reference","isActive":true,"identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/World\/changeTick"},{"type":"text","text":". The following example declares two forces and moves the entities that"},{"type":"text","text":" "},{"type":"text","text":"feel at least one of them:"}]},{"syntax":"swift","code":["struct Wind: Component { var force: Double }","struct Thrust: Component { var force: Double }"],"type":"codeListing"},{"syntax":"swift","code":["var world = World()","let kite = world.spawn(Position(x: 0, y: 0), Velocity(dx: 1, dy: 0), Wind(force: 3))","let rocket = world.spawn(Position(x: 0, y: 0), Velocity(dx: 1, dy: 0), Thrust(force: 5))","let cart = world.spawn(Position(x: 0, y: 0), Velocity(dx: 1, dy: 0))","","world.update(Position.self, over: Query(Velocity.self, AnyOf<Wind, Thrust>.self)) { position, row in","    let (velocity, (wind, thrust)) = row.components","    position.x += velocity.dx + (wind?.force ?? 0) + (thrust?.force ?? 0)","}","print(world[Position.self, of: kite])","\/\/ Prints \"Position(x: 4.0, y: 0.0)\"","print(world[Position.self, of: rocket])","\/\/ Prints \"Position(x: 6.0, y: 0.0)\"","print(world[Position.self, of: cart])","\/\/ Prints \"Position(x: 0.0, y: 0.0)\""],"type":"codeListing"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The cart feels neither force, so it doesn’t match the "},{"type":"reference","isActive":true,"identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/AnyOf"},{"type":"text","text":" term and isn’t visited."}]},{"type":"aside","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"O("},{"type":"emphasis","inlineContent":[{"text":"n","type":"text"}]},{"type":"text","text":") for "},{"type":"emphasis","inlineContent":[{"type":"text","text":"n"}]},{"type":"text","text":" entities in the smallest of "},{"code":"W","type":"codeVoice"},{"type":"text","text":" and the component terms, plus"},{"type":"text","text":" "},{"type":"text","text":"a copy of the "},{"code":"W","type":"codeVoice"},{"type":"text","text":" storage when another world shares it."}]}],"style":"note","name":"Complexity"},{"type":"aside","content":[{"inlineContent":[{"type":"text","text":""},{"code":"query","type":"codeVoice"},{"type":"text","text":" doesn’t read "},{"code":"W","type":"codeVoice"},{"type":"text","text":"."}],"type":"paragraph"}],"style":"note","name":"Precondition"}]}],"hierarchy":{"paths":[["doc:\/\/WorldModule\/documentation\/WorldModule","doc:\/\/WorldModule\/documentation\/WorldModule\/World"]]},"metadata":{"title":"update(_:over:body:)","symbolKind":"method","extendedModule":"WorldModule","role":"symbol","remoteSource":{"url":"https:\/\/github.com\/Tyler-Keith-Thompson\/ECS\/blob\/main\/Sources\/WorldModule\/Query.swift#L425","fileName":"Query.swift"},"roleHeading":"Instance Method","modules":[{"name":"WorldModule"}],"externalID":"s:11WorldModule0A0V6update_4over4bodyyxm_AA5QueryVyq_q_Qp_QPGyxz_AA0F3RowVy5ValueQy_q_Qp_QPGtq0_YKXEtq0_YKRv_AA9ComponentRzAA0F4TermR_s5ErrorR0_r1_lF","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"update","kind":"identifier"},{"text":"<","kind":"text"},{"text":"W","kind":"genericParameter"},{"text":", each ","kind":"text"},{"text":"T","kind":"genericParameter"},{"text":", ","kind":"text"},{"text":"Failure","kind":"genericParameter"},{"text":">(","kind":"text"},{"text":"W","kind":"typeIdentifier"},{"text":".Type, ","kind":"text"},{"text":"over","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"Query","kind":"typeIdentifier","preciseIdentifier":"s:11WorldModule5QueryV"},{"text":"<repeat each ","kind":"text"},{"text":"T","kind":"typeIdentifier"},{"text":">, ","kind":"text"},{"text":"body","kind":"externalParam"},{"text":": (","kind":"text"},{"text":"inout","kind":"keyword"},{"text":" ","kind":"text"},{"text":"W","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"QueryRow","kind":"typeIdentifier","preciseIdentifier":"s:11WorldModule8QueryRowV"},{"text":"<repeat (each ","kind":"text"},{"text":"T","kind":"typeIdentifier"},{"text":").","kind":"text"},{"text":"Value","kind":"typeIdentifier","preciseIdentifier":"s:11WorldModule9QueryTermP5ValueQa"},{"text":">) ","kind"