ocumentation\/WorldModule\/Component","preciseIdentifier":"s:11WorldModule9ComponentP","text":"Component"},{"kind":"text","text":", repeat each "},{"kind":"typeIdentifier","text":"T"},{"kind":"text","text":" : "},{"kind":"typeIdentifier","identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/QueryTerm","preciseIdentifier":"s:11WorldModule9QueryTermP","text":"QueryTerm"},{"kind":"text","text":", "},{"kind":"typeIdentifier","text":"Failure"},{"kind":"text","text":" : "},{"kind":"typeIdentifier","preciseIdentifier":"s:s5ErrorP","text":"Error"}]}],"kind":"declarations"},{"kind":"parameters","parameters":[{"name":"type","content":[{"inlineContent":[{"text":"The component type to change.","type":"text"}],"type":"paragraph"}]},{"name":"query","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The entities to visit and the components to read from each."}]}]},{"name":"body","content":[{"inlineContent":[{"type":"text","text":"A closure that changes one entity’s component. If it throws, the visit stops and"},{"type":"text","text":" "},{"type":"text","text":"the method rethrows the error; changes already made are kept."}],"type":"paragraph"}]}]},{"content":[{"level":2,"type":"heading","anchor":"discussion","text":"Discussion"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The method visits every entity that holds a "},{"type":"codeVoice","code":"W"},{"type":"text","text":" and matches "},{"type":"codeVoice","code":"query"},{"type":"text","text":". For each one, "},{"type":"codeVoice","code":"body"},{"type":"text","text":" "},{"type":"text","text":"receives the entity’s "},{"type":"codeVoice","code":"W"},{"type":"text","text":" to change, and a "},{"type":"reference","identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/QueryRow","isActive":true},{"type":"text","text":" carrying the entity and the values"},{"type":"text","text":" "},{"type":"text","text":"of the query’s terms. Every "},{"type":"codeVoice","code":"W"},{"type":"text","text":" visited is marked changed at the world’s current"},{"type":"text","text":" "},{"type":"reference","identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/World\/changeTick","isActive":true},{"type":"text","text":". The following example declares two forces and moves the entities that"},{"type":"text","text":" "},{"type":"text","text":"feel at least one of them:"}]},{"syntax":"swift","code":["struct Wind: Component { var force: Double }","struct Thrust: Component { var force: Double }"],"type":"codeListing"},{"syntax":"swift","code":["var world = World()","let kite = world.spawn(Position(x: 0, y: 0), Velocity(dx: 1, dy: 0), Wind(force: 3))","let rocket = world.spawn(Position(x: 0, y: 0), Velocity(dx: 1, dy: 0), Thrust(force: 5))","let cart = world.spawn(Position(x: 0, y: 0), Velocity(dx: 1, dy: 0))","","world.update(Position.self, over: Query(Velocity.self, AnyOf<Wind, Thrust>.self)) { position, row in","    let (velocity, (wind, thrust)) = row.components","    position.x += velocity.dx + (wind?.force ?? 0) + (thrust?.force ?? 0)","}","print(world[Position.self, of: kite])","\/\/ Prints \"Position(x: 4.0, y: 0.0)\"","print(world[Position.self, of: rocket])","\/\/ Prints \"Position(x: 6.0, y: 0.0)\"","print(world[Position.self, of: cart])","\/\/ Prints \"Position(x: 0.0, y: 0.0)\""],"type":"codeListing"},{"type":"paragraph","inlineContent":[{"text":"The cart feels neither force, so it doesn’t match the ","type":"text"},{"isActive":true,"identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/AnyOf","type":"reference"},{"text":" term and isn’t visited.","type":"text"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"O("},{"type":"emphasis","inlineContent":[{"text":"n","type":"text"}]},{"type":"text","text":") for "},{"type":"emphasis","inlineContent":[{"text":"n","type":"text"}]},{"type":"text","text":" entities in the smallest of "},{"type":"codeVoice","code":"W"},{"type":"text","text":" and the component terms, plus"