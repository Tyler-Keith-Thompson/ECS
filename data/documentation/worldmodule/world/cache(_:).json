{"sections":[],"metadata":{"remoteSource":{"fileName":"QueryCache.swift","url":"https:\/\/github.com\/Tyler-Keith-Thompson\/ECS\/blob\/main\/Sources\/WorldModule\/QueryCache.swift#L127"},"externalID":"s:11WorldModule0A0V5cacheyyAA5QueryVyxxQp_QPGRvzAA0D4TermRzlF","role":"symbol","extendedModule":"WorldModule","symbolKind":"method","modules":[{"name":"WorldModule"}],"fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"cache","kind":"identifier"},{"text":"<each ","kind":"text"},{"text":"T","kind":"genericParameter"},{"text":">(","kind":"text"},{"text":"Query","kind":"typeIdentifier","preciseIdentifier":"s:11WorldModule5QueryV"},{"text":"<repeat each ","kind":"text"},{"text":"T","kind":"typeIdentifier"},{"text":">)","kind":"text"}],"title":"cache(_:)","roleHeading":"Instance Method"},"abstract":[{"type":"text","text":"Keeps a list of the entities that match a query’s structure, so that queries and updates"},{"type":"text","text":" "},{"type":"text","text":"with the same conditions visit only those entities."}],"kind":"symbol","hierarchy":{"paths":[["doc:\/\/WorldModule\/documentation\/WorldModule","doc:\/\/WorldModule\/documentation\/WorldModule\/World"]]},"schemaVersion":{"major":0,"minor":3,"patch":0},"seeAlsoSections":[{"identifiers":["doc:\/\/WorldModule\/documentation\/WorldModule\/World\/group(_:)","doc:\/\/WorldModule\/documentation\/WorldModule\/World\/group(checked:)","doc:\/\/WorldModule\/documentation\/WorldModule\/World\/index(_:)","doc:\/\/WorldModule\/documentation\/WorldModule\/World\/lookup(_:)"],"generated":true,"anchor":"Speeding-Up-Queries","title":"Speeding Up Queries"}],"primaryContentSections":[{"kind":"declarations","declarations":[{"tokens":[{"text":"mutating","kind":"keyword"},{"text":" ","kind":"text"},{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"cache","kind":"identifier"},{"text":"<each ","kind":"text"},{"text":"T","kind":"genericParameter"},{"text":">(","kind":"text"},{"text":"_","kind":"externalParam"},{"text":" ","kind":"text"},{"text":"query","kind":"internalParam"},{"text":": ","kind":"text"},{"identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/Query","preciseIdentifier":"s:11WorldModule5QueryV","text":"Query","kind":"typeIdentifier"},{"text":"<repeat each ","kind":"text"},{"text":"T","kind":"typeIdentifier"},{"text":">) ","kind":"text"},{"text":"where","kind":"keyword"},{"text":" repeat each ","kind":"text"},{"text":"T","kind":"typeIdentifier"},{"text":" : ","kind":"text"},{"identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/QueryTerm","preciseIdentifier":"s:11WorldModule9QueryTermP","text":"QueryTerm","kind":"typeIdentifier"}],"platforms":["Linux"],"languages":["swift"]}]},{"kind":"parameters","parameters":[{"name":"query","content":[{"inlineContent":[{"text":"The query whose matching entities to keep.","type":"text"}],"type":"paragraph"}]}]},{"kind":"content","content":[{"type":"heading","level":2,"anchor":"discussion","text":"Discussion"},{"type":"paragraph","inlineContent":[{"text":"A query normally walks the storage of one of its types and checks every entity there","type":"text"},{"text":" ","type":"text"},{"text":"against the rest of its conditions. When few of those entities match, most of that walk is","type":"text"},{"text":" ","type":"text"},{"text":"wasted. A cached query keeps the matching entities in a list of their own, kept current as","type":"text"},{"text":" ","type":"text"},{"text":"you spawn, insert, remove and despawn, so a visit can walk that list instead.","type":"text"}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Use a cache for a query you run often whose conditions exclude most of the entities it"},{"type":"text","text":" "},{"text":"would otherwise walk, such as the few entities that are awake among many asleep:","type":"text"}]},{"type":"codeListing","syntax":"swift","code":["struct Asleep: Component {}"]},{"type":"codeListing","syntax":"swift","code":["var world = World()","let awake = world.spawn(Position(x: 0, y: 0), Velocity(dx: 1, dy: 0))","let sleeper = world.spawn(Position(x: 0, y: 0), Velocity(dx: 1, dy: 0), Asleep())","","world.cache(Query(Position.self, Velocity.self).without(Asleep.self))","","world.update(Position.self, reading: Velocity.self, where: .without(Asleep.self)) { position, row in","    position.x += row.components.dx","}","print(world[Position.self, of: awake].x, world[Position.self, of: sleeper].x)","\/\/ Prints \"1.0 0.0\""]},{"type":"paragraph","inlineContent":[{"text":"The cache holds the entities that hold every component term of ","type":"text"},{"type":"codeVoice","code":"query"},{"text":" and every type its","type":"text"},{"text":" ","type":"text"},{"text":"filter requires, hold none of the types it excludes or skips by default (such as","type":"text"},{"text":" ","type":"text"},{"type":"reference","identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/Disabled","isActive":true},{"text":"), and pass its groups of alternatives that name no change ticks. A query or","type":"text"},{"text":" ","type":"text"},{"text":"update uses the cache when its own conditions imply the cache’s: it requires every type the","type":"text"},{"text":" ","type":"text"},{"text":"cache requires, excludes every type the cache excludes, and has the same groups of","type":"text"},{"text":" ","type":"text"},{"text":"alternatives. It walks the cache only when the cache is smaller than the storage it would","type":"text"},{"text":" ","type":"text"},{"text":"otherwise walk. A cache never changes which entities a visit finds, only how it finds them.","type":"text"}]},{"type":"paragraph","inlineContent":[{"isActive":true,"identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/AnyOf","type":"reference"},{"text":" terms, change-tick filters and relation filters don’t narrow the cache; a visit","type":"text"},{"text":" ","type":"text"},{"text":"still checks them for each cached entity. Caching the same conditions twice keeps one","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"cache. A copy of the world keeps its caches; a snapshot doesn’t."}]},{"type":"aside","name":"Complexity","style":"note","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"O("},{"type":"emphasis","inlineContent":[{"type":"text","text":"n"}]},{"type":"text","text":"·"},{"type":"emphasis","inlineContent":[{"type":"text","text":"t"}]},{"type":"text","text":") for "},{"type":"emphasis","inlineContent":[{"type":"text","text":"n"}]},{"type":"text","text":" entities in the smallest required type, or every live"},{"type":"text","text":" "},{"type":"text","text":"entity when the query requires none, and "},{"type":"emphasis","inlineContent":[{"type":"text","text":"t"}]},{"type":"text","text":" conditions. Each cache adds O("},{"type":"emphasis","inlineContent":[{"type":"text","text":"t"}]},{"type":"text","text":") to adding"},{"type":"text","text":" "},{"type":"text","text":"or removing a component of a type it names."}]}]}]}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/worldmodule\/world\/cache(_:)"]}],"identifier":{"url":"doc:\/\/WorldModule\/documentation\/WorldModule\/World\/cache(_:)","interfaceLanguage":"swift"},"references":{"doc://WorldModule/documentation/WorldModule/Query":{"kind":"symbol","type":"topic","title":"Query","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"Query"}],"url":"\/documentation\/worldmodule\/query","abstract":[{"type":"text","text":"A description of the entities to visit and the components to read from each."}],"role":"symbol","navigatorTitle":[{"kind":"identifier","text":"Query"}],"identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/Query"},"doc://WorldModule/documentation/WorldModule/QueryTerm":{"kind":"symbol","type":"topic","abstract":[{"type":"text","text":"A type that can be a term of a query, deciding which entities match and what the query reads"},{"type":"text","text":" "},{"type":"text","text":"from each."}],"role":"symbol","fragments":[{"text":"protocol","kind":"keyword"},{"text":" ","kind":"text"},{"text":"QueryTerm","kind":"identifier"}],"title":"QueryTerm","navigatorTitle":[{"text":"QueryTerm","kind":"identifier"}],"identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/QueryTerm","url":"\/documentation\/worldmodule\/queryterm"},"doc://WorldModule/documentation/WorldModule/Disabled":{"kind":"symbol","type":"topic","identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/Disabled","role":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Disabled","kind":"identifier"}],"title":"Disabled","navigatorTitle":[{"text":"Disabled","kind":"identifier"}],"abstract":[{"type":"text","text":"A component that makes queries and updates skip an entity, unless they ask for it."}],"url":"\/documentation\/worldmodule\/disabled"},"doc://WorldModule/documentation/WorldModule":{"abstract":[{"type":"text","text":"Store the state of a game or simulation as entities and components, and read and change it with"},{"type":"text","text":" "},{"type":"text","text":"queries, updates, and commands."}],"url":"\/documentation\/worldmodule","identifier":"doc:\/\/WorldModule\/documentation\/WorldModule","role":"collection","type":"topic","title":"WorldModule","kind":"symbol"},"doc://WorldModule/documentation/WorldModule/World/lookup(_:)":{"kind":"symbol","type":"topic","title":"lookup(_:)","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"lookup","kind":"identifier"},{"text":"<","kind":"text"},{"text":"C","kind":"genericParameter"},{"text":">(","kind":"text"},{"text":"C","kind":"typeIdentifier"},{"text":") -> [","kind":"text"},{"text":"Entity","preciseIdentifier":"s:11WorldModule6EntityV","kind":"typeIdentifier"},{"text":"]","kind":"text"}],"url":"\/documentation\/worldmodule\/world\/lookup(_:)","abstract":[{"text":"Returns the entities holding a component equal to the given value.","type":"text"}],"role":"symbol","identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/World\/lookup(_:)"},"doc://WorldModule/documentation/WorldModule/AnyOf":{"kind":"symbol","type":"topic","title":"AnyOf","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"AnyOf"}],"url":"\/documentation\/worldmodule\/anyof","abstract":[{"type":"text","text":"A group of types an entity matches by matching at least one of them."}],"role":"symbol","navigatorTitle":[{"kind":"identifier","text":"AnyOf"}],"identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/AnyOf"},"doc://WorldModule/documentation/WorldModule/World":{"type":"topic","role":"symbol","abstract":[{"text":"A collection of entities, the components they hold, and resources.","type":"text"}],"fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"World","kind":"identifier"}],"navigatorTitle":[{"text":"World","kind":"identifier"}],"kind":"symbol","title":"World","url":"\/documentation\/worldmodule\/world","identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/World"},"doc://WorldModule/documentation/WorldModule/World/cache(_:)":{"type":"topic","role":"symbol","abstract":[{"text":"Keeps a list of the entities that match a query’s structure, so that queries and updates","type":"text"},{"text":" ","type":"text"},{"text":"with the same conditions visit only those entities.","type":"text"}],"fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"cache","kind":"identifier"},{"text":"<each ","kind":"text"},{"kind":"genericParameter","text":"T"},{"kind":"text","text":">("},{"kind":"typeIdentifier","text":"Query","preciseIdentifier":"s:11WorldModule5QueryV"},{"kind":"text","text":"<repeat each "},{"kind":"typeIdentifier","text":"T"},{"kind":"text","text":">)"}],"kind":"symbol","title":"cache(_:)","url":"\/documentation\/worldmodule\/world\/cache(_:)","identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/World\/cache(_:)"},"doc://WorldModule/documentation/WorldModule/World/group(checked:)":{"kind":"symbol","type":"topic","title":"group(checked:)","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"group"},{"kind":"text","text":"<each "},{"text":"C","kind":"genericParameter"},{"text":">(","kind":"text"},{"text":"checked","kind":"externalParam"},{"text":": repeat (each ","kind":"text"},{"text":"C","kind":"typeIdentifier"},{"text":").Type) ","kind":"text"},{"text":"throws","kind":"keyword"},{"text":"(","kind":"text"},{"preciseIdentifier":"s:11WorldModule10GroupErrorO","text":"GroupError","kind":"typeIdentifier"},{"text":")","kind":"text"}],"url":"\/documentation\/worldmodule\/world\/group(checked:)","abstract":[{"type":"text","text":"Keeps the given component types packed in the same order, throwing an error if they can’t"},{"type":"text","text":" "},{"type":"text","text":"be grouped."}],"role":"symbol","identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/World\/group(checked:)"},"doc://WorldModule/documentation/WorldModule/World/group(_:)":{"type":"topic","role":"symbol","abstract":[{"text":"Keeps the given component types packed in the same order, so that queries and updates of","type":"text"},{"text":" ","type":"text"},{"text":"exactly these types visit their entities without lookups.","type":"text"}],"fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"group"},{"kind":"text","text":"<each "},{"text":"C","kind":"genericParameter"},{"text":">(repeat (each ","kind":"text"},{"text":"C","kind":"typeIdentifier"},{"text":").Type)","kind":"text"}],"kind":"symbol","title":"group(_:)","url":"\/documentation\/worldmodule\/world\/group(_:)","identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/World\/group(_:)"},"doc://WorldModule/documentation/WorldModule/World/index(_:)":{"kind":"symbol","type":"topic","title":"index(_:)","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"index","kind":"identifier"},{"kind":"text","text":"<"},{"kind":"genericParameter","text":"C"},{"kind":"text","text":">("},{"kind":"typeIdentifier","text":"C"},{"kind":"text","text":".Type)"}],"url":"\/documentation\/worldmodule\/world\/index(_:)","abstract":[{"type":"text","text":"Keeps a map from each value of a component type to the entities holding it, so that"},{"type":"text","text":" "},{"type":"reference","identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/World\/lookup(_:)","isActive":true},{"type":"text","text":" finds them without walking the type’s storage."}],"role":"symbol","identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/World\/index(_:)"}}}