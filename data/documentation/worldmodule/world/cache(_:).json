" "},{"type":"text","text":"them for each cached entity. Caching the same conditions twice keeps one cache. A copy of"},{"type":"text","text":" "},{"type":"text","text":"the world keeps its caches; a snapshot does not."}],"type":"paragraph"},{"name":"Complexity","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"O("},{"type":"emphasis","inlineContent":[{"text":"n","type":"text"}]},{"type":"text","text":"·"},{"type":"emphasis","inlineContent":[{"text":"t","type":"text"}]},{"type":"text","text":") for "},{"type":"emphasis","inlineContent":[{"type":"text","text":"n"}]},{"type":"text","text":" entities in the smallest required type, or every live"},{"type":"text","text":" "},{"type":"text","text":"entity when the query requires none, and "},{"type":"emphasis","inlineContent":[{"type":"text","text":"t"}]},{"type":"text","text":" conditions. Each cache adds O("},{"type":"emphasis","inlineContent":[{"text":"t","type":"text"}]},{"type":"text","text":") to"},{"type":"text","text":" "},{"type":"text","text":"adding or removing a component of a type it names."}]}],"type":"aside","style":"note"}]}],"hierarchy":{"paths":[["doc:\/\/WorldModule\/documentation\/WorldModule","doc:\/\/WorldModule\/documentation\/WorldModule\/World"]]},"kind":"symbol","schemaVersion":{"minor":3,"patch":0,"major":0},"identifier":{"url":"doc:\/\/WorldModule\/documentation\/WorldModule\/World\/cache(_:)","interfaceLanguage":"swift"},"sections":[],"references":{"doc://WorldModule/documentation/WorldModule/Disabled":{"navigatorTitle":[{"text":"Disabled","kind":"identifier"}],"role":"symbol","url":"\/documentation\/worldmodule\/disabled","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Disabled","kind":"identifier"}],"identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/Disabled","kind":"symbol","abstract":[{"text":"Marks an entity that queries and updates skip, unless they ask for it.","type":"text"}],"type":"topic","title":"Disabled"},"doc://