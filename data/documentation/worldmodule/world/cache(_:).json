{"kind":"symbol","schemaVersion":{"major":0,"minor":3,"patch":0},"identifier":{"url":"doc:\/\/WorldModule\/documentation\/WorldModule\/World\/cache(_:)","interfaceLanguage":"swift"},"metadata":{"remoteSource":{"fileName":"QueryCache.swift","url":"https:\/\/github.com\/Tyler-Keith-Thompson\/ECS\/blob\/main\/Sources\/WorldModule\/QueryCache.swift#L127"},"title":"cache(_:)","role":"symbol","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"cache"},{"kind":"text","text":"<each "},{"kind":"genericParameter","text":"T"},{"kind":"text","text":">("},{"kind":"typeIdentifier","text":"Query","preciseIdentifier":"s:11WorldModule5QueryV"},{"kind":"text","text":"<repeat each "},{"kind":"typeIdentifier","text":"T"},{"kind":"text","text":">)"}],"extendedModule":"WorldModule","externalID":"s:11WorldModule0A0V5cacheyyAA5QueryVyxxQp_QPGRvzAA0D4TermRzlF","modules":[{"name":"WorldModule"}],"symbolKind":"method","roleHeading":"Instance Method"},"seeAlsoSections":[{"title":"Speeding Up Queries","generated":true,"anchor":"Speeding-Up-Queries","identifiers":["doc:\/\/WorldModule\/documentation\/WorldModule\/World\/group(_:)","doc:\/\/WorldModule\/documentation\/WorldModule\/World\/group(checked:)","doc:\/\/WorldModule\/documentation\/WorldModule\/World\/index(_:)-u1gw","doc:\/\/WorldModule\/documentation\/WorldModule\/World\/index(_:)-2gtfg","doc:\/\/WorldModule\/documentation\/WorldModule\/World\/lookup(_:)","doc:\/\/WorldModule\/documentation\/WorldModule\/World\/lookup(_:equals:)","doc:\/\/WorldModule\/documentation\/WorldModule\/World\/index(ordered:)","doc:\/\/WorldModule\/documentation\/WorldModule\/World\/lookup(_:in:)","doc:\/\/WorldModule\/documentation\/WorldModule\/World\/entities(sortedBy:)"]}],"abstract":[{"type":"text","text":"Keeps a list of the entities that match a query’s structure, so that queries and updates"},{"type":"text","text":" "},{"type":"text","text":"with the same conditions visit only those entities."}],"sections":[],"hierarchy":{"paths":[["doc:\/\/WorldModule\/documentation\/WorldModule","doc:\/\/WorldModule\/documentation\/WorldModule\/World"]]},"primaryContentSections":[{"declarations":[{"platforms":["Linux"],"tokens":[{"kind":"keyword","text":"mutating"},{"kind":"text","text":" "},{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"cache"},{"kind":"text","text":"<each "},{"kind":"genericParameter","text":"T"},{"kind":"text","text":">("},{"kind":"externalParam","text":"_"},{"kind":"text","text":" "},{"kind":"internalParam","text":"query"},{"kind":"text","text":": "},{"kind":"typeIdentifier","identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/Query","text":"Query","preciseIdentifier":"s:11WorldModule5QueryV"},{"kind":"text","text":"<repeat each "},{"kind":"typeIdentifier","text":"T"},{"kind":"text","text":">) "},{"kind":"keyword","text":"where"},{"kind":"text","text":" repeat each "},{"kind":"typeIdentifier","text":"T"},{"kind":"text","text":" : "},{"kind":"typeIdentifier","identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/QueryTerm","text":"QueryTerm","preciseIdentifier":"s:11WorldModule9QueryTermP"}],"languages":["swift"]}],"kind":"declarations"},{"parameters":[{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The query whose matching entities to keep."}]}],"name":"query"}],"kind":"parameters"},{"content":[{"anchor":"discussion","level":2,"type":"heading","text":"Discussion"},{"type":"paragraph","inlineContent":[{"text":"A query normally walks the storage of one of its types and checks every entity there","type":"text"},{"text":" ","type":"text"},{"text":"against the rest of its conditions. When few of those entities match, most of that walk is","type":"text"},{"text":" ","type":"text"},{"text":"wasted. A cached query keeps the matching entities in a list of their own, kept current as","type":"text"},{"text":" ","type":"text"},{"text":"you spawn, insert, remove and despawn, so a visit can walk that list instead.","type":"text"}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Use a cache for a query you run often whose conditions exclude most of the entities it"},{"type":"text","text":" "},{"type":"text","text":"would otherwise walk, such as the few entities that are awake among many asleep:"}]},{"syntax":"swift","type":"codeListing","code":["struct Asleep: Component {}"]},{"syntax":"swift","type":"codeListing","code":["var world = World()","let awake = world.spawn(Position(x: 0, y: 0), Velocity(dx: 1, dy: 0))","let sleeper = world.spawn(Position(x: 0, y: 0), Velocity(dx: 1, dy: 0), Asleep())","","world.cache(Query(Position.self, Velocity.self).without(Asleep.self))","","world.update(Position.self, reading: Velocity.self, where: .without(Asleep.self)) { position, row in","    position.x += row.components.dx","}","print(world[Position.self, of: awake].x, world[Position.self, of: sleeper].x)","\/\/ Prints \"1.0 0.0\""]},{"type":"paragraph","inlineContent":[{"type":"text","text":"The cache holds the entities that hold every component term of "},{"type":"codeVoice","code":"query"},{"type":"text","text":" and every type its"},{"type":"text","text":" "},{"type":"text","text":"filter requires, hold none of the types it excludes or skips by default (such as"},{"type":"text","text":" "},{"type":"reference","isActive":true,"identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/Disabled"},{"type":"text","text":"), and pass its groups of alternatives that name no change ticks. A query or"},{"type":"text","text":" "},{"type":"text","text":"update uses the cache when its own conditions imply the cache’s: it requires every type the"},{"type":"text","text":" "},{"type":"text","text":"cache requires, excludes every type the cache excludes, and has the same groups of"},{"type":"text","text":" "},{"type":"text","text":"alternatives. It walks the cache only when the cache is smaller than the storage it would"},{"type":"text","text":" "},{"type":"text","text":"otherwise walk. A cache never changes which entities a visit finds, only how it finds them."}]},{"type":"paragraph","inlineContent":[{"isActive":true,"identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/AnyOf","type":"reference"},{"text":" terms, change-tick filters and relation filters don’t narrow the cache; a visit","type":"text"},{"text":" ","type":"text"},{"text":"still checks them for each cached entity. Caching the same conditions twice keeps one","type":"text"},{"text":" ","type":"text"},{"text":"cache. A copy of the world keeps its caches; a snapshot doesn’t.","type":"text"}]},{"content":[{"inlineContent":[{"type":"text","text":"O("},{"type":"emphasis","inlineContent":[{"text":"n","type":"text"}]},{"type":"text","text":"·"},{"type":"emphasis","inlineContent":[{"text":"t","type":"text"}]},{"type":"text","text":") for "},{"type":"emphasis","inlineContent":[{"type":"text","text":"n"}]},{"type":"text","text":" entities in the smallest required type, or every live"},{"type":"text","text":" "},{"type":"text","text":"entity when the query requires none, and "},{"type":"emphasis","inlineContent":[{"text":"t","type":"text"}]},{"type":"text","text":" conditions. Each cache adds O("},{"type":"emphasis","inlineContent":[{"type":"text","text":"t"}]},{"type":"text","text":") to adding"},{"type":"text","text":" "},{"type":"text","text":"or removing a component of a type it names."}],"type":"paragraph"}],"name":"Complexity","type":"aside","style":"note"}],"kind":"content"}],"variants":[{"paths":["\/documentation\/worldmodule\/world\/cache(_:)"],"traits":[{"interfaceLanguage":"swift"}]}],"references":{"doc://WorldModule/documentation/WorldModule/World/index(_:)-2gtfg":{"kind":"symbol","identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/World\/index(_:)-2gtfg","type":"topic","role":"symbol","title":"index(_:)","url":"\/documentation\/worldmodule\/world\/index(_:)-2gtfg","abstract":[{"type":"text","text":"Keeps a map from each value of a component’s property to the entities holding it, so that"},{"type":"text","text":" "},{"type":"reference","identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/World\/lookup(_:equals:)","isActive":true},{"type":"text","text":" finds them without walking the type’s storage."}],"fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"index"},{"kind":"text","text":"<"},{"kind":"genericParameter","text":"C"},{"kind":"text","text":", "},{"kind":"genericParameter","text":"Key"},{"kind":"text","text":">(any "},{"kind":"typeIdentifier","text":"KeyPath","preciseIdentifier":"s:s7KeyPathC"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","text":"C"},{"kind":"text","text":", "},{"kind":"typeIdentifier","text":"Key"},{"kind":"text","text":"> & "},{"kind":"typeIdentifier","text":"Sendable","preciseIdentifier":"s:s8SendableP"},{"kind":"text","text":")"}]},"doc://WorldModule/documentation/WorldModule/World":{"title":"World","navigatorTitle":[{"kind":"identifier","text":"World"}],"abstract":[{"text":"A collection of entities, the components they hold, and resources.","type":"text"}],"identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/World","role":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"World"}],"kind":"symbol","type":"topic","url":"\/documentation\/worldmodule\/world"},"doc://WorldModule/documentation/WorldModule/Query":{"kind":"symbol","navigatorTitle":[{"text":"Query","kind":"identifier"}],"url":"\/documentation\/worldmodule\/query","type":"topic","abstract":[{"type":"text","text":"A description of the entities to visit and the components to read from each."}],"title":"Query","role":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Query","kind":"identifier"}],"identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/Query"},"doc://WorldModule/documentation/WorldModule/World/lookup(_:)":{"url":"\/