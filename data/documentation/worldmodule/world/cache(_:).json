{"schemaVersion":{"major":0,"minor":3,"patch":0},"sections":[],"kind":"symbol","identifier":{"url":"doc:\/\/WorldModule\/documentation\/WorldModule\/World\/cache(_:)","interfaceLanguage":"swift"},"abstract":[{"text":"Keeps a list of the entities that match a query’s structure, so that queries and updates","type":"text"},{"text":" ","type":"text"},{"text":"with the same conditions visit only those entities.","type":"text"}],"seeAlsoSections":[{"anchor":"Speeding-Up-Queries","title":"Speeding Up Queries","identifiers":["doc:\/\/WorldModule\/documentation\/WorldModule\/World\/group(_:)","doc:\/\/WorldModule\/documentation\/WorldModule\/World\/group(checked:)","doc:\/\/WorldModule\/documentation\/WorldModule\/World\/index(_:)-u1gw","doc:\/\/WorldModule\/documentation\/WorldModule\/World\/index(_:)-2gtfg","doc:\/\/WorldModule\/documentation\/WorldModule\/World\/lookup(_:)","doc:\/\/WorldModule\/documentation\/WorldModule\/World\/lookup(_:equals:)","doc:\/\/WorldModule\/documentation\/WorldModule\/World\/index(ordered:)","doc:\/\/WorldModule\/documentation\/WorldModule\/World\/lookup(_:in:)","doc:\/\/WorldModule\/documentation\/WorldModule\/World\/entities(sortedBy:)"],"generated":true}],"hierarchy":{"paths":[["doc:\/\/WorldModule\/documentation\/WorldModule","doc:\/\/WorldModule\/documentation\/WorldModule\/World"]]},"primaryContentSections":[{"declarations":[{"tokens":[{"text":"mutating","kind":"keyword"},{"text":" ","kind":"text"},{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"cache","kind":"identifier"},{"text":"<each ","kind":"text"},{"text":"T","kind":"genericParameter"},{"text":">(","kind":"text"},{"text":"_","kind":"externalParam"},{"text":" ","kind":"text"},{"text":"query","kind":"internalParam"},{"text":": ","kind":"text"},{"text":"Query","identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/Query","kind":"typeIdentifier","preciseIdentifier":"s:11WorldModule5QueryV"},{"text":"<repeat each ","kind":"text"},{"text":"T","kind":"typeIdentifier"},{"text":">) ","kind":"text"},{"text":"where","kind":"keyword"},{"text":" repeat each ","kind":"text"},{"text":"T","kind":"typeIdentifier"},{"text":" : ","kind":"text"},{"text":"QueryTerm","identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/QueryTerm","kind":"typeIdentifier","preciseIdentifier":"s:11WorldModule9QueryTermP"}],"platforms":["Linux"],"languages":["swift"]}],"kind":"declarations"},{"parameters":[{"name":"query","content":[{"type":"paragraph","inlineContent":[{"text":"The query whose matching entities to keep.","type":"text"}]}]}],"kind":"parameters"},{"content":[{"level":2,"text":"Discussion","type":"heading","anchor":"discussion"},{"type":"paragraph","inlineContent":[{"text":"A query normally walks the storage of one of its types and checks every entity there","type":"text"},{"text":" ","type":"text"},{"text":"against the rest of its conditions. When few of those entities match, most of that walk is","type":"text"},{"text":" ","type":"text"},{"text":"wasted. A cached query keeps the matching entities in a list of their own, kept current as","type":"text"},{"text":" ","type":"text"},{"text":"you spawn, insert, remove and despawn, so a visit can walk that list instead.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"Use a cache for a query you run often whose conditions exclude most of the entities it","type":"text"},{"text":" ","type":"text"},{"text":"would otherwise walk, such as the few entities that are awake among many asleep:","type":"text"}]},{"type":"codeListing","syntax":"swift","code":["struct Asleep: Component {}"]},{"type":"codeListing","syntax":"swift","code":["var world = World()","let awake = world.spawn(Position(x: 0, y: 0), Velocity(dx: 1, dy: 0))","let sleeper = world.spawn(Position(x: 0, y: 0), Velocity(dx: 1, dy: 0), Asleep())","","world.cache(Query(Position.self, Velocity.self).without(Asleep.self))","","world.update(Position.self, reading: Velocity.self, where: .without(Asleep.self)) { position, row in","    position.x += row.components.dx","}","print(world[Position.self, of: awake].x, world[Position.self, of: sleeper].x)","\/\/ Prints \"1.0 0.0\""]},{"type":"paragraph","inlineContent":[{"type":"text","text":"The cache holds the entities that hold every component term of "},{"code":"query","type":"codeVoice"},{"type":"text","text":" and every type its"},{"type":"text","text":" "},{"type":"text","text":"filter requires, hold none of the types it excludes or skips by default (such as"},{"type":"text","text":" "},{"type":"reference","identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/Disabled","isActive":true},{"type":"text","text":"), and pass its groups of alternatives that name no change ticks. A query or"},{"type":"text","text":" "},{"type":"text","text":"update uses the cache when its own conditions imply the cache’s: it requires every type the"},{"type":"text","text":" "},{"type":"text","text":"cache requires, excludes every type the cache excludes, and has the same groups of"},{"type":"text","text":" "},{"type":"text","text":"alternatives. It walks the cache only when the cache is smaller than the storage it would"},{"type":"text","text":" "},{"type":"text","text":"otherwise walk. A cache never changes which entities a visit finds, only how it finds them."}]},{"type":"paragraph","inlineContent":[{"isActive":true,"type":"reference","identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/AnyOf"},{"type":"text","text":" terms, change-tick filters and relation filters don’t narrow the cache; a visit"},{"type":"text","text":" "},{"type":"text","text":"still checks them for each cached entity. Caching the same conditions twice keeps one"},{"type":"text","text":" "},{"type":"text","text":"cache. A copy of the world keeps its caches; a snapshot doesn’t."}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"O("},{"type":"emphasis","inlineContent":[{"text":"n","type":"text"}]},{"type":"text","text":"·"},{"type":"emphasis","inlineContent":[{"type":"text","text":"t"}]},{"type":"text","text":") for "},{"type":"emphasis","inlineContent":[{"type":"text","text":"n"}]},{"type":"text","text":" entities in the smallest required type, or every live"},{"type":"text","text":" "},{"type":"text","text":"entity when the query requires none, and "},{"type":"emphasis","inlineContent":[{"type":"text","text":"t"}]},{"type":"text","text":" conditions. Each cache adds O("},{"type":"emphasis","inlineContent":[{"text":"t","type":"text"}]},{"type":"text","text":") to adding"},{"type":"text","text":" "},{"type":"text","text":"or removing a component of a type it names."}]}],"style":"note","name":"Complexity","type":"aside"}],"kind":"content"}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/worldmodule\/world\/cache(_:)"]}],"metadata":{"fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"cache","kind":"identifier"},{"text":"<each ","kind":"text"},{"text":"T","kind":"genericParameter"},{"text":">(","kind":"text"},{"text":"Query","preciseIdentifier":"s:11WorldModule5QueryV","kind":"typeIdentifier"},{"text":"<repeat each ","kind":"text"},{"text":"T","kind":"typeIdentifier"},{"text":">)","kind":"text"}],"remoteSource":{"fileName":"QueryCache.swift","url":"https:\/\/github.com\/Tyler-Keith-Thompson\/ECS\/blob\/main\/Sources\/WorldModule\/QueryCache.swift#L127"},"role":"symbol","externalID":"s:11WorldModule0A0V5cacheyyAA5QueryVyxxQp_QPGRvzAA0D4TermRzlF","extendedModule":"WorldModule","roleHeading":"Instance Method","modules":[{"name":"WorldModule"}],"title":"cache(_:)","symbolKind":"method"},"references":{"doc://WorldModule/documentation/WorldModule/World/entities(sortedBy:)":{"kind":"symbol","title":"entities(sortedBy:)","role":"symbol","identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/World\/entities(sortedBy:)","url":"\/documentation\/worldmodule\/world\/entities(sortedby:)","abstract":[{"type":"text","text":"Returns the entities holding a component type, in the order of a property of the"},{"type":"text","text":" "},{"type":"text","text":"component."}],"type":"topic","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"entities"},{"kind":"text","text":"<"},{"kind":"genericParameter","text":"C"},{"kind":"text","text":", "},{"kind":"genericParameter","text":"Key"},{"kind":"text","text":">("},{"kind":"externalParam","text":"sortedBy"},{"kind":"text","text":": any "},{"preciseIdentifier":"s:s7KeyPathC","kind":"typeIdentifier","text":"KeyPath"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","text":"C"},{"kind":"text","text":", "},{"kind":"typeIdentifier","text":"Key"},{"kind":"text","text":"> & "},{"preciseIdentifier":"s:s8SendableP","kind":"typeIdentifier","text":"Sendable"},{"kind":"text","text":") -> ["},{"preciseIdentifier":"s:11WorldModule6EntityV","kind":"typeIdentifier","text":"Entity"},{"kind":"text","text":"]"}]},"doc://WorldModule/documentation/WorldModule":{"identifier":"doc:\/\/WorldModule\/documentation\/WorldModule","type":"topic","title":"WorldModule","kind":"symbol","role":"collection","abstract":[{"text":"Store the state of a game or simulation as entities and components, and read and change it with","type":"text"},{"text":" ","type":"text"},{"text":"queries, updates, and commands.","type":"text"}],"url":"\/documentation\/worldmodule"},"doc://WorldModule/documentation/WorldModule/World/index(_:)-u1gw":{"kind":"symbol","title":"index(_:)","role":"symbol","identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/World\/index(_:)-u1gw","url":"\/documentation\/worldmodule\/world\/index(_:)-u1gw","abstract":[{"type":"text","text":"Keeps a map from each value of a component type to the entities holding it, so that"},{"type":"text","text":" "},{"type":"reference","identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/World\/lookup(_:)","isActive":true},{"type":"text","text":" finds them without walking the type’s storage."}],"ty