{"abstract":[{"type":"text","text":"Keeps the entities "},{"type":"codeVoice","code":"query"},{"type":"text","text":" matches from now on, so queries and updates whose conditions"},{"type":"text","text":" "},{"type":"text","text":"imply it visit only those entities rather than walking a whole column."}],"kind":"symbol","variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/worldmodule\/world\/cache(_:)"]}],"primaryContentSections":[{"declarations":[{"platforms":["Linux"],"tokens":[{"text":"mutating","kind":"keyword"},{"text":" ","kind":"text"},{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"cache","kind":"identifier"},{"text":"<each ","kind":"text"},{"text":"T","kind":"genericParameter"},{"text":">(","kind":"text"},{"text":"_","kind":"externalParam"},{"text":" ","kind":"text"},{"text":"query","kind":"internalParam"},{"text":": ","kind":"text"},{"identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/Query","preciseIdentifier":"s:11WorldModule5QueryV","text":"Query","kind":"typeIdentifier"},{"text":"<repeat each ","kind":"text"},{"text":"T","kind":"typeIdentifier"},{"text":">) ","kind":"text"},{"text":"where","kind":"keyword"},{"text":" repeat each ","kind":"text"},{"text":"T","kind":"typeIdentifier"},{"text":" : ","kind":"text"},{"identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/QueryTerm","preciseIdentifier":"s:11WorldModule9QueryTermP","text":"QueryTerm","kind":"typeIdentifier"}],"languages":["swift"]}],"kind":"declarations"},{"content":[{"text":"Discussion","anchor":"discussion","type":"heading","level":2},{"type":"paragraph","inlineContent":[{"type":"text","text":"The cache holds the entities with every component term of "},{"type":"codeVoice","code":"query"},{"type":"text","text":" and every type its"},{"type":"text","text":" "},{"type":"text","text":"filter requires, none it excludes or skips by default ("},{"type":"reference","identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/Disabled","isActive":true},{"type":"text","text":"), and passing its"},{"type":"text","text":" "},{"type":"text","text":"groups of alternatives that name no change ticks. Spawning, inserting, removing and"},{"type":"text","text":" "},{"type":"text","text":"despawning keep it current. A visit uses the cache when it requires every type the cache"},{"type":"text","text":" "},{"type":"text","text":"requires, excludes every type the cache excludes and has the same groups of"},{"type":"text","text":" "},{"type":"text","text":"alternatives, and the cache is smaller than the columns it would otherwise walk; what it"},{"type":"text","text":" "},{"type":"text","text":"lists does not change."}]},{"syntax":"swift","type":"codeListing","code":["let awake = Query(Position.self, Velocity.self).without(Sleeping.self)","world.cache(awake)","world.update(Position.self, reading: Velocity.self, where: .without(Sleeping.self)) { … }"]},{"type":"paragraph","inlineContent":[{"type":"reference","isActive":true,"identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/AnyOf"},{"type":"text","text":" terms, change-tick filters and relation filters do not narrow the cache; the visit still checks"},{"type":"text","text":" "},{"type":"text","text":"them for each cached entity. Caching the same conditions twice keeps one cache. A copy of"},{"type":"text","text":" "},{"type":"text","text":"the world keeps its caches; a snapshot does not."}]},{"name":"Complexity","type":"aside","content":[{"inlineContent":[{"type":"text","text":"O("},{"type":"emphasis","inlineContent":[{"type":"text","text":"n"}]},{"type":"text","text":"·"},{"type":"emphasis","inlineContent":[{"text":"t","type":"text"}]},{"type":"text","text":") for "},{"type":"emphasis","inlineContent":[{"type":"text","text":"n"}]},{"type":"text","text":" entities in the smallest required type, or every live"},{"type":"text","text":" "},{"type":"text","text":"entity when the query requires none, and "},{"type":"emphasis","inlineContent":[{"type":"text","text":"t"}]},{"type":"text","text":" conditions. Each cache adds O("},{"type":"emphasis","inlineContent":[{"text":"t","type":"text"}]},{"type":"text","text":") to"},{"type":"text","text":" "},{"type":"text","text":"adding or removing a component of a type it names."}],"type":"paragraph"}],"style":"note"}],"kind":"content"}],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/WorldModule\/documentation\/WorldModule\/World\/cache(_:)"},"metadata":{"role":"symbol","modules":[{"name":"WorldModule"}],"symbolKind":"method","roleHeading":"Instance Method","externalID":"s:11WorldModule0A0V5cacheyyAA5QueryVyxxQp_QPGRvzAA0D4TermRzlF","extendedModule":"WorldModule","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"cache","kind":"identifier"},{"text":"<each ","kind":"text"},{"text":"T","kind":"genericParameter"},{"text":">(","kind":"text"},{"text":"Query","preciseIdentifier":"s:11WorldModule5QueryV","kind":"typeIdentifier"},{"text":"<repeat each ","kind":"text"},{"text":"T","kind":"typeIdentifier"},{"text":">)","kind":"text"}],"remoteSource":{"url":"https:\/\/github.com\/Tyler-Keith-Thompson\/ECS\/blob\/main\/Sources\/WorldModule\/QueryCache.swift#L106","fileName":"QueryCache.swift"},"title":"cache(_:)"},"schemaVersion":{"patch":0,"minor":3,"major":0},"hierarchy":{"paths":[["doc:\/\/WorldModule\/documentation\/WorldModule","doc:\/\/WorldModule\/documentation\/WorldModule\/World"]]},"sections":[],"references":{"doc://WorldModule/documentation/WorldModule/World":{"url":"\/documentation\/worldmodule\/world","role":"symbol","kind":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"World"}],"type":"topic","navigatorTitle":[{"kind":"identifier","text":"World"}],"title":"World","identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/World","abstract":[{"type":"text","text":"Entities, the components they hold, and the world’s resources."}]},"doc://WorldModule/documentation/