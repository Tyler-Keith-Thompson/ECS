ld\/group(_:)","identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/World\/group(_:)","abstract":[{"type":"text","text":"Keeps the given component types packed in the same order, so that queries and updates of"},{"type":"text","text":" "},{"type":"text","text":"exactly these types visit their entities without lookups."}]},"doc://WorldModule/documentation/WorldModule/AnyOf":{"url":"\/documentation\/worldmodule\/anyof","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"AnyOf"}],"type":"topic","role":"symbol","navigatorTitle":[{"kind":"identifier","text":"AnyOf"}],"kind":"symbol","identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/AnyOf","abstract":[{"text":"A group of types an entity matches by matching at least one of them.","type":"text"}],"title":"AnyOf"},"doc://WorldModule/documentation/WorldModule/World/lookup(_:)":{"abstract":[{"text":"Returns the entities holding a component equal to the given value.","type":"text"}],"kind":"symbol","url":"\/documentation\/worldmodule\/world\/lookup(_:)","role":"symbol","identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/World\/lookup(_:)","type":"topic","title":"lookup(_:)","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"lookup","kind":"identifier"},{"text":"<","kind":"text"},{"text":"C","kind":"genericParameter"},{"text":">(","kind":"text"},{"kind":"typeIdentifier","text":"C"},{"kind":"text","text":") -> ["},{"kind":"typeIdentifier","text":"Entity","preciseIdentifier":"s:11WorldModule6EntityV"},{"kind":"text","text":"]"}]},"doc://WorldModule/documentation/WorldModule/QueryTerm":{"abstract":[{"text":"A type that can be a term of a query, deciding which entities match and what the query reads","type":"text"},{"text":" ","type":"text"},{"text":"from each.","type":"text"}],"kind":"symbol","url":"\/documentation\/worldmodule\/queryterm","role":"symbol","navigatorTitle":[{"text":"QueryTerm","kind":"identifier"}],"identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/QueryTerm","type":"topic","title":"QueryTerm","fragments":[{"text":"protocol","kind":"keyword"},{"text":" ","kind":"text"},{"text":"QueryTerm","kind":"identifier"}]},"doc://WorldModule/documentation/WorldModule/Disabled":{"abstract":[{"text":"A component that makes queries and updates skip an entity, unless they ask for it.","type":"text"}],"kind":"symbol","url":"\/documentation\/worldmodule\/disabled","role":"symbol","navigatorTitle":[{"kind":"identifier","text":"Disabled"}],"identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/Disabled","type":"topic","title":"Disabled","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"Disabled"}]}}}