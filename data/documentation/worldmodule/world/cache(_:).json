{"hierarchy":{"paths":[["doc:\/\/WorldModule\/documentation\/WorldModule","doc:\/\/WorldModule\/documentation\/WorldModule\/World"]]},"primaryContentSections":[{"kind":"declarations","declarations":[{"tokens":[{"text":"mutating","kind":"keyword"},{"text":" ","kind":"text"},{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"cache","kind":"identifier"},{"text":"<each ","kind":"text"},{"text":"T","kind":"genericParameter"},{"text":">(","kind":"text"},{"text":"_","kind":"externalParam"},{"text":" ","kind":"text"},{"text":"query","kind":"internalParam"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:11WorldModule5QueryV","text":"Query","kind":"typeIdentifier","identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/Query"},{"text":"<repeat each ","kind":"text"},{"text":"T","kind":"typeIdentifier"},{"text":">) ","kind":"text"},{"text":"where","kind":"keyword"},{"text":" repeat each ","kind":"text"},{"text":"T","kind":"typeIdentifier"},{"text":" : ","kind":"text"},{"preciseIdentifier":"s:11WorldModule9QueryTermP","text":"QueryTerm","kind":"typeIdentifier","identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/QueryTerm"}],"languages":["swift"],"platforms":["Linux"]}]},{"kind":"parameters","parameters":[{"name":"query","content":[{"type":"paragraph","inlineContent":[{"text":"The query whose matching entities to keep.","type":"text"}]}]}]},{"kind":"content","content":[{"anchor":"discussion","text":"Discussion","type":"heading","level":2},{"inlineContent":[{"type":"text","text":"A query normally walks the storage of one of its types and checks every entity there"},{"type":"text","text":" "},{"type":"text","text":"against the rest of its conditions. When few of those entities match, most of that walk is"},{"type":"text","text":" "},{"type":"text","text":"wasted. A cached query keeps the matching entities in a list of their own, kept current as"},{"type":"text","text":" "},{"type":"text","text":"you spawn, insert, remove and despawn, so a visit can walk that list instead."}],"type":"paragraph"},{"inlineContent":[{"text":"Use a cache for a query you run often whose conditions exclude most of the entities it","type":"text"},{"text":" ","type":"text"},{"text":"would otherwise walk, such as the few entities that are awake among many asleep:","type":"text"}],"type":"paragraph"},{"syntax":"swift","code":["struct Asleep: Component {}"],"type":"codeListing"},{"syntax":"swift","code":["var world = World()","let awake = world.spawn(Position(x: 0, y: 0), Velocity(dx: 1, dy: 0))","let sleeper = world.spawn(Position(x: 0, y: 0), Velocity(dx: 1, dy: 0), Asleep())","","world.cache(Query(Position.self, Velocity.self).without(Asleep.self))","","world.update(Position.self, reading: Velocity.self, where: .without(Asleep.self)) { position, row in","    position.x += row.components.dx","}","print(world[Position.self, of: awake].x, world[Position.self, of: sleeper].x)","\/\/ Prints \"1.0 0.0\""],"type":"codeListing"},{"inlineContent":[{"text":"The cache holds the entities that hold every component term of ","type":"text"},{"code":"query","type":"codeVoice"},{"text":" and every type its","type":"text"},{"text":" ","type":"text"},{"text":"filter requires, hold none of the types it excludes or skips by default (such as","type":"text"},{"text":" ","type":"text"},{"identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/Disabled","isActive":true,"type":"reference"},{"text":"), and pass its groups of alternatives that name no change ticks. A query or","type":"text"},{"text":" ","type":"text"},{"text":"update uses the cache when its own conditions imply the cache’s: it requires every type the","type":"text"},{"text":" ","type":"text"},{"text":"cache requires, excludes every type the cache excludes, and has the same groups of","type":"text"},{"text":" ","type":"text"},{"text":"alternatives. It walks the cache only when the cache is smaller than the storage it would","type":"text"},{"text":" ","type":"text"},{"text":"otherwise walk. A cache never changes which entities a visit finds, only how it finds them.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"type":"reference","isActive":true,"identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/AnyOf"},{"text":" terms, change-tick filters and relation filters don’t narrow the cache; a visit","type":"text"},{"text":" ","type":"text"},{"text":"still checks them for each cached entity. Caching the same conditions twice keeps one","type":"text"},{"text":" ","type":"text"},{"text":"cache. A copy of the world keeps its caches; a snapshot doesn’t.","type":"text"}],"type":"paragraph"},{"style":"note","name":"Complexity","content":[{"inlineContent":[{"text":"O(","type":"text"},{"type":"emphasis","inlineContent":[{"text":"n","type":"text"}]},{"text":"·","type":"text"},{"type":"emphasis","inlineContent":[{"text":"t","type":"text"}]},{"text":") for ","type":"text"},{"type":"emphasis","inlineContent":[{"type":"text","text":"n"}]},{"text":" entities in the smallest required type, or every live","type":"text"},{"text":" ","type":"text"},{"text":"entity when the query requires none, and ","type":"text"},{"type":"emphasis","inlineContent":[{"type":"text","text":"t"}]},{"text":" conditions. Each cache adds O(","type":"text"},{"type":"emphasis","inlineContent":[{"type":"text","text":"t"}]},{"text":") to adding","type":"text"},{"text":" ","type":"text"},{"text":"or removing a component of a type it names.","type":"text"}],"type":"paragraph"}],"type":"aside"}]}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/worldmodule\/world\/cache(_:)"]}],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/WorldModule\/documentation\/WorldModule\/World\/cache(_:)"},"sections":[],"kind":"symbol","abstract":[{"text":"Keeps a list of the entities that match a query’s structure, so that queries and updates","type":"text"},{"text":" ","type":"text"},{"text":"with the same conditions visit only those entities.","type":"text"}],"schemaVersion":{"patch":0,"major":0,"minor":3},"seeAlsoSections":[{"anchor":"Speeding-Up-Queries","identifiers":["doc:\/\/WorldModule\/documentation\/WorldModule\/World\/group(_:)","doc:\/\/WorldModule\/documentation\/WorldModule\/World\/group(checked:)","doc:\/\/WorldModule\/documentation\/WorldModule\/World\/index(_:)-u1gw","doc:\/\/WorldModule\/documentation\/WorldModule\/World\/index(_:)-2gtfg","doc:\/\/WorldModule\/documentation\/WorldModule\/World\/lookup(_:)","doc:\/\/WorldModule\/documentation\/WorldModule\/World\/lookup(_:equals:)","doc:\/\/WorldModule\/documentation\/WorldModule\/World\/index(ordered:)","doc:\/\/WorldModule\/documentation\/WorldModule\/World\/lookup(_:in:)","doc:\/\/WorldModule\/documentation\/WorldModule\/World\/entities(sortedBy:)"],"title":"Speeding Up Queries","generated":true}],"metadata":{"roleHeading":"Instance Method","title":"cache(_:)","extendedModule":"WorldModule","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"cache","kind":"identifier"},{"text":"<each ","kind":"text"},{"text":"T","kind":"genericParameter"},{"text":">(","kind":"text"},{"text":"Query","kind":"typeIdentifier","preciseIdentifier":"s:11WorldModule5QueryV"},{"text":"<repeat each ","kind":"text"},{"text":"T","kind":"typeIdentifier"},{"text":">)","kind":"text"}],"modules":[{"name":"WorldModule"}],"externalID":"s:11WorldModule0A0V5cacheyyAA5QueryVyxxQp_QPGRvzAA0D4TermRzlF","remoteSource":{"fileName":"QueryCache.swift","url":"https:\/\/github.com\/Tyler-Keith-Thompson\/ECS\/blob\/main\/Sources\/WorldModule\/QueryCache.swift#L127"},"role":"symbol","symbolKind":"method"},"references":{"doc://WorldModule/documentation/WorldModule/World/index(_:)-2gtfg":{"type":"topic","identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/World\/index(_:)-2gtfg","title":"index(_:)","role":"symbol","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"index"},{"text":"<","kind":"text"},{"text":"C",