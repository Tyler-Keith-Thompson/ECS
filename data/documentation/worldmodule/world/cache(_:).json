{"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/worldmodule\/world\/cache(_:)"]}],"sections":[],"kind":"symbol","hierarchy":{"paths":[["doc:\/\/WorldModule\/documentation\/WorldModule","doc:\/\/WorldModule\/documentation\/WorldModule\/World"]]},"primaryContentSections":[{"kind":"declarations","declarations":[{"tokens":[{"kind":"keyword","text":"mutating"},{"kind":"text","text":" "},{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"cache"},{"kind":"text","text":"<each "},{"kind":"genericParameter","text":"T"},{"kind":"text","text":">("},{"kind":"externalParam","text":"_"},{"kind":"text","text":" "},{"kind":"internalParam","text":"query"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:11WorldModule5QueryV","identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/Query","text":"Query"},{"kind":"text","text":"<repeat each "},{"kind":"typeIdentifier","text":"T"},{"kind":"text","text":">) "},{"kind":"keyword","text":"where"},{"kind":"text","text":" repeat each "},{"kind":"typeIdentifier","text":"T"},{"kind":"text","text":" : "},{"kind":"typeIdentifier","preciseIdentifier":"s:11WorldModule9QueryTermP","identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/QueryTerm","text":"QueryTerm"}],"languages":["swift"],"platforms":["Linux"]}]},{"kind":"parameters","parameters":[{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The query whose matching entities to keep."}]}],"name":"query"}]},{"kind":"content","content":[{"anchor":"discussion","text":"Discussion","type":"heading","level":2},{"type":"paragraph","inlineContent":[{"type":"text","text":"A query normally walks the storage of one of its types and checks every entity there"},{"type":"text","text":" "},{"type":"text","text":"against the rest of its conditions. When few of those entities match, most of that walk is"},{"type":"text","text":" "},{"type":"text","text":"wasted. A cached query keeps the matching entities in a list of their own, kept current as"},{"type":"text","text":" "},{"type":"text","text":"you spawn, insert, remove and despawn, so a visit can walk that list instead."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Use a cache for a query you run often whose conditions exclude most of the entities it"},{"type":"text","text":" "},{"type":"text","text":"would otherwise walk, such as the few entities that are awake among many asleep:"}]},{"type":"codeListing","syntax":"swift","code":["struct Asleep: Component {}"]},{"type":"codeListing","syntax":"swift","code":["var world = World()","let awake = world.spawn(Position(x: 0, y: 0), Velocity(dx: 1, dy: 0))","let sleeper = world.spawn(Position(x: 0, y: 0), Velocity(dx: 1, dy: 0), Asleep())","","world.cache(Query(Position.self, Velocity.self).without(Asleep.self))","","world.update(Position.self, reading: Velocity.self, where: .without(Asleep.self)) { position, row in","    position.x += row.components.dx","}","print(world[Position.self, of: awake].x, world[Position.self, of: sleeper].x)","\/\/ Prints \"1.0 0.0\""]},{"type":"paragraph","inlineContent":[{"text":"The cache holds the entities that hold every component term of ","type":"text"},{"type":"codeVoice","code":"query"},{"text":" and every type its","type":"text"},{"text":" ","type":"text"},{"text":"filter requires, hold none of the types it excludes or skips by default (such as","type":"text"},{"text":" ","type":"text"},{"identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/Disabled","type":"reference","isActive":true},{"text":"), and pass its groups of alternatives that name no change ticks. A query or","type":"text"},{"text":" ","type":"text"},{"text":"update uses the cache when its own conditions imply the cache’s: it requires every type the","type":"text"},{"text":" ","type":"text"},{"text":"cache requires, excludes every type the cache excludes, and has the same groups of","type":"text"},{"text":" ","type":"text"},{"text":"alternatives. It walks the cache only when the cache is smaller than the storage it would","type":"text"},{"text":" ","type":"text"},{"text":"otherwise walk. A cache never changes which entities a visit finds, only how it finds them.","type":"text"}]},{"type":"paragraph","inlineContent":[{"type":"reference","identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/AnyOf","isActive":true},{"type":"text","text":" terms, change-tick filters and relation filters don’t narrow the cache; a visit"},{"type":"text","text":" "},{"type":"text","text":"still checks them for each cached entity. Caching the same conditions twice keeps one"},{"type":"text","text":" "},{"type":"text","text":"cache. A copy of the world keeps its caches; a snapshot doesn’t."}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"O("},{"type":"emphasis","inlineContent":[{"type":"text","text":"n"}]},{"type":"text","text":"·"},{"type":"emphasis","inlineContent":[{"text":"t","type":"text"}]},{"type":"text","text":") for "},{"type":"emphasis","inlineContent":[{"text":"n","type":"text"}]},{"type":"text","text":" entities in the smallest required type, or every live"},{"type":"text","text":" "},{"type":"text","text":"entity when the query requires none, and "},{"type":"emphasis","inlineContent":[{"type":"text","text":"t"}]},{"type":"text","text":" conditions. Each cache adds O("},{"type":"emphasis","inlineContent":[{"type":"text","text":"t"}]},{"type":"text","text":") to adding"},{"type":"text","text":" "},{"type":"text","text":"or removing a component of a type it names."}]}],"style":"note","type":"aside","name":"Complexity"}]}],"seeAlsoSections":[{"identifiers":["doc:\/\/WorldModule\/documentation\/WorldModule\/World\/group(_:)","doc:\/\/WorldModule\/documentation\/WorldModule\/World\/group(checked:)","doc:\/\/WorldModule\/documentation\/WorldModule\/World\/index(_:)-u1gw","doc:\/\/WorldModule\/documentation\/WorldModule\/World\/index(_:)-2gtfg","doc:\/\/WorldModule\/