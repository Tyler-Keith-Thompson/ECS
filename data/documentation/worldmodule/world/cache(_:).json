t"},{"text":"from each.","type":"text"}],"type":"topic","url":"\/documentation\/worldmodule\/queryterm","identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/QueryTerm","kind":"symbol","role":"symbol","fragments":[{"kind":"keyword","text":"protocol"},{"kind":"text","text":" "},{"kind":"identifier","text":"QueryTerm"}],"navigatorTitle":[{"kind":"identifier","text":"QueryTerm"}]},"doc://WorldModule/documentation/WorldModule/World/index(_:)":{"identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/World\/index(_:)","type":"topic","kind":"symbol","title":"index(_:)","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"index","kind":"identifier"},{"text":"<","kind":"text"},{"text":"C","kind":"genericParameter"},{"text":">(","kind":"text"},{"text":"C","kind":"typeIdentifier"},{"text":".Type)","kind":"text"}],"role":"symbol","url":"\/documentation\/worldmodule\/world\/index(_:)","abstract":[{"text":"Keeps a map from each value of a component type to the entities holding it, so that","type":"text"},{"text":" ","type":"text"},{"identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/World\/lookup(_:)","isActive":true,"type":"reference"},{"text":" finds them without walking the type’s storage.","type":"text"}]},"doc://WorldModule/documentation/WorldModule/Query":{"url":"\/documentation\/worldmodule\/query","identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/Query","navigatorTitle":[{"kind":"identifier","text":"Query"}],"role":"symbol","title":"Query","abstract":[{"text":"A description of the entities to visit and the components to read from each.","type":"text"}],"kind":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"Query"}],"type":"topic"},"doc://WorldModule/documentation/WorldModule/AnyOf":{"kind":"symbol","url":"\/documentation\/worldmodule\/anyof","identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/AnyOf","type":"topic","role":"symbol"