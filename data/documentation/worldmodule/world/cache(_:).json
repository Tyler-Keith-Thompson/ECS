{"sections":[],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/WorldModule\/documentation\/WorldModule\/World\/cache(_:)"},"seeAlsoSections":[{"anchor":"Speeding-Up-Queries","title":"Speeding Up Queries","identifiers":["doc:\/\/WorldModule\/documentation\/WorldModule\/World\/group(_:)","doc:\/\/WorldModule\/documentation\/WorldModule\/World\/group(checked:)","doc:\/\/WorldModule\/documentation\/WorldModule\/World\/index(_:)-u1gw","doc:\/\/WorldModule\/documentation\/WorldModule\/World\/index(_:)-2gtfg","doc:\/\/WorldModule\/documentation\/WorldModule\/World\/lookup(_:)","doc:\/\/WorldModule\/documentation\/WorldModule\/World\/lookup(_:equals:)"],"generated":true}],"hierarchy":{"paths":[["doc:\/\/WorldModule\/documentation\/WorldModule","doc:\/\/WorldModule\/documentation\/WorldModule\/World"]]},"kind":"symbol","metadata":{"roleHeading":"Instance Method","modules":[{"name":"WorldModule"}],"extendedModule":"WorldModule","title":"cache(_:)","remoteSource":{"fileName":"QueryCache.swift","url":"https:\/\/github.com\/Tyler-Keith-Thompson\/ECS\/blob\/main\/Sources\/WorldModule\/QueryCache.swift#L127"},"externalID":"s:11WorldModule0A0V5cacheyyAA5QueryVyxxQp_QPGRvzAA0D4TermRzlF","role":"symbol","symbolKind":"method","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"cache","kind":"identifier"},{"text":"<each ","kind":"text"},{"text":"T","kind":"genericParameter"},{"text":">(","kind":"text"},{"text":"Query","preciseIdentifier":"s:11WorldModule5QueryV","kind":"typeIdentifier"},{"text":"<repeat each ","kind":"text"},{"text":"T","kind":"typeIdentifier"},{"text":">)","kind":"text"}]},"abstract":[{"text":"Keeps a list of the entities that match a query’s structure, so that queries and updates","type":"text"},{"text":" ","type":"text"},{"text":"with the same conditions visit only those entities.","type":"text"}],"primaryContentSections":[{"kind":"declarations","declarations":[{"tokens":[{"kind":"keyword","text":"mutating"},{"kind":"text","text":" "},{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"cache"},{"kind":"text","text":"<each "},{"kind":"genericParameter","text":"T"},{"kind":"text","text":">("},{"kind":"externalParam","text":"_"},{"kind":"text","text":" "},{"kind":"internalParam","text":"query"},{"kind":"text","text":": "},{"identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/Query","kind":"typeIdentifier","preciseIdentifier":"s:11WorldModule5QueryV","text":"Query"},{"kind":"text","text":"<repeat each "},{"kind":"typeIdentifier","text":"T"},{"kind":"text","text":">) "},{"kind":"keyword","text":"where"},{"kind":"text","text":" repeat each "},{"kind":"typeIdentifier","text":"T"},{"kind":"text","text":" : "},{"identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/QueryTerm","kind":"typeIdentifier","preciseIdentifier":"s:11WorldModule9QueryTermP","text":"QueryTerm"}],"platforms":["Linux"],"languages":["swift"]}]},{"parameters":[{"content":[{"inlineContent":[{"type":"text","text":"The query whose matching entities to keep."}],"type":"paragraph"}],"name":"query"}],"kind":"parameters"},{"content":[{"level":2,"text":"Discussion","anchor":"discussion","type":"heading"},{"inlineContent":[{"text":"A query normally walks the storage of one of its types and checks every entity there","type":"text"},{"text":" ","type":"text"},{"text":"against the rest of its conditions. When few of those entities match, most of that walk is","type":"text"},{"text":" ","type":"text"},{"text":"wasted. A cached query keeps the matching entities in a list of their own, kept current as","type":"text"},{"text":" ","type":"text"},{"text":"you spawn, insert, remove and despawn, so a visit can walk that list instead.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"Use a cache for a query you run often whose conditions exclude most of the entities it"},{"type":"text","text":" "},{"type":"text","text":"would otherwise walk, such as the few entities that are awake among many asleep:"}],"type":"paragraph"},{"code":["struct Asleep: Component {}"],"type":"codeListing","syntax":"swift"},{"code":["var world = World()","let awake = world.spawn(Position(x: 0, y: 0), Velocity(dx: 1, dy: 0))","let sleeper = world.spawn(Position(x: 0, y: 0), Velocity(dx: 1, dy: 0), Asleep())","","world.cache(Query(Position.self, Velocity.self).without(Asleep.self))","","world.update(Position.self, reading: Velocity.self, where: .without(Asleep.self)) { position, row in","    position.x += row.components.dx","}","print(world[Position.self, of: awake].x, world[Position.self, of: sleeper].x)","\/\/ Prints \"1.0 0.0\""],"type":"codeListing","syntax":"swift"},{"inlineContent":[{"text":"The cache holds the entities that hold every component term of ","type":"text"},{"code":"query","type":"codeVoice"},{"text":" and every type its","type":"text"},{"text":" ","type":"text"},{"text":"filter requires, hold none of the types it excludes or skips by default (such as","type":"text"},{"text":" ","type":"text"},{"identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/Disabled","type":"reference","isActive":true},{"text":"), and pass its groups of alternatives that name no change ticks. A query or","type":"text"},{"text":" ","type":"text"},{"text":"update uses the cache when its own conditions imply the cache’s: it requires every type the","type":"text"},{"text":" ","type":"text"},{"text":"cache requires, excludes every type the cache excludes, and has the same groups of","type":"text"},{"text":" ","type":"text"},{"text":"alternatives. It walks the cache only when the cache is smaller than the storage it would","type":"text"},{"text":" ","type":"text"},{"text":"otherwise walk. A cache never changes which entities a visit finds, only how it finds them.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"type":"reference","identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/AnyOf","isActive":true},{"type":"text","text":" terms, change-tick filters and relation filters don’t narrow the cache; a visit"},{"type":"text","text":" "},{"type":"text","text":"still checks them for each cached entity. Caching the same conditions twice keeps one"},{"type":"text","text":" "},{"type":"text","text":"cache. A copy of the world keeps its caches; a snapshot doesn’t."}],"type":"paragraph"},{"name":"Complexity","style":"note","type":"aside","content":[{"inlineContent":[{"type":"text","text":"O("},{"type":"emphasis","inlineContent":[{"type":"text","text":"n"}]},{"type":"text","text":"·"},{"type":"emphasis","inlineContent":[{"text":"t","type":"text"}]},{"type":"text","text":") for "},{"type":"emphasis","inlineContent":[{"type":"text","text":"n"}]},{"type":"text","text":" entities in the smallest required type, or every live"},{"type":"text","text":" "},{"type":"text","text":"entity when the query requires none, and "},{"type":"emphasis","inlineContent":[{"text":"t","type":"text"}]},{"type":"text","text":" conditions. Each cache adds O("},{"type":"emphasis","inlineContent":[{"text":"t","type":"text"}]},{"type":"text","text":") to adding"},{"type":"text","text":" "},{"type":"text","text":"or removing a component of a type it names."}],"type":"paragraph"}]}],"kind":"content"}],"schemaVersion":{"major":0,"minor":3,"patch":0},"variants":[{"paths":["\/documentation\/worldmodule\/world\/cache(_:)"],"traits":[{"interfaceLanguage":"swift"}]}],"references":{"doc://WorldModule/documentation/WorldModule/World/index(_:)-2gtfg":{"type":"topic","identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/World\/index(_:)-2gtfg","title":"index(_:)","kind":"symbol","abstract":[{"type":"text","text":"Keeps a map from each value of a component’s property to the entities holding it, so that"},{"type":"text","text":" "},{"type":"reference","identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/World\/lookup(_:equals:)","isActive":true},{"type":"text","text":" finds them without walking the type’s storage."}],"url":"\/documentation\/worldmodule\/world\/index(_:)-2gtfg","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"index","kind":"identifier"},{"text":"<","kind":"text"},{"text":"C","kind":"genericParameter"},{"text":", ","kind":"text"},{"text":"Key","kind":"genericParameter"},{"text":">(any ","kind":"text"},{"text":"KeyPath","preciseIdentifier":"s:s7KeyPathC","kind":"typeIdentifier"},{"text":"<","kind":"text"},{"text":"C","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"Key","kind":"typeIdentifier"},{"text":"> & ","kind":"text"},{"text":"Sendable","preciseIdentifier":"s:s8SendableP","kind":"typeIdentifier"},{"text":")","kind":"text"}],"role":"symbol"},"doc://WorldModule/documentation/WorldModule":{"type":"topic","kind":"symbol","role":"collection","title":"WorldModule","abstract":[{"type":"text","text":"Store the state of a game or simulation as entities and components, and read and change it with"},{"type":"text","text":" "},{"type":"text","text":"queries, updates, and commands."}],"url":"\/documentation\/worldmodule","identifier":"doc:\/\/WorldModule\/documentation\/WorldModule"},"doc://WorldModule/documentation/WorldModule/World/index(_:)-u1gw":{"role":"symbol","identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/World\/index(_:)-u1gw","type":"topic","abstract":[{"type":"text","text":"Keeps a map from each value of a component type to the entities holding it, so that"},{"type":"text","text":" "},{"type":"reference","identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/World\/lookup(_:)","isActive":true},{"type":"text","text":" finds them without walking the type’s storage."}],"kind":"symbol","url":"\/documentation\/worldmodule\/world\/index(_:)-u1gw","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"index"},{"text":"<","kind":"text"},{"text":"C","kind":"genericParameter"},{"text":">(","kind":"text"},{"text":"C","kind":"typeIdentifier"},{"text":".Type)","kind":"text"}],"t