e":"topic","identifier":"doc:\/\/WorldModule\/documentation\/WorldModule","url":"\/documentation\/worldmodule","role":"collection","title":"WorldModule","kind":"symbol","abstract":[{"text":"Store the state of a game or simulation as entities and components, and read and change it with","type":"text"},{"text":" ","type":"text"},{"text":"queries, updates, and commands.","type":"text"}]},"doc://WorldModule/documentation/WorldModule/World/group(checked:)":{"type":"topic","identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/World\/group(checked:)","title":"group(checked:)","role":"symbol","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"group","kind":"identifier"},{"text":"<each ","kind":"text"},{"text":"C","kind":"genericParameter"},{"text":">(","kind":"text"},{"text":"checked","kind":"externalParam"},{"text":": repeat (each ","kind":"text"},{"text":"C","kind":"typeIdentifier"},{"text":").Type) ","kind":"text"},{"text":"throws","kind":"keyword"},{"kind":"text","text":"("},{"preciseIdentifier":"s:11WorldModule10GroupErrorO","kind":"typeIdentifier","text":"GroupError"},{"kind":"text","text":")"}],"kind":"symbol","abstract":[{"text":"Keeps the given component types packed in the same order, throwing an error if they can’t","type":"text"},{"text":" ","type":"text"},{"text":"be grouped.","type":"text"}],"url":"\/documentation\/worldmodule\/world\/group(checked:)"},"doc://WorldModule/documentation/WorldModule/AnyOf":{"navigatorTitle":[{"kind":"identifier","text":"AnyOf"}],"fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"AnyOf"}],"kind":"symbol","abstract":[{"text":"A group of types an entity matches by matching at least one of them.","type":"text"}],"url":"\/documentation\/worldmodule\/anyof","title":"AnyOf","identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/AnyOf","role":"symbol","type":"topic"},"doc://WorldModule/documentation/WorldModule/Disabled":{"url":"\/documen