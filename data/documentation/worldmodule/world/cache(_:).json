{"metadata":{"extendedModule":"WorldModule","roleHeading":"Instance Method","externalID":"s:11WorldModule0A0V5cacheyyAA5QueryVyxxQp_QPGRvzAA0D4TermRzlF","title":"cache(_:)","symbolKind":"method","role":"symbol","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"cache"},{"kind":"text","text":"<each "},{"kind":"genericParameter","text":"T"},{"kind":"text","text":">("},{"kind":"typeIdentifier","text":"Query","preciseIdentifier":"s:11WorldModule5QueryV"},{"kind":"text","text":"<repeat each "},{"kind":"typeIdentifier","text":"T"},{"kind":"text","text":">)"}],"modules":[{"name":"WorldModule"}],"remoteSource":{"url":"https:\/\/github.com\/Tyler-Keith-Thompson\/ECS\/blob\/main\/Sources\/WorldModule\/QueryCache.swift#L127","fileName":"QueryCache.swift"}},"abstract":[{"text":"Keeps a list of the entities that match a query’s structure, so that queries and updates","type":"text"},{"text":" ","type":"text"},{"text":"with the same conditions visit only those entities.","type":"text"}],"kind":"symbol","variants":[{"paths":["\/documentation\/worldmodule\/world\/cache(_:)"],"traits":[{"interfaceLanguage":"swift"}]}],"schemaVersion":{"patch":0,"major":0,"minor":3},"sections":[],"hierarchy":{"paths":[["doc:\/\/WorldModule\/documentation\/WorldModule","doc:\/\/WorldModule\/documentation\/WorldModule\/World"]]},"identifier":{"url":"doc:\/\/WorldModule\/documentation\/WorldModule\/World\/cache(_:)","interfaceLanguage":"swift"},"seeAlsoSections":[{"title":"Speeding Up Queries","generated":true,"anchor":"Speeding-Up-Queries","identifiers":["doc:\/\/WorldModule\/documentation\/WorldModule\/World\/group(_:)","doc:\/\/WorldModule\/documentation\/WorldModule\/World\/group(checked:)","doc:\/\/WorldModule\/documentation\/WorldModule\/World\/index(_:)","doc:\/\/WorldModule\/documentation\/WorldModule\/World\/lookup(_:)"]}],"primaryContentSections":[{"kind":"declarations","declarations":[{"languages":["swift"],"tokens":[{"kind":"keyword","text":"mutating"},{"kind":"text","text":" "},{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"cache"},{"kind":"text","text":"<each "},{"kind":"genericParameter","text":"T"},{"kind":"text","text":">("},{"kind":"externalParam","text":"_"},{"kind":"text","text":" "},{"kind":"internalParam","text":"query"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"Query","identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/Query","preciseIdentifier":"s:11WorldModule5QueryV"},{"kind":"text","text":"<repeat each "},{"kind":"typeIdentifier","text":"T"},{"kind":"text","text":">) "},{"kind":"keyword","text":"where"},{"kind":"text","text":" repeat each "},{"kind":"typeIdentifier","text":"T"},{"kind":"text","text":" : "},{"kind":"typeIdentifier","text":"QueryTerm","identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/QueryTerm","preciseIdentifier":"s:11WorldModule9QueryTermP"}],"platforms":["Linux"]}]},{"parameters":[{"name":"query","content":[{"inlineContent":[{"text":"The query whose matching entities to keep.","type":"text"}],"type":"paragraph"}]}],"kind":"parameters"},{"kind":"content","content":[{"text":"Discussion","anchor":"discussion","type":"heading","level":2},{"inlineContent":[{"type":"text","text":"A query normally walks the storage of one of its types and checks every entity there"},{"type":"text","text":" "},{"type":"text","text":"against the rest of its conditions. When few of those entities match, most of that walk is"},{"type":"text","text":" "},{"type":"text","text":"wasted. A cached query keeps the matching entities in a list of their own, kept current as"},{"type":"text","text":" "},{"type":"text","text":"you spawn, insert, remove and despawn, so a visit can walk that list instead."}],"type":"paragraph"},{"inlineContent":[{"text":"Use a cache for a query you run often whose conditions exclude most of the entities it","type":"text"},{"text":" ","type":"text"},{"text":"would otherwise walk, such as the few entities that are awake among many asleep:","type":"text"}],"type":"paragraph"},{"code":["struct Asleep: Component {}"],"type":"codeListing","syntax":"swift"},{"code":["var world = World()","let awake = world.spawn(Position(x: 0, y: 0), Velocity(dx: 1, dy: 0))","let sleeper = world.spawn(Position(x: 0, y: 0), Velocity(dx: 1, dy: 0), Asleep())","","world.cache(Query(Position.self, Velocity.self).without(Asleep.self))","","world.update(Position.self, reading: Velocity.self, where: .without(Asleep.self)) { position, row in","    position.x += row.components.dx","}","print(world[Position.self, of: awake].x, world[Position.self, of: sleeper].x)","\/\/ Prints \"1.0 0.0\""],"type":"codeListing","syntax":"swift"},{"inlineContent":[{"text":"The cache holds the entities that hold every component term of ","type":"text"},{"code":"query","type":"codeVoice"},{"text":" and every type its","type":"text"},{"text":" ","type":"text"},{"text":"filter requires, hold none of the types it excludes or skips by default (such as","type":"text"},{"text":" ","type":"text"},{"identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/Disabled","isActive":true,"type":"reference"},{"text":"), and pass its groups of alternatives that name no change ticks. A query or","type":"text"},{"text":" ","type":"text"},{"text":"update uses the cache when its own conditions imply the cache’s: it requires every type the","type":"text"},{"text":" ","type":"text"},{"text":"cache requires, excludes every type the cache excludes, and has the same groups of","type":"text"},{"text":" ","type":"text"},{"text":"alternatives. It walks the cache only when the cache is smaller than the storage it would","type":"text"},{"text":" ","type":"text"},{"text":"otherwise walk. A cache never changes which entities a visit finds, only how it finds them.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/AnyOf","isActive":true,"type":"reference"},{"text":" terms, change-tick filters and relation filters don’t narrow the cache; a visit","type":"text"},{"text":" ","type":"text"},{"text":"still checks them for each cached entity. Caching the same conditions twice keeps one","type":"text"},{"text":" ","type":"text"},{"text":"cache. A copy of the world keeps its caches; a snapshot doesn’t.","type":"text"}],"type":"paragraph"},{"style":"note","content":[{"type":"paragraph","inlineContent":[{"text":"O(","type":"text"},{"type":"emphasis","inlineContent":[{"type":"text","text":"n"}]},{"text":"·","type":"text"},{"type":"emphasis","inlineContent":[{"type":"text","text":"t"}]},{"text":") for ","type":"text"},{"type":"emphasis","inlineContent":[{"text":"n","type":"text"}]},{"text":" entities in the smallest required type, or every live","type":"text"},{"text":" ","type":"text"},{"text":"entity when the query requires none, and ","type":"text"},{"type":"emphasis","inlineContent":[{"type":"text","text":"t"}]},{"text":" conditions. Each cache adds O(","type":"text"},{"type":"emphasis","inlineContent":[{"text":"t","type":"text"}]},{"text":") to adding","type":"text"},{"text":" ","type":"text"},{"text":"or removing a component of a type it names.","type":"text"}]}],"type":"aside","name":"Complexity"}]}],"references":{"doc://WorldModule/documentation/WorldModule":{"role":"collection","url":"\/documentation\/worldmodule","abstract":[{"text":"Store the state of a game or simulation as entities and components, and read and change it with","type":"text"},{"text":" ","type":"text"},{"text":"queries, updates, and commands.","type":"text"}],"identifier":"doc:\/\/WorldModule\/documentation\/WorldModule","title":"WorldModule","type":"topic","kind":"symbol"},"doc://WorldModule/documentation/WorldModule/World":{"kind":"symbol","type":"topic","role":"symbol","title":"World","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"World"}],"url":"\/documentation\/worldmodule\/world","identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/World","navigatorTitle":[{"kind":"identifier","text":"World"}],"abstract":[{"type":"text","text":"A collection of entities, the components they hold, and resources."}]},"doc://WorldModule/documentation/WorldModule/World/lookup(_:)":{"identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/World\/lookup(_:)","role":"symbol","url":"\/documentation\/worldmodule\/world\/lookup(_:)","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"lookup"},{"kind":"text","text":"<"},{"kind":"genericParameter","text":"C"},{"kind":"text","text":">("},{"text":"C","kind":"typeIdentifier"},{"text":") -> [","kind":"text"},{"text":"Entity","kind":"typeIdentifier","preciseIdentifier":"s:11WorldModule6EntityV"},{"text":"]","kind":"text"}],"type":"topic","title":"lookup(_:)","kind":"symbol","abstract":[{"type":"text","text":"Returns the entities holding a component equal to the given value."}]},"doc://WorldModule/documentation/WorldModule/AnyOf":{"abstract":[{"type":"text","text":"A group of types an entity matches by matching at least one of them."}],"kind":"symbol","role":"symbol","title":"AnyOf","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"AnyOf"}],"url":"\/documentation\/worldmodule\/anyof","identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/AnyOf","navigatorTitle":[{"kind":"identifier","text":"AnyOf"}],"type":"topic"},"doc://WorldModule/documentation/WorldModule/World/group(checked:)":{"type":"topic","kind":"symbol","role":"symbol","title":"group(checked:)","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"group","kind":"identifier"},{"text":"<each ","kind":"text"},{"kind":"genericParameter","text":"C"},{"kind":"text","text":">("},{"kind":"externalParam","text":"checked"},{"kind":"text","text":": repeat (each "},{"kind":"typeIdentifier","text":"C"},{"kind":"text","text":").Type) "},{"kind":"keyw