{"seeAlsoSections":[{"identifiers":["doc:\/\/WorldModule\/documentation\/WorldModule\/World\/group(_:)","doc:\/\/WorldModule\/documentation\/WorldModule\/World\/group(checked:)","doc:\/\/WorldModule\/documentation\/WorldModule\/World\/index(_:)-u1gw","doc:\/\/WorldModule\/documentation\/WorldModule\/World\/index(_:)-2gtfg","doc:\/\/WorldModule\/documentation\/WorldModule\/World\/lookup(_:)","doc:\/\/WorldModule\/documentation\/WorldModule\/World\/lookup(_:equals:)","doc:\/\/WorldModule\/documentation\/WorldModule\/World\/index(ordered:)","doc:\/\/WorldModule\/documentation\/WorldModule\/World\/lookup(_:in:)","doc:\/\/WorldModule\/documentation\/WorldModule\/World\/entities(sortedBy:)"],"title":"Speeding Up Queries","generated":true,"anchor":"Speeding-Up-Queries"}],"schemaVersion":{"patch":0,"major":0,"minor":3},"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/WorldModule\/documentation\/WorldModule\/World\/cache(_:)"},"sections":[],"kind":"symbol","hierarchy":{"paths":[["doc:\/\/WorldModule\/documentation\/WorldModule","doc:\/\/WorldModule\/documentation\/WorldModule\/World"]]},"abstract":[{"text":"Keeps a list of the entities that match a query’s structure, so that queries and updates","type":"text"},{"text":" ","type":"text"},{"text":"with the same conditions visit only those entities.","type":"text"}],"variants":[{"paths":["\/documentation\/worldmodule\/world\/cache(_:)"],"traits":[{"interfaceLanguage":"swift"}]}],"primaryContentSections":[{"declarations":[{"languages":["swift"],"platforms":["Linux"],"tokens":[{"kind":"keyword","text":"mutating"},{"kind":"text","text":" "},{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"cache"},{"kind":"text","text":"<each "},{"kind":"genericParameter","text":"T"},{"kind":"text","text":">("},{"kind":"externalParam","text":"_"},{"kind":"text","text":" "},{"kind":"internalParam","text":"query"},{"kind":"text","text":": "},{"preciseIdentifier":"s:11WorldModule5QueryV","kind":"typeIdentifier","identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/Query","text":"Query"},{"kind":"text","text":"<repeat each "},{"kind":"typeIdentifier","text":"T"},{"kind":"text","text":">) "},{"kind":"keyword","text":"where"},{"kind":"text","text":" repeat each "},{"kind":"typeIdentifier","text":"T"},{"kind":"text","text":" : "},{"preciseIdentifier":"s:11WorldModule9QueryTermP","kind":"typeIdentifier","identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/QueryTerm","text":"QueryTerm"}]}],"kind":"declarations"},{"kind":"parameters","parameters":[{"content":[{"type":"paragraph","inlineContent":[{"text":"The query whose matching entities to keep.","type":"text"}]}],"name":"query"}]},{"kind":"content","content":[{"type":"heading","anchor":"discussion","level":2,"text":"Discussion"},{"type":"paragraph","inlineContent":[{"text":"A query normally walks the storage of one of its types and checks every entity there","type":"text"},{"text":" ","type":"text"},{"text":"against the rest of its conditions. When few of those entities match, most of that walk is","type":"text"},{"text":" ","type":"text"},{"text":"wasted. A cached query keeps the matching entities in a list of their own, kept current as","type":"text"},{"text":" ","type":"text"},{"text":"you spawn, insert, remove and despawn, so a visit can walk that list instead.","type":"text"}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Use a cache for a query you run often whose conditions exclude most of the entities it"},{"type":"text","text":" "},{"type":"text","text":"would otherwise walk, such as the few entities that are awake among many asleep:"}]},{"type":"codeListing","code":["struct Asleep: Component {}"],"syntax":"swift"},{"type":"codeListing","code":["var world = World()","let awake = world.spawn(Position(x: 0, y: 0), Velocity(dx: 1, dy: 0))","let sleeper = world.spawn(Position(x: 0, y: 0), Velocity(dx: 1, dy: 0), Asleep())","","world.cache(Query(Position.self, Velocity.self).without(Asleep.self))","","world.update(Position.self, reading: Velocity.self, where: .without(Asleep.self)) { position, row in","    position.x += row.components.dx","}","print(world[Position.self, of: awake].x, world[Position.self, of: sleeper].x)","\/\/ Prints \"1.0 0.0\""],"syntax":"swift"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The cache holds the entities that hold every component term of "},{"type":"codeVoice","code":"query"},{"type":"text","text":" and every type its"},{"type":"text","text":" "},{"type":"text","text":"filter requires, hold none of the types it excludes or skips by default (such as"},{"type":"text","text":" "},{"type":"reference","identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/Disabled","isActive":true},{"type":"text","text":"), and pass its groups of alternatives that name no change ticks. A query or"},{"type":"text","text":" "},{"type":"text","text":"update uses the cache when its own conditions imply the cache’s: it requires every type the"},{"type":"text","text":" "},{"type":"text","text":"cache requires, excludes every type the cache excludes, and has the same groups of"},{"type":"text","text":" "},{"type":"text","text":"alternatives. It walks the cache only when the cache is smaller than the storage it would"},{"type":"text","text":" "},{"type":"text","text":"otherwise walk. A cache never changes which entities a visit finds, only how it finds them."}]},{"type":"paragraph","inlineContent":[{"type":"reference","identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/AnyOf","isActive":true},{"type":"text","text":" terms, change-tick filters and relation filters don’t narrow the cache; a visit"},{"type":"text","text":" "},{"type":"text","text":"still checks them for each cached entity. Caching the same conditions twice keeps one"},{"type":"text","text":" "},{"type":"text","text":"cache. A copy of the world keeps its caches; a snapshot doesn’t."}]},{"style":"note","type":"aside","name":"Complexity","content":[{"inlineContent":[{"text":"O(","type":"text"},{"type":"emphasis","inlineContent":[{"text":"n","type":"text"}]},{"text":"·","type":"text"},{"type":"emphasis","inlineContent":[{"type":"text","text":"t"}]},{"text":") for ","type":"text"},{"type":"emphasis","inlineContent":[{"type":"text","text":"n"}]},{"text":" entities in the smallest required type, or every live","type":"text"},{"text":" ","type":"text"},{"text":"entity when the query requires none, and ","type":"text"},{"type":"emphasis","inlineContent":[{"text":"t","type":"text"}]},{"text":" conditions. Each cache adds O(","type":"text"},{"type":"emphasis","inlineContent":[{"text":"t","type":"text"}]},{"text":") to adding","type":"text"},{"text":" ","type":"text"},{"text":"or removing a component of a type it names.","type":"text"}],"type":"paragraph"}]}]}],"metadata":{"role":"symbol","extendedModule":"WorldModule","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"cache"},{"kind":"text","text":"<each "},{"kind":"genericParameter","text":"T"},{"kind":"text","text":">("},{"kind":"typeIdentifier","text":"Query","preciseIdentifier":"s:11WorldModule5QueryV"},{"kind":"text","text":"<repeat each "},{"kind":"typeIdentifier","text":"T"},{"kind":"text","text":">)"}],"remoteSource":{"url":"https:\/\/github.com\/Tyler-Keith-Thompson\/ECS\/blob\/main\/Sources\/WorldModule\/QueryCache.swift#L127","fileName":"QueryCache.swift"},"modules":[{"name":"WorldModule"}],"roleHeading":"Instance Method","symbolKind":"method","externalID":"s:11WorldModule0A0V5cacheyyAA5QueryVyxxQp_QPGRvzAA0D4TermRzlF","title":"cache(_:)"},"references":{"doc://WorldModule/documentation/WorldModule/World/index(_:)-u1gw":{"type":"topic","url":"\/documentation\/worldmodule\/world\/index(_:)-u1gw","abstract":[{"text":"Keeps a map from each value of a component type to the entities holding it, so that","type":"text"},{"text":" ","type":"text"},{"isActive":true,"identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/World\/lookup(_:)","type":"reference"},{"text":" finds them without walking the type’s storage.","type":"text"}],"role":"symbol","kind":"symbol","title":"index(_:)","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"index","kind":"identifier"},{"kind":"text","text":"<"},{"kind":"genericParameter","text":"C"},{"kind":"text","text":">("},{"kind":"typeIdentifier","text":"C"},{"kind":"text","text":".Type)"}],"identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/World\/index(_:)-u1gw"},"doc://WorldModule/documentation/WorldModule":{"type":"topic","identifier":"doc:\/\/WorldModule\/documentation\/WorldModule","abstract":[{"text":"Store the state of a game or simulation as entities and components, and read and change it with","type":"text"},{"text":" ","type":"text"},{"text":"queries, updates, and commands.","type":"text"}],"role":"collection","kind":"symbol","title":"WorldModule","url":"\/documentation\/worldmodule"},"doc://WorldModule/documentation/WorldModule/World/cache(_:)":{"type":"topic","url":"\/documentation\/worldmodule\/world\/cache(_:)","abstract":[{"type":"text","text":"Keeps a list of the entities that match a query’s structure, so that queries and updates"},{"type":"text","text":" "},{"type":"text","text":"with the same conditions visit only those entities."}],"role":"symbol","kind":"symbol","title":"cache(_:)","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"cache","kind":"identifier"},{"text":"<each ","kind":"text"},{"kind":"genericParameter","text":"T"},{"kind":"text","text":">("},{"kind":"typeIdentifier","text":"Query","preciseIdentifier":"s:11WorldModule5QueryV"},{"kind":"text","text":"<repeat each "},{"kind":"typeIdentifier","text":"T"},{"kind":"text","text":">)"}],"identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/World\/cache(_:)"},"doc://WorldModule/documentation/WorldModule/World/index(_:)-2gtfg":{"url":"\/documentation\/worldmodule\/world\/index(_:)