{"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/worldmodule\/world\/spawn(contentsof:)-7g753"]}],"abstract":[{"type":"text","text":"Adds the entities of a scene to the world as new entities, and inserts the scene’s"},{"type":"text","text":" "},{"type":"text","text":"resources."}],"schemaVersion":{"major":0,"minor":3,"patch":0},"seeAlsoSections":[{"identifiers":["doc:\/\/WorldModule\/documentation\/WorldModule\/World\/snapshot(_:)","doc:\/\/WorldModule\/documentation\/WorldModule\/World\/init(restoring:)-6alog","doc:\/\/WorldModule\/documentation\/WorldModule\/World\/scene(_:)","doc:\/\/WorldModule\/documentation\/WorldModule\/World\/init(restoring:)-7m7do"],"title":"Saving and Restoring","anchor":"Saving-and-Restoring","generated":true}],"hierarchy":{"paths":[["doc:\/\/WorldModule\/documentation\/WorldModule","doc:\/\/WorldModule\/documentation\/WorldModule\/World"]]},"metadata":{"fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"spawn"},{"kind":"text","text":"("},{"kind":"externalParam","text":"contentsOf"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:11WorldModule5SceneV","text":"Scene"},{"kind":"text","text":") -> ["},{"kind":"typeIdentifier","preciseIdentifier":"s:11WorldModule6EntityV","text":"Entity"},{"kind":"text","text":" : "},{"kind":"typeIdentifier","preciseIdentifier":"s:11WorldModule6EntityV","text":"Entity"},{"kind":"text","text":"]"}],"roleHeading":"Instance Method","title":"spawn(contentsOf:)","externalID":"s:11WorldModule0A0V5spawn10contentsOfSDyAA6EntityVAGGAA5SceneV_tF","symbolKind":"method","extendedModule":"WorldModule","modules":[{"name":"WorldModule"}],"role":"symbol","remoteSource":{"url":"https:\/\/github.com\/Tyler-Keith-Thompson\/ECS\/blob\/main\/Sources\/WorldModule\/Scene.swift#L894","fileName":"Scene.swift"}},"kind":"symbol","sections":[],"identifier":{"url":"doc:\/\/WorldModule\/documentation\/WorldModule\/World\/spawn(contentsOf:)-7g753","interfaceLanguage":"swift"},"primaryContentSections":[{"kind":"declarations","declarations":[{"tokens":[{"text":"@discardableResult","kind":"attribute"},{"text":" ","kind":"text"},{"text":"mutating","kind":"keyword"},{"text":" ","kind":"text"},{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"spawn","kind":"identifier"},{"text":"(","kind":"text"},{"text":"contentsOf","kind":"externalParam"},{"text":" ","kind":"text"},{"text":"scene","kind":"internalParam"},{"text":": ","kind":"text"},{"text":"Scene","preciseIdentifier":"s:11WorldModule5SceneV","kind":"typeIdentifier","identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/Scene"},{"text":") -> [","kind":"text"},{"text":"Entity","preciseIdentifier":"s:11WorldModule6EntityV","kind":"typeIdentifier","identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/Entity"},{"text":" : ","kind":"text"},{"text":"Entity","preciseIdentifier":"s:11WorldModule6EntityV","kind":"typeIdentifier","identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/Entity"},{"text":"]","kind":"text"}],"languages":["swift"],"platforms":["Linux"]}]},{"parameters":[{"name":"scene","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The scene whose entities to spawn."}]}]}],"kind":"parameters"},{"content":[{"text":"Return Value","anchor":"return-value","type":"heading","level":2},{"inlineContent":[{"text":"The entity spawned for each live entity of the scene, keyed by the scene’s","type":"text"},{"text":" ","type":"text"},{"text":"entity.","type":"text"}],"type":"paragraph"}],"kind":"content"},{"mentions":["doc:\/\/WorldModule\/documentation\/WorldModule\/SavingAndLoadingWorlds"],"kind":"mentions"},{"content":[{"anchor":"discussion","type":"heading","text":"Discussion","level":2},{"inlineContent":[{"type":"text","text":"Use this method to place a saved group of entities into a world, as many times as you"},{"type":"text","text":" "},{"type":"text","text":"like: a squad of enemies, a room of a level. Each live entity of the scene is spawned as a"},{"type":"text","text":" "},{"type":"text","text":"new entity with its components, hierarchy and relations. The scene’s resources replace"},{"type":"text","text":" "},{"type":"text","text":"any of the same types the world holds."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"A component that conforms to "},{"identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/MapEntities","isActive":true,"type":"reference"},{"type":"text","text":", such as a relation’s "},{"identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/Targets","isActive":true,"type":"reference"},{"type":"text","text":", has each"},{"type":"text","text":" "},{"type":"text","text":"of the scene’s entities it names replaced by the entity spawned for it. Entities outside"},{"type":"text","text":" "},{"type":"text","text":"the scene are left as they are. The following example spawns a squad twice, and each"},{"type":"text","text":" "},{"type":"text","text":"copy’s follower follows its own copy’s leader:"}],"type":"paragraph"},{"type":"codeListing","syntax":"swift","code":["var registry = TypeRegistry()","try registry.register(Name.self, named: \"Name\")","try registry.register(Follows.self, named: \"Follows\")","","var squad = World()","let leader = squad.spawn(Name(value: \"Captain\"))","let follower = squad.spawn(Name(value: \"Private\"), Follows(leader: leader))","let saved = squad.scene(registry)","","var world = World()","let alpha = world.spawn(contentsOf: saved)","let bravo = world.spawn(contentsOf: saved)","print(world.count)","\/\/ Prints \"4\"","","let bravoFollower = bravo[follower]!","print(world[Follows.self, of: bravoFollower].leader == bravo[leader])","\/\/ Prints \"true\"","print(alpha[leader] == bravo[leader])","\/\/ Prints \"false\""]},{"inlineContent":[{"type":"text","text":"Components are inserted as "},{"type":"codeVoice","code":"insert(_:into:)"},{"type":"text","text":" inserts them, running hooks."}],"type":"paragraph"},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"O("},{"inlineContent":[{"text":"n","type":"text"}],"type":"emphasis"},{"type":"text","text":"), where "},{"inlineContent":[{"text":"n","type":"text"}],"type":"emphasis"},{"type":"text","text":" is the number of entities and components spawned."}]}],"name":"Complexity","type":"aside","style":"note"}],"kind":"content"}],"references":{"doc://WorldModule/documentation/WorldModule/Scene":{"title":"Scene","url":"\/documentation\/worldmodule\/scene","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"Scene"}],"abstract":[{"text":"A saved copy of a world’s entities, hierarchy, and the components and resources of the types","type":"text"},{"text":" ","type":"text"},{"text":"a registry names.","type":"text"}],"type":"topic","role":"symbol","navigatorTitle":[{"kind":"identifier","text":"Scene"}],"kind":"symbol","identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/Scene"},"doc://WorldModule/documentation/WorldModule/Entity":{"type":"topic","kind":"symbol","navigatorTitle":[{"text":"Entity","kind":"identifier"}],"title":"Entity","identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/Entity","abstract":[{"text":"A handle that identifies one entity in a world.","type":"text"}],"role":"symbol","url":"\/documentation\/worldmodule\/entity","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Entity","kind":"identifier"}]},"doc://WorldModule/documentation/WorldModule/World/init(restoring:)-6alog":{"url":"\/documentation\/worldmodule\/world\/init(restoring:)-6alog","abstract":[{"text":"Creates a world from a snapshot, with the entities, hierarchy and components it saved.","type":"text"}],"title":"init(restoring:)","role":"symbol","kind":"symbol","identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/World\/init(restoring:)-6alog","fragments":[{"text":"init","kind":"identifier