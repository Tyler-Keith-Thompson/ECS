\/WorldModule\/documentation\/WorldModule\/SavingAndLoadingWorlds"],"kind":"mentions"},{"kind":"content","content":[{"anchor":"discussion","level":2,"type":"heading","text":"Discussion"},{"inlineContent":[{"text":"Use this method to place a saved group of entities into a world, as many times as you","type":"text"},{"text":" ","type":"text"},{"text":"like: a squad of enemies, a room of a level. Each live entity of the scene is spawned as a","type":"text"},{"text":" ","type":"text"},{"text":"new entity with its components, hierarchy and relations. The scene’s resources replace","type":"text"},{"text":" ","type":"text"},{"text":"any of the same types the world holds.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"A component that conforms to ","type":"text"},{"identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/MapEntities","isActive":true,"type":"reference"},{"text":", such as a relation’s ","type":"text"},{"identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/Targets","isActive":true,"type":"reference"},{"text":", has each","type":"text"},{"text":" ","type":"text"},{"text":"of the scene’s entities it names replaced by the entity spawned for it. Entities outside","type":"text"},{"text":" ","type":"text"},{"text":"the scene are left as they are. The following example spawns a squad twice, and each","type":"text"},{"text":" ","type":"text"},{"text":"copy’s follower follows its own copy’s leader:","type":"text"}],"type":"paragraph"},{"syntax":"swift","code":["var registry = TypeRegistry()","try registry.register(Name.self, named: \"Name\")","try registry.register(Follows.self, named: \"Follows\")","","var squad = World()","let leader = squad.spawn(Name(value: \"Captain\"))","let follower = squad.spawn(Name(value: \"Private\"), Follows(leader: leader))","let saved = squad.scene(registry)","","var world = World()","let alpha = world.spawn(contentsOf: saved)","let bravo = world.spawn(contentsOf: saved)","print(world.count)","\/\/ Prints \"4\"","","let bravoFollower = bravo[follower]!","print(world[Follows.self, of: bravoFollower].leader == bravo[leader])","\/\/ Prints \"true\"","print(alpha[leader] == bravo[leader])","\/\/ Prints \"false\""],"type":"codeListing"},{"inlineContent":[{"text":"Components are inserted as ","type":"text"},{"code":"insert(_:into:)","type":"codeVoice"},{"text":" inserts them, running hooks.","type":"text"}],"type":"paragraph"},{"style":"note","name":"Complexity","content":[{"type":"paragraph","inlineContent":[{"text":"O(","type":"text"},{"inlineContent":[{"text":"n","type":"text"}],"type":"emphasis"},{"text":"), where ","type":"text"},{"inlineContent":[{"text":"n","type":"text"}],"type":"emphasis"},{"text":" is the number of entities and components spawned.","type":"text"}]}],"type":"aside"}]}],"variants":[{"paths":["\/documentation\/worldmodule\/world\/spawn(contentsof:)-7g753"],"traits":[{"interfaceLanguage":"swift"}]}],"hierarchy":{"paths":[["doc:\/\/WorldModule\/documentation\/WorldModule","doc:\/\/WorldModule\/documentation\/WorldModule\/World"]]},"kind":"symbol","identifier":{"interfaceLanguage":"swift","url":"doc:\/\/WorldModule\/documentation\/WorldModule\/World\/spawn(contentsOf:)-7g753"},"schemaVersion":{"major":0,"patch":0,"minor":3},"metadata":{"modules":[{"name":"WorldModule"}],"roleHeading":"Instance Method","extendedModule":"WorldModule","title":"spawn(contentsOf:)","role":"symbol","symbolKind":"method","externalID":"s:11WorldModule0A0V5spawn10contentsOfSDyAA6EntityVAGGAA5SceneV_tF","remoteSource":{"url":"https:\/\/github.com\/Tyler-Keith-Thompson\/ECS\/blob\/main\/Sources\/WorldModule\/Scene.swift#L894","fileName":"Scene.swift"},"fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"spawn","kind":"identifier"},{"text":"(","kind":"text"},{"text":"contentsOf","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"Scene","preciseIdentifier":"s:11WorldModule5SceneV","kind":"typeIdentifier"},{"text":") -> [","kind":"text"},{"text"