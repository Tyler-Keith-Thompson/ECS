{"schemaVersion":{"minor":3,"patch":0,"major":0},"hierarchy":{"paths":[["doc:\/\/WorldModule\/documentation\/WorldModule","doc:\/\/WorldModule\/documentation\/WorldModule\/World"]]},"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/WorldModule\/documentation\/WorldModule\/World\/spawn(contentsOf:)-7g753"},"kind":"symbol","variants":[{"paths":["\/documentation\/worldmodule\/world\/spawn(contentsof:)-7g753"],"traits":[{"interfaceLanguage":"swift"}]}],"metadata":{"modules":[{"name":"WorldModule"}],"symbolKind":"method","extendedModule":"WorldModule","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"spawn"},{"kind":"text","text":"("},{"kind":"externalParam","text":"contentsOf"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"Scene","preciseIdentifier":"s:11WorldModule5SceneV"},{"kind":"text","text":") -> ["},{"kind":"typeIdentifier","text":"Entity","preciseIdentifier":"s:11WorldModule6EntityV"},{"kind":"text","text":" : "},{"kind":"typeIdentifier","text":"Entity","preciseIdentifier":"s:11WorldModule6EntityV"},{"kind":"text","text":"]"}],"remoteSource":{"url":"https:\/\/github.com\/Tyler-Keith-Thompson\/ECS\/blob\/main\/Sources\/WorldModule\/Scene.swift#L894","fileName":"Scene.swift"},"role":"symbol","externalID":"s:11WorldModule0A0V5spawn10contentsOfSDyAA6EntityVAGGAA5SceneV_tF","title":"spawn(contentsOf:)","roleHeading":"Instance Method"},"seeAlsoSections":[{"anchor":"Saving-and-Restoring","title":"Saving and Restoring","identifiers":["doc:\/\/WorldModule\/documentation\/WorldModule\/World\/snapshot(_:)","doc:\/\/WorldModule\/documentation\/WorldModule\/World\/init(restoring:)-6alog","doc:\/\/WorldModule\/documentation\/WorldModule\/World\/scene(_:)","doc:\/\/WorldModule\/documentation\/WorldModule\/World\/init(restoring:)-7m7do"],"generated":true}],"primaryContentSections":[{"declarations":[{"platforms":["Linux"],"tokens":[{"kind":"attribute","text":"@discardableResult"},{"kind":"text","text":" "},{"kind":"keyword","text":"mutating"},{"kind":"text","text":" "},{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"spawn"},{"kind":"text","text":"("},{"kind":"externalParam","text":"contentsOf"},{"kind":"text","text":" "},{"kind":"internalParam","text":"scene"},{"kind":"text","text":": "},{"preciseIdentifier":"s:11WorldModule5SceneV","kind":"typeIdentifier","text":"Scene","identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/Scene"},{"kind":"text","text":") -> ["},{"preciseIdentifier":"s:11WorldModule6EntityV","kind":"typeIdentifier","text":"Entity","identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/Entity"},{"kind":"text","text":" : "},{"preciseIdentifier":"s:11WorldModule6EntityV","kind":"typeIdentifier","text":"Entity","identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/Entity"},{"kind":"text","text":"]"}],"languages":["swift"]}],"kind":"declarations"},{"parameters":[{"name":"scene","content":[{"inlineContent":[{"type":"text","text":"The scene whose entities to spawn."}],"type":"paragraph"}]}],"kind":"parameters"},{"content":[{"anchor":"return-value","text":"Return Value","type":"heading","level":2},{"type":"paragraph","inlineContent":[{"text":"The entity spawned for each live entity of the scene, keyed by the scene’s","type":"text"},{"text":" ","type":"text"},{"text":"entity.","type":"text"}]}],"kind":"content"},{"mentions":["doc:\/\/WorldModule\/documentation\/WorldModule\/SavingAndLoadingWorlds"],"kind":"mentions"},{"content":[{"type":"heading","text":"Discussion","anchor":"discussion","level":2},{"type":"paragraph","inlineContent":[{"text":"Use this method to place a saved group of entities into a world, as many times as you","type":"text"},{"text":" ","type":"text"},{"text":"like: a squad of enemies, a room of a level. Each live entity of the scene is spawned as a","type":"text"},{"text":" ","type":"text"},{"text":"new entity with its components, hierarchy and relations. The scene’s resources replace","type":"text"},{"text":" ","type":"text"},{"text":"any of the same types the world holds.","type":"text"}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"A component that conforms to "},{"type":"reference","isActive":true,"identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/MapEntities"},{"type":"text","text":", such as a relation’s "},{"type":"reference","isActive":true,"identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/Targets"},{"type":"text","text":", has each"},{"type":"text","text":" "},{"type":"text","text":"of the scene’s entities it names replaced by the entity spawned for it. Entities outside"},{"type":"text","text":" "},{"type":"text","text":"the scene are left as they are. The following example spawns a squad twice, and each"},{"type":"text","text":" "},{"type":"text","text":"copy’s follower follows its own copy’s leader:"}]},{"type":"codeListing","code":["var registry = TypeRegistry()","try registry.register(Name.self, named: \"Name\")","try registry.register(Follows.self, named: \"Follows\")","","var squad = World()","let leader = squad.spawn(Name(value: \"Captain\"))","let follower = squad.spawn(Name(value: \"Private\"), Follows(leader: leader))","let saved = squad.scene(registry)","","var world = World()","let alpha = world.spawn(contentsOf: saved)","let bravo = world.spawn(contentsOf: saved)","print(world.count)","\/\/ Prints \"4\"","","let bravoFollower = bravo[follower]!","print(world[Follows.self, of: bravoFollower].leader == bravo[leader])","\/\/ Prints \"true\"","print(alpha[leader] == bravo[leader])","\/\/ Prints \"false\""],"syntax":"swift"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Components are inserted as "},{"type":"codeVoice","code":"insert(_:into:)"},{"type":"text","text":" inserts them, running hooks."}]},{"type":"aside","name":"Complexity","style":"note","content":[{"inlineContent":[{"text":"O(","type":"text"},{"inlineContent":[{"type":"text","text":"n"}],"type":"emphasis"},{"text":"), where ","type":"text"},{"inlineContent":[{"type":"text","text":"n"}],"type":"emphasis"},{"text":" is the number of entities and components spawned.","type":"text"}],"type":"paragraph"}]}],"kind":"content"}],"abstract":[{"text":"Adds the entities of a scene to the world as new entities, and inserts the scene’s","type":"text"},{"text":" ","type":"text"},{"text":"resources.","type":"text"}],"sections":[],"references":{"doc://WorldModule/documentation/WorldModule/World/init(restoring:)-6alog":{"kind":"symbol","title":"init(restoring:)","fragments":[{"kind":"identifier","text":"init"},{"kind":"text","text":"<each "},{"kind":"genericParameter","text":"C"},{"kind":"text","text":">("},{"kind":"externalParam","text":"restoring"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"WorldSnapshot","preciseIdentifier":"s:11WorldModule0A8SnapshotV"},{"kind":"text","text":"<repeat each "},{"kind":"typeIdentifier","text":"C"},{"kind":"text","text":">)"}],"identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/World\/init(restoring:)-6alog","abstract":[{"type":"text","text":"Creates a world from a snapshot, with the entities, hierarchy and components it saved."}],"type":"topic","role":"symbol","url":"\/documentation\/worldmodule\/world\/init(restoring:)-6alog"},"doc://WorldModule/documentation/WorldModule/Entity":{"type":"topic","title":"Entity","role":"symbol","abstract":[{"type":"text","text":"A handle that identifies one entity in a world."}],"fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"Entity"}],"kind":"symbol","navigatorTitle":[{"kind":"identifier","text":"Entity"}],"url":"\/documentation\/worldmodule\/entity","identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/Entity"},"doc://WorldModule/documentation/WorldModule/SavingAndLoadingWorlds":{"type":"topic","title":"Saving and Loading Worlds","role":"article","abstract":[{"type":"text","text":"Save a world’s entities and compon