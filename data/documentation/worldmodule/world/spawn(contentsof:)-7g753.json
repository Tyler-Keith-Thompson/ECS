{"kind":"symbol","hierarchy":{"paths":[["doc:\/\/WorldModule\/documentation\/WorldModule","doc:\/\/WorldModule\/documentation\/WorldModule\/World"]]},"identifier":{"url":"doc:\/\/WorldModule\/documentation\/WorldModule\/World\/spawn(contentsOf:)-7g753","interfaceLanguage":"swift"},"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/worldmodule\/world\/spawn(contentsof:)-7g753"]}],"sections":[],"schemaVersion":{"major":0,"patch":0,"minor":3},"metadata":{"fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"spawn"},{"kind":"text","text":"("},{"kind":"externalParam","text":"contentsOf"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"Scene","preciseIdentifier":"s:11WorldModule5SceneV"},{"kind":"text","text":") -> ["},{"kind":"typeIdentifier","text":"Entity","preciseIdentifier":"s:11WorldModule6EntityV"},{"kind":"text","text":" : "},{"kind":"typeIdentifier","text":"Entity","preciseIdentifier":"s:11WorldModule6EntityV"},{"kind":"text","text":"]"}],"roleHeading":"Instance Method","modules":[{"name":"WorldModule"}],"remoteSource":{"url":"https:\/\/github.com\/Tyler-Keith-Thompson\/ECS\/blob\/main\/Sources\/WorldModule\/Scene.swift#L894","fileName":"Scene.swift"},"symbolKind":"method","extendedModule":"WorldModule","role":"symbol","externalID":"s:11WorldModule0A0V5spawn10contentsOfSDyAA6EntityVAGGAA5SceneV_tF","title":"spawn(contentsOf:)"},"seeAlsoSections":[{"generated":true,"anchor":"Saving-and-Restoring","title":"Saving and Restoring","identifiers":["doc:\/\/WorldModule\/documentation\/WorldModule\/World\/snapshot(_:)","doc:\/\/WorldModule\/documentation\/WorldModule\/World\/init(restoring:)-6alog","doc:\/\/WorldModule\/documentation\/WorldModule\/World\/scene(_:)","doc:\/\/WorldModule\/documentation\/WorldModule\/World\/init(restoring:)-7m7do"]}],"abstract":[{"text":"Adds the entities of a scene to the world as new entities, and inserts the scene’s","type":"text"},{"text":" ","type":"text"},{"text":"resources.","type":"text"}],"primaryContentSections":[{"declarations":[{"platforms":["Linux"],"languages":["swift"],"tokens":[{"text":"@discardableResult","kind":"attribute"},{"text":" ","kind":"text"},{"text":"mutating","kind":"keyword"},{"text":" ","kind":"text"},{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"spawn","kind":"identifier"},{"text":"(","kind":"text"},{"text":"contentsOf","kind":"externalParam"},{"text":" ","kind":"text"},{"text":"scene","kind":"internalParam"},{"text":": ","kind":"text"},{"text":"Scene","kind":"typeIdentifier","identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/Scene","preciseIdentifier":"s:11WorldModule5SceneV"},{"text":") -> [","kind":"text"},{"text":"Entity","kind":"typeIdentifier","identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/Entity","preciseIdentifier":"s:11WorldModule6EntityV"},{"text":" : ","kind":"text"},{"text":"Entity","kind":"typeIdentifier","identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/Entity","preciseIdentifier":"s:11WorldModule6EntityV"},{"text":"]","kind":"text"}]}],"kind":"declarations"},{"parameters":[{"name":"scene","content":[{"inlineContent":[{"type":"text","text":"The scene whose entities to spawn."}],"type":"paragraph"}]}],"kind":"parameters"},{"kind":"content","content":[{"level":2,"type":"heading","text":"Return Value","anchor":"return-value"},{"type":"paragraph","inlineContent":[{"text":"The entity spawned for each live entity of the scene, keyed by the scene’s","type":"text"},{"text":" ","type":"text"},{"text":"entity.","type":"text"}]}]},{"kind":"mentions","mentions":["doc:\/\/WorldModule\/documentation\/WorldModule\/SavingAndLoadingWorlds"]},{"kind":"content","content":[{"level":2,"type":"heading","anchor":"discussion","text":"Discussion"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Use this method to place a saved group of entities into a world, as many times as you"},{"type":"text","text":" "},{"type":"text","text":"like: a squad of enemies, a room of a level. Each live entity of the scene is spawned as a"},{"type":"text","text":" "},{"type":"text","text":"new entity with its components, hierarchy and relations. The scene’s resources replace"},{"type":"text","text":" "},{"type":"text","text":"any of the same types the world holds."}]},{"type":"paragraph","inlineContent":[{"text":"A component that conforms to ","type":"text"},{"identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/MapEntities","type":"reference","isActive":true},{"text":", such as a relation’s ","type":"text"},{"identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/Targets","type":"reference","isActive":true},{"text":", has each","type":"text"},{"text":" ","type":"text"},{"text":"of the scene’s entities it names replaced by the entity spawned for it. Entities outside","type":"text"},{"text":" ","type":"text"},{"text":"the scene are left as they are. The following example spawns a squad twice, and each","type":"text"},{"text":" ","type":"text"},{"text":"copy’s follower follows its own copy’s leader:","type":"text"}]},{"type":"codeListing","syntax":"swift","code":["var registry = TypeRegistry()","try registry.register(Name.self, named: \"Name\")","try registry.register(Follows.self, named: \"Follows\")","","var squad = World()","let leader = squad.spawn(Name(value: \"Captain\"))","let follower = squad.spawn(Name(value: \"Private\"), Follows(leader: leader))","let saved = squad.scene(registry)","","var world = World()","let alpha = world.spawn(contentsOf: saved)","let bravo = world.spawn(contentsOf: saved)","print(world.count)","\/\/ Prints \"4\"","","let bravoFollower = bravo[follower]!","print(world[Follows.self, of: bravoFollower].leader == bravo[leader])","\/\/ Prints \"true\"","print(alpha[leader] == bravo[leader])","\/\/ Prints \"false\""]},{"type":"paragraph","inlineContent":[{"text":"Components are inserted as ","type":"text"},{"code":"insert(_:into:)","type":"codeVoice"},{"text":" inserts them, running hooks.","type":"text"}]},{"type":"aside","style":"note","name":"Complexity","content":[{"inlineContent":[{"text":"O(","type":"text"},{"inlineContent":[{"type":"text","text":"n"}],"type":"emphasis"},{"text":"), where ","type":"text"},{"inlineContent":[{"text":"n","type":"text"}],"type":"emphasis"},{"text":" is the number of entities and components spawned.","type":"text"}],"type":"paragraph"}]}]}],"references":{"doc://WorldModule/documentation/WorldModule/MapEntities":{"url":"\/documentation\/worldmodule\/mapentities","kind":"symbol","fragments":[{"text":"protocol","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MapEntities","kind":"identifier"}],"type":"topic","identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/MapEntities","title":"MapEntities","navigatorTitle":[{"text":"MapEntities","kind":"identifier"}],"role":"symbol","abstract":[{"type":"text","text":"A type whose values name other entities, which can be pointed at different entities."}]},"doc://WorldModule/documentation/WorldModule/World":{"kind":"symbol","abstract":[{"text":"A collection of entities, the components they hold, and resources.","type":"text"}],"identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/World","url":"\/documentation\/worldmodule\/world","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"World"}],"title":"World","navigatorTitle":[{"kind":"identifier","text":"World"}],"role":"symbol","type":"topic"},"doc://WorldModule/documentation/WorldModule":{"kind":"symbol","abstract":[{"text":"Store the state of a game or simulation as entities and components, and read and change it with","type":"text"},{"text":" ","type":"text"},{"text":"queries, updates, and commands.","type":"text"}],"identifier":"doc:\/\/WorldModule\/documentation\/WorldModule","url":"\/documentation\/worldmodule","title":"WorldModule","role":"collection","type":"topic"},"doc://WorldModule/documentation/WorldModule/World/spawn