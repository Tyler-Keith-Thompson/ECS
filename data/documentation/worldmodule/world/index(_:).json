{"identifier":{"url":"doc:\/\/WorldModule\/documentation\/WorldModule\/World\/index(_:)","interfaceLanguage":"swift"},"primaryContentSections":[{"kind":"declarations","declarations":[{"tokens":[{"text":"mutating","kind":"keyword"},{"text":" ","kind":"text"},{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"index","kind":"identifier"},{"text":"<","kind":"text"},{"text":"C","kind":"genericParameter"},{"text":">(","kind":"text"},{"kind":"externalParam","text":"_"},{"kind":"text","text":" "},{"kind":"internalParam","text":"type"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"C"},{"kind":"text","text":".Type) "},{"kind":"keyword","text":"where"},{"kind":"text","text":" "},{"kind":"typeIdentifier","text":"C"},{"kind":"text","text":" : "},{"kind":"typeIdentifier","text":"Hashable","preciseIdentifier":"s:SH"},{"kind":"text","text":", "},{"kind":"typeIdentifier","text":"C"},{"kind":"text","text":" : "},{"kind":"typeIdentifier","text":"Component","preciseIdentifier":"s:11WorldModule9ComponentP","identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/Component"}],"platforms":["Linux"],"languages":["swift"]}]},{"kind":"parameters","parameters":[{"name":"type","content":[{"inlineContent":[{"text":"The component type to index.","type":"text"}],"type":"paragraph"}]}]},{"kind":"content","content":[{"text":"Discussion","type":"heading","level":2,"anchor":"discussion"},{"type":"paragraph","inlineContent":[{"text":"Use an index when you often look entities up by a component’s value, such as finding an","type":"text"},{"text":" ","type":"text"},{"text":"entity by its name:","type":"text"}]},{"code":["var world = World()","let bob = world.spawn(Name(value: \"bob\"), Health(current: 3))","world.spawn(Name(value: \"ada\"), Health(current: 4))","world.index(Name.self)","","print(world.lookup(Name(value: \"bob\")) == [bob])","\/\/ Prints \"true\""],"type":"codeListing","syntax":"swift"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Spawning, inserting, removing and despawning keep the index current. A change made in place,"},{"type":"text","text":" "},{"type":"text","text":"through the world’s subscript, an update or a mutable span, leaves the index out of date"},{"type":"text","text":" "},{"type":"text","text":"until the next "},{"type":"reference","identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/World\/advanceChangeTick()","isActive":true},{"type":"text","text":", which a schedule calls before each system, rebuilds"},{"type":"text","text":" "},{"type":"text","text":"it. Until then, "},{"type":"reference","identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/World\/lookup(_:)","isActive":true},{"type":"text","text":" walks the storage, so its answer is always current. Index a"},{"type":"text","text":" "},{"type":"text","text":"type whose values change rarely. Indexing a type twice keeps one index. A copy of the world"},{"type":"text","text":" "},{"type":"text","text":"keeps its indexes; a snapshot doesn’t."}]},{"type":"aside","name":"Complexity","content":[{"inlineContent":[{"type":"text","text":"O("},{"type":"emphasis","inlineContent":[{"type":"text","text":"n"}]},{"type":"text","text":") for "},{"type":"emphasis","inlineContent":[{"type":"text","text":"n"}]},{"type":"text","text":" entities holding a "},{"code":"C","type":"codeVoice"},{"type":"text","text":"."}],"type":"paragraph"}],"style":"note"}]}],"kind":"symbol","metadata":{"extendedModule":"WorldModule","role":"symbol","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"index","kind":"identifier"},{"kind":"text","text":"<"},{"kind":"genericParameter","text":"C"},{"kind":"text","text":">("},{"kind":"typeIdentifier","text":"C"},{"kind":"text","text":".Type)"}],"remoteSource":{"fileName":"ValueIndex.swift","url":"https:\/\/github.com\/Tyler-Keith-Thompson\/ECS\/blob\/main\/Sources\/WorldModule\/ValueIndex.swift#L93"},"externalID":"s:11WorldModule0A0V5indexyyxmSHRzAA9ComponentRzlF","modules