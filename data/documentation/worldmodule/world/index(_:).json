e next "},{"isActive":true,"type":"reference","identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/World\/advanceChangeTick()"},{"type":"text","text":", which a schedule calls before each system, rebuilds"},{"type":"text","text":" "},{"type":"text","text":"it. Until then, "},{"isActive":true,"type":"reference","identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/World\/lookup(_:)"},{"type":"text","text":" walks the storage, so its answer is always current. Index a"},{"type":"text","text":" "},{"type":"text","text":"type whose values change rarely. Indexing a type twice keeps one index. A copy of the world"},{"type":"text","text":" "},{"type":"text","text":"keeps its indexes; a snapshot doesn’t."}],"type":"paragraph"},{"style":"note","name":"Complexity","content":[{"type":"paragraph","inlineContent":[{"text":"O(","type":"text"},{"inlineContent":[{"text":"n","type":"text"}],"type":"emphasis"},{"text":") for ","type":"text"},{"inlineContent":[{"type":"text","text":"n"}],"type":"emphasis"},{"text":" entities holding a ","type":"text"},{"code":"C","type":"codeVoice"},{"text":".","type":"text"}]}],"type":"aside"}]}],"references":{"doc://WorldModule/documentation/WorldModule/World/lookup(_:)":{"identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/World\/lookup(_:)","kind":"symbol","type":"topic","title":"lookup(_:)","url":"\/documentation\/worldmodule\/world\/lookup(_:)","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"lookup","kind":"identifier"},{"text":"<","kind":"text"},{"text":"C","kind":"genericParameter"},{"text":">(","kind":"text"},{"kind":"typeIdentifier","text":"C"},{"kind":"text","text":") -> ["},{"kind":"typeIdentifier","text":"Entity","preciseIdentifier":"s:11WorldModule6EntityV"},{"kind":"text","text":"]"}],"abstract":[{"text":"Returns the entities holding a component equal to the given value.","type":"text"}],"role":"symbol"},"doc://WorldModule/documentation/WorldModule/World":{"type":"topic","fra