o)","\/\/ Prints \"true\""],"type":"codeListing","syntax":"swift"},{"inlineContent":[{"type":"text","text":"A hook runs after the world operation that fired it has finished, so it sees every"},{"type":"text","text":" "},{"type":"text","text":"component a spawn or bundle insert gave. Hooks run in the order they were fired. A change"},{"type":"text","text":" "},{"type":"text","text":"that a hook makes fires hooks of its own, which run after the hooks already waiting."}],"type":"paragraph"},{"style":"note","type":"aside","content":[{"inlineContent":[{"text":"Changes made in place, through the world’s subscript or an update, run no hooks.","type":"text"},{"text":" ","type":"text"},{"text":"Find those with change detection instead.","type":"text"}],"type":"paragraph"}],"name":"Note"},{"style":"note","type":"aside","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"O(1) amortized."}]}],"name":"Complexity"}]}],"references":{"doc://WorldModule/documentation/WorldModule/World/onRemove(_:perform:)-2t2p":{"type":"topic","abstract":[{"type":"text","text":"Registers a closure to run whenever an entity loses a component of the given type."}],"identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/World\/onRemove(_:perform:)-2t2p","role":"symbol","kind":"symbol","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"onRemove","kind":"identifier"},{"text":"<","kind":"text"},{"text":"C","kind":"genericParameter"},{"text":">(","kind":"text"},{"text":"C","kind":"typeIdentifier"},{"text":".Type, ","kind":"text"},{"text":"perform","kind":"externalParam"},{"text":": (","kind":"text"},{"text":"inout","kind":"keyword"},{"text":" ","kind":"text"},{"text":"World","preciseIdentifier":"s:11WorldModule0A0V","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"Entity","preciseIdentifier":"s:11WorldModule6EntityV","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"C","kind":"typeIdentifier"},{"text":") -> ","kind":"text"},{