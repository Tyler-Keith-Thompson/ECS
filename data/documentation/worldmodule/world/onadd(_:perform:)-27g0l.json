"text":"_","kind":"externalParam"},{"text":" ","kind":"text"},{"text":"type","kind":"internalParam"},{"text":": ","kind":"text"},{"text":"C","kind":"typeIdentifier"},{"text":".Type, ","kind":"text"},{"text":"perform","kind":"externalParam"},{"text":" ","kind":"text"},{"text":"hook","kind":"internalParam"},{"text":": ","kind":"text"},{"text":"@escaping ","kind":"attribute"},{"text":"@Sendable","kind":"attribute"},{"text":" (","kind":"text"},{"text":"inout","kind":"keyword"},{"text":" ","kind":"text"},{"text":"World","preciseIdentifier":"s:11WorldModule0A0V","kind":"typeIdentifier","identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/World"},{"text":", ","kind":"text"},{"text":"Entity","preciseIdentifier":"s:11WorldModule6EntityV","kind":"typeIdentifier","identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/Entity"},{"text":") -> ","kind":"text"},{"text":"Void","preciseIdentifier":"s:s4Voida","kind":"typeIdentifier"},{"text":") ","kind":"text"},{"text":"where","kind":"keyword"},{"text":" ","kind":"text"},{"text":"C","kind":"typeIdentifier"},{"text":" : ","kind":"text"},{"text":"Component","preciseIdentifier":"s:11WorldModule9ComponentP","kind":"typeIdentifier","identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/Component"}]}]},{"kind":"parameters","parameters":[{"content":[{"inlineContent":[{"type":"text","text":"The component type to watch."}],"type":"paragraph"}],"name":"type"},{"content":[{"type":"paragraph","inlineContent":[{"text":"The closure to run, given the world and the entity that gained a ","type":"text"},{"code":"C","type":"codeVoice"},{"text":".","type":"text"}]}],"name":"hook"}]},{"kind":"content","content":[{"type":"heading","text":"Discussion","anchor":"discussion","level":2},{"type":"paragraph","inlineContent":[{"text":"Use hooks to keep data outside the components in step with them, such as an index of","type":"text"},{"text":" ","type":"text"},{"text":"entities by name. An ","type":"text"},{"type":"emphasis","inlineContent":[{"type":"text","text":"add hook"}]},{"text":" runs when an entity that didn’t hold a ","type":"text"},{"type":"codeVoice","code":"C"},{"text":" gets one, by","type":"text"},{"text":" ","type":"text"},{"text":"spawning, inserting or applying a command. Replacing a ","type":"text"},{"type":"codeVoice","code":"C"},{"text":" the entity already holds","type":"text"},{"text":" ","type":"text"},{"text":"doesn’t run it; see ","type":"text"},{"type":"reference","identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/World\/onInsert(_:perform:)","isActive":true},{"text":" for a hook that runs then too.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"The following example records each named entity in a resource as it’s spawned:","type":"text"}]},{"type":"codeListing","code":["struct NameDirectory: Resource { var entities: [String: Entity] = [:] }","","var world = World()","world.resources.insert(NameDirectory())","world.onAdd(Name.self) { world, entity in","    let name = world[Name.self, of: entity].value","    world.resources[NameDirectory.self].entities[name] = entity","}","","let hero = world.spawn(Name(value: \"Hero\"))","print(world.resources[NameDirectory.self].entities[\"Hero\"] == hero)","\/\/ Prints \"true\""],"syntax":"swift"},{"type":"paragraph","inlineContent":[{"text":"A hook runs after the world operation that fired it has finished, so it sees every","type":"text"},{"text":" ","type":"text"},{"text":"component a spawn or bundle insert gave. Hooks run in the order they were fired. A change","type":"text"},{"text":" ","type":"text"},{"text":"that a hook makes fires hooks of its own, which run after the hooks already waiting.","type":"text"}]},{"type":"aside","name":"Note","content":[{"inlineContent":[{"text":"Changes made in place, through the world’s subscript or an update, run no hooks.","type":"text"},{"text":" ","type":"text"},{"text":"Find those with change detection instead.","type":"text"}],"type":"paragraph"}],"style":"note"},{"type":"aside","name":"Complexity","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"O(1) amortized."}]}],"style":"note"}]}],"abstract":[{"type":"text","text":"Registers a closure to run whenever an entity gains a component of the given type."}],"seeAlsoSections":[{"generated":true,"identifiers":["doc:\/\/WorldModule\/documentation\/WorldModule\/World\/onInsert(_:perform:)","doc:\/\/WorldModule\/documentation\/WorldModule\/World\/onRemove(_:perform:)-2t2p","doc:\/\/WorldModule\/documentation\/WorldModule\/World\/onAdd(_:perform:)-8d74u","doc:\/\/WorldModule\/documentation\/WorldModule\/World\/onRemove(_:perform:)-5cn3d","doc:\/\/WorldModule\/documentation\/WorldModule\/World\/removeHooks(of:)"],"anchor":"Responding-to-Component-Changes-with-Hooks","title":"Responding to Component Changes with Hooks"}],"references":{"doc://WorldModule/documentation/WorldModule/Entity":{"type":"topic","kind":"symbol","abstract":[{"type":"text","text":"A handle that identifies one entity in a world."}],"fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"Entity"}],"url":"\/documentation\/worldmodule\/entity","title":"Entity","navigatorTitle":[{"kind":"identifier","text":"Entity"}],"identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/Entity","role":"symbol"},"doc://WorldModule/documentation/WorldModule/Component":{"type":"topic","kind":"symbol","abstract":[{"text":"A type that can be stored as a component of an entity.","type":"text"}],"fragments":[{"text":"protocol","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Component","kind":"identifier"}],"url":"\/documentation\/worldmodule\/component","title":"Component","navigatorTitle":[{"text":"Component","kind":"identifier"}],"identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/Component","role":"symbol"},"doc://WorldModule/documentation/WorldModule":{"identifier":"doc:\/\/WorldModule\/documentation\/WorldModule","abstract":[{"type":"text","te