:"text"},{"text":"C","kind":"genericParameter"},{"text":">(","kind":"text"},{"text":"_","kind":"externalParam"},{"text":" ","kind":"text"},{"text":"type","kind":"internalParam"},{"text":": ","kind":"text"},{"text":"C","kind":"typeIdentifier"},{"text":".Type, ","kind":"text"},{"text":"perform","kind":"externalParam"},{"text":" ","kind":"text"},{"text":"hook","kind":"internalParam"},{"text":": ","kind":"text"},{"text":"@escaping ","kind":"attribute"},{"text":"@Sendable","kind":"attribute"},{"text":" (","kind":"text"},{"text":"inout","kind":"keyword"},{"text":" ","kind":"text"},{"identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/World","preciseIdentifier":"s:11WorldModule0A0V","text":"World","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/Entity","preciseIdentifier":"s:11WorldModule6EntityV","text":"Entity","kind":"typeIdentifier"},{"text":") -> ","kind":"text"},{"preciseIdentifier":"s:s4Voida","text":"Void","kind":"typeIdentifier"},{"text":") ","kind":"text"},{"text":"where","kind":"keyword"},{"text":" ","kind":"text"},{"text":"C","kind":"typeIdentifier"},{"text":" : ","kind":"text"},{"identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/Component","preciseIdentifier":"s:11WorldModule9ComponentP","text":"Component","kind":"typeIdentifier"}],"languages":["swift"],"platforms":["Linux"]}]},{"parameters":[{"content":[{"inlineContent":[{"text":"The component type to watch.","type":"text"}],"type":"paragraph"}],"name":"type"},{"content":[{"type":"paragraph","inlineContent":[{"text":"The closure to run, given the world and the entity that gained a ","type":"text"},{"code":"C","type":"codeVoice"},{"text":".","type":"text"}]}],"name":"hook"}],"kind":"parameters"},{"kind":"content","content":[{"level":2,"anchor":"discussion","text":"Discussion","type":"heading"},{"inlineContent":[{"type":"text","text":"Use hooks to keep data outside the components in step with them, such as an index of"},{"type":"text","text":" "},{"type":"text","text":"entities by name. An "},{"inlineContent":[{"text":"add hook","type":"text"}],"type":"emphasis"},{"type":"text","text":" runs when an entity that didn’t hold a "},{"type":"codeVoice","code":"C"},{"type":"text","text":" gets one, by"},{"type":"text","text":" "},{"type":"text","text":"spawning, inserting or applying a command. Replacing a "},{"type":"codeVoice","code":"C"},{"type":"text","text":" the entity already holds"},{"type":"text","text":" "},{"type":"text","text":"doesn’t run it; see "},{"identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/World\/onInsert(_:perform:)","type":"reference","isActive":true},{"type":"text","text":" for a hook that runs then too."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"The following example records each named entity in a resource as it’s spawned:"}],"type":"paragraph"},{"syntax":"swift","code":["struct NameDirectory: Resource { var entities: [String: Entity] = [:] }","","var world = World()","world.resources.insert(NameDirectory())","world.onAdd(Name.self) { world, entity in","    let name = world[Name.self, of: entity].value","    world.resources[NameDirectory.self].entities[name] = entity","}","","let hero = world.spawn(Name(value: \"Hero\"))","print(world.resources[NameDirectory.self].entities[\"Hero\"] == hero)","\/\/ Prints \"true\""],"type":"codeListing"},{"inlineContent":[{"type":"text","text":"A hook runs after the world operation that fired it has finished, so it sees every"},{"type":"text","text":" "},{"type":"text","text":"component a spawn or bundle insert gave. Hooks run in the order they were fired. A change"},{"type":"text","text":" "},{"type":"text","text":"that a hook makes fires hooks of its own, which run after the hooks already waiting."}],"type":"paragraph"},{"name":"Note","style":"note","type":"aside","content":[{"inlineContent":[{"type":"text","text":"Changes made in place, through the world’s subscript or an update, run no hooks."},{"type":"text","text":" "},{"type":"text","text":"Find those with change detection instead."}],"type":"paragraph"}]},{"name":"Complexity","style":"note","type":"aside","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"O(1) amortized."}]}]}]}],"seeAlsoSections":[{"generated":true,"title":"Responding to Component Changes with Hooks","identifiers":["doc:\/\/WorldModule\/documentation\/WorldModule\/World\/onInsert(_:perform:)","doc:\/\/WorldModule\/documentation\/WorldModule\/World\/onRemove(_:perform:)-2t2p","doc:\/\/WorldModule\/documentation\/WorldModule\/World\/onAdd(_:perform:)-8d74u","doc:\/\/WorldModule\/documentation\/WorldModule\/World\/onRemove(_:perform:)-5cn3d","doc:\/\/WorldModule\/documentation\/WorldModule\/World\/removeHooks(of:)"],"anchor":"Responding-to-Component-Changes-with-Hooks"}],"references":{"doc://WorldModule/documentation/WorldModule/Component":{"kind":"symbol","url":"\/documentation\/worldmodule\/component","title":"Component","identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/Component","role":"symbol","navigatorTitle":[{"kind":"identifier","text":"Component"}],"type":"topic","fragments":[{"kind":"keyword","text":"protocol"},{"kind":"text","text":" "},{"kind":"identifier","text":"Component"}],"abstract":[{"text":"A type that can be stored as a component of an entity.","type":"text"}]},"doc://WorldModule/documentation/WorldModule/World/onInsert(_:perform:)":{"url":"\/documentation\/worldmodule\/world\/oninsert(_:perform:)","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"onInsert","kind":"identifier"},{"text":"<","kind":"text"},{"text":"C","kind":"genericParameter"},{"text":">(","kind":"text"},{"text":"C","kind":"typeIdentifier"},{"text":".Type, ","kind":"text"},{"text":"perform","kind":"externalParam"},{"text":": (","kind":"text"},{"text":"inout","kind":"keyword"},{"text":" ","kind":"text"},{"text":"World","kind":"typeIdentifier","preciseIdentifier":"s:11WorldModule0A0V"},