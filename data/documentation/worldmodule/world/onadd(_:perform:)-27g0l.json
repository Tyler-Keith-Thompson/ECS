ule","title":"onAdd(_:perform:)","remoteSource":{"url":"https:\/\/github.com\/Tyler-Keith-Thompson\/ECS\/blob\/main\/Sources\/WorldModule\/Hooks.swift#L92","fileName":"Hooks.swift"}},"primaryContentSections":[{"declarations":[{"tokens":[{"kind":"keyword","text":"mutating"},{"kind":"text","text":" "},{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"onAdd"},{"kind":"text","text":"<"},{"kind":"genericParameter","text":"C"},{"kind":"text","text":">("},{"kind":"externalParam","text":"_"},{"kind":"text","text":" "},{"kind":"internalParam","text":"type"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"C"},{"kind":"text","text":".Type, "},{"kind":"externalParam","text":"perform"},{"kind":"text","text":" "},{"kind":"internalParam","text":"hook"},{"kind":"text","text":": "},{"kind":"attribute","text":"@escaping "},{"kind":"attribute","text":"@Sendable"},{"kind":"text","text":" ("},{"kind":"keyword","text":"inout"},{"kind":"text","text":" "},{"kind":"typeIdentifier","identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/World","text":"World","preciseIdentifier":"s:11WorldModule0A0V"},{"kind":"text","text":", "},{"kind":"typeIdentifier","identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/Entity","text":"Entity","preciseIdentifier":"s:11WorldModule6EntityV"},{"kind":"text","text":") -> "},{"kind":"typeIdentifier","text":"Void","preciseIdentifier":"s:s4Voida"},{"kind":"text","text":") "},{"kind":"keyword","text":"where"},{"kind":"text","text":" "},{"kind":"typeIdentifier","text":"C"},{"kind":"text","text":" : "},{"kind":"typeIdentifier","identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/Component","text":"Component","preciseIdentifier":"s:11WorldModule9ComponentP"}],"languages":["swift"],"platforms":["Linux"]}],"kind":"declarations"},{"parameters":[{"content":[{"inlineContent":[{"text":"The component type to watch.","type":"text"}],"type":"paragraph"}],"name":"type"},{"content":[{"inlineContent":[{"type":"text","text":"The closure to run, given the world and the entity that gained a "},{"code":"C","type":"codeVoice"},{"type":"text","text":"."}],"type":"paragraph"}],"name":"hook"}],"kind":"parameters"},{"content":[{"type":"heading","level":2,"anchor":"discussion","text":"Discussion"},{"type":"paragraph","inlineContent":[{"text":"Use hooks to keep data outside the components in step with them, such as an index of","type":"text"},{"text":" ","type":"text"},{"text":"entities by name. An ","type":"text"},{"inlineContent":[{"type":"text","text":"add hook"}],"type":"emphasis"},{"text":" runs when an entity that didn’t hold a ","type":"text"},{"code":"C","type":"codeVoice"},{"text":" gets one, by","type":"text"},{"text":" ","type":"text"},{"text":"spawning, inserting or applying a command. Replacing a ","type":"text"},{"code":"C","type":"codeVoice"},{"text":" the entity already holds","type":"text"},{"text":" ","type":"text"},{"text":"doesn’t run it; see ","type":"text"},{"type":"reference","identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/World\/onInsert(_:perform:)","isActive":true},{"text":" for a hook that runs then too.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"The following example records each named entity in a resource as it’s spawned:","type":"text"}]},{"type":"codeListing","code":["struct NameDirectory: Resource { var entities: [String: Entity] = [:] }","","var world = World()","world.resources.insert(NameDirectory())","world.onAdd(Name.self) { world, entity in","    let name = world[Name.self, of: entity].value","    world.resources[NameDirectory.self].entities[name] = entity","}","","let hero = world.spawn(Name(value: \"Hero\"))","print(world.resources[NameDirectory.self].entities[\"Hero\"] == hero)","\/\/ Prints \"true\""],"syntax":"swift"},{"type":"paragraph","inlineContent":[{"text":"A hook runs after the world operation that fired it has finished, so it sees every","type":"text"},{"text":" ","type":"text"},{"text":"component a spawn or bundle insert gave. Hooks run in the order they were fired. A change","type":"text"},{"text":" ","type":"text"},{"text":"that a hook makes fires hooks of its own, which run after the hooks already waiting.","type":"text"}]},{"type":"aside","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Changes made in place, through the world’s subscript or an update, run no hooks."},{"type":"text","text":" "},{"type":"text","text":"Find those with change detection instead."}]}],"style":"note","name":"Note"},{"type":"aside","content":[{"inlineContent":[{"text":"O(1) amortized.","type":"text"}],"type":"paragraph"}],"style":"note","name":"Complexity"}],"kind":"content"}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/worldmodule\/world\/onadd(_:perform:)-27g0l"]}],"references":{"doc://WorldModule/documentation/WorldModule/World/onAdd(_:perform:)-27g0l":{"type":"topic","title":"onAdd(_:perform:)","kind":"symbol","url":"\/documentation\/worldmodule\/world\/onadd(_:perform:)-27g0l","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"onAdd","kind":"identifier"},{"text":"<","kind":"text"},{"text":"C","kind":"genericParameter"},{"text":">(","kind":"text"},{"kind":"typeIdentifier","text":"C"},{"kind":"text","text":".Type, "},{"kind":"externalParam","text":"perform"},{"kind":"text","text":": ("},{"kind":"keyword","text":"inout"},{"kind":"text","text":" "},{"preciseIdentifier":"s:11WorldModule0A0V","kind":"typeIdentifier","text":"World"},{"text":", ","kind":"text"},{"text":"Entity","kind":"typeIdentifier","preciseIdentifier":"s:11WorldModule6EntityV"},{"text":") -> ","kind":"text"},{"text":"Void","kind":"typeIdentifier","preciseIdentifier":"s:s4Voida"},{"text":")","kind":"text"}],"identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/World\/onAdd(_:perform:)-27g0l","role":"symbol","abstract":[{"type":"text","text":"Registers a closure to run whenever an entity gains a component 