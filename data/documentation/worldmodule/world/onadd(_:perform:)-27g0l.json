aVersion":{"minor":3,"major":0,"patch":0},"kind":"symbol","hierarchy":{"paths":[["doc:\/\/WorldModule\/documentation\/WorldModule","doc:\/\/WorldModule\/documentation\/WorldModule\/World"]]},"abstract":[{"text":"Registers a closure to run whenever an entity gains a component of the given type.","type":"text"}],"primaryContentSections":[{"declarations":[{"languages":["swift"],"platforms":["Linux"],"tokens":[{"kind":"keyword","text":"mutating"},{"kind":"text","text":" "},{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"onAdd"},{"kind":"text","text":"<"},{"kind":"genericParameter","text":"C"},{"kind":"text","text":">("},{"kind":"externalParam","text":"_"},{"kind":"text","text":" "},{"kind":"internalParam","text":"type"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"C"},{"kind":"text","text":".Type, "},{"kind":"externalParam","text":"perform"},{"kind":"text","text":" "},{"kind":"internalParam","text":"hook"},{"kind":"text","text":": "},{"kind":"attribute","text":"@escaping "},{"kind":"attribute","text":"@Sendable"},{"kind":"text","text":" ("},{"kind":"keyword","text":"inout"},{"kind":"text","text":" "},{"identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/World","kind":"typeIdentifier","preciseIdentifier":"s:11WorldModule0A0V","text":"World"},{"kind":"text","text":", "},{"identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/Entity","kind":"typeIdentifier","preciseIdentifier":"s:11WorldModule6EntityV","text":"Entity"},{"kind":"text","text":") -> "},{"kind":"typeIdentifier","preciseIdentifier":"s:s4Voida","text":"Void"},{"kind":"text","text":") "},{"kind":"keyword","text":"where"},{"kind":"text","text":" "},{"kind":"typeIdentifier","text":"C"},{"kind":"text","text":" : "},{"identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/Component","kind":"typeIdentifier","preciseIdentifier":"s:11WorldModule9ComponentP","text":"Component"}]}],"kind":"declarations"},{"kind":"parameters","parameters":[{"content":[{"inlineContent":[{"type":"text","text":"The component type to watch."}],"type":"paragraph"}],"name":"type"},{"content":[{"type":"paragraph","inlineContent":[{"text":"The closure to run, given the world and the entity that gained a ","type":"text"},{"code":"C","type":"codeVoice"},{"text":".","type":"text"}]}],"name":"hook"}]},{"content":[{"level":2,"text":"Discussion","anchor":"discussion","type":"heading"},{"inlineContent":[{"type":"text","text":"Use hooks to keep data outside the components in step with them, such as an index of"},{"type":"text","text":" "},{"type":"text","text":"entities by name. An "},{"inlineContent":[{"type":"text","text":"add hook"}],"type":"emphasis"},{"type":"text","text":" runs when an entity that didn’t hold a "},{"type":"codeVoice","code":"C"},{"text":" gets one, by","type":"text"},{"text":" ","type":"text"},{"text":"spawning, inserting or applying a command. Replacing a ","type":"text"},{"type":"codeVoice","code":"C"},{"text":" the entity already holds","type":"text"},{"text":" ","type":"text"},{"text":"doesn’t run it; see ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/World\/onInsert(_:perform:)"},{"text":" for a hook that runs then too.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"The following example records each named entity in a resource as it’s spawned:"}],"type":"paragraph"},{"code":["struct NameDirectory: Resource { var entities: [String: Entity] = [:] }","","var world = World()","world.resources.insert(NameDirectory())","world.onAdd(Name.self) { world, entity in","    let name = world[Name.self, of: entity].value","    world.resources[NameDirectory.self].entities[name] = entity","}","","let hero = world.spawn(Name(value: \"Hero\"))","print(world.resources[NameDirectory.self].entities[\"Hero\"] == hero)","\/\/ Prints \"true\""],"syntax":"swift","type":"codeListing"},{"inlineContent":[{"type":"text","text":"A hook runs after the world operation that fired it has finished, so it sees every"},{"type":"text","text":" "},{"type":"text","text":"component a spawn or bundle insert gave. Hooks run in the order they were fired. A change"},{"type":"text","text":" "},{"type":"text","text":"that a hook makes fires hooks of its own, which run after the hooks already waiting."}],"type":"paragraph"},{"name":"Note","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Changes made in place, through the world’s subscript or an update, run no hooks."},{"type":"text","text":" "},{"type":"text","text":"Find those with change detection instead."}]}],"style":"note","type":"aside"},{"name":"Complexity","content":[{"inlineContent":[{"type":"text","text":"O(1) amortized."}],"type":"paragraph"}],"style":"note","type":"aside"}],"kind":"content"}],"references":{"doc://WorldModule/documentation/WorldModule/World/removeHooks(of:)":{"url":"\/documentation\/worldmodule\/world\/removehooks(of:)","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"removeHooks"},{"kind":"text","text":"<"},{"kind":"genericParameter","text":"C"},{"kind":"text","text":">("},{"kind":"externalParam","text":"of"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"C"},{"kind":"text","text":".Type)"}],"abstract":[{"type":"text","text":"Removes every hook registered for a component type."}],"role":"symbol","title":"removeHooks(of:)","kind":"symbol","type":"topic","identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/World\/removeHooks(of:)"},"doc://WorldModule/documentation/WorldModule/World/onRemove(_:perform:)-5cn3d":{"fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"onRemove","kind":"identifier"},{"text":"<each ","kind":"text"},{"text":"T","kind":"genericParameter"},{"text":">(","kind":"text"},{"kind":"typeIdentifier","text":"Query","preciseIdentifier":"s:11WorldModule5QueryV"},{"kind":"text","text":"<repeat each "},{"ki