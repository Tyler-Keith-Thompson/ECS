ntityVtYbctAA9ComponentRzlF","role":"symbol"},"variants":[{"paths":["\/documentation\/worldmodule\/world\/onadd(_:perform:)-27g0l"],"traits":[{"interfaceLanguage":"swift"}]}],"kind":"symbol","primaryContentSections":[{"kind":"declarations","declarations":[{"platforms":["Linux"],"tokens":[{"kind":"keyword","text":"mutating"},{"kind":"text","text":" "},{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"onAdd"},{"kind":"text","text":"<"},{"kind":"genericParameter","text":"C"},{"kind":"text","text":">("},{"kind":"externalParam","text":"_"},{"kind":"text","text":" "},{"kind":"internalParam","text":"type"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"C"},{"kind":"text","text":".Type, "},{"kind":"externalParam","text":"perform"},{"kind":"text","text":" "},{"kind":"internalParam","text":"hook"},{"kind":"text","text":": "},{"kind":"attribute","text":"@escaping "},{"kind":"attribute","text":"@Sendable"},{"kind":"text","text":" ("},{"kind":"keyword","text":"inout"},{"kind":"text","text":" "},{"kind":"typeIdentifier","identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/World","text":"World","preciseIdentifier":"s:11WorldModule0A0V"},{"kind":"text","text":", "},{"kind":"typeIdentifier","identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/Entity","text":"Entity","preciseIdentifier":"s:11WorldModule6EntityV"},{"kind":"text","text":") -> "},{"kind":"typeIdentifier","text":"Void","preciseIdentifier":"s:s4Voida"},{"kind":"text","text":") "},{"kind":"keyword","text":"where"},{"kind":"text","text":" "},{"kind":"typeIdentifier","text":"C"},{"kind":"text","text":" : "},{"kind":"typeIdentifier","identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/Component","text":"Component","preciseIdentifier":"s:11WorldModule9ComponentP"}],"languages":["swift"]}]},{"parameters":[{"name":"type","content":[{"inlineContent":[{"type":"text","text":"The component type to watch."}],"type":"paragraph"}]},{"name":"hook","content":[{"type":"paragraph","inlineContent":[{"text":"The closure to run, given the world and the entity that gained a ","type":"text"},{"type":"codeVoice","code":"C"},{"text":".","type":"text"}]}]}],"kind":"parameters"},{"content":[{"type":"heading","level":2,"text":"Discussion","anchor":"discussion"},{"type":"paragraph","inlineContent":[{"text":"Use hooks to keep data outside the components in step with them, such as an index of","type":"text"},{"text":" ","type":"text"},{"text":"entities by name. An ","type":"text"},{"type":"emphasis","inlineContent":[{"type":"text","text":"add hook"}]},{"text":" runs when an entity that didn’t hold a ","type":"text"},{"type":"codeVoice","code":"C"},{"text":" gets one, by","type":"text"},{"text":" ","type":"text"},{"text":"spawning, inserting or applying a command. Replacing a ","type":"text"},{"type":"codeVoice","code":"C"},{"text":" the entity already holds","type":"text"},{"text":" ","type":"text"},{"text":"doesn’t run it; see ","type":"text"},{"isActive":true,"identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/World\/onInsert(_:perform:)","type":"reference"},{"text":" for a hook that runs then too.","type":"text"}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"The following example records each named entity in a resource as it’s spawned:"}]},{"syntax":"swift","type":"codeListing","code":["struct NameDirectory: Resource { var entities: [String: Entity] = [:] }","","var world = World()","world.resources.insert(NameDirectory())","world.onAdd(Name.self) { world, entity in","    let name = world[Name.self, of: entity].value","    world.resources[NameDirectory.self].entities[name] = entity","}","","let hero = world.spawn(Name(value: \"Hero\"))","print(world.resources[NameDirectory.self].entities[\"Hero\"] == hero)","\/\/ Prints \"true\""]},{"type":"paragraph","inlineContent":[{"text":"A hook runs after the world operation that fired it has finished, so it sees every","type":"text"},{"text":" ","type":"text"},{"text":"component a spawn or bundle insert gave. Hooks run in the order they were fired. A change","type":"text"},{"text":" ","type":"text"},{"text":"that a hook makes fires hooks of its own, which run after the hooks already waiting.","type":"text"}]},{"type":"aside","content":[{"inlineContent":[{"type":"text","text":"Changes made in place, through the world’s subscript or an update, run no hooks."},{"type":"text","text":" "},{"type":"text","text":"Find those with change detection instead."}],"type":"paragraph"}],"name":"Note","style":"note"},{"type":"aside","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"O(1) amortized."}]}],"name":"Complexity","style":"note"}],"kind":"content"}],"abstract":[{"text":"Registers a closure to run whenever an entity gains a component of the given type.","type":"text"}],"references":{"doc://WorldModule/documentation/WorldModule/World/onRemove(_:perform:)-5cn3d":{"url":"\/documentation\/worldmodule\/world\/onremove(_:perform:)-5cn3d","role":"symbol","identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/World\/onRemove(_:perform:)-5cn3d","title":"onRemove(_:perform:)","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"onRemove"},{"kind":"text","text":"<each "},{"kind":"genericParameter","text":"T"},{"kind":"text","text":">("},{"text":"Query","kind":"typeIdentifier","preciseIdentifier":"s:11WorldModule5QueryV"},{"text":"<repeat each ","kind":"text"},{"text":"T","kind":"typeIdentifier"},{"text":">, ","kind":"text"},{"text":"perform","kind":"externalParam"},{"text":": (","kind":"text"},{"text":"inout","kind":"keyword"},{"text":" ","kind":"text"},{"text":"World","preciseIdentifier":"s:11WorldModule0A0V","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"Entity","preciseIdentifier":"s:11WorldModule6EntityV","kind":"typeIdentifier"},{"text":") -> ","kind":"text"},{"text":"Void","preciseIdentifier":"s:s4Voida","kind":"typeIdentifier"},{"text":")","kind