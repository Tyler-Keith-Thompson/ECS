{"schemaVersion":{"minor":3,"patch":0,"major":0},"metadata":{"role":"symbol","modules":[{"name":"WorldModule"}],"roleHeading":"Instance Method","symbolKind":"method","externalID":"s:11WorldModule0A0V5onAdd_7performyxm_yACz_AA6EntityVtYbctAA9ComponentRzlF","extendedModule":"WorldModule","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"onAdd","kind":"identifier"},{"kind":"text","text":"<"},{"kind":"genericParameter","text":"C"},{"kind":"text","text":">("},{"kind":"typeIdentifier","text":"C"},{"kind":"text","text":".Type, "},{"kind":"externalParam","text":"perform"},{"kind":"text","text":": ("},{"kind":"keyword","text":"inout"},{"kind":"text","text":" "},{"kind":"typeIdentifier","preciseIdentifier":"s:11WorldModule0A0V","text":"World"},{"kind":"text","text":", "},{"kind":"typeIdentifier","preciseIdentifier":"s:11WorldModule6EntityV","text":"Entity"},{"kind":"text","text":") -> "},{"kind":"typeIdentifier","preciseIdentifier":"s:s4Voida","text":"Void"},{"kind":"text","text":")"}],"title":"onAdd(_:perform:)","remoteSource":{"fileName":"Hooks.swift","url":"https:\/\/github.com\/Tyler-Keith-Thompson\/ECS\/blob\/main\/Sources\/WorldModule\/Hooks.swift#L92"}},"sections":[],"abstract":[{"text":"Registers a closure to run whenever an entity gains a component of the given type.","type":"text"}],"seeAlsoSections":[{"generated":true,"anchor":"Responding-to-Component-Changes-with-Hooks","identifiers":["doc:\/\/WorldModule\/documentation\/WorldModule\/World\/onInsert(_:perform:)","doc:\/\/WorldModule\/documentation\/WorldModule\/World\/onRemove(_:perform:)-2t2p","doc:\/\/WorldModule\/documentation\/WorldModule\/World\/onAdd(_:perform:)-8d74u","doc:\/\/WorldModule\/documentation\/WorldModule\/World\/onRemove(_:perform:)-5cn3d","doc:\/\/WorldModule\/documentation\/WorldModule\/World\/removeHooks(of:)"],"title":"Responding to Component Changes with Hooks"}],"primaryContentSections":[{"kind":"declarations","declarations":[{"languages":["swift"],"tokens":[{"kind":"keyword","text":"mutating"},{"kind":"text","text":" "},{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"onAdd"},{"kind":"text","text":"<"},{"kind":"genericParameter","text":"C"},{"kind":"text","text":">("},{"kind":"externalParam","text":"_"},{"kind":"text","text":" "},{"kind":"internalParam","text":"type"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"C"},{"kind":"text","text":".Type, "},{"kind":"externalParam","text":"perform"},{"kind":"text","text":" "},{"kind":"internalParam","text":"hook"},{"kind":"text","text":": "},{"kind":"attribute","text":"@escaping "},{"kind":"attribute","text":"@Sendable"},{"kind":"text","text":" ("},{"kind":"keyword","text":"inout"},{"kind":"text","text":" "},{"identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/World","kind":"typeIdentifier","text":"World","preciseIdentifier":"s:11WorldModule0A0V"},{"kind":"text","text":", "},{"identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/Entity","kind":"typeIdentifier","text":"Entity","preciseIdentifier":"s:11WorldModule6EntityV"},{"kind":"text","text":") -> "},{"kind":"typeIdentifier","text":"Void","preciseIdentifier":"s:s4Voida"},{"kind":"text","text":") "},{"kind":"keyword","text":"where"},{"kind":"text","text":" "},{"kind":"typeIdentifier","text":"C"},{"kind":"text","text":" : "},{"identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/Component","kind":"typeIdentifier","text":"Component","preciseIdentifier":"s:11WorldModule9ComponentP"}],"platforms":["Linux"]}]},{"kind":"parameters","parameters":[{"name":"type","content":[{"inlineContent":[{"text":"The component type to watch.","type":"text"}],"type":"paragraph"}]},{"name":"hook","content":[{"inlineContent":[{"type":"text","text":"The closure to run, given the world and the entity that gained a "},{"type":"codeVoice","code":"C"},{"type":"text","text":"."}],"type":"paragraph"}]}]},{"kind":"content","content":[{"text":"Discussion","anchor":"discussion","type":"heading","level":2},{"inlineContent":[{"type":"text","text":"Use hooks to keep data outside the components in step with them, such as an index of"},{"type":"text","text":" "},{"type":"text","text":"entities by name. An "},{"type":"emphasis","inlineContent":[{"text":"add hook","type":"text"}]},{"type":"text","text":" runs when an entity that didn’t hold a "},{"code":"C","type":"codeVoice"},{"type":"text","text":" gets one, by"},{"type":"text","text":" "},{"type":"text","text":"spawning, inserting or applying a command. Replacing a "},{"code":"C","type":"codeVoice"},{"type":"text","text":" the entity already holds"},{"type":"text","text":" "},{"type":"text","text":"doesn’t run it; see "},{"type":"reference","isActive":true,"identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/World\/onInsert(_:perform:)"},{"type":"text","text":" for a hook that runs then too."}],"type":"paragraph"},{"inlineContent":[{"text":"The following example records each named entity in a resource as it’s spawned:","type":"text"}],"type":"paragraph"},{"syntax":"swift","type":"codeListing","code":["struct NameDirectory: Resource { var entities: [String: Entity] = [:] }","","var world = World()","world.resources.insert(NameDirectory())","world.onAdd(Name.self) { world, entity in","    let name = world[Name.self, of: entity].value","    world.resources[NameDirectory.self].entities[name] = entity","}","","let hero = world.spawn(Name(value: \"Hero\"))","print(world.resources[NameDirectory.self].entities[\"Hero\"] == hero)","\/\/ Prints \"true\""]},{"inlineContent":[{"text":"A hook runs after the world operation that fired it has finished, so it sees every","type":"text"},{"text":" ","type":"text"},{"text":"component a spawn or bundle insert gave. Hooks run in the order they were fired. A change","type":"text"},{"text":" ","type":"text"},{"text":"that a hook makes fires hooks of its own, which run after the hooks already waiting.","type":"text"}],"type":"paragraph"},{"name":"Note","content":[{"inlineContent":[{"text":"Changes made in place, through the world’s subscript or an update, run no hooks.","type":"text"},{"text":" ","type":"text"},{"text":"Find those with change detection instead.","type":"text"}],"type":"paragraph"}],"style":"note","type":"aside"},{"name":"Complexity","content":[{"inlineContent":[{"type":"text","text":"O(1) amortized."}],"type":"paragraph"}],"style":"note","type":"aside"}]}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/worldmodule\/world\/onadd(_:perform:)-27g0l"]}],"identifier":{"url":"doc:\/\/WorldModule\/documentation\/WorldModule\/World\/onAdd(_:perform:)-27g0l","interfaceLanguage":"swift"},"hierarchy":{"paths":[["doc:\/\/WorldModule\/documentation\/WorldModule","doc:\/\/WorldModule\/documentation\/WorldModule\/World"]]},"kind":"symbol","references":{"doc://WorldModule/documentation/WorldModule/World/onInsert(_:perform:)":{"identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/World\/onInsert(_:perform:)","role":"symbol","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"onInsert"},{"kind":"text","text":"<"},{"kind":"genericParameter","text":"C"},{"kind":"text","text":">("},{"kind":"typeIdentifier","text":"C"},{"kind":"text","text":".Type, "},{"kind":"externalParam","text":"perform"},{"kind":"text","text":": ("},{"kind":"keyword","text":"inout"},{"kind":"text","text":" "},{"kind":"typeIdentifier","preciseIdentifier":"s:11WorldModule0A0V","text":"World"},{"kind":"text","text":", "},{"kind":"typeIdentifier","preciseIdentifier":"s:11WorldModule6EntityV","text":"Entity"},{"kind":"text","text":") -> "},{"kind":"typeIdentifier","preciseIdentifier":"s:s4Voida","text":"Void"},{"kind":"text","text":")"}],"title":"onInsert(_:perform:)","abstract":[{"text":"Registers a closure to run whenever an entity is given a component of the given type,","type":"text"},{"text":" ","type":"text"},{"text":"whether it’s new or replaces one the ent