{"abstract":[{"type":"text","text":"Registers a closure to run whenever an entity gains a component of the given type."}],"sections":[],"seeAlsoSections":[{"anchor":"Responding-to-Component-Changes-with-Hooks","generated":true,"title":"Responding to Component Changes with Hooks","identifiers":["doc:\/\/WorldModule\/documentation\/WorldModule\/World\/onInsert(_:perform:)","doc:\/\/WorldModule\/documentation\/WorldModule\/World\/onRemove(_:perform:)-2t2p","doc:\/\/WorldModule\/documentation\/WorldModule\/World\/onAdd(_:perform:)-8d74u","doc:\/\/WorldModule\/documentation\/WorldModule\/World\/onRemove(_:perform:)-5cn3d","doc:\/\/WorldModule\/documentation\/WorldModule\/World\/removeHooks(of:)"]}],"primaryContentSections":[{"kind":"declarations","declarations":[{"languages":["swift"],"platforms":["Linux"],"tokens":[{"text":"mutating","kind":"keyword"},{"text":" ","kind":"text"},{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"onAdd","kind":"identifier"},{"text":"<","kind":"text"},{"text":"C","kind":"genericParameter"},{"text":">(","kind":"text"},{"text":"_","kind":"externalParam"},{"text":" ","kind":"text"},{"text":"type","kind":"internalParam"},{"text":": ","kind":"text"},{"text":"C","kind":"typeIdentifier"},{"text":".Type, ","kind":"text"},{"text":"perform","kind":"externalParam"},{"text":" ","kind":"text"},{"text":"hook","kind":"internalParam"},{"text":": ","kind":"text"},{"text":"@escaping ","kind":"attribute"},{"text":"@Sendable","kind":"attribute"},{"text":" (","kind":"text"},{"text":"inout","kind":"keyword"},{"text":" ","kind":"text"},{"text":"World","identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/World","preciseIdentifier":"s:11WorldModule0A0V","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"Entity","identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/Entity","preciseIdentifier":"s:11WorldModule6EntityV","kind":"typeIdentifier"},{"text":") -> ","kind":"text"},{"text":"Void","preciseIdentifier":"s:s4Voida","kind":"typeIdentifier"},{"text":") ","kind":"text"},{"text":"where","kind":"keyword"},{"text":" ","kind":"text"},{"text":"C","kind":"typeIdentifier"},{"text":" : ","kind":"text"},{"text":"Component","identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/Component","preciseIdentifier":"s:11WorldModule9ComponentP","kind":"typeIdentifier"}]}]},{"kind":"parameters","parameters":[{"name":"type","content":[{"inlineContent":[{"text":"The component type to watch.","type":"text"}],"type":"paragraph"}]},{"name":"hook","content":[{"inlineContent":[{"type":"text","text":"The closure to run, given the world and the entity that gained a "},{"code":"C","type":"codeVoice"},{"type":"text","text":"."}],"type":"paragraph"}]}]},{"kind":"content","content":[{"text":"Discussion","type":"heading","anchor":"discussion","level":2},{"type":"paragraph","inlineContent":[{"type":"text","text":"Use hooks to keep data outside the components in step with them, such as an index of"},{"type":"text","text":" "},{"type":"text","text":"entities by name. An "},{"type":"emphasis","inlineContent":[{"type":"text","text":"add hook"}]},{"type":"text","text":" runs when an entity that didn’t hold a "},{"type":"codeVoice","code":"C"},{"type":"text","text":" gets one, by"},{"type":"text","text":" "},{"type":"text","text":"spawning, inserting or applying a command. Replacing a "},{"type":"codeVoice","code":"C"},{"type":"text","text":" the entity already holds"},{"type":"text","text":" "},{"type":"text","text":"doesn’t run it; see "},{"type":"reference","isActive":true,"identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/World\/onInsert(_:perform:)"},{"type":"text","text":" for a hook that runs then too."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"The following example records each named entity in a resource as it’s spawned:"}]},{"type":"codeListing","code":["struct NameDirectory: Resource { var entities: [String: Entity] = [:] }","","var world = World()","world.resources.insert(NameDirectory())","world.onAdd(Name.self) { world, entity in","    let name = world[Name.self, of: entity].value","    world.resources[NameDirectory.self].entities[name] = entity","}","","let hero = world.spawn(Name(value: \"Hero\"))","print(world.resources[NameDirectory.self].entities[\"Hero\"] == hero)","\/\/ Prints \"true\""],"syntax":"swift"},{"type":"paragraph","inlineContent":[{"type":"text","text":"A hook runs after the world operation that fired it has finished, so it sees every"},{"type":"text","text":" "},{"type":"text","text":"component a spawn or bundle insert gave. Hooks run in the order they were fired. A change"},{"type":"text","text":" "},{"type":"text","text":"that a hook makes fires hooks of its own, which run after the hooks already waiting."}]},{"content":[{"inlineContent":[{"text":"Changes made in place, through the world’s subscript or an update, run no hooks.","type":"text"},{"text":" ","type":"text"},{"text":"Find those with change detection instead.","type":"text"}],"type":"paragraph"}],"type":"aside","style":"note","name":"Note"},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"O(1) amortized."}]}],"type":"aside","style":"note","name":"Complexity"}]}],"kind":"symbol","identifier":{"interfaceLanguage":"swift","url":"doc:\/\/WorldModule\/documentation\/WorldModule\/World\/onAdd(_:perform:)-27g0l"},"hierarchy":{"paths":[["doc:\/\/WorldModule\/documentation\/WorldModule","doc:\/\/WorldModule\/documentation\/WorldModule\/World"]]},"schemaVersion":{"patch":0,"major":0,"minor":3},"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/worldmodule\/world\/onadd(_:perform:)-27g0l"]}],"metadata":{"title":"onAdd(_:perform:)","modules":[{"name":"WorldModule"}],"symbolKind":"method","externalID":"s:11WorldModule0A0V5onAdd_7performyxm_yACz_AA6EntityVtYbctAA9ComponentRzlF","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"onAdd","kind":"identifier"},{"text":"<","kind":"