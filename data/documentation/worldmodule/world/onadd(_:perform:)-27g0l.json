{"primaryContentSections":[{"kind":"declarations","declarations":[{"tokens":[{"kind":"keyword","text":"mutating"},{"kind":"text","text":" "},{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"onAdd"},{"kind":"text","text":"<"},{"kind":"genericParameter","text":"C"},{"kind":"text","text":">("},{"kind":"externalParam","text":"_"},{"kind":"text","text":" "},{"kind":"internalParam","text":"type"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"C"},{"kind":"text","text":".Type, "},{"kind":"externalParam","text":"perform"},{"kind":"text","text":" "},{"kind":"internalParam","text":"hook"},{"kind":"text","text":": "},{"kind":"attribute","text":"@escaping "},{"kind":"attribute","text":"@Sendable"},{"kind":"text","text":" ("},{"kind":"keyword","text":"inout"},{"kind":"text","text":" "},{"identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/World","kind":"typeIdentifier","preciseIdentifier":"s:11WorldModule0A0V","text":"World"},{"kind":"text","text":", "},{"identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/Entity","kind":"typeIdentifier","preciseIdentifier":"s:11WorldModule6EntityV","text":"Entity"},{"kind":"text","text":") -> "},{"kind":"typeIdentifier","preciseIdentifier":"s:s4Voida","text":"Void"},{"kind":"text","text":") "},{"kind":"keyword","text":"where"},{"kind":"text","text":" "},{"kind":"typeIdentifier","text":"C"},{"kind":"text","text":" : "},{"identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/Component","kind":"typeIdentifier","preciseIdentifier":"s:11WorldModule9ComponentP","text":"Component"}],"platforms":["Linux"],"languages":["swift"]}]},{"parameters":[{"name":"type","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The component type to watch."}]}]},{"name":"hook","content":[{"inlineContent":[{"type":"text","text":"The closure to run, given the world and the entity that gained a "},{"type":"codeVoice","code":"C"},{"type":"text","text":"."}],"type":"paragraph"}]}],"kind":"parameters"},{"kind":"mentions","mentions":["doc:\/\/WorldModule\/documentation\/WorldModule\/ReactingToChanges"]},{"kind":"content","content":[{"text":"Discussion","type":"heading","anchor":"discussion","level":2},{"type":"paragraph","inlineContent":[{"text":"Use hooks to keep data outside the components in step with them, such as an index of","type":"text"},{"text":" ","type":"text"},{"text":"entities by name. An ","type":"text"},{"inlineContent":[{"type":"text","text":"add hook"}],"type":"emphasis"},{"text":" runs when an entity that didn’t hold a ","type":"text"},{"code":"C","type":"codeVoice"},{"text":" gets one, by","type":"text"},{"text":" ","type":"text"},{"text":"spawning, inserting or applying a command. Replacing a ","type":"text"},{"code":"C","type":"codeVoice"},{"text":" the entity already holds","type":"text"},{"text":" ","type":"text"},{"text":"doesn’t run it; see ","type":"text"},{"identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/World\/onInsert(_:perform:)","type":"reference","isActive":true},{"text":" for a hook that runs then too.","type":"text"}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"The following example records each named entity in a resource as it’s spawned:"}]},{"type":"codeListing","syntax":"swift","code":["struct NameDirectory: Resource { var entities: [String: Entity] = [:] }","","var world = World()","world.resources.insert(NameDirectory())","world.onAdd(Name.self) { world, entity in","    let name = world[Name.self, of: entity].value","    world.resources[NameDirectory.self].entities[name] = entity","}","","let hero = world.spawn(Name(value: \"Hero\"))","print(world.resources[NameDirectory.self].entities[\"Hero\"] == hero)","\/\/ Prints \"true\""]},{"type":"paragraph","inlineContent":[{"type":"text","text":"A hook runs after the world operation that fired it has finished, so it sees every"},{"type":"text","text":" "},{"type":"text","text":"component a spawn or bundle insert gave. Hooks run in the order they were fired. A change"},{"type":"text","text":" "},{"type":"text","text":"that a hook makes fires hooks of its own, which run after the hooks already waiting."}]},{"name":"Note","style":"note","type":"aside","content":[{"inlineContent":[{"type":"text","text":"Changes made in place, through the world’s subscript or an update, run no hooks."},{"type":"text","text":" "},{"type":"text","text":"Find those with change detection instead."}],"type":"paragraph"}]},{"name":"Complexity","style":"note","type":"aside","content":[{"inlineContent":[{"text":"O(1) amortized.","type":"text"}],"type":"paragraph"}]}]}],"kind":"symbol","identifier":{"interfaceLanguage":"swift","url":"doc:\/\/WorldModule\/documentation\/WorldModule\/World\/onAdd(_:perform:)-27g0l"},"hierarchy":{"paths":[["doc:\/\/WorldModule\/documentation\/WorldModule","doc:\/\/WorldModule\/documentation\/WorldModule\/World"]]},"metadata":{"fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"onAdd","kind":"identifier"},{"text":"<","kind":"text"},{"text":"C","kind":"genericParameter"},{"text":">(","kind":"text"},{"text":"C","kind":"typeIdentifier"},{"text":".Type, ","kind":"text"},{"text":"perform","kind":"externalParam"},{"text":": (","kind":"text"},{"text":"inout","kind":"keyword"},{"text":" ","kind":"text"},{"preciseIdentifier":"s:11WorldModule0A0V","text":"World","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"preciseIdentifier":"s:11WorldModule6EntityV","text":"Entity","kind":"typeIdentifier"},{"text":") -> ","kind":"text"},{"preciseIdentifier":"s:s4Voida","text":"Void","kind":"typeIdentifier"},{"text":")","kind":"text"}],"extendedModule":"WorldModule","remoteSource":{"url":"https:\/\/github.com\/Tyler-Keith-Thompson\/ECS\/blob\/main\/Sources\/WorldModule\/Hooks.swift#L92","fileName":"Hooks.swift"},"modules":[{"name":"WorldModule"}],"externalID":"s:11WorldModule0A0V5onAdd_7performyxm_yACz_AA6EntityVtYbctAA9ComponentRzlF","symbolKind":"method","role":"symbol","ro