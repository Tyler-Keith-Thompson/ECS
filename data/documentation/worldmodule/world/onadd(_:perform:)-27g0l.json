name":"type","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The component type to watch."}]}]},{"name":"hook","content":[{"inlineContent":[{"text":"The closure to run, given the world and the entity that gained a ","type":"text"},{"type":"codeVoice","code":"C"},{"text":".","type":"text"}],"type":"paragraph"}]}]},{"kind":"content","content":[{"text":"Discussion","anchor":"discussion","level":2,"type":"heading"},{"inlineContent":[{"type":"text","text":"Use hooks to keep data outside the components in step with them, such as an index of"},{"type":"text","text":" "},{"type":"text","text":"entities by name. An "},{"type":"emphasis","inlineContent":[{"text":"add hook","type":"text"}]},{"type":"text","text":" runs when an entity that didn’t hold a "},{"code":"C","type":"codeVoice"},{"type":"text","text":" gets one, by"},{"type":"text","text":" "},{"type":"text","text":"spawning, inserting or applying a command. Replacing a "},{"code":"C","type":"codeVoice"},{"type":"text","text":" the entity already holds"},{"type":"text","text":" "},{"type":"text","text":"doesn’t run it; see "},{"isActive":true,"identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/World\/onInsert(_:perform:)","type":"reference"},{"type":"text","text":" for a hook that runs then too."}],"type":"paragraph"},{"inlineContent":[{"text":"The following example records each named entity in a resource as it’s spawned:","type":"text"}],"type":"paragraph"},{"syntax":"swift","code":["struct NameDirectory: Resource { var entities: [String: Entity] = [:] }","","var world = World()","world.resources.insert(NameDirectory())","world.onAdd(Name.self) { world, entity in","    let name = world[Name.self, of: entity].value","    world.resources[NameDirectory.self].entities[name] = entity","}","","let hero = world.spawn(Name(value: \"Hero\"))","print(world.resources[NameDirectory.self].entities[\"Hero\"] == hero)","\/\/ Prints \"true\""],"type":"codeListing"},{"inlineContent":[{"type":"text","t