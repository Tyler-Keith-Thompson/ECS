{"metadata":{"roleHeading":"Instance Method","modules":[{"name":"WorldModule"}],"extendedModule":"WorldModule","externalID":"s:11WorldModule0A0V5onAdd_7performyxm_yACz_AA6EntityVtYbctAA9ComponentRzlF","title":"onAdd(_:perform:)","symbolKind":"method","remoteSource":{"url":"https:\/\/github.com\/Tyler-Keith-Thompson\/ECS\/blob\/main\/Sources\/WorldModule\/Hooks.swift#L92","fileName":"Hooks.swift"},"role":"symbol","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"onAdd","kind":"identifier"},{"text":"<","kind":"text"},{"text":"C","kind":"genericParameter"},{"text":">(","kind":"text"},{"text":"C","kind":"typeIdentifier"},{"text":".Type, ","kind":"text"},{"text":"perform","kind":"externalParam"},{"text":": (","kind":"text"},{"text":"inout","kind":"keyword"},{"text":" ","kind":"text"},{"text":"World","preciseIdentifier":"s:11WorldModule0A0V","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"Entity","preciseIdentifier":"s:11WorldModule6EntityV","kind":"typeIdentifier"},{"text":") -> ","kind":"text"},{"text":"Void","preciseIdentifier":"s:s4Voida","kind":"typeIdentifier"},{"text":")","kind":"text"}]},"abstract":[{"text":"Registers a closure to run whenever an entity gains a component of the given type.","type":"text"}],"primaryContentSections":[{"kind":"declarations","declarations":[{"tokens":[{"text":"mutating","kind":"keyword"},{"text":" ","kind":"text"},{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"onAdd","kind":"identifier"},{"text":"<","kind":"text"},{"text":"C","kind":"genericParameter"},{"text":">(","kind":"text"},{"text":"_","kind":"externalParam"},{"text":" ","kind":"text"},{"text":"type","kind":"internalParam"},{"text":": ","kind":"text"},{"text":"C","kind":"typeIdentifier"},{"text":".Type, ","kind":"text"},{"text":"perform","kind":"externalParam"},{"text":" ","kind":"text"},{"text":"hook","kind":"internalParam"},{"text":": ","kind":"text"},{"text":"@escaping ","kind":"attribute"},{"text":"@Sendable","kind":"attribute"},{"text":" (","kind":"text"},{"text":"inout","kind":"keyword"},{"text":" ","kind":"text"},{"text":"World","kind":"typeIdentifier","preciseIdentifier":"s:11WorldModule0A0V","identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/World"},{"text":", ","kind":"text"},{"text":"Entity","kind":"typeIdentifier","preciseIdentifier":"s:11WorldModule6EntityV","identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/Entity"},{"text":") -> ","kind":"text"},{"text":"Void","kind":"typeIdentifier","preciseIdentifier":"s:s4Voida"},{"text":") ","kind":"text"},{"text":"where","kind":"keyword"},{"text":" ","kind":"text"},{"text":"C","kind":"typeIdentifier"},{"text":" : ","kind":"text"},{"text":"Component","kind":"typeIdentifier","preciseIdentifier":"s:11WorldModule9ComponentP","identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/Component"}],"platforms":["Linux"],"languages":["swift"]}]},{"kind":"parameters","parameters":[{"content":[{"type":"paragraph","inlineContent":[{"text":"The component type to watch.","type":"text"}]}],"name":"type"},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The closure to run, given the world and the entity that gained a "},{"type":"codeVoice","code":"C"},{"type":"text","text":"."}]}],"name":"hook"}]},{"kind":"content","content":[{"type":"heading","text":"Discussion","anchor":"discussion","level":2},{"type":"paragraph","inlineContent":[{"type":"text","text":"Use hooks to keep data outside the components in step with them, such as an index of"},{"type":"text","text":" "},{"type":"text","text":"entities by name. An "},{"inlineContent":[{"type":"text","text":"add hook"}],"type":"emphasis"},{"type":"text","text":" runs when an entity that didn’t hold a "},{"type":"codeVoice","code":"C"},{"type":"text","text":" gets one, by"},{"type":"text","text":" "},{"type":"text","text":"spawning, inserting or applying a command. Replacing a "},{"type":"codeVoice","code":"C"},{"type":"text","text":" the entity already holds"},{"type":"text","text":" "},{"type":"text","text":"doesn’t run it; see "},{"type":"reference","identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/World\/onInsert(_:perform:)","isActive":true},{"type":"text","text":" for a hook that runs then too."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"The following example records each named entity in a resource as it’s spawned:"}]},{"type":"codeListing","syntax":"swift","code":["struct NameDirectory: Resource { var entities: [String: Entity] = [:] }","","var world = World()","world.resources.insert(NameDirectory())","world.onAdd(Name.self) { world, entity in","    let name = world[Name.self, of: entity].value","    world.resources[NameDirectory.self].entities[name] = entity","}","","let hero = world.spawn(Name(value: \"Hero\"))","print(world.resources[NameDirectory.self].entities[\"Hero\"] == hero)","\/\/ Prints \"true\""]},{"type":"paragraph","inlineContent":[{"text":"A hook runs after the world operation that fired it has finished, so it sees every","type":"text"},{"text":" ","type":"text"},{"text":"component a spawn or bundle insert gave. Hooks run in the order they were fired. A change","type":"text"},{"text":" ","type":"text"},{"text":"that a hook makes fires hooks of its own, which run after the hooks already waiting.","type":"text"}]},{"type":"aside","content":[{"type":"paragraph","inlineContent":[{"text":"Changes made in place, through the world’s subscript or an update, run no hooks.","type":"text"},{"text":" ","type":"text"},{"text":"Find those with change detection instead.","type":"text"}]}],"name":"Note","style":"note"},{"type":"aside","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"O(1) amortized."}]}],"name":"Complexity","style":"note"}]}],"schemaVersion":{"patch":0,"minor":3,"major":0},"hierarchy":{"paths":[["doc:\/\/WorldModule\/documentation\/WorldModule","doc:\/\/WorldModule\/documentation\/WorldModule\/World"]]},"identifier":{"url":"d