"},{"type":"text","text":"."}],"type":"paragraph"}],"kind":"content"},{"content":[{"anchor":"discussion","level":2,"text":"Discussion","type":"heading"},{"inlineContent":[{"text":"Spawning many entities at once does the same as spawning each with ","type":"text"},{"isActive":true,"identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/World\/spawn(_:)-5h8u","type":"reference"},{"text":", in","type":"text"},{"text":" ","type":"text"},{"text":"order, but faster when nothing watches the spawns: the world finds the type’s storage","type":"text"},{"text":" ","type":"text"},{"text":"once and grows it once, rather than once per entity. Use it to build a large world, such","type":"text"},{"text":" ","type":"text"},{"text":"as a simulation’s initial state:","type":"text"}],"type":"paragraph"},{"syntax":"swift","code":["var world = World()","let rocks = world.spawn(contentsOf: (0 ..< 3).map { Position(x: Double($0), y: 0) })","","print(rocks.count, world[Position.self, of: rocks[2]].x)","\/\/ Prints \"3 2.0\""],"type":"codeListing"},{"inlineContent":[{"text":"The faster path applies when the world has no hooks or cached queries, and the type","type":"text"},{"text":" ","type":"text"},{"text":"requires no other components and has no relation, value index, group or change log. Otherwise","type":"text"},{"text":" ","type":"text"},{"text":"the world spawns the entities one at a time, so hooks run and every structure stays","type":"text"},{"text":" ","type":"text"},{"text":"current either way.","type":"text"}],"type":"paragraph"},{"style":"note","name":"Complexity","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"O("},{"type":"emphasis","inlineContent":[{"text":"n","type":"text"}]},{"type":"text","text":") amortized for "},{"type":"emphasis","inlineContent":[{"type":"text","text":"n"}]},{"type":"text","text":" components."}]}],"type":"aside"},{"style":"note","name":"Precondition","content":[{"type":"paragraph","inlineContent":[{"text":"Fewer than ","ty