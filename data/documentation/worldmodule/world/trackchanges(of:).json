{"kind":"symbol","identifier":{"interfaceLanguage":"swift","url":"doc:\/\/WorldModule\/documentation\/WorldModule\/World\/trackChanges(of:)"},"abstract":[{"text":"Starts logging which entities have a component of the given type added or changed, so","type":"text"},{"text":" ","type":"text"},{"text":"that finding the ones changed since a tick costs time in proportion to how many changed,","type":"text"},{"text":" ","type":"text"},{"text":"not to how many hold the type.","type":"text"}],"primaryContentSections":[{"kind":"declarations","declarations":[{"platforms":["Linux"],"tokens":[{"kind":"keyword","text":"mutating"},{"kind":"text","text":" "},{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"trackChanges"},{"kind":"text","text":"<"},{"kind":"genericParameter","text":"C"},{"kind":"text","text":">("},{"kind":"externalParam","text":"of"},{"kind":"text","text":" "},{"kind":"internalParam","text":"type"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"C"},{"kind":"text","text":".Type) "},{"kind":"keyword","text":"where"},{"kind":"text","text":" "},{"kind":"typeIdentifier","text":"C"},{"kind":"text","text":" : "},{"kind":"typeIdentifier","preciseIdentifier":"s:11WorldModule9ComponentP","identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/Component","text":"Component"}],"languages":["swift"]}]},{"parameters":[{"content":[{"inlineContent":[{"type":"text","text":"The component type whose changes to log."}],"type":"paragraph"}],"name":"type"}],"kind":"parameters"},{"kind":"mentions","mentions":["doc:\/\/WorldModule\/documentation\/WorldModule\/QueryingAWorld","doc:\/\/WorldModule\/documentation\/WorldModule\/ReactingToChanges"]},{"kind":"content","content":[{"type":"heading","text":"Discussion","anchor":"discussion","level":2},{"type":"paragraph","inlineContent":[{"type":"text","text":"Without a log, a query filtered with "},{"identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/Query\/changed(_:since:)","type":"reference","isActive":true},{"type":"text","text":" or"},{"type":"text","text":" "},{"identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/Query\/added(_:since:)","type":"reference","isActive":true},{"type":"text","text":" checks every entity it would otherwise visit. Once a type’s"},{"type":"text","text":" "},{"type":"text","text":"changes are tracked, those filters start from the entities the log records after the tick."},{"type":"text","text":" "},{"type":"text","text":"Track a type when you often ask what changed among many entities and few change between"},{"type":"text","text":" "},{"type":"text","text":"asks, such as rules that react to the handful of entities an event touched:"}]},{"type":"codeListing","code":["var world = World()","for _ in 0 ..< 1000 { world.spawn(Health(current: 10)) }","let hurt = world.spawn(Health(current: 10))","world.trackChanges(of: Health.self)","","let checkpoint = world.changeTick","world.advanceChangeTick()","world[Health.self, of: hurt].current -= 4","","let changed = world.query(Health.self).changed(Health.self, since: checkpoint)","print(changed.map(\\.entity) == [hurt])","\/\/ Prints \"true\""],"syntax":"swift"},{"type":"paragraph","inlineContent":[{"text":"Every write is logged: through the world’s subscript, an insert, an update or a mutable","type":"text"},{"text":" ","type":"text"},{"text":"span. An update logs each entity it visits, as it marks each one changed. The log holds at","type":"text"},{"text":" ","type":"text"},{"text":"most about twice as many entries as there are entities holding the type: once it grows past","type":"text"},{"text":" ","type":"text"},{"text":"that, the next write drops the entries a later change supersedes. Tracking changes makes no","type":"text"},{"text":" ","type":"text"},{"text":"difference to which entities a query finds, only to how fast it finds them. Calling this","type":"text"},{"text":" ","type":"text"},{"text":"method again for the same type does nothing. A copy of the world keeps the log.","type":"text"}]},{"type":"aside","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"O("},{"type":"emphasis","inlineContent":[{"text":"n","type":"text"}]},{"type":"text","text":" log "},{"type":"emphasis","inlineContent":[{"text":"n","type":"text"}]},{"type":"text","text":") for "},{"type":"emphasis","inlineContent":[{"type":"text","text":"n"}]},{"type":"text","text":" entities holding a "},{"type":"codeVoice","code":"C"},{"type":"text","text":". Afterward, each write to a "},{"type":"codeVoice","code":"C"},{"type":"text","text":" "},{"type":"text","text":"costs O(1) amortized more."}]}],"style":"note","name":"Complexity"}]}],"seeAlsoSections":[{"identifiers":["doc:\/\/WorldModule\/documentation\/WorldModule\/World\/changeTick","doc:\/\/WorldModule\/documentation\/WorldModule\/World\/advanceChangeTick()","doc:\/\/WorldModule\/documentation\/WorldModule\/World\/lastRun"],"generated":true,"anchor":"Detecting-Changes","title":"Detecting Changes"}],"schemaVersion":{"major":0,"patch":0,"minor":3},"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/worldmodule\/world\/trackchanges(of:)"]}],"metadata":{"role":"symbol","title":"trackChanges(of:)","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"trackChanges","kind":"identifier"},{"text":"<","kind":"text"},{"text":"C","kind":"genericParameter"},{"text":">(","kind":"text"},{"text":"of","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"C","kind":"typeIdentifier"},{"text":".Type)","kind":"text"}],"externalID":"s:11WorldModule0A0V12trackChanges2ofyxm_tAA9ComponentRzlF","symbolKind":"method","modules":[{"name":"WorldModule"}],"remoteSource":{"fileName":"World.swift","url":"https:\/\/github.com\/Tyler-Keith-Thompson\/ECS\/blob\/main\/Sources\/WorldModule\/World.swift#L255"},"roleHeading":"Instance Method"},"hierarchy":{"paths":[["doc:\/\/WorldModule\/documentation\/WorldModule","doc:\/\/WorldModule\/documentation\/WorldModule\/World"]]},"sections":[],"references":{"doc://WorldModule/documentation/WorldModule/ReactingToChanges":{"title":"Reacting to Changes","abstract":[{"type":"text","text":"Find the components that changed or went away, run code as changes happen, and pass messages"},{"type":"text","text":" "},{"type":"text","text":"between the parts of a program."}],"identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/ReactingToChanges","role":"article","kind":"article","url":"\/documentation\/worldmodule\/reactingtochanges","type":"topic"},"doc://WorldModule/documentation/WorldModule/World/changeTick":{"title":"changeTick","abstract":[{"text":"The tick the world stamps on every component it adds or changes.","type":"text"}],"identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/World\/changeTick","role":"symbol","fragments":[{"text":"var","kind":"keyword"},{"text":" ","kind":"text"},{"text":"changeTick","kind":"identifier"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:11WorldModule10ChangeTickV","text":"ChangeTick","kind":"typeIdentifier"}],"kind":"symbol","type":"topic","url":"\/documentation\/worldmodule\/world\/changetick"},"doc://WorldModule/documentation/WorldModule/Query/added(_:since:)":{"kind":"symbol","url":"\/documentation\/worldmodule\/query\/added(_:since:)","type":"topic","abstract":[{"type":"text","text":"Returns a query that also requires a component added after the given tick."}],"title":"added(_:since:)","role":"symbol","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"added","kind":"identifier"},{"text":"<","kind":"text"},{"text":"F","kind":"genericParameter"},{"text":">(","kind":"text"},{"kind":"typeIdentifier","text":"F"},{"kind":"text","text":".Type, "},{"kind":"externalParam","text":"since"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"ChangeTick","preciseIdentifier":"s:11WorldModule10ChangeTickV"},{"kind":"text","text":"?) -> "},{"kind":"typeIdentifier","text":"Query","preciseIdentifier":"s:11WorldModule5QueryV"},{"text":"<repeat each ","kind":"text"},{"text":"T","kind":"typeIdentifier"},{"text":">","kind":"text"}],"identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/Query\/added(_:since:)"},"doc://WorldModule/documentation/WorldModule":{"kind":"symbol","identifier":"doc:\/\/WorldModule\/documentation\/WorldModule","type":"topic","role":"collection","title":"WorldModule","abstract":[{"type":"text","text":"Store the state of a game or simulation as entities and components, and read and change it with"},{"type":"text","text":" "},{"type":"text","text":"queries, updates, and commands."}],"url":"\/documentation\/worldmodule"},"doc://WorldModule/documentation/WorldModule/World/trackChanges(of:)":{"kind":"symbol","identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/World\/trackChanges(of:)","type":"topic","role":"symbol","title":"trackChanges(of:)","abstract":[{"text":"Starts logging which entities have a component of the given type added or changed, so","type":"text"},{"text":" ","type":"text"},{"text":"that finding the ones changed since a tick costs time in proportion to how many changed,","type":"text"},{"text":" ","type":"text"},{"text":"not to how many hold the type.","type":"text"}],"url":"\/documentation\/worldmodule\/world\/trackchanges(of:)","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"trackChanges","kind":"identifier"},{"text":"<","kind":"text"},{"text":"C","kind":"genericParameter"},{"text":">(","kind":"text"},{"text":"of","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"C","kind":"typeIdentifier"},{"kind":"text","text":".Type)"}]},"doc://WorldModule/documentation/WorldModule/Query/changed(_:since:)":{"abstract":[{"text":"Returns a query that also requires a component added or changed after the given tick.","type":"text"}],"kind":"symbol","identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/Query\/changed(_:since:)","type":"topic","role":"symbol","title"