{"variants":[{"paths":["\/documentation\/worldmodule\/world\/trackchanges(of:)"],"traits":[{"interfaceLanguage":"swift"}]}],"abstract":[{"text":"Starts logging which entities have a component of the given type added or changed, so","type":"text"},{"text":" ","type":"text"},{"text":"that finding the ones changed since a tick costs time in proportion to how many changed,","type":"text"},{"text":" ","type":"text"},{"text":"not to how many hold the type.","type":"text"}],"primaryContentSections":[{"kind":"declarations","declarations":[{"languages":["swift"],"platforms":["Linux"],"tokens":[{"text":"mutating","kind":"keyword"},{"text":" ","kind":"text"},{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"kind":"identifier","text":"trackChanges"},{"kind":"text","text":"<"},{"kind":"genericParameter","text":"C"},{"kind":"text","text":">("},{"kind":"externalParam","text":"of"},{"kind":"text","text":" "},{"kind":"internalParam","text":"type"},{"text":": ","kind":"text"},{"text":"C","kind":"typeIdentifier"},{"text":".Type) ","kind":"text"},{"text":"where","kind":"keyword"},{"text":" ","kind":"text"},{"text":"C","kind":"typeIdentifier"},{"text":" : ","kind":"text"},{"identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/Component","kind":"typeIdentifier","preciseIdentifier":"s:11WorldModule9ComponentP","text":"Component"}]}]},{"parameters":[{"content":[{"inlineContent":[{"text":"The component type whose changes to log.","type":"text"}],"type":"paragraph"}],"name":"type"}],"kind":"parameters"},{"kind":"mentions","mentions":["doc:\/\/WorldModule\/documentation\/WorldModule\/QueryingAWorld","doc:\/\/WorldModule\/documentation\/WorldModule\/ReactingToChanges"]},{"kind":"content","content":[{"text":"Discussion","level":2,"anchor":"discussion","type":"heading"},{"inlineContent":[{"text":"Without a log, a query filtered with ","type":"text"},{"type":"reference","identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/Query\/changed(_:since:)","isActive":true},{"text":" or","type":"text"},{"text":" ","type":"text"},{"type":"reference","identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/Query\/added(_:since:)","isActive":true},{"text":" checks every entity it would otherwise visit. Once a type’s","type":"text"},{"text":" ","type":"text"},{"text":"changes are tracked, those filters start from the entities the log records after the tick.","type":"text"},{"text":" ","type":"text"},{"text":"Track a type when you often ask what changed among many entities and few change between","type":"text"},{"text":" ","type":"text"},{"text":"asks, such as rules that react to the handful of entities an event touched:","type":"text"}],"type":"paragraph"},{"syntax":"swift","type":"codeListing","code":["var world = World()","for _ in 0 ..< 1000 { world.spawn(Health(current: 10)) }","let hurt = world.spawn(Health(current: 10))","world.trackChanges(of: Health.self)","","let checkpoint = world.changeTick","world.advanceChangeTick()","world[Health.self, of: hurt].current -= 4","","let changed = world.query(Health.self).changed(Health.self, since: checkpoint)","print(changed.map(\\.entity) == [hurt])","\/\/ Prints \"true\""]},{"inlineContent":[{"text":"Every write is logged: through the world’s subscript, an insert, an update or a mutable","type":"text"},{"text":" ","type":"text"},{"text":"span. An update logs each entity it visits, as it marks each one changed. The log holds at","type":"text"},{"text":" ","type":"text"},{"text":"most about twice as many entries as there are entities holding the type: once it grows past","type":"text"},{"text":" ","type":"text"},{"text":"that, the next write drops the entries a later change supersedes. Tracking changes makes no","type":"text"},{"text":" ","type":"text"},{"text":"difference to which entities a query finds, only to how fast it finds them. Calling this","type":"text"},{"text":" ","type":"text"},{"text":"method again for the same type does nothing. A copy of the world keeps the log.","type":"text"}],"type":"paragraph"},{"name":"Complexity","content":[{"inlineContent":[{"type":"text","text":"O("},{"type":"emphasis","inlineContent":[{"type":"text","text":"n"}]},{"type":"text","text":" log "},{"type":"emphasis","inlineContent":[{"text":"n","type":"text"}]},{"type":"text","text":") for "},{"type":"emphasis","inlineContent":[{"type":"text","text":"n"}]},{"type":"text","text":" entities holding a "},{"type":"codeVoice","code":"C"},{"type":"text","text":". Afterward, each write to a "},{"type":"codeVoice","code":"C"},{"type":"text","text":" "},{"type":"text","text":"costs O(1) amortized more."}],"type":"paragraph"}],"type":"aside","style":"note"}]}],"hierarchy":{"paths":[["doc:\/\/WorldModule\/documentation\/WorldModule","doc:\/\/WorldModule\/documentation\/WorldModule\/World"]]},"schemaVersion":{"major":0,"patch":0,"minor":3},"metadata":{"roleHeading":"Instance Method","remoteSource":{"fileName":"World.swift","url":"https:\/\/github.com\/Tyler-Keith-Thompson\/ECS\/blob\/main\/Sources\/WorldModule\/World.swift#L255"},"fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"trackChanges","kind":"identifier"},{"text":"<","kind":"text"},{"text":"C","kind":"genericParameter"},{"text":">(","kind":"text"},{"text":"of","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"C","kind":"typeIdentifier"},{"text":".Type)","kind":"text"}],"role":"symbol","externalID":"s:11WorldModule0A0V12trackChanges2ofyxm_tAA9ComponentRzlF","symbolKind":"method","modules":[{"name":"WorldModule"}],"title":"trackChanges(of:)"},"sections":[],"seeAlsoSections":[{"anchor":"Detecting-Changes","title":"Detecting Changes","identifiers":["doc:\/\/WorldModule\/documentation\/WorldModule\/World\/changeTick","doc:\/\/WorldModule\/documentation\/WorldModule\/World\/advanceChangeTick()","doc:\/\/WorldModule\/documentation\/WorldModule\/World\/lastRun"],"generated":true}],"kind":"symbol","identifier":{"interfaceLanguage":"swift","url":"doc:\/\/WorldModule\/documentation\/W