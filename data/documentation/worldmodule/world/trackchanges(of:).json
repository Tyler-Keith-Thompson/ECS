Component"}]},"doc://WorldModule/documentation/WorldModule/QueryingAWorld":{"abstract":[{"type":"text","text":"Find the entities that hold the components you need, read those components, and change them in place."}],"url":"\/documentation\/worldmodule\/queryingaworld","title":"Querying a World","type":"topic","kind":"article","role":"article","identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/QueryingAWorld"},"doc://WorldModule/documentation/WorldModule/Query/added(_:since:)":{"title":"added(_:since:)","url":"\/documentation\/worldmodule\/query\/added(_:since:)","abstract":[{"type":"text","text":"Returns a query that also requires a component added after the given tick."}],"identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/Query\/added(_:since:)","type":"topic","kind":"symbol","role":"symbol","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"added","kind":"identifier"},{"text":"<","kind":"text"},{"text":"F","kind":"genericParameter"},{"text":">(","kind":"text"},{"text":"F","kind":"typeIdentifier"},{"text":".Type, ","kind":"text"},{"text":"since","kind":"externalParam"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:11WorldModule10ChangeTickV","text":"ChangeTick","kind":"typeIdentifier"},{"text":"?) -> ","kind":"text"},{"preciseIdentifier":"s:11WorldModule5QueryV","text":"Query","kind":"typeIdentifier"},{"text":"<repeat each ","kind":"text"},{"text":"T","kind":"typeIdentifier"},{"text":">","kind":"text"}]},"doc://WorldModule/documentation/WorldModule/Query/changed(_:since:)":{"role":"symbol","type":"topic","title":"changed(_:since:)","identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/Query\/changed(_:since:)","kind":"symbol","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"changed","kind":"identifier"},{"text":"<","kind":"text"},{"text":"F","kind":"genericParameter"},{"text":">(","kind":"text"},{"text":"F","kind":"typeIdentifier"},{"text":".Type, ","kind":"text"}