{"identifier":{"url":"doc:\/\/WorldModule\/documentation\/WorldModule\/World\/trackChanges(of:)","interfaceLanguage":"swift"},"kind":"symbol","metadata":{"modules":[{"name":"WorldModule"}],"remoteSource":{"url":"https:\/\/github.com\/Tyler-Keith-Thompson\/ECS\/blob\/main\/Sources\/WorldModule\/World.swift#L255","fileName":"World.swift"},"externalID":"s:11WorldModule0A0V12trackChanges2ofyxm_tAA9ComponentRzlF","roleHeading":"Instance Method","symbolKind":"method","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"trackChanges","kind":"identifier"},{"text":"<","kind":"text"},{"text":"C","kind":"genericParameter"},{"text":">(","kind":"text"},{"text":"of","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"C","kind":"typeIdentifier"},{"text":".Type)","kind":"text"}],"title":"trackChanges(of:)","role":"symbol"},"variants":[{"paths":["\/documentation\/worldmodule\/world\/trackchanges(of:)"],"traits":[{"interfaceLanguage":"swift"}]}],"seeAlsoSections":[{"generated":true,"title":"Detecting Changes","identifiers":["doc:\/\/WorldModule\/documentation\/WorldModule\/World\/changeTick","doc:\/\/WorldModule\/documentation\/WorldModule\/World\/advanceChangeTick()","doc:\/\/WorldModule\/documentation\/WorldModule\/World\/lastRun"],"anchor":"Detecting-Changes"}],"hierarchy":{"paths":[["doc:\/\/WorldModule\/documentation\/WorldModule","doc:\/\/WorldModule\/documentation\/WorldModule\/World"]]},"sections":[],"abstract":[{"type":"text","text":"Starts logging which entities have a component of the given type added or changed, so"},{"type":"text","text":" "},{"type":"text","text":"that finding the ones changed since a tick costs time in proportion to how many changed,"},{"type":"text","text":" "},{"type":"text","text":"not to how many hold the type."}],"schemaVersion":{"major":0,"patch":0,"minor":3},"primaryContentSections":[{"declarations":[{"platforms":["Linux"],"languages":["swift"],"tokens":[{"kind":"keyword","text":"mutating"},{"kind":"text","text":" "},{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"trackChanges"},{"kind":"text","text":"<"},{"kind":"genericParameter","text":"C"},{"kind":"text","text":">("},{"kind":"externalParam","text":"of"},{"kind":"text","text":" "},{"kind":"internalParam","text":"type"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"C"},{"kind":"text","text":".Type) "},{"kind":"keyword","text":"where"},{"kind":"text","text":" "},{"kind":"typeIdentifier","text":"C"},{"kind":"text","text":" : "},{"kind":"typeIdentifier","preciseIdentifier":"s:11WorldModule9ComponentP","identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/Component","text":"Component"}]}],"kind":"declarations"},{"kind":"parameters","parameters":[{"name":"type","content":[{"inlineContent":[{"type":"text","text":"The component type whose changes to log."}],"type":"paragraph"}]}]},{"kind":"mentions","mentions":["doc:\/\/WorldModule\/documentation\/WorldModule\/QueryingAWorld"]},{"content":[{"level":2,"text":"Discussion","type":"heading","anchor":"discussion"},{"inlineContent":[{"text":"Without a log, a query filtered with ","type":"text"},{"identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/Query\/changed(_:since:)","isActive":true,"type":"reference"},{"text":" or","type":"text"},{"text":" ","type":"text"},{"identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/Query\/added(_:since:)","isActive":true,"type":"reference"},{"text":" checks every entity it would otherwise visit. Once a type’s","type":"text"},{"text":" ","type":"text"},{"text":"changes are tracked, those filters start from the entities the log records after the tick.","type":"text"},{"text":" ","type":"text"},{"text":"Track a type when you often ask what changed among many entities and few change between","type":"text"},{"text":" ","type":"text"},{"text":"asks, such as rules that react to the handful of entities an event touched:","type":"text"}],"type":"paragraph"},{"syntax":"swift","type":"codeListing","code":["var world = World()","for _ in 0 ..< 1000 { world.spawn(Health(current: 10)) }","let hurt = world.spawn(Health(current: 10))","world.trackChanges(of: Health.self)","","let checkpoint = world.changeTick","world.advanceChangeTick()","world[Health.self, of: hurt].current -= 4","","let changed = world.query(Health.self).changed(Health.self, since: checkpoint)","print(changed.map(\\.entity) == [hurt])","\/\/ Prints \"true\""]},{"inlineContent":[{"text":"Every write is logged: through the world’s subscript, an insert, an update or a mutable","type":"text"},{"text":" ","type":"text"},{"text":"span. An update logs each entity it visits, as it marks each one changed. The log holds at","type":"text"},{"text":" ","type":"text"},{"text":"most about twice as many entries as there are entities holding the type: once it grows past","type":"text"},{"text":" ","type":"text"},{"text":"that, the next write drops the entries a later change supersedes. Tracking changes makes no","type":"text"},{"text":" ","type":"text"},{"text":"difference to which entities a query finds, only to how fast it finds them. Calling this","type":"text"},{"text":" ","type":"text"},{"text":"method again for the same type does nothing. A copy of the world keeps the log.","type":"text"}],"type":"paragraph"},{"style":"note","name":"Complexity","type":"aside","content":[{"inlineContent":[{"type":"text","text":"O("},{"type":"emphasis","inlineContent":[{"text":"n","type":"text"}]},{"type":"text","text":" log "},{"type":"emphasis","inlineContent":[{"type":"text","text":"n"}]},{"type":"text","text":") for "},{"type":"emphasis","inlineContent":[{"type":"text","text":"n"}]},{"type":"text","text":" entities holding a "},{"type":"codeVoice","code":"C"},{"type":"text","text":". Afterward, each write to a "},{"type":"codeVoice","code":"C"},{"type":"text","text":" "},{"type":"text","text":"costs O(1) amortized more."}],"type":"paragraph"}]}],"kind":"content"}],"references":{"doc://WorldModule/documentation/WorldModule/World/trackChanges(of:)":{"type":"topic","title":"trackChanges(of:)","url":"\/documentation\/worldmodule\/world\/trackchanges(of:)","identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/World\/trackChanges(of:)","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"trackChanges","kind":"identifier"},{"text":"<","kind":"text"},{"text":"C","kind":"genericParameter"},{"text":">(","kind":"text"},{"text":"of","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"C","kind":"typeIdentifier"},{"text":".Type)","kind":"text"}],"abstract":[{"text":"Starts logging which entities have a component of the given type added or changed, so","type":"text"},{"text":" ","type":"text"},{"text":"that finding the ones changed since a tick costs time in proportion to how many changed,","type":"text"},{"text":" ","type":"text"},{"text":"not to how many hold the type.","type":"text"}],"kind":"symbol","role":"symbol"},"doc://WorldModule/documentation/WorldModule/World":{"kind":"symbol","abstract":[{"text":"A collection of entities, the components they hold, and resources.","type":"text"}],"identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/World","url":"\/documentation\/worldmodule\/world","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"World"}],"title":"World","navigatorTitle":[{"kind":"identifier","text":"World"}],"role":"symbol","type":"topic"},"doc://WorldModule/documentation/WorldModule":{"kind":"symbol","abstract":[{"text":"Store the state of a game or simulation as entities and components, and read and change it with","type":"text"},{"text":" ","type":"text"},{"text":"queries, updates, and commands.","type":"text"}],"identifier":"doc:\/\/WorldModule\/documentation\/WorldModule","url":"\/documentation\/worldmodule","title":"WorldModule","role":"collection","type":"topic"},"doc://WorldModule/documentation/WorldModule/Query/changed(_:since:)":{"title":