},{"kind":"identifier","text":"added"},{"kind":"text","text":"<"},{"kind":"genericParameter","text":"F"},{"kind":"text","text":">("},{"text":"F","kind":"typeIdentifier"},{"text":".Type, ","kind":"text"},{"text":"since","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"ChangeTick","kind":"typeIdentifier","preciseIdentifier":"s:11WorldModule10ChangeTickV"},{"text":"?) -> ","kind":"text"},{"text":"Query","kind":"typeIdentifier","preciseIdentifier":"s:11WorldModule5QueryV"},{"kind":"text","text":"<repeat each "},{"kind":"typeIdentifier","text":"T"},{"kind":"text","text":">"}]},"doc://WorldModule/documentation/WorldModule/World/advanceChangeTick()":{"identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/World\/advanceChangeTick()","kind":"symbol","url":"\/documentation\/worldmodule\/world\/advancechangetick()","type":"topic","role":"symbol","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"advanceChangeTick"},{"kind":"text","text":"() -> "},{"preciseIdentifier":"s:11WorldModule10ChangeTickV","kind":"typeIdentifier","text":"ChangeTick"}],"title":"advanceChangeTick()","abstract":[{"text":"Starts a new change tick, so components added or changed from now on are newer than every","type":"text"},{"text":" ","type":"text"},{"text":"earlier tick.","type":"text"}]},"doc://WorldModule/documentation/WorldModule/World/lastRun":{"url":"\/documentation\/worldmodule\/world\/lastrun","type":"topic","kind":"symbol","abstract":[{"type":"text","text":"The change tick at which the running system last ran."}],"identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/World\/lastRun","title":"lastRun","fragments":[{"text":"var","kind":"keyword"},{"text":" ","kind":"text"},{"text":"lastRun","kind":"identifier"},{"text":": ","kind":"text"},{"text":"ChangeTick","kind":"typeIdentifier","preciseIdentifier":"s:11WorldModule10ChangeTickV"}],"role":"symbol"},"doc://WorldModule/documentation/WorldModule/QueryingAWorld":{"abstr