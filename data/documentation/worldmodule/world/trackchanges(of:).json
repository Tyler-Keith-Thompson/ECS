{"metadata":{"externalID":"s:11WorldModule0A0V12trackChanges2ofyxm_tAA9ComponentRzlF","title":"trackChanges(of:)","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"trackChanges","kind":"identifier"},{"text":"<","kind":"text"},{"text":"C","kind":"genericParameter"},{"text":">(","kind":"text"},{"text":"of","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"C","kind":"typeIdentifier"},{"text":".Type)","kind":"text"}],"symbolKind":"method","role":"symbol","roleHeading":"Instance Method","modules":[{"name":"WorldModule"}],"remoteSource":{"url":"https:\/\/github.com\/Tyler-Keith-Thompson\/ECS\/blob\/main\/Sources\/WorldModule\/World.swift#L255","fileName":"World.swift"}},"sections":[],"abstract":[{"text":"Starts logging which entities have a component of the given type added or changed, so","type":"text"},{"text":" ","type":"text"},{"text":"that finding the ones changed since a tick costs time in proportion to how many changed,","type":"text"},{"text":" ","type":"text"},{"text":"not to how many hold the type.","type":"text"}],"variants":[{"paths":["\/documentation\/worldmodule\/world\/trackchanges(of:)"],"traits":[{"interfaceLanguage":"swift"}]}],"schemaVersion":{"minor":3,"major":0,"patch":0},"kind":"symbol","identifier":{"url":"doc:\/\/WorldModule\/documentation\/WorldModule\/World\/trackChanges(of:)","interfaceLanguage":"swift"},"hierarchy":{"paths":[["doc:\/\/WorldModule\/documentation\/WorldModule","doc:\/\/WorldModule\/documentation\/WorldModule\/World"]]},"seeAlsoSections":[{"title":"Detecting Changes","generated":true,"identifiers":["doc:\/\/WorldModule\/documentation\/WorldModule\/World\/changeTick","doc:\/\/WorldModule\/documentation\/WorldModule\/World\/advanceChangeTick()","doc:\/\/WorldModule\/documentation\/WorldModule\/World\/lastRun"],"anchor":"Detecting-Changes"}],"primaryContentSections":[{"kind":"declarations","declarations":[{"platforms":["Linux"],"languages":["swift"],"tokens":[{"kind":"keyword","text":"mutating"},{"kind":"text","text":" "},{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"trackChanges"},{"kind":"text","text":"<"},{"kind":"genericParameter","text":"C"},{"kind":"text","text":">("},{"kind":"externalParam","text":"of"},{"kind":"text","text":" "},{"kind":"internalParam","text":"type"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"C"},{"kind":"text","text":".Type) "},{"kind":"keyword","text":"where"},{"kind":"text","text":" "},{"kind":"typeIdentifier","text":"C"},{"kind":"text","text":" : "},{"identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/Component","kind":"typeIdentifier","preciseIdentifier":"s:11WorldModule9ComponentP","text":"Component"}]}]},{"kind":"parameters","parameters":[{"content":[{"inlineContent":[{"type":"text","text":"The component type whose changes to log."}],"type":"paragraph"}],"name":"type"}]},{"kind":"mentions","mentions":["doc:\/\/WorldModule\/documentation\/WorldModule\/QueryingAWorld"]},{"content":[{"text":"Discussion","anchor":"discussion","level":2,"type":"heading"},{"inlineContent":[{"text":"Without a log, a query filtered with ","type":"text"},{"identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/Query\/changed(_:since:)","isActive":true,"type":"reference"},{"text":" or","type":"text"},{"text":" ","type":"text"},{"identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/Query\/added(_:since:)","isActive":true,"type":"reference"},{"text":" checks every entity it would otherwise visit. Once a type’s","type":"text"},{"text":" ","type":"text"},{"text":"changes are tracked, those filters start from the entities the log records after the tick.","type":"text"},{"text":" ","type":"text"},{"text":"Track a type when you often ask what changed among many entities and few change between","type":"text"},{"text":" ","type":"text"},{"text":"asks, such as rules that react to the handful of entities an event touched:","type":"text"}],"type":"paragraph"},{"syntax":"swift","code":["var world = World()","for _ in 0 ..< 1000 { world.spawn(Health(current: 10)) }","let hurt = world.spawn(Health(current: 10))","world.trackChanges(of: Health.self)","","let checkpoint = world.changeTick","world.advanceChangeTick()","world[Health.self, of: hurt].current -= 4","","let changed = world.query(Health.self).changed(Health.self, since: checkpoint)","print(changed.map(\\.entity) == [hurt])","\/\/ Prints \"true\""],"type":"codeListing"},{"inlineContent":[{"type":"text","text":"Every write is logged: through the world’s subscript, an insert, an update or a mutable"},{"type":"text","text":" "},{"type":"text","text":"span. An update logs each entity it visits, as it marks each one changed. The log holds at"},{"type":"text","text":" "},{"type":"text","text":"most about twice as many entries as there are entities holding the type: once it grows past"},{"type":"text","text":" "},{"type":"text","text":"that, the next write drops the entries a later change supersedes. Tracking changes makes no"},{"type":"text","text":" "},{"type":"text","text":"difference to which entities a query finds, only to how fast it finds them. Calling this"},{"type":"text","text":" "},{"type":"text","text":"method again for the same type does nothing. A copy of the world keeps the log."}],"type":"paragraph"},{"content":[{"inlineContent":[{"type":"text","text":"O("},{"type":"emphasis","inlineContent":[{"type":"text","text":"n"}]},{"type":"text","text":" log "},{"type":"emphasis","inlineContent":[{"type":"text","text":"n"}]},{"type":"text","text":") for "},{"type":"emphasis","inlineContent":[{"text":"n","type":"text"}]},{"type":"text","text":" entities holding a "},{"type":"codeVoice","code":"C"},{"type":"text","text":". Afterward, each write to a "},{"type":"codeVoice","code":"C"},{"type":"text","text":" "},{"type":"text","text":"costs O(1) amortized more."}],"type":"paragraph"}],"style":"note","name":"Complexity","type":"aside"}],"kind":"content"}],"references":{"doc://WorldModule/documentation/WorldModule/Component":{"title":"Component","role":"symbol","identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/Component","kind":"symbol","navigatorTitle":[{"text":"Component","kind":"identifier"}],"url":"\/documentation\/worldmodule\/component","abstract":[{"type":"text","text":"A type that can be stored as a component of an entity."}],"fragments":[{"text":"protocol","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Component","kind":"identifier"}],"type":"topic"},"doc://WorldModule/documentation/WorldModule/World":{"role":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"World","kind":"identifier"}],"kind":"symbol","type":"topic","identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/World","title":"World","navigatorTitle":[{"text":"World","kind":"identifier"}],"url":"\/documentation\/worldmodule\/world","abstract":[{"text":"A collection of entities, the components they hold, and resources.","type":"text"}]},"doc://WorldModule/documentation/WorldModule/World/changeTick":{"title":"changeTick","url":"\/documentation\/worldmodule\/world\/changetick","type":"topic","identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/World\/changeTick","fragments":[{"text":"var","kind":"keyword"},{"text":" ","kind":"text"},{"text":"changeTick","kind":"identifier"},{"text":": ","kind":"text"},{"text":"ChangeTick","kind":"typeIdentifier","preciseIdentifier":"s:11WorldModule10ChangeTickV"}],"abstract":[{"text":"The tick the world stamps on every component it adds or changes.","type":"text"}],"role":"symbol","kind":"symbol"},"doc://WorldModule/documentation/WorldModule/Query/changed(_:since:)":{"role":"symbol","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"changed","kind":"identifier"},{"text":"<","kind":"text"},{"text":"F","kind":"genericParameter"},{"text":">(","kind":"text"},{"text":"F","kind":"typeIdentifier"},{"text":".Type, ","kind":"text"},{"text":"since","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"ChangeTick","kind":"typeIdentifier","preciseIdentifier":"s:11WorldModule10ChangeTickV"},{"text":"?) -> ","kind":"text"},{"text":"Query","kind":"typeIdentifier","preciseIdentifier":"s:11WorldModule5QueryV"},{"kind":"text","text":"<repeat each "},{"kind":"typeIdentifier","text":"T"},{"kind":"text","text":">"}],"kind":"symbol","type":"topic","identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/Query\/changed(_:since:)","title":"changed(_:since:)","url":"\/documentation\/worldmodule\/query\/changed(_:since:)","abstract":[{"type":"text","text":"Returns a query that also requires a component added or changed after the given tick."}]},"doc://WorldModule/documentation/WorldModule/Query/added(_:since:)":{"type":"topic","url":"\/documentation\/worldmodule\/query\/added(_:since:)","role":"symbol","kind":"symbol","title":"added(_:since:)","abstract":[{"type":"text","text":"Returns a query that also requires a component added after the given tick."}],"fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"added"},{"kind":"text","text":"<"},{"kind":"genericParameter","text":"F"},{"kind":"text","text":">("},{"kind":"typeIdentifier","text":"F"},{"kind":"text","text":".Type, "},{"kind":"externalParam","text":"since"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:11WorldModule10ChangeTickV","text":"ChangeTick"},{"kind":"text","text":"?) -> "},{"kind":"typeIdentifier","preciseIdentifier":"s:11WorldModule5QueryV","text":"Query"},{"kind":"text","text":"<repeat each "},{"kind":"typeIdentifier","text":"T"},{"kind":"text","text":">"}],"identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/Query\/added(_:since:)"},"doc://WorldModule/documentation/WorldModule/QueryingAWorld":{"title":"Querying a World","role":"article","identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/QueryingAWorld","kind":"article","url":"\/documentation\/w