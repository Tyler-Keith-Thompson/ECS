{"abstract":[{"type":"text","text":"Starts logging which entities have a component of the given type added or changed, so"},{"type":"text","text":" "},{"type":"text","text":"that finding the ones changed since a tick costs time in proportion to how many changed,"},{"type":"text","text":" "},{"type":"text","text":"not to how many hold the type."}],"hierarchy":{"paths":[["doc:\/\/WorldModule\/documentation\/WorldModule","doc:\/\/WorldModule\/documentation\/WorldModule\/World"]]},"identifier":{"url":"doc:\/\/WorldModule\/documentation\/WorldModule\/World\/trackChanges(of:)","interfaceLanguage":"swift"},"sections":[],"seeAlsoSections":[{"anchor":"Detecting-Changes","generated":true,"title":"Detecting Changes","identifiers":["doc:\/\/WorldModule\/documentation\/WorldModule\/World\/changeTick","doc:\/\/WorldModule\/documentation\/WorldModule\/World\/advanceChangeTick()","doc:\/\/WorldModule\/documentation\/WorldModule\/World\/lastRun"]}],"kind":"symbol","primaryContentSections":[{"declarations":[{"platforms":["Linux"],"tokens":[{"kind":"keyword","text":"mutating"},{"kind":"text","text":" "},{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"trackChanges"},{"kind":"text","text":"<"},{"kind":"genericParameter","text":"C"},{"kind":"text","text":">("},{"kind":"externalParam","text":"of"},{"kind":"text","text":" "},{"kind":"internalParam","text":"type"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"C"},{"kind":"text","text":".Type) "},{"kind":"keyword","text":"where"},{"kind":"text","text":" "},{"kind":"typeIdentifier","text":"C"},{"kind":"text","text":" : "},{"kind":"typeIdentifier","preciseIdentifier":"s:11WorldModule9ComponentP","identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/Component","text":"Component"}],"languages":["swift"]}],"kind":"declarations"},{"parameters":[{"name":"type","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The component type whose changes to log."}]}]}],"kind":"parameters"},{"kind":"mentions","mentions":["doc:\/\/WorldModule\/documentation\/WorldModule\/QueryingAWorld","doc:\/\/WorldModule\/documentation\/WorldModule\/ReactingToChanges"]},{"kind":"content","content":[{"type":"heading","level":2,"text":"Discussion","anchor":"discussion"},{"inlineContent":[{"text":"Without a log, a query filtered with ","type":"text"},{"identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/Query\/changed(_:since:)","type":"reference","isActive":true},{"text":" or","type":"text"},{"text":" ","type":"text"},{"identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/Query\/added(_:since:)","type":"reference","isActive":true},{"text":" checks every entity it would otherwise visit. Once a type’s","type":"text"},{"text":" ","type":"text"},{"text":"changes are tracked, those filters start from the entities the log records after the tick.","type":"text"},{"text":" ","type":"text"},{"text":"Track a type when you often ask what changed among many entities and few change between","type":"text"},{"text":" ","type":"text"},{"text":"asks, such as rules that react to the handful of entities an event touched:","type":"text"}],"type":"paragraph"},{"syntax":"swift","code":["var world = World()","for _ in 0 ..< 1000 { world.spawn(Health(current: 10)) }","let hurt = world.spawn(Health(current: 10))","world.trackChanges(of: Health.self)","","let checkpoint = world.changeTick","world.advanceChangeTick()","world[Health.self, of: hurt].current -= 4","","let changed = world.query(Health.self).changed(Health.self, since: checkpoint)","print(changed.map(\\.entity) == [hurt])","\/\/ Prints \"true\""],"type":"codeListing"},{"inlineContent":[{"text":"Every write is logged: through the world’s subscript, an insert, an update or a mutable","type":"text"},{"text":" ","type":"text"},{"text":"span. An update logs each entity it visits, as it marks each one changed. The log holds at","type":"text"},{"text":" ","type":"text"},{"text":"most about twice as many entries as there are entities holding the type: once it grows past","type":"text"},{"text":" ","type":"text"},{"text":"that, the next write drops the entries a later change supersedes. Tracking changes makes no","type":"text"},{"text":" ","type":"text"},{"text":"difference to which entities a query finds, only to how fast it finds them. Calling this","type":"text"},{"text":" ","type":"text"},{"text":"method again for the same type does nothing. A copy of the world keeps the log.","type":"text"}],"type":"paragraph"},{"content":[{"type":"paragraph","inlineContent":[{"text":"O(","type":"text"},{"inlineContent":[{"type":"text","text":"n"}],"type":"emphasis"},{"text":" log ","type":"text"},{"inlineContent":[{"type":"text","text":"n"}],"type":"emphasis"},{"text":") for ","type":"text"},{"inlineContent":[{"type":"text","text":"n"}],"type":"emphasis"},{"text":" entities holding a ","type":"text"},{"code":"C","type":"codeVoice"},{"text":". Afterward, each write to a ","type":"text"},{"code":"C","type":"codeVoice"},{"text":" ","type":"text"},{"text":"costs O(1) amortized more.","type":"text"}]}],"type":"aside","name":"Complexity","style":"note"}]}],"metadata":{"title":"trackChanges(of:)","modules":[{"name":"WorldModule"}],"fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"trackChanges","kind":"identifier"},{"text":"<","kind":"text"},{"text":"C","kind":"genericParameter"},{"text":">(","kind":"text"},{"text":"of","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"C","kind":"typeIdentifier"},{"text":".Type)","kind":"text"}],"symbolKind":"method","externalID":"s:11WorldModule0A0V12trackChanges2ofyxm_tAA9ComponentRzlF","roleHeading":"Instance Method","remoteSource":{"url":"https:\/\/github.com\/Tyler-Keith-Thompson\/ECS\/blob\/main\/Sources\/WorldModule\/World.swift#L255","fileName":"World.swift"},"role":"symbol"},"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/worldmodule\/world\/trackchanges(of:)"]}],"schemaVe