{"kind":"symbol","sections":[],"schemaVersion":{"major":0,"patch":0,"minor":3},"hierarchy":{"paths":[["doc:\/\/WorldModule\/documentation\/WorldModule","doc:\/\/WorldModule\/documentation\/WorldModule\/World"]]},"primaryContentSections":[{"kind":"declarations","declarations":[{"tokens":[{"kind":"keyword","text":"mutating"},{"kind":"text","text":" "},{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"trackChanges"},{"kind":"text","text":"<"},{"kind":"genericParameter","text":"C"},{"kind":"text","text":">("},{"kind":"externalParam","text":"of"},{"kind":"text","text":" "},{"kind":"internalParam","text":"type"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"C"},{"kind":"text","text":".Type) "},{"kind":"keyword","text":"where"},{"kind":"text","text":" "},{"kind":"typeIdentifier","text":"C"},{"kind":"text","text":" : "},{"kind":"typeIdentifier","identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/Component","text":"Component","preciseIdentifier":"s:11WorldModule9ComponentP"}],"platforms":["Linux"],"languages":["swift"]}]},{"kind":"parameters","parameters":[{"content":[{"type":"paragraph","inlineContent":[{"text":"The component type whose changes to log.","type":"text"}]}],"name":"type"}]},{"kind":"mentions","mentions":["doc:\/\/WorldModule\/documentation\/WorldModule\/QueryingAWorld","doc:\/\/WorldModule\/documentation\/WorldModule\/ReactingToChanges"]},{"kind":"content","content":[{"anchor":"discussion","text":"Discussion","level":2,"type":"heading"},{"inlineContent":[{"text":"Without a log, a query filtered with ","type":"text"},{"identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/Query\/changed(_:since:)","isActive":true,"type":"reference"},{"text":" or","type":"text"},{"text":" ","type":"text"},{"identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/Query\/added(_:since:)","isActive":true,"type":"reference"},{"text":" checks every entity it would otherwise visit. Once a type’s","type":"text"},{"text":" ","type":"text"},{"text":"changes are tracked, those filters start from the entities the log records after the tick.","type":"text"},{"text":" ","type":"text"},{"text":"Track a type when you often ask what changed among many entities and few change between","type":"text"},{"text":" ","type":"text"},{"text":"asks, such as rules that react to the handful of entities an event touched:","type":"text"}],"type":"paragraph"},{"code":["var world = World()","for _ in 0 ..< 1000 { world.spawn(Health(current: 10)) }","let hurt = world.spawn(Health(current: 10))","world.trackChanges(of: Health.self)","","let checkpoint = world.changeTick","world.advanceChangeTick()","world[Health.self, of: hurt].current -= 4","","let changed = world.query(Health.self).changed(Health.self, since: checkpoint)","print(changed.map(\\.entity) == [hurt])","\/\/ Prints \"true\""],"syntax":"swift","type":"codeListing"},{"inlineContent":[{"text":"Every write is logged: through the world’s subscript, an insert, an update or a mutable","type":"text"},{"text":" ","type":"text"},{"text":"span. An update logs each entity it visits, as it marks each one changed. The log holds at","type":"text"},{"text":" ","type":"text"},{"text":"most about twice as many entries as there are entities holding the type: once it grows past","type":"text"},{"text":" ","type":"text"},{"text":"that, the next write drops the entries a later change supersedes. Tracking changes makes no","type":"text"},{"text":" ","type":"text"},{"text":"difference to which entities a query finds, only to how fast it finds them. Calling this","type":"text"},{"text":" ","type":"text"},{"text":"method again for the same type does nothing. A copy of the world keeps the log.","type":"text"}],"type":"paragraph"},{"name":"Complexity","content":[{"type":"paragraph","inlineContent":[{"text":"O(","type":"text"},{"inlineContent":[{"text":"n","type":"text"}],"type":"emphasis"},{"text":" log ","type":"text"},{"inlineContent":[{"type":"text","text":"n"}],"type":"emphasis"},{"text":") for ","type":"text"},{"inlineContent":[{"text":"n","type":"text"}],"type":"emphasis"},{"text":" entities holding a ","type":"text"},{"code":"C","type":"codeVoice"},{"text":". Afterward, each write to a ","type":"text"},{"code":"C","type":"codeVoice"},{"text":" ","type":"text"},{"text":"costs O(1) amortized more.","type":"text"}]}],"style":"note","type":"aside"}]}],"seeAlsoSections":[{"generated":true,"identifiers":["doc:\/\/WorldModule\/documentation\/WorldModule\/World\/changeTick","doc:\/\/WorldModule\/documentation\/WorldModule\/World\/advanceChangeTick()","doc:\/\/WorldModule\/documentation\/WorldModule\/World\/lastRun"],"title":"Detecting Changes","anchor":"Detecting-Changes"}],"variants":[{"paths":["\/documentation\/worldmodule\/world\/trackchanges(of:)"],"traits":[{"interfaceLanguage":"swift"}]}],"abstract":[{"text":"Starts logging which entities have a component of the given type added or changed, so","type":"text"},{"text":" ","type":"text"},{"text":"that finding the ones changed since a tick costs time in proportion to how many changed,","type":"text"},{"text":" ","type":"text"},{"text":"not to how many hold the type.","type":"text"}],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/WorldModule\/documentation\/WorldModule\/World\/trackChanges(of:)"},"metadata":{"fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"trackChanges"},{"kind":"text","text":"<"},{"kind":"genericParameter","text":"C"},{"kind":"text","text":">("},{"kind":"externalParam","text":"of"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"C"},{"kind":"text","text":".Type)"}],"externalID":"s:11WorldModule0A0V12trackChanges2ofyxm_tAA9ComponentRzlF","modules":[{"name":"WorldModule"}],"remoteSource":{"fileName":"World.swift","url":"https:\/\/github.com\/Tyler-Keith-Thompson\/ECS\/blob\/main\/Sources\/WorldModule\/World.swift#L255"},"symbolKind":"method","role":"symbol","roleHeading":"Instance Method","title":"trackChanges(of:)"},"references":{"doc://WorldModule/documentation/WorldModule/QueryingAWorld":{"abstract":[{"text":"Find the entities that hold the components you need, read those components, and change them in place.","type":"text"}],"role":"article","url":"\/documentation\/worldmodule\/queryingaworld","kind":"article","identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/QueryingAWorld","title":"Querying a World","type":"topic"},"doc://WorldModule/documentation/WorldModule/Query/added(_:since:)":{"title":"added(_:since:)","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"added","kind":"identifier"},{"text":"<","kind":"text"},{"text":"F","kind":"genericParameter"},{"text":">(","kind":"text"},{"text":"F","kind":"typeIdentifier"},{"text":".Type, ","kind":"text"},{"text":"since","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"ChangeTick","kind":"typeIdentifier","preciseIdentifier":"s:11WorldModule10ChangeTickV"},{"text":"?) -> ","kind":"text"},{"text":"Query","kind":"typeIdentifier","preciseIdentifier":"s:11WorldModule5QueryV"},{"text":"<repeat each ","kind":"text"},{"text":"T","kind":"typeIdentifier"},{"text":">","kind":"text"}],"kind":"symbol","type":"topic","identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/Query\/added(_:since:)","url":"\/documentation\/worldmodule\/query\/added(_:since:)","abstract":[{"text":"Returns a query that also requires a component added after the given tick.","type":"text"}],"role":"symbol"},"doc://WorldModule/documentation/WorldModule/ReactingToChanges":{"kind":"article","role":"article","type":"topic","abstract":[{"type":"text","text":"Find the components that changed or went away, run code as changes happen, and pass messages"},{"type":"text","text":" "},{"type":"text","text":"between the parts of a program."}],"url":"\/documentation\/worldmodule\/reactingtochanges","title":"Reacting to Changes","identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/ReactingToChanges"},"doc://WorldModule/documentation/WorldModule":{"abstract":[{"text":"Store the state of a game or simulation as entities and components, and read and change it with","type":"text"},{"text":" ","type":"text"},{"text":"queries, updates, and commands.","type":"text"}],"role":"collection","url":"\/documentation\/worldmodule","kind":"symbol","identifier":"doc:\/\/WorldModule\/documentation\/WorldModule","title":"WorldModule","type":"topic"},"doc://WorldModule/documentation/WorldModule/Component":{"abstract":[{"type":"text","text":"A type that can be stored as a component of an entity."}],"role":"symbol","url":"\/documentation\/worldmodule\/component","kind":"symbol","navigatorTitle":[{"kind":"identifier","text":"Component"}],"type":"topic","identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/Component","title":"Component","fragments":[{"kind":"keyword","text":"protocol"},{"kind":"text","text":" "},{"kind":"identifier","text":"Component"}]},"doc://WorldModule/documentation/WorldModule/World/trackChanges(of:)":{"kind":"symbol","role":"symbol","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"trackChanges"},{"kind":"text","text":"<"},{"kind":"genericParameter","text":"C"},{"kind":"text","text":">("},{"kind":"externalParam","text":"of"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"C"},{"kind":"text","text":".Type)"}],"abstract":[{"type":"text","text":"Starts logging which entities have a component of the given type added or changed, so"},{"type":"text","text":" "},{"type":"text","text":"that finding the ones changed since a tick costs time in proportion to how many changed,"},{"type":"text","text":" "},{"type":"text","text":"not to how many hold the type."}],"type":"topic","url":"\/documentation\/worldmodule\/world\/trackchanges(of:)","title":"trackChanges(of:)","identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/World\/trackChanges(of:)"},"doc://WorldModule/doc