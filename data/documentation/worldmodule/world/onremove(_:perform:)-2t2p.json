{"abstract":[{"text":"Registers a closure to run whenever an entity loses a component of the given type.","type":"text"}],"primaryContentSections":[{"declarations":[{"tokens":[{"kind":"keyword","text":"mutating"},{"kind":"text","text":" "},{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"onRemove"},{"kind":"text","text":"<"},{"kind":"genericParameter","text":"C"},{"kind":"text","text":">("},{"kind":"externalParam","text":"_"},{"kind":"text","text":" "},{"kind":"internalParam","text":"type"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"C"},{"kind":"text","text":".Type, "},{"kind":"externalParam","text":"perform"},{"kind":"text","text":" "},{"kind":"internalParam","text":"hook"},{"kind":"text","text":": "},{"kind":"attribute","text":"@escaping "},{"kind":"attribute","text":"@Sendable"},{"kind":"text","text":" ("},{"kind":"keyword","text":"inout"},{"kind":"text","text":" "},{"kind":"typeIdentifier","text":"World","identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/World","preciseIdentifier":"s:11WorldModule0A0V"},{"kind":"text","text":", "},{"kind":"typeIdentifier","text":"Entity","identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/Entity","preciseIdentifier":"s:11WorldModule6EntityV"},{"kind":"text","text":", "},{"kind":"typeIdentifier","text":"C"},{"kind":"text","text":") -> "},{"kind":"typeIdentifier","text":"Void","preciseIdentifier":"s:s4Voida"},{"kind":"text","text":") "},{"kind":"keyword","text":"where"},{"kind":"text","text":" "},{"kind":"typeIdentifier","text":"C"},{"kind":"text","text":" : "},{"kind":"typeIdentifier","text":"Component","identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/Component","preciseIdentifier":"s:11WorldModule9ComponentP"}],"languages":["swift"],"platforms":["Linux"]}],"kind":"declarations"},{"parameters":[{"content":[{"inlineContent":[{"text":"The component type to watch.","type":"text"}],"type":"paragraph"}],"name":"type"},{"content":[{"type":"paragraph","inlineContent":[{"text":"The closure to run, given the world, the entity that lost its ","type":"text"},{"code":"C","type":"codeVoice"},{"text":" and the","type":"text"},{"text":" ","type":"text"},{"text":"component it lost.","type":"text"}]}],"name":"hook"}],"kind":"parameters"},{"content":[{"anchor":"discussion","text":"Discussion","type":"heading","level":2},{"inlineContent":[{"text":"A ","type":"text"},{"type":"emphasis","inlineContent":[{"text":"remove hook","type":"text"}]},{"text":" runs when an entity loses its ","type":"text"},{"code":"C","type":"codeVoice"},{"text":" by removing it, removing a bundle that","type":"text"},{"text":" ","type":"text"},{"text":"holds it, or being despawned. The hook receives the removed component, since it’s gone","type":"text"},{"text":" ","type":"text"},{"text":"from the entity by the time the hook runs; after a despawn, the entity is no longer live.","type":"text"},{"text":" ","type":"text"},{"text":"Remove hooks run at the same point add hooks do (see ","type":"text"},{"code":"onAdd(_:perform:)","type":"codeVoice"},{"text":").","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"The following example keeps a directory of named entities in step as they’re despawned:","type":"text"}],"type":"paragraph"},{"type":"codeListing","syntax":"swift","code":["var world = World()","world.resources.insert(NameDirectory())","world.onAdd(Name.self) { world, entity in","    let name = world[Name.self, of: entity].value","    world.resources[NameDirectory.self].entities[name] = entity","}","world.onRemove(Name.self) { world, _, name in","    world.resources[NameDirectory.self].entities[name.value] = nil","}","","let villain = world.spawn(Name(value: \"Villain\"))","world.despawn(villain)","print(world.resources[NameDirectory.self].entities.isEmpty)","\/\/ Prints \"true\""]},{"style":"note","content":[{"inlineContent":[{"text":"O(1) amortized.","type":"text"}],"type":"paragraph"}],"type":"aside","name":"Complexity"}],"ki