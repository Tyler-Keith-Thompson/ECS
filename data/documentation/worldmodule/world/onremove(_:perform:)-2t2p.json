 lost its ","type":"text"},{"code":"C","type":"codeVoice"},{"text":" and the","type":"text"},{"text":" ","type":"text"},{"text":"component it lost.","type":"text"}]}]}]},{"content":[{"type":"heading","anchor":"discussion","level":2,"text":"Discussion"},{"type":"paragraph","inlineContent":[{"type":"text","text":"A "},{"inlineContent":[{"type":"text","text":"remove hook"}],"type":"emphasis"},{"type":"text","text":" runs when an entity loses its "},{"type":"codeVoice","code":"C"},{"type":"text","text":" by removing it, removing a bundle that"},{"type":"text","text":" "},{"type":"text","text":"holds it, or being despawned. The hook receives the removed component, since it’s gone"},{"type":"text","text":" "},{"type":"text","text":"from the entity by the time the hook runs; after a despawn, the entity is no longer live."},{"type":"text","text":" "},{"type":"text","text":"Remove hooks run at the same point add hooks do (see "},{"type":"codeVoice","code":"onAdd(_:perform:)"},{"type":"text","text":")."}]},{"type":"paragraph","inlineContent":[{"text":"The following example keeps a directory of named entities in step as they’re despawned:","type":"text"}]},{"type":"codeListing","syntax":"swift","code":["var world = World()","world.resources.insert(NameDirectory())","world.onAdd(Name.self) { world, entity in","    let name = world[Name.self, of: entity].value","    world.resources[NameDirectory.self].entities[name] = entity","}","world.onRemove(Name.self) { world, _, name in","    world.resources[NameDirectory.self].entities[name.value] = nil","}","","let villain = world.spawn(Name(value: \"Villain\"))","world.despawn(villain)","print(world.resources[NameDirectory.self].entities.isEmpty)","\/\/ Prints \"true\""]},{"type":"aside","name":"Complexity","style":"note","content":[{"type":"paragraph","inlineContent":[{"text":"O(1) amortized.","type":"text"}]}]}],"kind":"content"}],"abstract":[{"text":"Registers a closure to run whenever an entity loses a component of the given type.",