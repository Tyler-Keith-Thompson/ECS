{"hierarchy":{"paths":[["doc:\/\/WorldModule\/documentation\/WorldModule","doc:\/\/WorldModule\/documentation\/WorldModule\/World"]]},"primaryContentSections":[{"declarations":[{"tokens":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"query","kind":"identifier"},{"text":"<each ","kind":"text"},{"text":"T","kind":"genericParameter"},{"text":">(","kind":"text"},{"text":"_","kind":"externalParam"},{"text":" ","kind":"text"},{"text":"query","kind":"internalParam"},{"text":": ","kind":"text"},{"text":"Query","preciseIdentifier":"s:11WorldModule5QueryV","identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/Query","kind":"typeIdentifier"},{"text":"<repeat each ","kind":"text"},{"text":"T","kind":"typeIdentifier"},{"text":">) -> ","kind":"text"},{"text":"QueryView","preciseIdentifier":"s:11WorldModule9QueryViewV","identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/QueryView","kind":"typeIdentifier"},{"text":"<repeat (each ","kind":"text"},{"text":"T","kind":"typeIdentifier"},{"text":").","kind":"text"},{"text":"Value","preciseIdentifier":"s:11WorldModule9QueryTermP5ValueQa","identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/QueryTerm\/Value","kind":"typeIdentifier"},{"text":"> ","kind":"text"},{"text":"where","kind":"keyword"},{"text":" repeat each ","kind":"text"},{"text":"T","kind":"typeIdentifier"},{"text":" : ","kind":"text"},{"text":"QueryTerm","preciseIdentifier":"s:11WorldModule9QueryTermP","identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/QueryTerm","kind":"typeIdentifier"}],"platforms":["Linux"],"languages":["swift"]}],"kind":"declarations"},{"parameters":[{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The entities to visit and the components to read."}]}],"name":"query"}],"kind":"parameters"},{"content":[{"text":"Return Value","level":2,"anchor":"return-value","type":"heading"},{"inlineContent":[{"text":"A view of the matching rows, as of this moment.","type":"text"}],"type":"paragraph"}],"kind":"content"},{"content":[{"type":"heading","level":2,"text":"Discussion","anchor":"discussion"},{"type":"paragraph","inlineContent":[{"text":"Each row is a tuple of the entity, labeled ","type":"text"},{"code":"entity","type":"codeVoice"},{"text":", followed by one value per term: the","type":"text"},{"text":" ","type":"text"},{"text":"component for a component term, and a tuple of optionals for an ","type":"text"},{"identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/AnyOf","isActive":true,"type":"reference"},{"text":" term. The","type":"text"},{"text":" ","type":"text"},{"text":"following example reads the name of every entity pushed by wind, thrust or both, with the","type":"text"},{"text":" ","type":"text"},{"text":"forces it feels:","type":"text"}]},{"type":"codeListing","syntax":"swift","code":["var world = World()","world.spawn(Name(value: \"kite\"), Wind(force: 3))","world.spawn(Name(value: \"rocket\"), Thrust(force: 5))","world.spawn(Name(value: \"rock\"))","","var forces: [String] = []","for (_, name, (wind, thrust)) in world.query(Query(Name.self, AnyOf<Wind, Thrust>.self)) {","    forces.append(\"\\(name.value): \\((wind?.force ?? 0) + (thrust?.force ?? 0))\")","}","print(forces)","\/\/ Prints \"[\"kite: 3.0\", \"rocket: 5.0\"]\""]},{"type":"paragraph","inlineContent":[{"text":"The rock holds neither a wind nor a thrust, so it doesn’t match the ","type":"text"},{"type":"reference","identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/AnyOf","isActive":true},{"text":" term.","type":"text"}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"The view is lazy: it finds the matching entities as you iterate it."}]},{"type":"aside","content":[{"inlineContent":[{"type":"text","text":"O("},{"inlineContent":[{"type":"text","text":"t"}],"type":"emphasis"},{"type":"text","text":") for "},{"inlineContent":[{"text":"t","type":"text"}],"type":"emphasis"},{"type":"text","text":" terms to create. Iterating is O("},{"inli