moment."}],"type":"paragraph"}],"kind":"content"},{"content":[{"text":"Discussion","level":2,"type":"heading","anchor":"discussion"},{"inlineContent":[{"text":"Each row is a tuple of the entity, labeled ","type":"text"},{"code":"entity","type":"codeVoice"},{"text":", followed by one value per term: the","type":"text"},{"text":" ","type":"text"},{"text":"component for a component term, and a tuple of optionals for an ","type":"text"},{"identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/AnyOf","type":"reference","isActive":true},{"text":" term. The","type":"text"},{"text":" ","type":"text"},{"text":"following example reads the name of every entity pushed by wind, thrust or both, with the","type":"text"},{"text":" ","type":"text"},{"text":"forces it feels:","type":"text"}],"type":"paragraph"},{"syntax":"swift","code":["var world = World()","world.spawn(Name(value: \"kite\"), Wind(force: 3))","world.spawn(Name(value: \"rocket\"), Thrust(force: 5))","world.spawn(Name(value: \"rock\"))","","var forces: [String] = []","for (_, name, (wind, thrust)) in world.query(Query(Name.self, AnyOf<Wind, Thrust>.self)) {","    forces.append(\"\\(name.value): \\((wind?.force ?? 0) + (thrust?.force ?? 0))\")","}","print(forces)","\/\/ Prints \"[\"kite: 3.0\", \"rocket: 5.0\"]\""],"type":"codeListing"},{"inlineContent":[{"type":"text","text":"The rock holds neither a wind nor a thrust, so it doesn’t match the "},{"type":"reference","isActive":true,"identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/AnyOf"},{"type":"text","text":" term."}],"type":"paragraph"},{"inlineContent":[{"text":"The view is lazy: it finds the matching entities as you iterate it.","type":"text"}],"type":"paragraph"},{"style":"note","content":[{"inlineContent":[{"type":"text","text":"O("},{"type":"emphasis","inlineContent":[{"type":"text","text":"t"}]},{"type":"text","text":") for "},{"type":"emphasis","inlineContent":[{"type":"text","text":"t"}]},{"type":"text","text":" terms to create. Iterating is O("},{"type":"emphasis","inlineContent":[{"text":"n","type":"text"}]},{"type":"text","text":") for "},{"type":"emphasis","inlineContent":[{"type":"text","text":"n"}]},{"type":"text","text":" entities in the"},{"type":"text","text":" "},{"type":"text","text":"smallest component term or required type, or every entity when there’s none."}],"type":"paragraph"}],"name":"Complexity","type":"aside"}],"kind":"content"}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/worldmodule\/world\/query(_:)-4yi98"]}],"sections":[],"identifier":{"url":"doc:\/\/WorldModule\/documentation\/WorldModule\/World\/query(_:)-4yi98","interfaceLanguage":"swift"},"metadata":{"title":"query(_:)","extendedModule":"WorldModule","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"query","kind":"identifier"},{"text":"<each ","kind":"text"},{"text":"T","kind":"genericParameter"},{"text":">(","kind":"text"},{"text":"Query","preciseIdentifier":"s:11WorldModule5QueryV","kind":"typeIdentifier"},{"text":"<repeat each ","kind":"text"},{"text":"T","kind":"typeIdentifier"},{"text":">) -> ","kind":"text"},{"text":"QueryView","preciseIdentifier":"s:11WorldModule9QueryViewV","kind":"typeIdentifier"},{"text":"<repeat (each ","kind":"text"},{"text":"T","kind":"typeIdentifier"},{"text":").","kind":"text"},{"text":"Value","preciseIdentifier":"s:11WorldModule9QueryTermP5ValueQa","kind":"typeIdentifier"},{"text":">","kind":"text"}],"modules":[{"name":"WorldModule"}],"symbolKind":"method","roleHeading":"Instance Method","externalID":"s:11WorldModule0A0V5queryyAA9QueryViewVy5ValueQzxQp_QPGAA0D0VyxxQp_QPGRvzAA0D4TermRzlF","role":"symbol","remoteSource":{"fileName":"Query.swift","url":"https:\/\/github.com\/Tyler-Keith-Thompson\/ECS\/blob\/main\/Sources\/WorldModule\/Query.swift#L421"}},"abstract":[{"text":"Returns the entities that match a query, with the values of its terms.","type":"text"}],"seeAlsoSections":[{"identifiers":["doc:\/\/WorldModule\/docume