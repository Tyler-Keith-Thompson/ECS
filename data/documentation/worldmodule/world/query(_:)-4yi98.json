"text":"Discussion","type":"heading","level":2},{"inlineContent":[{"type":"text","text":"Each row is a tuple of the entity, labeled "},{"code":"entity","type":"codeVoice"},{"type":"text","text":", followed by one value per term: the"},{"type":"text","text":" "},{"type":"text","text":"component for a component term, and a tuple of optionals for an "},{"identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/AnyOf","isActive":true,"type":"reference"},{"type":"text","text":" term. The"},{"type":"text","text":" "},{"type":"text","text":"following example reads the name of every entity pushed by wind, thrust or both, with the"},{"type":"text","text":" "},{"type":"text","text":"forces it feels:"}],"type":"paragraph"},{"code":["var world = World()","world.spawn(Name(value: \"kite\"), Wind(force: 3))","world.spawn(Name(value: \"rocket\"), Thrust(force: 5))","world.spawn(Name(value: \"rock\"))","","var forces: [String] = []","for (_, name, (wind, thrust)) in world.query(Query(Name.self, AnyOf<Wind, Thrust>.self)) {","    forces.append(\"\\(name.value): \\((wind?.force ?? 0) + (thrust?.force ?? 0))\")","}","print(forces)","\/\/ Prints \"[\"kite: 3.0\", \"rocket: 5.0\"]\""],"syntax":"swift","type":"codeListing"},{"inlineContent":[{"text":"The rock holds neither a wind nor a thrust, so it doesn’t match the ","type":"text"},{"identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/AnyOf","isActive":true,"type":"reference"},{"text":" term.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"The view is lazy: it finds the matching entities as you iterate it."}],"type":"paragraph"},{"style":"note","name":"Complexity","type":"aside","content":[{"inlineContent":[{"type":"text","text":"O("},{"inlineContent":[{"text":"t","type":"text"}],"type":"emphasis"},{"type":"text","text":") for "},{"inlineContent":[{"type":"text","text":"t"}],"type":"emphasis"},{"type":"text","text":" terms to create. Iterating is O("},{"inlineContent":[{"text":"n","type":"text"}],"type":"emphasis"},{"type":"text","text":") for "},{"inlineContent":[{"text":"n","type":"text"}],"type":"emphasis"},{"type":"text","text":" entities in the"},{"type":"text","text":" "},{"type":"text","text":"smallest component term or required type, or every entity when there’s none."}],"type":"paragraph"}]}]}],"hierarchy":{"paths":[["doc:\/\/WorldModule\/documentation\/WorldModule","doc:\/\/WorldModule\/documentation\/WorldModule\/World"]]},"references":{"doc://WorldModule/documentation/WorldModule/AnyOf":{"navigatorTitle":[{"text":"AnyOf","kind":"identifier"}],"kind":"symbol","role":"symbol","type":"topic","url":"\/documentation\/worldmodule\/anyof","title":"AnyOf","identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/AnyOf","abstract":[{"text":"A group of types an entity matches by matching at least one of them.","type":"text"}],"fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"AnyOf","kind":"identifier"}]},"doc://WorldModule/documentation/WorldModule":{"abstract":[{"type":"text","text":"Store the state of a game or simulation as entities and components, and read and change it with"},{"type":"text","text":" "},{"type":"text","text":"queries, updates, and commands."}],"role":"collection","title":"WorldModule","kind":"symbol","identifier":"doc:\/\/WorldModule\/documentation\/WorldModule","url":"\/documentation\/worldmodule","type":"topic"},"doc://WorldModule/documentation/WorldModule/World/query(_:_:_:)":{"url":"\/documentation\/worldmodule\/world\/query(_:_:_:)","role":"symbol","identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/World\/query(_:_:_:)","kind":"symbol","abstract":[{"type":"text","text":"Returns the entities that hold components of all three given types, with those components."}],"fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"query"},{"kind":"text","text":"<"},{"kind":"genericParameter","text":"A"},{"kind":"text","text":", "},{"kind":"gen