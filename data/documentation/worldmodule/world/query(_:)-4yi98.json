","text":"A view of the matching rows, as of this moment."}]}],"kind":"content"},{"content":[{"anchor":"discussion","level":2,"text":"Discussion","type":"heading"},{"inlineContent":[{"text":"Each row is a tuple of the entity, labeled ","type":"text"},{"code":"entity","type":"codeVoice"},{"text":", followed by one value per term: the","type":"text"},{"text":" ","type":"text"},{"text":"component for a component term, and a tuple of optionals for an ","type":"text"},{"identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/AnyOf","isActive":true,"type":"reference"},{"text":" term. The","type":"text"},{"text":" ","type":"text"},{"text":"following example reads the name of every entity pushed by wind, thrust or both, with the","type":"text"},{"text":" ","type":"text"},{"text":"forces it feels:","type":"text"}],"type":"paragraph"},{"code":["var world = World()","world.spawn(Name(value: \"kite\"), Wind(force: 3))","world.spawn(Name(value: \"rocket\"), Thrust(force: 5))","world.spawn(Name(value: \"rock\"))","","var forces: [String] = []","for (_, name, (wind, thrust)) in world.query(Query(Name.self, AnyOf<Wind, Thrust>.self)) {","    forces.append(\"\\(name.value): \\((wind?.force ?? 0) + (thrust?.force ?? 0))\")","}","print(forces)","\/\/ Prints \"[\"kite: 3.0\", \"rocket: 5.0\"]\""],"syntax":"swift","type":"codeListing"},{"inlineContent":[{"text":"The rock holds neither a wind nor a thrust, so it doesn’t match the ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/AnyOf"},{"text":" term.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"The view is lazy: it finds the matching entities as you iterate it.","type":"text"}],"type":"paragraph"},{"name":"Complexity","style":"note","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"O("},{"inlineContent":[{"text":"t","type":"text"}],"type":"emphasis"},{"type":"text","text":") for "},{"inlineContent":[{"text":"t","type":"text"}],"type":"emphasis"},{"type":"text","text":" terms to create. Iterating is O("},{"inlineContent":[{"type":"text","text":"n"}],"type":"emphasis"},{"type":"text","text":") for "},{"inlineContent":[{"type":"text","text":"n"}],"type":"emphasis"},{"type":"text","text":" entities in the"},{"type":"text","text":" "},{"type":"text","text":"smallest component term or required type, or every entity when there’s none."}]}],"type":"aside"}],"kind":"content"}],"references":{"doc://WorldModule/documentation/WorldModule/QueryTerm/Value":{"kind":"symbol","identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/QueryTerm\/Value","title":"Value","abstract":[{"type":"text","text":"The value a query’s row holds for this term."}],"type":"topic","url":"\/documentation\/worldmodule\/queryterm\/value","fragments":[{"kind":"keyword","text":"associatedtype"},{"kind":"text","text":" "},{"kind":"identifier","text":"Value"}],"role":"symbol","required":true},"doc://WorldModule/documentation/WorldModule/QueryTerm":{"role":"symbol","title":"QueryTerm","identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/QueryTerm","kind":"symbol","url":"\/documentation\/worldmodule\/queryterm","fragments":[{"kind":"keyword","text":"protocol"},{"kind":"text","text":" "},{"kind":"identifier","text":"QueryTerm"}],"navigatorTitle":[{"kind":"identifier","text":"QueryTerm"}],"type":"topic","abstract":[{"type":"text","text":"A type that can be a term of a query, deciding which entities match and what the query reads"},{"type":"text","text":" "},{"type":"text","text":"from each."}]},"doc://WorldModule/documentation/WorldModule/AnyOf":{"abstract":[{"type":"text","text":"A group of types an entity matches by matching at least one of them."}],"kind":"symbol","role":"symbol","title":"AnyOf","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"AnyOf"}],"url":"\/documentation\/worldmodule\/anyof","identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/Any