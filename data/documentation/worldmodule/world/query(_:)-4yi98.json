"},{"content":[{"level":2,"anchor":"discussion","text":"Discussion","type":"heading"},{"inlineContent":[{"type":"text","text":"Each row is a tuple of the entity, labeled "},{"type":"codeVoice","code":"entity"},{"type":"text","text":", followed by one value per term: the"},{"type":"text","text":" "},{"type":"text","text":"component for a component term, and a tuple of optionals for an "},{"identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/AnyOf","type":"reference","isActive":true},{"type":"text","text":" term. The"},{"type":"text","text":" "},{"type":"text","text":"following example reads the name of every entity pushed by wind, thrust or both, with the"},{"type":"text","text":" "},{"type":"text","text":"forces it feels:"}],"type":"paragraph"},{"syntax":"swift","type":"codeListing","code":["var world = World()","world.spawn(Name(value: \"kite\"), Wind(force: 3))","world.spawn(Name(value: \"rocket\"), Thrust(force: 5))","world.spawn(Name(value: \"rock\"))","","var forces: [String] = []","for (_, name, (wind, thrust)) in world.query(Query(Name.self, AnyOf<Wind, Thrust>.self)) {","    forces.append(\"\\(name.value): \\((wind?.force ?? 0) + (thrust?.force ?? 0))\")","}","print(forces)","\/\/ Prints \"[\"kite: 3.0\", \"rocket: 5.0\"]\""]},{"inlineContent":[{"text":"The rock holds neither a wind nor a thrust, so it doesn’t match the ","type":"text"},{"type":"reference","isActive":true,"identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/AnyOf"},{"text":" term.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"The view is lazy: it finds the matching entities as you iterate it."}],"type":"paragraph"},{"content":[{"inlineContent":[{"type":"text","text":"O("},{"type":"emphasis","inlineContent":[{"text":"t","type":"text"}]},{"type":"text","text":") for "},{"type":"emphasis","inlineContent":[{"type":"text","text":"t"}]},{"type":"text","text":" terms to create. Iterating is O("},{"type":"emphasis","inlineContent":[{"type":"text","text":"n"}]},{"type":"text","text":") for "},{"type":"emphasis","inlineContent":[{"text":"n","type":"text"}]},{"type":"text","text":" entities in the"},{"type":"text","text":" "},{"type":"text","text":"smallest component term or required type, or every entity when there’s none."}],"type":"paragraph"}],"name":"Complexity","type":"aside","style":"note"}],"kind":"content"}],"sections":[],"schemaVersion":{"patch":0,"minor":3,"major":0},"kind":"symbol","references":{"doc://WorldModule/documentation/WorldModule/World":{"type":"topic","navigatorTitle":[{"text":"World","kind":"identifier"}],"url":"\/documentation\/worldmodule\/world","title":"World","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"World","kind":"identifier"}],"identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/World","kind":"symbol","role":"symbol","abstract":[{"text":"A collection of entities, the components they hold, and resources.","type":"text"}]},"doc://WorldModule/documentation/WorldModule/World/query(_:)-zacg":{"role":"symbol","type":"topic","abstract":[{"type":"text","text":"Returns the entities that hold a component of the given type, with that component."}],"identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/World\/query(_:)-zacg","url":"\/documentation\/worldmodule\/world\/query(_:)-zacg","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"query","kind":"identifier"},{"text":"<","kind":"text"},{"text":"A","kind":"genericParameter"},{"text":">(","kind":"text"},{"text":"A","kind":"typeIdentifier"},{"text":".Type) -> ","kind":"text"},{"text":"QueryView","preciseIdentifier":"s:11WorldModule9QueryViewV","kind":"typeIdentifier"},{"text":"<","kind":"text"},{"text":"A","kind":"typeIdentifier"},{"text":">","kind":"text"}],"kind":"symbol","title":"query(_:)"},"doc://WorldModule/documentation/WorldModule/Query":{"role":"symbol","type":"topic","abstract":[{"type":"text","text":"A description of the entities to visit and t