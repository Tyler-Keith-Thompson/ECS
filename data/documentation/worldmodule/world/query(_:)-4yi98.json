tions":[],"identifier":{"url":"doc:\/\/WorldModule\/documentation\/WorldModule\/World\/query(_:)-4yi98","interfaceLanguage":"swift"},"primaryContentSections":[{"declarations":[{"tokens":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"query"},{"kind":"text","text":"<each "},{"kind":"genericParameter","text":"T"},{"kind":"text","text":">("},{"kind":"externalParam","text":"_"},{"kind":"text","text":" "},{"kind":"internalParam","text":"query"},{"kind":"text","text":": "},{"identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/Query","kind":"typeIdentifier","text":"Query","preciseIdentifier":"s:11WorldModule5QueryV"},{"kind":"text","text":"<repeat each "},{"kind":"typeIdentifier","text":"T"},{"kind":"text","text":">) -> "},{"identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/QueryView","kind":"typeIdentifier","text":"QueryView","preciseIdentifier":"s:11WorldModule9QueryViewV"},{"kind":"text","text":"<repeat (each "},{"kind":"typeIdentifier","text":"T"},{"kind":"text","text":")."},{"identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/QueryTerm\/Value","kind":"typeIdentifier","text":"Value","preciseIdentifier":"s:11WorldModule9QueryTermP5ValueQa"},{"kind":"text","text":"> "},{"kind":"keyword","text":"where"},{"kind":"text","text":" repeat each "},{"kind":"typeIdentifier","text":"T"},{"kind":"text","text":" : "},{"identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/QueryTerm","kind":"typeIdentifier","text":"QueryTerm","preciseIdentifier":"s:11WorldModule9QueryTermP"}],"platforms":["Linux"],"languages":["swift"]}],"kind":"declarations"},{"kind":"parameters","parameters":[{"name":"query","content":[{"inlineContent":[{"type":"text","text":"The entities to visit and the components to read."}],"type":"paragraph"}]}]},{"kind":"content","content":[{"type":"heading","text":"Return Value","anchor":"return-value","level":2},{"type":"paragraph","inlineContent":[{"type":"text","text":"A view of the matching rows, as of this moment."}]}]},{"kind":"content","content":[{"text":"Discussion","level":2,"anchor":"discussion","type":"heading"},{"inlineContent":[{"type":"text","text":"Each row is a tuple of the entity, labeled "},{"type":"codeVoice","code":"entity"},{"type":"text","text":", followed by one value per term: the"},{"type":"text","text":" "},{"type":"text","text":"component for a component term, and a tuple of optionals for an "},{"identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/AnyOf","type":"reference","isActive":true},{"type":"text","text":" term. The"},{"type":"text","text":" "},{"type":"text","text":"following example reads the name of every entity pushed by wind, thrust or both, with the"},{"type":"text","text":" "},{"type":"text","text":"forces it feels:"}],"type":"paragraph"},{"code":["var world = World()","world.spawn(Name(value: \"kite\"), Wind(force: 3))","world.spawn(Name(value: \"rocket\"), Thrust(force: 5))","world.spawn(Name(value: \"rock\"))","","var forces: [String] = []","for (_, name, (wind, thrust)) in world.query(Query(Name.self, AnyOf<Wind, Thrust>.self)) {","    forces.append(\"\\(name.value): \\((wind?.force ?? 0) + (thrust?.force ?? 0))\")","}","print(forces)","\/\/ Prints \"[\"kite: 3.0\", \"rocket: 5.0\"]\""],"syntax":"swift","type":"codeListing"},{"inlineContent":[{"type":"text","text":"The rock holds neither a wind nor a thrust, so it doesn’t match the "},{"type":"reference","isActive":true,"identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/AnyOf"},{"type":"text","text":" term."}],"type":"paragraph"},{"inlineContent":[{"text":"The view is lazy: it finds the matching entities as you iterate it.","type":"text"}],"type":"paragraph"},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"O("},{"inlineContent":[{"text":"t","type":"text"}],"type":"emphasis"},{"type":"text","text":") for "},{"inlineContent":[{"type":"text","text":"t"}],"type":"emphasis"},{"type":"text","text":" terms to create. Iterating is O("},{"inlineContent":[{"text":"n","type":"text"}],"type":"emphasis"},{"type":"text","text":") for "},{"inlineContent":[{"type":"text","text":"n"}],"type":"emphasis"},{"type":"text","text":" entities in the"},{"type":"text","text":" "},{"type":"text","text":"smallest component term or required type, or every entity when there’s none."}]}],"style":"note","name":"Complexity","type":"aside"}]}],"schemaVersion":{"major":0,"patch":0,"minor":3},"references":{"doc://WorldModule/documentation/WorldModule/World/query(_:)-4yi98":{"identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/World\/query(_:)-4yi98","kind":"symbol","abstract":[{"text":"Returns the entities that match a query, with the values of its terms.","type":"text"}],"url":"\/documentation\/worldmodule\/world\/query(_:)-4yi98","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"query"},{"kind":"text","text":"<each "},{"kind":"genericParameter","text":"T"},{"kind":"text","text":">("},{"kind":"typeIdentifier","text":"Query","preciseIdentifier":"s:11WorldModule5QueryV"},{"kind":"text","text":"<repeat each "},{"kind":"typeIdentifier","text":"T"},{"kind":"text","text":">) -> "},{"kind":"typeIdentifier","text":"QueryView","preciseIdentifier":"s:11WorldModule9QueryViewV"},{"kind":"text","text":"<repeat (each "},{"kind":"typeIdentifier","text":"T"},{"kind":"text","text":")."},{"kind":"typeIdentifier","text":"Value","preciseIdentifier":"s:11WorldModule9QueryTermP5ValueQa"},{"kind":"text","text":">"}],"type":"topic","role":"symbol","title":"query(_:)"},"doc://WorldModule/documentation/WorldModule/World/query(_:)-3e8od":{"identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/World\/query(_:)-3e8od","kind":"symbol","abstract":[{"text":"Returns the entities that hold every one of the given component types, with those","type":"text"},{"text":" ","type":"text"},{"text":"components.","type":"text"}],"url":"\/documentation\/worldmodule\/world\/query(_:)-3e