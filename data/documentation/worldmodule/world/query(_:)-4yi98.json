":"paragraph"}]},{"kind":"content","content":[{"level":2,"type":"heading","text":"Discussion","anchor":"discussion"},{"type":"paragraph","inlineContent":[{"text":"Each row is a tuple of the entity, labeled ","type":"text"},{"code":"entity","type":"codeVoice"},{"text":", followed by one value per term: the","type":"text"},{"text":" ","type":"text"},{"text":"component for a component term, and a tuple of optionals for an ","type":"text"},{"isActive":true,"identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/AnyOf","type":"reference"},{"text":" term. The","type":"text"},{"text":" ","type":"text"},{"text":"following example reads the name of every entity pushed by wind, thrust or both, with the","type":"text"},{"text":" ","type":"text"},{"text":"forces it feels:","type":"text"}]},{"syntax":"swift","type":"codeListing","code":["var world = World()","world.spawn(Name(value: \"kite\"), Wind(force: 3))","world.spawn(Name(value: \"rocket\"), Thrust(force: 5))","world.spawn(Name(value: \"rock\"))","","var forces: [String] = []","for (_, name, (wind, thrust)) in world.query(Query(Name.self, AnyOf<Wind, Thrust>.self)) {","    forces.append(\"\\(name.value): \\((wind?.force ?? 0) + (thrust?.force ?? 0))\")","}","print(forces)","\/\/ Prints \"[\"kite: 3.0\", \"rocket: 5.0\"]\""]},{"type":"paragraph","inlineContent":[{"type":"text","text":"The rock holds neither a wind nor a thrust, so it doesn’t match the "},{"identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/AnyOf","type":"reference","isActive":true},{"type":"text","text":" term."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"The view is lazy: it finds the matching entities as you iterate it."}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"O(","type":"text"},{"type":"emphasis","inlineContent":[{"type":"text","text":"t"}]},{"text":") for ","type":"text"},{"type":"emphasis","inlineContent":[{"text":"t","type":"text"}]},{"text":" terms to create. Iterating is O(","type":"text"},{"