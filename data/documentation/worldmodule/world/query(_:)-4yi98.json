","text":"A view of the matching rows, as of this moment."}]}],"kind":"content"},{"content":[{"type":"heading","anchor":"discussion","level":2,"text":"Discussion"},{"type":"paragraph","inlineContent":[{"text":"Each row is a tuple of the entity, labeled ","type":"text"},{"code":"entity","type":"codeVoice"},{"text":", followed by one value per term: the","type":"text"},{"text":" ","type":"text"},{"text":"component for a component term, and a tuple of optionals for an ","type":"text"},{"isActive":true,"identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/AnyOf","type":"reference"},{"text":" term. The","type":"text"},{"text":" ","type":"text"},{"text":"following example reads the name of every entity pushed by wind, thrust or both, with the","type":"text"},{"text":" ","type":"text"},{"text":"forces it feels:","type":"text"}]},{"type":"codeListing","code":["var world = World()","world.spawn(Name(value: \"kite\"), Wind(force: 3))","world.spawn(Name(value: \"rocket\"), Thrust(force: 5))","world.spawn(Name(value: \"rock\"))","","var forces: [String] = []","for (_, name, (wind, thrust)) in world.query(Query(Name.self, AnyOf<Wind, Thrust>.self)) {","    forces.append(\"\\(name.value): \\((wind?.force ?? 0) + (thrust?.force ?? 0))\")","}","print(forces)","\/\/ Prints \"[\"kite: 3.0\", \"rocket: 5.0\"]\""],"syntax":"swift"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The rock holds neither a wind nor a thrust, so it doesn’t match the "},{"identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/AnyOf","isActive":true,"type":"reference"},{"type":"text","text":" term."}]},{"type":"paragraph","inlineContent":[{"text":"The view is lazy: it finds the matching entities as you iterate it.","type":"text"}]},{"type":"aside","name":"Complexity","style":"note","content":[{"inlineContent":[{"type":"text","text":"O("},{"type":"emphasis","inlineContent":[{"text":"t","type":"text"}]},{"type":"text","text":") for "},{"type":"emphasis","inlineContent":[{"type":"text","text":"t"}]},{"type":"text","text":" terms to create. Iterating is O("},{"type":"emphasis","inlineContent":[{"type":"text","text":"n"}]},{"type":"text","text":") for "},{"type":"emphasis","inlineContent":[{"text":"n","type":"text"}]},{"type":"text","text":" entities in the"},{"type":"text","text":" "},{"type":"text","text":"smallest component term or required type, or every entity when there’s none."}],"type":"paragraph"}]}],"kind":"content"}],"references":{"doc://WorldModule/documentation/WorldModule/Query":{"kind":"symbol","title":"Query","identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/Query","url":"\/documentation\/worldmodule\/query","abstract":[{"text":"A description of the entities to visit and the components to read from each.","type":"text"}],"type":"topic","role":"symbol","navigatorTitle":[{"kind":"identifier","text":"Query"}],"fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"Query"}]},"doc://WorldModule/documentation/WorldModule/World/query(_:)-zacg":{"url":"\/documentation\/worldmodule\/world\/query(_:)-zacg","title":"query(_:)","abstract":[{"type":"text","text":"Returns the entities that hold a component of the given type, with that component."}],"role":"symbol","kind":"symbol","identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/World\/query(_:)-zacg","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"query","kind":"identifier"},{"text":"<","kind":"text"},{"text":"A","kind":"genericParameter"},{"text":">(","kind":"text"},{"text":"A","kind":"typeIdentifier"},{"text":".Type) -> ","kind":"text"},{"text":"QueryView","preciseIdentifier":"s:11WorldModule9QueryViewV","kind":"typeIdentifier"},{"text":"<","kind":"text"},{"text":"A","kind":"typeIdentifier"},{"text":">","kind":"text"}],"type":"topic"},"doc://WorldModule/documentation/WorldModule/AnyOf":{"title":"AnyOf","url":"\/documentation\/worldmodule\/anyof","abstract":[{"text":"A group of types an