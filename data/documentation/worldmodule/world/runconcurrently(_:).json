{"identifier":{"url":"doc:\/\/WorldModule\/documentation\/WorldModule\/World\/runConcurrently(_:)","interfaceLanguage":"swift"},"metadata":{"role":"symbol","roleHeading":"Instance Method","remoteSource":{"fileName":"Concurrency.swift","url":"https:\/\/github.com\/Tyler-Keith-Thompson\/ECS\/blob\/main\/Sources\/WorldModule\/Concurrency.swift#L264"},"title":"runConcurrently(_:)","symbolKind":"method","modules":[{"name":"WorldModule"}],"extendedModule":"WorldModule","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"runConcurrently"},{"kind":"text","text":"(["},{"kind":"typeIdentifier","preciseIdentifier":"s:11WorldModule16ConcurrentChangeV","text":"ConcurrentChange"},{"kind":"text","text":"])"}],"externalID":"s:11WorldModule0A0V15runConcurrentlyyySayAA16ConcurrentChangeVGF"},"kind":"symbol","sections":[],"hierarchy":{"paths":[["doc:\/\/WorldModule\/documentation\/WorldModule","doc:\/\/WorldModule\/documentation\/WorldModule\/World"]]},"schemaVersion":{"minor":3,"patch":0,"major":0},"primaryContentSections":[{"kind":"declarations","declarations":[{"languages":["swift"],"tokens":[{"text":"mutating","kind":"keyword"},{"text":" ","kind":"text"},{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"runConcurrently","kind":"identifier"},{"text":"(","kind":"text"},{"text":"_","kind":"externalParam"},{"text":" ","kind":"text"},{"text":"changes","kind":"internalParam"},{"text":": [","kind":"text"},{"text":"ConcurrentChange","kind":"typeIdentifier","identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/ConcurrentChange","preciseIdentifier":"s:11WorldModule16ConcurrentChangeV"},{"text":"])","kind":"text"}],"platforms":["Linux"]}]},{"parameters":[{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The changes to run."}]}],"name":"changes"}],"kind":"parameters"},{"kind":"content","content":[{"text":"Discussion","anchor":"discussion","level":2,"type":"heading"},{"inlineContent":[{"text":"Use this method to spread independent work across the processor’s cores. Each change reads","type":"text"},{"text":" ","type":"text"},{"text":"the world as it was before any of them ran, and writes only the types its access lists, so","type":"text"},{"text":" ","type":"text"},{"text":"the result is the same as running the changes one after another in any order:","type":"text"}],"type":"paragraph"},{"syntax":"swift","code":["var world = World()","let ball = world.spawn(Position(x: 0, y: 0), Velocity(dx: 1, dy: 0), Health(current: 10))","","world.runConcurrently([","    ConcurrentChange(access: .reads(Velocity.self).writes(Position.self)) { world in","        world.update(Position.self, reading: Velocity.self) { position, row in","            position.x += row.components.dx","        }","    },","    ConcurrentChange(access: .writes(Health.self)) { world in","        world.update(Health.self) { health, _ in health.current -= 1 }","    },","])","","print(world[Position.self, of: ball].x, world[Health.self, of: ball].current)","\/\/ Prints \"1.0 9\""],"type":"codeListing"},{"inlineContent":[{"type":"text","text":"A change sees the components and resources that other changes write as missing, so its"},{"type":"text","text":" "},{"type":"text","text":"access must list everything it reads. Command buffers a change queues with "},{"isActive":true,"type":"reference","identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/World\/queue(_:)"},{"type":"text","text":" "},{"type":"text","text":"are queued in this world in the order of "},{"type":"codeVoice","code":"changes"},{"type":"text","text":"."}],"type":"paragraph"},{"name":"Important","content":[{"type":"paragraph","inlineContent":[{"text":"A change must write only the component and resource types its access lists,","type":"text"},{"text":" ","type":"text"},{"text":"and must not spawn or despawn entities. It writes relations through their ","type":"text"},{"identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/Targets","isActive":true,"type":"reference"},{"text":" ","type":"text"},{"text":"components, and the hierarchy through ","type":"text"},{"code":"Targets<ChildOf>","type":"codeVoice"},{"text":".","type":"text"}]}],"style":"important","type":"aside"},{"name":"Complexity","content":[{"type":"paragraph","inlineContent":[{"text":"O(","type":"text"},{"type":"emphasis","inlineContent":[{"type":"text","text":"c"}]},{"text":"·","type":"text"},{"type":"emphasis","inlineContent":[{"text":"t","type":"text"}]},{"text":"), besides the cost of the changes themselves, where ","type":"text"},{"type":"emphasis","inlineContent":[{"type":"text","text":"c"}]},{"text":" is the","type":"text"},{"text":" ","type":"text"},{"text":"number of changes and ","type":"text"},{"type":"emphasis","inlineContent":[{"type":"text","text":"t"}]},{"text":" is the number of component types the world has stored.","type":"text"}]}],"style":"note","type":"aside"},{"name":"Precondition","content":[{"type":"paragraph","inlineContent":[{"text":"No two accesses conflict, and each change writes only what its access","type":"text"},{"text":" ","type":"text"},{"text":"lists and spawns and despawns nothing; a change that breaks this traps. In debug builds,","type":"text"},{"text":" ","type":"text"},{"text":"a change that reads a component or resource type its access doesn’t list traps too. Any","type":"text"},{"text":" ","type":"text"},{"text":"change may read ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/Disabled"},{"text":" and ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/Prefab"},{"text":".","type":"text"}]}],"style":"note","type":"aside"}]}],"abstract":[{"text":"Runs changes at the same time, each on its own copy of the world, and keeps what each one","type":"text"},{"text":" ","type":"text"},{"text":"wrote.","type":"text"}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/worldmodule\/world\/runconcurrently(_:)"]}],"references":{"doc://WorldModule/documentation/WorldModule":{"kind":"symbol","identifier":"doc:\/\/WorldModule\/documentation\/WorldModule","role":"collection","title":"WorldModule","type":"topic","abstract":[{"text":"Store the state of a game or simulation as entities and components, and read and change it with","type":"text"},{"text":" ","type":"text"},{"text":"queries, updates, and commands.","type":"text"}],"url":"\/documentation\/worldmodule"},"doc://WorldModule/documentation/WorldModule/Prefab":{"type":"topic","title":"Prefab","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Prefab","kind":"identifier"}],"navigatorTitle":[{"text":"Prefab","kind":"identifier"}],"kind":"symbol","url":"\/documentation\/worldmodule\/prefab","identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/Prefab","role":"symbol","abstract":[{"text":"A component that marks an entity as a template for spawning copies.","type":"text"}]},"doc://WorldModule/documentation/WorldModule/Targets":{"kind":"symbol","identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/Targets","role":"symbol","navigatorTitle":[{"kind":"identifier","text":"Targets"}],"title":"Targets","type":"topic","abstract":[{"type":"text","text":"The component that holds a source entity’s targets of a relation, with the relation’s value"},{"type":"text","text":" "},{"type":"text","text":"for each."}],"fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"Targets"}],"url":"\/documentation\/worldmodule\/targets"},"doc://WorldModule/documentation/WorldModule/World/applyQueuedCommands()":{"type":"topic","title":"applyQueuedCommands()","kind":"symbol","role":"symbol","url":"\/documentation\/worldmodule\/world\/applyqueuedcommands()","identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/World\/applyQueuedCommands()","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"applyQueuedCommands"},{"kind":"text","text":"() -> ["},{"preciseIdentifier":"s:11WorldModule6EntityV","kind":"typeIdentifier","text":"Entity"},{"kind":"text","text":"]"}],"abstract":[{"type":"text","text":"Applies every queued command buffer, in the order the buffers were queued, and empties the"},{"type":"text","text":" "},{"type":"text","text":"queue."}]},"doc://WorldModule/documentation/WorldModule/World/queue(_:)":{"kind":"symbol","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"queue","kind":"identifier"},{"text":"(","kind":"text"},{"text":"Commands","kind":"typeIdentifier","preciseIdentifier":"s:11WorldModule8CommandsV"},{"text":")","kind":"text"}],"type":"topic","url":"\/documentation\/worldmodule\/world\/queue(_:)","abstract":[{"type":"text","text":"Adds a command buffer to the world’s queue, to apply later with"},{"type":"text","text":" "},{"identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/World\/applyQueuedCommands()","isActive":true,"type":"reference"},{"type":"text","text":"."}],"identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/World\/queue(_:)","role":"symbol","title":"queue(_:)"},"doc://WorldModule/documentation/WorldModule/ConcurrentChange":{"kind":"symbol","identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/ConcurrentChange","role":"symbol","navigatorTitle":[{"kind":"identifier","text":"ConcurrentChange"}],"title":"ConcurrentChange","type":"topic","abstract":[{"type":"text","text":"A change to a world, paired with the access that describes what it reads and writes."}],"fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"ConcurrentChange"}],"url":"\/documentation\/worldmodule\/concurrentchange"},"doc://WorldModule/documentation/WorldModule/Disabled":{"kind":"symbol","identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/Disabled","role":"symbol","navigatorTitle":[