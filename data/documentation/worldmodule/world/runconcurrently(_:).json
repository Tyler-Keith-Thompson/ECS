ation\/worldmodule\/prefab","identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/Prefab","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Prefab","kind":"identifier"}],"title":"Prefab"},"doc://WorldModule/documentation/WorldModule/Targets":{"navigatorTitle":[{"kind":"identifier","text":"Targets"}],"kind":"symbol","role":"symbol","url":"\/documentation\/worldmodule\/targets","type":"topic","title":"Targets","identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/Targets","abstract":[{"type":"text","text":"The component that holds a source entity’s targets of a relation, with the relation’s value"},{"type":"text","text":" "},{"type":"text","text":"for each."}],"fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"Targets"}]},"doc://WorldModule/documentation/WorldModule/World/queue(_:)":{"abstract":[{"type":"text","text":"Adds a command buffer to the world’s queue, to apply later with"},{"type":"text","text":" "},{"type":"reference","identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/World\/applyQueuedCommands()","isActive":true},{"type":"text","text":"."}],"url":"\/documentation\/worldmodule\/world\/queue(_:)","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"queue"},{"text":"(","kind":"text"},{"text":"Commands","preciseIdentifier":"s:11WorldModule8CommandsV","kind":"typeIdentifier"},{"text":")","kind":"text"}],"role":"symbol","type":"topic","kind":"symbol","identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/World\/queue(_:)","title":"queue(_:)"}}}