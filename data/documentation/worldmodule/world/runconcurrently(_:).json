{"sections":[],"abstract":[{"type":"text","text":"Runs changes at the same time, each on its own copy of the world, and keeps what each one"},{"type":"text","text":" "},{"type":"text","text":"wrote."}],"metadata":{"title":"runConcurrently(_:)","extendedModule":"WorldModule","roleHeading":"Instance Method","externalID":"s:11WorldModule0A0V15runConcurrentlyyySayAA16ConcurrentChangeVGF","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"runConcurrently","kind":"identifier"},{"text":"([","kind":"text"},{"text":"ConcurrentChange","kind":"typeIdentifier","preciseIdentifier":"s:11WorldModule16ConcurrentChangeV"},{"text":"])","kind":"text"}],"remoteSource":{"url":"https:\/\/github.com\/Tyler-Keith-Thompson\/ECS\/blob\/main\/Sources\/WorldModule\/Concurrency.swift#L264","fileName":"Concurrency.swift"},"role":"symbol","modules":[{"name":"WorldModule"}],"symbolKind":"method"},"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/worldmodule\/world\/runconcurrently(_:)"]}],"schemaVersion":{"major":0,"minor":3,"patch":0},"hierarchy":{"paths":[["doc:\/\/WorldModule\/documentation\/WorldModule","doc:\/\/WorldModule\/documentation\/WorldModule\/World"]]},"identifier":{"url":"doc:\/\/WorldModule\/documentation\/WorldModule\/World\/runConcurrently(_:)","interfaceLanguage":"swift"},"kind":"symbol","primaryContentSections":[{"declarations":[{"platforms":["Linux"],"tokens":[{"text":"mutating","kind":"keyword"},{"text":" ","kind":"text"},{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"runConcurrently","kind":"identifier"},{"text":"(","kind":"text"},{"text":"_","kind":"externalParam"},{"text":" ","kind":"text"},{"text":"changes","kind":"internalParam"},{"text":": [","kind":"text"},{"text":"ConcurrentChange","preciseIdentifier":"s:11WorldModule16ConcurrentChangeV","identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/ConcurrentChange","kind":"typeIdentifier"},{"text":"])","kind":"text"}],"languages":["swift"]}],"kind":"declarations"},{"parameters":[{"name":"changes","content":[{"type":"paragraph","inlineContent":[{"text":"The changes to run.","type":"text"}]}]}],"kind":"parameters"},{"content":[{"type":"heading","anchor":"discussion","text":"Discussion","level":2},{"type":"paragraph","inlineContent":[{"text":"Use this method to spread independent work across the processor’s cores. Each change reads","type":"text"},{"text":" ","type":"text"},{"text":"the world as it was before any of them ran, and writes only the types its access lists, so","type":"text"},{"text":" ","type":"text"},{"text":"the result is the same as running the changes one after another in any order:","type":"text"}]},{"syntax":"swift","type":"codeListing","code":["var world = World()","let ball = world.spawn(Position(x: 0, y: 0), Velocity(dx: 1, dy: 0), Health(current: 10))","","world.runConcurrently([","    ConcurrentChange(access: .reads(Velocity.self).writes(Position.self)) { world in","        world.update(Position.self, reading: Velocity.self) { position, row in","            position.x += row.components.dx","        }","    },","    ConcurrentChange(access: .writes(Health.self)) { world in","        world.update(Health.self) { health, _ in health.current -= 1 }","    },","])","","print(world[Position.self, of: ball].x, world[Health.self, of: ball].current)","\/\/ Prints \"1.0 9\""]},{"type":"paragraph","inlineContent":[{"type":"text","text":"A change sees the components and resources that other changes write as missing, so its"},{"type":"text","text":" "},{"type":"text","text":"access must list everything it reads. Command buffers a change queues with "},{"type":"reference","isActive":true,"identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/World\/queue(_:)"},{"type":"text","text":" "},{"type":"text","text":"are queued in this world in the order of "},{"code":"changes","type":"codeVoice"},{"type":"text","text":"."}]},{"type":"aside","name":"Important","style":"important","content":[{"inlineContent":[{"type":"text","text":"A change must write only the component and resource types its access lists,"},{"type":"text","text":" "},{"type":"text","text":"and must not spawn or despawn entities. It writes relations through their "},{"type":"reference","isActive":true,"identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/Targets"},{"type":"text","text":" "},{"type":"text","text":"components, and the hierarchy through "},{"type":"codeVoice","code":"Targets<ChildOf>"},{"type":"text","text":"."}],"type":"paragraph"}]},{"type":"aside","name":"Complexity","style":"note","content":[{"inlineContent":[{"type":"text","text":"O("},{"type":"emphasis","inlineContent":[{"text":"c","type":"text"}]},{"type":"text","text":"·"},{"type":"emphasis","inlineContent":[{"text":"t","type":"text"}]},{"type":"text","text":"), besides the cost of the changes themselves, where "},{"type":"emphasis","inlineContent":[{"type":"text","text":"c"}]},{"type":"text","text":" is the"},{"type":"text","text":" "},{"type":"text","text":"number of changes and "},{"type":"emphasis","inlineContent":[{"type":"text","text":"t"}]},{"type":"text","text":" is the number of component types the world has stored."}],"type":"paragraph"}]},{"type":"aside","name":"Precondition","style":"note","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"No two accesses conflict, and each change writes only what its access"},{"type":"text","text":" "},{"type":"text","text":"lists and spawns and despawns nothing; a change that breaks this traps. In debug builds,"},{"type":"text","text":" "},{"type":"text","text":"a change that reads a component or resource type its access doesn’t list traps too. Any"},{"type":"text","text":" "},{"type":"text","text":"change may read "},{"identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/Disabled","type":"reference","isActive":true},{"type":"text","text":" and "},{"identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/Prefab","type":"reference","isActive":true},{"type":"text","text":"."}]}]}],"kind":"content"}],"references":{"doc://WorldModule/documentation/WorldModule/Targets":{"url":"\/documentation\/worldmodule\/targets","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"Targets"}],"type":"topic","kind":"symbol","identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/Targets","role":"symbol","abstract":[{"text":"The component that holds a source entity’s targets of a relation, with the relation’s value","type":"text"},{"text":" ","type":"text"},{"text":"for each.","type":"text"}],"navigatorTitle":[{"kind":"identifier","text":"Targets"}],"title":"Targets"},"doc://WorldModule/documentation/WorldModule/World":{"type":"topic","url":"\/documentation\/worldmodule\/world","abstract":[{"type":"text","text":"A collection of entities, the components they hold, and resources."}],"role":"symbol","kind":"symbol","navigatorTitle":[{"text":"World","kind":"identifier"}],"title":"World","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"World","kind":"identifier"}],"identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/World"},"doc://WorldModule/documentation/WorldModule/ConcurrentChange":{"type":"topic","identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/ConcurrentChange","abstract":[{"type":"text","text":"A change to a world, paired with the access that describes what it reads and writes."}],"role":"symbol","kind":"symbol","navigatorTitle":[{"kind":"identifier","text":"ConcurrentChange"}],"title":"ConcurrentChange","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"ConcurrentChange"}],"url":"\/documentation\/worldmodule\/concurrentchange"},"doc://WorldModule/documentation/WorldModule/World/applyQueuedCommands()":{"identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/World\/applyQueuedCommands()","type":"topic","abstract":[{"text":"Applies every queued command buffer, in the order the buffers were queued, and empties the","type":"text"},{"text":" ","type":"text"},{"text":"queue.","type":"text"}],"role":"symbol","kind":"symbol","title":"applyQueuedCommands()","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"applyQueuedCommands"},{"kind":"text","text":"() -> ["},{"text":"Entity","kind":"typeIdentifier","preciseIdentifier":"s:11WorldModule6EntityV"},{"text":"]","kind":"text"}],"url":"\/documentation\/worldmodule\/world\/applyqueuedcommands()"},"doc://WorldModule/documentation/WorldModule/Disabled":{"title":"Disabled","navigatorTitle":[{"text":"Disabled","kind":"identifier"}],"abstract":[{"type":"text","text":"A component that makes queries and updates skip an entity, unless they ask for it."}],"fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Disabled","kind":"identifier"}],"role":"symbol","url":"\/documentation\/worldmodule\/disabled","identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/Disabled","kind":"symbol","type":"topic"},"doc://WorldModule/documentation/WorldModule/World/queue(_:)":{"type":"topic","identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/World\/queue(_:)","abstract":[{"text":"Adds a command buffer to the world’s queue, to apply later with","type":"text"},{"text":" ","type":"text"},{"identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/World\/applyQueuedCommands()","isActive":true,"type":"reference"},{"text":".","type":"text"}],"role":"symbol","kind":"symbol","title":"queue(_:)","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"queue","kind":"identifier"},{"text":"(","kind":"text"},{"preciseIdentifier":"s:11WorldModule8CommandsV","text":"Commands","kind":"typeIdentifier"},{"text":")","kind":"text"}],"url":"\/documentation\/worldmodule\/world\/queue(_:)"},"doc://WorldModule/documentation/WorldModule/World/runConcurrently(_:)":{"title":"runConcurrently(_:)","abstract":[{"type":"text","text":"Runs changes at the same time, each on its own copy of the world, and keeps what each one"},{"type":"text","text":" "},{"type":"text","text":"wrote."}],"fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"runConcurrently","kind":"identifier"},{"kind":"text","text":"(["},{"preciseIdentifier":"s:11WorldModule16ConcurrentChangeV","kind":"typeIdentifier","text":"ConcurrentChange"},{"kind":"text","text":"])"}],"role":"symbol","url":"\/documentation\/worldmodule\/world\/runconcurrently(_:)","identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/World\/runConcurrently(_:)","type":"topic","kind":"symbol"},"doc://WorldModule/documentation/WorldModule/Prefab":{"navigatorTitle":[{"text":"Prefab","kind":"identifier"}],"role":"symbol","identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/Prefab","type":"topic","title":"Prefab","url":"\/documentation\/worldmodule\/prefab","kind":"symbol","abstract":[{"text":"A component that marks an entity as a template for spawning copies.","type":"text"}],"fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Prefab","kind":"identifier"}]},"doc://WorldModule/documentation/WorldModule":{"type":"topic","identifier":"doc:\/\/WorldModule\/documentation\/WorldModule","abstract":[{"text":"Store the state of a game or simulation as entities and components, and read and change it with","type":"text"},{"text":" ","type":"text"},{"text":"queries, updates, and commands.","type":"text"}],"role":"collection","kind":"symbol","title":"WorldModule","url":"\/documentation\/worldmodule"}}}