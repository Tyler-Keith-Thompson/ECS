"kind":"identifier"}],"navigatorTitle":[{"text":"Prefab","kind":"identifier"}],"title":"Prefab"},"doc://WorldModule/documentation/WorldModule":{"type":"topic","kind":"symbol","role":"collection","title":"WorldModule","abstract":[{"type":"text","text":"Store the state of a game or simulation as entities and components, and read and change it with"},{"type":"text","text":" "},{"type":"text","text":"queries, updates, and commands."}],"url":"\/documentation\/worldmodule","identifier":"doc:\/\/WorldModule\/documentation\/WorldModule"},"doc://WorldModule/documentation/WorldModule/Targets":{"navigatorTitle":[{"kind":"identifier","text":"Targets"}],"kind":"symbol","type":"topic","role":"symbol","title":"Targets","abstract":[{"type":"text","text":"The component that holds a source entity’s targets of a relation, with the relation’s value"},{"type":"text","text":" "},{"type":"text","text":"for each."}],"url":"\/documentation\/worldmodule\/targets","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"Targets"}],"identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/Targets"},"doc://WorldModule/documentation/WorldModule/World":{"navigatorTitle":[{"text":"World","kind":"identifier"}],"type":"topic","kind":"symbol","role":"symbol","title":"World","abstract":[{"type":"text","text":"A collection of entities, the components they hold, and resources."}],"url":"\/documentation\/worldmodule\/world","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"World","kind":"identifier"}],"identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/World"}}}