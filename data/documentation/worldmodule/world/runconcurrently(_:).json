{"schemaVersion":{"major":0,"minor":3,"patch":0},"kind":"symbol","sections":[],"abstract":[{"text":"Runs changes at the same time, each on its own copy of the world, and keeps what each one","type":"text"},{"text":" ","type":"text"},{"text":"wrote.","type":"text"}],"identifier":{"url":"doc:\/\/WorldModule\/documentation\/WorldModule\/World\/runConcurrently(_:)","interfaceLanguage":"swift"},"variants":[{"paths":["\/documentation\/worldmodule\/world\/runconcurrently(_:)"],"traits":[{"interfaceLanguage":"swift"}]}],"hierarchy":{"paths":[["doc:\/\/WorldModule\/documentation\/WorldModule","doc:\/\/WorldModule\/documentation\/WorldModule\/World"]]},"metadata":{"title":"runConcurrently(_:)","role":"symbol","modules":[{"name":"WorldModule"}],"extendedModule":"WorldModule","symbolKind":"method","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"runConcurrently","kind":"identifier"},{"text":"([","kind":"text"},{"text":"ConcurrentChange","kind":"typeIdentifier","preciseIdentifier":"s:11WorldModule16ConcurrentChangeV"},{"text":"])","kind":"text"}],"roleHeading":"Instance Method","externalID":"s:11WorldModule0A0V15runConcurrentlyyySayAA16ConcurrentChangeVGF","remoteSource":{"url":"https:\/\/github.com\/Tyler-Keith-Thompson\/ECS\/blob\/main\/Sources\/WorldModule\/Concurrency.swift#L264","fileName":"Concurrency.swift"}},"primaryContentSections":[{"kind":"declarations","declarations":[{"tokens":[{"text":"mutating","kind":"keyword"},{"text":" ","kind":"text"},{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"runConcurrently","kind":"identifier"},{"text":"(","kind":"text"},{"text":"_","kind":"externalParam"},{"text":" ","kind":"text"},{"text":"changes","kind":"internalParam"},{"text":": [","kind":"text"},{"text":"ConcurrentChange","preciseIdentifier":"s:11WorldModule16ConcurrentChangeV","identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/ConcurrentChange","kind":"typeIdentifier"},{"text":"])","kind":"text"}],"platforms":["Linux"],"languages":["swift"]}]},{"kind":"parameters","parameters":[{"content":[{"type":"paragraph","inlineContent":[{"text":"The changes to run.","type":"text"}]}],"name":"changes"}]},{"kind":"content","content":[{"anchor":"discussion","type":"heading","level":2,"text":"Discussion"},{"type":"paragraph","inlineContent":[{"text":"Use this method to spread independent work across the processor’s cores. Each change reads","type":"text"},{"text":" ","type":"text"},{"text":"the world as it was before any of them ran, and writes only the types its access lists, so","type":"text"},{"text":" ","type":"text"},{"text":"the result is the same as running the changes one after another in any order:","type":"text"}]},{"type":"codeListing","syntax":"swift","code":["var world = World()","let ball = world.spawn(Position(x: 0, y: 0), Velocity(dx: 1, dy: 0), Health(current: 10))","","world.runConcurrently([","    ConcurrentChange(access: .reads(Velocity.self).writes(Position.self)) { world in","        world.update(Position.self, reading: Velocity.self) { position, row in","            position.x += row.components.dx","        }","    },","    ConcurrentChange(access: .writes(Health.self)) { world in","        world.update(Health.self) { health, _ in health.current -= 1 }","    },","])","","print(world[Position.self, of: ball].x, world[Health.self, of: ball].current)","\/\/ Prints \"1.0 9\""]},{"type":"paragraph","inlineContent":[{"type":"text","text":"A change sees the components and resources that other changes write as missing, so its"},{"type":"text","text":" "},{"type":"text","text":"access must list everything it reads. Command buffers a change queues with "},{"isActive":true,"identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/World\/queue(_:)","type":"reference"},{"type":"text","text":" "},{"type":"text","text":"are queued in this world in the order of "},{"type":"codeVoice","code":"changes"},{"type":"text","text":"."}]},{"type":"aside","content":[{"type":"paragraph","inlineContent":[{"text":"A change must write only the component and resource types its access lists,","type":"text"},{"text":" ","type":"text"},{"text":"and must not spawn or despawn entities. It writes relations through their ","type":"text"},{"isActive":true,"identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/Targets","type":"reference"},{"text":" ","type":"text"},{"text":"components, and the hierarchy through ","type":"text"},{"code":"Targets<ChildOf>","type":"codeVoice"},{"text":".","type":"text"}]}],"name":"Important","style":"important"},{"type":"aside","content":[{"inlineContent":[{"text":"O(","type":"text"},{"inlineContent":[{"text":"c","type":"text"}],"type":"emphasis"},{"text":"·","type":"text"},{"inlineContent":[{"type":"text","text":"t"}],"type":"emphasis"},{"text":"), besides the cost of the changes themselves, where ","type":"text"},{"inlineContent":[{"type":"text","text":"c"}],"type":"emphasis"},{"text":" is the","type":"text"},{"text":" ","type":"text"},{"text":"number of changes and ","type":"text"},{"inlineContent":[{"type":"text","text":"t"}],"type":"emphasis"},{"text":" is the number of component types the world has stored.","type":"text"}],"type":"paragraph"}],"name":"Complexity","style":"note"},{"type":"aside","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"No two accesses conflict, and each change writes only what its access"},{"type":"text","text":" "},{"type":"text","text":"lists and spawns and despawns nothing; a change that breaks this traps. In debug builds,"},{"type":"text","text":" "},{"type":"text","text":"a change that reads a component or resource type its access doesn’t list traps too. Any"},{"type":"text","text":" "},{"type":"text","text":"change may read "},{"isActive":true,"identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/Disabled","type":"reference"},{"type":"text","text":" and "},{"isActive":true,"identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/Prefab","type":"reference"},{"type":"text","text":"."}]}],"name":"Precondition","style":"note"}]}],"references":{"doc://WorldModule/documentation/WorldModule":{"role":"collection","type":"topic","abstract":[{"type":"text","text":"Store the state of a game or simulation as entities and components, and read and change it with"},{"type":"text","text":" "},{"type":"text","text":"queries, updates, and commands."}],"identifier":"doc:\/\/WorldModule\/documentation\/WorldModule","kind":"symbol","url":"\/documentation\/worldmodule","title":"WorldModule"},"doc://WorldModule/documentation/WorldModule/Targets":{"navigatorTitle":[{"kind":"identifier","text":"Targets"}],"title":"Targets","type":"topic","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"Targets"}],"kind":"symbol","role":"symbol","identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/Targets","abstract":[{"text":"The component that holds a source entity’s targets of a relation, with the relation’s value","type":"text"},{"text":" ","type":"text"},{"text":"for each.","type":"text"}],"url":"\/documentation\/worldmodule\/targets"},"doc://WorldModule/documentation/WorldModule/Disabled":{"navigatorTitle":[{"text":"Disabled","kind":"identifier"}],"title":"Disabled","type":"topic","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Disabled","kind":"identifier"}],"kind":"symbol","role":"symbol","identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/Disabled","abstract":[{"text":"A component that makes queries and updates skip an entity, unless they ask for it.","type":"text"}],"url":"\/documentation\/worldmodule\/disabled"},"doc://WorldModule/documentation/WorldModule/ConcurrentChange":{"identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/ConcurrentChange","abstract":[{"text":"A change to a world, paired with the access that describes what it reads and writes.","type":"text"}],"title":"ConcurrentChange","navigatorTitle":[{"kind":"identifier","text":"ConcurrentChange"}],"kind":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"ConcurrentChange"}],"type":"topic","role":"symbol","url":"\/documentation\/worldmodule\/concurrentchange"},"doc://WorldModule/documentation/WorldModule/World/applyQueuedCommands()":{"abstract":[{"type":"text","text":"Applies every queued command buffer, in the order the buffers were queued, and empties the"},{"type":"text","text":" "},{"type":"text","text":"queue."}],"kind":"symbol","url":"\/documentation\/worldmodule\/world\/applyqueuedcommands()","type":"topic","title":"applyQueuedCommands()","identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/World\/applyQueuedCommands()","role":"symbol","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"applyQueuedCommands","kind":"identifier"},{"text":"() -> [","kind":"text"},{"text":"Entity","preciseIdentifier":"s:11WorldModule6EntityV","kind":"typeIdentifier"},{"text":"]","kind":"text"}]},"doc://WorldModule/documentation/WorldModule/World":{"navigatorTitle":[{"text":"World","kind":"identifier"}],"title":"World","type":"topic","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"World","kind":"identifier"}],"kind":"symbol","role":"symbol","identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/World","abstract":[{"text":"A collection of entities, the components they hold, and resources.","type":"text"}],"url":"\/documentation\/worldmodule\/world"},"doc://WorldModule/documentation/WorldModule/World/runConcurrently(_:)":{"abstract":[{"type":"text","text":"Runs changes at the same time, each on its own copy of the world, and keeps what each one"},{"type":"text","text":" "},{"type":"text","text":"wrote."}],"kind":"symbol","url":"\/documentation\/worldmodule\/world\/runconcurrently(_:)","type":"topic","title":"runConcurrently(_:)","identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/World\/r