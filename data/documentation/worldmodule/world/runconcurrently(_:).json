{"hierarchy":{"paths":[["doc:\/\/WorldModule\/documentation\/WorldModule","doc:\/\/WorldModule\/documentation\/WorldModule\/World"]]},"primaryContentSections":[{"declarations":[{"languages":["swift"],"tokens":[{"text":"mutating","kind":"keyword"},{"text":" ","kind":"text"},{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"runConcurrently","kind":"identifier"},{"text":"(","kind":"text"},{"text":"_","kind":"externalParam"},{"text":" ","kind":"text"},{"text":"changes","kind":"internalParam"},{"text":": [","kind":"text"},{"text":"ConcurrentChange","preciseIdentifier":"s:11WorldModule16ConcurrentChangeV","identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/ConcurrentChange","kind":"typeIdentifier"},{"text":"])","kind":"text"}],"platforms":["Linux"]}],"kind":"declarations"},{"parameters":[{"name":"changes","content":[{"type":"paragraph","inlineContent":[{"text":"The changes to run.","type":"text"}]}]}],"kind":"parameters"},{"kind":"content","content":[{"anchor":"discussion","type":"heading","level":2,"text":"Discussion"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Use this method to spread independent work across the processor’s cores. Each change reads"},{"type":"text","text":" "},{"type":"text","text":"the world as it was before any of them ran, and writes only the types its access lists, so"},{"type":"text","text":" "},{"type":"text","text":"the result is the same as running the changes one after another in any order:"}]},{"syntax":"swift","type":"codeListing","code":["var world = World()","let ball = world.spawn(Position(x: 0, y: 0), Velocity(dx: 1, dy: 0), Health(current: 10))","","world.runConcurrently([","    ConcurrentChange(access: .reads(Velocity.self).writes(Position.self)) { world in","        world.update(Position.self, reading: Velocity.self) { position, row in","            position.x += row.components.dx","        }","    },","    ConcurrentChange(access: .writes(Health.self)) { world in","        world.update(Health.self) { health, _ in health.current -= 1 }","    },","])","","print(world[Position.self, of: ball].x, world[Health.self, of: ball].current)","\/\/ Prints \"1.0 9\""]},{"type":"paragraph","inlineContent":[{"type":"text","text":"A change sees the components and resources that other changes write as missing, so its"},{"type":"text","text":" "},{"type":"text","text":"access must list everything it reads. Command buffers a change queues with "},{"isActive":true,"type":"reference","identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/World\/queue(_:)"},{"type":"text","text":" "},{"type":"text","text":"are queued in this world in the order of "},{"code":"changes","type":"codeVoice"},{"type":"text","text":"."}]},{"style":"important","type":"aside","name":"Important","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"A change must write only the component and resource types its access lists,"},{"type":"text","text":" "},{"type":"text","text":"and must not spawn or despawn entities. It writes relations through their "},{"type":"reference","isActive":true,"identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/Targets"},{"type":"text","text":" "},{"type":"text","text":"components, and the hierarchy through "},{"type":"codeVoice","code":"Targets<ChildOf>"},{"type":"text","text":"."}]}]},{"style":"note","type":"aside","name":"Complexity","content":[{"inlineContent":[{"text":"O(","type":"text"},{"inlineContent":[{"text":"c","type":"text"}],"type":"emphasis"},{"text":"·","type":"text"},{"inlineContent":[{"text":"t","type":"text"}],"type":"emphasis"},{"text":"), besides the cost of the changes themselves, where ","type":"text"},{"inlineContent":[{"type":"text","text":"c"}],"type":"emphasis"},{"text":" is the","type":"text"},{"text":" ","type":"text"},{"text":"number of changes and ","type":"text"},{"inlineContent":[{"text":"t","type":"text"}],"type":"emphasis"},{"text":" is the number of component types the world has stored.","type":"text"}],"type":"paragraph"}]},{"style":"note","type":"aside","name":"Precondition","content":[{"inlineContent":[{"type":"text","text":"No two accesses conflict, and each change writes only what its access"},{"type":"text","text":" "},{"type":"text","text":"lists and spawns and despawns nothing; a change that breaks this traps. In debug builds,"},{"type":"text","text":" "},{"type":"text","text":"a change that reads a component or resource type its access doesn’t list traps too. Any"},{"type":"text","text":" "},{"type":"text","text":"change may read "},{"identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/Disabled","type":"reference","isActive":true},{"type":"text","text":" and "},{"identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/Prefab","type":"reference","isActive":true},{"type":"text","text":"."}],"type":"paragraph"}]}]}],"schemaVersion":{"minor":3,"patch":0,"major":0},"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/worldmodule\/world\/runconcurrently(_:)"]}],"metadata":{"externalID":"s:11WorldModule0A0V15runConcurrentlyyySayAA16ConcurrentChangeVGF","role":"symbol","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"runConcurrently","kind":"identifier"},{"text":"([","kind":"text"},{"preciseIdentifier":"s:11WorldModule16ConcurrentChangeV","text":"ConcurrentChange","kind":"typeIdentifier"},{"text":"])","kind":"text"}],"symbolKind":"method","remoteSource":{"url":"https:\/\/github.com\/Tyler-Keith-Thompson\/ECS\/blob\/main\/Sources\/WorldModule\/Concurrency.swift#L264","fileName":"Concurrency.swift"},"roleHeading":"Instance Method","modules":[{"name":"WorldModule"}],"extendedModule":"WorldModule","title":"runConcurrently(_:)"},"sections":[],"identifier":{"url":"doc:\/\/WorldModule\/documentation\/WorldModule\/World\/runConcurrently(_:)","interfaceLanguage":"swift"},"abstract":[{"type":"text","text":"Runs changes at the same time, each on its own copy of the world, and keeps what each one"},{"type":"text","text":" "},{"type":"text","text":"wrote."}],"kind":"symbol","references":{"doc://WorldModule/documentation/WorldModule":{"role":"collection","url":"\/documentation\/worldmodule","abstract":[{"text":"Store the state of a game or simulation as entities and components, and read and change it with","type":"text"},{"text":" ","type":"text"},{"text":"queries, updates, and commands.","type":"text"}],"identifier":"doc:\/\/WorldModule\/documentation\/WorldModule","title":"WorldModule","type":"topic","kind":"symbol"},"doc://WorldModule/documentation/WorldModule/World":{"kind":"symbol","type":"topic","role":"symbol","title":"World","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"World"}],"url":"\/documentation\/worldmodule\/world","identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/World","navigatorTitle":[{"kind":"identifier","text":"World"}],"abstract":[{"type":"text","text":"A collection of entities, the components they hold, and resources."}]},"doc://WorldModule/documentation/WorldModule/ConcurrentChange":{"navigatorTitle":[{"kind":"identifier","text":"ConcurrentChange"}],"title":"ConcurrentChange","identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/ConcurrentChange","role":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"ConcurrentChange"}],"kind":"symbol","type":"topic","url":"\/documentation\/worldmodule\/concurrentchange","abstract":[{"text":"A change to a world, paired with the access that describes what it reads and writes.","type":"text"}]},"doc://WorldModule/documentation/WorldModule/World/applyQueuedCommands()":{"identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/World\/applyQueuedCommands()","role":"symbol","url":"\/documentation\/worldmodule\/world\/applyqueuedcommands()","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"applyQueuedCommands","kind":"identifier"},{