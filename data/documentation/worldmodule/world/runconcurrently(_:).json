{"metadata":{"externalID":"s:11WorldModule0A0V15runConcurrentlyyySayAA16ConcurrentChangeVGF","symbolKind":"method","title":"runConcurrently(_:)","role":"symbol","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"runConcurrently"},{"text":"([","kind":"text"},{"preciseIdentifier":"s:11WorldModule16ConcurrentChangeV","text":"ConcurrentChange","kind":"typeIdentifier"},{"text":"])","kind":"text"}],"extendedModule":"WorldModule","roleHeading":"Instance Method","modules":[{"name":"WorldModule"}],"remoteSource":{"url":"https:\/\/github.com\/Tyler-Keith-Thompson\/ECS\/blob\/main\/Sources\/WorldModule\/Concurrency.swift#L264","fileName":"Concurrency.swift"}},"hierarchy":{"paths":[["doc:\/\/WorldModule\/documentation\/WorldModule","doc:\/\/WorldModule\/documentation\/WorldModule\/World"]]},"schemaVersion":{"major":0,"minor":3,"patch":0},"kind":"symbol","variants":[{"paths":["\/documentation\/worldmodule\/world\/runconcurrently(_:)"],"traits":[{"interfaceLanguage":"swift"}]}],"primaryContentSections":[{"kind":"declarations","declarations":[{"languages":["swift"],"platforms":["Linux"],"tokens":[{"kind":"keyword","text":"mutating"},{"kind":"text","text":" "},{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"runConcurrently"},{"text":"(","kind":"text"},{"text":"_","kind":"externalParam"},{"text":" ","kind":"text"},{"text":"changes","kind":"internalParam"},{"text":": [","kind":"text"},{"text":"ConcurrentChange","kind":"typeIdentifier","identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/ConcurrentChange","preciseIdentifier":"s:11WorldModule16ConcurrentChangeV"},{"text":"])","kind":"text"}]}]},{"kind":"parameters","parameters":[{"name":"changes","content":[{"type":"paragraph","inlineContent":[{"text":"The changes to run.","type":"text"}]}]}]},{"kind":"content","content":[{"type":"heading","anchor":"discussion","level":2,"text":"Discussion"},{"type":"paragraph","inlineContent":[{"text":"Use this method to spread independent work across the processor’s cores. Each change reads","type":"text"},{"type":"text","text":" "},{"text":"the world as it was before any of them ran, and writes only the types its access lists, so","type":"text"},{"text":" ","type":"text"},{"text":"the result is the same as running the changes one after another in any order:","type":"text"}]},{"code":["var world = World()","let ball = world.spawn(Position(x: 0, y: 0), Velocity(dx: 1, dy: 0), Health(current: 10))","","world.runConcurrently([","    ConcurrentChange(access: .reads(Velocity.self).writes(Position.self)) { world in","        world.update(Position.self, reading: Velocity.self) { position, row in","            position.x += row.components.dx","        }","    },","    ConcurrentChange(access: .writes(Health.self)) { world in","        world.update(Health.self) { health, _ in health.current -= 1 }","    },","])","","print(world[Position.self, of: ball].x, world[Health.self, of: ball].current)","\/\/ Prints \"1.0 9\""],"type":"codeListing","syntax":"swift"},{"type":"paragraph","inlineContent":[{"text":"A change sees the components and resources that other changes write as missing, so its","type":"text"},{"text":" ","type":"text"},{"text":"access must list everything it reads. Command buffers a change queues with ","type":"text"},{"identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/World\/queue(_:)","type":"reference","isActive":true},{"text":" ","type":"text"},{"text":"are queued in this world in the order of ","type":"text"},{"code":"changes","type":"codeVoice"},{"text":".","type":"text"}]},{"type":"aside","name":"Important","content":[{"inlineContent":[{"type":"text","text":"A change must write only the component and resource types its access lists,"},{"type":"text","text":" "},{"type":"text","text":"and must not spawn or despawn entities. It writes relations through their "},{"type":"reference","identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/Targets","isActive":true},{"type":"text","text":" "},{"type":"text","text":"components, and the hierarchy through "},{"type":"codeVoice","code":"Targets<ChildOf>"},{"type":"text","text":"."}],"type":"paragraph"}],"style":"important"},{"type":"aside","name":"Complexity","content":[{"type":"paragraph","inlineContent":[{"text":"O(","type":"text"},{"inlineContent":[{"type":"text","text":"c"}],"type":"emphasis"},{"text":"·","type":"text"},{"inlineContent":[{"type":"text","text":"t"}],"type":"emphasis"},{"text":"), besides the cost of the changes themselves, where ","type":"text"},{"inlineContent":[{"type":"text","text":"c"}],"type":"emphasis"},{"text":" is the","type":"text"},{"text":" ","type":"text"},{"text":"number of changes and ","type":"text"},{"inlineContent":[{"type":"text","text":"t"}],"type":"emphasis"},{"text":" is the number of component types the world has stored.","type":"text"}]}],"style":"note"},{"type":"aside","name":"Precondition","content":[{"type":"paragraph","inlineContent":[{"text":"No two accesses conflict, and each change writes only what its access","type":"text"},{"text":" ","type":"text"},{"text":"lists and spawns and despawns nothing; a change that breaks this traps. In debug builds,","type":"text"},{"text":" ","type":"text"},{"text":"a change that reads a component or resource type its access doesn’t list traps too. Any","type":"text"},{"text":" ","type":"text"},{"text":"change may read ","type":"text"},{"identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/Disabled","type":"reference","isActive":true},{"text":" and ","type":"text"},{"identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/Prefab","type":"reference","isActive":true},{"text":".","type":"text"}]}],"style":"note"}]}],"sections":[],"identifier":{"url":"doc:\/\/WorldModule\/documentation\/WorldModule\/World\/runConcurrently(_:)","interfaceLanguage":"swift"},"abstract":[{"text":"Runs changes at the same time, each on its own copy of the world, and keeps what each one","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"wrote."}],"references":{"doc://WorldModule/documentation/WorldModule/World/applyQueuedCommands()":{"title":"applyQueuedCommands()","url":"\/documentation\/worldmodule\/world\/applyqueuedcommands()","role":"symbol","abstract":[{"text":"Applies every queued command buffer, in the order the buffers were queued, and empties the","type":"text"},{"text":" ","type":"text"},{"text":"queue.","type":"text"}],"fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"applyQueuedCommands"},{"kind":"text","text":"() -> ["},{"text":"Entity","kind":"typeIdentifier","preciseIdentifier":"s:11WorldModule6EntityV"},{"text":"]","kind":"text"}],"identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/World\/applyQueuedCommands()","type":"topic","kind":"symbol"},"doc://WorldModule/documentation/WorldModule/Prefab":{"fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Prefab","kind":"identifier"}],"abstract":[{"text":"A component that marks an entity as a template for spawning copies.","type":"text"}],"navigatorTitle":[{"text":"Prefab","kind":"identifier"}],"url":"\/documentation\/worldmodule\/prefab","identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/Prefab","role":"symbol","type":"topic","title":"Prefab","kind":"symbol"},"doc://WorldModule/documentation/WorldModule/World/queue(_:)":{"title":"queue(_:)","url":"\/documentation\/worldmodule\/world\/queue(_:)","role":"symbol","abstract":[{"type":"text","text":"Adds a command buffer to the world’s queue, to apply later with"},{"type":"text","text":" "},{"type":"reference","identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/World\/applyQueuedCommands()","isActive":true},{"type":"text","text":"."}],"fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"queue","kind":"identifier"},{"text":"(","kind":"text"},{"preciseIdentifier":"s:11WorldModule8CommandsV","text":"Commands","kind":"typeIdentifier"},{"text":")","kind":"text"}],"identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/World\/queue(_:)","type":"topic","kind":"symbol"},"doc://WorldModule/documentation/WorldModule/Targets":{"abstract":[{"type":"text","text":"The component that holds a source entity’s targets of a relation, with the relation’s value"},{"type":"text","text":" "},{"type":"text","text":"for each."}],"type":"topic","kind":"symbol","role":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Targets","kind":"identifier"}],"title":"Targets","navigatorTitle":[{"text":"Targets","kind":"identifier"}],"identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/Targets","url":"\/documentation\/worldmodule\/targets"},"doc://WorldModule/documentation/WorldModule":{"abstract":[{"type":"text","text":"Store the state of a game or simulation as entities and components, and read and change it with"},{"type":"text","text":" "},{"type":"text","text":"queries, updates, and commands."}],"url":"\/documentation\/worldmodule","identifier":"doc:\/\/WorldModule\/documentation\/WorldModule","role":"collection","type":"topic","title":"WorldModule","kind":"symbol"},"doc://WorldModule/documentation/WorldModule/ConcurrentChange":{"kind":"symbol","type":"topic","title":"ConcurrentChange","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"ConcurrentChange"}],"url":"\/documentation\/worldmodule\/concurrentchange","abstract":[{"type":"text","text":"A change to a world, paired with the access that describes what it reads and writes."}],"role":"symbol","navigatorTitle":[{"kind":"identifier","text":"ConcurrentChange"}],"identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/ConcurrentChange"},"doc://WorldModule/documentation/WorldModule/World/runConcurrently(_:)":{"type":"topic","title":"runConcurrently(_:)","kind":"symbol","role":"symbol","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"runConcurrently","kind":"identifier"},{"text":"([","kind":"text"},{"preciseIdentifier":"s:11WorldModule16ConcurrentChangeV","kind":"typeIdentifier","text":"ConcurrentChange"},{"kind":"text","text":"])"}],"url":"\/documentation\/worldmodule\/world\/runconcurrently(_:)","identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/World\/runConcurrently(_:)","abstract":[{"type":"text","text":"Runs changes at the same time, each on its own copy of the world, and keeps what each one"},{"type":"text","text":" "},{"type":"text","text":"wrote."}]},"doc://WorldModule/documentation/WorldModule/World":{"type":"topic","role":"symbol","abstract":[{"text":"A collection of entities, the components they hold, and resources.","type":"text"}],"fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"World","kind":"identifier"}],"navigatorTitle":[{"text":"World","kind":"identifier"}],"kind":"symbol","title":"World","url":"\/documentation\/worldmodule\/world","identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/World"},"doc://WorldModule/documentation/WorldModule/Disabled":{"kind":"symbol","type":"topic","identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/Disabled","role":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Disabled","kind":"identifier"}],"title":"Disabled","navigatorTitle":[{"text":"Disabled","kind":"identifier"}],"abstract":[{"type":"text","text":"A component that makes queries and updates skip an entity, unless they ask for it."}],"url":"\/documentation\/worldmodule\/disabled"}}}