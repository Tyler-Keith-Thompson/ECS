{"kind":"symbol","identifier":{"url":"doc:\/\/WorldModule\/documentation\/WorldModule\/World\/runConcurrently(_:)","interfaceLanguage":"swift"},"abstract":[{"type":"text","text":"Runs changes at the same time, each on its own copy of the world, and keeps what each one"},{"type":"text","text":" "},{"type":"text","text":"wrote."}],"metadata":{"extendedModule":"WorldModule","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"runConcurrently"},{"kind":"text","text":"(["},{"kind":"typeIdentifier","preciseIdentifier":"s:11WorldModule16ConcurrentChangeV","text":"ConcurrentChange"},{"kind":"text","text":"])"}],"roleHeading":"Instance Method","externalID":"s:11WorldModule0A0V15runConcurrentlyyySayAA16ConcurrentChangeVGF","role":"symbol","symbolKind":"method","modules":[{"name":"WorldModule"}],"remoteSource":{"url":"https:\/\/github.com\/Tyler-Keith-Thompson\/ECS\/blob\/main\/Sources\/WorldModule\/Concurrency.swift#L264","fileName":"Concurrency.swift"},"title":"runConcurrently(_:)"},"primaryContentSections":[{"kind":"declarations","declarations":[{"platforms":["Linux"],"tokens":[{"kind":"keyword","text":"mutating"},{"kind":"text","text":" "},{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"runConcurrently"},{"kind":"text","text":"("},{"kind":"externalParam","text":"_"},{"kind":"text","text":" "},{"kind":"internalParam","text":"changes"},{"kind":"text","text":": ["},{"kind":"typeIdentifier","identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/ConcurrentChange","preciseIdentifier":"s:11WorldModule16ConcurrentChangeV","text":"ConcurrentChange"},{"kind":"text","text":"])"}],"languages":["swift"]}]},{"kind":"parameters","parameters":[{"content":[{"inlineContent":[{"type":"text","text":"The changes to run."}],"type":"paragraph"}],"name":"changes"}]},{"kind":"content","content":[{"text":"Discussion","anchor":"discussion","type":"heading","level":2},{"type":"paragraph","inlineContent":[{"type":"text","text":"Use this method to spread independent work across the processor’s cores. Each change reads"},{"type":"text","text":" "},{"type":"text","text":"the world as it was before any of them ran, and writes only the types its access lists, so"},{"type":"text","text":" "},{"type":"text","text":"the result is the same as running the changes one after another in any order:"}]},{"type":"codeListing","code":["var world = World()","let ball = world.spawn(Position(x: 0, y: 0), Velocity(dx: 1, dy: 0), Health(current: 10))","","world.runConcurrently([","    ConcurrentChange(access: .reads(Velocity.self).writes(Position.self)) { world in","        world.update(Position.self, reading: Velocity.self) { position, row in","            position.x += row.components.dx","        }","    },","    ConcurrentChange(access: .writes(Health.self)) { world in","        world.update(Health.self) { health, _ in health.current -= 1 }","    },","])","","print(world[Position.self, of: ball].x, world[Health.self, of: ball].current)","\/\/ Prints \"1.0 9\""],"syntax":"swift"},{"type":"paragraph","inlineContent":[{"type":"text","text":"A change sees the components and resources that other changes write as missing, so its"},{"type":"text","text":" "},{"type":"text","text":"access must list everything it reads. Command buffers a change queues with "},{"type":"reference","identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/World\/queue(_:)","isActive":true},{"type":"text","text":" "},{"type":"text","text":"are queued in this world in the order of "},{"type":"codeVoice","code":"changes"},{"type":"text","text":"."}]},{"content":[{"inlineContent":[{"text":"A change must write only the component and resource types its access lists,","type":"text"},{"text":" ","type":"text"},{"text":"and must not spawn or despawn entities. It writes relations through their ","type":"text"},{"identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/Targets","type":"reference","isActive":true},{"text":" ","type":"text"},{"text":"components, and the hierarchy through ","type":"text"},{"code":"Targets<ChildOf>","type":"codeVoice"},{"text":".","type":"text"}],"type":"paragraph"}],"type":"aside","style":"important","name":"Important"},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"O("},{"inlineContent":[{"type":"text","text":"c"}],"type":"emphasis"},{"type":"text","text":"·"},{"inlineContent":[{"text":"t","type":"text"}],"type":"emphasis"},{"type":"text","text":"), besides the cost of the changes themselves, where "},{"inlineContent":[{"type":"text","text":"c"}],"type":"emphasis"},{"type":"text","text":" is the"},{"type":"text","text":" "},{"type":"text","text":"number of changes and "},{"inlineContent":[{"text":"t","type":"text"}],"type":"emphasis"},{"type":"text","text":" is the number of component types the world has stored."}]}],"type":"aside","style":"note","name":"Complexity"},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"No two accesses conflict, and each change writes only what its access"},{"type":"text","text":" "},{"type":"text","text":"lists and spawns and despawns nothing; a change that breaks this traps. In debug builds,"},{"type":"text","text":" "},{"type":"text","text":"a change that reads a component or resource type its access doesn’t list traps too. Any"},{"type":"text","text":" "},{"type":"text","text":"change may read "},{"type":"reference","identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/Disabled","isActive":true},{"type":"text","text":" and "},{"type":"reference","identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/Prefab","isActive":true},{"type":"text","text":"."}]}],"type":"aside","style":"note","name":"Precondition"}]}],"hierarchy":{"paths":[["doc:\/\/WorldModule\/documentation\/WorldModule","doc:\/\/WorldModule\/documentation\/WorldModule\/World"]]},"schemaVersion":{"patch":0,"major":0,"minor":3},"variants":[{"paths":["\/documentation\/worldmodule\/world\/runconcurrently(_:)"],"traits":[{"interfaceLanguage":"swift"}]}],"sections":[],"references":{"doc://WorldModule/documentation/WorldModule/World/queue(_:)":{"fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"queue","kind":"identifier"},{"kind":"text","text":"("},{"kind":"typeIdentifier","text":"Commands","preciseIdentifier":"s:11WorldModule8CommandsV"},{"kind":"text","text":")"}],"url":"\/documentation\/worldmodule\/world\/queue(_:)","kind":"symbol","role":"symbol","identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/World\/queue(_:)","abstract":[{"text":"Adds a command buffer to the world’s queue, to apply later with","type":"text"},{"text":" ","type":"text"},{"isActive":true,"identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/World\/applyQueuedCommands()","type":"reference"},{"text":".","type":"text"}],"type":"topic","title":"queue(_:)"},"doc://WorldModule/documentation/WorldModule/Disabled":{"url":"\/documentation\/worldmodule\/disabled","kind":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Disabled","kind":"identifier"}],"identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/Disabled","type":"topic","title":"Disabled","abstract":[{"type":"text","text":"A component that makes queries and updates skip an entity, unless they ask for it."}],"role":"symbol","navigatorTitle":[{"text":"Disabled","kind":"identifier"}]},"doc://WorldModule/documentation/WorldModule/World/runConcurrently(_:)":{"fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"runConcurrently"},{"kind":"text","text":"(["},{"preciseIdentifier":"s:11WorldModule16ConcurrentChangeV","text":"ConcurrentChange","kind":"typeIdentifier"},{"text":"])","kind":"text"}],"url":"\/documentation\/worldmodule\/world\/runconcurrently(_:)","kind":"symbol","role":"symbol","identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/World\/runConcurrently(_:)","abstract":[{"text":"Runs changes at the same time, each on its own copy of the world, and keeps what each one","type":"text"},{"text":" ","type":"text"},{"text":"wrote.","type":"text"}],"type":"topic","title":"runConcurrently(_:)"},"doc://WorldModule/documentation/WorldModule/ConcurrentChange":{"url":"\/documentation\/worldmodule\/concurrentchange","kind":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"ConcurrentChange","kind":"identifier"}],"identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/ConcurrentChange","type":"topic","title":"ConcurrentChange","abstract":[{"text":"A change to a world, paired with the access that describes what it reads and writes.","type":"text"}],"role":"symbol","navigatorTitle":[{"text":"ConcurrentChange","kind":"identifier"}]},"doc://WorldModule/documentation/WorldModule":{"role":"collection","type":"topic","identifier":"doc:\/\/WorldModule\/documentation\/WorldModule","url":"\/documentation\/worldmodule","abstract":[{"type":"text","text":"Store the state of a game or simulation as entities and components, and read and change it with"},{"type":"text","text":" "},{"type":"text","text":"queries, updates, and commands."}],"kind":"symbol","title":"WorldModule"},"doc://WorldModule/documentation/WorldModule/World":{"role":"symbol","url":"\/documentation\/worldmodule\/world","navigatorTitle":[{"kind":"identifier","text":"World"}],"title":"World","type":"topic","abstract":[{"text":"A collection of entities, the components they hold, and resources.","type":"text"}],"kind":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"World"}],"identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/World"},"doc://WorldModule/documentation/WorldModule/World/applyQueuedCommands()":{"role":"symbol","type":"topic","identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/World\/applyQueuedCommands()","kind":"symbol","abstract":[{"text":"Applies every queued command buffer, in the order the buffers were queued, and empties the","type":"text"},{"text":" ","type":"text"},{"text":"queue.","type":"text"}],"url":"\/documentation\/worldmodule\/world\/applyqueuedcommands()","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"applyQueuedCommands","kind":"identifier"},{"text":"() -> [","kind":"text"},{"kind":"typeIdentifier","text":"Entity","preciseIdentifier":"s:11WorldModule6EntityV"},{"kind":"text","text":"]"}],"title":"applyQueuedCommands()"},"doc://WorldModule/documentation/WorldModule/Targets":{"role":"symbol","type":"topic","identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/Targets","kind":"symbol","abstract":[{"text":"The component that holds a source entity’s targets of a relation, with the relation’s value","type":"text"},{"text":" ","type":"text"},{"text":"for each.","type":"text"}],"url":"\/documentation\/worldmodule\/targets","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Targets","kind":"identifier"}],"navigatorTitle":[{"text":"Targets","kind":"identifier"}],"title":"Targets"},"doc://WorldModule/documentation/WorldModule/Prefab":{"url":"\/documentation\/worldmodule\/prefab","kind":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"Prefab"}],"identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/Prefab","type":"topic","abstract":[{"text":"A component that marks an entity as a template for spawning copies.","type":"text"}],"title":"Prefab","role":"symbol","navigatorTitle":[{"kind":"identifier","text":"Prefab"}]}}}