{"schemaVersion":{"minor":3,"patch":0,"major":0},"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/WorldModule\/documentation\/WorldModule\/World\/runConcurrently(_:)"},"sections":[],"hierarchy":{"paths":[["doc:\/\/WorldModule\/documentation\/WorldModule","doc:\/\/WorldModule\/documentation\/WorldModule\/World"]]},"variants":[{"paths":["\/documentation\/worldmodule\/world\/runconcurrently(_:)"],"traits":[{"interfaceLanguage":"swift"}]}],"metadata":{"externalID":"s:11WorldModule0A0V15runConcurrentlyyySayAA16ConcurrentChangeVGF","role":"symbol","modules":[{"name":"WorldModule"}],"title":"runConcurrently(_:)","symbolKind":"method","extendedModule":"WorldModule","roleHeading":"Instance Method","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"runConcurrently","kind":"identifier"},{"text":"([","kind":"text"},{"text":"ConcurrentChange","kind":"typeIdentifier","preciseIdentifier":"s:11WorldModule16ConcurrentChangeV"},{"text":"])","kind":"text"}],"remoteSource":{"fileName":"Concurrency.swift","url":"https:\/\/github.com\/Tyler-Keith-Thompson\/ECS\/blob\/main\/Sources\/WorldModule\/Concurrency.swift#L264"}},"primaryContentSections":[{"kind":"declarations","declarations":[{"tokens":[{"kind":"keyword","text":"mutating"},{"kind":"text","text":" "},{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"runConcurrently"},{"kind":"text","text":"("},{"kind":"externalParam","text":"_"},{"kind":"text","text":" "},{"kind":"internalParam","text":"changes"},{"kind":"text","text":": ["},{"preciseIdentifier":"s:11WorldModule16ConcurrentChangeV","identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/ConcurrentChange","kind":"typeIdentifier","text":"ConcurrentChange"},{"kind":"text","text":"])"}],"platforms":["Linux"],"languages":["swift"]}]},{"kind":"parameters","parameters":[{"name":"changes","content":[{"type":"paragraph","inlineContent":[{"text":"The changes to run.","type":"text"}]}]}]},{"kind":"content","content":[{"type":"heading","level":2,"text":"Discussion","anchor":"discussion"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Use this method to spread independent work across the processor’s cores. Each change reads"},{"type":"text","text":" "},{"type":"text","text":"the world as it was before any of them ran, and writes only the types its access lists, so"},{"type":"text","text":" "},{"type":"text","text":"the result is the same as running the changes one after another in any order:"}]},{"syntax":"swift","type":"codeListing","code":["var world = World()","let ball = world.spawn(Position(x: 0, y: 0), Velocity(dx: 1, dy: 0), Health(current: 10))","","world.runConcurrently([","    ConcurrentChange(access: .reads(Velocity.self).writes(Position.self)) { world in","        world.update(Position.self, reading: Velocity.self) { position, row in","            position.x += row.components.dx","        }","    },","    ConcurrentChange(access: .writes(Health.self)) { world in","        world.update(Health.self) { health, _ in health.current -= 1 }","    },","])","","print(world[Position.self, of: ball].x, world[Health.self, of: ball].current)","\/\/ Prints \"1.0 9\""]},{"type":"paragraph","inlineContent":[{"type":"text","text":"A change sees the components and resources that other changes write as missing, so its"},{"type":"text","text":" "},{"type":"text","text":"access must list everything it reads. Command buffers a change queues with "},{"isActive":true,"type":"reference","identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/World\/queue(_:)"},{"type":"text","text":" "},{"type":"text","text":"are queued in this world in the order of "},{"code":"changes","type":"codeVoice"},{"type":"text","text":"."}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"A change must write only the component and resource types its access lists,"},{"type":"text","text":" "},{"type":"text","text":"and must not spawn or despawn entities. It writes relations through their "},{"type":"reference","identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/Targets","isActive":true},{"type":"text","text":" "},{"type":"text","text":"components, and the hierarchy through "},{"type":"codeVoice","code":"Targets<ChildOf>"},{"type":"text","text":"."}]}],"type":"aside","name":"Important","style":"important"},{"content":[{"type":"paragraph","inlineContent":[{"text":"O(","type":"text"},{"inlineContent":[{"type":"text","text":"c"}],"type":"emphasis"},{"text":"·","type":"text"},{"inlineContent":[{"text":"t","type":"text"}],"type":"emphasis"},{"text":"), besides the cost of the changes themselves, where ","type":"text"},{"inlineContent":[{"type":"text","text":"c"}],"type":"emphasis"},{"text":" is the","type":"text"},{"text":" ","type":"text"},{"text":"number of changes and ","type":"text"},{"inlineContent":[{"type":"text","text":"t"}],"type":"emphasis"},{"text":" is the number of component types the world has stored.","type":"text"}]}],"type":"aside","name":"Complexity","style":"note"},{"content":[{"inlineContent":[{"type":"text","text":"No two accesses conflict, and each change writes only what its access"},{"type":"text","text":" "},{"type":"text","text":"lists and spawns and despawns nothing; a change that breaks this traps. In debug builds,"},{"type":"text","text":" "},{"type":"text","text":"a change that reads a component or resource type its access doesn’t list traps too. Any"},{"type":"text","text":" "},{"type":"text","text":"change may read "},{"type":"reference","isActive":true,"identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/Disabled"},{"type":"text","text":" and "},{"type":"reference","isActive":true,"identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/Prefab"},{"type":"text","text":"."}],"type":"paragraph"}],"type":"aside","name":"Precondition","style":"note"}]}],"kind":"symbol","abstract":[{"text":"Runs changes at the same time, each on its own copy of the world, and keeps what each one","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"wrote."}],"references":{"doc://WorldModule/documentation/WorldModule/Prefab":{"abstract":[{"text":"A component that marks an entity as a template for spawning copies.","type":"text"}],"navigatorTitle":[{"text":"Prefab","kind":"identifier"}],"title":"Prefab","identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/Prefab","role":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Prefab","kind":"identifier"}],"url":"\/documentation\/worldmodule\/prefab","kind":"symbol","type":"topic"},"doc://WorldModule/documentation/WorldModule/World/runConcurrently(_:)":{"fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"runConcurrently"},{"kind":"text","text":"(["},{"kind":"typeIdentifier","preciseIdentifier":"s:11WorldModule16ConcurrentChangeV","text":"ConcurrentChange"},{"kind":"text","text":"])"}],"identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/World\/runConcurrently(_:)","url":"\/documentation\/worldmodule\/world\/runconcurrently(_:)","role":"symbol","title":"runConcurrently(_:)","type":"topic","abstract":[{"type":"text","text":"Runs changes at the same time, each on its own copy of the world, and keeps what each one"},{"type":"text","text":" "},{"type":"text","text":"wrote."}],"kind":"symbol"},"doc://WorldModule/documentation/WorldModule/World/queue(_:)":{"identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/World\/queue(_:)","role":"symbol","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"queue","kind":"identifier"},{"kind":"text","text":"("},{"kind":"typeIdentifier","preciseIdentifier":"s:11WorldModule8CommandsV","text":"Commands"},{"kind":"text","text":")"}],"title":"queue(_:)","kind":"symbol","type":"topic","abstract":[{"type":"text","text":"Adds a command buffer to the world’s queue, to apply later with"},{"type":"text","text":" "},{"identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/World\/applyQueuedCommands()","type":"reference","isActive":true},{"type":"text","text":"."}],"url":"\/documentation\/worldmodule\/world\/queue(_:)"},"doc://WorldModule/documentation/WorldModule/World":{"url":"\/documentation\/worldmodule\/world","identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/World","navigatorTitle":[{"text":"World","kind":"identifier"}],"role":"symbol","title":"World","abstract":[{"type":"text","text":"A collection of entities, the components they hold, and resources."}],"kind":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"World","kind":"identifier"}],"type":"topic"},"doc://WorldModule/documentation/WorldModule/ConcurrentChange":{"kind":"symbol","url":"\/documentation\/worldmodule\/concurrentchange","identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/ConcurrentChange","type":"topic","role":"symbol","title":"ConcurrentChange","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"ConcurrentChange"}],"abstract":[{"type":"text","text":"A change to a world, paired with the access that describes what it reads and writes."}],"navigatorTitle":[{"kind":"identifier","text":"ConcurrentChange"}]},"doc://WorldModule/documentation/WorldModule":{"abstract":[{"text":"Store the state of a game or simulation as entities and components, and read and change it with","type":"text"},{"text":" ","type":"text"},{"text":"queries, updates, and commands.","type":"text"}],"type":"topic","title":"WorldModule","url":"\/documentation\/worldmodule","kind":"symbol","role":"collection","identifier":"doc:\/\/WorldModule\/documentation\/WorldModule"},"doc://WorldModule/documentation/WorldModule/Disabled":{"fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Disabled","kind":"identifier"}],"navigatorTitle":[{"text":"Disabled","kind":"identifier"}],"title":"Disabled","url":"\/documentation\/worldmodule\/disabled","kind":"symbol","abstract":[{"type":"text","text":"A component that makes queries and updates skip an entity, unless they ask for it."}],"role":"symbol","type":"topic","identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/Disabled"},"doc://WorldModule/documentation/WorldModule/Targets":{"fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"Targets"}],"url":"\/documentation\/worldmodule\/targets","identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/Targets","navigatorTitle":[{"kind":"identifier","text":"Targets"}],"role":"symbol","title":"Targets","type":"topic","kind":"symbol","abstract":[{"text":"The component that holds a source entity’s targets of a relation, with the relation’s value","type":"text"},{"text":" ","type":"text"},{"text":"for each.","type":"text"}]},"doc://WorldModule/documentation/WorldModule/World/applyQueuedCommands()":{"kind":"symbol","url":"\/documentation\/worldmodule\/world\/applyqueuedcommands()","identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/World\/applyQueuedCommands()","type":"topic","role":"symbol","title":"applyQueuedCommands()","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"applyQueuedCommands"},{"kind":"text","text":"() -> ["},{"text":"Entity","kind":"typeIdentifier","preciseIdentifier":"s:11WorldModule6EntityV"},{"text":"]","kind":"text"}],"abstract":[{"type":"text","text":"Applies every queued command buffer, in the order the buffers were queued, and empties the"},{"type":"text","text":" "},{"type":"text","text":"queue."}]}}}