orldModule\/documentation\/WorldModule\/ConcurrentChange"},"doc://WorldModule/documentation/WorldModule/World/applyQueuedCommands()":{"abstract":[{"type":"text","text":"Applies every queued command buffer, in the order the buffers were queued, and empties the"},{"type":"text","text":" "},{"type":"text","text":"queue."}],"role":"symbol","title":"applyQueuedCommands()","url":"\/documentation\/worldmodule\/world\/applyqueuedcommands()","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"applyQueuedCommands","kind":"identifier"},{"text":"() -> [","kind":"text"},{"text":"Entity","kind":"typeIdentifier","preciseIdentifier":"s:11WorldModule6EntityV"},{"text":"]","kind":"text"}],"identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/World\/applyQueuedCommands()","kind":"symbol","type":"topic"},"doc://WorldModule/documentation/WorldModule/World/queue(_:)":{"abstract":[{"text":"Adds a command buffer to the world’s queue, to apply later with","type":"text"},{"text":" ","type":"text"},{"identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/World\/applyQueuedCommands()","type":"reference","isActive":true},{"text":".","type":"text"}],"role":"symbol","title":"queue(_:)","url":"\/documentation\/worldmodule\/world\/queue(_:)","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"queue","kind":"identifier"},{"kind":"text","text":"("},{"preciseIdentifier":"s:11WorldModule8CommandsV","kind":"typeIdentifier","text":"Commands"},{"kind":"text","text":")"}],"identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/World\/queue(_:)","kind":"symbol","type":"topic"}}}