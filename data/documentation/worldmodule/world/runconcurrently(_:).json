{"abstract":[{"text":"Runs changes at the same time, each on its own copy of the world, and keeps what each one","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"wrote."}],"metadata":{"remoteSource":{"url":"https:\/\/github.com\/Tyler-Keith-Thompson\/ECS\/blob\/main\/Sources\/WorldModule\/Concurrency.swift#L264","fileName":"Concurrency.swift"},"roleHeading":"Instance Method","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"runConcurrently"},{"text":"([","kind":"text"},{"text":"ConcurrentChange","kind":"typeIdentifier","preciseIdentifier":"s:11WorldModule16ConcurrentChangeV"},{"text":"])","kind":"text"}],"role":"symbol","externalID":"s:11WorldModule0A0V15runConcurrentlyyySayAA16ConcurrentChangeVGF","modules":[{"name":"WorldModule"}],"extendedModule":"WorldModule","title":"runConcurrently(_:)","symbolKind":"method"},"sections":[],"schemaVersion":{"minor":3,"major":0,"patch":0},"kind":"symbol","identifier":{"interfaceLanguage":"swift","url":"doc:\/\/WorldModule\/documentation\/WorldModule\/World\/runConcurrently(_:)"},"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/worldmodule\/world\/runconcurrently(_:)"]}],"hierarchy":{"paths":[["doc:\/\/WorldModule\/documentation\/WorldModule","doc:\/\/WorldModule\/documentation\/WorldModule\/World"]]},"primaryContentSections":[{"kind":"declarations","declarations":[{"platforms":["Linux"],"languages":["swift"],"tokens":[{"kind":"keyword","text":"mutating"},{"kind":"text","text":" "},{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"runConcurrently"},{"kind":"text","text":"("},{"kind":"externalParam","text":"_"},{"kind":"text","text":" "},{"kind":"internalParam","text":"changes"},{"kind":"text","text":": ["},{"identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/ConcurrentChange","kind":"typeIdentifier","text":"ConcurrentChange","preciseIdentifier":"s:11WorldModule16ConcurrentChangeV"},{"kind":"text","text":"])"}]}]},{"kind":"parameters","parameters":[{"name":"changes","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The changes to run."}]}]}]},{"kind":"content","content":[{"level":2,"type":"heading","anchor":"discussion","text":"Discussion"},{"type":"paragraph","inlineContent":[{"text":"Use this method to spread independent work across the processor’s cores. Each change reads","type":"text"},{"text":" ","type":"text"},{"text":"the world as it was before any of them ran, and writes only the types its access lists, so","type":"text"},{"text":" ","type":"text"},{"text":"the result is the same as running the changes one after another in any order:","type":"text"}]},{"type":"codeListing","syntax":"swift","code":["var world = World()","let ball = world.spawn(Position(x: 0, y: 0), Velocity(dx: 1, dy: 0), Health(current: 10))","","world.runConcurrently([","    ConcurrentChange(access: .reads(Velocity.self).writes(Position.self)) { world in","        world.update(Position.self, reading: Velocity.self) { position, row in","            position.x += row.components.dx","        }","    },","    ConcurrentChange(access: .writes(Health.self)) { world in","        world.update(Health.self) { health, _ in health.current -= 1 }","    },","])","","print(world[Position.self, of: ball].x, world[Health.self, of: ball].current)","\/\/ Prints \"1.0 9\""]},{"type":"paragraph","inlineContent":[{"type":"text","text":"A change sees the components and resources that other changes write as missing, so its"},{"type":"text","text":" "},{"type":"text","text":"access must list everything it reads. Command buffers a change queues with "},{"identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/World\/queue(_:)","type":"reference","isActive":true},{"type":"text","text":" "},{"type":"text","text":"are queued in this world in the order of "},{"code":"changes","type":"codeVoice"},{"type":"text","text":"."}]},{"type":"aside","content":[{"type":"paragraph","inlineContent":[{"text":"A change must write only the component and resource types its access lists,","type":"text"},{"text":" ","type":"text"},{"text":"and must not spawn or despawn entities. It writes relations through their ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/Targets"},{"text":" ","type":"text"},{"text":"components, and the hierarchy through ","type":"text"},{"type":"codeVoice","code":"Targets<ChildOf>"},{"text":".","type":"text"}]}],"style":"important","name":"Important"},{"type":"aside","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"O("},{"type":"emphasis","inlineContent":[{"text":"c","type":"text"}]},{"type":"text","text":"·"},{"type":"emphasis","inlineContent":[{"type":"text","text":"t"}]},{"type":"text","text":"), besides the cost of the changes themselves, where "},{"type":"emphasis","inlineContent":[{"type":"text","text":"c"}]},{"type":"text","text":" is the"},{"type":"text","text":" "},{"type":"text","text":"number of changes and "},{"type":"emphasis","inlineContent":[{"type":"text","text":"t"}]},{"type":"text","text":" is the number of component types the world has stored."}]}],"style":"note","name":"Complexity"},{"type":"aside","content":[{"type":"paragraph","inlineContent":[{"text":"No two accesses conflict, and each change writes only what its access","type":"text"},{"text":" ","type":"text"},{"text":"lists and spawns and despawns nothing; a change that breaks this traps. In debug builds,","type":"text"},{"text":" ","type":"text"},{"text":"a change that reads a component or resource type its access doesn’t list traps too. Any","type":"text"},{"text":" ","type":"text"},{"text":"change may read ","type":"text"},{"identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/Disabled","isActive":true,"type":"reference"},{"text":" and ","type":"text"},{"identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/Prefab","isActive":true,"type":"reference"},{"text":".","type":"text"}]}],"style":"note","name":"Precondition"}]}],"references":{"doc://WorldModule/documentation/WorldModule/World/runConcurrently(_:)":{"type":"topic","kind":"symbol","title":"runConcurrently(_:)","url":"\/documentation\/worldmodule\/world\/runconcurrently(_:)","role":"symbol","identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/World\/runConcurrently(_:)","abstract":[{"type":"text","text":"Runs changes at the same time, each on its own copy of the world, and keeps what each one"},{"type":"text","text":" "},{"type":"text","text":"wrote."}],"fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"runConcurrently","kind":"identifier"},{"text":"([","kind":"text"},{"text":"ConcurrentChange","kind":"typeIdentifier","preciseIdentifier":"s:11WorldModule16ConcurrentChangeV"},{"text":"])","kind":"text"}]},"doc://WorldModule/documentation/WorldModule/Prefab":{"type":"topic","kind":"symbol","title":"Prefab","url":"\/documentation\/worldmodule\/prefab","role":"symbol","identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/Prefab","abstract":[{"type":"text","text":"A component that marks an entity as a template for spawning copies."}],"navigatorTitle":[{"text":"Prefab","kind":"identifier"}],"fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Prefab","kind":"identifier"}]},"doc://WorldModule/documentation/WorldModule/World/applyQueuedCommands()":{"type":"topic","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"applyQueuedCommands","kind":"identifier"},{"text":"() -> [","kind":"text"},{"kind":"typeIdentifier","text":"Entity","preciseIdentifier":"s:11WorldModule6EntityV"},{"kind":"text","text":"]"}],"kind":"symbol","role":"symbol","title":"applyQueuedCommands()","url":"\/documentation\/worldmodule\/world\/applyqueuedcommands()","abstract":[{"type":"text","text":"Applies every queued command buffer, in the order the buffers were queued, and empties the"},{"type":"text","text":" "},{"type":"text","text":"queue."}],"identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/World\/applyQueuedCommands()"},"doc://WorldModule/documentation/WorldModule/World":{"type":"topic","title":"World","role":"symbol","abstract":[{"type":"text","text":"A collection of entities, the components they hold, and resources."}],"fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"World"}],"kind":"symbol","navigatorTitle":[{"kind":"identifier","text":"World"}],"url":"\/documentation\/worldmodule\/world","identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/World"},"doc://WorldModule/documentation/WorldModule/World/queue(_:)":{"type":"topic","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"queue"},{"kind":"text","text":"("},{"kind":"typeIdentifier","preciseIdentifier":"s:11WorldModule8CommandsV","text":"Commands"},{"kind":"text","text":")"}],"kind":"symbol","role":"symbol","title":"queue(_:)","url":"\/documentation\/worldmodule\/world\/queue(_:)","abstract":[{"type":"text","text":"Adds a command buffer to the world’s queue, to apply later with"},{"type":"text","text":" "},{"isActive":true,"type":"reference","identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/World\/applyQueuedCommands()"},{"type":"text","text":"."}],"identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/World\/queue(_:)"},"doc://WorldModule/documentation/WorldModule":{"type":"topic","kind":"symbol","role":"collection","title":"WorldModule","url":"\/documentation\/worldmodule","abstract":[{"text":"Store the state of a game or simulation as entities and components, and read and change it with","type":"text"},{"text":" ","type":"text"},{"text":"queries, updates, and commands.","type":"text"}],"identifier":"doc:\/\/WorldModule\/documentation\/WorldModule"},"doc://WorldModule/documentation/WorldModule/Targets":{"type":"topic","url":"\/documentation\/worldmodule\/targets","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Targets","kind":"identifier"}],"kind":"symbol","navigatorTitle":[{"text":"Targets","kind":"identifier"}],"abstract":[{"text":"The component that holds a source entity’s targets of a relation, with the relation’s value","type":"text"},{"text":" ","type":"text"},{"text":"for each.","type":"text"}],"title":"Targets","identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/Targets","role":"symbol"},"doc://WorldModule/documentation/WorldModule/ConcurrentChange":{"type":"topic","title":"ConcurrentChange","role":"symbol","abstract":[{"text":"A change to a world, paired with the access that describes what it reads and writes.","type":"text"}],"fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"ConcurrentChange","kind":"identifier"}],"kind":"symbol","navigatorTitle":[{"text":"ConcurrentChange","kind":"identifier"}],"url":"\/documentation\/worldmodule\/concurrentchange","identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/ConcurrentChange"},"doc://WorldModule/documentation/WorldModule/Disabled":{"type":"topic","title":"Disabled","role":"symbol","abstract":[{"type":"text","text":"A component that makes queries and updates skip an entity, unless they ask for it."}],"fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Disabled","kind":"identifier"}],"kind":"symbol","navigatorTitle":[{"text":"Disabled","kind":"identifier"}],"url":"\/documentation\/worldmodule\/disabled","identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/Disabled"}}}