{"sections":[],"variants":[{"paths":["\/documentation\/worldmodule\/world\/runconcurrently(_:)"],"traits":[{"interfaceLanguage":"swift"}]}],"identifier":{"url":"doc:\/\/WorldModule\/documentation\/WorldModule\/World\/runConcurrently(_:)","interfaceLanguage":"swift"},"schemaVersion":{"patch":0,"major":0,"minor":3},"hierarchy":{"paths":[["doc:\/\/WorldModule\/documentation\/WorldModule","doc:\/\/WorldModule\/documentation\/WorldModule\/World"]]},"kind":"symbol","metadata":{"fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"runConcurrently","kind":"identifier"},{"text":"([","kind":"text"},{"preciseIdentifier":"s:11WorldModule16ConcurrentChangeV","text":"ConcurrentChange","kind":"typeIdentifier"},{"text":"])","kind":"text"}],"roleHeading":"Instance Method","title":"runConcurrently(_:)","remoteSource":{"url":"https:\/\/github.com\/Tyler-Keith-Thompson\/ECS\/blob\/main\/Sources\/WorldModule\/Concurrency.swift#L264","fileName":"Concurrency.swift"},"modules":[{"name":"WorldModule"}],"extendedModule":"WorldModule","role":"symbol","externalID":"s:11WorldModule0A0V15runConcurrentlyyySayAA16ConcurrentChangeVGF","symbolKind":"method"},"abstract":[{"text":"Runs changes at the same time, each on its own copy of the world, and keeps what each one","type":"text"},{"text":" ","type":"text"},{"text":"wrote.","type":"text"}],"primaryContentSections":[{"declarations":[{"platforms":["Linux"],"tokens":[{"text":"mutating","kind":"keyword"},{"text":" ","kind":"text"},{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"runConcurrently","kind":"identifier"},{"text":"(","kind":"text"},{"text":"_","kind":"externalParam"},{"text":" ","kind":"text"},{"text":"changes","kind":"internalParam"},{"text":": [","kind":"text"},{"text":"ConcurrentChange","identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/ConcurrentChange","kind":"typeIdentifier","preciseIdentifier":"s:11WorldModule16ConcurrentChangeV"},{"text":"])","kind":"text"}],"languages":["swift"]}],"kind":"declarations"},{"parameters":[{"content":[{"inlineContent":[{"type":"text","text":"The changes to run."}],"type":"paragraph"}],"name":"changes"}],"kind":"parameters"},{"content":[{"level":2,"text":"Discussion","anchor":"discussion","type":"heading"},{"inlineContent":[{"type":"text","text":"Use this method to spread independent work across the processor’s cores. Each change reads"},{"type":"text","text":" "},{"type":"text","text":"the world as it was before any of them ran, and writes only the types its access lists, so"},{"type":"text","text":" "},{"type":"text","text":"the result is the same as running the changes one after another in any order:"}],"type":"paragraph"},{"code":["var world = World()","let ball = world.spawn(Position(x: 0, y: 0), Velocity(dx: 1, dy: 0), Health(current: 10))","","world.runConcurrently([","    ConcurrentChange(access: .reads(Velocity.self).writes(Position.self)) { world in","        world.update(Position.self, reading: Velocity.self) { position, row in","            position.x += row.components.dx","        }","    },","    ConcurrentChange(access: .writes(Health.self)) { world in","        world.update(Health.self) { health, _ in health.current -= 1 }","    },","])","","print(world[Position.self, of: ball].x, world[Health.self, of: ball].current)","\/\/ Prints \"1.0 9\""],"syntax":"swift","type":"codeListing"},{"inlineContent":[{"text":"A change sees the components and resources that other changes write as missing, so its","type":"text"},{"text":" ","type":"text"},{"text":"access must list everything it reads. Command buffers a change queues with ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/World\/queue(_:)"},{"text":" ","type":"text"},{"text":"are queued in this world in the order of ","type":"text"},{"type":"codeVoice","code":"changes"},{"text":".","type":"text"}],"type":"paragraph"},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"A change must write only the component and resource types its access lists,"},{"type":"text","text":" "},{"type":"text","text":"and must not spawn or despawn entities. It writes relations through their "},{"type":"reference","identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/Targets","isActive":true},{"type":"text","text":" "},{"type":"text","text":"components, and the hierarchy through "},{"type":"codeVoice","code":"Targets<ChildOf>"},{"type":"text","text":"."}]}],"name":"Important","type":"aside","style":"important"},{"content":[{"type":"paragraph","inlineContent":[{"text":"O(","type":"text"},{"inlineContent":[{"type":"text","text":"c"}],"type":"emphasis"},{"text":"·","type":"text"},{"inlineContent":[{"type":"text","text":"t"}],"type":"emphasis"},{"text":"), besides the cost of the changes themselves, where ","type":"text"},{"inlineContent":[{"type":"text","text":"c"}],"type":"emphasis"},{"text":" is the","type":"text"},{"text":" ","type":"text"},{"text":"number of changes and ","type":"text"},{"inlineContent":[{"type":"text","text":"t"}],"type":"emphasis"},{"text":" is the number of component types the world has stored.","type":"text"}]}],"name":"Complexity","type":"aside","style":"note"},{"content":[{"inlineContent":[{"text":"No two accesses conflict, and each change writes only what its access","type":"text"},{"text":" ","type":"text"},{"text":"lists and spawns and despawns nothing; a change that breaks this traps. In debug builds,","type":"text"},{"text":" ","type":"text"},{"text":"a change that reads a component or resource type its access doesn’t list traps too. Any","type":"text"},{"text":" ","type":"text"},{"text":"change may read ","type":"text"},{"identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/Disabled","isActive":true,"type":"reference"},{"text":" and ","type":"text"},{"identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/Prefab","isActive":true,"type":"reference"},{"text":".","type":"text"}],"type":"paragraph"}],"name":"Precondition","type":"aside","style":"note"}],"kind":"content"}],"references":{"doc://WorldModule/documentation/WorldModule/World/queue(_:)":{"role":"symbol","type":"topic","abstract":[{"type":"text","text":"Adds a command buffer to the world’s queue, to apply later with"},{"type":"text","text":" "},{"type":"reference","isActive":true,"identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/World\/applyQueuedCommands()"},{"type":"text","text":"."}],"kind":"symbol","title":"queue(_:)","url":"\/documentation\/worldmodule\/world\/queue(_:)","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"queue","kind":"identifier"},{"kind":"text","text":"("},{"kind":"typeIdentifier","preciseIdentifier":"s:11WorldModule8CommandsV","text":"Commands"},{"kind":"text","text":")"}],"identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/World\/queue(_:)"},"doc://WorldModule/documentation/WorldModule/World/runConcurrently(_:)":{"role":"symbol","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"runConcurrently"},{"kind":"text","text":"(["},{"preciseIdentifier":"s:11WorldModule16ConcurrentChangeV","text":"ConcurrentChange","kind":"typeIdentifier"},{"text":"])","kind":"text"}],"abstract":[{"text":"Runs changes at the same time, each on its own copy of the world, and keeps what each one","type":"text"},{"text":" ","type":"text"},{"text":"wrote.","type":"text"}],"url":"\/documentation\/worldmodule\/world\/runconcurrently(_:)","type":"topic","title":"runConcurrently(_:)","kind":"symbol","identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/World\/runConcurrently(_:)"},"doc://WorldModule/documentation/WorldModule/World":{"role":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"World","kind":"identifier"}],"abstract":[{"text":"A collection of entities, the components they hold, and resources.","type":"text"}],"url":"\/documentation\/worldmodule\/world","type":"topic","navigatorTitle":[{"text":"World","kind":"identifier"}],"title":"World","kind":"symbol","identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/World"},"doc://WorldModule/documentation/WorldModule/World/applyQueuedCommands()":{"fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"applyQueuedCommands","kind":"identifier"},{"text":"() -> [","kind":"text"},{"kind":"typeIdentifier","preciseIdentifier":"s:11WorldModule6EntityV","text":"Entity"},{"kind":"text","text":"]"}],"title":"applyQueuedCommands()","kind":"symbol","identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/World\/applyQueuedCommands()","role":"symbol","type":"topic","abstract":[{"type":"text","text":"Applies every queued command buffer, in the order the buffers were queued, and empties the"},{"type":"text","text":" "},{"type":"text","text":"queue."}],"url":"\/documentation\/worldmodule\/world\/applyqueuedcommands()"},"doc://WorldModule/documentation/WorldModule/Prefab":{"kind":"symbol","url":"\/documentation\/worldmodule\/prefab","title":"Prefab","identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/Prefab","role":"symbol","navigatorTitle":[{"kind":"identifier","text":"Prefab"}],"type":"topic","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"Prefab"}],"abstract":[{"type":"text","text":"A component that marks an entity as a template for spawning copies."}]},"doc://WorldModule/documentation/WorldModule/Targets":{"kind":"symbol","title":"Targets","identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/Targets","url":"\/documentation\/worldmodule\/targets","role":"symbol","navigatorTitle":[{"text":"Targets","kind":"identifier"}],"type":"topic","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Targets","kind":"identifier"}],"abstract":[{"type":"text","text":"The component that holds a source entity’s targets of a relation, with the relation’s value"},{"type":"text","text":" "},{"type":"text","text":"for each."}]},"doc://WorldModule/documentation/WorldModule/ConcurrentChange":{"kind":"symbol","title":"ConcurrentChange","identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/ConcurrentChange","url":"\/documentation\/worldmodule\/concurrentchange","role":"symbol","navigatorTitle":[{"text":"ConcurrentChange","kind":"identifier"}],"type":"topic","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"ConcurrentChange","kind":"identifier"}],"abstract":[{"text":"A change to a world, paired with the access that describes what it reads and writes.","type":"text"}]},"doc://WorldModule/documentation/WorldModule":{"identifier":"doc:\/\/WorldModule\/documentation\/WorldModule","role":"collection","kind":"symbol","type":"topic","abstract":[{"type":"text","text":"Store the state of a game or simulation as entities and components, and read and change it with"},{"type":"text","text":" "},{"type":"text","text":"queries, updates, and commands."}],"url":"\/documentation\/worldmodule","title":"WorldModule"},"doc://WorldModule/documentation/WorldModule/Disabled":{"kind":"symbol","title":"Disabled","identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/Disabled","url":"\/documentation\/worldmodule\/disabled","role":"symbol","navigatorTitle":[{"text":"Disabled","kind":"identifier"}],"type":"topic","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Disabled","kind":"identifier"}],"abstract":[{"type":"text","text":"A component that makes queries and updates skip an entity, unless they ask for it."}]}}}