{"schemaVersion":{"major":0,"patch":0,"minor":3},"kind":"symbol","identifier":{"url":"doc:\/\/WorldModule\/documentation\/WorldModule\/World\/runConcurrently(_:)","interfaceLanguage":"swift"},"abstract":[{"type":"text","text":"Runs changes at the same time, each on its own copy of the world, and keeps what each one"},{"type":"text","text":" "},{"type":"text","text":"wrote."}],"primaryContentSections":[{"declarations":[{"platforms":["Linux"],"languages":["swift"],"tokens":[{"kind":"keyword","text":"mutating"},{"kind":"text","text":" "},{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"runConcurrently"},{"kind":"text","text":"("},{"kind":"externalParam","text":"_"},{"kind":"text","text":" "},{"kind":"internalParam","text":"changes"},{"kind":"text","text":": ["},{"preciseIdentifier":"s:11WorldModule16ConcurrentChangeV","identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/ConcurrentChange","kind":"typeIdentifier","text":"ConcurrentChange"},{"kind":"text","text":"])"}]}],"kind":"declarations"},{"kind":"parameters","parameters":[{"name":"changes","content":[{"inlineContent":[{"text":"The changes to run.","type":"text"}],"type":"paragraph"}]}]},{"kind":"content","content":[{"type":"heading","level":2,"anchor":"discussion","text":"Discussion"},{"type":"paragraph","inlineContent":[{"text":"Use this method to spread independent work across the processor’s cores. Each change reads","type":"text"},{"text":" ","type":"text"},{"text":"the world as it was before any of them ran, and writes only the types its access lists, so","type":"text"},{"text":" ","type":"text"},{"text":"the result is the same as running the changes one after another in any order:","type":"text"}]},{"type":"codeListing","code":["var world = World()","let ball = world.spawn(Position(x: 0, y: 0), Velocity(dx: 1, dy: 0), Health(current: 10))","","world.runConcurrently([","    ConcurrentChange(access: .reads(Velocity.self).writes(Position.self)) { world in","        world.update(Position.self, reading: Velocity.self) { position, row in","            position.x += row.components.dx","        }","    },","    ConcurrentChange(access: .writes(Health.self)) { world in","        world.update(Health.self) { health, _ in health.current -= 1 }","    },","])","","print(world[Position.self, of: ball].x, world[Health.self, of: ball].current)","\/\/ Prints \"1.0 9\""],"syntax":"swift"},{"type":"paragraph","inlineContent":[{"text":"A change sees the components and resources that other changes write as missing, so its","type":"text"},{"text":" ","type":"text"},{"text":"access must list everything it reads. Command buffers a change queues with ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/World\/queue(_:)"},{"text":" ","type":"text"},{"text":"are queued in this world in the order of ","type":"text"},{"code":"changes","type":"codeVoice"},{"text":".","type":"text"}]},{"type":"aside","content":[{"inlineContent":[{"text":"A change must write only the component and resource types its access lists,","type":"text"},{"text":" ","type":"text"},{"text":"and must not spawn or despawn entities. It writes relations through their ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/Targets"},{"text":" ","type":"text"},{"text":"components, and the hierarchy through ","type":"text"},{"code":"Targets<ChildOf>","type":"codeVoice"},{"text":".","type":"text"}],"type":"paragraph"}],"name":"Important","style":"important"},{"type":"aside","content":[{"inlineContent":[{"text":"O(","type":"text"},{"inlineContent":[{"text":"c","type":"text"}],"type":"emphasis"},{"text":"·","type":"text"},{"inlineContent":[{"type":"text","text":"t"}],"type":"emphasis"},{"text":"), besides the cost of the changes themselves, where ","type":"text"},{"inlineContent":[{"type":"text","text":"c"}],"type":"emphasis"},{"text":" is the","type":"text"},{"text":" ","type":"text"},{"text":"number of changes and ","type":"text"},{"inlineContent":[{"text":"t","type":"text"}],"type":"emphasis"},{"text":" is the number of component types the world has stored.","type":"text"}],"type":"paragraph"}],"name":"Complexity","style":"note"},{"type":"aside","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"No two accesses conflict, and each change writes only what its access"},{"type":"text","text":" "},{"type":"text","text":"lists and spawns and despawns nothing; a change that breaks this traps. In debug builds,"},{"type":"text","text":" "},{"type":"text","text":"a change that reads a component or resource type its access doesn’t list traps too. Any"},{"type":"text","text":" "},{"type":"text","text":"change may read "},{"identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/Disabled","type":"reference","isActive":true},{"type":"text","text":" and "},{"identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/Prefab","type":"reference","isActive":true},{"type":"text","text":"."}]}],"name":"Precondition","style":"note"}]}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/worldmodule\/world\/runconcurrently(_:)"]}],"sections":[],"metadata":{"fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"runConcurrently","kind":"identifier"},{"text":"([","kind":"text"},{"text":"ConcurrentChange","kind":"typeIdentifier","preciseIdentifier":"s:11WorldModule16ConcurrentChangeV"},{"text":"])","kind":"text"}],"extendedModule":"WorldModule","role":"symbol","modules":[{"name":"WorldModule"}],"title":"runConcurrently(_:)","symbolKind":"method","externalID":"s:11WorldModule0A0V15runConcurrentlyyySayAA16ConcurrentChangeVGF","roleHeading":"Instance Method","remoteSource":{"url":"https:\/\/github.com\/Tyler-Keith-Thompson\/ECS\/blob\/main\/Sources\/WorldModule\/Concurrency.swift#L264","fileName":"Concurrency.swift"}},"hierarchy":{"paths":[["doc:\/\/WorldModule\/documentati