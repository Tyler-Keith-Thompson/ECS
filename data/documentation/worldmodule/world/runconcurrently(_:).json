{"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/worldmodule\/world\/runconcurrently(_:)"]}],"sections":[],"kind":"symbol","hierarchy":{"paths":[["doc:\/\/WorldModule\/documentation\/WorldModule","doc:\/\/WorldModule\/documentation\/WorldModule\/World"]]},"primaryContentSections":[{"kind":"declarations","declarations":[{"platforms":["Linux"],"languages":["swift"],"tokens":[{"kind":"keyword","text":"mutating"},{"kind":"text","text":" "},{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"runConcurrently"},{"kind":"text","text":"("},{"kind":"externalParam","text":"_"},{"kind":"text","text":" "},{"kind":"internalParam","text":"changes"},{"kind":"text","text":": ["},{"preciseIdentifier":"s:11WorldModule16ConcurrentChangeV","kind":"typeIdentifier","text":"ConcurrentChange","identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/ConcurrentChange"},{"kind":"text","text":"])"}]}]},{"kind":"parameters","parameters":[{"content":[{"inlineContent":[{"text":"The changes to run.","type":"text"}],"type":"paragraph"}],"name":"changes"}]},{"kind":"content","content":[{"type":"heading","text":"Discussion","anchor":"discussion","level":2},{"type":"paragraph","inlineContent":[{"type":"text","text":"Use this method to spread independent work across the processor’s cores. Each change reads"},{"type":"text","text":" "},{"type":"text","text":"the world as it was before any of them ran, and writes only the types its access lists, so"},{"type":"text","text":" "},{"type":"text","text":"the result is the same as running the changes one after another in any order:"}]},{"type":"codeListing","syntax":"swift","code":["var world = World()","let ball = world.spawn(Position(x: 0, y: 0), Velocity(dx: 1, dy: 0), Health(current: 10))","","world.runConcurrently([","    ConcurrentChange(access: .reads(Velocity.self).writes(Position.self)) { world in","        world.update(Position.self, reading: Velocity.self) { position, row in","            position.x += row.components.dx","        }","    },","    ConcurrentChange(access: .writes(Health.self)) { world in","        world.update(Health.self) { health, _ in health.current -= 1 }","    },","])","","print(world[Position.self, of: ball].x, world[Health.self, of: ball].current)","\/\/ Prints \"1.0 9\""]},{"type":"paragraph","inlineContent":[{"text":"A change sees the components and resources that other changes write as missing, so its","type":"text"},{"text":" ","type":"text"},{"text":"access must list everything it reads. Command buffers a change queues with ","type":"text"},{"isActive":true,"identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/World\/queue(_:)","type":"reference"},{"text":" ","type":"text"},{"text":"are queued in this world in the order of ","type":"text"},{"type":"codeVoice","code":"changes"},{"text":".","type":"text"}]},{"type":"aside","style":"important","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"A change must write only the component and resource types its access lists,"},{"type":"text","text":" "},{"type":"text","text":"and must not spawn or despawn entities. It writes relations through their "},{"type":"reference","identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/Targets","isActive":true},{"type":"text","text":" "},{"type":"text","text":"components, and the hierarchy through "},{"type":"codeVoice","code":"Targets<ChildOf>"},{"type":"text","text":"."}]}],"name":"Important"},{"type":"aside","style":"note","content":[{"type":"paragraph","inlineContent":[{"text":"O(","type":"text"},{"inlineContent":[{"text":"c","type":"text"}],"type":"emphasis"},{"text":"·","type":"text"},{"inlineContent":[{"type":"text","text":"t"}],"type":"emphasis"},{"text":"), besides the cost of the changes themselves, where ","type":"text"},{"inlineContent":[{"type":"text","text":"c"}],"type":"emphasis"},{"text":" is the","type":"text"},{"text":" ","type":"text"},{"text":"number of changes and ","type":"text"},{"inlineContent":[{"text":"t","type":"text"}],"type":"emphasis"},{"text":" is the number of component types the world has stored.","type":"text"}]}],"name":"Complexity"},{"type":"aside","style":"note","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"No two accesses conflict, and each change writes only what its access"},{"type":"text","text":" "},{"type":"text","text":"lists and spawns and despawns nothing; a change that breaks this traps. In debug builds,"},{"type":"text","text":" "},{"type":"text","text":"a change that reads a component or resource type its access doesn’t list traps too. Any"},{"type":"text","text":" "},{"type":"text","text":"change may read "},{"type":"reference","identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/Disabled","isActive":true},{"type":"text","text":" and "},{"type":"reference","identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/Prefab","isActive":true},{"type":"text","text":"."}]}],"name":"Precondition"}]}],"metadata":{"symbolKind":"method","externalID":"s:11WorldModule0A0V15runConcurrentlyyySayAA16ConcurrentChangeVGF","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"runConcurrently","kind":"identifier"},{"text":"([","kind":"text"},{"text":"ConcurrentChange","kind":"typeIdentifier","preciseIdentifier":"s:11WorldModule16ConcurrentChangeV"},{"text":"])","kind":"text"}],"title":"runConcurrently(_:)","role":"symbol","extendedModule":"WorldModule","remoteSource":{"url":"https:\/\/github.com\/Tyler-Keith-Thompson\/ECS\/blob\/main\/Sources\/WorldModule\/Concurrency.swift#L264","fileName":"Concurrency.swift"},"roleHeading":"Instance Method","modules":[{"name":"WorldModule"}]},"abstract":[{"type":"text","text":"Runs changes at the same time, each on its own copy of the world, and keeps what each one"},{"type":"text","text":" "},{"type":"text","text":"wrote."}],"schemaVersion":{"major":0,"minor":3,"patch":0},"identifier":{"url":"doc:\/\/WorldModule\/documentation\/WorldModule\/World\/runConcurrently(_:)","interfaceLanguage":"swift"},"references":{"doc://WorldModule/documentation/WorldModule/World":{"kind":"symbol","abstract":[{"text":"A collection of entities, the components they hold, and resources.","type":"text"}],"identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/World","url":"\/documentation\/worldmodule\/world","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"World"}],"title":"World","navigatorTitle":[{"kind":"identifier","text":"World"}],"role":"symbol","type":"topic"},"doc://WorldModule/documentation/WorldModule/Disabled":{"type":"topic","abstract":[{"type":"text","text":"A component that makes queries and updates skip an entity, unless they ask for it."}],"role":"symbol","navigatorTitle":[{"text":"Disabled","kind":"identifier"}],"identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/Disabled","url":"\/documentation\/worldmodule\/disabled","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Disabled","kind":"identifier"}],"kind":"symbol","title":"Disabled"},"doc://WorldModule/documentation/WorldModule/Targets":{"kind":"symbol","abstract":[{"type":"text","text":"The component that holds a source entity’s targets of a relation, with the relation’s value"},{"type":"text","text":" "},{"type":"text","text":"for each."}],"identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/Targets","url":"\/documentation\/worldmodule\/targets","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"Targets"}],"title":"Targets","navigatorTitle":[{"kind":"identifier","text":"Targets"}],"role":"symbol","type":"topic"},"doc://WorldModule/documentation/WorldModule/Prefab":{"type":"topic","abstract":[{"text":"A component that marks an entity as a template for spawning copies.","type":"text"}],"role":"symbol","navigatorTitle":[{"kind":"identifier","text":"Prefab"}],"identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/Prefab","url":"\/documentation\/worldmodule\/prefab","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"Prefab"}],"kind":"symbol","title":"Prefab"},"doc://WorldModule/documentation/WorldModule/ConcurrentChange":{"identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/ConcurrentChange","kind":"symbol","type":"topic","url":"\/documentation\/worldmodule\/concurrentchange","role":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"ConcurrentChange","kind":"identifier"}],"title":"ConcurrentChange","navigatorTitle":[{"text":"ConcurrentChange","kind":"identifier"}],"abstract":[{"type":"text","text":"A change to a world, paired with the access that describes what it reads and writes."}]},"doc://WorldModule/documentation/WorldModule/World/runConcurrently(_:)":{"identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/World\/runConcurrently(_:)","kind":"symbol","type":"topic","url":"\/documentation\/worldmodule\/world\/runconcurrently(_:)","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"runConcurrently"},{"kind":"text","text":"(["},{"kind":"typeIdentifier","preciseIdentifier":"s:11WorldModule16ConcurrentChangeV","text":"ConcurrentChange"},{"kind":"text","text":"])"}],"title":"runConcurrently(_:)","abstract":[{"type":"text","text":"Runs changes at the same time, each on its own copy of the world, and keeps what each one"},{"type":"text","text":" "},{"type":"text","text":"wrote."}],"role":"symbol"},"doc://WorldModule/documentation/WorldModule/World/applyQueuedCommands()":{"type":"topic","title":"applyQueuedCommands()","url":"\/documentation\/worldmodule\/world\/applyqueuedcommands()","identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/World\/applyQueuedCommands()","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"applyQueuedCommands"},{"kind":"text","text":"() -> ["},{"kind":"typeIdentifier","preciseIdentifier":"s:11WorldModule6EntityV","text":"Entity"},{"kind":"text","text":"]"}],"abstract":[{"type":"text","text":"Applies every queued command buffer, in the order the buffers were queued, and empties the"},{"type":"text","text":" "},{"type":"text","text":"queue."}],"kind":"symbol","role":"symbol"},"doc://WorldModule/documentation/WorldModule":{"kind":"symbol","abstract":[{"text":"Store the state of a game or simulation as entities and components, and read and change it with","type":"text"},{"text":" ","type":"text"},{"text":"queries, updates, and commands.","type":"text"}],"identifier":"doc:\/\/WorldModule\/documentation\/WorldModule","url":"\/documentation\/worldmodule","title":"WorldModule","role":"collection","type":"topic"},"doc://WorldModule/documentation/WorldModule/World/queue(_:)":{"type":"topic","title":"queue(_:)","url":"\/documentation\/worldmodule\/world\/queue(_:)","identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/World\/queue(_:)","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"queue","kind":"identifier"},{"kind":"text","text":"("},{"kind":"typeIdentifier","preciseIdentifier":"s:11WorldModule8CommandsV","text":"Commands"},{"kind":"text","text":")"}],"abstract":[{"type":"text","text":"Adds a command buffer to the world’s queue, to apply later with"},{"type":"text","text":" "},{"type":"reference","isActive":true,"identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/World\/applyQueuedCommands()"},{"type":"text","text":"."}],"kind":"symbol","role":"symbol"}}}