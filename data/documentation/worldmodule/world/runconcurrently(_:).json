{"abstract":[{"type":"text","text":"Runs changes at the same time, each on its own copy of the world, and keeps what each one"},{"type":"text","text":" "},{"type":"text","text":"wrote."}],"sections":[],"schemaVersion":{"minor":3,"patch":0,"major":0},"metadata":{"title":"runConcurrently(_:)","extendedModule":"WorldModule","modules":[{"name":"WorldModule"}],"externalID":"s:11WorldModule0A0V15runConcurrentlyyySayAA16ConcurrentChangeVGF","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"runConcurrently","kind":"identifier"},{"kind":"text","text":"(["},{"kind":"typeIdentifier","preciseIdentifier":"s:11WorldModule16ConcurrentChangeV","text":"ConcurrentChange"},{"kind":"text","text":"])"}],"roleHeading":"Instance Method","symbolKind":"method","remoteSource":{"url":"https:\/\/github.com\/Tyler-Keith-Thompson\/ECS\/blob\/main\/Sources\/WorldModule\/Concurrency.swift#L264","fileName":"Concurrency.swift"},"role":"symbol"},"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/worldmodule\/world\/runconcurrently(_:)"]}],"kind":"symbol","identifier":{"url":"doc:\/\/WorldModule\/documentation\/WorldModule\/World\/runConcurrently(_:)","interfaceLanguage":"swift"},"primaryContentSections":[{"declarations":[{"languages":["swift"],"tokens":[{"text":"mutating","kind":"keyword"},{"text":" ","kind":"text"},{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"runConcurrently","kind":"identifier"},{"text":"(","kind":"text"},{"text":"_","kind":"externalParam"},{"text":" ","kind":"text"},{"text":"changes","kind":"internalParam"},{"text":": [","kind":"text"},{"identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/ConcurrentChange","text":"ConcurrentChange","preciseIdentifier":"s:11WorldModule16ConcurrentChangeV","kind":"typeIdentifier"},{"text":"])","kind":"text"}],"platforms":["Linux"]}],"kind":"declarations"},{"kind":"parameters","parameters":[{"content":[{"inlineContent":[{"text":"The changes to run.","type":"text"}],"type":"paragraph"}],"name":"changes"}]},{"kind":"content","content":[{"level":2,"anchor":"discussion","text":"Discussion","type":"heading"},{"inlineContent":[{"type":"text","text":"Use this method to spread independent work across the processor’s cores. Each change reads"},{"type":"text","text":" "},{"type":"text","text":"the world as it was before any of them ran, and writes only the types its access lists, so"},{"type":"text","text":" "},{"type":"text","text":"the result is the same as running the changes one after another in any order:"}],"type":"paragraph"},{"code":["var world = World()","let ball = world.spawn(Position(x: 0, y: 0), Velocity(dx: 1, dy: 0), Health(current: 10))","","world.runConcurrently([","    ConcurrentChange(access: .reads(Velocity.self).writes(Position.self)) { world in","        world.update(Position.self, reading: Velocity.self) { position, row in","            position.x += row.components.dx","        }","    },","    ConcurrentChange(access: .writes(Health.self)) { world in","        world.update(Health.self) { health, _ in health.current -= 1 }","    },","])","","print(world[Position.self, of: ball].x, world[Health.self, of: ball].current)","\/\/ Prints \"1.0 9\""],"syntax":"swift","type":"codeListing"},{"inlineContent":[{"text":"A change sees the components and resources that other changes write as missing, so its","type":"text"},{"text":" ","type":"text"},{"text":"access must list everything it reads. Command buffers a change queues with ","type":"text"},{"type":"reference","isActive":true,"identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/World\/queue(_:)"},{"text":" ","type":"text"},{"text":"are queued in this world in the order of ","type":"text"},{"type":"codeVoice","code":"changes"},{"text":".","type":"text"}],"type":"paragraph"},{"style":"important","name":"Important","content":[{"inlineContent":[{"type":"text","text":"A change must write only the component and resource types its access lists,"},{"type":"text","text":" "},{"type":"text","text":"and must not spawn or despawn entities. It writes relations through their "},{"isActive":true,"type":"reference","identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/Targets"},{"type":"text","text":" "},{"type":"text","text":"components, and the hierarchy through "},{"code":"Targets<ChildOf>","type":"codeVoice"},{"type":"text","text":"."}],"type":"paragraph"}],"type":"aside"},{"style":"note","name":"Complexity","content":[{"inlineContent":[{"type":"text","text":"O("},{"type":"emphasis","inlineContent":[{"type":"text","text":"c"}]},{"type":"text","text":"·"},{"type":"emphasis","inlineContent":[{"text":"t","type":"text"}]},{"type":"text","text":"), besides the cost of the changes themselves, where "},{"type":"emphasis","inlineContent":[{"text":"c","type":"text"}]},{"type":"text","text":" is the"},{"type":"text","text":" "},{"type":"text","text":"number of changes and "},{"type":"emphasis","inlineContent":[{"type":"text","text":"t"}]},{"type":"text","text":" is the number of component types the world has stored."}],"type":"paragraph"}],"type":"aside"},{"style":"note","name":"Precondition","content":[{"type":"paragraph","inlineContent":[{"text":"No two accesses conflict, and each change writes only what its access","type":"text"},{"text":" ","type":"text"},{"text":"lists and spawns and despawns nothing; a change that breaks this traps. In debug builds,","type":"text"},{"text":" ","type":"text"},{"text":"a change that reads a component or resource type its access doesn’t list traps too. Any","type":"text"},{"text":" ","type":"text"},{"text":"change may read ","type":"text"},{"identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/Disabled","isActive":true,"type":"reference"},{"text":" and ","type":"text"},{"identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/Prefab","isActive":true,"type":"reference"},{"text":".","type":"text"}]}],"type":"aside"}]}],"hierarchy":{"paths":[["doc:\/\/WorldModule\/documentation\/WorldModule","doc:\/\/WorldModule\/documentation\/WorldModule\/World"]]},"references":{"doc://WorldModule/documentation/WorldModule/World":{"type":"topic","navigatorTitle":[{"text":"World","kind":"identifier"}],"url":"\/documentation\/worldmodule\/world","title":"World","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"World","kind":"identifier"}],"identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/World","kind":"symbol","role":"symbol","abstract":[{"text":"A collection of entities, the components they hold, and resources.","type":"text"}]},"doc://WorldModule/documentation/WorldModule/Prefab":{"role":"symbol","title":"Prefab","kind":"symbol","abstract":[{"text":"A component that marks an entity as a template for spawning copies.","type":"text"}],"fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Prefab","kind":"identifier"}],"navigatorTitle":[{"text":"Prefab","kind":"identifier"}],"type":"topic","identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/Prefab","url":"\/documentation\/worldmodule\/prefab"},"doc://WorldModule/documentation/WorldModule/World/queue(_:)":{"role":"symbol","abstract":[{"type":"text","text":"Adds a command buffer to the world’s queue, to apply later with"},{"type":"text","text":" "},{"isActive":true,"type":"reference","identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/World\/applyQueuedCommands()"},{"type":"text","text":"."}],"type":"topic","identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/World\/queue(_:)","url":"\/documentation\/worldmodule\/world\/queue(_:)","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"queue","kind":"identifier"},{"kind":"text","text":"("},{"kind":"typeIdentifier","preciseIdentifier":"s:11WorldModule8CommandsV","text":"Commands"},{"kind":"text","text":")"}],"kind":"symbol","title":"queue(_:)"},"doc://WorldModule/documentation/WorldModule/Disabled":{"role":"symbol","title":"Disabled","abstract":[{"text":"A component that makes queries and updates skip an entity, unless they ask for it.","type":"text"}],"kind":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"Disabled"}],"navigatorTitle":[{"kind":"identifier","text":"Disabled"}],"type":"topic","identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/Disabled","url":"\/documentation\/worldmodule\/disabled"},"doc://WorldModule/documentation/WorldModule":{"role":"collection","type":"topic","abstract":[{"text":"Store the state of a game or simulation as entities and components, and read and change it with","type":"text"},{"text":" ","type":"text"},{"text":"queries, updates, and commands.","type":"text"}],"identifier":"doc:\/\/WorldModule\/documentation\/WorldModule","url":"\/documentation\/worldmodule","kind":"symbol","title":"WorldModule"},"doc://WorldModule/documentation/WorldModule/Targets":{"role":"symbol","type":"topic","abstract":[{"type":"text","text":"The component that holds a source entity’s targets of a relation, with the relation’s value"},{"type":"text","text":" "},{"type":"text","text":"for each."}],"identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/Targets","url":"\/documentation\/worldmodule\/targets","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"Targets"}],"kind":"symbol","navigatorTitle":[{"kind":"identifier","text":"Targets"}],"title":"Targets"},"doc://WorldModule/documentation/WorldModule/ConcurrentChange":{"role":"symbol","title":"ConcurrentChange","kind":"symbol","abstract":[{"text":"A change to a world, paired with the access that describes what it reads and writes.","type":"text"}],"fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"ConcurrentChange"}],"navigatorTitle":[{"kind":"identifier","text":"ConcurrentChange"}],"type":"topic","identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/ConcurrentChange","url":"\/documentation\/worldmodule\/concurrentchange"},"doc://WorldModule/documentation/WorldModule/World/runConcurrently(_:)":{"role":"symbol","type":"topic","abstract":[{"text":"Runs changes at the same time, each on its own copy of the world, and keeps what each one","type":"text"},{"text":" ","type":"text"},{"text":"wrote.","type":"text"}],"identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/World\/runConcurrently(_:)","url":"\/documentation\/worldmodule\/world\/runconcurrently(_:)","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"runConcurrently","kind":"identifier"},{"text":"([","kind":"text"},{"text":"ConcurrentChange","preciseIdentifier":"s:11WorldModule16ConcurrentChangeV","kind":"typeIdentifier"},{"text":"])","kind":"text"}],"kind":"symbol","title":"runConcurrently(_:)"},"doc://WorldModule/documentation/WorldModule/World/applyQueuedCommands()":{"role":"symbol","type":"topic","abstract":[{"type":"text","text":"Applies every queued command buffer, in the order the buffers were queued, and empties the"},{"type":"text","text":" "},{"type":"text","text":"queue."}],"identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/World\/applyQueuedCommands()","url":"\/documentation\/worldmodule\/world\/applyqueuedcommands()","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"applyQueuedCommands","kind":"identifier"},{"text":"() -> [","kind":"text"},{"text":"Entity","kind":"typeIdentifier","preciseIdentifier":"s:11WorldModule6EntityV"},{"text":"]","kind":"text"}],"kind":"symbol","title":"applyQueuedCommands()"}}}