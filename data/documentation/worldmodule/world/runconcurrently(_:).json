{"kind":"symbol","schemaVersion":{"major":0,"minor":3,"patch":0},"hierarchy":{"paths":[["doc:\/\/WorldModule\/documentation\/WorldModule","doc:\/\/WorldModule\/documentation\/WorldModule\/World"]]},"identifier":{"url":"doc:\/\/WorldModule\/documentation\/WorldModule\/World\/runConcurrently(_:)","interfaceLanguage":"swift"},"abstract":[{"text":"Runs changes at the same time, each on its own copy of the world, and keeps what each one","type":"text"},{"text":" ","type":"text"},{"text":"wrote.","type":"text"}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/worldmodule\/world\/runconcurrently(_:)"]}],"sections":[],"metadata":{"role":"symbol","roleHeading":"Instance Method","remoteSource":{"fileName":"Concurrency.swift","url":"https:\/\/github.com\/Tyler-Keith-Thompson\/ECS\/blob\/main\/Sources\/WorldModule\/Concurrency.swift#L264"},"fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"runConcurrently","kind":"identifier"},{"text":"([","kind":"text"},{"text":"ConcurrentChange","kind":"typeIdentifier","preciseIdentifier":"s:11WorldModule16ConcurrentChangeV"},{"text":"])","kind":"text"}],"extendedModule":"WorldModule","title":"runConcurrently(_:)","externalID":"s:11WorldModule0A0V15runConcurrentlyyySayAA16ConcurrentChangeVGF","modules":[{"name":"WorldModule"}],"symbolKind":"method"},"primaryContentSections":[{"kind":"declarations","declarations":[{"tokens":[{"text":"mutating","kind":"keyword"},{"text":" ","kind":"text"},{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"runConcurrently","kind":"identifier"},{"text":"(","kind":"text"},{"text":"_","kind":"externalParam"},{"text":" ","kind":"text"},{"text":"changes","kind":"internalParam"},{"text":": [","kind":"text"},{"identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/ConcurrentChange","preciseIdentifier":"s:11WorldModule16ConcurrentChangeV","text":"ConcurrentChange","kind":"typeIdentifier"},{"text":"])","kind":"text"}],"platforms":["Linux"],"languages":["swift"]}]},{"kind":"parameters","parameters":[{"content":[{"inlineContent":[{"text":"The changes to run.","type":"text"}],"type":"paragraph"}],"name":"changes"}]},{"content":[{"type":"heading","text":"Discussion","anchor":"discussion","level":2},{"type":"paragraph","inlineContent":[{"text":"Use this method to spread independent work across the processor’s cores. Each change reads","type":"text"},{"text":" ","type":"text"},{"text":"the world as it was before any of them ran, and writes only the types its access lists, so","type":"text"},{"text":" ","type":"text"},{"text":"the result is the same as running the changes one after another in any order:","type":"text"}]},{"type":"codeListing","syntax":"swift","code":["var world = World()","let ball = world.spawn(Position(x: 0, y: 0), Velocity(dx: 1, dy: 0), Health(current: 10))","","world.runConcurrently([","    ConcurrentChange(access: .reads(Velocity.self).writes(Position.self)) { world in","        world.update(Position.self, reading: Velocity.self) { position, row in","            position.x += row.components.dx","        }","    },","    ConcurrentChange(access: .writes(Health.self)) { world in","        world.update(Health.self) { health, _ in health.current -= 1 }","    },","])","","print(world[Position.self, of: ball].x, world[Health.self, of: ball].current)","\/\/ Prints \"1.0 9\""]},{"type":"paragraph","inlineContent":[{"type":"text","text":"A change sees the components and resources that other changes write as missing, so its"},{"type":"text","text":" "},{"type":"text","text":"access must list everything it reads. Command buffers a change queues with "},{"identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/World\/queue(_:)","type":"reference","isActive":true},{"type":"text","text":" "},{"type":"text","text":"are queued in this world in the order of "},{"type":"codeVoice","code":"changes"},{"type":"text","text":"."}]},{"name":"Important","type":"aside","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"A change must write only the component and resource types its access lists,"},{"type":"text","text":" "},{"type":"text","text":"and must not spawn or despawn entities. It writes relations through their "},{"type":"reference","identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/Targets","isActive":true},{"type":"text","text":" "},{"type":"text","text":"components, and the hierarchy through "},{"type":"codeVoice","code":"Targets<ChildOf>"},{"type":"text","text":"."}]}],"style":"important"},{"name":"Complexity","type":"aside","content":[{"inlineContent":[{"text":"O(","type":"text"},{"type":"emphasis","inlineContent":[{"type":"text","text":"c"}]},{"text":"·","type":"text"},{"type":"emphasis","inlineContent":[{"type":"text","text":"t"}]},{"text":"), besides the cost of the changes themselves, where ","type":"text"},{"type":"emphasis","inlineContent":[{"type":"text","text":"c"}]},{"text":" is the","type":"text"},{"text":" ","type":"text"},{"text":"number of changes and ","type":"text"},{"type":"emphasis","inlineContent":[{"type":"text","text":"t"}]},{"text":" is the number of component types the world has stored.","type":"text"}],"type":"paragraph"}],"style":"note"},{"name":"Precondition","type":"aside","content":[{"type":"paragraph","inlineContent":[{"text":"No two accesses conflict, and each change writes only what its access","type":"text"},{"text":" ","type":"text"},{"text":"lists and spawns and despawns nothing; a change that breaks this traps. In debug builds,","type":"text"},{"text":" ","type":"text"},{"text":"a change that reads a component or resource type its access doesn’t list traps too. Any","type":"text"},{"text":" ","type":"text"},{"text":"change may read ","type":"text"},{"identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/Disabled","isActive":true,"type":"reference"},{"text":" and ","type":"text"},{"identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/Prefab","isActive":true,"type":"reference"},{"text":".","type":"text"}]}],"style":"note"}],"kind":"content"}],"references":{"doc://WorldModule/documentation/WorldModule/World/runConcurrently(_:)":{"title":"runConcurrently(_:)","type":"topic","kind":"symbol","abstract":[{"type":"text","text":"Runs changes at the same time, each on its own copy of the world, and keeps what each one"},{"type":"text","text":" "},{"type":"text","text":"wrote."}],"identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/World\/runConcurrently(_:)","role":"symbol","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"runConcurrently"},{"kind":"text","text":"(["},{"kind":"typeIdentifier","text":"ConcurrentChange","preciseIdentifier":"s:11WorldModule16ConcurrentChangeV"},{"kind":"text","text":"])"}],"url":"\/documentation\/worldmodule\/world\/runconcurrently(_:)"},"doc://WorldModule/documentation/WorldModule/Targets":{"navigatorTitle":[{"kind":"identifier","text":"Targets"}],"fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"Targets"}],"kind":"symbol","abstract":[{"type":"text","text":"The component that holds a source entity’s targets of a relation, with the relation’s value"},{"type":"text","text":" "},{"type":"text","text":"for each."}],"url":"\/documentation\/worldmodule\/targets","identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/Targets","title":"Targets","role":"symbol","type":"topic"},"doc://WorldModule/documentation/WorldModule/Prefab":{"kind":"symbol","navigatorTitle":[{"text":"Prefab","kind":"identifier"}],"fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Prefab","kind":"identifier"}],"abstract":[{"text":"A component that marks an entity as a template for spawning copies.","type":"text"}],"role":"symbol","title":"Prefab","identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/Prefab","type":"topic","url":"\/documentation\/worldmodule\/prefab"},"doc://WorldModule/documentation/WorldModule/Disabled":{"url":"\/documentation\/worldmodule\/disabled","navigatorTitle":[{"kind":"identifier","text":"Disabled"}],"fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"Disabled"}],"abstract":[{"text":"A component that makes queries and updates skip an entity, unless they ask for it.","type":"text"}],"role":"symbol","title":"Disabled","identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/Disabled","type":"topic","kind":"symbol"},"doc://WorldModule/documentation/WorldModule/World/queue(_:)":{"url":"\/documentation\/worldmodule\/world\/queue(_:)","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"queue"},{"kind":"text","text":"("},{"kind":"typeIdentifier","preciseIdentifier":"s:11WorldModule8CommandsV","text":"Commands"},{"kind":"text","text":")"}],"abstract":[{"text":"Adds a command buffer to the world’s queue, to apply later with","type":"text"},{"text":" ","type":"text"},{"identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/World\/applyQueuedCommands()","type":"reference","isActive":true},{"text":".","type":"text"}],"role":"symbol","title":"queue(_:)","identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/World\/queue(_:)","kind":"symbol","type":"topic"},"doc://WorldModule/documentation/WorldModule/World":{"type":"topic","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"World"}],"identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/World","url":"\/documentation\/worldmodule\/world","role":"symbol","kind":"symbol","title":"World","abstract":[{"text":"A collection of entities, the components they hold, and resources.","type":"text"}],"navigatorTitle":[{"kind":"identifier","text":"World"}]},"doc://WorldModule/documentation/WorldModule":{"type":"topic","identifier":"doc:\/\/WorldModule\/documentation\/WorldModule","url":"\/documentation\/worldmodule","role":"collection","title":"WorldModule","kind":"symbol","abstract":[{"text":"Store the state of a game or simulation as entities and components, and read and change it with","type":"text"},{"text":" ","type":"text"},{"text":"queries, updates, and commands.","type":"text"}]},"doc://WorldModule/documentation/WorldModule/World/applyQueuedCommands()":{"url":"\/documentation\/worldmodule\/world\/applyqueuedcommands()","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"applyQueuedCommands","kind":"identifier"},{"text":"() -> [","kind":"text"},{"preciseIdentifier":"s:11WorldModule6EntityV","text":"Entity","kind":"typeIdentifier"},{"text":"]","kind":"text"}],"abstract":[{"text":"Applies every queued command buffer, in the order the buffers were queued, and empties the","type":"text"},{"text":" ","type":"text"},{"text":"queue.","type":"text"}],"role":"symbol","title":"applyQueuedCommands()","identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/World\/applyQueuedCommands()","type":"topic","kind":"symbol"},"doc://WorldModule/documentation/WorldModule/ConcurrentChange":{"type":"topic","title":"ConcurrentChange","identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/ConcurrentChange","url":"\/documentation\/worldmodule\/concurrentchange","abstract":[{"text":"A change to a world, paired with the access that describes what it reads and writes.","type":"text"}],"role":"symbol","kind":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"ConcurrentChange"}],"navigatorTitle":[{"kind":"identifier","text":"ConcurrentChange"}]}}}