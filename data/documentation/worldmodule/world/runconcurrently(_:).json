{"hierarchy":{"paths":[["doc:\/\/WorldModule\/documentation\/WorldModule","doc:\/\/WorldModule\/documentation\/WorldModule\/World"]]},"abstract":[{"text":"Runs changes at the same time, each on its own copy of the world, and keeps what each one","type":"text"},{"text":" ","type":"text"},{"text":"wrote.","type":"text"}],"metadata":{"externalID":"s:11WorldModule0A0V15runConcurrentlyyySayAA16ConcurrentChangeVGF","role":"symbol","symbolKind":"method","title":"runConcurrently(_:)","modules":[{"name":"WorldModule"}],"fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"runConcurrently","kind":"identifier"},{"text":"([","kind":"text"},{"text":"ConcurrentChange","preciseIdentifier":"s:11WorldModule16ConcurrentChangeV","kind":"typeIdentifier"},{"text":"])","kind":"text"}],"extendedModule":"WorldModule","roleHeading":"Instance Method","remoteSource":{"fileName":"Concurrency.swift","url":"https:\/\/github.com\/Tyler-Keith-Thompson\/ECS\/blob\/main\/Sources\/WorldModule\/Concurrency.swift#L264"}},"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/worldmodule\/world\/runconcurrently(_:)"]}],"schemaVersion":{"patch":0,"major":0,"minor":3},"sections":[],"kind":"symbol","primaryContentSections":[{"declarations":[{"platforms":["Linux"],"tokens":[{"text":"mutating","kind":"keyword"},{"text":" ","kind":"text"},{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"runConcurrently","kind":"identifier"},{"text":"(","kind":"text"},{"text":"_","kind":"externalParam"},{"text":" ","kind":"text"},{"text":"changes","kind":"internalParam"},{"text":": [","kind":"text"},{"text":"ConcurrentChange","preciseIdentifier":"s:11WorldModule16ConcurrentChangeV","kind":"typeIdentifier","identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/ConcurrentChange"},{"text":"])","kind":"text"}],"languages":["swift"]}],"kind":"declarations"},{"parameters":[{"content":[{"type":"paragraph","inlineContent":[{"text":"The changes to run.","type":"text"}]}],"name":"changes"}],"kind":"parameters"},{"kind":"content","content":[{"anchor":"discussion","type":"heading","level":2,"text":"Discussion"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Use this method to spread independent work across the processor’s cores. Each change reads"},{"type":"text","text":" "},{"type":"text","text":"the world as it was before any of them ran, and writes only the types its access lists, so"},{"type":"text","text":" "},{"type":"text","text":"the result is the same as running the changes one after another in any order:"}]},{"syntax":"swift","type":"codeListing","code":["var world = World()","let ball = world.spawn(Position(x: 0, y: 0), Velocity(dx: 1, dy: 0), Health(current: 10))","","world.runConcurrently([","    ConcurrentChange(access: .reads(Velocity.self).writes(Position.self)) { world in","        world.update(Position.self, reading: Velocity.self) { position, row in","            position.x += row.components.dx","        }","    },","    ConcurrentChange(access: .writes(Health.self)) { world in","        world.update(Health.self) { health, _ in health.current -= 1 }","    },","])","","print(world[Position.self, of: ball].x, world[Health.self, of: ball].current)","\/\/ Prints \"1.0 9\""]},{"type":"paragraph","inlineContent":[{"type":"text","text":"A change sees the components and resources that other changes write as missing, so its"},{"type":"text","text":" "},{"type":"text","text":"access must list everything it reads. Command buffers a change queues with "},{"type":"reference","identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/World\/queue(_:)","isActive":true},{"type":"text","text":" "},{"type":"text","text":"are queued in this world in the order of "},{"type":"codeVoice","code":"changes"},{"type":"text","text":"."}]},{"style":"important","type":"aside","name":"Important","content":[{"inlineContent":[{"text":"A change must write only the component and resource types its access lists,","type":"text"},{"text":" ","type":"text"},{"text":"and must not spawn or despawn entities. It writes relations through their ","type":"text"},{"identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/Targets","isActive":true,"type":"reference"},{"text":" ","type":"text"},{"text":"components, and the hierarchy through ","type":"text"},{"code":"Targets<ChildOf>","type":"codeVoice"},{"text":".","type":"text"}],"type":"paragraph"}]},{"style":"note","type":"aside","name":"Complexity","content":[{"type":"paragraph","inlineContent":[{"text":"O(","type":"text"},{"inlineContent":[{"type":"text","text":"c"}],"type":"emphasis"},{"text":"·","type":"text"},{"inlineContent":[{"text":"t","type":"text"}],"type":"emphasis"},{"text":"), besides the cost of the changes themselves, where ","type":"text"},{"inlineContent":[{"type":"text","text":"c"}],"type":"emphasis"},{"text":" is the","type":"text"},{"text":" ","type":"text"},{"text":"number of changes and ","type":"text"},{"inlineContent":[{"type":"text","text":"t"}],"type":"emphasis"},{"text":" is the number of component types the world has stored.","type":"text"}]}]},{"style":"note","type":"aside","name":"Precondition","content":[{"type":"paragraph","inlineContent":[{"text":"No two accesses conflict, and each change writes only what its access","type":"text"},{"text":" ","type":"text"},{"text":"lists and spawns and despawns nothing; a change that breaks this traps. In debug builds,","type":"text"},{"text":" ","type":"text"},{"text":"a change that reads a component or resource type its access doesn’t list traps too. Any","type":"text"},{"text":" ","type":"text"},{"text":"change may read ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/Disabled"},{"text":" and ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/Prefab"},{"text":".","type":"text"}]}]}]}],"identifier":{"url":"doc:\/\/WorldModule\/documentation\/WorldModule\/World\/runConcurrently(_:)","interfaceLanguage":"swift"},"references":{"doc://WorldModule/documentation/WorldModule":{"url":"\/documentation\/worldmodule","type":"topic","role":"collection","kind":"symbol","abstract":[{"type":"text","text":"Store the state of a game or simulation as entities and components, and read and change it with"},{"type":"text","text":" "},{"type":"text","text":"queries, updates, and commands."}],"identifier":"doc:\/\/WorldModule\/documentation\/WorldModule","title":"WorldModule"},"doc://WorldModule/documentation/WorldModule/ConcurrentChange":{"abstract":[{"text":"A change to a world, paired with the access that describes what it reads and writes.","type":"text"}],"kind":"symbol","url":"\/documentation\/worldmodule\/concurrentchange","role":"symbol","navigatorTitle":[{"kind":"identifier","text":"ConcurrentChange"}],"identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/ConcurrentChange","type":"topic","title":"ConcurrentChange","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"ConcurrentChange"}]},"doc://WorldModule/documentation/WorldModule/World/queue(_:)":{"url":"\/documentation\/worldmodule\/world\/queue(_:)","identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/World\/queue(_:)","kind":"symbol","title":"queue(_:)","role":"symbol","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"queue"},{"kind":"text","text":"("},{"kind":"typeIdentifier","preciseIdentifier":"s:11WorldModule8CommandsV","text":"Commands"},{"kind":"text","text":")"}],"type":"topic","abstract":[{"text":"Adds a command buffer to the world’s queue, to apply later with","type":"text"},{"text":" ","type":"text"},{"isActive":true,"identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/World\/applyQueuedCommands()","type":"reference"},{"text":".","type":"text"}]},"doc://WorldModule/documentation/WorldModule/Prefab":{"navigatorTitle":