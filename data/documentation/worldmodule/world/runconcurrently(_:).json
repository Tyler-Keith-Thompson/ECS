{"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/WorldModule\/documentation\/WorldModule\/World\/runConcurrently(_:)"},"sections":[],"abstract":[{"text":"Runs changes at the same time, each on its own copy of the world, and keeps what each one","type":"text"},{"text":" ","type":"text"},{"text":"wrote.","type":"text"}],"primaryContentSections":[{"kind":"declarations","declarations":[{"tokens":[{"kind":"keyword","text":"mutating"},{"kind":"text","text":" "},{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"runConcurrently"},{"kind":"text","text":"("},{"kind":"externalParam","text":"_"},{"kind":"text","text":" "},{"kind":"internalParam","text":"changes"},{"kind":"text","text":": ["},{"preciseIdentifier":"s:11WorldModule16ConcurrentChangeV","identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/ConcurrentChange","kind":"typeIdentifier","text":"ConcurrentChange"},{"kind":"text","text":"])"}],"languages":["swift"],"platforms":["Linux"]}]},{"kind":"parameters","parameters":[{"name":"changes","content":[{"inlineContent":[{"type":"text","text":"The changes to run."}],"type":"paragraph"}]}]},{"kind":"content","content":[{"anchor":"discussion","type":"heading","level":2,"text":"Discussion"},{"inlineContent":[{"type":"text","text":"Use this method to spread independent work across the processor’s cores. Each change reads"},{"type":"text","text":" "},{"type":"text","text":"the world as it was before any of them ran, and writes only the types its access lists, so"},{"type":"text","text":" "},{"type":"text","text":"the result is the same as running the changes one after another in any order:"}],"type":"paragraph"},{"code":["var world = World()","let ball = world.spawn(Position(x: 0, y: 0), Velocity(dx: 1, dy: 0), Health(current: 10))","","world.runConcurrently([","    ConcurrentChange(access: .reads(Velocity.self).writes(Position.self)) { world in","        world.update(Position.self, reading: Velocity.self) { position, row in","            position.x += row.components.dx","        }","    },","    ConcurrentChange(access: .writes(Health.self)) { world in","        world.update(Health.self) { health, _ in health.current -= 1 }","    },","])","","print(world[Position.self, of: ball].x, world[Health.self, of: ball].current)","\/\/ Prints \"1.0 9\""],"type":"codeListing","syntax":"swift"},{"inlineContent":[{"text":"A change sees the components and resources that other changes write as missing, so its","type":"text"},{"text":" ","type":"text"},{"text":"access must list everything it reads. Command buffers a change queues with ","type":"text"},{"identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/World\/queue(_:)","isActive":true,"type":"reference"},{"text":" ","type":"text"},{"text":"are queued in this world in the order of ","type":"text"},{"code":"changes","type":"codeVoice"},{"text":".","type":"text"}],"type":"paragraph"},{"name":"Important","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"A change must write only the component and resource types its access lists,"},{"type":"text","text":" "},{"type":"text","text":"and must not spawn or despawn entities. It writes relations through their "},{"isActive":true,"type":"reference","identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/Targets"},{"type":"text","text":" "},{"type":"text","text":"components, and the hierarchy through "},{"type":"codeVoice","code":"Targets<ChildOf>"},{"type":"text","text":"."}]}],"type":"aside","style":"important"},{"name":"Complexity","content":[{"type":"paragraph","inlineContent":[{"text":"O(","type":"text"},{"inlineContent":[{"type":"text","text":"c"}],"type":"emphasis"},{"text":"·","type":"text"},{"inlineContent":[{"type":"text","text":"t"}],"type":"emphasis"},{"text":"), besides the cost of the changes themselves, where ","type":"text"},{"inlineContent":[{"type":"text","text":"c"}],"type":"emphasis"},{"text":" is the","type":"text"},{"text":" ","type":"text"},{"text":"number of changes and ","type":"text"},{"inlineContent":[{"type":"text","text":"t"}],"type":"emphasis"},{"text":" is the number of component types the world has stored.","type":"text"}]}],"type":"aside","style":"note"},{"name":"Precondition","content":[{"type":"paragraph","inlineContent":[{"text":"No two accesses conflict, and each change writes only what its access","type":"text"},{"text":" ","type":"text"},{"text":"lists and spawns and despawns nothing; a change that breaks this traps. In debug builds,","type":"text"},{"text":" ","type":"text"},{"text":"a change that reads a component or resource type its access doesn’t list traps too. Any","type":"text"},{"text":" ","type":"text"},{"text":"change may read ","type":"text"},{"type":"reference","isActive":true,"identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/Disabled"},{"text":" and ","type":"text"},{"type":"reference","isActive":true,"identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/Prefab"},{"text":".","type":"text"}]}],"type":"aside","style":"note"}]}],"variants":[{"paths":["\/documentation\/worldmodule\/world\/runconcurrently(_:)"],"traits":[{"interfaceLanguage":"swift"}]}],"kind":"symbol","schemaVersion":{"patch":0,"major":0,"minor":3},"metadata":{"fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"runConcurrently"},{"kind":"text","text":"(["},{"kind":"typeIdentifier","preciseIdentifier":"s:11WorldModule16ConcurrentChangeV","text":"ConcurrentChange"},{"kind":"text","text":"])"}],"modules":[{"name":"WorldModule"}],"role":"symbol","remoteSource":{"fileName":"Concurrency.swift","url":"https:\/\/github.com\/Tyler-Keith-Thompson\/ECS\/blob\/main\/Sources\/WorldModule\/Concurrency.swift#L264"},"title":"runConcurrently(_:)","roleHeading":"Instance Method","externalID":"s:11WorldModule0A0V15runConcurrentlyyySayAA16ConcurrentChangeVGF","extendedModule":"WorldModule","symbolKind":"method"},"hierarchy":{"paths":[["doc:\/\/WorldModule\/documentation\/WorldModule","doc:\/\/WorldModule\/documentation\/WorldModule\/World"]]},"references":{"doc://WorldModule/documentation/WorldModule/ConcurrentChange":{"navigatorTitle":[{"kind":"identifier","text":"ConcurrentChange"}],"url":"\/documentation\/worldmodule\/concurrentchange","abstract":[{"type":"text","text":"A change to a world, paired with the access that describes what it reads and writes."}],"identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/ConcurrentChange","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"ConcurrentChange"}],"title":"ConcurrentChange","kind":"symbol","type":"topic","role":"symbol"},"doc://WorldModule/documentation/WorldModule/World/queue(_:)":{"kind":"symbol","identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/World\/queue(_:)","type":"topic","role":"symbol","title":"queue(_:)","abstract":[{"text":"Adds a command buffer to the world’s queue, to apply later with","type":"text"},{"text":" ","type":"text"},{"isActive":true,"identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/World\/applyQueuedCommands()","type":"reference"},{"text":".","type":"text"}],"url":"\/documentation\/worldmodule\/world\/queue(_:)","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"queue"},{"kind":"text","text":"("},{"preciseIdentifier":"s:11WorldModule8CommandsV","kind":"typeIdentifier","text":"Commands"},{"kind":"text","text":")"}]},"doc://WorldModule/documentation/WorldModule/Targets":{"identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/Targets","abstract":[{"type":"text","text":"The component that holds a source entity’s targets of a relation, with the relation’s value"},{"type":"text","text":" "},{"type":"text","text":"for each."}],"fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Targets","kind":"identifier"}],"title":"Targets","role":"symbol","kind":"symbol","url":"\/documentation\/worldmodule\/targets","navigatorTitle":[{"text":"Targets","kind":"identifier"}],"type":"topic"},"doc://WorldModule/documentation/WorldModule/World/runConcurrently(_:)":{"title":"runConcurrently(_:)","role":"symbol","url":"\/documentation\/worldmodule\/world\/runconcurrently(_:)","kind":"symbol","identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/World\/runConcurrently(_:)","type":"topic","abstract":[{"type":"text","text":"Runs changes at the same time, each on its own copy of the world, and keeps what each one"},{"type":"text","text":" "},{"type":"text","text":"wrote."}],"fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"runConcurrently","kind":"identifier"},{"text":"([","kind":"text"},{"text":"ConcurrentChange","preciseIdentifier":"s:11WorldModule16ConcurrentChangeV","kind":"typeIdentifier"},{"text":"])","kind":"text"}]},"doc://WorldModule/documentation/WorldModule/World/applyQueuedCommands()":{"kind":"symbol","identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/World\/applyQueuedCommands()","type":"topic","role":"symbol","title":"applyQueuedCommands()","url":"\/documentation\/worldmodule\/world\/applyqueuedcommands()","abstract":[{"type":"text","text":"Applies every queued command buffer, in the order the buffers were queued, and empties the"},{"type":"text","text":" "},{"type":"text","text":"queue."}],"fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"applyQueuedCommands"},{"kind":"text","text":"() -> ["},{"preciseIdentifier":"s:11WorldModule6EntityV","text":"Entity","kind":"typeIdentifier"},{"text":"]","kind":"text"}]},"doc://WorldModule/documentation/WorldModule":{"kind":"symbol","identifier":"doc:\/\/WorldModule\/documentation\/WorldModule","type":"topic","role":"collection","title":"WorldModule","abstract":[{"type":"text","text":"Store the state of a game or simulation as entities and components, and read and change it with"},{"type":"text","text":" "},{"type"