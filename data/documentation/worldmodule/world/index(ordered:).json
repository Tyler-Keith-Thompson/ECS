entation\/worldmodule\/world\/index(ordered:)"],"traits":[{"interfaceLanguage":"swift"}]}],"identifier":{"url":"doc:\/\/WorldModule\/documentation\/WorldModule\/World\/index(ordered:)","interfaceLanguage":"swift"},"abstract":[{"type":"text","text":"Keeps the entities holding a component type sorted by a property of the component, so"},{"type":"text","text":" "},{"type":"text","text":"that "},{"type":"reference","identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/World\/lookup(_:in:)","isActive":true},{"type":"text","text":" finds the entities whose property falls in a range, and"},{"type":"text","text":" "},{"type":"reference","identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/World\/entities(sortedBy:)","isActive":true},{"type":"text","text":" lists them in order, without walking and sorting the type’s"},{"type":"text","text":" "},{"type":"text","text":"storage."}],"primaryContentSections":[{"declarations":[{"languages":["swift"],"tokens":[{"kind":"keyword","text":"mutating"},{"kind":"text","text":" "},{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"index"},{"kind":"text","text":"<"},{"kind":"genericParameter","text":"C"},{"kind":"text","text":", "},{"kind":"genericParameter","text":"Key"},{"kind":"text","text":">("},{"kind":"externalParam","text":"ordered"},{"kind":"text","text":" "},{"kind":"internalParam","text":"key"},{"kind":"text","text":": any "},{"kind":"typeIdentifier","text":"KeyPath","preciseIdentifier":"s:s7KeyPathC"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","text":"C"},{"kind":"text","text":", "},{"kind":"typeIdentifier","text":"Key"},{"kind":"text","text":"> & "},{"kind":"typeIdentifier","text":"Sendable","preciseIdentifier":"s:s8SendableP"},{"kind":"text","text":") "},{"kind":"keyword","text":"where"},{"kind":"text","text":" "},{"kind":"typeIdentifier","text":"C"},{"kind":"text","text":" : "},{"kind":"typeIdentifier","text":"Component","identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/Component","preciseIdentifier":"s:11WorldModule9ComponentP"},{"kind":"text","text":", "},{"kind":"typeIdentifier","text":"Key"},{"kind":"text","text":" : "},{"kind":"typeIdentifier","text":"Comparable","preciseIdentifier":"s:SL"},{"kind":"text","text":", "},{"kind":"typeIdentifier","text":"Key"},{"kind":"text","text":" : "},{"kind":"typeIdentifier","text":"Sendable","preciseIdentifier":"s:s8SendableP"}],"platforms":["Linux"]}],"kind":"declarations"},{"kind":"parameters","parameters":[{"content":[{"type":"paragraph","inlineContent":[{"text":"The key path of the property to sort the component type’s entities by.","type":"text"}]}],"name":"key"}]},{"content":[{"level":2,"type":"heading","text":"Discussion","anchor":"discussion"},{"type":"paragraph","inlineContent":[{"text":"Use an ordered index when you often ask for the entities whose property lies between two","type":"text"},{"text":" ","type":"text"},{"text":"values, such as the ones whose health runs low, or visit entities in the order of a","type":"text"},{"text":" ","type":"text"},{"text":"property, such as drawing them back to front:","type":"text"}]},{"code":["var world = World()","let weak = world.spawn(Health(current: 2))","let weaker = world.spawn(Health(current: 1))","world.spawn(Health(current: 9))","world.index(ordered: \\Health.current)","","print(world.lookup(\\Health.current, in: ...3) == [weaker, weak])","\/\/ Prints \"true\""],"type":"codeListing","syntax":"swift"},{"type":"paragraph","inlineContent":[{"type":"text","text":"An ordered index is kept current the same way as an index by value ("},{"type":"reference","identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/World\/index(_:)-u1gw","isActive":true},{"type":"text","text":"):"},{"type":"text","text":" "},{"type":"text","text":"spawning, inserting, removing and despawning update it; a change in place leaves it out of"},{"type":"text","text":" "},{"type":"text","text":"date until the next "},{"type":"reference","iden