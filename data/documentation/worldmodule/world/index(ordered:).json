{"type":"text","text":" "},{"type":"text","text":"Keeping it costs O(log "},{"type":"emphasis","inlineContent":[{"type":"text","text":"n"}]},{"type":"text","text":") for each insert, removal and despawn of an entity holding a"},{"type":"text","text":" "},{"type":"codeVoice","code":"C"},{"type":"text","text":", where an index by value costs O(1), so index a key path ordered only when you look it"},{"type":"text","text":" "},{"type":"text","text":"up by range or order. Indexing the same key path ordered twice keeps one index; a key path"},{"type":"text","text":" "},{"type":"text","text":"can have an ordered index and an index by value at once."}],"type":"paragraph"},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Every key equals itself; a floating-point key isn’t NaN."}]}],"style":"note","type":"aside","name":"Precondition"},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"O("},{"type":"emphasis","inlineContent":[{"type":"text","text":"n"}]},{"type":"text","text":" log "},{"type":"emphasis","inlineContent":[{"type":"text","text":"n"}]},{"type":"text","text":") for "},{"type":"emphasis","inlineContent":[{"type":"text","text":"n"}]},{"type":"text","text":" entities holding a "},{"type":"codeVoice","code":"C"},{"type":"text","text":"."}]}],"style":"note","type":"aside","name":"Complexity"}]}],"abstract":[{"text":"Keeps the entities holding a component type sorted by a property of the component, so","type":"text"},{"text":" ","type":"text"},{"text":"that ","type":"text"},{"type":"reference","identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/World\/lookup(_:in:)","isActive":true},{"text":" finds the entities whose property falls in a range, and","type":"text"},{"text":" ","type":"text"},{"type":"reference","identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/World\/entities(sortedBy:)","isActive":true},{"text":" lists them in order, without walking and sorting the type’s","type":"text"},{"text":" ","type