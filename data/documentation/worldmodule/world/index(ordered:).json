{"schemaVersion":{"minor":3,"major":0,"patch":0},"abstract":[{"type":"text","text":"Keeps the entities holding a component type sorted by a property of the component, so"},{"type":"text","text":" "},{"type":"text","text":"that "},{"type":"reference","identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/World\/lookup(_:in:)","isActive":true},{"type":"text","text":" finds the entities whose property falls in a range, and"},{"type":"text","text":" "},{"type":"reference","identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/World\/entities(sortedBy:)","isActive":true},{"type":"text","text":" lists them in order, without walking and sorting the type’s"},{"type":"text","text":" "},{"type":"text","text":"storage."}],"metadata":{"extendedModule":"WorldModule","remoteSource":{"url":"https:\/\/github.com\/Tyler-Keith-Thompson\/ECS\/blob\/main\/Sources\/WorldModule\/ValueIndex.swift#L394","fileName":"ValueIndex.swift"},"fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"index","kind":"identifier"},{"text":"<","kind":"text"},{"text":"C","kind":"genericParameter"},{"text":", ","kind":"text"},{"text":"Key","kind":"genericParameter"},{"text":">(","kind":"text"},{"text":"ordered","kind":"externalParam"},{"text":": any ","kind":"text"},{"text":"KeyPath","kind":"typeIdentifier","preciseIdentifier":"s:s7KeyPathC"},{"text":"<","kind":"text"},{"text":"C","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"Key","kind":"typeIdentifier"},{"text":"> & ","kind":"text"},{"text":"Sendable","kind":"typeIdentifier","preciseIdentifier":"s:s8SendableP"},{"text":")","kind":"text"}],"title":"index(ordered:)","roleHeading":"Instance Method","modules":[{"name":"WorldModule"}],"symbolKind":"method","role":"symbol","externalID":"s:11WorldModule0A0V5index7orderedys8Sendable_s7KeyPathCyxq_GXc_tAA9ComponentRzSLR_sAFR_r0_lF"},"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/WorldModule\/documentation\/WorldModule\/World\/index(ordered:)"},"se