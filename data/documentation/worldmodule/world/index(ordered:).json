ocumentation\/WorldModule\/Component","kind":"typeIdentifier","preciseIdentifier":"s:11WorldModule9ComponentP","text":"Component"},{"kind":"text","text":", "},{"kind":"typeIdentifier","text":"Key"},{"kind":"text","text":" : "},{"kind":"typeIdentifier","preciseIdentifier":"s:SL","text":"Comparable"},{"kind":"text","text":", "},{"kind":"typeIdentifier","text":"Key"},{"kind":"text","text":" : "},{"kind":"typeIdentifier","preciseIdentifier":"s:s8SendableP","text":"Sendable"}]}],"kind":"declarations"},{"kind":"parameters","parameters":[{"name":"key","content":[{"inlineContent":[{"text":"The key path of the property to sort the component type’s entities by.","type":"text"}],"type":"paragraph"}]}]},{"kind":"content","content":[{"type":"heading","level":2,"text":"Discussion","anchor":"discussion"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Use an ordered index when you often ask for the entities whose property lies between two"},{"type":"text","text":" "},{"type":"text","text":"values, such as the ones whose health runs low, or visit entities in the order of a"},{"type":"text","text":" "},{"type":"text","text":"property, such as drawing them back to front:"}]},{"type":"codeListing","syntax":"swift","code":["var world = World()","let weak = world.spawn(Health(current: 2))","let weaker = world.spawn(Health(current: 1))","world.spawn(Health(current: 9))","world.index(ordered: \\Health.current)","","print(world.lookup(\\Health.current, in: ...3) == [weaker, weak])","\/\/ Prints \"true\""]},{"type":"paragraph","inlineContent":[{"type":"text","text":"An ordered index is kept current the same way as an index by value ("},{"type":"reference","identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/World\/index(_:)-u1gw","isActive":true},{"type":"text","text":"):"},{"type":"text","text":" "},{"type":"text","text":"spawning, inserting, removing and despawning update it; a change in place leaves it out of"},{"type":"text","text":" "},{"type":"text","text":"date 