{"primaryContentSections":[{"kind":"declarations","declarations":[{"languages":["swift"],"platforms":["Linux"],"tokens":[{"text":"protocol","kind":"keyword"},{"kind":"text","text":" "},{"kind":"identifier","text":"Bundle"},{"kind":"text","text":" : "},{"kind":"typeIdentifier","preciseIdentifier":"s:s8SendableP","text":"Sendable"}]}]},{"kind":"content","content":[{"type":"heading","level":2,"anchor":"overview","text":"Overview"},{"inlineContent":[{"text":"Use a bundle to name a set of components that often go together, such as everything a ship","type":"text"},{"text":" ","type":"text"},{"text":"needs, so you can spawn them in one step and keep that set in one place. Declare the","type":"text"},{"text":" ","type":"text"},{"text":"bundle’s contents in its ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/Bundle\/body-9bv1p"},{"text":" property. The body is built by ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/BundleBuilder"},{"text":", so you","type":"text"},{"text":" ","type":"text"},{"text":"can list components and other bundles, and use ","type":"text"},{"code":"if","type":"codeVoice"},{"text":", ","type":"text"},{"code":"switch","type":"codeVoice"},{"text":" and optional values:","type":"text"}],"type":"paragraph"},{"syntax":"swift","type":"codeListing","code":["struct Armor: Component { var rating: Int }","","struct Ship: Bundle {","    var position: Position","    var armored: Bool","","    var body: some Bundle {","        position","        Velocity(dx: 0, dy: 0)","        if armored { Armor(rating: 10) }","    }","}","","var world = World()","let ship = world.spawn(Ship(position: Position(x: 0, y: 0), armored: true))","print(world.contains(Armor.self, in: ship))","\/\/ Prints \"true\""]},{"inlineContent":[{"type":"text","text":"Removing a bundle type removes every component type the bundle can hold, including the types"},{"type":"text","text":" "},{"type":"text","text":"of branches that weren’t taken:"}],"type":"paragraph"},{"syntax":"swift","type":"codeListing","code":["var world = World()","let ship = world.spawn(","    Ship(position: Position(x: 0, y: 0), armored: false),","    Health(current: 50)",")","","world.remove(Ship.self, from: ship)","print(world.contains(Position.self, in: ship), world.contains(Health.self, in: ship))","\/\/ Prints \"false true\""]},{"inlineContent":[{"type":"text","text":"Every "},{"identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/Component","isActive":true,"type":"reference"},{"type":"text","text":" is a bundle of itself, so anywhere a bundle is expected, you can pass a"},{"type":"text","text":" "},{"type":"text","text":"single component."}],"type":"paragraph"},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Foundation also declares a type named "},{"code":"Bundle","type":"codeVoice"},{"type":"text","text":". In a file that imports Foundation,"},{"type":"text","text":" "},{"type":"text","text":"write "},{"code":"ECS.Bundle","type":"codeVoice"},{"type":"text","text":" to name this protocol."}]}],"type":"aside","name":"Note","style":"note"}]}],"seeAlsoSections":[{"title":"Grouping Components","anchor":"Grouping-Components","identifiers":["doc:\/\/WorldModule\/documentation\/WorldModule\/BundleBuilder","doc:\/\/WorldModule\/documentation\/WorldModule\/TupleBundle","doc:\/\/WorldModule\/documentation\/WorldModule\/EitherBundle"],"generated":true}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/worldmodule\/bundle"]}],"kind":"symbol","metadata":{"navigatorTitle":[{"text":"Bundle","kind":"identifier"}],"externalID":"s:11WorldModule6BundleP","modules":[{"name":"WorldModule"}],"symbolKind":"protocol","role":"symbol","roleHeading":"Protocol","remoteSource":{"url":"https:\/\/github.com\/Tyler-Keith-Thompson\/ECS\/blob\/main\/Sources\/WorldModule\/Bundle.swift#L48","fileName":"Bundle.swift"},"fr