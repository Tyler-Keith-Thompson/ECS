ype":"paragraph","inlineContent":[{"text":"Use a bundle to name a set of components that often go together, such as everything a ship","type":"text"},{"text":" ","type":"text"},{"text":"needs, so you can spawn them in one step and keep that set in one place. Declare the","type":"text"},{"text":" ","type":"text"},{"text":"bundle’s contents in its ","type":"text"},{"isActive":true,"identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/Bundle\/body-9bv1p","type":"reference"},{"text":" property. The body is built by ","type":"text"},{"isActive":true,"identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/BundleBuilder","type":"reference"},{"text":", so you","type":"text"},{"text":" ","type":"text"},{"text":"can list components and other bundles, and use ","type":"text"},{"code":"if","type":"codeVoice"},{"text":", ","type":"text"},{"code":"switch","type":"codeVoice"},{"text":" and optional values:","type":"text"}]},{"syntax":"swift","type":"codeListing","code":["struct Armor: Component { var rating: Int }","","struct Ship: Bundle {","    var position: Position","    var armored: Bool","","    var body: some Bundle {","        position","        Velocity(dx: 0, dy: 0)","        if armored { Armor(rating: 10) }","    }","}","","var world = World()","let ship = world.spawn(Ship(position: Position(x: 0, y: 0), armored: true))","print(world.contains(Armor.self, in: ship))","\/\/ Prints \"true\""]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Removing a bundle type removes every component type the bundle can hold, including the types"},{"type":"text","text":" "},{"type":"text","text":"of branches that weren’t taken:"}]},{"syntax":"swift","type":"codeListing","code":["var world = World()","let ship = world.spawn(","    Ship(position: Position(x: 0, y: 0), armored: false),","    Health(current: 50)",")","","world.remove(Ship.self, from: ship)","print(world.contains(Position.self, in: ship), world.contains(Health.self, in: ship))","\/\/ Prints \"false true\""]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Every "},{"isActive":true,"type":"reference","identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/Component"},{"type":"text","text":" is a bundle of itself, so anywhere a bundle is expected, you can pass a"},{"type":"text","text":" "},{"type":"text","text":"single component."}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Foundation also declares a type named "},{"type":"codeVoice","code":"Bundle"},{"type":"text","text":". In a file that imports Foundation,"},{"type":"text","text":" "},{"type":"text","text":"write "},{"type":"codeVoice","code":"ECS.Bundle"},{"type":"text","text":" to name this protocol."}]}],"type":"aside","name":"Note","style":"note"}]}],"metadata":{"roleHeading":"Protocol","remoteSource":{"url":"https:\/\/github.com\/Tyler-Keith-Thompson\/ECS\/blob\/main\/Sources\/WorldModule\/Bundle.swift#L48","fileName":"Bundle.swift"},"symbolKind":"protocol","navigatorTitle":[{"text":"Bundle","kind":"identifier"}],"externalID":"s:11WorldModule6BundleP","role":"symbol","fragments":[{"text":"protocol","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Bundle","kind":"identifier"}],"title":"Bundle","modules":[{"name":"WorldModule"}]},"sections":[],"hierarchy":{"paths":[["doc:\/\/WorldModule\/documentation\/WorldModule"]]},"topicSections":[{"identifiers":["doc:\/\/WorldModule\/documentation\/WorldModule\/Bundle\/Body-swift.associatedtype"],"anchor":"Associated-Types","title":"Associated Types","generated":true},{"identifiers":["doc:\/\/WorldModule\/documentation\/WorldModule\/Bundle\/body-9bv1p"],"anchor":"Instance-Properties","title":"Instance Properties","generated":true},{"identifiers":["doc:\/\/WorldModule\/documentation\/WorldModule\/Bundle\/insert(into:in:)"],"anchor":"Instance-Methods","title":"Instance Methods","generated":true},{"identifiers":["doc:\/\/WorldModule\/documentation\/WorldModule\/Bundle\/remove(from:in:)"],"anchor":"Type-Methods","t