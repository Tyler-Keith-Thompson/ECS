{"abstract":[{"type":"text","text":"A type that groups components to be spawned, inserted, and removed together."}],"primaryContentSections":[{"declarations":[{"languages":["swift"],"tokens":[{"text":"protocol","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Bundle","kind":"identifier"},{"text":" : ","kind":"text"},{"preciseIdentifier":"s:s8SendableP","text":"Sendable","kind":"typeIdentifier"}],"platforms":["Linux"]}],"kind":"declarations"},{"content":[{"type":"heading","text":"Overview","anchor":"overview","level":2},{"type":"paragraph","inlineContent":[{"text":"Use a bundle to name a set of components that often go together, such as everything a ship","type":"text"},{"text":" ","type":"text"},{"text":"needs, so you can spawn them in one step and keep that set in one place. Declare the","type":"text"},{"text":" ","type":"text"},{"text":"bundle’s contents in its ","type":"text"},{"type":"reference","isActive":true,"identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/Bundle\/body-9bv1p"},{"text":" property. The body is built by ","type":"text"},{"type":"reference","isActive":true,"identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/BundleBuilder"},{"text":", so you","type":"text"},{"text":" ","type":"text"},{"text":"can list components and other bundles, and use ","type":"text"},{"code":"if","type":"codeVoice"},{"text":", ","type":"text"},{"code":"switch","type":"codeVoice"},{"text":" and optional values:","type":"text"}]},{"type":"codeListing","code":["struct Armor: Component { var rating: Int }","","struct Ship: Bundle {","    var position: Position","    var armored: Bool","","    var body: some Bundle {","        position","        Velocity(dx: 0, dy: 0)","        if armored { Armor(rating: 10) }","    }","}","","var world = World()","let ship = world.spawn(Ship(position: Position(x: 0, y: 0), armored: true))","print(world.contains(Armor.self, in: ship))","\/\/ Prints \"true\""],"syntax":"swift"},{"type":"paragraph","inlineContent":[{"ty