{"kind":"symbol","identifier":{"url":"doc:\/\/WorldModule\/documentation\/WorldModule\/Bundle","interfaceLanguage":"swift"},"schemaVersion":{"patch":0,"minor":3,"major":0},"sections":[],"hierarchy":{"paths":[["doc:\/\/WorldModule\/documentation\/WorldModule"]]},"metadata":{"symbolKind":"protocol","fragments":[{"kind":"keyword","text":"protocol"},{"kind":"text","text":" "},{"text":"Bundle","kind":"identifier"}],"externalID":"s:11WorldModule6BundleP","remoteSource":{"url":"https:\/\/github.com\/Tyler-Keith-Thompson\/ECS\/blob\/main\/Sources\/WorldModule\/Bundle.swift#L48","fileName":"Bundle.swift"},"roleHeading":"Protocol","navigatorTitle":[{"kind":"identifier","text":"Bundle"}],"title":"Bundle","modules":[{"name":"WorldModule"}],"role":"symbol"},"abstract":[{"type":"text","text":"A type that groups components to be spawned, inserted, and removed together."}],"seeAlsoSections":[{"generated":true,"title":"Grouping Components","identifiers":["doc:\/\/WorldModule\/documentation\/WorldModule\/BundleBuilder","doc:\/\/WorldModule\/documentation\/WorldModule\/TupleBundle","doc:\/\/WorldModule\/documentation\/WorldModule\/EitherBundle"],"anchor":"Grouping-Components"}],"primaryContentSections":[{"declarations":[{"tokens":[{"text":"protocol","kind":"keyword"},{"kind":"text","text":" "},{"kind":"identifier","text":"Bundle"},{"kind":"text","text":" : "},{"kind":"typeIdentifier","text":"Sendable","preciseIdentifier":"s:s8SendableP"}],"languages":["swift"],"platforms":["Linux"]}],"kind":"declarations"},{"content":[{"type":"heading","anchor":"overview","text":"Overview","level":2},{"type":"paragraph","inlineContent":[{"type":"text","text":"Use a bundle to name a set of components that often go together, such as everything a ship"},{"type":"text","text":" "},{"type":"text","text":"needs, so you can spawn them in one step and keep that set in one place. Declare the"},{"type":"text","text":" "},{"type":"text","text":"bundle’s contents in its "},{"type":"reference","identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/Bundle\/body-9bv1p","isActive":true},{"type":"text","text":" property. The body is built by "},{"type":"reference","identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/BundleBuilder","isActive":true},{"type":"text","text":", so you"},{"type":"text","text":" "},{"type":"text","text":"can list components and other bundles, and use "},{"type":"codeVoice","code":"if"},{"type":"text","text":", "},{"type":"codeVoice","code":"switch"},{"type":"text","text":" and optional values:"}]},{"type":"codeListing","code":["struct Armor: Component { var rating: Int }","","struct Ship: Bundle {","    var position: Position","    var armored: Bool","","    var body: some Bundle {","        position","        Velocity(dx: 0, dy: 0)","        if armored { Armor(rating: 10) }","    }","}","","var world = World()","let ship = world.spawn(Ship(position: Position(x: 0, y: 0), armored: true))","print(world.contains(Armor.self, in: ship))","\/\/ Prints \"true\""],"syntax":"swift"},{"type":"paragraph","inlineContent":[{"text":"Removing a bundle type removes every component type the bundle can hold, including the types","type":"text"},{"text":" ","type":"text"},{"text":"of branches that weren’t taken:","type":"text"}]},{"type":"codeListing","code":["var world = World()","let ship = world.spawn(","    Ship(position: Position(x: 0, y: 0), armored: false),","    Health(current: 50)",")","","world.remove(Ship.self, from: ship)","print(world.contains(Position.self, in: ship), world.contains(Health.self, in: ship))","\/\/ Prints \"false true\""],"syntax":"swift"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Every "},{"isActive":true,"type":"reference","identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/Component"},{"type":"text","text":" is a bundle of itself, so anywhere a bundle is expected, you can pass a"},{"type":"text","text":" "},{"type":"text","text":"single component."}]},{"type":"aside","style":"note","name":"Note