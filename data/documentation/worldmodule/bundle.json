e":"switch"},{"type":"text","text":" and optional values:"}],"type":"paragraph"},{"syntax":"swift","code":["struct Armor: Component { var rating: Int }","","struct Ship: Bundle {","    var position: Position","    var armored: Bool","","    var body: some Bundle {","        position","        Velocity(dx: 0, dy: 0)","        if armored { Armor(rating: 10) }","    }","}","","var world = World()","let ship = world.spawn(Ship(position: Position(x: 0, y: 0), armored: true))","print(world.contains(Armor.self, in: ship))","\/\/ Prints \"true\""],"type":"codeListing"},{"inlineContent":[{"type":"text","text":"Removing a bundle type removes every component type the bundle can hold, including the types"},{"type":"text","text":" "},{"type":"text","text":"of branches that weren’t taken:"}],"type":"paragraph"},{"syntax":"swift","code":["var world = World()","let ship = world.spawn(","    Ship(position: Position(x: 0, y: 0), armored: false),","    Health(current: 50)",")","","world.remove(Ship.self, from: ship)","print(world.contains(Position.self, in: ship), world.contains(Health.self, in: ship))","\/\/ Prints \"false true\""],"type":"codeListing"},{"inlineContent":[{"type":"text","text":"Every "},{"type":"reference","identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/Component","isActive":true},{"type":"text","text":" is a bundle of itself, so anywhere a bundle is expected, you can pass a"},{"type":"text","text":" "},{"type":"text","text":"single component."}],"type":"paragraph"},{"style":"note","name":"Note","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Foundation also declares a type named "},{"code":"Bundle","type":"codeVoice"},{"type":"text","text":". In a file that imports Foundation,"},{"type":"text","text":" "},{"type":"text","text":"write "},{"code":"ECS.Bundle","type":"codeVoice"},{"type":"text","text":" to name this protocol."}]}],"type":"aside"}],"kind":"content"}],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/WorldModul