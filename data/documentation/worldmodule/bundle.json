:", "},{"type":"codeVoice","code":"switch"},{"type":"text","text":" and optional values:"}],"type":"paragraph"},{"syntax":"swift","code":["struct Armor: Component { var rating: Int }","","struct Ship: Bundle {","    var position: Position","    var armored: Bool","","    var body: some Bundle {","        position","        Velocity(dx: 0, dy: 0)","        if armored { Armor(rating: 10) }","    }","}","","var world = World()","let ship = world.spawn(Ship(position: Position(x: 0, y: 0), armored: true))","print(world.contains(Armor.self, in: ship))","\/\/ Prints \"true\""],"type":"codeListing"},{"inlineContent":[{"type":"text","text":"Removing a bundle type removes every component type the bundle can hold, including the types"},{"type":"text","text":" "},{"type":"text","text":"of branches that weren’t taken:"}],"type":"paragraph"},{"syntax":"swift","code":["var world = World()","let ship = world.spawn(","    Ship(position: Position(x: 0, y: 0), armored: false),","    Health(current: 50)",")","","world.remove(Ship.self, from: ship)","print(world.contains(Position.self, in: ship), world.contains(Health.self, in: ship))","\/\/ Prints \"false true\""],"type":"codeListing"},{"inlineContent":[{"text":"Every ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/Component"},{"text":" is a bundle of itself, so anywhere a bundle is expected, you can pass a","type":"text"},{"text":" ","type":"text"},{"text":"single component.","type":"text"}],"type":"paragraph"},{"name":"Note","style":"note","content":[{"inlineContent":[{"text":"Foundation also declares a type named ","type":"text"},{"code":"Bundle","type":"codeVoice"},{"text":". In a file that imports Foundation,","type":"text"},{"text":" ","type":"text"},{"text":"write ","type":"text"},{"code":"ECS.Bundle","type":"codeVoice"},{"text":" to name this protocol.","type":"text"}],"type":"paragraph"}],"type":"aside"}],"kind":"content"}],"hierarchy":{"paths":[["doc:\/\/Worl