preciseIdentifier":"s:s8SendableP"}],"languages":["swift"],"platforms":["Linux"]}],"kind":"declarations"},{"content":[{"level":2,"anchor":"overview","type":"heading","text":"Overview"},{"inlineContent":[{"type":"text","text":"Use a bundle to name a set of components that often go together, such as everything a ship"},{"type":"text","text":" "},{"type":"text","text":"needs, so you can spawn them in one step and keep that set in one place. Declare the"},{"type":"text","text":" "},{"type":"text","text":"bundle’s contents in its "},{"isActive":true,"type":"reference","identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/Bundle\/body-9bv1p"},{"type":"text","text":" property. The body is built by "},{"isActive":true,"type":"reference","identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/BundleBuilder"},{"type":"text","text":", so you"},{"type":"text","text":" "},{"type":"text","text":"can list components and other bundles, and use "},{"type":"codeVoice","code":"if"},{"type":"text","text":", "},{"type":"codeVoice","code":"switch"},{"type":"text","text":" and optional values:"}],"type":"paragraph"},{"code":["struct Armor: Component { var rating: Int }","","struct Ship: Bundle {","    var position: Position","    var armored: Bool","","    var body: some Bundle {","        position","        Velocity(dx: 0, dy: 0)","        if armored { Armor(rating: 10) }","    }","}","","var world = World()","let ship = world.spawn(Ship(position: Position(x: 0, y: 0), armored: true))","print(world.contains(Armor.self, in: ship))","\/\/ Prints \"true\""],"type":"codeListing","syntax":"swift"},{"inlineContent":[{"text":"Removing a bundle type removes every component type the bundle can hold, including the types","type":"text"},{"text":" ","type":"text"},{"text":"of branches that weren’t taken:","type":"text"}],"type":"paragraph"},{"code":["var world = World()","let ship = world.spawn(","    Ship(position: Position(x: 0, y: 0), armored: false),","    Health(current: 50)",")