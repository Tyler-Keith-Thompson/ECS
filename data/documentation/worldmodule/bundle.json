tion\/WorldModule\/Bundle\/body-9bv1p","type":"reference","isActive":true},{"text":" property. The body is built by ","type":"text"},{"identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/BundleBuilder","type":"reference","isActive":true},{"text":", so you","type":"text"},{"text":" ","type":"text"},{"text":"can list components and other bundles, and use ","type":"text"},{"code":"if","type":"codeVoice"},{"text":", ","type":"text"},{"code":"switch","type":"codeVoice"},{"text":" and optional values:","type":"text"}],"type":"paragraph"},{"syntax":"swift","type":"codeListing","code":["struct Armor: Component { var rating: Int }","","struct Ship: Bundle {","    var position: Position","    var armored: Bool","","    var body: some Bundle {","        position","        Velocity(dx: 0, dy: 0)","        if armored { Armor(rating: 10) }","    }","}","","var world = World()","let ship = world.spawn(Ship(position: Position(x: 0, y: 0), armored: true))","print(world.contains(Armor.self, in: ship))","\/\/ Prints \"true\""]},{"inlineContent":[{"type":"text","text":"Removing a bundle type removes every component type the bundle can hold, including the types"},{"type":"text","text":" "},{"type":"text","text":"of branches that weren’t taken:"}],"type":"paragraph"},{"syntax":"swift","type":"codeListing","code":["var world = World()","let ship = world.spawn(","    Ship(position: Position(x: 0, y: 0), armored: false),","    Health(current: 50)",")","","world.remove(Ship.self, from: ship)","print(world.contains(Position.self, in: ship), world.contains(Health.self, in: ship))","\/\/ Prints \"false true\""]},{"inlineContent":[{"type":"text","text":"Every "},{"isActive":true,"type":"reference","identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/Component"},{"type":"text","text":" is a bundle of itself, so anywhere a bundle is expected, you can pass a"},{"type":"text","text":" "},{"type":"text","text":"single component."}],"type":"paragraph"},{"style":"note","content":[{"