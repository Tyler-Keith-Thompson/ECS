{"abstract":[{"text":"A type that groups components to be spawned, inserted, and removed together.","type":"text"}],"relationshipsSections":[{"kind":"relationships","title":"Inherits From","type":"inheritsFrom","identifiers":["doc:\/\/WorldModule\/s8SendableP","doc:\/\/WorldModule\/s16SendableMetatypeP"]},{"kind":"relationships","title":"Inherited By","type":"inheritedBy","identifiers":["doc:\/\/WorldModule\/documentation\/WorldModule\/Component"]},{"kind":"relationships","title":"Conforming Types","type":"conformingTypes","identifiers":["doc:\/\/WorldModule\/documentation\/WorldModule\/Disabled","doc:\/\/WorldModule\/documentation\/WorldModule\/EitherBundle","doc:\/\/WorldModule\/documentation\/WorldModule\/Swift\/Never","doc:\/\/WorldModule\/documentation\/WorldModule\/Swift\/Optional","doc:\/\/WorldModule\/documentation\/WorldModule\/Prefab","doc:\/\/WorldModule\/documentation\/WorldModule\/Targets","doc:\/\/WorldModule\/documentation\/WorldModule\/TupleBundle"]}],"schemaVersion":{"major":0,"minor":3,"patch":0},"identifier":{"url":"doc:\/\/WorldModule\/documentation\/WorldModule\/Bundle","interfaceLanguage":"swift"},"primaryContentSections":[{"kind":"declarations","declarations":[{"platforms":["Linux"],"tokens":[{"kind":"keyword","text":"protocol"},{"kind":"text","text":" "},{"kind":"identifier","text":"Bundle"},{"kind":"text","text":" : "},{"kind":"typeIdentifier","text":"Sendable","preciseIdentifier":"s:s8SendableP"}],"languages":["swift"]}]},{"content":[{"type":"heading","text":"Overview","anchor":"overview","level":2},{"type":"paragraph","inlineContent":[{"text":"Use a bundle to name a set of components that often go together, such as everything a ship","type":"text"},{"text":" ","type":"text"},{"text":"needs, so you can spawn them in one step and keep that set in one place. Declare the","type":"text"},{"text":" ","type":"text"},{"text":"bundle’s contents in its ","type":"text"},{"identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/Bundle\/body-9bv1p","isActive":true,"type":"reference"},{"text":" property. The body is built by ","type":"text"},{"identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/BundleBuilder","isActive":true,"type":"reference"},{"type":"text","text":", so you"},{"type":"text","text":" "},{"type":"text","text":"can list components and other bundles, and use "},{"type":"codeVoice","code":"if"},{"type":"text","text":", "},{"type":"codeVoice","code":"switch"},{"type":"text","text":" and optional values:"}]},{"code":["struct Armor: Component { var rating: Int }","","struct Ship: Bundle {","    var position: Position","    var armored: Bool","","    var body: some Bundle {","        position","        Velocity(dx: 0, dy: 0)","        if armored { Armor(rating: 10) }","    }","}","","var world = World()","let ship = world.spawn(Ship(position: Position(x: 0, y: 0), armored: true))","print(world.contains(Armor.self, in: ship))","\/\/ Prints \"true\""],"type":"codeListing","syntax":"swift"},{"type":"paragraph","inlineContent":[{"text":"Removing a bundle type removes every component type the bundle can hold, including the types","type":"text"},{"text":" ","type":"text"},{"text":"of branches that weren’t taken:","type":"text"}]},{"code":["var world = World()","let ship = world.spawn(","    Ship(position: Position(x: 0, y: 0), armored: false),","    Health(current: 50)",")","","world.remove(Ship.self, from: ship)","print(world.contains(Position.self, in: ship), world.contains(Health.self, in: ship))","\/\/ Prints \"false true\""],"type":"codeListing","syntax":"swift"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Every "},{"type":"reference","isActive":true,"identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/Component"},{"type":"text","text":" is a bundle of itself, so anywhere a bundle is expected, you can pass a"},{"type":"text","text":" "},{"type":"text","text":"single component."}]},{"name":"Note","type":"aside","style":"note","content":[{"inlineContent":[{"type":"text","text":"Foundation also declares a type named "},{"type":"codeVoice","code":"Bundle"},{"type":"text","text":". In a file that imports Foundation,"},{"type":"text","text":" "},{"type":"text","text":"write "},{"type":"codeVoice","code":"ECS.Bundle"},{"type":"text","text":" to name this protocol."}],"type":"paragraph"}]}],"kind":"content"}],"hierarchy":{"paths":[["doc:\/\/WorldModule\/documentation\/WorldModule"]]},"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/worldmodule\/bundle"]}],"seeAlsoSections":[{"title":"Grouping Components","anchor":"Grouping-Components","generated":true,"identifiers":["doc:\/\/WorldModule\/documentation\/WorldModule\/BundleBuilder","doc:\/\/WorldModule\/documentation\/WorldModule\/TupleBundle","doc:\/\/WorldModule\/documentation\/WorldModule\/EitherBundle"]}],"kind":"symbol","sections":[],"metadata":{"remoteSource":{"fileName":"Bundle.swift","url":"https:\/\/github.com\/Tyler-Keith-Thompson\/ECS\/blob\/main\/Sources\/WorldModule\/Bundle.swift#L48"},"symbolKind":"protocol","modules":[{"name":"WorldModule"}],"role":"symbol","roleHeading":"Protocol","fragments":[{"text":"protocol","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Bundle","kind":"identifier"}],"externalID":"s:11WorldModule6BundleP","title":"Bundle","navigatorTitle":[{"text":"Bundle","kind":"identifier"}]},"topicSections":[{"title":"Associated Types","identifiers":["doc:\/\/WorldModule\/documentation\/WorldModule\/Bundle\/Body-swift.associatedtype"],"generated":true,"anchor":"Associated-Types"},{"title":"Instance Properties","identifiers":["doc:\/\/WorldModule\/documentation\/WorldModule\/Bundle\/body-9bv1p"],"generated":true,"anchor":"Instance-Properties"},{"title":"Instance Methods","identifiers":["doc:\/\/WorldModule\/documentation\/WorldModule\/Bundle\/insert(into:in:)"],"generated":true,"anchor":"Instance-Methods"},{"title":"Type Methods","identifiers":["doc:\/\/WorldModule\/documentation\/WorldModule\/Bundle\/remove(from:in:)"],"ge