{"kind":"symbol","sections":[],"schemaVersion":{"minor":3,"major":0,"patch":0},"hierarchy":{"paths":[["doc:\/\/WorldModule\/documentation\/WorldModule"]]},"primaryContentSections":[{"declarations":[{"platforms":["Linux"],"languages":["swift"],"tokens":[{"text":"@frozen","kind":"attribute"},{"text":" ","kind":"text"},{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Query","kind":"identifier"},{"text":"<each ","kind":"text"},{"text":"T","kind":"genericParameter"},{"text":"> ","kind":"text"},{"text":"where","kind":"keyword"},{"text":" repeat each ","kind":"text"},{"text":"T","kind":"typeIdentifier"},{"text":" : ","kind":"text"},{"text":"QueryTerm","kind":"typeIdentifier","identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/QueryTerm","preciseIdentifier":"s:11WorldModule9QueryTermP"}]}],"kind":"declarations"},{"mentions":["doc:\/\/WorldModule\/documentation\/WorldModule\/QueryingAWorld","doc:\/\/WorldModule\/documentation\/WorldModule\/ReactingToChanges"],"kind":"mentions"},{"content":[{"level":2,"text":"Overview","anchor":"overview","type":"heading"},{"inlineContent":[{"text":"A query has ","type":"text"},{"inlineContent":[{"type":"text","text":"terms"}],"type":"emphasis"},{"text":" and a ","type":"text"},{"inlineContent":[{"type":"text","text":"filter"}],"type":"emphasis"},{"text":". Each term is either a component type, which an entity must","type":"text"},{"text":" ","type":"text"},{"text":"hold and whose value the query reads, or an ","type":"text"},{"identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/AnyOf","isActive":true,"type":"reference"},{"text":" group, which an entity matches by holding","type":"text"},{"text":" ","type":"text"},{"text":"at least one of its types. The filter adds conditions that read nothing: types an entity must","type":"text"},{"text":" ","type":"text"},{"text":"or must not hold, components added or changed since a tick, and relations. An entity matches","type":"text"},{"text":" ","type":"text"},{"text":"the query when it matches every term and passes the filter.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"A query doesn’t belong to any world. Build it once, store it, compare it with another, and run"},{"type":"text","text":" "},{"type":"text","text":"it against any world. The following example finds the entities that move and aren’t frozen:"}],"type":"paragraph"},{"code":["var world = World()","world.spawn(Name(value: \"comet\"), Position(x: 0, y: 0), Velocity(dx: 1, dy: 0))","world.spawn(Name(value: \"statue\"), Position(x: 4, y: 2), Velocity(dx: 1, dy: 0), Frozen())","world.spawn(Name(value: \"moon\"), Position(x: 9, y: 9))","","let movers = Query(Name.self, Position.self, Velocity.self).without(Frozen.self)","","var names: [String] = []","for (_, name, _, _) in world.query(movers) {","    names.append(name.value)","}","print(names)","\/\/ Prints \"[\"comet\"]\""],"syntax":"swift","type":"codeListing"},{"inlineContent":[{"type":"text","text":"Each row starts with the entity, labeled "},{"type":"codeVoice","code":"entity"},{"type":"text","text":", followed by one value per term in the order"},{"type":"text","text":" "},{"type":"text","text":"the query lists them. The statue holds every term but is frozen, and the moon has no velocity."}],"type":"paragraph"},{"inlineContent":[{"text":"To change components while you visit them, pass a query to ","type":"text"},{"type":"codeVoice","code":"update(_:over:body:)"},{"text":". The","type":"text"},{"text":" ","type":"text"},{"text":"following example moves every entity that has a velocity and isn’t frozen:","type":"text"}],"type":"paragraph"},{"code":["var world = World()","let comet = world.spawn(Position(x: 0, y: 0), Velocity(dx: 1, dy: 2))","let statue = world.spawn(Position(x: 4, y: 2), Velocity(dx: 1, dy: 0), Frozen())","","world.update(Position.self, over: Query(Velocity.self).without(Frozen.self)) { position, row in","    position.x += row.components.dx","    position.y += row.components.dy","}","print(world[Position.self, of: comet])","\/\/ Prints \"Position(x: 1.0, y: 2.0)\"","print(world[Position.self, of: statue])","\/\/ Prints \"Position(x: 4.0, y: 2.0)\""],"syntax":"swift","type":"codeListing"},{"inlineContent":[{"type":"text","text":"As a parameter of a system, a query arrives bound to the world the system runs on, and you"},{"type":"text","text":" "},{"type":"text","text":"iterate it directly. A system spells its filter as types; see "},{"identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/Query\/Where","type":"reference","isActive":true},{"type":"text","text":"."}],"type":"paragraph"},{"inlineContent":[{"text":"Queries of one to three terms, each a component or an ","type":"text"},{"isActive":true,"identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/AnyOf","type":"reference"},{"text":" group of two to four types, run","type":"text"},{"text":" ","type":"text"},{"text":"through code specialized for their exact shape. Other shapes take a general path that does more","type":"text"},{"text":" ","type":"text"},{"text":"work per entity.","type":"text"}],"type":"paragraph"}],"kind":"content"}],"relationshipsSections":[{"title":"Conforms To","identifiers":["doc:\/\/WorldModule\/s8CopyableP","doc:\/\/WorldModule\/SQ","doc:\/\/WorldModule\/s9EscapableP","doc:\/\/WorldModule\/SH","doc:\/\/WorldModule\/s8SendableP","doc:\/\/WorldModule\/s16SendableMetatypeP","doc:\/\/WorldModule\/ST"],"type":"conformsTo","kind":"relationships"}],"seeAlsoSections":[{"anchor":"Querying-and-Updating-Entities","generated":true,"identifiers":["doc:\/\/WorldModule\/documentation\/WorldModule\/QueryingAWorld","doc:\/\/WorldModule\/documentation\/WorldModule\/QueryView","doc:\/\/WorldModule\/documentation\/WorldModule\/EntityQueryView","doc:\/\/WorldModule\/documentation\/WorldModule\/QueryRow","doc:\/\/WorldModule\/documentation\/WorldModule\/QueryTerm","doc:\/\/WorldModule\/documentation\/WorldModule\/AnyOf","doc:\/\/WorldModule\/documentatio