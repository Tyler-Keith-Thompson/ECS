EntityQueryView","doc:\/\/WorldModule\/documentation\/WorldModule\/QueryRow","doc:\/\/WorldModule\/documentation\/WorldModule\/QueryTerm","doc:\/\/WorldModule\/documentation\/WorldModule\/AnyOf","doc:\/\/WorldModule\/documentation\/WorldModule\/EntitiesView"]}],"schemaVersion":{"major":0,"minor":3,"patch":0},"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/WorldModule\/documentation\/WorldModule\/Query"},"metadata":{"roleHeading":"Structure","role":"symbol","modules":[{"name":"WorldModule"}],"symbolKind":"struct","navigatorTitle":[{"kind":"identifier","text":"Query"}],"fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Query","kind":"identifier"}],"externalID":"s:11WorldModule5QueryV","remoteSource":{"fileName":"Query.swift","url":"https:\/\/github.com\/Tyler-Keith-Thompson\/ECS\/blob\/main\/Sources\/WorldModule\/Query.swift#L56"},"title":"Query"},"abstract":[{"type":"text","text":"A description of the entities to visit and the components to read from each."}],"relationshipsSections":[{"type":"conformsTo","kind":"relationships","title":"Conforms To","identifiers":["doc:\/\/WorldModule\/s8CopyableP","doc:\/\/WorldModule\/SQ","doc:\/\/WorldModule\/s9EscapableP","doc:\/\/WorldModule\/SH","doc:\/\/WorldModule\/s8SendableP","doc:\/\/WorldModule\/s16SendableMetatypeP","doc:\/\/WorldModule\/ST"]}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/worldmodule\/query"]}],"hierarchy":{"paths":[["doc:\/\/WorldModule\/documentation\/WorldModule"]]},"primaryContentSections":[{"declarations":[{"languages":["swift"],"platforms":["Linux"],"tokens":[{"text":"@frozen","kind":"attribute"},{"text":" ","kind":"text"},{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Query","kind":"identifier"},{"text":"<each ","kind":"text"},{"text":"T","kind":"genericParameter"},{"text":"> ","kind":"text"},{"text":"where","kind":"keyword"},{"text":" repeat each ","kind":"text"},{"text":"T","kind":"typeIdentifier"},{"text":" : ","kind":"text"},{"text":"QueryTerm","preciseIdentifier":"s:11WorldModule9QueryTermP","kind":"typeIdentifier","identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/QueryTerm"}]}],"kind":"declarations"},{"kind":"mentions","mentions":["doc:\/\/WorldModule\/documentation\/WorldModule\/QueryingAWorld"]},{"content":[{"type":"heading","text":"Overview","anchor":"overview","level":2},{"type":"paragraph","inlineContent":[{"type":"text","text":"A query has "},{"type":"emphasis","inlineContent":[{"text":"terms","type":"text"}]},{"type":"text","text":" and a "},{"type":"emphasis","inlineContent":[{"text":"filter","type":"text"}]},{"type":"text","text":". Each term is either a component type, which an entity must"},{"type":"text","text":" "},{"type":"text","text":"hold and whose value the query reads, or an "},{"identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/AnyOf","type":"reference","isActive":true},{"type":"text","text":" group, which an entity matches by holding"},{"type":"text","text":" "},{"type":"text","text":"at least one of its types. The filter adds conditions that read nothing: types an entity must"},{"type":"text","text":" "},{"type":"text","text":"or must not hold, components added or changed since a tick, and relations. An entity matches"},{"type":"text","text":" "},{"type":"text","text":"the query when it matches every term and passes the filter."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"A query doesn’t belong to any world. Build it once, store it, compare it with another, and run"},{"type":"text","text":" "},{"type":"text","text":"it against any world. The following example finds the entities that move and aren’t frozen:"}]},{"type":"codeListing","syntax":"swift","code":["var world = World()","world.spawn(Name(value: \"comet\"), Position(x: 0, y: 0), Velocity(dx: 1, dy: 0))","world.spawn(Name(value: \"statue\"), Position(x: 4, y: 2), Velocity(dx: 1, dy: 0), Frozen())","world.spawn(Name(value: \"moon\"), Position(x: 9, y: 9))","","let movers = Query(Name.self, Position.self, Velocity.self).without(Frozen.self)","","var names: [String] = []","for (_, name, _, _) in world.query(movers) {","    names.append(name.value)","}","print(names)","\/\/ Prints \"[\"comet\"]\""]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Each row starts with the entity, labeled "},{"code":"entity","type":"codeVoice"},{"type":"text","text":", followed by one value per term in the order"},{"type":"text","text":" "},{"type":"text","text":"the query lists them. The statue holds every term but is frozen, and the moon has no velocity."}]},{"type":"paragraph","inlineContent":[{"text":"To change components while you visit them, pass a query to ","type":"text"},{"code":"update(_:over:body:)","type":"codeVoice"},{"text":". The","type":"text"},{"text":" ","type":"text"},{"text":"following example moves every entity that has a velocity and isn’t frozen:","type":"text"}]},{"type":"codeListing","syntax":"swift","code":["var world = World()","let comet = world.spawn(Position(x: 0, y: 0), Velocity(dx: 1, dy: 2))","let statue = world.spawn(Position(x: 4, y: 2), Velocity(dx: 1, dy: 0), Frozen())","","world.update(Position.self, over: Query(Velocity.self).without(Frozen.self)) { position, row in","    position.x += row.components.dx","    position.y += row.components.dy","}","print(world[Position.self, of: comet])","\/\/ Prints \"Position(x: 1.0, y: 2.0)\"","print(world[Position.self, of: statue])","\/\/ Prints \"Position(x: 4.0, y: 2.0)\""]},{"type":"paragraph","inlineContent":[{"text":"As a parameter of a system, a query arrives bound to the world the system runs on, and you","type":"text"},{"text":" ","type":"text"},{"text":"iterate it directly. A system spells its filter as types; see ","type":"text"},{"identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/Query\/Where","type":"reference","isActive":true},{"text":".","type":"text"}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Queries of one to three terms, each a component or an "},{"type":"reference","isActive":true,"identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/AnyOf"},{"type":"text","text":" group of two to four types, run"},{"type":"text","text":" "},{"type":"text","text":"through code specialized for their exact shape. Other shapes take a general path that does more"},{"type":"text","text":" "},{"type":"text","text":"work per entity."}]}],"kind":"content"}],"sections":[],"kind":"symbol","references":{"doc://WorldModule/documentation/WorldModule/Query":{"type":"topic","role":"symbol","identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/Query","title":"Query","kind":"symbol","url":"\/documentation\/worldmodule\/query","abstract":[{"text":"A description of the entities to visit and the components to read from each.","type":"text"}],"navigatorTitle":[{"text":"Query","kind":"identifier"}],"fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Query","kind":"identifier"}]},"doc://WorldModule/documentation/WorldModule/Query/hash(into:)":{"type":"topic","title":"hash(into:)","identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/Query\/hash(into:)","url":"\/documentation\/worldmodule\/query\/hash(into:)","abstract":[{"type":"text","text":"Hashes the query’s filter by feeding it into the given hasher."}],"role":"symbol","kind":"symbol","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"hash","kind":"identifier"},{"text":"(","kind":"text"},{"text":"into","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"inout","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Hasher","kind":"typeIdentifier","preciseIdentifier":"s:s6HasherV"},{"text":")","kind":"text"}]},"doc://WorldModule/documentation/WorldModule/Query/==(_:_:)":{"abstract":[{"type":"text","text":"Returns a Boolean value indicating whether two queries have the same filter."}],"type":"topic","title":"==(_:_:)","identifier":"d