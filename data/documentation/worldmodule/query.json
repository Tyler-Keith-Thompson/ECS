{"sections":[],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/worldmodule\/query"]}],"schemaVersion":{"patch":0,"minor":3,"major":0},"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/WorldModule\/documentation\/WorldModule\/Query"},"hierarchy":{"paths":[["doc:\/\/WorldModule\/documentation\/WorldModule"]]},"kind":"symbol","metadata":{"fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"Query"}],"roleHeading":"Structure","title":"Query","remoteSource":{"fileName":"Query.swift","url":"https:\/\/github.com\/Tyler-Keith-Thompson\/ECS\/blob\/main\/Sources\/WorldModule\/Query.swift#L56"},"modules":[{"name":"WorldModule"}],"externalID":"s:11WorldModule5QueryV","role":"symbol","symbolKind":"struct","navigatorTitle":[{"text":"Query","kind":"identifier"}]},"abstract":[{"text":"A description of the entities to visit and the components to read from each.","type":"text"}],"topicSections":[{"identifiers":["doc:\/\/WorldModule\/documentation\/WorldModule\/Query\/Where"],"anchor":"Structures","generated":true,"title":"Structures"},{"identifiers":["doc:\/\/WorldModule\/documentation\/WorldModule\/Query\/==(_:_:)"],"anchor":"Operators","generated":true,"title":"Operators"},{"identifiers":["doc:\/\/WorldModule\/documentation\/WorldModule\/Query\/init(_:)","doc:\/\/WorldModule\/documentation\/WorldModule\/Query\/init(filter:)"],"anchor":"Initializers","generated":true,"title":"Initializers"},{"identifiers":["doc:\/\/WorldModule\/documentation\/WorldModule\/Query\/filter","doc:\/\/WorldModule\/documentation\/WorldModule\/Query\/first"],"anchor":"Instance-Properties","generated":true,"title":"Instance Properties"},{"identifiers":["doc:\/\/WorldModule\/documentation\/WorldModule\/Query\/added(_:since:)","doc:\/\/WorldModule\/documentation\/WorldModule\/Query\/allowing(_:)","doc:\/\/WorldModule\/documentation\/WorldModule\/Query\/anyOf(_:)","doc:\/\/WorldModule\/documentation\/WorldModule\/Query\/changed(_:since:)","doc:\/\/WorldModule\/documentation\/WorldModule\/Query\/filtered(by:)","doc:\/\/WorldModule\/documentation\/WorldModule\/Query\/hash(into:)","doc:\/\/WorldModule\/documentation\/WorldModule\/Query\/related(_:to:)","doc:\/\/WorldModule\/documentation\/WorldModule\/Query\/with(_:)","doc:\/\/WorldModule\/documentation\/WorldModule\/Query\/without(_:)"],"anchor":"Instance-Methods","generated":true,"title":"Instance Methods"},{"identifiers":["doc:\/\/WorldModule\/documentation\/WorldModule\/Query\/Equatable-Implementations","doc:\/\/WorldModule\/documentation\/WorldModule\/Query\/Sequence-Implementations"],"anchor":"Default-Implementations","generated":true,"title":"Default Implementations"}],"relationshipsSections":[{"title":"Conforms To","identifiers":["doc:\/\/WorldModule\/s8CopyableP","doc:\/\/WorldModule\/SQ","doc:\/\/WorldModule\/s9EscapableP","doc:\/\/WorldModule\/SH","doc:\/\/WorldModule\/s8SendableP","doc:\/\/WorldModule\/s16SendableMetatypeP","doc:\/\/WorldModule\/ST"],"type":"conformsTo","kind":"relationships"}],"primaryContentSections":[{"declarations":[{"platforms":["Linux"],"tokens":[{"kind":"attribute","text":"@frozen"},{"kind":"text","text":" "},{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"Query"},{"kind":"text","text":"<each "},{"kind":"genericParameter","text":"T"},{"kind":"text","text":"> "},{"kind":"keyword","text":"where"},{"kind":"text","text":" repeat each "},{"kind":"typeIdentifier","text":"T"},{"kind":"text","text":" : "},{"kind":"typeIdentifier","text":"QueryTerm","identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/QueryTerm","preciseIdentifier":"s:11WorldModule9QueryTermP"}],"languages":["swift"]}],"kind":"declarations"},{"mentions":["doc:\/\/WorldModule\/documentation\/WorldModule\/QueryingAWorld"],"kind":"mentions"},{"content":[{"level":2,"anchor":"overview","type":"heading","text":"Overview"},{"type":"paragraph","inlineContent":[{"type":"text","text":"A query has "},{"inlineContent":[{"type":"text","text":"terms"}],"type":"emphasis"},{"type":"text","text":" and a "},{"inlineContent":[{"type":"text","text":"filter"}],"type":"emphasis"},{"type":"text","text":". Each term is either a component type, which an entity must"},{"type":"text","text":" "},{"type":"text","text":"hold and whose value the query reads, or an "},{"identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/AnyOf","type":"reference","isActive":true},{"type":"text","text":" group, which an entity matches by holding"},{"type":"text","text":" "},{"type":"text","text":"at least one of its types. The filter adds conditions that read nothing: types an entity must"},{"type":"text","text":" "},{"type":"text","text":"or must not hold, components added or changed since a tick, and relations. An entity matches"},{"type":"text","text":" "},{"type":"text","text":"the query when it matches every term and passes the filter."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"A query doesn’t belong to any world. Build it once, store it, compare it with another, and run"},{"type":"text","text":" "},{"type":"text","text":"it against any world. The following example finds the entities that move and aren’t frozen:"}]},{"syntax":"swift","code":["var world = World()","world.spawn(Name(value: \"comet\"), Position(x: 0, y: 0), Velocity(dx: 1, dy: 0))","world.spawn(Name(value: \"statue\"), Position(x: 4, y: 2), Velocity(dx: 1, dy: 0), Frozen())","world.spawn(Name(value: \"moon\"), Position(x: 9, y: 9))","","let movers = Query(Name.self, Position.self, Velocity.self).without(Frozen.self)","","var names: [String] = []","for (_, name, _, _) in world.query(movers) {","    names.append(name.value)","}","print(names)","\/\/ Prints \"[\"comet\"]\""],"type":"codeListing"},{"type":"paragraph","inlineContent":[{"text":"Each row starts with the entity, labeled ","type":"text"},{"code":"entity","type":"codeVoice"},{"text":", followed by one value per term in the order","type":"text"},{"text":" ","type":"text"},{"text":"the query lists them. The statue holds every term but is frozen, and the moon has no velocity.","type":"text"}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"To change components while you visit them, pass a query to "},{"code":"update(_:over:body:)","type":"codeVoice"},{"type":"text","text":". The"},{"type":"text","text":" "},{"type":"text","text":"following example moves every entity that has a velocity and isn’t frozen:"}]},{"syntax":"swift","code":["var world = World()","let comet = world.spawn(Position(x: 0, y: 0), Velocity(dx: 1, dy: 2))","let statue = world.spawn(Position(x: 4, y: 2), Velocity(dx: 1, dy: 0), Frozen())","","world.update(Position.self, over: Query(Velocity.self).without(Frozen.self)) { position, row in","    position.x += row.components.dx","    position.y += row.components.dy","}","print(world[Position.self, of: comet])","\/\/ Prints \"Position(x: 1.0, y: 2.0)\"","print(world[Position.self, of: statue])","\/\/ Prints \"Position(x: 4.0, y: 2.0)\""],"type":"codeListing"},{"type":"paragraph","inlineContent":[{"text":"As a parameter of a system, a query arrives bound to the world the system runs on, and you","type":"text"},{"text":" ","type":"text"},{"text":"iterate it directly. A system spells its filter as types; see ","type":"text"},{"identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/Query\/Where","isActive":true,"type":"reference"},{"text":".","type":"text"}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Queries of one to three terms, each a component or an "},{"identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/AnyOf","type":"reference","isActive":true},{"type":"text","text":" group of two to four types, run"},{"type":"text","text":" "},{"type":"text","text":"through code specialized for their exact shape. Other shapes take a general path that does more"},{"type":"text","text":" "},{"type":"text","text":"work per entity."}]}],"kind":"content"}],"seeAlsoS