{"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/worldmodule\/query"]}],"sections":[],"seeAlsoSections":[{"anchor":"Querying-and-Updating-Entities","title":"Querying and Updating Entities","generated":true,"identifiers":["doc:\/\/WorldModule\/documentation\/WorldModule\/QueryingAWorld","doc:\/\/WorldModule\/documentation\/WorldModule\/QueryView","doc:\/\/WorldModule\/documentation\/WorldModule\/EntityQueryView","doc:\/\/WorldModule\/documentation\/WorldModule\/QueryRow","doc:\/\/WorldModule\/documentation\/WorldModule\/QueryTerm","doc:\/\/WorldModule\/documentation\/WorldModule\/AnyOf","doc:\/\/WorldModule\/documentation\/WorldModule\/EntitiesView"]}],"schemaVersion":{"minor":3,"patch":0,"major":0},"abstract":[{"type":"text","text":"A description of the entities to visit and the components to read from each."}],"relationshipsSections":[{"identifiers":["doc:\/\/WorldModule\/s8CopyableP","doc:\/\/WorldModule\/SQ","doc:\/\/WorldModule\/s9EscapableP","doc:\/\/WorldModule\/SH","doc:\/\/WorldModule\/s8SendableP","doc:\/\/WorldModule\/s16SendableMetatypeP","doc:\/\/WorldModule\/ST"],"title":"Conforms To","type":"conformsTo","kind":"relationships"}],"topicSections":[{"anchor":"Structures","title":"Structures","generated":true,"identifiers":["doc:\/\/WorldModule\/documentation\/WorldModule\/Query\/Where"]},{"anchor":"Operators","title":"Operators","generated":true,"identifiers":["doc:\/\/WorldModule\/documentation\/WorldModule\/Query\/==(_:_:)"]},{"anchor":"Initializers","title":"Initializers","generated":true,"identifiers":["doc:\/\/WorldModule\/documentation\/WorldModule\/Query\/init(_:)","doc:\/\/WorldModule\/documentation\/WorldModule\/Query\/init(filter:)"]},{"anchor":"Instance-Properties","title":"Instance Properties","generated":true,"identifiers":["doc:\/\/WorldModule\/documentation\/WorldModule\/Query\/filter","doc:\/\/WorldModule\/documentation\/WorldModule\/Query\/first"]},{"anchor":"Instance-Methods","title":"Instance Methods","generated":true,"identifiers":["doc:\/\/WorldModule\/documentation\/WorldModule\/Query\/added(_:since:)","doc:\/\/WorldModule\/documentation\/WorldModule\/Query\/allowing(_:)","doc:\/\/WorldModule\/documentation\/WorldModule\/Query\/anyOf(_:)","doc:\/\/WorldModule\/documentation\/WorldModule\/Query\/changed(_:since:)","doc:\/\/WorldModule\/documentation\/WorldModule\/Query\/filtered(by:)","doc:\/\/WorldModule\/documentation\/WorldModule\/Query\/hash(into:)","doc:\/\/WorldModule\/documentation\/WorldModule\/Query\/related(_:to:)","doc:\/\/WorldModule\/documentation\/WorldModule\/Query\/with(_:)","doc:\/\/WorldModule\/documentation\/WorldModule\/Query\/without(_:)"]},{"anchor":"Default-Implementations","title":"Default Implementations","generated":true,"identifiers":["doc:\/\/WorldModule\/documentation\/WorldModule\/Query\/Equatable-Implementations","doc:\/\/WorldModule\/documentation\/WorldModule\/Query\/Sequence-Implementations"]}],"identifier":{"url":"doc:\/\/WorldModule\/documentation\/WorldModule\/Query","interfaceLanguage":"swift"},"kind":"symbol","primaryContentSections":[{"declarations":[{"tokens":[{"text":"@frozen","kind":"attribute"},{"text":" ","kind":"text"},{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Query","kind":"identifier"},{"text":"<each ","kind":"text"},{"text":"T","kind":"genericParameter"},{"text":"> ","kind":"text"},{"text":"where","kind":"keyword"},{"text":" repeat each ","kind":"text"},{"text":"T","kind":"typeIdentifier"},{"text":" : ","kind":"text"},{"text":"QueryTerm","preciseIdentifier":"s:11WorldModule9QueryTermP","kind":"typeIdentifier","identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/QueryTerm"}],"platforms":["Linux"],"languages":["swift"]}],"kind":"declarations"},{"mentions":["doc:\/\/WorldModule\/documentation\/WorldModule\/QueryingAWorld"],"kind":"mentions"},{"content":[{"type":"heading","anchor":"overview","text":"Overview","level":2},{"type":"paragraph","inlineContent":[{"text":"A query has ","type":"text"},{"inlineContent":[{"text":"terms","type":"text"}],"type":"emphasis"},{"text":" and a ","type":"text"},{"inlineContent":[{"text":"filter","type":"text"}],"type":"emphasis"},{"text":". Each term is either a component type, which an entity must","type":"text"},{"text":" ","type":"text"},{"text":"hold and whose value the query reads, or an ","type":"text"},{"identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/AnyOf","type":"reference","isActive":true},{"text":" group, which an entity matches by holding","type":"text"},{"text":" ","type":"text"},{"text":"at least one of its types. The filter adds conditions that read nothing: types an entity must","type":"text"},{"text":" ","type":"text"},{"text":"or must not hold, components added or changed since a tick, and relations. An entity matches","type":"text"},{"text":" ","type":"text"},{"text":"the query when it matches every term and passes the filter.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"A query doesn’t belong to any world. Build it once, store it, compare it with another, and run","type":"text"},{"text":" ","type":"text"},{"text":"it against any world. The following example finds the entities that move and aren’t frozen:","type":"text"}]},{"type":"codeListing","syntax":"swift","code":["var world = World()","world.spawn(Name(value: \"comet\"), Position(x: 0, y: 0), Velocity(dx: 1, dy: 0))","world.spawn(Name(value: \"statue\"), Position(x: 4, y: 2), Velocity(dx: 1, dy: 0), Frozen())","world.spawn(Name(value: \"moon\"), Position(x: 9, y: 9))","","let movers = Query(Name.self, Position.self, Velocity.self).without(Frozen.self)","","var names: [String] = []","for (_, name, _, _) in world.query(movers) {","    names.append(name.value)","}","print(names)","\/\/ Prints \"[\"comet\"]\""]},{"type":"paragraph","inlineContent":[{"text":"Each row starts with the entity, labeled ","type":"text"},{"type":"codeVoice","code":"entity"},{"text":", followed by one value per term in the order","type":"text"},{"text":" ","type":"text"},{"text":"the query lists them. The statue holds every term but is frozen, and the moon has no velocity.","type":"text"}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"To change components while you visit them, pass a query to "},{"type":"codeVoice","code":"update(_:over:body:)"},{"type":"text","text":". The"},{"type":"text","text":" "},{"type":"text","text":"following example moves every entity that has a velocity and isn’t frozen:"}]},{"type":"codeListing","syntax":"swift","code":["var world = World()","let comet = world.spawn(Position(x: 0, y: 0), Velocity(dx: 1, dy: 2))","let statue = world.spawn(Position(x: 4, y: 2), Velocity(dx: 1, dy: 0), Frozen())","","world.update(Position.self, over: Query(Velocity.self).without(Frozen.self)) { position, row in","    position.x += row.components.dx","    position.y += row.components.dy","}","print(world[Position.self, of: comet])","\/\/ Prints \"Position(x: 1.0, y: 2.0)\"","print(world[Position.self, of: statue])","\/\/ Prints \"Position(x: 4.0, y: 2.0)\""]},{"type":"paragraph","inlineContent":[{"type":"text","text":"As a parameter of a system, a query arrives bound to the world the system runs on, and you"},{"type":"text","text":" "},{"type":"text","text":"iterate it directly. A system spells its filter as types; see "},{"type":"reference","identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/Query\/Where","isActive":true},{"type":"text","text":"."}]},{"type":"paragraph","inlineContent":[{"text":"Queries of one to three terms, each a component or an ","type":"text"},{"identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/AnyOf","isActive":true,"type":"reference"},{"text":" group of two to four types, run","type":"text"},{"text":" ","type":"text"},{"text":"through code specialized for their exact shape. Other shapes take a general path that does more","type":"text"},{"text":" ","type":"text"},{"text":"work per entity.","type":"text"}]}],"kind":"content"}],"metadata":{"title":"Query","navigatorTitle":[{"kind":"identifier","text":"Query"}],"role":"symbol","remoteSource":{"url":"https:\/\/github.com\/Tyler-Keith-Thompson\/ECS\/blob\/main\/Sources\/WorldModule\/Query.swift#L56","fileName":"Query.swift"},"fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"Query"}],"externalID":"s:11WorldModule5QueryV","modules":[{"name":"WorldModule"}],"symbolKind":"struct","roleHeading":"Structure"},"hierarchy":{"paths":[["doc:\/\/WorldModule\/documentation\/WorldModule"]]},"references":{"doc://WorldModule/SH":{"title":"Swift.Hashable","identifier":"doc:\/\/WorldModule\/SH","type":"unresolvable"},"doc://WorldModule/SQ":{"type":"unresolvable","title":"Swift.Equatable","identifier":"doc:\/\/WorldModule\/SQ"},"doc://WorldModule/documentation/WorldModule/QueryingAWorld":{"identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/QueryingAWorld","abstract":[{"type":"text","text":"Find the entities that hold the components you need, read those components, and change them in place."}],"url":"\/documentation\/worldmodule\/queryingaworld","title":"Querying a World","type":"topic","kind":"article","role":"article"},"doc://WorldModule/documentation/WorldModule/EntityQueryView":{"fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"EntityQueryView","kind":"identifier"}],"navigatorTitle":[{"text":"EntityQueryView","kind":"identifier"}],"abstract":[{"type":"text","text":"A lazy sequence of the entities that pass a filter, without reading any of their components."}],"identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/EntityQueryView","url":"\/documentation\/worldmodule\/entityqueryview","title":"EntityQueryView","type":"topic","kind":"symbol","role":"symbol"},"doc://WorldModule/s8SendableP":{"title":"Swift.Sendable","identifier":"doc:\/\/WorldModule\/s8SendableP","type":"unresolvable"},"doc://WorldModule/documentation/WorldModule/Query/hash(into:)":{"r