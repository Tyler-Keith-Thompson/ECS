tions","generated":true}],"hierarchy":{"paths":[["doc:\/\/WorldModule\/documentation\/WorldModule"]]},"relationshipsSections":[{"type":"conformsTo","kind":"relationships","title":"Conforms To","identifiers":["doc:\/\/WorldModule\/s15BitwiseCopyableP","doc:\/\/WorldModule\/SL","doc:\/\/WorldModule\/s8CopyableP","doc:\/\/WorldModule\/s23CustomStringConvertibleP","doc:\/\/WorldModule\/Se","doc:\/\/WorldModule\/SE","doc:\/\/WorldModule\/SQ","doc:\/\/WorldModule\/s9EscapableP","doc:\/\/WorldModule\/SH","doc:\/\/WorldModule\/s8SendableP","doc:\/\/WorldModule\/s16SendableMetatypeP"]}],"primaryContentSections":[{"declarations":[{"tokens":[{"kind":"attribute","text":"@frozen"},{"kind":"text","text":" "},{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"Entity"}],"languages":["swift"],"platforms":["Linux"]}],"kind":"declarations"},{"kind":"content","content":[{"type":"heading","level":2,"text":"Overview","anchor":"overview"},{"type":"paragraph","inlineContent":[{"type":"text","text":"An entity is one thing in your game or simulation. It has no data of its own: a "},{"type":"reference","identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/World","isActive":true},{"type":"text","text":" "},{"type":"text","text":"stores the components it holds, and the handle is how you refer to it. You get a handle by"},{"type":"text","text":" "},{"type":"text","text":"spawning an entity, and you pass it back to the world to read and change its components:"}]},{"type":"codeListing","syntax":"swift","code":["var world = World()","let hero = world.spawn(Name(value: \"Ada\"), Health(current: 100))","","print(world[Name.self, of: hero].value)","\/\/ Prints \"Ada\""]},{"type":"paragraph","inlineContent":[{"text":"A handle is a small value, cheap to copy and store, for example in a component that refers to","type":"text"},{"text":" ","type":"text"},{"text":"another entity. It holds two numbers: the ","type":"text"},{"type":"reference","identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/Entity\/index","isActive":true},{"text":" of the slot the entity occupies in the","type":"text"},{"text":" ","type":"text"},{"text":"world, and the ","type":"text"},{"type":"reference","identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/Entity\/generation","isActive":true},{"text":" of that slot. When an entity is despawned, the world can reuse","type":"text"},{"text":" ","type":"text"},{"text":"its slot for a new entity with the next generation, so a handle kept past its entity’s despawn","type":"text"},{"text":" ","type":"text"},{"text":"is ","type":"text"},{"type":"emphasis","inlineContent":[{"text":"stale","type":"text"}]},{"text":": it never names the entity that took the slot.","type":"text"}]},{"type":"codeListing","syntax":"swift","code":["var world = World()","let first = world.spawn(Position(x: 0, y: 0))","world.despawn(first)","let second = world.spawn(Position(x: 1, y: 1))","","print(first, second)","\/\/ Prints \"0:0 0:1\"","print(world.contains(first))","\/\/ Prints \"false\""]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Entities are ordered by slot, then by generation."}]}]}],"variants":[{"paths":["\/documentation\/worldmodule\/entity"],"traits":[{"interfaceLanguage":"swift"}]}],"sections":[],"references":{"doc://WorldModule/documentation/WorldModule/World":{"identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/World","title":"World","type":"topic","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"World","kind":"identifier"}],"abstract":[{"text":"A collection of entities, the components they hold, and resources.","type":"text"}],"role":"symbol","kind":"symbol","navigatorTitle":[{"text":"World","kind":"identifier"}],"url":"\/documentation\/worldmodule\/world"},"doc://WorldModule/documentation/WorldModule/Entity/_(_:_:)":{"role":"symbol","fragments":[{"kind":"keyword","text":"static"},{"kind":"text","text":" "},{"kind":"keyword","text":"