{"abstract":[{"type":"text","text":"A handle that identifies one entity in a world."}],"relationshipsSections":[{"title":"Conforms To","kind":"relationships","identifiers":["doc:\/\/WorldModule\/s15BitwiseCopyableP","doc:\/\/WorldModule\/SL","doc:\/\/WorldModule\/s8CopyableP","doc:\/\/WorldModule\/s23CustomStringConvertibleP","doc:\/\/WorldModule\/Se","doc:\/\/WorldModule\/SE","doc:\/\/WorldModule\/SQ","doc:\/\/WorldModule\/s9EscapableP","doc:\/\/WorldModule\/SH","doc:\/\/WorldModule\/s8SendableP","doc:\/\/WorldModule\/s16SendableMetatypeP"],"type":"conformsTo"}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/worldmodule\/entity"]}],"kind":"symbol","identifier":{"url":"doc:\/\/WorldModule\/documentation\/WorldModule\/Entity","interfaceLanguage":"swift"},"schemaVersion":{"major":0,"patch":0,"minor":3},"topicSections":[{"title":"Operators","generated":true,"identifiers":["doc:\/\/WorldModule\/documentation\/WorldModule\/Entity\/_(_:_:)"],"anchor":"Operators"},{"title":"Initializers","generated":true,"identifiers":["doc:\/\/WorldModule\/documentation\/WorldModule\/Entity\/init(from:)","doc:\/\/WorldModule\/documentation\/WorldModule\/Entity\/init(index:generation:)"],"anchor":"Initializers"},{"title":"Instance Properties","generated":true,"identifiers":["doc:\/\/WorldModule\/documentation\/WorldModule\/Entity\/generation","doc:\/\/WorldModule\/documentation\/WorldModule\/Entity\/index"],"anchor":"Instance-Properties"},{"title":"Default Implementations","generated":true,"identifiers":["doc:\/\/WorldModule\/documentation\/WorldModule\/Entity\/Comparable-Implementations","doc:\/\/WorldModule\/documentation\/WorldModule\/Entity\/CustomStringConvertible-Implementations","doc:\/\/WorldModule\/documentation\/WorldModule\/Entity\/Equatable-Implementations"],"anchor":"Default-Implementations"}],"metadata":{"symbolKind":"struct","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"Entity"}],"role":"symbol","roleHeading":"Structure","remoteSource":{"fileName":"Entity.swift","url":"https:\/\/github.com\/Tyler-Keith-Thompson\/ECS\/blob\/main\/Sources\/WorldModule\/Entity.swift#L35"},"navigatorTitle":[{"text":"Entity","kind":"identifier"}],"modules":[{"name":"WorldModule"}],"externalID":"s:11WorldModule6EntityV","title":"Entity"},"primaryContentSections":[{"declarations":[{"tokens":[{"text":"@frozen","kind":"attribute"},{"text":" ","kind":"text"},{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Entity","kind":"identifier"}],"platforms":["Linux"],"languages":["swift"]}],"kind":"declarations"},{"kind":"content","content":[{"type":"heading","level":2,"text":"Overview","anchor":"overview"},{"type":"paragraph","inlineContent":[{"text":"An entity is one thing in your game or simulation. It has no data of its own: a ","type":"text"},{"identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/World","isActive":true,"type":"reference"},{"text":" ","type":"text"},{"text":"stores the components it holds, and the handle is how you refer to it. You get a handle by","type":"text"},{"text":" ","type":"text"},{"text":"spawning an entity, and you pass it back to the world to read and change its components:","type":"text"}]},{"type":"codeListing","syntax":"swift","code":["var world = World()","let hero = world.spawn(Name(value: \"Ada\"), Health(current: 100))","","print(world[Name.self, of: hero].value)","\/\/ Prints \"Ada\""]},{"type":"paragraph","inlineContent":[{"type":"text","text":"A handle is a small value, cheap to copy and store, for example in a component that refers to"},{"type":"text","text":" "},{"type":"text","text":"another entity. It holds two numbers: the "},{"type":"reference","identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/Entity\/index","isActive":true},{"type":"text","text":" of the slot the entity occupies in the"},{"type":"text","text":" "},{"type":"text","text":"world, and the "},{"type":"reference","identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/Entity\/generation","isActive":true},{"type":"text","text":" of that slot. When an entity is despawned, the world can reuse"},{"type":"text","text":" "},{"type":"text","text":"its slot for a new entity with the next generation, so a handle kept past its entity’s despawn"},{"type":"text","text":" "},{"type":"text","text":"is "},{"type":"emphasis","inlineContent":[{"type":"text","text":"stale"}]},{"type":"text","text":": it never names the entity that took the slot."}]},{"type":"codeListing","syntax":"swift","code":["var world = World()","let first = world.spawn(Position(x: 0, y: 0))","world.despawn(first)","let second = world.spawn(Position(x: 1, y: 1))","","print(first, second)","\/\/ Prints \"0:0 0:1\"","print(world.contains(first))","\/\/ Prints \"false\""]},{"type":"paragraph","inlineContent":[{"text":"Entities are ordered by slot, then by generation.","type":"text"}]}]}],"sections":[],"hierarchy":{"paths":[["doc:\/\/WorldModule\/documentation\/WorldModule"]]},"seeAlsoSections":[{"title":"Essentials","generated":true,"identifiers":["doc:\/\/WorldModule\/documentation\/WorldModule\/World","doc:\/\/WorldModule\/documentation\/WorldModule\/Component","doc:\/\/WorldModule\/documentation\/WorldModule\/Resource"],"anchor":"Essentials"}],"references":{"doc://WorldModule/documentation/WorldModule/Entity":{"url":"\/documentation\/worldmodule\/entity","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"Entity"}],"type":"topic","kind":"symbol","identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/Entity","role":"symbol","abstract":[{"text":"A handle that identifies one entity in a world.","type":"text"}],"navigatorTitle":[{"kind":"identifier","text":"Entity"}],"title":"Entity"},"doc://WorldModule/SH":{"identifier":"doc:\/\/WorldModule\/SH","type":"unresolvable","title":"Swift.Hashable"},"doc://WorldModule/documentation/WorldModule/Entity/CustomStringConvertible-Imple