{"kind":"symbol","relationshipsSections":[{"title":"Conforms To","type":"conformsTo","identifiers":["doc:\/\/WorldModule\/s15BitwiseCopyableP","doc:\/\/WorldModule\/SL","doc:\/\/WorldModule\/s8CopyableP","doc:\/\/WorldModule\/s23CustomStringConvertibleP","doc:\/\/WorldModule\/Se","doc:\/\/WorldModule\/SE","doc:\/\/WorldModule\/SQ","doc:\/\/WorldModule\/s9EscapableP","doc:\/\/WorldModule\/SH","doc:\/\/WorldModule\/s8SendableP","doc:\/\/WorldModule\/s16SendableMetatypeP"],"kind":"relationships"}],"variants":[{"paths":["\/documentation\/worldmodule\/entity"],"traits":[{"interfaceLanguage":"swift"}]}],"abstract":[{"type":"text","text":"A handle that identifies one entity in a world."}],"sections":[],"primaryContentSections":[{"declarations":[{"platforms":["Linux"],"languages":["swift"],"tokens":[{"text":"@frozen","kind":"attribute"},{"text":" ","kind":"text"},{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Entity","kind":"identifier"}]}],"kind":"declarations"},{"kind":"content","content":[{"type":"heading","text":"Overview","level":2,"anchor":"overview"},{"type":"paragraph","inlineContent":[{"text":"An entity is one thing in your game or simulation. It has no data of its own: a ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/World"},{"text":" ","type":"text"},{"text":"stores the components it holds, and the handle is how you refer to it. You get a handle by","type":"text"},{"text":" ","type":"text"},{"text":"spawning an entity, and you pass it back to the world to read and change its components:","type":"text"}]},{"type":"codeListing","code":["var world = World()","let hero = world.spawn(Name(value: \"Ada\"), Health(current: 100))","","print(world[Name.self, of: hero].value)","\/\/ Prints \"Ada\""],"syntax":"swift"},{"type":"paragraph","inlineContent":[{"text":"A handle is a small value, cheap to copy and store, for example in a component that refers to","type":"text"},{"text":" ","type":"text"},{"text":"another entity. It holds two numbers: the ","type":"text"},{"identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/Entity\/index","isActive":true,"type":"reference"},{"text":" of the slot the entity occupies in the","type":"text"},{"text":" ","type":"text"},{"text":"world, and the ","type":"text"},{"identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/Entity\/generation","isActive":true,"type":"reference"},{"text":" of that slot. When an entity is despawned, the world can reuse","type":"text"},{"text":" ","type":"text"},{"text":"its slot for a new entity with the next generation, so a handle kept past its entity’s despawn","type":"text"},{"text":" ","type":"text"},{"text":"is ","type":"text"},{"inlineContent":[{"type":"text","text":"stale"}],"type":"emphasis"},{"text":": it never names the entity that took the slot.","type":"text"}]},{"type":"codeListing","code":["var world = World()","let first = world.spawn(Position(x: 0, y: 0))","world.despawn(first)","let second = world.spawn(Position(x: 1, y: 1))","","print(first, second)","\/\/ Prints \"0:0 0:1\"","print(world.contains(first))","\/\/ Prints \"false\""],"syntax":"swift"},{"type":"paragraph","inlineContent":[{"text":"Entities are ordered by slot, then by generation.","type":"text"}]}]}],"metadata":{"roleHeading":"Structure","modules":[{"name":"WorldModule"}],"symbolKind":"struct","title":"Entity","navigatorTitle":[{"kind":"identifier","text":"Entity"}],"remoteSource":{"fileName":"Entity.swift","url":"https:\/\/github.com\/Tyler-Keith-Thompson\/ECS\/blob\/main\/Sources\/WorldModule\/Entity.swift#L35"},"externalID":"s:11WorldModule6EntityV","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Entity","kind":"identifier"}],"role":"symbol"},"topicSections":[{"title":"Operators","generated":true,"anchor":"Operators","identifiers":["doc:\/\/WorldModule\/documentation\/WorldModule\/Entity\/_(_:_:)"]},{"title":"Initializers","generated":true,"ancho