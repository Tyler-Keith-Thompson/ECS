{"sections":[],"metadata":{"modules":[{"name":"WorldModule"}],"remoteSource":{"fileName":"Entity.swift","url":"https:\/\/github.com\/Tyler-Keith-Thompson\/ECS\/blob\/main\/Sources\/WorldModule\/Entity.swift#L35"},"symbolKind":"struct","title":"Entity","role":"symbol","navigatorTitle":[{"kind":"identifier","text":"Entity"}],"roleHeading":"Structure","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Entity","kind":"identifier"}],"externalID":"s:11WorldModule6EntityV"},"seeAlsoSections":[{"generated":true,"identifiers":["doc:\/\/WorldModule\/documentation\/WorldModule\/World","doc:\/\/WorldModule\/documentation\/WorldModule\/Component","doc:\/\/WorldModule\/documentation\/WorldModule\/Resource"],"anchor":"Essentials","title":"Essentials"}],"hierarchy":{"paths":[["doc:\/\/WorldModule\/documentation\/WorldModule"]]},"abstract":[{"text":"A handle that identifies one entity in a world.","type":"text"}],"variants":[{"paths":["\/documentation\/worldmodule\/entity"],"traits":[{"interfaceLanguage":"swift"}]}],"kind":"symbol","topicSections":[{"generated":true,"identifiers":["doc:\/\/WorldModule\/documentation\/WorldModule\/Entity\/_(_:_:)"],"anchor":"Operators","title":"Operators"},{"generated":true,"identifiers":["doc:\/\/WorldModule\/documentation\/WorldModule\/Entity\/init(from:)","doc:\/\/WorldModule\/documentation\/WorldModule\/Entity\/init(index:generation:)"],"anchor":"Initializers","title":"Initializers"},{"generated":true,"identifiers":["doc:\/\/WorldModule\/documentation\/WorldModule\/Entity\/generation","doc:\/\/WorldModule\/documentation\/WorldModule\/Entity\/index"],"anchor":"Instance-Properties","title":"Instance Properties"},{"generated":true,"identifiers":["doc:\/\/WorldModule\/documentation\/WorldModule\/Entity\/Comparable-Implementations","doc:\/\/WorldModule\/documentation\/WorldModule\/Entity\/CustomStringConvertible-Implementations","doc:\/\/WorldModule\/documentation\/WorldModule\/Entity\/Equatable-Implementations"],"anchor":"Default-Implementations","title":"Default Implementations"}],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/WorldModule\/documentation\/WorldModule\/Entity"},"relationshipsSections":[{"identifiers":["doc:\/\/WorldModule\/s15BitwiseCopyableP","doc:\/\/WorldModule\/SL","doc:\/\/WorldModule\/s8CopyableP","doc:\/\/WorldModule\/s23CustomStringConvertibleP","doc:\/\/WorldModule\/Se","doc:\/\/WorldModule\/SE","doc:\/\/WorldModule\/SQ","doc:\/\/WorldModule\/s9EscapableP","doc:\/\/WorldModule\/SH","doc:\/\/WorldModule\/s8SendableP","doc:\/\/WorldModule\/s16SendableMetatypeP"],"kind":"relationships","title":"Conforms To","type":"conformsTo"}],"schemaVersion":{"minor":3,"patch":0,"major":0},"primaryContentSections":[{"declarations":[{"platforms":["Linux"],"languages":["swift"],"tokens":[{"kind":"attribute","text":"@frozen"},{"kind":"text","text":" "},{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"Entity"}]}],"kind":"declarations"},{"content":[{"type":"heading","text":"Overview","anchor":"overview","level":2},{"type":"paragraph","inlineContent":[{"type":"text","text":"An entity is one thing in your game or simulation. It has no data of its own: a "},{"identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/World","isActive":true,"type":"reference"},{"type":"text","text":" "},{"type":"text","text":"stores the components it holds, and the handle is how you refer to it. You get a handle by"},{"type":"text","text":" "},{"type":"text","text":"spawning an entity, and you pass it back to the world to read and change its components:"}]},{"type":"codeListing","code":["var world = World()","let hero = world.spawn(Name(value: \"Ada\"), Health(current: 100))","","print(world[Name.self, of: hero].value)","\/\/ Prints \"Ada\""],"syntax":"swift"},{"type":"paragraph","inlineContent":[{"type":"text","text":"A handle is a small value, cheap to copy and store, for example in a component that refers to"},{"type":"text","text":" "},{"type":"text","text":"another entity. It holds two numbers: the "},{"identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/Entity\/index","type":"reference","isActive":true},{"type":"text","text":" of the slot the entity occupies in the"},{"type":"text","text":" "},{"type":"text","text":"world, and the "},{"identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/Entity\/generation","type":"reference","isActive":true},{"type":"text","text":" of that slot. When an entity is despawned, the world can reuse"},{"type":"text","text":" "},{"type":"text","text":"its slot for a new entity with the next generation, so a handle kept past its entity’s despawn"},{"type":"text","text":" "},{"type":"text","text":"is "},{"type":"emphasis","inlineContent":[{"type":"text","text":"stale"}]},{"type":"text","text":": it never names the entity that took the slot."}]},{"type":"codeListing","code":["var world = World()","let first = world.spawn(Position(x: 0, y: 0))","world.despawn(first)","let second = world.spawn(Position(x: 1, y: 1))","","print(first, second)","\/\/ Prints \"0:0 0:1\"","print(world.contains(first))","\/\/ Prints \"false\""],"syntax":"swift"},{"type":"paragraph","inlineContent":[{"text":"Entities are ordered by slot, then by generation.","type":"text"}]}],"kind":"content"}],"references":{"doc://WorldModule/s16SendableMetatypeP":{"title":"Swift.SendableMetatype","type":"unresolvable","identifier":"doc:\/\/WorldModule\/s16SendableMetatypeP"},"doc://WorldModule/SH":{"type":"unresolvable","identifier":"doc:\/\/WorldModule\/SH","title":"Swift.Hashable"},"doc://WorldModule/s8CopyableP":{"title":"Swift.Copyable","type":"unresolvable","identifier":"doc:\/\/WorldModule\/s8CopyableP"},"doc://WorldModule/documentation/WorldModule/Entity/_(_:_:)":{"type":"topic","kind":"symbol","title":"<(_:_:)","identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/Entity\/_(_:_:)","abstract":[{"type":"text","text":"Returns a Boolean value indicating whether the first entity ord