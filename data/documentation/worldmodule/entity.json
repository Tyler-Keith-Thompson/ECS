{"topicSections":[{"title":"Operators","generated":true,"identifiers":["doc:\/\/WorldModule\/documentation\/WorldModule\/Entity\/_(_:_:)"],"anchor":"Operators"},{"title":"Initializers","generated":true,"identifiers":["doc:\/\/WorldModule\/documentation\/WorldModule\/Entity\/init(from:)","doc:\/\/WorldModule\/documentation\/WorldModule\/Entity\/init(index:generation:)"],"anchor":"Initializers"},{"title":"Instance Properties","generated":true,"identifiers":["doc:\/\/WorldModule\/documentation\/WorldModule\/Entity\/generation","doc:\/\/WorldModule\/documentation\/WorldModule\/Entity\/index"],"anchor":"Instance-Properties"},{"title":"Default Implementations","generated":true,"identifiers":["doc:\/\/WorldModule\/documentation\/WorldModule\/Entity\/Comparable-Implementations","doc:\/\/WorldModule\/documentation\/WorldModule\/Entity\/CustomStringConvertible-Implementations","doc:\/\/WorldModule\/documentation\/WorldModule\/Entity\/Equatable-Implementations"],"anchor":"Default-Implementations"}],"sections":[],"seeAlsoSections":[{"generated":true,"title":"Essentials","identifiers":["doc:\/\/WorldModule\/documentation\/WorldModule\/World","doc:\/\/WorldModule\/documentation\/WorldModule\/Component","doc:\/\/WorldModule\/documentation\/WorldModule\/Resource"],"anchor":"Essentials"}],"variants":[{"paths":["\/documentation\/worldmodule\/entity"],"traits":[{"interfaceLanguage":"swift"}]}],"primaryContentSections":[{"declarations":[{"platforms":["Linux"],"tokens":[{"kind":"attribute","text":"@frozen"},{"kind":"text","text":" "},{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"Entity"}],"languages":["swift"]}],"kind":"declarations"},{"content":[{"anchor":"overview","level":2,"text":"Overview","type":"heading"},{"inlineContent":[{"type":"text","text":"An entity is one thing in your game or simulation. It has no data of its own: a "},{"type":"reference","identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/World","isActive":true},{"type":"text","text":" "},{"type":"text","text":"stores the components it holds, and the handle is how you refer to it. You get a handle by"},{"type":"text","text":" "},{"type":"text","text":"spawning an entity, and you pass it back to the world to read and change its components:"}],"type":"paragraph"},{"code":["var world = World()","let hero = world.spawn(Name(value: \"Ada\"), Health(current: 100))","","print(world[Name.self, of: hero].value)","\/\/ Prints \"Ada\""],"syntax":"swift","type":"codeListing"},{"inlineContent":[{"type":"text","text":"A handle is a small value, cheap to copy and store, for example in a component that refers to"},{"type":"text","text":" "},{"type":"text","text":"another entity. It holds two numbers: the "},{"type":"reference","isActive":true,"identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/Entity\/index"},{"type":"text","text":" of the slot the entity occupies in the"},{"type":"text","text":" "},{"type":"text","text":"world, and the "},{"type":"reference","isActive":true,"identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/Entity\/generation"},{"type":"text","text":" of that slot. When an entity is despawned, the world can reuse"},{"type":"text","text":" "},{"type":"text","text":"its slot for a new entity with the next generation, so a handle kept past its entity’s despawn"},{"type":"text","text":" "},{"type":"text","text":"is "},{"type":"emphasis","inlineContent":[{"type":"text","text":"stale"}]},{"type":"text","text":": it never names the entity that took the slot."}],"type":"paragraph"},{"code":["var world = World()","let first = world.spawn(Position(x: 0, y: 0))","world.despawn(first)","let second = world.spawn(Position(x: 1, y: 1))","","print(first, second)","\/\/ Prints \"0:0 0:1\"","print(world.contains(first))","\/\/ Prints \"false\""],"syntax":"swift","type":"codeListing"},{"inlineContent":[{"text":"Entities are ordered by slot, then by generation.","type":"text"}],"type":"paragraph"}],"kind":"content"}],"sch