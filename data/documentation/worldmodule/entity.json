"type":"text"},{"text":"another entity. It holds two numbers: the ","type":"text"},{"type":"reference","isActive":true,"identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/Entity\/index"},{"text":" of the slot the entity occupies in the","type":"text"},{"text":" ","type":"text"},{"text":"world, and the ","type":"text"},{"type":"reference","isActive":true,"identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/Entity\/generation"},{"text":" of that slot. When an entity is despawned, the world can reuse","type":"text"},{"text":" ","type":"text"},{"text":"its slot for a new entity with the next generation, so a handle kept past its entity’s despawn","type":"text"},{"text":" ","type":"text"},{"text":"is ","type":"text"},{"inlineContent":[{"text":"stale","type":"text"}],"type":"emphasis"},{"text":": it never names the entity that took the slot.","type":"text"}]},{"type":"codeListing","code":["var world = World()","let first = world.spawn(Position(x: 0, y: 0))","world.despawn(first)","let second = world.spawn(Position(x: 1, y: 1))","","print(first, second)","\/\/ Prints \"0:0 0:1\"","print(world.contains(first))","\/\/ Prints \"false\""],"syntax":"swift"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Entities are ordered by slot, then by generation."}]}]}],"references":{"doc://WorldModule/documentation/WorldModule/Entity/Comparable-Implementations":{"title":"Comparable Implementations","url":"\/documentation\/worldmodule\/entity\/comparable-implementations","role":"collectionGroup","abstract":[],"identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/Entity\/Comparable-Implementations","type":"topic","kind":"article"},"doc://WorldModule/documentation/WorldModule/Entity/init(index:generation:)":{"type":"topic","title":"init(index:generation:)","kind":"symbol","role":"symbol","fragments":[{"text":"init","kind":"identifier"},{"text":"(","kind":"text"},{"text":"index","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"UInt32","k