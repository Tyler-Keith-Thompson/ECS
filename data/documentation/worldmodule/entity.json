{"abstract":[{"text":"A handle that identifies one entity in a world.","type":"text"}],"sections":[],"seeAlsoSections":[{"anchor":"Essentials","identifiers":["doc:\/\/WorldModule\/documentation\/WorldModule\/World","doc:\/\/WorldModule\/documentation\/WorldModule\/Component","doc:\/\/WorldModule\/documentation\/WorldModule\/Resource"],"title":"Essentials","generated":true}],"identifier":{"url":"doc:\/\/WorldModule\/documentation\/WorldModule\/Entity","interfaceLanguage":"swift"},"hierarchy":{"paths":[["doc:\/\/WorldModule\/documentation\/WorldModule"]]},"schemaVersion":{"major":0,"minor":3,"patch":0},"kind":"symbol","metadata":{"modules":[{"name":"WorldModule"}],"roleHeading":"Structure","role":"symbol","externalID":"s:11WorldModule6EntityV","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"Entity"}],"symbolKind":"struct","navigatorTitle":[{"kind":"identifier","text":"Entity"}],"title":"Entity","remoteSource":{"fileName":"Entity.swift","url":"https:\/\/github.com\/Tyler-Keith-Thompson\/ECS\/blob\/main\/Sources\/WorldModule\/Entity.swift#L35"}},"primaryContentSections":[{"declarations":[{"languages":["swift"],"platforms":["Linux"],"tokens":[{"kind":"attribute","text":"@frozen"},{"kind":"text","text":" "},{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"Entity"}]}],"kind":"declarations"},{"content":[{"text":"Overview","level":2,"anchor":"overview","type":"heading"},{"inlineContent":[{"type":"text","text":"An entity is one thing in your game or simulation. It has no data of its own: a "},{"type":"reference","identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/World","isActive":true},{"type":"text","text":" "},{"type":"text","text":"stores the components it holds, and the handle is how you refer to it. You get a handle by"},{"type":"text","text":" "},{"type":"text","text":"spawning an entity, and you pass it back to the world to read and change its components:"}],"type":"paragraph"},{"code":["var world = World()","let hero = world.spawn(Name(value: \"Ada\"), Health(current: 100))","","print(world[Name.self, of: hero].value)","\/\/ Prints \"Ada\""],"syntax":"swift","type":"codeListing"},{"inlineContent":[{"text":"A handle is a small value, cheap to copy and store, for example in a component that refers to","type":"text"},{"text":" ","type":"text"},{"text":"another entity. It holds two numbers: the ","type":"text"},{"identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/Entity\/index","type":"reference","isActive":true},{"text":" of the slot the entity occupies in the","type":"text"},{"text":" ","type":"text"},{"text":"world, and the ","type":"text"},{"identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/Entity\/generation","type":"reference","isActive":true},{"text":" of that slot. When an entity is despawned, the world can reuse","type":"text"},{"text":" ","type":"text"},{"text":"its slot for a new entity with the next generation, so a handle kept past its entity’s despawn","type":"text"},{"text":" ","type":"text"},{"text":"is ","type":"text"},{"type":"emphasis","inlineContent":[{"type":"text","text":"stale"}]},{"text":": it never names the entity that took the slot.","type":"text"}],"type":"paragraph"},{"code":["var world = World()","let first = world.spawn(Position(x: 0, y: 0))","world.despawn(first)","let second = world.spawn(Position(x: 1, y: 1))","","print(first, second)","\/\/ Prints \"0:0 0:1\"","print(world.contains(first))","\/\/ Prints \"false\""],"syntax":"swift","type":"codeListing"},{"inlineContent":[{"text":"Entities are ordered by slot, then by generation.","type":"text"}],"type":"paragraph"}],"kind":"content"}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/worldmodule\/entity"]}],"topicSections":[{"anchor":"Operators","identifiers":["doc:\/\/WorldModule\/documentation\/WorldModule\/Entity\/_(_:_:)"],"title":"Operators","generated":true},{"anchor":"Initializers","identifiers":["doc:\/\/WorldModule\/documentation\/WorldModule\/Entity\/init(from:)","doc:\/\/WorldModule\/documentation\/WorldModule\/Entity\/init(index:generation:)"],"title":"Initializers","generated":true},{"anchor":"Instance-Properties","identifiers":["doc:\/\/WorldModule\/documentation\/WorldModule\/Entity\/generation","doc:\/\/WorldModule\/documentation\/WorldModule\/Entity\/index"],"title":"Instance Properties","generated":true},{"anchor":"Default-Implementations","identifiers":["doc:\/\/WorldModule\/documentation\/WorldModule\/Entity\/Comparable-Implementations","doc:\/\/WorldModule\/documentation\/WorldModule\/Entity\/CustomStringConvertible-Implementations","doc:\/\/WorldModule\/documentation\/WorldModule\/Entity\/Equatable-Implementations"],"title":"Default Implementations","generated":true}],"relationshipsSections":[{"type":"conformsTo","identifiers":["doc:\/\/WorldModule\/s15BitwiseCopyableP","doc:\/\/WorldModule\/SL","doc:\/\/WorldModule\/s8CopyableP","doc:\/\/WorldModule\/s23CustomStringConvertibleP","doc:\/\/WorldModule\/Se","doc:\/\/WorldModule\/SE","doc:\/\/WorldModule\/SQ","doc:\/\/WorldModule\/s9EscapableP","doc:\/\/WorldModule\/SH","doc:\/\/WorldModule\/s8SendableP","doc:\/\/WorldModule\/s16SendableMetatypeP"],"title":"Conforms To","kind":"relationships"}],"references":{"doc://WorldModule/s15BitwiseCopyableP":{"title":"Swift.BitwiseCopyable","type":"unresolvable","identifier":"doc:\/\/WorldModule\/s15BitwiseCopyableP"},"doc://WorldModule/documentation/WorldModule":{"role":"collection","type":"topic","abstract":[{"text":"Store the state of a game or simulation as entities and components, and read and change it with","type":"text"},{"text":" ","type":"text"},{"text":"queries, updates, and commands.","type":"text"}],"identifier":"doc:\/\/WorldModule\/documentation\/WorldModule","url":"\/documentation\/worldmodule","kind":"symbol","title":"WorldModule"},"doc://WorldModule/s8CopyableP":{"type":"unresolvable","identifier":"doc:\/\/WorldModule\/s8C