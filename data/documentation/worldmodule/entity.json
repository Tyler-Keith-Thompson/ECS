{"schemaVersion":{"minor":3,"major":0,"patch":0},"relationshipsSections":[{"title":"Conforms To","identifiers":["doc:\/\/WorldModule\/s15BitwiseCopyableP","doc:\/\/WorldModule\/SL","doc:\/\/WorldModule\/s8CopyableP","doc:\/\/WorldModule\/s23CustomStringConvertibleP","doc:\/\/WorldModule\/Se","doc:\/\/WorldModule\/SE","doc:\/\/WorldModule\/SQ","doc:\/\/WorldModule\/s9EscapableP","doc:\/\/WorldModule\/SH","doc:\/\/WorldModule\/s8SendableP","doc:\/\/WorldModule\/s16SendableMetatypeP"],"type":"conformsTo","kind":"relationships"}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/worldmodule\/entity"]}],"seeAlsoSections":[{"generated":true,"title":"Essentials","identifiers":["doc:\/\/WorldModule\/documentation\/WorldModule\/World","doc:\/\/WorldModule\/documentation\/WorldModule\/Component","doc:\/\/WorldModule\/documentation\/WorldModule\/Resource"],"anchor":"Essentials"}],"metadata":{"navigatorTitle":[{"kind":"identifier","text":"Entity"}],"roleHeading":"Structure","externalID":"s:11WorldModule6EntityV","role":"symbol","remoteSource":{"fileName":"Entity.swift","url":"https:\/\/github.com\/Tyler-Keith-Thompson\/ECS\/blob\/main\/Sources\/WorldModule\/Entity.swift#L35"},"symbolKind":"struct","title":"Entity","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Entity","kind":"identifier"}],"modules":[{"name":"WorldModule"}]},"primaryContentSections":[{"declarations":[{"tokens":[{"text":"@frozen","kind":"attribute"},{"text":" ","kind":"text"},{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Entity","kind":"identifier"}],"platforms":["Linux"],"languages":["swift"]}],"kind":"declarations"},{"kind":"content","content":[{"anchor":"overview","type":"heading","text":"Overview","level":2},{"type":"paragraph","inlineContent":[{"text":"An entity is one thing in your game or simulation. It has no data of its own: a ","type":"text"},{"identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/World","type":"reference","isActive":true},{"text":" ","type":"text"},{"text":"stores the components it holds, and the handle is how you refer to it. You get a handle by","type":"text"},{"text":" ","type":"text"},{"text":"spawning an entity, and you pass it back to the world to read and change its components:","type":"text"}]},{"syntax":"swift","type":"codeListing","code":["var world = World()","let hero = world.spawn(Name(value: \"Ada\"), Health(current: 100))","","print(world[Name.self, of: hero].value)","\/\/ Prints \"Ada\""]},{"type":"paragraph","inlineContent":[{"type":"text","text":"A handle is a small value, cheap to copy and store, for example in a component that refers to"},{"type":"text","text":" "},{"type":"text","text":"another entity. It holds two numbers: the "},{"isActive":true,"identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/Entity\/index","type":"reference"},{"type":"text","text":" of the slot the entity occupies in the"},{"type":"text","text":" "},{"type":"text","text":"world, and the "},{"isActive":true,"identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/Entity\/generation","type":"reference"},{"type":"text","text":" of that slot. When an entity is despawned, the world can reuse"},{"type":"text","text":" "},{"type":"text","text":"its slot for a new entity with the next generation, so a handle kept past its entity’s despawn"},{"type":"text","text":" "},{"type":"text","text":"is "},{"type":"emphasis","inlineContent":[{"text":"stale","type":"text"}]},{"type":"text","text":": it never names the entity that took the slot."}]},{"syntax":"swift","type":"codeListing","code":["var world = World()","let first = world.spawn(Position(x: 0, y: 0))","world.despawn(first)","let second = world.spawn(Position(x: 1, y: 1))","","print(first, second)","\/\/ Prints \"0:0 0:1\"","print(world.contains(first))","\/\/ Prints \"false\""]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Entities are ordered by slot, then by generation."}]}]}]