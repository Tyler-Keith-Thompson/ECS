orldModule\/SQ","doc:\/\/WorldModule\/s9EscapableP","doc:\/\/WorldModule\/SH","doc:\/\/WorldModule\/s8SendableP","doc:\/\/WorldModule\/s16SendableMetatypeP"],"kind":"relationships","title":"Conforms To"}],"seeAlsoSections":[{"anchor":"Essentials","identifiers":["doc:\/\/WorldModule\/documentation\/WorldModule\/World","doc:\/\/WorldModule\/documentation\/WorldModule\/Component","doc:\/\/WorldModule\/documentation\/WorldModule\/Resource"],"title":"Essentials","generated":true}],"primaryContentSections":[{"declarations":[{"tokens":[{"text":"@frozen","kind":"attribute"},{"text":" ","kind":"text"},{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Entity","kind":"identifier"}],"languages":["swift"],"platforms":["Linux"]}],"kind":"declarations"},{"content":[{"anchor":"overview","level":2,"text":"Overview","type":"heading"},{"inlineContent":[{"type":"text","text":"An entity is one thing in your game or simulation. It has no data of its own: a "},{"isActive":true,"identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/World","type":"reference"},{"type":"text","text":" "},{"type":"text","text":"stores the components it holds, and the handle is how you refer to it. You get a handle by"},{"type":"text","text":" "},{"type":"text","text":"spawning an entity, and you pass it back to the world to read and change its components:"}],"type":"paragraph"},{"code":["var world = World()","let hero = world.spawn(Name(value: \"Ada\"), Health(current: 100))","","print(world[Name.self, of: hero].value)","\/\/ Prints \"Ada\""],"syntax":"swift","type":"codeListing"},{"inlineContent":[{"text":"A handle is a small value, cheap to copy and store, for example in a component that refers to","type":"text"},{"text":" ","type":"text"},{"text":"another entity. It holds two numbers: the ","type":"text"},{"identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/Entity\/index","type":"reference","isActive":true},{"text":" of the slot the entity occupies in the","type":"text"},{"text":" ","type":"text"},{"text":"world, and the ","type":"text"},{"identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/Entity\/generation","type":"reference","isActive":true},{"text":" of that slot. When an entity is despawned, the world can reuse","type":"text"},{"text":" ","type":"text"},{"text":"its slot for a new entity with the next generation, so a handle kept past its entity’s despawn","type":"text"},{"text":" ","type":"text"},{"text":"is ","type":"text"},{"inlineContent":[{"text":"stale","type":"text"}],"type":"emphasis"},{"text":": it never names the entity that took the slot.","type":"text"}],"type":"paragraph"},{"code":["var world = World()","let first = world.spawn(Position(x: 0, y: 0))","world.despawn(first)","let second = world.spawn(Position(x: 1, y: 1))","","print(first, second)","\/\/ Prints \"0:0 0:1\"","print(world.contains(first))","\/\/ Prints \"false\""],"syntax":"swift","type":"codeListing"},{"inlineContent":[{"text":"Entities are ordered by slot, then by generation.","type":"text"}],"type":"paragraph"}],"kind":"content"}],"abstract":[{"type":"text","text":"A handle that identifies one entity in a world."}],"identifier":{"url":"doc:\/\/WorldModule\/documentation\/WorldModule\/Entity","interfaceLanguage":"swift"},"kind":"symbol","sections":[],"references":{"doc://WorldModule/documentation/WorldModule/Entity/_(_:_:)":{"type":"topic","url":"\/documentation\/worldmodule\/entity\/_(_:_:)","role":"symbol","kind":"symbol","title":"<(_:_:)","abstract":[{"type":"text","text":"Returns a Boolean value indicating whether the first entity orders before the second, by"},{"type":"text","text":" "},{"type":"text","text":"slot and then by generation."}],"fragments":[{"text":"static","kind":"keyword"},{"text":" ","kind":"text"},{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"<","kind":"identifier"},{"text":" ","kind":"text"},{"text":"(","kind":"text"},{"preciseIdentifier":"s:11WorldModule6EntityV","text":"Entity","kind":"ty