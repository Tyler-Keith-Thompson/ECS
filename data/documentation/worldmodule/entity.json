{"seeAlsoSections":[{"title":"Essentials","generated":true,"identifiers":["doc:\/\/WorldModule\/documentation\/WorldModule\/World","doc:\/\/WorldModule\/documentation\/WorldModule\/Component","doc:\/\/WorldModule\/documentation\/WorldModule\/Resource"],"anchor":"Essentials"}],"sections":[],"hierarchy":{"paths":[["doc:\/\/WorldModule\/documentation\/WorldModule"]]},"metadata":{"remoteSource":{"url":"https:\/\/github.com\/Tyler-Keith-Thompson\/ECS\/blob\/main\/Sources\/WorldModule\/Entity.swift#L35","fileName":"Entity.swift"},"modules":[{"name":"WorldModule"}],"title":"Entity","symbolKind":"struct","navigatorTitle":[{"text":"Entity","kind":"identifier"}],"role":"symbol","externalID":"s:11WorldModule6EntityV","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"Entity"}],"roleHeading":"Structure"},"identifier":{"url":"doc:\/\/WorldModule\/documentation\/WorldModule\/Entity","interfaceLanguage":"swift"},"relationshipsSections":[{"kind":"relationships","title":"Conforms To","type":"conformsTo","identifiers":["doc:\/\/WorldModule\/s15BitwiseCopyableP","doc:\/\/WorldModule\/SL","doc:\/\/WorldModule\/s8CopyableP","doc:\/\/WorldModule\/s23CustomStringConvertibleP","doc:\/\/WorldModule\/Se","doc:\/\/WorldModule\/SE","doc:\/\/WorldModule\/SQ","doc:\/\/WorldModule\/s9EscapableP","doc:\/\/WorldModule\/SH","doc:\/\/WorldModule\/s8SendableP","doc:\/\/WorldModule\/s16SendableMetatypeP"]}],"kind":"symbol","abstract":[{"text":"A handle that identifies one entity in a world.","type":"text"}],"primaryContentSections":[{"kind":"declarations","declarations":[{"languages":["swift"],"tokens":[{"text":"@frozen","kind":"attribute"},{"text":" ","kind":"text"},{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Entity","kind":"identifier"}],"platforms":["Linux"]}]},{"kind":"content","content":[{"level":2,"text":"Overview","anchor":"overview","type":"heading"},{"inlineContent":[{"type":"text","text":"An entity is one thing in your game or simulation. It has no data of its own: a "},{"isActive":true,"identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/World","type":"reference"},{"type":"text","text":" "},{"type":"text","text":"stores the components it holds, and the handle is how you refer to it. You get a handle by"},{"type":"text","text":" "},{"type":"text","text":"spawning an entity, and you pass it back to the world to read and change its components:"}],"type":"paragraph"},{"syntax":"swift","type":"codeListing","code":["var world = World()","let hero = world.spawn(Name(value: \"Ada\"), Health(current: 100))","","print(world[Name.self, of: hero].value)","\/\/ Prints \"Ada\""]},{"inlineContent":[{"type":"text","text":"A handle is a small value, cheap to copy and store, for example in a component that refers to"},{"type":"text","text":" "},{"type":"text","text":"another entity. It holds two numbers: the "},{"type":"reference","identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/Entity\/index","isActive":true},{"type":"text","text":" of the slot the entity occupies in the"},{"type":"text","text":" "},{"type":"text","text":"world, and the "},{"type":"reference","identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/Entity\/generation","isActive":true},{"type":"text","text":" of that slot. When an entity is despawned, the world can reuse"},{"type":"text","text":" "},{"type":"text","text":"its slot for a new entity with the next generation, so a handle kept past its entity’s despawn"},{"type":"text","text":" "},{"type":"text","text":"is "},{"type":"emphasis","inlineContent":[{"text":"stale","type":"text"}]},{"type":"text","text":": it never names the entity that took the slot."}],"type":"paragraph"},{"syntax":"swift","type":"codeListing","code":["var world = World()","let first = world.spawn(Position(x: 0, y: 0))","world.despawn(first)","let second = world.spawn(Position(x: 1, y: 1))","","print(first, second)","\/\/ Prints \"0:0 0:1\"","print(world.contains(first))","\/\/ Prints \"false\""]},{"inlineContent":[{"type":"text","text":"Entities are ordered by slot, then by generation."}],"type":"paragraph"}]}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/worldmodule\/entity"]}],"schemaVersion":{"minor":3,"patch":0,"major":0},"topicSections":[{"title":"Operators","generated":true,"identifiers":["doc:\/\/WorldModule\/documentation\/WorldModule\/Entity\/_(_:_:)"],"anchor":"Operators"},{"title":"Initializers","generated":true,"identifiers":["doc:\/\/WorldModule\/documentation\/WorldModule\/Entity\/init(from:)","doc:\/\/WorldModule\/documentation\/WorldModule\/Entity\/init(index:generation:)"],"anchor":"Initializers"},{"title":"Instance Properties","generated":true,"identifiers":["doc:\/\/WorldModule\/documentation\/WorldModule\/Entity\/generation","doc:\/\/WorldModule\/documentation\/WorldModule\/Entity\/index"],"anchor":"Instance-Properties"},{"title":"Default Implementations","generated":true,"identifiers":["doc:\/\/WorldModule\/documentation\/WorldModule\/Entity\/Comparable-Implementations","doc:\/\/WorldModule\/documentation\/WorldModule\/Entity\/CustomStringConvertible-Implementations","doc:\/\/WorldModule\/documentation\/WorldModule\/Entity\/Equatable-Implementations"],"anchor":"Default-Implementations"}],"references":{"doc://WorldModule/s15BitwiseCopyableP":{"identifier":"doc:\/\/WorldModule\/s15BitwiseCopyableP","title":"Swift.BitwiseCopyable","type":"unresolvable"},"doc://WorldModule/documentation/WorldModule/Entity/_(_:_:)":{"identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/Entity\/_(_:_:)","type":"topic","role":"symbol","kind":"symbol","fragments":[{"kind":"keyword","text":"static"},{"kind":"text","text":" "},{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"<"},{"kind":"text","text":" "},{"kind":"text","text":"("},{"preciseIdentifier":"s:11WorldModule6EntityV","kind":"typeIdentifier","text":"Entity"},{"kind":"text","text":", "},{"pre