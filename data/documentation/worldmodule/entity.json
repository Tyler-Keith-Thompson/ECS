{"topicSections":[{"title":"Operators","generated":true,"anchor":"Operators","identifiers":["doc:\/\/WorldModule\/documentation\/WorldModule\/Entity\/_(_:_:)"]},{"title":"Initializers","generated":true,"anchor":"Initializers","identifiers":["doc:\/\/WorldModule\/documentation\/WorldModule\/Entity\/init(from:)","doc:\/\/WorldModule\/documentation\/WorldModule\/Entity\/init(index:generation:)"]},{"title":"Instance Properties","generated":true,"anchor":"Instance-Properties","identifiers":["doc:\/\/WorldModule\/documentation\/WorldModule\/Entity\/generation","doc:\/\/WorldModule\/documentation\/WorldModule\/Entity\/index"]},{"title":"Default Implementations","generated":true,"anchor":"Default-Implementations","identifiers":["doc:\/\/WorldModule\/documentation\/WorldModule\/Entity\/Comparable-Implementations","doc:\/\/WorldModule\/documentation\/WorldModule\/Entity\/CustomStringConvertible-Implementations","doc:\/\/WorldModule\/documentation\/WorldModule\/Entity\/Equatable-Implementations"]}],"variants":[{"paths":["\/documentation\/worldmodule\/entity"],"traits":[{"interfaceLanguage":"swift"}]}],"metadata":{"modules":[{"name":"WorldModule"}],"title":"Entity","externalID":"s:11WorldModule6EntityV","symbolKind":"struct","role":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Entity","kind":"identifier"}],"navigatorTitle":[{"kind":"identifier","text":"Entity"}],"roleHeading":"Structure","remoteSource":{"url":"https:\/\/github.com\/Tyler-Keith-Thompson\/ECS\/blob\/main\/Sources\/WorldModule\/Entity.swift#L35","fileName":"Entity.swift"}},"kind":"symbol","hierarchy":{"paths":[["doc:\/\/WorldModule\/documentation\/WorldModule"]]},"sections":[],"abstract":[{"type":"text","text":"A handle that identifies one entity in a world."}],"relationshipsSections":[{"title":"Conforms To","identifiers":["doc:\/\/WorldModule\/s15BitwiseCopyableP","doc:\/\/WorldModule\/SL","doc:\/\/WorldModule\/s8CopyableP","doc:\/\/WorldModule\/s23CustomStringConvertibleP","doc:\/\/WorldModule\/Se","doc:\/\/WorldModule\/SE","doc:\/\/WorldModule\/SQ","doc:\/\/WorldModule\/s9EscapableP","doc:\/\/WorldModule\/SH","doc:\/\/WorldModule\/s8SendableP","doc:\/\/WorldModule\/s16SendableMetatypeP"],"type":"conformsTo","kind":"relationships"}],"seeAlsoSections":[{"title":"Essentials","generated":true,"anchor":"Essentials","identifiers":["doc:\/\/WorldModule\/documentation\/WorldModule\/World","doc:\/\/WorldModule\/documentation\/WorldModule\/Component","doc:\/\/WorldModule\/documentation\/WorldModule\/Resource"]}],"identifier":{"url":"doc:\/\/WorldModule\/documentation\/WorldModule\/Entity","interfaceLanguage":"swift"},"primaryContentSections":[{"declarations":[{"platforms":["Linux"],"tokens":[{"text":"@frozen","kind":"attribute"},{"text":" ","kind":"text"},{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Entity","kind":"identifier"}],"languages":["swift"]}],"kind":"declarations"},{"content":[{"anchor":"overview","level":2,"type":"heading","text":"Overview"},{"inlineContent":[{"text":"An entity is one thing in your game or simulation. It has no data of its own: a ","type":"text"},{"identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/World","type":"reference","isActive":true},{"text":" ","type":"text"},{"text":"stores the components it holds, and the handle is how you refer to it. You get a handle by","type":"text"},{"text":" ","type":"text"},{"text":"spawning an entity, and you pass it back to the world to read and change its components:","type":"text"}],"type":"paragraph"},{"syntax":"swift","code":["var world = World()","let hero = world.spawn(Name(value: \"Ada\"), Health(current: 100))","","print(world[Name.self, of: hero].value)","\/\/ Prints \"Ada\""],"type":"codeListing"},{"inlineContent":[{"text":"A handle is a small value, cheap to copy and store, for example in a component that refers to","type":"text"},{"text":" ","type":"text"},{"text":"another entity. It holds two numbers: the ","type":"text"},{"isActive":true,"identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/Entity\/index","type":"reference"},{"text":" of the slot the entity occupies in the","type":"text"},{"text":" ","type":"text"},{"text":"world, and the ","type":"text"},{"isActive":true,"identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/Entity\/generation","type":"reference"},{"text":" of that slot. When an entity is despawned, the world can reuse","type":"text"},{"text":" ","type":"text"},{"text":"its slot for a new entity with the next generation, so a handle kept past its entity’s despawn","type":"text"},{"text":" ","type":"text"},{"text":"is ","type":"text"},{"inlineContent":[{"type":"text","text":"stale"}],"type":"emphasis"},{"text":": it never names the entity that took the slot.","type":"text"}],"type":"paragraph"},{"syntax":"swift","code":["var world = World()","let first = world.spawn(Position(x: 0, y: 0))","world.despawn(first)","let second = world.spawn(Position(x: 1, y: 1))","","print(first, second)","\/\/ Prints \"0:0 0:1\"","print(world.contains(first))","\/\/ Prints \"false\""],"type":"codeListing"},{"inlineContent":[{"type":"text","text":"Entities are ordered by slot, then by generation."}],"type":"paragraph"}],"kind":"content"}],"schemaVersion":{"patch":0,"minor":3,"major":0},"references":{"doc://WorldModule/documentation/WorldModule/Component":{"type":"topic","kind":"symbol","abstract":[{"text":"A type that can be stored as a component of an entity.","type":"text"}],"fragments":[{"text":"protocol","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Component","kind":"identifier"}],"url":"\/documentation\/worldmodule\/component","title":"Component","navigatorTitle":[{"text":"Component","kind":"identifier"}],"identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/Component","role":"symbol"},"doc://WorldModule/documentation/WorldModule/Entity/Equatable-Implementations":{"kind":"article","type":"topic","title":"Equatable Implementations","identifier":"doc