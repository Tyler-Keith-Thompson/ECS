{"hierarchy":{"paths":[["doc:\/\/WorldModule\/documentation\/WorldModule"]]},"metadata":{"title":"ChildOf","navigatorTitle":[{"text":"ChildOf","kind":"identifier"}],"modules":[{"name":"WorldModule"}],"remoteSource":{"url":"https:\/\/github.com\/Tyler-Keith-Thompson\/ECS\/blob\/main\/Sources\/WorldModule\/Hierarchy.swift#L51","fileName":"Hierarchy.swift"},"role":"symbol","externalID":"s:11WorldModule7ChildOfV","roleHeading":"Structure","symbolKind":"struct","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"ChildOf"}]},"topicSections":[{"title":"Initializers","generated":true,"identifiers":["doc:\/\/WorldModule\/documentation\/WorldModule\/ChildOf\/init()","doc:\/\/WorldModule\/documentation\/WorldModule\/ChildOf\/init(from:)"],"anchor":"Initializers"},{"title":"Type Properties","generated":true,"identifiers":["doc:\/\/WorldModule\/documentation\/WorldModule\/ChildOf\/isExclusive","doc:\/\/WorldModule\/documentation\/WorldModule\/ChildOf\/onTargetDespawn"],"anchor":"Type-Properties"},{"title":"Default Implementations","generated":true,"identifiers":["doc:\/\/WorldModule\/documentation\/WorldModule\/ChildOf\/Equatable-Implementations","doc:\/\/WorldModule\/documentation\/WorldModule\/ChildOf\/Relation-Implementations"],"anchor":"Default-Implementations"}],"primaryContentSections":[{"kind":"declarations","declarations":[{"tokens":[{"text":"@frozen","kind":"attribute"},{"text":" ","kind":"text"},{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"ChildOf","kind":"identifier"}],"platforms":["Linux"],"languages":["swift"]}]},{"kind":"mentions","mentions":["doc:\/\/WorldModule\/documentation\/WorldModule\/SavingAndLoadingWorlds"]},{"kind":"content","content":[{"level":2,"anchor":"overview","type":"heading","text":"Overview"},{"type":"paragraph","inlineContent":[{"type":"text","text":"A hierarchy groups entities into trees: a ship and its turrets, a menu and its buttons. Each"},{"type":"text","text":" "},{"type":"text","text":"entity has at most one parent, and despawning a parent despawns its children, and theirs in"},{"type":"text","text":" "},{"type":"text","text":"turn. Build a hierarchy with "},{"type":"reference","isActive":true,"identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/World\/addChild(_:to:)"},{"type":"text","text":", which refuses a link that would make"},{"type":"text","text":" "},{"type":"text","text":"an entity its own ancestor, and walk it with "},{"type":"reference","isActive":true,"identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/World\/parent(of:)"},{"type":"text","text":","},{"type":"text","text":" "},{"type":"reference","isActive":true,"identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/World\/children(of:)"},{"type":"text","text":", "},{"type":"reference","isActive":true,"identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/World\/ancestors(of:)"},{"type":"text","text":" and "},{"type":"reference","isActive":true,"identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/World\/descendants(of:)"},{"type":"text","text":"."}]},{"type":"paragraph","inlineContent":[{"text":"The following example attaches a turret and an engine to a ship, then despawns the ship,","type":"text"},{"text":" ","type":"text"},{"text":"which takes its parts with it:","type":"text"}]},{"code":["var world = World()","let ship = world.spawn(Name(value: \"Ship\"))","let turret = world.spawn(Name(value: \"Turret\"))","let engine = world.spawn(Name(value: \"Engine\"))","try world.addChild(turret, to: ship)","try world.addChild(engine, to: ship)","","let parts = world.children(of: ship).map { world[Name.self, of: $0].value }","print(parts)","\/\/ Prints \"[\"Turret\", \"Engine\"]\"","","world.despawn(ship)","print(world.contains(engine))","\/\/ Prints \"false\""],"type":"codeListing","syntax":"swift"},{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"ChildOf"},{"type":"text","text":" is a "},{"type":"reference","identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/Relation","isActive":true},{"type":"text","text":" like any other, so an entity with a parent holds a"},{"type":"text","text":" "},{"type":"codeVoice","code":"Targets<ChildOf>"},{"type":"text","text":" component naming it. Queries use that to find the entities at each level"},{"type":"text","text":" "},{"type":"text","text":"of a tree:"}]},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":".related(ChildOf.self, to: parent)"},{"type":"text","text":" keeps the children of "},{"type":"codeVoice","code":"parent"},{"type":"text","text":"."}]}]},{"content":[{"inlineContent":[{"type":"codeVoice","code":".with(Targets<ChildOf>.self)"},{"type":"text","text":" keeps entities that have a parent."}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"code":".without(Targets<ChildOf>.self)","type":"codeVoice"},{"text":" keeps the roots.","type":"text"}]}]}]},{"code":["var world = World()","let menu = world.spawn(Name(value: \"Menu\"))","let play = world.spawn(Name(value: \"Play\"))","let quit = world.spawn(Name(value: \"Quit\"))","try world.addChild(play, to: menu)","try world.addChild(quit, to: menu)","","print(world.query(Name.self).related(ChildOf.self, to: menu).count)","\/\/ Prints \"2\"","print(world.query(Name.self).without(Targets<ChildOf>.self).count)","\/\/ Prints \"1\""],"type":"codeListing","syntax":"swift"}]}],"sections":[],"identifier":{"url":"doc:\/\/WorldModule\/documentation\/WorldModule\/ChildOf","interfaceLanguage":"swift"},"schemaVersion":{"minor":3,"major":0,"patch":0},"relationshipsSections":[{"title":"Conforms To","type":"conformsTo","kind":"relationships","identifiers":["doc:\/\/WorldModule\/documentation\/WorldModule\/Relation","doc:\/\/WorldModule\/s15BitwiseCopyableP","doc:\/\/WorldModule\/Se","doc:\/\/WorldModule\/SE","doc:\/\/WorldModule\/SQ","doc:\/\/WorldModule\/SH","doc:\/\/WorldModule\/s8SendableP","do