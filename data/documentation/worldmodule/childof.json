enu and its buttons. Each"},{"type":"text","text":" "},{"type":"text","text":"entity has at most one parent, and despawning a parent despawns its children, and theirs in"},{"type":"text","text":" "},{"type":"text","text":"turn. Build a hierarchy with "},{"type":"reference","isActive":true,"identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/World\/addChild(_:to:)"},{"type":"text","text":", which refuses a link that would make"},{"type":"text","text":" "},{"type":"text","text":"an entity its own ancestor, and walk it with "},{"isActive":true,"identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/World\/parent(of:)","type":"reference"},{"text":",","type":"text"},{"text":" ","type":"text"},{"isActive":true,"identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/World\/children(of:)","type":"reference"},{"text":", ","type":"text"},{"isActive":true,"identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/World\/ancestors(of:)","type":"reference"},{"text":" and ","type":"text"},{"isActive":true,"identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/World\/descendants(of:)","type":"reference"},{"text":".","type":"text"}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"The following example attaches a turret and an engine to a ship, then despawns the ship,"},{"text":" ","type":"text"},{"text":"which takes its parts with it:","type":"text"}]},{"code":["var world = World()","let ship = world.spawn(Name(value: \"Ship\"))","let turret = world.spawn(Name(value: \"Turret\"))","let engine = world.spawn(Name(value: \"Engine\"))","try world.addChild(turret, to: ship)","try world.addChild(engine, to: ship)","","let parts = world.children(of: ship).map { world[Name.self, of: $0].value }","print(parts)","\/\/ Prints \"[\"Turret\", \"Engine\"]\"","","world.despawn(ship)","print(world.contains(engine))","\/\/ Prints \"false\""],"type":"codeListing","syntax":"swift"},{"type":"paragraph","inlineContent":[{"code":"ChildOf","type":"codeVoice"},{"text":" is a ","type":"text"},{"type":"reference","isActive":true,"identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/Relation"},{"text":" like any other, so an entity with a parent holds a","type":"text"},{"text":" ","type":"text"},{"code":"Targets<ChildOf>","type":"codeVoice"},{"text":" component naming it. Queries use that to find the entities at each level","type":"text"},{"text":" ","type":"text"},{"text":"of a tree:","type":"text"}]},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"code":".related(ChildOf.self, to: parent)","type":"codeVoice"},{"text":" keeps the children of ","type":"text"},{"code":"parent","type":"codeVoice"},{"text":".","type":"text"}]}]},{"content":[{"inlineContent":[{"type":"codeVoice","code":".with(Targets<ChildOf>.self)"},{"text":" keeps entities that have a parent.","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"code":".without(Targets<ChildOf>.self)","type":"codeVoice"},{"type":"text","text":" keeps the roots."}],"type":"paragraph"}]}]},{"code":["var world = World()","let menu = world.spawn(Name(value: \"Menu\"))","let play = world.spawn(Name(value: \"Play\"))","let quit = world.spawn(Name(value: \"Quit\"))","try world.addChild(play, to: menu)","try world.addChild(quit, to: menu)","","print(world.query(Name.self).related(ChildOf.self, to: menu).count)","\/\/ Prints \"2\"","print(world.query(Name.self).without(Targets<ChildOf>.self).count)","\/\/ Prints \"1\""],"type":"codeListing","syntax":"swift"}]}],"variants":[{"paths":["\/documentation\/worldmodule\/childof"],"traits":[{"interfaceLanguage":"swift"}]}],"metadata":{"modules":[{"name":"WorldModule"}],"roleHeading":"Structure","role":"symbol","externalID":"s:11WorldModule7ChildOfV","remoteSource":{"url":"https:\/\/github.com\/Tyler-Keith-Thompson\/ECS\/blob\/main\/Sources\/WorldModule\/Hierarchy.swift#L51","fileName":"Hierarchy.swift"},"navigatorTitle":[{"text":"ChildOf","kind":"identifier"}],"symbolKind":"stru