{"metadata":{"fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"ChildOf"}],"symbolKind":"struct","navigatorTitle":[{"text":"ChildOf","kind":"identifier"}],"remoteSource":{"url":"https:\/\/github.com\/Tyler-Keith-Thompson\/ECS\/blob\/main\/Sources\/WorldModule\/Hierarchy.swift#L51","fileName":"Hierarchy.swift"},"externalID":"s:11WorldModule7ChildOfV","title":"ChildOf","role":"symbol","modules":[{"name":"WorldModule"}],"roleHeading":"Structure"},"identifier":{"url":"doc:\/\/WorldModule\/documentation\/WorldModule\/ChildOf","interfaceLanguage":"swift"},"hierarchy":{"paths":[["doc:\/\/WorldModule\/documentation\/WorldModule"]]},"sections":[],"topicSections":[{"title":"Initializers","anchor":"Initializers","generated":true,"identifiers":["doc:\/\/WorldModule\/documentation\/WorldModule\/ChildOf\/init()","doc:\/\/WorldModule\/documentation\/WorldModule\/ChildOf\/init(from:)"]},{"title":"Type Properties","anchor":"Type-Properties","generated":true,"identifiers":["doc:\/\/WorldModule\/documentation\/WorldModule\/ChildOf\/isExclusive","doc:\/\/WorldModule\/documentation\/WorldModule\/ChildOf\/onTargetDespawn"]},{"title":"Default Implementations","anchor":"Default-Implementations","generated":true,"identifiers":["doc:\/\/WorldModule\/documentation\/WorldModule\/ChildOf\/Equatable-Implementations","doc:\/\/WorldModule\/documentation\/WorldModule\/ChildOf\/Relation-Implementations"]}],"abstract":[{"type":"text","text":"The relation that links a child entity to its parent."}],"relationshipsSections":[{"title":"Conforms To","type":"conformsTo","identifiers":["doc:\/\/WorldModule\/documentation\/WorldModule\/Relation","doc:\/\/WorldModule\/s15BitwiseCopyableP","doc:\/\/WorldModule\/Se","doc:\/\/WorldModule\/SE","doc:\/\/WorldModule\/SQ","doc:\/\/WorldModule\/SH","doc:\/\/WorldModule\/s8SendableP","doc:\/\/WorldModule\/s16SendableMetatypeP"],"kind":"relationships"}],"seeAlsoSections":[{"title":"Building Hierarchies","anchor":"Building-Hierarchies","generated":true,"identifiers":["doc:\/\/WorldModule\/documentation\/WorldModule\/AncestorsView","doc:\/\/WorldModule\/documentation\/WorldModule\/DescendantsView","doc:\/\/WorldModule\/documentation\/WorldModule\/CyclicHierarchy","doc:\/\/WorldModule\/documentation\/WorldModule\/HierarchyError"]}],"primaryContentSections":[{"declarations":[{"tokens":[{"text":"@frozen","kind":"attribute"},{"text":" ","kind":"text"},{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"ChildOf","kind":"identifier"}],"platforms":["Linux"],"languages":["swift"]}],"kind":"declarations"},{"mentions":["doc:\/\/WorldModule\/documentation\/WorldModule\/SavingAndLoadingWorlds"],"kind":"mentions"},{"content":[{"level":2,"type":"heading","text":"Overview","anchor":"overview"},{"type":"paragraph","inlineContent":[{"text":"A hierarchy groups entities into trees: a ship and its turrets, a menu and its buttons. Each","type":"text"},{"text":" ","type":"text"},{"text":"entity has at most one parent, and despawning a parent despawns its children, and theirs in","type":"text"},{"text":" ","type":"text"},{"text":"turn. Build a hierarchy with ","type":"text"},{"identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/World\/addChild(_:to:)","isActive":true,"type":"reference"},{"text":", which refuses a link that would make","type":"text"},{"text":" ","type":"text"},{"text":"an entity its own ancestor, and walk it with ","type":"text"},{"identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/World\/parent(of:)","isActive":true,"type":"reference"},{"text":",","type":"text"},{"text":" ","type":"text"},{"identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/World\/children(of:)","isActive":true,"type":"reference"},{"text":", ","type":"text"},{"identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/World\/ancestors(of:)","isActive":true,"type":"reference"},{"text":" and ","type":"text"},{"identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/World\/descendants(of:)","isActive":true,"type":"reference"},{"text":".","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"The following example attaches a turret and an engine to a ship, then despawns the ship,","type":"text"},{"text":" ","type":"text"},{"text":"which takes its parts with it:","type":"text"}]},{"type":"codeListing","code":["var world = World()","let ship = world.spawn(Name(value: \"Ship\"))","let turret = world.spawn(Name(value: \"Turret\"))","let engine = world.spawn(Name(value: \"Engine\"))","try world.addChild(turret, to: ship)","try world.addChild(engine, to: ship)","","let parts = world.children(of: ship).map { world[Name.self, of: $0].value }","print(parts)","\/\/ Prints \"[\"Turret\", \"Engine\"]\"","","world.despawn(ship)","print(world.contains(engine))","\/\/ Prints \"false\""],"syntax":"swift"},{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"ChildOf"},{"type":"text","text":" is a "},{"type":"reference","isActive":true,"identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/Relation"},{"type":"text","text":" like any other, so an entity with a parent holds a"},{"type":"text","text":" "},{"type":"codeVoice","code":"Targets<ChildOf>"},{"type":"text","text":" component naming it. Queries use that to find the entities at each level"},{"type":"text","text":" "},{"type":"text","text":"of a tree:"}]},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"code":".related(ChildOf.self, to: parent)","type":"codeVoice"},{"type":"text","text":" keeps the children of "},{"code":"parent","type":"codeVoice"},{"type":"text","text":"."}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":".with(Targets<ChildOf>.self)"},{"type":"text","text":" keeps entities that have a parent."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":".without(Targets<ChildOf>.self)"},{"text":" keeps the roots.","type":"text"}]}]}]},{"type":"codeListing