{"variants":[{"paths":["\/documentation\/worldmodule\/childof"],"traits":[{"interfaceLanguage":"swift"}]}],"sections":[],"kind":"symbol","hierarchy":{"paths":[["doc:\/\/WorldModule\/documentation\/WorldModule"]]},"relationshipsSections":[{"identifiers":["doc:\/\/WorldModule\/documentation\/WorldModule\/Relation","doc:\/\/WorldModule\/s15BitwiseCopyableP","doc:\/\/WorldModule\/Se","doc:\/\/WorldModule\/SE","doc:\/\/WorldModule\/SQ","doc:\/\/WorldModule\/SH","doc:\/\/WorldModule\/s8SendableP","doc:\/\/WorldModule\/s16SendableMetatypeP"],"type":"conformsTo","kind":"relationships","title":"Conforms To"}],"seeAlsoSections":[{"identifiers":["doc:\/\/WorldModule\/documentation\/WorldModule\/AncestorsView","doc:\/\/WorldModule\/documentation\/WorldModule\/DescendantsView","doc:\/\/WorldModule\/documentation\/WorldModule\/CyclicHierarchy","doc:\/\/WorldModule\/documentation\/WorldModule\/HierarchyError"],"generated":true,"anchor":"Building-Hierarchies","title":"Building Hierarchies"}],"primaryContentSections":[{"declarations":[{"tokens":[{"kind":"attribute","text":"@frozen"},{"kind":"text","text":" "},{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"ChildOf"}],"languages":["swift"],"platforms":["Linux"]}],"kind":"declarations"},{"mentions":["doc:\/\/WorldModule\/documentation\/WorldModule\/SavingAndLoadingWorlds"],"kind":"mentions"},{"content":[{"anchor":"overview","type":"heading","text":"Overview","level":2},{"type":"paragraph","inlineContent":[{"text":"A hierarchy groups entities into trees: a ship and its turrets, a menu and its buttons. Each","type":"text"},{"text":" ","type":"text"},{"text":"entity has at most one parent, and despawning a parent despawns its children, and theirs in","type":"text"},{"text":" ","type":"text"},{"text":"turn. Build a hierarchy with ","type":"text"},{"identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/World\/addChild(_:to:)","isActive":true,"type":"reference"},{"text":", which refuses a link that would make","type":"text"},{"text":" ","type":"text"},{"text":"an entity its own ancestor, and walk it with ","type":"text"},{"identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/World\/parent(of:)","isActive":true,"type":"reference"},{"text":",","type":"text"},{"text":" ","type":"text"},{"identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/World\/children(of:)","isActive":true,"type":"reference"},{"text":", ","type":"text"},{"identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/World\/ancestors(of:)","isActive":true,"type":"reference"},{"text":" and ","type":"text"},{"identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/World\/descendants(of:)","isActive":true,"type":"reference"},{"text":".","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"The following example attaches a turret and an engine to a ship, then despawns the ship,","type":"text"},{"text":" ","type":"text"},{"text":"which takes its parts with it:","type":"text"}]},{"type":"codeListing","code":["var world = World()","let ship = world.spawn(Name(value: \"Ship\"))","let turret = world.spawn(Name(value: \"Turret\"))","let engine = world.spawn(Name(value: \"Engine\"))","try world.addChild(turret, to: ship)","try world.addChild(engine, to: ship)","","let parts = world.children(of: ship).map { world[Name.self, of: $0].value }","print(parts)","\/\/ Prints \"[\"Turret\", \"Engine\"]\"","","world.despawn(ship)","print(world.contains(engine))","\/\/ Prints \"false\""],"syntax":"swift"},{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"ChildOf"},{"text":" is a ","type":"text"},{"type":"reference","isActive":true,"identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/Relation"},{"text":" like any other, so an entity with a parent holds a","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"Targets<ChildOf>"},{"text":" component naming it. Queries use that to find the entities at each level","type":"text"},{"text":" ","type":"text"},{"text":"of a tree:","type":"text"}]},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"type":"codeVoice","code":".related(ChildOf.self, to: parent)"},{"type":"text","text":" keeps the children of "},{"type":"codeVoice","code":"parent"},{"type":"text","text":"."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"codeVoice","code":".with(Targets<ChildOf>.self)"},{"text":" keeps entities that have a parent.","type":"text"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"code":".without(Targets<ChildOf>.self)","type":"codeVoice"},{"text":" keeps the roots.","type":"text"}]}]}]},{"type":"codeListing","code":["var world = World()","let menu = world.spawn(Name(value: \"Menu\"))","let play = world.spawn(Name(value: \"Play\"))","let quit = world.spawn(Name(value: \"Quit\"))","try world.addChild(play, to: menu)","try world.addChild(quit, to: menu)","","print(world.query(Name.self).related(ChildOf.self, to: menu).count)","\/\/ Prints \"2\"","print(world.query(Name.self).without(Targets<ChildOf>.self).count)","\/\/ Prints \"1\""],"syntax":"swift"}],"kind":"content"}],"metadata":{"symbolKind":"struct","externalID":"s:11WorldModule7ChildOfV","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"ChildOf"}],"role":"symbol","title":"ChildOf","remoteSource":{"fileName":"Hierarchy.swift","url":"https:\/\/github.com\/Tyler-Keith-Thompson\/ECS\/blob\/main\/Sources\/WorldModule\/Hierarchy.swift#L51"},"navigatorTitle":[{"text":"ChildOf","kind":"identifier"}],"roleHeading":"Structure","modules":[{"name":"WorldModule"}]},"abstract":[{"text":"The relation that links a child entity to its parent.","type":"text"}],"topicSections":[{"identifiers":["doc:\/\/WorldModule\/documentation\/WorldModule\/ChildOf\/init()","doc:\/\/WorldModule\/documentation\/WorldModule\/ChildOf\/init(from:)"],"generated":true,"anchor":"Initializers","title":"Initializers"},{"identifiers":["doc:\/\/Wo