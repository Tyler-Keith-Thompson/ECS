{"sections":[],"metadata":{"symbolKind":"struct","remoteSource":{"url":"https:\/\/github.com\/Tyler-Keith-Thompson\/ECS\/blob\/main\/Sources\/WorldModule\/Hierarchy.swift#L51","fileName":"Hierarchy.swift"},"roleHeading":"Structure","externalID":"s:11WorldModule7ChildOfV","modules":[{"name":"WorldModule"}],"title":"ChildOf","role":"symbol","navigatorTitle":[{"text":"ChildOf","kind":"identifier"}],"fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"ChildOf","kind":"identifier"}]},"topicSections":[{"generated":true,"title":"Initializers","anchor":"Initializers","identifiers":["doc:\/\/WorldModule\/documentation\/WorldModule\/ChildOf\/init()","doc:\/\/WorldModule\/documentation\/WorldModule\/ChildOf\/init(from:)"]},{"generated":true,"title":"Type Properties","anchor":"Type-Properties","identifiers":["doc:\/\/WorldModule\/documentation\/WorldModule\/ChildOf\/isExclusive","doc:\/\/WorldModule\/documentation\/WorldModule\/ChildOf\/onTargetDespawn"]},{"generated":true,"title":"Default Implementations","anchor":"Default-Implementations","identifiers":["doc:\/\/WorldModule\/documentation\/WorldModule\/ChildOf\/Equatable-Implementations","doc:\/\/WorldModule\/documentation\/WorldModule\/ChildOf\/Relation-Implementations"]}],"relationshipsSections":[{"kind":"relationships","title":"Conforms To","type":"conformsTo","identifiers":["doc:\/\/WorldModule\/documentation\/WorldModule\/Relation","doc:\/\/WorldModule\/s15BitwiseCopyableP","doc:\/\/WorldModule\/Se","doc:\/\/WorldModule\/SE","doc:\/\/WorldModule\/SQ","doc:\/\/WorldModule\/SH","doc:\/\/WorldModule\/s8SendableP","doc:\/\/WorldModule\/s16SendableMetatypeP"]}],"seeAlsoSections":[{"generated":true,"title":"Building Hierarchies","anchor":"Building-Hierarchies","identifiers":["doc:\/\/WorldModule\/documentation\/WorldModule\/AncestorsView","doc:\/\/WorldModule\/documentation\/WorldModule\/DescendantsView","doc:\/\/WorldModule\/documentation\/WorldModule\/CyclicHierarchy","doc:\/\/WorldModule\/documentation\/WorldModule\/HierarchyError"]}],"schemaVersion":{"minor":3,"major":0,"patch":0},"primaryContentSections":[{"kind":"declarations","declarations":[{"languages":["swift"],"platforms":["Linux"],"tokens":[{"kind":"attribute","text":"@frozen"},{"kind":"text","text":" "},{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"ChildOf"}]}]},{"kind":"mentions","mentions":["doc:\/\/WorldModule\/documentation\/WorldModule\/SavingAndLoadingWorlds"]},{"kind":"content","content":[{"text":"Overview","anchor":"overview","level":2,"type":"heading"},{"inlineContent":[{"type":"text","text":"A hierarchy groups entities into trees: a ship and its turrets, a menu and its buttons. Each"},{"type":"text","text":" "},{"type":"text","text":"entity has at most one parent, and despawning a parent despawns its children, and theirs in"},{"type":"text","text":" "},{"type":"text","text":"turn. Build a hierarchy with "},{"type":"reference","isActive":true,"identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/World\/addChild(_:to:)"},{"type":"text","text":", which refuses a link that would make"},{"type":"text","text":" "},{"type":"text","text":"an entity its own ancestor, and walk it with "},{"type":"reference","isActive":true,"identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/World\/parent(of:)"},{"type":"text","text":","},{"type":"text","text":" "},{"type":"reference","isActive":true,"identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/World\/children(of:)"},{"type":"text","text":", "},{"type":"reference","isActive":true,"identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/World\/ancestors(of:)"},{"type":"text","text":" and "},{"type":"reference","isActive":true,"identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/World\/descendants(of:)"},{"type":"text","text":"."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"The following example attaches a turret and an engine to a ship, then despawns the ship,"},{"type":"text","text":" "},{"type":"text","text":"which takes its parts with it:"}],"type":"paragraph"},{"syntax":"swift","code":["var world = World()","let ship = world.spawn(Name(value: \"Ship\"))","let turret = world.spawn(Name(value: \"Turret\"))","let engine = world.spawn(Name(value: \"Engine\"))","try world.addChild(turret, to: ship)","try world.addChild(engine, to: ship)","","let parts = world.children(of: ship).map { world[Name.self, of: $0].value }","print(parts)","\/\/ Prints \"[\"Turret\", \"Engine\"]\"","","world.despawn(ship)","print(world.contains(engine))","\/\/ Prints \"false\""],"type":"codeListing"},{"inlineContent":[{"code":"ChildOf","type":"codeVoice"},{"type":"text","text":" is a "},{"type":"reference","identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/Relation","isActive":true},{"type":"text","text":" like any other, so an entity with a parent holds a"},{"type":"text","text":" "},{"code":"Targets<ChildOf>","type":"codeVoice"},{"type":"text","text":" component naming it. Queries use that to find the entities at each level"},{"type":"text","text":" "},{"type":"text","text":"of a tree:"}],"type":"paragraph"},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"type":"codeVoice","code":".related(ChildOf.self, to: parent)"},{"type":"text","text":" keeps the children of "},{"type":"codeVoice","code":"parent"},{"type":"text","text":"."}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"code":".with(Targets<ChildOf>.self)","type":"codeVoice"},{"type":"text","text":" keeps entities that have a parent."}]}]},{"content":[{"inlineContent":[{"code":".without(Targets<ChildOf>.self)","type":"codeVoice"},{"text":" keeps the roots.","type":"text"}],"type":"paragraph"}]}]},{"syntax":"swift","code":["var world = World()","let menu = world.spawn(Name(value: \"Menu\"))","let play = world.spawn(Name(value: \"Play\"))","let quit = world.spawn(Name(value: \"Quit\"))","try world.addChild(play, to: menu)","try world.addChild(quit, to: menu)","","print(world.query(Name.self).related(ChildOf.self, to: menu).count)","\/\/ Prints \"2\"","print(world.query(Name.self).without(Targets<ChildOf>.self).count)","\/\/ Prints \"1\""],"type":"codeListing"}]}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/worldmodule\/childof"]}],"hierarchy":{"paths":[["doc:\/\/WorldModule\/documentation\/WorldModule"]]},"abstract":[{"type":"text","text":"The relation that links a child entity to its parent."}],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/WorldModule\/documentation\/WorldModule\/ChildOf"},"kind":"symbol","references":{"doc://WorldModule/SQ":{"identifier":"doc:\/\/WorldModule\/SQ","type":"unresolvable","title":"Swift.Equatable"},"doc://WorldModule/SH":{"type":"unresolvable","identifier":"doc:\/\/WorldModule\/SH","title":"Swift.Hashable"},"doc://WorldModule/documentation/WorldModule/AncestorsView":{"kind":"symbol","type":"topic","role":"symbol","title":"AncestorsView","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"AncestorsView"}],"url":"\/documentation\/worldmodule\/ancestorsview","identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/AncestorsView","navigatorTitle":[{"kind":"identifier","text":"AncestorsView"}],"abstract":[{"type":"text","text":"A lazy sequence of an entity’s ancestors, from its parent up to the root of its tree."}]},"doc://WorldModule/documentation/WorldModule/World/parent(of:)":{"identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/World\/parent(of:)","role":"symbol","url":"\/documentation\/worldmodule\/world\/parent(of:)","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"parent"},{"kind":"text","text":"("},{"kind":"externalParam","text":"of"},{"kind":"text","text":": "},{"preciseIdentifier":"s:11WorldModule6EntityV","kind":"typeIdentifier","text":"Entity"},{"kind":"text","text":") -> "},{"preci