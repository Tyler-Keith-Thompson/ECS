:" "},{"type":"text","text":"of a tree:"}]},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":".related(ChildOf.self, to: parent)"},{"text":" keeps the children of ","type":"text"},{"type":"codeVoice","code":"parent"},{"text":".","type":"text"}]}]},{"content":[{"inlineContent":[{"code":".with(Targets<ChildOf>.self)","type":"codeVoice"},{"text":" keeps entities that have a parent.","type":"text"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"code":".without(Targets<ChildOf>.self)","type":"codeVoice"},{"text":" keeps the roots.","type":"text"}]}]}],"type":"unorderedList"},{"syntax":"swift","type":"codeListing","code":["var world = World()","let menu = world.spawn(Name(value: \"Menu\"))","let play = world.spawn(Name(value: \"Play\"))","let quit = world.spawn(Name(value: \"Quit\"))","try world.addChild(play, to: menu)","try world.addChild(quit, to: menu)","","print(world.query(Name.self).related(ChildOf.self, to: menu).count)","\/\/ Prints \"2\"","print(world.query(Name.self).without(Targets<ChildOf>.self).count)","\/\/ Prints \"1\""]}],"kind":"content"}],"relationshipsSections":[{"kind":"relationships","title":"Conforms To","type":"conformsTo","identifiers":["doc:\/\/WorldModule\/documentation\/WorldModule\/Relation","doc:\/\/WorldModule\/s15BitwiseCopyableP","doc:\/\/WorldModule\/Se","doc:\/\/WorldModule\/SE","doc:\/\/WorldModule\/SQ","doc:\/\/WorldModule\/SH","doc:\/\/WorldModule\/s8SendableP","doc:\/\/WorldModule\/s16SendableMetatypeP"]}],"sections":[],"identifier":{"url":"doc:\/\/WorldModule\/documentation\/WorldModule\/ChildOf","interfaceLanguage":"swift"},"metadata":{"title":"ChildOf","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"ChildOf"}],"modules":[{"name":"WorldModule"}],"navigatorTitle":[{"kind":"identifier","text":"ChildOf"}],"symbolKind":"struct","roleHeading":"Structure","externalID":"s:11WorldModule7ChildOfV","role":"symbol","remoteSo