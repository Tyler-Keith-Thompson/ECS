{"sections":[],"kind":"symbol","metadata":{"title":"ChildOf","symbolKind":"struct","modules":[{"name":"WorldModule"}],"navigatorTitle":[{"text":"ChildOf","kind":"identifier"}],"externalID":"s:11WorldModule7ChildOfV","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"ChildOf","kind":"identifier"}],"role":"symbol","roleHeading":"Structure","remoteSource":{"url":"https:\/\/github.com\/Tyler-Keith-Thompson\/ECS\/blob\/main\/Sources\/WorldModule\/Hierarchy.swift#L51","fileName":"Hierarchy.swift"}},"schemaVersion":{"major":0,"patch":0,"minor":3},"hierarchy":{"paths":[["doc:\/\/WorldModule\/documentation\/WorldModule"]]},"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/WorldModule\/documentation\/WorldModule\/ChildOf"},"abstract":[{"type":"text","text":"The relation that links a child entity to its parent."}],"variants":[{"paths":["\/documentation\/worldmodule\/childof"],"traits":[{"interfaceLanguage":"swift"}]}],"topicSections":[{"identifiers":["doc:\/\/WorldModule\/documentation\/WorldModule\/ChildOf\/init()","doc:\/\/WorldModule\/documentation\/WorldModule\/ChildOf\/init(from:)"],"generated":true,"anchor":"Initializers","title":"Initializers"},{"identifiers":["doc:\/\/WorldModule\/documentation\/WorldModule\/ChildOf\/isExclusive","doc:\/\/WorldModule\/documentation\/WorldModule\/ChildOf\/onTargetDespawn"],"generated":true,"anchor":"Type-Properties","title":"Type Properties"},{"identifiers":["doc:\/\/WorldModule\/documentation\/WorldModule\/ChildOf\/Equatable-Implementations","doc:\/\/WorldModule\/documentation\/WorldModule\/ChildOf\/Relation-Implementations"],"generated":true,"anchor":"Default-Implementations","title":"Default Implementations"}],"relationshipsSections":[{"identifiers":["doc:\/\/WorldModule\/documentation\/WorldModule\/Relation","doc:\/\/WorldModule\/s15BitwiseCopyableP","doc:\/\/WorldModule\/Se","doc:\/\/WorldModule\/SE","doc:\/\/WorldModule\/SQ","doc:\/\/WorldModule\/SH","doc:\/\/WorldModule\/s8SendableP","doc:\/\/WorldModule\/s16SendableMetatypeP"],"kind":"relationships","title":"Conforms To","type":"conformsTo"}],"seeAlsoSections":[{"identifiers":["doc:\/\/WorldModule\/documentation\/WorldModule\/AncestorsView","doc:\/\/WorldModule\/documentation\/WorldModule\/DescendantsView","doc:\/\/WorldModule\/documentation\/WorldModule\/CyclicHierarchy","doc:\/\/WorldModule\/documentation\/WorldModule\/HierarchyError"],"generated":true,"anchor":"Building-Hierarchies","title":"Building Hierarchies"}],"primaryContentSections":[{"kind":"declarations","declarations":[{"platforms":["Linux"],"tokens":[{"kind":"attribute","text":"@frozen"},{"kind":"text","text":" "},{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"ChildOf"}],"languages":["swift"]}]},{"kind":"mentions","mentions":["doc:\/\/WorldModule\/documentation\/WorldModule\/SavingAndLoadingWorlds"]},{"kind":"content","content":[{"text":"Overview","level":2,"anchor":"overview","type":"heading"},{"inlineContent":[{"text":"A hierarchy groups entities into trees: a ship and its turrets, a menu and its buttons. Each","type":"text"},{"text":" ","type":"text"},{"text":"entity has at most one parent, and despawning a parent despawns its children, and theirs in","type":"text"},{"text":" ","type":"text"},{"text":"turn. Build a hierarchy with ","type":"text"},{"identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/World\/addChild(_:to:)","type":"reference","isActive":true},{"text":", which refuses a link that would make","type":"text"},{"text":" ","type":"text"},{"text":"an entity its own ancestor, and walk it with ","type":"text"},{"identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/World\/parent(of:)","type":"reference","isActive":true},{"text":",","type":"text"},{"text":" ","type":"text"},{"identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/World\/children(of:)","type":"reference","isActive":true},{"text":", ","type":"text"},{"identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/World\/ancestors(of:)","type":"reference","isActive":true},{"text":" and ","type":"text"},{"identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/World\/descendants(of:)","type":"reference","isActive":true},{"text":".","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"The following example attaches a turret and an engine to a ship, then despawns the ship,","type":"text"},{"text":" ","type":"text"},{"text":"which takes its parts with it:","type":"text"}],"type":"paragraph"},{"type":"codeListing","code":["var world = World()","let ship = world.spawn(Name(value: \"Ship\"))","let turret = world.spawn(Name(value: \"Turret\"))","let engine = world.spawn(Name(value: \"Engine\"))","try world.addChild(turret, to: ship)","try world.addChild(engine, to: ship)","","let parts = world.children(of: ship).map { world[Name.self, of: $0].value }","print(parts)","\/\/ Prints \"[\"Turret\", \"Engine\"]\"","","world.despawn(ship)","print(world.contains(engine))","\/\/ Prints \"false\""],"syntax":"swift"},{"inlineContent":[{"type":"codeVoice","code":"ChildOf"},{"text":" is a ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/Relation"},{"text":" like any other, so an entity with a parent holds a","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"Targets<ChildOf>"},{"text":" component naming it. Queries use that to find the entities at each level","type":"text"},{"text":" ","type":"text"},{"text":"of a tree:","type":"text"}],"type":"paragraph"},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"type":"codeVoice","code":".related(ChildOf.self, to: parent)"},{"text":" keeps the children of ","type":"text"},{"type":"codeVoice","code":"parent"},{"text":".","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"codeVoice","code":".with(Targets<ChildOf>.self)"},{"type":"text","text":" keeps entities that have a parent."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"codeVoice","code":".without(Targets<ChildOf>.self)"},{"type":"text","text":" keeps the roots."}],"type":"paragraph"}]}]},{"type":"codeListing","code":["var world = World()","let menu = world.spawn(Name(value: \"Menu\"))","let play = world.spawn(Name(value: \"Play\"))","let quit = world.spawn(Name(value: \"Quit\"))","try world.addChild(play, to: menu)","try world.addChild(quit, to: menu)","","print(world.query(Name.self).related(ChildOf.self, to: menu).count)","\/\/ Prints \"2\"","print(world.query(Name.self).without(Targets<ChildOf>.self).count)","\/\/ Prints \"1\""],"syntax":"swift"}]}],"references":{"doc://WorldModule/documentation/WorldModule/ChildOf/Equatable-Implementations":{"kind":"article","type":"topic","identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/ChildOf\/Equatable-Implementations","role":"collectionGroup","title":"Equatable Implementations","abstract":[],"url":"\/documentation\/worldmodule\/childof\/equatable-implementations"},"doc://WorldModule/documentation/WorldModule/CyclicHierarchy":{"identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/CyclicHierarchy","role":"symbol","navigatorTitle":[{"text":"CyclicHierarchy","kind":"identifier"}],"url":"\/documentation\/worldmodule\/cyclichierarchy","type":"topic","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"CyclicHierarchy","kind":"identifier"}],"title":"CyclicHierarchy","kind":"symbol","abstract":[{"text":"An error that indicates a link would make an entity its own ancestor.","type":"text"}]},"doc://WorldModule/documentation/WorldModule/World/parent(of:)":{"type":"topic","url":"\/documentation\/worldmodule\/world\/parent(of:)","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"parent"},{"kind":"text","text":"("},{"kind":"externalParam","text":"of"},{"kind":"text","text":": "},{"preciseIdentifier":"s:11WorldModule6EntityV","kind":"typeIdentifier","text