swift"],"platforms":["Linux"]}]},{"kind":"mentions","mentions":["doc:\/\/WorldModule\/documentation\/WorldModule\/SavingAndLoadingWorlds"]},{"kind":"content","content":[{"anchor":"overview","type":"heading","level":2,"text":"Overview"},{"inlineContent":[{"type":"text","text":"A hierarchy groups entities into trees: a ship and its turrets, a menu and its buttons. Each"},{"type":"text","text":" "},{"type":"text","text":"entity has at most one parent, and despawning a parent despawns its children, and theirs in"},{"type":"text","text":" "},{"type":"text","text":"turn. Build a hierarchy with "},{"type":"reference","identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/World\/addChild(_:to:)","isActive":true},{"type":"text","text":", which refuses a link that would make"},{"type":"text","text":" "},{"type":"text","text":"an entity its own ancestor, and walk it with "},{"type":"reference","identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/World\/parent(of:)","isActive":true},{"type":"text","text":","},{"type":"text","text":" "},{"type":"reference","identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/World\/children(of:)","isActive":true},{"type":"text","text":", "},{"type":"reference","identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/World\/ancestors(of:)","isActive":true},{"type":"text","text":" and "},{"type":"reference","identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/World\/descendants(of:)","isActive":true},{"type":"text","text":"."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"The following example attaches a turret and an engine to a ship, then despawns the ship,"},{"type":"text","text":" "},{"type":"text","text":"which takes its parts with it:"}],"type":"paragraph"},{"type":"codeListing","code":["var world = World()","let ship = world.spawn(Name(value: \"Ship\"))","let turret = world.spawn(Name(value: \"Turret\"))","let engine = world.spawn(Name(value: \"Engine\"))","try world.addChild(turret, to: ship)","try world.addChild(engine, to: ship)","","let parts = world.children(of: ship).map { world[Name.self, of: $0].value }","print(parts)","\/\/ Prints \"[\"Turret\", \"Engine\"]\"","","world.despawn(ship)","print(world.contains(engine))","\/\/ Prints \"false\""],"syntax":"swift"},{"inlineContent":[{"code":"ChildOf","type":"codeVoice"},{"text":" is a ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/Relation"},{"text":" like any other, so an entity with a parent holds a","type":"text"},{"text":" ","type":"text"},{"code":"Targets<ChildOf>","type":"codeVoice"},{"text":" component naming it. Queries use that to find the entities at each level","type":"text"},{"text":" ","type":"text"},{"text":"of a tree:","type":"text"}],"type":"paragraph"},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"type":"codeVoice","code":".related(ChildOf.self, to: parent)"},{"type":"text","text":" keeps the children of "},{"type":"codeVoice","code":"parent"},{"type":"text","text":"."}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":".with(Targets<ChildOf>.self)"},{"type":"text","text":" keeps entities that have a parent."}]}]},{"content":[{"inlineContent":[{"type":"codeVoice","code":".without(Targets<ChildOf>.self)"},{"type":"text","text":" keeps the roots."}],"type":"paragraph"}]}]},{"type":"codeListing","code":["var world = World()","let menu = world.spawn(Name(value: \"Menu\"))","let play = world.spawn(Name(value: \"Play\"))","let quit = world.spawn(Name(value: \"Quit\"))","try world.addChild(play, to: menu)","try world.addChild(quit, to: menu)","","print(world.query(Name.self).related(ChildOf.self, to: menu).count)","\/\/ Prints \"2\"","print(world.query(Name.self).without(Targets<ChildOf>.self).count)","\/\/ Prints \"1\""],"syntax":"swift"}]}],"schemaVersion":{"patch":0,"major":0,"minor":3},"abstract":[{"type":"text","text":"The relation that link