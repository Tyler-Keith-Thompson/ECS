{"sections":[],"metadata":{"symbolKind":"struct","navigatorTitle":[{"kind":"identifier","text":"ChildOf"}],"remoteSource":{"url":"https:\/\/github.com\/Tyler-Keith-Thompson\/ECS\/blob\/main\/Sources\/WorldModule\/Hierarchy.swift#L51","fileName":"Hierarchy.swift"},"roleHeading":"Structure","externalID":"s:11WorldModule7ChildOfV","role":"symbol","title":"ChildOf","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"ChildOf"}],"modules":[{"name":"WorldModule"}]},"hierarchy":{"paths":[["doc:\/\/WorldModule\/documentation\/WorldModule"]]},"seeAlsoSections":[{"identifiers":["doc:\/\/WorldModule\/documentation\/WorldModule\/AncestorsView","doc:\/\/WorldModule\/documentation\/WorldModule\/DescendantsView","doc:\/\/WorldModule\/documentation\/WorldModule\/CyclicHierarchy","doc:\/\/WorldModule\/documentation\/WorldModule\/HierarchyError"],"title":"Building Hierarchies","generated":true,"anchor":"Building-Hierarchies"}],"primaryContentSections":[{"kind":"declarations","declarations":[{"languages":["swift"],"platforms":["Linux"],"tokens":[{"kind":"attribute","text":"@frozen"},{"kind":"text","text":" "},{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"ChildOf"}]}]},{"kind":"mentions","mentions":["doc:\/\/WorldModule\/documentation\/WorldModule\/SavingAndLoadingWorlds"]},{"kind":"content","content":[{"text":"Overview","type":"heading","level":2,"anchor":"overview"},{"type":"paragraph","inlineContent":[{"type":"text","text":"A hierarchy groups entities into trees: a ship and its turrets, a menu and its buttons. Each"},{"type":"text","text":" "},{"type":"text","text":"entity has at most one parent, and despawning a parent despawns its children, and theirs in"},{"type":"text","text":" "},{"type":"text","text":"turn. Build a hierarchy with "},{"identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/World\/addChild(_:to:)","isActive":true,"type":"reference"},{"type":"text","text":", which refuses a link that would make"},{"type":"text","text":" "},{"type":"text","text":"an entity its own ancestor, and walk it with "},{"identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/World\/parent(of:)","isActive":true,"type":"reference"},{"type":"text","text":","},{"type":"text","text":" "},{"identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/World\/children(of:)","isActive":true,"type":"reference"},{"type":"text","text":", "},{"identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/World\/ancestors(of:)","isActive":true,"type":"reference"},{"type":"text","text":" and "},{"identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/World\/descendants(of:)","isActive":true,"type":"reference"},{"type":"text","text":"."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"The following example attaches a turret and an engine to a ship, then despawns the ship,"},{"type":"text","text":" "},{"type":"text","text":"which takes its parts with it:"}]},{"code":["var world = World()","let ship = world.spawn(Name(value: \"Ship\"))","let turret = world.spawn(Name(value: \"Turret\"))","let engine = world.spawn(Name(value: \"Engine\"))","try world.addChild(turret, to: ship)","try world.addChild(engine, to: ship)","","let parts = world.children(of: ship).map { world[Name.self, of: $0].value }","print(parts)","\/\/ Prints \"[\"Turret\", \"Engine\"]\"","","world.despawn(ship)","print(world.contains(engine))","\/\/ Prints \"false\""],"type":"codeListing","syntax":"swift"},{"type":"paragraph","inlineContent":[{"code":"ChildOf","type":"codeVoice"},{"text":" is a ","type":"text"},{"identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/Relation","type":"reference","isActive":true},{"text":" like any other, so an entity with a parent holds a","type":"text"},{"text":" ","type":"text"},{"code":"Targets<ChildOf>","type":"codeVoice"},{"text":" component naming it. Queries use that to find the entities at each level","type":"text"},{"text":" ","type":"text"},{"text":"of a tree:","type":"text"}]},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"type":"codeVoice","code":".related(ChildOf.self, to: parent)"},{"type":"text","text":" keeps the children of "},{"type":"codeVoice","code":"parent"},{"type":"text","text":"."}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":".with(Targets<ChildOf>.self)"},{"type":"text","text":" keeps entities that have a parent."}]}]},{"content":[{"inlineContent":[{"type":"codeVoice","code":".without(Targets<ChildOf>.self)"},{"type":"text","text":" keeps the roots."}],"type":"paragraph"}]}]},{"code":["var world = World()","let menu = world.spawn(Name(value: \"Menu\"))","let play = world.spawn(Name(value: \"Play\"))","let quit = world.spawn(Name(value: \"Quit\"))","try world.addChild(play, to: menu)","try world.addChild(quit, to: menu)","","print(world.query(Name.self).related(ChildOf.self, to: menu).count)","\/\/ Prints \"2\"","print(world.query(Name.self).without(Targets<ChildOf>.self).count)","\/\/ Prints \"1\""],"type":"codeListing","syntax":"swift"}]}],"abstract":[{"type":"text","text":"The relation that links a child entity to its parent."}],"topicSections":[{"identifiers":["doc:\/\/WorldModule\/documentation\/WorldModule\/ChildOf\/init()","doc:\/\/WorldModule\/documentation\/WorldModule\/ChildOf\/init(from:)"],"title":"Initializers","generated":true,"anchor":"Initializers"},{"identifiers":["doc:\/\/WorldModule\/documentation\/WorldModule\/ChildOf\/isExclusive","doc:\/\/WorldModule\/documentation\/WorldModule\/ChildOf\/onTargetDespawn"],"title":"Type Properties","generated":true,"anchor":"Type-Properties"},{"identifiers":["doc:\/\/WorldModule\/documentation\/WorldModule\/ChildOf\/Equatable-Implementations","doc:\/\/WorldModule\/documentation\/WorldModule\/ChildOf\/Relation-Implementations"],"title":"Default Implementations","generated":true,"anchor":"Default-Implementations"}],"relationshipsSections":[{"kind"