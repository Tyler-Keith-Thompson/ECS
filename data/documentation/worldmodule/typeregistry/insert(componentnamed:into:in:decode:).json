xt":"The entity to insert the component into."}]}],"name":"entity"},{"content":[{"type":"paragraph","inlineContent":[{"text":"The world the entity is in.","type":"text"}]}],"name":"world"},{"content":[{"inlineContent":[{"text":"A closure that decodes a value of the type it is passed.","type":"text"}],"type":"paragraph"}],"name":"decode"}]},{"kind":"mentions","mentions":["doc:\/\/WorldModule\/documentation\/WorldModule\/SavingAndLoadingWorlds"]},{"kind":"content","content":[{"anchor":"discussion","type":"heading","text":"Discussion","level":2},{"type":"paragraph","inlineContent":[{"type":"text","text":"The registry calls "},{"type":"codeVoice","code":"decode"},{"type":"text","text":" with the registered type; decode a value of that type from"},{"type":"text","text":" "},{"type":"text","text":"your data with any decoder. The following example sets a ship’s position from JSON:"}]},{"code":["import Foundation","","var registry = TypeRegistry()","try registry.register(Position.self, named: \"Position\")","","var world = World()","let ship = world.spawn()","let data = Data(#\"{\"x\": 5, \"y\": 6}\"#.utf8)","","try registry.insert(componentNamed: \"Position\", into: ship, in: &world) { type in","    try JSONDecoder().decode(type, from: data)","}","print(world[Position.self, of: ship])","\/\/ Prints \"Position(x: 5.0, y: 6.0)\""],"type":"codeListing","syntax":"swift"},{"type":"paragraph","inlineContent":[{"text":"Inside your own ","type":"text"},{"code":"init(from:)","type":"codeVoice"},{"text":", decode with ","type":"text"},{"code":"{ type in try type.init(from: decoder) }","type":"codeVoice"},{"text":". The","type":"text"},{"text":" ","type":"text"},{"text":"component is inserted as ","type":"text"},{"code":"insert(_:into:)","type":"codeVoice"},{"text":" inserts it, running hooks and adding the","type":"text"},{"text":" ","type":"text"},{"text":"components it requires.","type":"text"}]},{"name":"Throws","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Any error "},{"type":"codeVoice","code":"decode"},{"type":"text","text":" throws. The world is then unchanged."}]}],"type":"aside","style":"note"},{"name":"Precondition","content":[{"inlineContent":[{"type":"text","text":"A component type is registered under "},{"type":"codeVoice","code":"name"},{"type":"text","text":", "},{"type":"codeVoice","code":"entity"},{"type":"text","text":" is live, and"},{"type":"text","text":" "},{"type":"codeVoice","code":"decode"},{"type":"text","text":" returns a value of the type it is passed. The checked spelling,"},{"type":"text","text":" "},{"identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/TypeRegistry\/insert(componentNamed:checkedInto:in:decode:)","type":"reference","isActive":true},{"type":"text","text":", throws for the first two instead."}],"type":"paragraph"}],"type":"aside","style":"note"},{"name":"Complexity","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"O("},{"type":"emphasis","inlineContent":[{"type":"text","text":"t"}]},{"type":"text","text":") plus the cost of decoding, where "},{"type":"emphasis","inlineContent":[{"type":"text","text":"t"}]},{"type":"text","text":" is the number of registered"},{"type":"text","text":" "},{"type":"text","text":"component types."}]}],"type":"aside","style":"note"}]}],"schemaVersion":{"minor":3,"patch":0,"major":0},"references":{"doc://WorldModule/documentation/WorldModule/TypeRegistry":{"abstract":[{"type":"text","text":"A list of the component and resource types that a scene saves, each under a name that"},{"type":"text","text":" "},{"type":"text","text":"identifies it in saved data."}],"kind":"symbol","url":"\/documentation\/worldmodule\/typeregistry","role":"symbol","navigatorTitle":[{"text":"TypeRegistry","kind":"identifier"}],"identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/TypeRegistry","type":"topic","title":"TypeRegistry","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"TypeRegistry","kind"