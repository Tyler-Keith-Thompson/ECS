A component type is registered under "},{"type":"codeVoice","code":"name"},{"type":"text","text":", "},{"type":"codeVoice","code":"entity"},{"type":"text","text":" is live, and"},{"type":"text","text":" "},{"type":"codeVoice","code":"decode"},{"type":"text","text":" returns a value of the type it is passed. The checked spelling,"},{"type":"text","text":" "},{"isActive":true,"type":"reference","identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/TypeRegistry\/insert(componentNamed:checkedInto:in:decode:)"},{"type":"text","text":", throws for the first two instead."}],"type":"paragraph"}],"name":"Precondition","type":"aside","style":"note"},{"content":[{"inlineContent":[{"text":"O(","type":"text"},{"inlineContent":[{"text":"t","type":"text"}],"type":"emphasis"},{"text":") plus the cost of decoding, where ","type":"text"},{"inlineContent":[{"text":"t","type":"text"}],"type":"emphasis"},{"text":" is the number of registered","type":"text"},{"text":" ","type":"text"},{"text":"component types.","type":"text"}],"type":"paragraph"}],"name":"Complexity","type":"aside","style":"note"}],"kind":"content"}],"schemaVersion":{"patch":0,"minor":3,"major":0},"sections":[],"hierarchy":{"paths":[["doc:\/\/WorldModule\/documentation\/WorldModule","doc:\/\/WorldModule\/documentation\/WorldModule\/TypeRegistry"]]},"identifier":{"url":"doc:\/\/WorldModule\/documentation\/WorldModule\/TypeRegistry\/insert(componentNamed:into:in:decode:)","interfaceLanguage":"swift"},"abstract":[{"type":"text","text":"Decodes a component of the type registered under a name and inserts it into an entity."}],"kind":"symbol","variants":[{"paths":["\/documentation\/worldmodule\/typeregistry\/insert(componentnamed:into:in:decode:)"],"traits":[{"interfaceLanguage":"swift"}]}],"metadata":{"symbolKind":"method","modules":[{"name":"WorldModule"}],"title":"insert(componentNamed:into:in:decode:)","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"insert","kind":"identifier"},{"