ragraph","inlineContent":[{"text":"Any error ","type":"text"},{"code":"decode","type":"codeVoice"},{"text":" throws. The world is then unchanged.","type":"text"}]}],"type":"aside"},{"style":"note","name":"Precondition","content":[{"type":"paragraph","inlineContent":[{"text":"A component type is registered under ","type":"text"},{"code":"name","type":"codeVoice"},{"text":", ","type":"text"},{"code":"entity","type":"codeVoice"},{"text":" is live, and","type":"text"},{"text":" ","type":"text"},{"code":"decode","type":"codeVoice"},{"text":" returns a value of the type it is passed. The checked spelling,","type":"text"},{"text":" ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/TypeRegistry\/insert(componentNamed:checkedInto:in:decode:)"},{"text":", throws for the first two instead.","type":"text"}]}],"type":"aside"},{"style":"note","name":"Complexity","content":[{"inlineContent":[{"type":"text","text":"O("},{"type":"emphasis","inlineContent":[{"type":"text","text":"t"}]},{"type":"text","text":") plus the cost of decoding, where "},{"type":"emphasis","inlineContent":[{"type":"text","text":"t"}]},{"type":"text","text":" is the number of registered"},{"type":"text","text":" "},{"type":"text","text":"component types."}],"type":"paragraph"}],"type":"aside"}],"kind":"content"}],"references":{"doc://WorldModule/documentation/WorldModule/Entity":{"role":"symbol","navigatorTitle":[{"text":"Entity","kind":"identifier"}],"title":"Entity","kind":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Entity","kind":"identifier"}],"type":"topic","identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/Entity","url":"\/documentation\/worldmodule\/entity","abstract":[{"type":"text","text":"A handle that identifies one entity in a world."}]},"doc://WorldModule/documentation/WorldModule/SavingAndLoadingWorlds":{"url":"\/documentation\/worldmodule\/savingandloadingworlds","kind":