t":"The world the entity is in.","type":"text"}],"type":"paragraph"}],"name":"world"},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"A closure that decodes a value of the type it is passed."}]}],"name":"decode"}]},{"kind":"mentions","mentions":["doc:\/\/WorldModule\/documentation\/WorldModule\/SavingAndLoadingWorlds"]},{"content":[{"text":"Discussion","anchor":"discussion","type":"heading","level":2},{"inlineContent":[{"text":"The registry calls ","type":"text"},{"code":"decode","type":"codeVoice"},{"text":" with the registered type; decode a value of that type from","type":"text"},{"text":" ","type":"text"},{"text":"your data with any decoder. The following example sets a ship’s position from JSON:","type":"text"}],"type":"paragraph"},{"syntax":"swift","code":["import Foundation","","var registry = TypeRegistry()","try registry.register(Position.self, named: \"Position\")","","var world = World()","let ship = world.spawn()","let data = Data(#\"{\"x\": 5, \"y\": 6}\"#.utf8)","","try registry.insert(componentNamed: \"Position\", into: ship, in: &world) { type in","    try JSONDecoder().decode(type, from: data)","}","print(world[Position.self, of: ship])","\/\/ Prints \"Position(x: 5.0, y: 6.0)\""],"type":"codeListing"},{"inlineContent":[{"type":"text","text":"Inside your own "},{"type":"codeVoice","code":"init(from:)"},{"type":"text","text":", decode with "},{"type":"codeVoice","code":"{ type in try type.init(from: decoder) }"},{"type":"text","text":". The"},{"type":"text","text":" "},{"type":"text","text":"component is inserted as "},{"type":"codeVoice","code":"insert(_:into:)"},{"type":"text","text":" inserts it, running hooks and adding the"},{"type":"text","text":" "},{"type":"text","text":"components it requires."}],"type":"paragraph"},{"content":[{"type":"paragraph","inlineContent":[{"text":"Any error ","type":"text"},{"type":"codeVoice","code":"decode"},{"text":" throws. The world is then unchanged.","type":"text"}]}],"style":"note","name":"Throws","type":"aside"},{"content":[{"inlineContent":[{"text":"A component type is registered under ","type":"text"},{"type":"codeVoice","code":"name"},{"text":", ","type":"text"},{"type":"codeVoice","code":"entity"},{"text":" is live, and","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"decode"},{"text":" returns a value of the type it is passed. The checked spelling,","type":"text"},{"text":" ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/TypeRegistry\/insert(componentNamed:checkedInto:in:decode:)"},{"text":", throws for the first two instead.","type":"text"}],"type":"paragraph"}],"style":"note","name":"Precondition","type":"aside"},{"content":[{"type":"paragraph","inlineContent":[{"text":"O(","type":"text"},{"inlineContent":[{"type":"text","text":"t"}],"type":"emphasis"},{"text":") plus the cost of decoding, where ","type":"text"},{"inlineContent":[{"type":"text","text":"t"}],"type":"emphasis"},{"text":" is the number of registered","type":"text"},{"text":" ","type":"text"},{"text":"component types.","type":"text"}]}],"style":"note","name":"Complexity","type":"aside"}],"kind":"content"}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/worldmodule\/typeregistry\/insert(componentnamed:into:in:decode:)"]}],"references":{"doc://WorldModule/documentation/WorldModule/Entity":{"type":"topic","navigatorTitle":[{"kind":"identifier","text":"Entity"}],"url":"\/documentation\/worldmodule\/entity","title":"Entity","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"Entity"}],"identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/Entity","kind":"symbol","role":"symbol","abstract":[{"type":"text","text":"A handle that identifies one entity in a world."}]},"doc://WorldModule/documentation/WorldModule/SavingAndLoadingWorlds":{"abstract":[{"type":"text","text":"Save a world’s entities and compo