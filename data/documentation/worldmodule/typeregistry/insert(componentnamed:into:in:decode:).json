dModule\/documentation\/WorldModule\/TypeRegistry"]]},"sections":[],"kind":"symbol","primaryContentSections":[{"declarations":[{"platforms":["Linux"],"tokens":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"insert","kind":"identifier"},{"text":"(","kind":"text"},{"text":"componentNamed","kind":"externalParam"},{"text":" ","kind":"text"},{"text":"name","kind":"internalParam"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:SS","text":"String","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"into","kind":"externalParam"},{"text":" ","kind":"text"},{"text":"entity","kind":"internalParam"},{"text":": ","kind":"text"},{"identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/Entity","preciseIdentifier":"s:11WorldModule6EntityV","text":"Entity","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"in","kind":"externalParam"},{"text":" ","kind":"text"},{"text":"world","kind":"internalParam"},{"text":": ","kind":"text"},{"text":"inout","kind":"keyword"},{"text":" ","kind":"text"},{"identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/World","preciseIdentifier":"s:11WorldModule0A0V","text":"World","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"decode","kind":"externalParam"},{"text":": (any ","kind":"text"},{"preciseIdentifier":"s:Se","text":"Decodable","kind":"typeIdentifier"},{"text":".Type) ","kind":"text"},{"text":"throws","kind":"keyword"},{"text":" -> any ","kind":"text"},{"preciseIdentifier":"s:Se","text":"Decodable","kind":"typeIdentifier"},{"text":") ","kind":"text"},{"text":"rethrows","kind":"keyword"}],"languages":["swift"]}],"kind":"declarations"},{"parameters":[{"name":"name","content":[{"type":"paragraph","inlineContent":[{"text":"The name the component type is registered under.","type":"text"}]}]},{"name":"entity","content":[{"inlineContent":[{"type":"text","text":"The entity to insert the component into."}],"type":"paragraph"}]},{"name":"world","content":[{"inlineContent":[{"text":"The world the entity is in.","type":"text"}],"type":"paragraph"}]},{"name":"decode","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"A closure that decodes a value of the type it is passed."}]}]}],"kind":"parameters"},{"kind":"mentions","mentions":["doc:\/\/WorldModule\/documentation\/WorldModule\/SavingAndLoadingWorlds"]},{"kind":"content","content":[{"text":"Discussion","anchor":"discussion","level":2,"type":"heading"},{"inlineContent":[{"text":"The registry calls ","type":"text"},{"code":"decode","type":"codeVoice"},{"text":" with the registered type; decode a value of that type from","type":"text"},{"text":" ","type":"text"},{"text":"your data with any decoder. The following example sets a ship’s position from JSON:","type":"text"}],"type":"paragraph"},{"code":["import Foundation","","var registry = TypeRegistry()","try registry.register(Position.self, named: \"Position\")","","var world = World()","let ship = world.spawn()","let data = Data(#\"{\"x\": 5, \"y\": 6}\"#.utf8)","","try registry.insert(componentNamed: \"Position\", into: ship, in: &world) { type in","    try JSONDecoder().decode(type, from: data)","}","print(world[Position.self, of: ship])","\/\/ Prints \"Position(x: 5.0, y: 6.0)\""],"syntax":"swift","type":"codeListing"},{"inlineContent":[{"type":"text","text":"Inside your own "},{"code":"init(from:)","type":"codeVoice"},{"type":"text","text":", decode with "},{"code":"{ type in try type.init(from: decoder) }","type":"codeVoice"},{"type":"text","text":". The"},{"type":"text","text":" "},{"type":"text","text":"component is inserted as "},{"code":"insert(_:into:)","type":"codeVoice"},{"type":"text","text":" inserts it, running hooks and adding the"},{"type":"text","text":" "},{"type":"text","text":"components it requires."}],"type":"paragraph"},{"style":"note","name":"Throws","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Any error "},{"code":"decode","type":"codeVoice"},{"type":"text","text":" throws. The world is then unchanged."}]}],"type":"aside"},{"style":"note","name":"Precondition","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"A component type is registered under "},{"code":"name","type":"codeVoice"},{"type":"text","text":", "},{"code":"entity","type":"codeVoice"},{"type":"text","text":" is live, and"},{"type":"text","text":" "},{"code":"decode","type":"codeVoice"},{"type":"text","text":" returns a value of the type it is passed. The checked spelling,"},{"type":"text","text":" "},{"isActive":true,"type":"reference","identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/TypeRegistry\/insert(componentNamed:checkedInto:in:decode:)"},{"type":"text","text":", throws for the first two instead."}]}],"type":"aside"},{"style":"note","name":"Complexity","content":[{"type":"paragraph","inlineContent":[{"text":"O(","type":"text"},{"type":"emphasis","inlineContent":[{"type":"text","text":"t"}]},{"text":") plus the cost of decoding, where ","type":"text"},{"type":"emphasis","inlineContent":[{"type":"text","text":"t"}]},{"text":" is the number of registered","type":"text"},{"text":" ","type":"text"},{"text":"component types.","type":"text"}]}],"type":"aside"}]}],"variants":[{"paths":["\/documentation\/worldmodule\/typeregistry\/insert(componentnamed:into:in:decode:)"],"traits":[{"interfaceLanguage":"swift"}]}],"references":{"doc://WorldModule/documentation/WorldModule/TypeRegistry":{"kind":"symbol","role":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"TypeRegistry","kind":"identifier"}],"type":"topic","abstract":[{"text":"A list of the component and resource types that a scene saves, each under a name that","type":"text"},{"text":" ","type":"text"},{"text":"identifies it in saved data.","type":"text"}],"navigatorTitle":[{"text":"TypeRegistry","kind":"identifier"}],"url":"\/documentation\/worldmodule\/typeregistry","title":"TypeRegistry","identifier":"doc:\/\/WorldModule\/documentation\/WorldModule