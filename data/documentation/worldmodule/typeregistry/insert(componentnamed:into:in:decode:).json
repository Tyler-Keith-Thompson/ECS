pe":"text","text":"A component type is registered under "},{"type":"codeVoice","code":"name"},{"type":"text","text":", "},{"type":"codeVoice","code":"entity"},{"type":"text","text":" is live, and"},{"type":"text","text":" "},{"type":"codeVoice","code":"decode"},{"type":"text","text":" returns a value of the type it is passed. The checked spelling,"},{"type":"text","text":" "},{"type":"reference","isActive":true,"identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/TypeRegistry\/insert(componentNamed:checkedInto:in:decode:)"},{"type":"text","text":", throws for the first two instead."}],"type":"paragraph"}],"type":"aside","style":"note","name":"Precondition"},{"content":[{"inlineContent":[{"type":"text","text":"O("},{"type":"emphasis","inlineContent":[{"text":"t","type":"text"}]},{"type":"text","text":") plus the cost of decoding, where "},{"type":"emphasis","inlineContent":[{"type":"text","text":"t"}]},{"type":"text","text":" is the number of registered"},{"type":"text","text":" "},{"type":"text","text":"component types."}],"type":"paragraph"}],"type":"aside","style":"note","name":"Complexity"}],"kind":"content"}],"schemaVersion":{"patch":0,"minor":3,"major":0},"variants":[{"paths":["\/documentation\/worldmodule\/typeregistry\/insert(componentnamed:into:in:decode:)"],"traits":[{"interfaceLanguage":"swift"}]}],"kind":"symbol","references":{"doc://WorldModule/documentation/WorldModule/World":{"navigatorTitle":[{"text":"World","kind":"identifier"}],"title":"World","type":"topic","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"World","kind":"identifier"}],"kind":"symbol","role":"symbol","identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/World","abstract":[{"text":"A collection of entities, the components they hold, and resources.","type":"text"}],"url":"\/documentation\/worldmodule\/world"},"doc://WorldModule/documentation/WorldModule/Entity":{"role":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"kind"