{"metadata":{"roleHeading":"Structure","modules":[{"name":"WorldModule"}],"externalID":"s:11WorldModule8QueryRowV","symbolKind":"struct","navigatorTitle":[{"text":"QueryRow","kind":"identifier"}],"remoteSource":{"url":"https:\/\/github.com\/Tyler-Keith-Thompson\/ECS\/blob\/main\/Sources\/WorldModule\/QueryView.swift#L20","fileName":"QueryView.swift"},"role":"symbol","title":"QueryRow","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"QueryRow","kind":"identifier"}]},"kind":"symbol","schemaVersion":{"major":0,"patch":0,"minor":3},"identifier":{"url":"doc:\/\/WorldModule\/documentation\/WorldModule\/QueryRow","interfaceLanguage":"swift"},"seeAlsoSections":[{"generated":true,"anchor":"Querying-and-Updating-Entities","title":"Querying and Updating Entities","identifiers":["doc:\/\/WorldModule\/documentation\/WorldModule\/QueryingAWorld","doc:\/\/WorldModule\/documentation\/WorldModule\/Query","doc:\/\/WorldModule\/documentation\/WorldModule\/QueryView","doc:\/\/WorldModule\/documentation\/WorldModule\/EntityQueryView","doc:\/\/WorldModule\/documentation\/WorldModule\/QueryTerm","doc:\/\/WorldModule\/documentation\/WorldModule\/AnyOf","doc:\/\/WorldModule\/documentation\/WorldModule\/EntitiesView"]}],"primaryContentSections":[{"kind":"declarations","declarations":[{"platforms":["Linux"],"tokens":[{"text":"@frozen","kind":"attribute"},{"text":" ","kind":"text"},{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"QueryRow","kind":"identifier"},{"kind":"text","text":"<each "},{"kind":"genericParameter","text":"C"},{"kind":"text","text":">"}],"languages":["swift"]}]},{"kind":"mentions","mentions":["doc:\/\/WorldModule\/documentation\/WorldModule\/QueryingAWorld"]},{"kind":"content","content":[{"level":2,"anchor":"overview","text":"Overview","type":"heading"},{"inlineContent":[{"type":"text","text":"An update’s closure receives the components it writes as "},{"type":"codeVoice","code":"inout"},{"type":"text","text":" arguments and everything else"},{"type":"text","text":" "},{"type":"text","text":"it reads in a row. The row’s "},{"isActive":true,"type":"reference","identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/QueryRow\/components"},{"type":"text","text":" hold the read values in the order the update lists"},{"type":"text","text":" "},{"type":"text","text":"them. An update that reads one type holds that type’s value itself, not a one-element tuple, and"},{"type":"text","text":" "},{"type":"text","text":"an update that reads nothing holds "},{"type":"codeVoice","code":"()"},{"type":"text","text":". An "},{"isActive":true,"type":"reference","identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/AnyOf"},{"type":"text","text":" term’s value is a tuple of optionals."}],"type":"paragraph"},{"code":["var world = World()","let comet = world.spawn(Position(x: 0, y: 0), Velocity(dx: 1, dy: 2), Health(current: 3))","","world.update(Position.self, reading: Velocity.self, Health.self) { position, row in","    let (velocity, health) = row.components","    position.x += velocity.dx * Double(health.current)","}","print(world[Position.self, of: comet])","\/\/ Prints \"Position(x: 3.0, y: 0.0)\""],"syntax":"swift","type":"codeListing"}]}],"sections":[],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/worldmodule\/queryrow"]}],"topicSections":[{"generated":true,"anchor":"Initializers","title":"Initializers","identifiers":["doc:\/\/WorldModule\/documentation\/WorldModule\/QueryRow\/init(entity:components:)"]},{"generated":true,"anchor":"Instance-Properties","title":"Instance Properties","identifiers":["doc:\/\/WorldModule\/documentation\/WorldModule\/QueryRow\/components","doc:\/\/WorldModule\/documentation\/WorldModule\/QueryRow\/entity"]}],"abstract":[{"text":"An entity an update visits, with the components the update reads from it.","type":"text"}],"hierarchy":{"paths":[["doc:\/\/WorldModule\/documentation\/WorldModule"]]},"relationshipsSections"