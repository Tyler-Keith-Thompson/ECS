{"kind":"symbol","sections":[],"schemaVersion":{"patch":0,"minor":3,"major":0},"topicSections":[{"anchor":"Initializers","title":"Initializers","generated":true,"identifiers":["doc:\/\/WorldModule\/documentation\/WorldModule\/QueryRow\/init(entity:components:)"]},{"anchor":"Instance-Properties","title":"Instance Properties","generated":true,"identifiers":["doc:\/\/WorldModule\/documentation\/WorldModule\/QueryRow\/components","doc:\/\/WorldModule\/documentation\/WorldModule\/QueryRow\/entity"]}],"relationshipsSections":[{"kind":"relationships","title":"Conforms To","type":"conformsTo","identifiers":["doc:\/\/WorldModule\/s8SendableP","doc:\/\/WorldModule\/s16SendableMetatypeP"]}],"hierarchy":{"paths":[["doc:\/\/WorldModule\/documentation\/WorldModule"]]},"seeAlsoSections":[{"anchor":"Querying-and-Updating-Entities","title":"Querying and Updating Entities","generated":true,"identifiers":["doc:\/\/WorldModule\/documentation\/WorldModule\/QueryingAWorld","doc:\/\/WorldModule\/documentation\/WorldModule\/Query","doc:\/\/WorldModule\/documentation\/WorldModule\/QueryView","doc:\/\/WorldModule\/documentation\/WorldModule\/EntityQueryView","doc:\/\/WorldModule\/documentation\/WorldModule\/QueryTerm","doc:\/\/WorldModule\/documentation\/WorldModule\/AnyOf","doc:\/\/WorldModule\/documentation\/WorldModule\/EntitiesView"]}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/worldmodule\/queryrow"]}],"primaryContentSections":[{"kind":"declarations","declarations":[{"tokens":[{"kind":"attribute","text":"@frozen"},{"kind":"text","text":" "},{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"QueryRow"},{"kind":"text","text":"<each "},{"kind":"genericParameter","text":"C"},{"kind":"text","text":">"}],"platforms":["Linux"],"languages":["swift"]}]},{"kind":"mentions","mentions":["doc:\/\/WorldModule\/documentation\/WorldModule\/QueryingAWorld"]},{"kind":"content","content":[{"type":"heading","level":2,"text":"Overview","anchor":"overview"},{"inlineContent":[{"type":"text","text":"An update’s closure receives the components it writes as "},{"type":"codeVoice","code":"inout"},{"type":"text","text":" arguments and everything else"},{"type":"text","text":" "},{"type":"text","text":"it reads in a row. The row’s "},{"type":"reference","identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/QueryRow\/components","isActive":true},{"type":"text","text":" hold the read values in the order the update lists"},{"type":"text","text":" "},{"type":"text","text":"them. An update that reads one type holds that type’s value itself, not a one-element tuple, and"},{"type":"text","text":" "},{"type":"text","text":"an update that reads nothing holds "},{"type":"codeVoice","code":"()"},{"type":"text","text":". An "},{"type":"reference","identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/AnyOf","isActive":true},{"type":"text","text":" term’s value is a tuple of optionals."}],"type":"paragraph"},{"syntax":"swift","type":"codeListing","code":["var world = World()","let comet = world.spawn(Position(x: 0, y: 0), Velocity(dx: 1, dy: 2), Health(current: 3))","","world.update(Position.self, reading: Velocity.self, Health.self) { position, row in","    let (velocity, health) = row.components","    position.x += velocity.dx * Double(health.current)","}","print(world[Position.self, of: comet])","\/\/ Prints \"Position(x: 3.0, y: 0.0)\""]}]}],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/WorldModule\/documentation\/WorldModule\/QueryRow"},"abstract":[{"type":"text","text":"An entity an update visits, with the components the update reads from it."}],"metadata":{"externalID":"s:11WorldModule8QueryRowV","modules":[{"name":"WorldModule"}],"symbolKind":"struct","role":"symbol","remoteSource":{"url":"https:\/\/github.com\/Tyler-Keith-Thompson\/ECS\/blob\/main\/Sources\/WorldModule\/QueryView.swift#L20","fileName":"QueryView.swift"},"title":"QueryRow","fragments":[{"text":"struct","kind":