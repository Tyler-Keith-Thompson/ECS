content":[{"anchor":"overview","text":"Overview","type":"heading","level":2},{"type":"paragraph","inlineContent":[{"text":"An update’s closure receives the components it writes as ","type":"text"},{"type":"codeVoice","code":"inout"},{"text":" arguments and everything else","type":"text"},{"text":" ","type":"text"},{"text":"it reads in a row. The row’s ","type":"text"},{"identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/QueryRow\/components","type":"reference","isActive":true},{"text":" hold the read values in the order the update lists","type":"text"},{"text":" ","type":"text"},{"text":"them. An update that reads one type holds that type’s value itself, not a one-element tuple, and","type":"text"},{"text":" ","type":"text"},{"text":"an update that reads nothing holds ","type":"text"},{"type":"codeVoice","code":"()"},{"text":". An ","type":"text"},{"identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/AnyOf","type":"reference","isActive":true},{"text":" term’s value is a tuple of optionals.","type":"text"}]},{"syntax":"swift","type":"codeListing","code":["var world = World()","let comet = world.spawn(Position(x: 0, y: 0), Velocity(dx: 1, dy: 2), Health(current: 3))","","world.update(Position.self, reading: Velocity.self, Health.self) { position, row in","    let (velocity, health) = row.components","    position.x += velocity.dx * Double(health.current)","}","print(world[Position.self, of: comet])","\/\/ Prints \"Position(x: 3.0, y: 0.0)\""]}],"kind":"content"}],"schemaVersion":{"minor":3,"patch":0,"major":0},"topicSections":[{"title":"Initializers","identifiers":["doc:\/\/WorldModule\/documentation\/WorldModule\/QueryRow\/init(entity:components:)"],"generated":true,"anchor":"Initializers"},{"title":"Instance Properties","identifiers":["doc:\/\/WorldModule\/documentation\/WorldModule\/QueryRow\/components","doc:\/\/WorldModule\/documentation\/WorldModule\/QueryRow\/entity"],"generated":true,"anchor":"Instance-Properties"}],"relationshipsSections"