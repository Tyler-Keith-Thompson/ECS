. An "},{"type":"reference","isActive":true,"identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/AnyOf"},{"type":"text","text":" term’s value is a tuple of optionals."}]},{"type":"codeListing","syntax":"swift","code":["var world = World()","let comet = world.spawn(Position(x: 0, y: 0), Velocity(dx: 1, dy: 2), Health(current: 3))","","world.update(Position.self, reading: Velocity.self, Health.self) { position, row in","    let (velocity, health) = row.components","    position.x += velocity.dx * Double(health.current)","}","print(world[Position.self, of: comet])","\/\/ Prints \"Position(x: 3.0, y: 0.0)\""]}]}],"sections":[],"variants":[{"paths":["\/documentation\/worldmodule\/queryrow"],"traits":[{"interfaceLanguage":"swift"}]}],"schemaVersion":{"major":0,"minor":3,"patch":0},"abstract":[{"type":"text","text":"An entity an update visits, with the components the update reads from it."}],"topicSections":[{"identifiers":["doc:\/\/WorldModule\/documentation\/WorldModule\/QueryRow\/init(entity:components:)"],"generated":true,"anchor":"Initializers","title":"Initializers"},{"identifiers":["doc:\/\/WorldModule\/documentation\/WorldModule\/QueryRow\/components","doc:\/\/WorldModule\/documentation\/WorldModule\/QueryRow\/entity"],"generated":true,"anchor":"Instance-Properties","title":"Instance Properties"}],"relationshipsSections":[{"kind":"relationships","identifiers":["doc:\/\/WorldModule\/s8SendableP","doc:\/\/WorldModule\/s16SendableMetatypeP"],"type":"conformsTo","title":"Conforms To"}],"seeAlsoSections":[{"identifiers":["doc:\/\/WorldModule\/documentation\/WorldModule\/QueryingAWorld","doc:\/\/WorldModule\/documentation\/WorldModule\/Query","doc:\/\/WorldModule\/documentation\/WorldModule\/QueryView","doc:\/\/WorldModule\/documentation\/WorldModule\/EntityQueryView","doc:\/\/WorldModule\/documentation\/WorldModule\/QueryTerm","doc:\/\/WorldModule\/documentation\/WorldModule\/AnyOf","doc:\/\/WorldModule\/documentation\/WorldModule\/EntitiesView"],"generated":t