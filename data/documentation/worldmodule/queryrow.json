{"primaryContentSections":[{"kind":"declarations","declarations":[{"platforms":["Linux"],"tokens":[{"kind":"attribute","text":"@frozen"},{"kind":"text","text":" "},{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"QueryRow"},{"kind":"text","text":"<each "},{"kind":"genericParameter","text":"C"},{"kind":"text","text":">"}],"languages":["swift"]}]},{"kind":"mentions","mentions":["doc:\/\/WorldModule\/documentation\/WorldModule\/QueryingAWorld"]},{"kind":"content","content":[{"text":"Overview","anchor":"overview","type":"heading","level":2},{"type":"paragraph","inlineContent":[{"text":"An update’s closure receives the components it writes as ","type":"text"},{"code":"inout","type":"codeVoice"},{"text":" arguments and everything else","type":"text"},{"text":" ","type":"text"},{"text":"it reads in a row. The row’s ","type":"text"},{"identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/QueryRow\/components","type":"reference","isActive":true},{"text":" hold the read values in the order the update lists","type":"text"},{"text":" ","type":"text"},{"text":"them. An update that reads one type holds that type’s value itself, not a one-element tuple, and","type":"text"},{"text":" ","type":"text"},{"text":"an update that reads nothing holds ","type":"text"},{"code":"()","type":"codeVoice"},{"text":". An ","type":"text"},{"identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/AnyOf","type":"reference","isActive":true},{"text":" term’s value is a tuple of optionals.","type":"text"}]},{"code":["var world = World()","let comet = world.spawn(Position(x: 0, y: 0), Velocity(dx: 1, dy: 2), Health(current: 3))","","world.update(Position.self, reading: Velocity.self, Health.self) { position, row in","    let (velocity, health) = row.components","    position.x += velocity.dx * Double(health.current)","}","print(world[Position.self, of: comet])","\/\/ Prints \"Position(x: 3.0, y: 0.0)\""],"type":"codeListing","syntax":"swift"}]}],"v