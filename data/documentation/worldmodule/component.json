its conformance. There are no requirements to implement:","type":"text"}],"type":"paragraph"},{"code":["struct Lifetime: Component { var remaining: Double }","","var world = World()","let spark = world.spawn(Position(x: 0, y: 0), Lifetime(remaining: 0.5))","","world[Lifetime.self, of: spark].remaining -= 0.25","print(world[Lifetime.self, of: spark].remaining)","\/\/ Prints \"0.25\""],"syntax":"swift","type":"codeListing"},{"inlineContent":[{"type":"text","text":"Every component is a "},{"type":"reference","identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/Bundle","isActive":true},{"type":"text","text":" of itself, so you can pass one anywhere a bundle is expected,"},{"type":"text","text":" "},{"type":"text","text":"and a "},{"type":"reference","identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/QueryTerm","isActive":true},{"type":"text","text":" that matches the entities holding it."}],"type":"paragraph"},{"anchor":"Requiring-Other-Components","type":"heading","level":3,"text":"Requiring Other Components"},{"inlineContent":[{"text":"A component can require others. Spawning an entity with the component, or inserting the","type":"text"},{"text":" ","type":"text"},{"text":"component into an entity, also inserts each required component the entity doesn’t hold, and","type":"text"},{"text":" ","type":"text"},{"text":"whatever those components require in turn. List the required components in ","type":"text"},{"identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/Component\/required-u15k","isActive":true,"type":"reference"},{"text":":","type":"text"}],"type":"paragraph"},{"code":["struct Player: Component {","    static var required: some Bundle {","        Position(x: 0, y: 0)","        Health(current: 100)","    }","}","","var world = World()","let player = world.spawn(Player(), Health(current: 50))","","print(world[Position.self, of: player])","\/\/ Prints \"Position(x: 0.0, y: 0.0)\"","print(world[Health.self, of: player].current)","\/\/ Prints \"50\""],"syntax":"swift","type":"codeListing"},{"inlineContent":[{"text":"A component given explicitly, like the health in the example above, is kept: required","type":"text"},{"text":" ","type":"text"},{"text":"components fill in only the types the entity doesn’t already hold.","type":"text"}],"type":"paragraph"}]}],"sections":[],"abstract":[{"text":"A type that can be stored as a component of an entity.","type":"text"}],"metadata":{"title":"Component","roleHeading":"Protocol","navigatorTitle":[{"text":"Component","kind":"identifier"}],"externalID":"s:11WorldModule9ComponentP","fragments":[{"kind":"keyword","text":"protocol"},{"kind":"text","text":" "},{"text":"Component","kind":"identifier"}],"remoteSource":{"url":"https:\/\/github.com\/Tyler-Keith-Thompson\/ECS\/blob\/main\/Sources\/WorldModule\/Component.swift#L48","fileName":"Component.swift"},"role":"symbol","modules":[{"name":"WorldModule"}],"symbolKind":"protocol"},"topicSections":[{"title":"Associated Types","generated":true,"anchor":"Associated-Types","identifiers":["doc:\/\/WorldModule\/documentation\/WorldModule\/Component\/Required-swift.associatedtype"]},{"title":"Type Properties","generated":true,"anchor":"Type-Properties","identifiers":["doc:\/\/WorldModule\/documentation\/WorldModule\/Component\/required-u15k"]}],"variants":[{"paths":["\/documentation\/worldmodule\/component"],"traits":[{"interfaceLanguage":"swift"}]}],"schemaVersion":{"patch":0,"major":0,"minor":3},"relationshipsSections":[{"title":"Inherits From","kind":"relationships","type":"inheritsFrom","identifiers":["doc:\/\/WorldModule\/documentation\/WorldModule\/Bundle","doc:\/\/WorldModule\/documentation\/WorldModule\/QueryTerm","doc:\/\/WorldModule\/s8SendableP","doc:\/\/WorldModule\/s16SendableMetatypeP"]},{"title":"Conforming Types","kind":"relationships","type":"conformingTypes","identifiers":["doc:\/\/WorldModule\/documentation\/WorldModule\/Disabled","doc:\/\/WorldModule\/documentation\/WorldModule\/Prefab","doc:\/\/WorldMo