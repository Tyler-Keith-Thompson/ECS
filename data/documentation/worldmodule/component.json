{"abstract":[{"text":"A type that can be stored as a component of an entity.","type":"text"}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/worldmodule\/component"]}],"identifier":{"url":"doc:\/\/WorldModule\/documentation\/WorldModule\/Component","interfaceLanguage":"swift"},"kind":"symbol","schemaVersion":{"minor":3,"major":0,"patch":0},"seeAlsoSections":[{"identifiers":["doc:\/\/WorldModule\/documentation\/WorldModule\/World","doc:\/\/WorldModule\/documentation\/WorldModule\/Entity","doc:\/\/WorldModule\/documentation\/WorldModule\/Resource"],"generated":true,"title":"Essentials","anchor":"Essentials"}],"topicSections":[{"identifiers":["doc:\/\/WorldModule\/documentation\/WorldModule\/Component\/Required-swift.associatedtype"],"generated":true,"title":"Associated Types","anchor":"Associated-Types"},{"identifiers":["doc:\/\/WorldModule\/documentation\/WorldModule\/Component\/required-u15k"],"generated":true,"title":"Type Properties","anchor":"Type-Properties"}],"hierarchy":{"paths":[["doc:\/\/WorldModule\/documentation\/WorldModule"]]},"sections":[],"primaryContentSections":[{"kind":"declarations","declarations":[{"languages":["swift"],"tokens":[{"kind":"keyword","text":"protocol"},{"kind":"text","text":" "},{"kind":"identifier","text":"Component"},{"kind":"text","text":" : "},{"kind":"typeIdentifier","text":"Bundle","identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/Bundle","preciseIdentifier":"s:11WorldModule6BundleP"},{"kind":"text","text":", "},{"kind":"typeIdentifier","text":"QueryTerm","identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/QueryTerm","preciseIdentifier":"s:11WorldModule9QueryTermP"},{"kind":"text","text":" "},{"kind":"keyword","text":"where"},{"kind":"text","text":" "},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":" == "},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":"."},{"kind":"typeIdentifier","text":"Value","identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/QueryTerm\/Value","preciseIdentifier":"s:11WorldModule9QueryTermP5ValueQa"},{"kind":"text","text":", "},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":"."},{"kind":"typeIdentifier","text":"Body","identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/Bundle\/Body-swift.associatedtype","preciseIdentifier":"s:11WorldModule6BundleP4BodyQa"},{"kind":"text","text":" == "},{"kind":"typeIdentifier","text":"Never","preciseIdentifier":"s:s5NeverO"}],"platforms":["Linux"]}]},{"kind":"content","content":[{"anchor":"overview","text":"Overview","type":"heading","level":2},{"inlineContent":[{"type":"text","text":"A component is one piece of an entity’s state, such as its position, its velocity or its"},{"type":"text","text":" "},{"type":"text","text":"health. Components are plain value types; the behavior that acts on them belongs to the code"},{"type":"text","text":" "},{"type":"text","text":"that queries and updates them. An entity holds at most one component of each type."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"To make a type a component, declare its conformance. There are no requirements to implement:"}],"type":"paragraph"},{"code":["struct Lifetime: Component { var remaining: Double }","","var world = World()","let spark = world.spawn(Position(x: 0, y: 0), Lifetime(remaining: 0.5))","","world[Lifetime.self, of: spark].remaining -= 0.25","print(world[Lifetime.self, of: spark].remaining)","\/\/ Prints \"0.25\""],"type":"codeListing","syntax":"swift"},{"inlineContent":[{"text":"Every component is a ","type":"text"},{"identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/Bundle","isActive":true,"type":"reference"},{"text":" of itself, so you can pass one anywhere a bundle is expected,","type":"text"},{"text":" ","type":"text"},{"text":"and a ","type":"text"},{"identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/QueryTerm","isActive":true,"type":"reference"},{"text":" that matches the entities holding it.","type":"text"}],"type":"paragraph"},{"anchor":"Requiring-Other-Components","text":"Requiring Other Components","type":"heading","level":3},{"inlineContent":[{"text":"A component can require others. Spawning an entity with the component, or inserting the","type":"text"},{"text":" ","type":"text"},{"text":"component into an entity, also inserts each required component the entity doesn’t hold, and","type":"text"},{"text":" ","type":"text"},{"text":"whatever those components require in turn. List the required components in ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/Component\/required-u15k"},{"text":":","type":"text"}],"type":"paragraph"},{"code":["struct Player: Component {","    static var required: some Bundle {","        Position(x: 0, y: 0)","        Health(current: 100)","    }","}","","var world = World()","let player = world.spawn(Player(), Health(current: 50))","","print(world[Position.self, of: player])","\/\/ Prints \"Position(x: 0.0, y: 0.0)\"","print(world[Health.self, of: player].current)","\/\/ Prints \"50\""],"type":"codeListing","syntax":"swift"},{"inlineContent":[{"text":"A component given explicitly, like the health in the example above, is kept: required","type":"text"},{"text":" ","type":"text"},{"text":"components fill in only the types the entity doesn’t already hold.","type":"text"}],"type":"paragraph"}]}],"relationshipsSections":[{"kind":"relationships","identifiers":["doc:\/\/WorldModule\/documentation\/WorldModule\/Bundle","doc:\/\/WorldModule\/documentation\/WorldModule\/QueryTerm","doc:\/\/WorldModule\/s8SendableP","doc:\/\/WorldModule\/s16SendableMetatypeP"],"title":"Inherits From","type":"inheritsFrom"},{"kind":"relationships","identifiers":["doc:\/\/WorldModule\/documentation\/WorldModule\/Disabled","doc:\/\/WorldModule\/documentation\/WorldModule\/Prefab","doc:\/\/WorldModule\/documentation\/WorldModule\/Targets"],"title":"Conforming Types","type":"conformin