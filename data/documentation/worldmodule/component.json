{"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/WorldModule\/documentation\/WorldModule\/Component"},"sections":[],"abstract":[{"text":"A type that can be stored as a component of an entity.","type":"text"}],"seeAlsoSections":[{"generated":true,"title":"Essentials","identifiers":["doc:\/\/WorldModule\/documentation\/WorldModule\/World","doc:\/\/WorldModule\/documentation\/WorldModule\/Entity","doc:\/\/WorldModule\/documentation\/WorldModule\/Resource"],"anchor":"Essentials"}],"primaryContentSections":[{"declarations":[{"tokens":[{"text":"protocol","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Component","kind":"identifier"},{"text":" : ","kind":"text"},{"text":"Bundle","kind":"typeIdentifier","identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/Bundle","preciseIdentifier":"s:11WorldModule6BundleP"},{"text":", ","kind":"text"},{"text":"QueryTerm","kind":"typeIdentifier","identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/QueryTerm","preciseIdentifier":"s:11WorldModule9QueryTermP"},{"text":" ","kind":"text"},{"text":"where","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":" == ","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":".","kind":"text"},{"text":"Value","kind":"typeIdentifier","identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/QueryTerm\/Value","preciseIdentifier":"s:11WorldModule9QueryTermP5ValueQa"},{"text":", ","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":".","kind":"text"},{"text":"Body","kind":"typeIdentifier","identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/Bundle\/Body-swift.associatedtype","preciseIdentifier":"s:11WorldModule6BundleP4BodyQa"},{"text":" == ","kind":"text"},{"text":"Never","kind":"typeIdentifier","preciseIdentifier":"s:s5NeverO"}],"languages":["swift"],"platforms":["Linux"]}],"kind":"declarations"},{"content":[{"anchor":"overview","level":2,"text":"Overview","type":"heading"},{"inlineContent":[{"type":"text","text":"A component is one piece of an entity’s state, such as its position, its velocity or its"},{"type":"text","text":" "},{"type":"text","text":"health. Components are plain value types; the behavior that acts on them belongs to the code"},{"type":"text","text":" "},{"type":"text","text":"that queries and updates them. An entity holds at most one component of each type."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"To make a type a component, declare its conformance. There are no requirements to implement:"}],"type":"paragraph"},{"code":["struct Lifetime: Component { var remaining: Double }","","var world = World()","let spark = world.spawn(Position(x: 0, y: 0), Lifetime(remaining: 0.5))","","world[Lifetime.self, of: spark].remaining -= 0.25","print(world[Lifetime.self, of: spark].remaining)","\/\/ Prints \"0.25\""],"syntax":"swift","type":"codeListing"},{"inlineContent":[{"text":"Every component is a ","type":"text"},{"type":"reference","identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/Bundle","isActive":true},{"text":" of itself, so you can pass one anywhere a bundle is expected,","type":"text"},{"text":" ","type":"text"},{"text":"and a ","type":"text"},{"type":"reference","identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/QueryTerm","isActive":true},{"text":" that matches the entities holding it.","type":"text"}],"type":"paragraph"},{"anchor":"Requiring-Other-Components","level":3,"text":"Requiring Other Components","type":"heading"},{"inlineContent":[{"text":"A component can require others. Spawning an entity with the component, or inserting the","type":"text"},{"text":" ","type":"text"},{"text":"component into an entity, also inserts each required component the entity doesn’t hold, and","type":"text"},{"text":" ","type":"text"},{"text":"whatever those components require in turn. List the required components in ","type":"text"},{"identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/Component\/required-u15k","isActive":true,"type":"reference"},{"text":":","type":"text"}],"type":"paragraph"},{"code":["struct Player: Component {","    static var required: some Bundle {","        Position(x: 0, y: 0)","        Health(current: 100)","    }","}","","var world = World()","let player = world.spawn(Player(), Health(current: 50))","","print(world[Position.self, of: player])","\/\/ Prints \"Position(x: 0.0, y: 0.0)\"","print(world[Health.self, of: player].current)","\/\/ Prints \"50\""],"syntax":"swift","type":"codeListing"},{"inlineContent":[{"text":"A component given explicitly, like the health in the example above, is kept: required","type":"text"},{"text":" ","type":"text"},{"text":"components fill in only the types the entity doesn’t already hold.","type":"text"}],"type":"paragraph"}],"kind":"content"}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/worldmodule\/component"]}],"kind":"symbol","schemaVersion":{"major":0,"minor":3,"patch":0},"relationshipsSections":[{"title":"Inherits From","type":"inheritsFrom","identifiers":["doc:\/\/WorldModule\/documentation\/WorldModule\/Bundle","doc:\/\/WorldModule\/documentation\/WorldModule\/QueryTerm","doc:\/\/WorldModule\/s8SendableP","doc:\/\/WorldModule\/s16SendableMetatypeP"],"kind":"relationships"},{"title":"Conforming Types","type":"conformingTypes","identifiers":["doc:\/\/WorldModule\/documentation\/WorldModule\/Disabled","doc:\/\/WorldModule\/documentation\/WorldModule\/Prefab","doc:\/\/WorldModule\/documentation\/WorldModule\/Targets"],"kind":"relationships"}],"metadata":{"fragments":[{"text":"protocol","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Component","kind":"identifier"}],"modules":[{"name":"WorldModule"}],"role":"symbol","remoteSource":{"fileName":"Component.swift","url":"https:\/\/github.com\/Tyler-Keith-Thompson\/ECS\/blob\/main\/Sources\/WorldModule\/Component.swift#L48"},"title":"Component","roleHeading":"Protocol","externalID":"s:11WorldModule9ComponentP","nav