ost one component of each type."}]},{"type":"paragraph","inlineContent":[{"text":"To make a type a component, declare its conformance. There are no requirements to implement:","type":"text"}]},{"type":"codeListing","code":["struct Lifetime: Component { var remaining: Double }","","var world = World()","let spark = world.spawn(Position(x: 0, y: 0), Lifetime(remaining: 0.5))","","world[Lifetime.self, of: spark].remaining -= 0.25","print(world[Lifetime.self, of: spark].remaining)","\/\/ Prints \"0.25\""],"syntax":"swift"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Every component is a "},{"type":"reference","isActive":true,"identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/Bundle"},{"type":"text","text":" of itself, so you can pass one anywhere a bundle is expected,"},{"type":"text","text":" "},{"type":"text","text":"and a "},{"type":"reference","isActive":true,"identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/QueryTerm"},{"type":"text","text":" that matches the entities holding it."}]},{"anchor":"Requiring-Other-Components","level":3,"type":"heading","text":"Requiring Other Components"},{"type":"paragraph","inlineContent":[{"type":"text","text":"A component can require others. Spawning an entity with the component, or inserting the"},{"type":"text","text":" "},{"type":"text","text":"component into an entity, also inserts each required component the entity doesn’t hold, and"},{"type":"text","text":" "},{"type":"text","text":"whatever those components require in turn. List the required components in "},{"type":"reference","isActive":true,"identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/Component\/required-u15k"},{"type":"text","text":":"}]},{"type":"codeListing","code":["struct Player: Component {","    static var required: some Bundle {","        Position(x: 0, y: 0)","        Health(current: 100)","    }","}","","var world = World()","let player = world.spawn(Player(), Health(current: 50))","","print(world[Positi