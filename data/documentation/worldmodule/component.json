{"metadata":{"modules":[{"name":"WorldModule"}],"role":"symbol","fragments":[{"kind":"keyword","text":"protocol"},{"kind":"text","text":" "},{"text":"Component","kind":"identifier"}],"title":"Component","remoteSource":{"url":"https:\/\/github.com\/Tyler-Keith-Thompson\/ECS\/blob\/main\/Sources\/WorldModule\/Component.swift#L48","fileName":"Component.swift"},"roleHeading":"Protocol","externalID":"s:11WorldModule9ComponentP","navigatorTitle":[{"text":"Component","kind":"identifier"}],"symbolKind":"protocol"},"primaryContentSections":[{"declarations":[{"platforms":["Linux"],"languages":["swift"],"tokens":[{"kind":"keyword","text":"protocol"},{"kind":"text","text":" "},{"kind":"identifier","text":"Component"},{"kind":"text","text":" : "},{"kind":"typeIdentifier","identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/Bundle","preciseIdentifier":"s:11WorldModule6BundleP","text":"Bundle"},{"kind":"text","text":", "},{"kind":"typeIdentifier","identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/QueryTerm","preciseIdentifier":"s:11WorldModule9QueryTermP","text":"QueryTerm"},{"kind":"text","text":" "},{"kind":"keyword","text":"where"},{"kind":"text","text":" "},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":" == "},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":"."},{"kind":"typeIdentifier","identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/QueryTerm\/Value","preciseIdentifier":"s:11WorldModule9QueryTermP5ValueQa","text":"Value"},{"kind":"text","text":", "},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":"."},{"kind":"typeIdentifier","identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/Bundle\/Body-swift.associatedtype","preciseIdentifier":"s:11WorldModule6BundleP4BodyQa","text":"Body"},{"kind":"text","text":" == "},{"kind":"typeIdentifier","preciseIdentifier":"s:s5NeverO","text":"Never"}]}],"kind":"declarations"},{"kind":"content","content":[{"type":"heading","text":"Overview","anchor":"overview","level":2},{"type":"paragraph","inlineContent":[{"type":"text","text":"A component is one piece of an entity’s state, such as its position, its velocity or its"},{"type":"text","text":" "},{"type":"text","text":"health. Components are plain value types; the behavior that acts on them belongs to the code"},{"type":"text","text":" "},{"type":"text","text":"that queries and updates them. An entity holds at most one component of each type."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"To make a type a component, declare its conformance. There are no requirements to implement:"}]},{"type":"codeListing","syntax":"swift","code":["struct Lifetime: Component { var remaining: Double }","","var world = World()","let spark = world.spawn(Position(x: 0, y: 0), Lifetime(remaining: 0.5))","","world[Lifetime.self, of: spark].remaining -= 0.25","print(world[Lifetime.self, of: spark].remaining)","\/\/ Prints \"0.25\""]},{"type":"paragraph","inlineContent":[{"text":"Every component is a ","type":"text"},{"isActive":true,"identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/Bundle","type":"reference"},{"text":" of itself, so you can pass one anywhere a bundle is expected,","type":"text"},{"text":" ","type":"text"},{"text":"and a ","type":"text"},{"isActive":true,"identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/QueryTerm","type":"reference"},{"text":" that matches the entities holding it.","type":"text"}]},{"type":"heading","text":"Requiring Other Components","anchor":"Requiring-Other-Components","level":3},{"type":"paragraph","inlineContent":[{"text":"A component can require others. Spawning an entity with the component, or inserting the","type":"text"},{"text":" ","type":"text"},{"text":"component into an entity, also inserts each required component the entity doesn’t hold, and","type":"text"},{"text":" ","type":"text"},{"text":"whatever those components require in turn. List the required components in ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/Component\/required-u15k"},{"text":":","type":"text"}]},{"type":"codeListing","syntax":"swift","code":["struct Player: Component {","    static var required: some Bundle {","        Position(x: 0, y: 0)","        Health(current: 100)","    }","}","","var world = World()","let player = world.spawn(Player(), Health(current: 50))","","print(world[Position.self, of: player])","\/\/ Prints \"Position(x: 0.0, y: 0.0)\"","print(world[Health.self, of: player].current)","\/\/ Prints \"50\""]},{"type":"paragraph","inlineContent":[{"type":"text","text":"A component given explicitly, like the health in the example above, is kept: required"},{"type":"text","text":" "},{"type":"text","text":"components fill in only the types the entity doesn’t already hold."}]}]}],"schemaVersion":{"major":0,"minor":3,"patch":0},"variants":[{"paths":["\/documentation\/worldmodule\/component"],"traits":[{"interfaceLanguage":"swift"}]}],"identifier":{"url":"doc:\/\/WorldModule\/documentation\/WorldModule\/Component","interfaceLanguage":"swift"},"sections":[],"seeAlsoSections":[{"title":"Essentials","anchor":"Essentials","generated":true,"identifiers":["doc:\/\/WorldModule\/documentation\/WorldModule\/World","doc:\/\/WorldModule\/documentation\/WorldModule\/Entity","doc:\/\/WorldModule\/documentation\/WorldModule\/Resource"]}],"abstract":[{"type":"text","text":"A type that can be stored as a component of an entity."}],"relationshipsSections":[{"type":"inheritsFrom","identifiers":["doc:\/\/WorldModule\/documentation\/WorldModule\/Bundle","doc:\/\/WorldModule\/documentation\/WorldModule\/QueryTerm","doc:\/\/WorldModule\/s8SendableP","doc:\/\/WorldModule\/s16SendableMetatypeP"],"title":"Inherits From","kind":"relationships"},{"type":"conformingTypes","identifiers":["doc:\/\/WorldModule\/documentation\/WorldModule\/Disabled","doc:\/\/WorldModule\/documentation\/WorldModule\/Prefab","doc:\/\/WorldModule\/documentation\/WorldModul