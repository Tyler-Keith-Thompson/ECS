{"schemaVersion":{"minor":3,"major":0,"patch":0},"sections":[],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/WorldModule\/documentation\/WorldModule\/Component"},"hierarchy":{"paths":[["doc:\/\/WorldModule\/documentation\/WorldModule"]]},"seeAlsoSections":[{"identifiers":["doc:\/\/WorldModule\/documentation\/WorldModule\/World","doc:\/\/WorldModule\/documentation\/WorldModule\/Entity","doc:\/\/WorldModule\/documentation\/WorldModule\/Resource"],"generated":true,"anchor":"Essentials","title":"Essentials"}],"variants":[{"paths":["\/documentation\/worldmodule\/component"],"traits":[{"interfaceLanguage":"swift"}]}],"topicSections":[{"identifiers":["doc:\/\/WorldModule\/documentation\/WorldModule\/Component\/Required-swift.associatedtype"],"generated":true,"anchor":"Associated-Types","title":"Associated Types"},{"identifiers":["doc:\/\/WorldModule\/documentation\/WorldModule\/Component\/required-u15k"],"generated":true,"anchor":"Type-Properties","title":"Type Properties"}],"primaryContentSections":[{"kind":"declarations","declarations":[{"languages":["swift"],"tokens":[{"kind":"keyword","text":"protocol"},{"kind":"text","text":" "},{"kind":"identifier","text":"Component"},{"kind":"text","text":" : "},{"kind":"typeIdentifier","identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/Bundle","preciseIdentifier":"s:11WorldModule6BundleP","text":"Bundle"},{"kind":"text","text":", "},{"kind":"typeIdentifier","identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/QueryTerm","preciseIdentifier":"s:11WorldModule9QueryTermP","text":"QueryTerm"},{"kind":"text","text":" "},{"kind":"keyword","text":"where"},{"kind":"text","text":" "},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":" == "},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":"."},{"kind":"typeIdentifier","identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/QueryTerm\/Value","preciseIdentifier":"s:11WorldModule9QueryTermP5ValueQa","text":"Value"},{"kind":"text","text":", "},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":"."},{"kind":"typeIdentifier","identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/Bundle\/Body-swift.associatedtype","preciseIdentifier":"s:11WorldModule6BundleP4BodyQa","text":"Body"},{"kind":"text","text":" == "},{"kind":"typeIdentifier","preciseIdentifier":"s:s5NeverO","text":"Never"}],"platforms":["Linux"]}]},{"kind":"content","content":[{"type":"heading","level":2,"anchor":"overview","text":"Overview"},{"type":"paragraph","inlineContent":[{"type":"text","text":"A component is one piece of an entity’s state, such as its position, its velocity or its"},{"type":"text","text":" "},{"type":"text","text":"health. Components are plain value types; the behavior that acts on them belongs to the code"},{"type":"text","text":" "},{"type":"text","text":"that queries and updates them. An entity holds at most one component of each type."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"To make a type a component, declare its conformance. There are no requirements to implement:"}]},{"type":"codeListing","code":["struct Lifetime: Component { var remaining: Double }","","var world = World()","let spark = world.spawn(Position(x: 0, y: 0), Lifetime(remaining: 0.5))","","world[Lifetime.self, of: spark].remaining -= 0.25","print(world[Lifetime.self, of: spark].remaining)","\/\/ Prints \"0.25\""],"syntax":"swift"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Every component is a "},{"type":"reference","identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/Bundle","isActive":true},{"type":"text","text":" of itself, so you can pass one anywhere a bundle is expected,"},{"type":"text","text":" "},{"type":"text","text":"and a "},{"type":"reference","identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/QueryTerm","isActive":true},{"type":"text","text":" that matches the entities holding it."}]},{"type":"heading","level":3,"anchor":"Requiring-Other-Components","text":"Requiring Other Components"},{"type":"paragraph","inlineContent":[{"type":"text","text":"A component can require others. Spawning an entity with the component, or inserting the"},{"type":"text","text":" "},{"type":"text","text":"component into an entity, also inserts each required component the entity doesn’t hold, and"},{"type":"text","text":" "},{"type":"text","text":"whatever those components require in turn. List the required components in "},{"type":"reference","isActive":true,"identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/Component\/required-u15k"},{"type":"text","text":":"}]},{"type":"codeListing","code":["struct Player: Component {","    static var required: some Bundle {","        Position(x: 0, y: 0)","        Health(current: 100)","    }","}","","var world = World()","let player = world.spawn(Player(), Health(current: 50))","","print(world[Position.self, of: player])","\/\/ Prints \"Position(x: 0.0, y: 0.0)\"","print(world[Health.self, of: player].current)","\/\/ Prints \"50\""],"syntax":"swift"},{"type":"paragraph","inlineContent":[{"type":"text","text":"A component given explicitly, like the health in the example above, is kept: required"},{"type":"text","text":" "},{"type":"text","text":"components fill in only the types the entity doesn’t already hold."}]}]}],"kind":"symbol","metadata":{"symbolKind":"protocol","remoteSource":{"fileName":"Component.swift","url":"https:\/\/github.com\/Tyler-Keith-Thompson\/ECS\/blob\/main\/Sources\/WorldModule\/Component.swift#L48"},"modules":[{"name":"WorldModule"}],"title":"Component","fragments":[{"text":"protocol","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Component","kind":"identifier"}],"roleHeading":"Protocol","externalID":"s:11WorldModule9ComponentP","role":"symbol","navigatorTitle":[{"text":"Component","kind":"identifier"}]},"abstract":[{"text":"A type that can be stored as a component of an entity.","type":"text"}],"relationshipsSections":[{"kind":"relationships","identifier