dentifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/Bundle"},{"text":" of itself, so you can pass one anywhere a bundle is expected,","type":"text"},{"text":" ","type":"text"},{"text":"and a ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/QueryTerm"},{"text":" that matches the entities holding it.","type":"text"}],"type":"paragraph"},{"anchor":"Requiring-Other-Components","text":"Requiring Other Components","type":"heading","level":3},{"inlineContent":[{"text":"A component can require others. Spawning an entity with the component, or inserting the","type":"text"},{"text":" ","type":"text"},{"text":"component into an entity, also inserts each required component the entity doesn’t hold, and","type":"text"},{"text":" ","type":"text"},{"text":"whatever those components require in turn. List the required components in ","type":"text"},{"identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/Component\/required-u15k","type":"reference","isActive":true},{"text":":","type":"text"}],"type":"paragraph"},{"code":["struct Player: Component {","    static var required: some Bundle {","        Position(x: 0, y: 0)","        Health(current: 100)","    }","}","","var world = World()","let player = world.spawn(Player(), Health(current: 50))","","print(world[Position.self, of: player])","\/\/ Prints \"Position(x: 0.0, y: 0.0)\"","print(world[Health.self, of: player].current)","\/\/ Prints \"50\""],"type":"codeListing","syntax":"swift"},{"inlineContent":[{"type":"text","text":"A component given explicitly, like the health in the example above, is kept: required"},{"type":"text","text":" "},{"type":"text","text":"components fill in only the types the entity doesn’t already hold."}],"type":"paragraph"}]}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/worldmodule\/component"]}],"schemaVersion":{"major":0,"patch":0,"minor":3},"identifier":{"url":"doc:\/\/WorldModule\/docu