ver","preciseIdentifier":"s:s5NeverO","kind":"typeIdentifier"}],"platforms":["Linux"]}],"kind":"declarations"},{"content":[{"anchor":"overview","level":2,"type":"heading","text":"Overview"},{"inlineContent":[{"type":"text","text":"A component is one piece of an entity’s state, such as its position, its velocity or its"},{"type":"text","text":" "},{"type":"text","text":"health. Components are plain value types; the behavior that acts on them belongs to the code"},{"type":"text","text":" "},{"type":"text","text":"that queries and updates them. An entity holds at most one component of each type."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"To make a type a component, declare its conformance. There are no requirements to implement:"}],"type":"paragraph"},{"type":"codeListing","syntax":"swift","code":["struct Lifetime: Component { var remaining: Double }","","var world = World()","let spark = world.spawn(Position(x: 0, y: 0), Lifetime(remaining: 0.5))","","world[Lifetime.self, of: spark].remaining -= 0.25","print(world[Lifetime.self, of: spark].remaining)","\/\/ Prints \"0.25\""]},{"inlineContent":[{"type":"text","text":"Every component is a "},{"isActive":true,"identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/Bundle","type":"reference"},{"type":"text","text":" of itself, so you can pass one anywhere a bundle is expected,"},{"type":"text","text":" "},{"type":"text","text":"and a "},{"isActive":true,"identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/QueryTerm","type":"reference"},{"type":"text","text":" that matches the entities holding it."}],"type":"paragraph"},{"anchor":"Requiring-Other-Components","level":3,"type":"heading","text":"Requiring Other Components"},{"inlineContent":[{"type":"text","text":"A component can require others. Spawning an entity with the component, or inserting the"},{"type":"text","text":" "},{"type":"text","text":"component into an entity, also inserts each required component the entity doesn’t hold, and"},{"type":"text","text":" "},{"type":"text","text":"whatever those components require in turn. List the required components in "},{"type":"reference","isActive":true,"identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/Component\/required-u15k"},{"type":"text","text":":"}],"type":"paragraph"},{"type":"codeListing","syntax":"swift","code":["struct Player: Component {","    static var required: some Bundle {","        Position(x: 0, y: 0)","        Health(current: 100)","    }","}","","var world = World()","let player = world.spawn(Player(), Health(current: 50))","","print(world[Position.self, of: player])","\/\/ Prints \"Position(x: 0.0, y: 0.0)\"","print(world[Health.self, of: player].current)","\/\/ Prints \"50\""]},{"inlineContent":[{"text":"A component given explicitly, like the health in the example above, is kept: required","type":"text"},{"text":" ","type":"text"},{"text":"components fill in only the types the entity doesn’t already hold.","type":"text"}],"type":"paragraph"}],"kind":"content"}],"kind":"symbol","identifier":{"url":"doc:\/\/WorldModule\/documentation\/WorldModule\/Component","interfaceLanguage":"swift"},"schemaVersion":{"patch":0,"major":0,"minor":3},"seeAlsoSections":[{"generated":true,"identifiers":["doc:\/\/WorldModule\/documentation\/WorldModule\/World","doc:\/\/WorldModule\/documentation\/WorldModule\/Entity","doc:\/\/WorldModule\/documentation\/WorldModule\/Resource"],"title":"Essentials","anchor":"Essentials"}],"hierarchy":{"paths":[["doc:\/\/WorldModule\/documentation\/WorldModule"]]},"abstract":[{"text":"A type that can be stored as a component of an entity.","type":"text"}],"topicSections":[{"generated":true,"identifiers":["doc:\/\/WorldModule\/documentation\/WorldModule\/Component\/Required-swift.associatedtype"],"title":"Associated Types","anchor":"Associated-Types"},{"generated":true,"identifiers":["doc:\/\/WorldModule\/documentation\/WorldModule\/Component\/required-u15k"],"title":"Type Properties","anchor":"Type-Prop