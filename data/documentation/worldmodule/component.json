le\/documentation\/WorldModule\/Entity","doc:\/\/WorldModule\/documentation\/WorldModule\/Resource"]}],"kind":"symbol","primaryContentSections":[{"declarations":[{"platforms":["Linux"],"languages":["swift"],"tokens":[{"kind":"keyword","text":"protocol"},{"kind":"text","text":" "},{"kind":"identifier","text":"Component"},{"kind":"text","text":" : "},{"text":"Bundle","kind":"typeIdentifier","identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/Bundle","preciseIdentifier":"s:11WorldModule6BundleP"},{"text":", ","kind":"text"},{"text":"QueryTerm","kind":"typeIdentifier","identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/QueryTerm","preciseIdentifier":"s:11WorldModule9QueryTermP"},{"text":" ","kind":"text"},{"text":"where","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":" == ","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":".","kind":"text"},{"text":"Value","identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/QueryTerm\/Value","kind":"typeIdentifier","preciseIdentifier":"s:11WorldModule9QueryTermP5ValueQa"},{"text":", ","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":".","kind":"text"},{"text":"Body","kind":"typeIdentifier","identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/Bundle\/Body-swift.associatedtype","preciseIdentifier":"s:11WorldModule6BundleP4BodyQa"},{"text":" == ","kind":"text"},{"text":"Never","kind":"typeIdentifier","preciseIdentifier":"s:s5NeverO"}]}],"kind":"declarations"},{"content":[{"type":"heading","level":2,"text":"Overview","anchor":"overview"},{"inlineContent":[{"text":"A component is one piece of an entity’s state, such as its position, its velocity or its","type":"text"},{"type":"text","text":" "},{"type":"text","text":"health. Components are plain value types; the behavior that acts on them belongs to the code"},{"type":"text","text":" "},{"type":"text","text":"that queries and updates them. An entity holds at most one component of each type."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"To make a type a component, declare its conformance. There are no requirements to implement:"}],"type":"paragraph"},{"type":"codeListing","syntax":"swift","code":["struct Lifetime: Component { var remaining: Double }","","var world = World()","let spark = world.spawn(Position(x: 0, y: 0), Lifetime(remaining: 0.5))","","world[Lifetime.self, of: spark].remaining -= 0.25","print(world[Lifetime.self, of: spark].remaining)","\/\/ Prints \"0.25\""]},{"inlineContent":[{"text":"Every component is a ","type":"text"},{"identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/Bundle","isActive":true,"type":"reference"},{"text":" of itself, so you can pass one anywhere a bundle is expected,","type":"text"},{"text":" ","type":"text"},{"text":"and a ","type":"text"},{"identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/QueryTerm","isActive":true,"type":"reference"},{"text":" that matches the entities holding it.","type":"text"}],"type":"paragraph"},{"level":3,"type":"heading","text":"Requiring Other Components","anchor":"Requiring-Other-Components"},{"inlineContent":[{"text":"A component can require others. Spawning an entity with the component, or inserting the","type":"text"},{"text":" ","type":"text"},{"text":"component into an entity, also inserts each required component the entity doesn’t hold, and","type":"text"},{"text":" ","type":"text"},{"text":"whatever those components require in turn. List the required components in ","type":"text"},{"identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/Component\/required-u15k","type":"reference","isActive":true},{"text":":","type":"text"}],"type":"paragraph"},{"syntax":"swift","type":"codeListing","code":["struct Player: Component {","    static var required: some Bundle {","        Position(x: 0, y: 0)","        Health(current: 100)","    }","}","","var world = World()","let player = world.spawn(Player(), Health(current: 50))","","print(world[Position.self, of: player])","\/\/ Prints \"Position(x: 0.0, y: 0.0)\"","print(world[Health.self, of: player].current)","\/\/ Prints \"50\""]},{"inlineContent":[{"text":"A component given explicitly, like the health in the example above, is kept: required","type":"text"},{"text":" ","type":"text"},{"text":"components fill in only the types the entity doesn’t already hold.","type":"text"}],"type":"paragraph"}],"kind":"content"}],"hierarchy":{"paths":[["doc:\/\/WorldModule\/documentation\/WorldModule"]]},"references":{"doc://WorldModule/documentation/WorldModule/Bundle/Body-swift.associatedtype":{"identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/Bundle\/Body-swift.associatedtype","type":"topic","role":"symbol","title":"Body","fragments":[{"text":"associatedtype","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Body","kind":"identifier"},{"text":" : ","kind":"text"},{"text":"Bundle","preciseIdentifier":"s:11WorldModule6BundleP","kind":"typeIdentifier"}],"abstract":[{"text":"The type of the bundle this bundle is made of.","type":"text"}],"kind":"symbol","required":true,"url":"\/documentation\/worldmodule\/bundle\/body-swift.associatedtype"},"doc://WorldModule/documentation/WorldModule/Resource":{"navigatorTitle":[{"kind":"identifier","text":"Resource"}],"identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/Resource","title":"Resource","role":"symbol","fragments":[{"kind":"keyword","text":"protocol"},{"kind":"text","text":" "},{"kind":"identifier","text":"Resource"}],"kind":"symbol","type":"topic","abstract":[{"type":"text","text":"A type that a world can hold a single value of, outside any entity."}],"url":"\/documentation\/worldmodule\/resource"},"doc://WorldModule/documentation/WorldModule/World":{"kind":"symbol","type":"topic","role":"symbol","title":"World","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"World"}],"url":"\/documentation\/worldmodule\/world","identifier":"d