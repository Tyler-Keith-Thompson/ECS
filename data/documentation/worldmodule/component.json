{"abstract":[{"text":"A type that can be stored as a component of an entity.","type":"text"}],"hierarchy":{"paths":[["doc:\/\/WorldModule\/documentation\/WorldModule"]]},"identifier":{"url":"doc:\/\/WorldModule\/documentation\/WorldModule\/Component","interfaceLanguage":"swift"},"sections":[],"kind":"symbol","schemaVersion":{"major":0,"patch":0,"minor":3},"seeAlsoSections":[{"anchor":"Essentials","title":"Essentials","generated":true,"identifiers":["doc:\/\/WorldModule\/documentation\/WorldModule\/World","doc:\/\/WorldModule\/documentation\/WorldModule\/Entity","doc:\/\/WorldModule\/documentation\/WorldModule\/Resource"]}],"primaryContentSections":[{"kind":"declarations","declarations":[{"platforms":["Linux"],"languages":["swift"],"tokens":[{"text":"protocol","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Component","kind":"identifier"},{"text":" : ","kind":"text"},{"text":"Bundle","identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/Bundle","kind":"typeIdentifier","preciseIdentifier":"s:11WorldModule6BundleP"},{"text":", ","kind":"text"},{"text":"QueryTerm","identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/QueryTerm","kind":"typeIdentifier","preciseIdentifier":"s:11WorldModule9QueryTermP"},{"text":" ","kind":"text"},{"text":"where","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":" == ","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":".","kind":"text"},{"text":"Value","identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/QueryTerm\/Value","kind":"typeIdentifier","preciseIdentifier":"s:11WorldModule9QueryTermP5ValueQa"},{"text":", ","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":".","kind":"text"},{"text":"Body","identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/Bundle\/Body-swift.associatedtype","kind":"typeIdentifier","preciseIdentifier":"s:11WorldModule6BundleP4BodyQa"},{"text":" == ","kind":"text"},{"text":"Never","kind":"typeIdentifier","preciseIdentifier":"s:s5NeverO"}]}]},{"kind":"content","content":[{"text":"Overview","type":"heading","level":2,"anchor":"overview"},{"type":"paragraph","inlineContent":[{"type":"text","text":"A component is one piece of an entity’s state, such as its position, its velocity or its"},{"type":"text","text":" "},{"type":"text","text":"health. Components are plain value types; the behavior that acts on them belongs to the code"},{"type":"text","text":" "},{"type":"text","text":"that queries and updates them. An entity holds at most one component of each type."}]},{"type":"paragraph","inlineContent":[{"text":"To make a type a component, declare its conformance. There are no requirements to implement:","type":"text"}]},{"syntax":"swift","code":["struct Lifetime: Component { var remaining: Double }","","var world = World()","let spark = world.spawn(Position(x: 0, y: 0), Lifetime(remaining: 0.5))","","world[Lifetime.self, of: spark].remaining -= 0.25","print(world[Lifetime.self, of: spark].remaining)","\/\/ Prints \"0.25\""],"type":"codeListing"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Every component is a "},{"type":"reference","isActive":true,"identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/Bundle"},{"type":"text","text":" of itself, so you can pass one anywhere a bundle is expected,"},{"type":"text","text":" "},{"type":"text","text":"and a "},{"type":"reference","isActive":true,"identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/QueryTerm"},{"type":"text","text":" that matches the entities holding it."}]},{"text":"Requiring Other Components","type":"heading","level":3,"anchor":"Requiring-Other-Components"},{"type":"paragraph","inlineContent":[{"text":"A component can require others. Spawning an entity with the component, or inserting the","type":"text"},{"text":" ","type":"text"},{"text":"component into an entity, also inserts each required component the entity doesn’t hold, and","type":"text"},{"text":" ","type":"text"},{"text":"whatever those components require in turn. List the required components in ","type":"text"},{"type":"reference","identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/Component\/required-u15k","isActive":true},{"text":":","type":"text"}]},{"syntax":"swift","code":["struct Player: Component {","    static var required: some Bundle {","        Position(x: 0, y: 0)","        Health(current: 100)","    }","}","","var world = World()","let player = world.spawn(Player(), Health(current: 50))","","print(world[Position.self, of: player])","\/\/ Prints \"Position(x: 0.0, y: 0.0)\"","print(world[Health.self, of: player].current)","\/\/ Prints \"50\""],"type":"codeListing"},{"type":"paragraph","inlineContent":[{"type":"text","text":"A component given explicitly, like the health in the example above, is kept: required"},{"type":"text","text":" "},{"type":"text","text":"components fill in only the types the entity doesn’t already hold."}]}]}],"relationshipsSections":[{"kind":"relationships","type":"inheritsFrom","title":"Inherits From","identifiers":["doc:\/\/WorldModule\/documentation\/WorldModule\/Bundle","doc:\/\/WorldModule\/documentation\/WorldModule\/QueryTerm","doc:\/\/WorldModule\/s8SendableP","doc:\/\/WorldModule\/s16SendableMetatypeP"]},{"kind":"relationships","type":"conformingTypes","title":"Conforming Types","identifiers":["doc:\/\/WorldModule\/documentation\/WorldModule\/Disabled","doc:\/\/WorldModule\/documentation\/WorldModule\/Prefab","doc:\/\/WorldModule\/documentation\/WorldModule\/Targets"]}],"metadata":{"role":"symbol","navigatorTitle":[{"text":"Component","kind":"identifier"}],"fragments":[{"kind":"keyword","text":"protocol"},{"kind":"text","text":" "},{"kind":"identifier","text":"Component"}],"externalID":"s:11WorldModule9ComponentP","modules":[{"name":"WorldModule"}],"title":"Component","symbolKind":"protocol","remoteSource":{"url":"https:\/\/github.com\/Tyler-Keith-Thompson\/ECS\/blob\/main\/Sources\/WorldModule\/Component.swift#L48","fileNa