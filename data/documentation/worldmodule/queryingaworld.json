{"kind":"article","identifier":{"url":"doc:\/\/WorldModule\/documentation\/WorldModule\/QueryingAWorld","interfaceLanguage":"swift"},"schemaVersion":{"major":0,"minor":3,"patch":0},"sections":[],"metadata":{"title":"Querying a World","modules":[{"name":"WorldModule"}],"roleHeading":"Article","role":"article"},"hierarchy":{"paths":[["doc:\/\/WorldModule\/documentation\/WorldModule"]]},"abstract":[{"text":"Find the entities that hold the components you need, read those components, and change them in place.","type":"text"}],"seeAlsoSections":[{"generated":true,"title":"Querying and Updating Entities","identifiers":["doc:\/\/WorldModule\/documentation\/WorldModule\/Query","doc:\/\/WorldModule\/documentation\/WorldModule\/QueryView","doc:\/\/WorldModule\/documentation\/WorldModule\/EntityQueryView","doc:\/\/WorldModule\/documentation\/WorldModule\/QueryRow","doc:\/\/WorldModule\/documentation\/WorldModule\/QueryTerm","doc:\/\/WorldModule\/documentation\/WorldModule\/AnyOf","doc:\/\/WorldModule\/documentation\/WorldModule\/EntitiesView"],"anchor":"Querying-and-Updating-Entities"}],"primaryContentSections":[{"kind":"content","content":[{"text":"Overview","level":2,"anchor":"Overview","type":"heading"},{"inlineContent":[{"type":"text","text":"Most of the work in an entity component system is a loop over many similar entities: move"},{"type":"text","text":" "},{"type":"text","text":"everything that has a velocity, damage everything standing in fire, draw everything that has a"},{"type":"text","text":" "},{"type":"text","text":"sprite. A "},{"inlineContent":[{"type":"text","text":"query"}],"type":"emphasis"},{"type":"text","text":" describes which entities such a loop visits and which components it reads. A"},{"type":"text","text":" "},{"type":"text","text":"world answers a query with a lazy view of the matching entities, and an "},{"inlineContent":[{"type":"text","text":"update"}],"type":"emphasis"},{"type":"text","text":" uses the same"},{"type":"text","text":" "},{"type":"text","text":"description to change components where they’re stored."}],"type":"paragraph"},{"text":"Read the entities that hold a set of components","level":3,"anchor":"Read-the-entities-that-hold-a-set-of-components","type":"heading"},{"inlineContent":[{"type":"text","text":"Pass component types to a world’s "},{"code":"query(_:)","type":"codeVoice"},{"type":"text","text":" method to visit every entity that holds all of"},{"type":"text","text":" "},{"type":"text","text":"them. Each row is a tuple of the entity, labeled "},{"code":"entity","type":"codeVoice"},{"type":"text","text":", followed by one component per type, in"},{"type":"text","text":" "},{"type":"text","text":"the order you listed them:"}],"type":"paragraph"},{"syntax":"swift","code":["var world = World()","world.spawn(Name(value: \"comet\"), Position(x: 1, y: 2), Velocity(dx: 3, dy: 4))","world.spawn(Name(value: \"rock\"), Position(x: 0, y: 0))","","for (_, name, position, velocity) in world.query(Name.self, Position.self, Velocity.self) {","    print(name.value, position.x + velocity.dx)","    \/\/ Prints \"comet 4.0\"","}"],"type":"codeListing"},{"inlineContent":[{"text":"The rock has no velocity, so the query skips it.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"Only the entity is labeled, because a tuple’s labels can’t be named after its element types. To"},{"type":"text","text":" "},{"type":"text","text":"work with rows in a closure, such as when you sort or filter them, name the components by"},{"type":"text","text":" "},{"type":"text","text":"destructuring the row rather than reaching for them by position:"}],"type":"paragraph"},{"syntax":"swift","code":["var world = World()","world.spawn(Name(value: \"comet\"), Health(current: 3))","world.spawn(Name(value: \"moon\"), Health(current: 9))","","let strongest = world.query(Name.self, Health.self)","    .sorted { first, second in","        let (_, _, firstHealth) = first","        let (_, _, secondHealth) = second","        return firstHealth.current > secondHealth.current","    }","    .map { (_, name, _) in name.value }","print(strongest)","\/\/ Prints \"[\"moon\", \"comet\"]\""],"type":"codeListing"},{"inlineContent":[{"type":"text","text":"A view is a snapshot of the world at the moment you asked for it. Changing the world while you"},{"type":"text","text":" "},{"type":"text","text":"iterate the view doesn’t change the rows it shows, so you can despawn entities or insert"},{"type":"text","text":" "},{"type":"text","text":"components from inside the loop."}],"type":"paragraph"},{"text":"Narrow a query with a filter","level":3,"anchor":"Narrow-a-query-with-a-filter","type":"heading"},{"inlineContent":[{"type":"text","text":"Some conditions matter without your needing to read the component. A "},{"type":"emphasis","inlineContent":[{"type":"text","text":"filter"}]},{"type":"text","text":" adds them:"},{"type":"text","text":" "},{"type":"reference","isActive":true,"identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/QueryView\/with(_:)"},{"type":"text","text":" requires types, "},{"type":"reference","isActive":true,"identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/QueryView\/without(_:)"},{"type":"text","text":" excludes them, and"},{"type":"text","text":" "},{"type":"reference","isActive":true,"identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/QueryView\/anyOf(_:)"},{"type":"text","text":" requires an entity to pass at least one of several filters. The rows still"},{"type":"text","text":" "},{"type":"text","text":"carry only the components you asked to read:"}],"type":"paragraph"},{"syntax":"swift","code":["var world = World()","world.spawn(Name(value: \"comet\"), Velocity(dx: 1, dy: 0))","world.spawn(Name(value: \"statue\"), Velocity(dx: 1, dy: 0), Frozen())","world.spawn(Name(value: \"rock\"))","","var moving: [String] = []","for (_, name) in world.query(Name.self).with(Velocity.self).without(Frozen.self) {","    moving.append(name.value)","}","print(moving)","\/\/ Prints \"[\"comet\"]\"","","let still = world.query(Name.self).anyOf(.with(Frozen.self), .without(Velocity.self))","print(still.count)","\/\/ Prints \"2\""],"type":"codeListing"},{"inlineContent":[{"type":"text","text":"A "},{"identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/QueryFilter","isActive":true,"type":"reference"},{"type":"text","text":" is a value of its own, so you can build one once and apply it with"},{"type":"text","text":" "},{"identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/QueryView\/filtered(by:)","isActive":true,"type":"reference"},{"type":"text","text":", "},{"identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/Query\/filtered(by:)","isActive":true,"type":"reference"},{"type":"text","text":", or the "},{"type":"codeVoice","code":"where"},{"type":"text","text":" argument of an update."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"To visit entities without reading any component, call "},{"code":"query()","type":"codeVoice"},{"type":"text","text":" with no types and narrow the"},{"type":"text","text":" "},{"type":"reference","identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/EntityQueryView","isActive":true},{"type":"text","text":" it returns:"}],"type":"paragraph"},{"syntax":"swift","code":["var world = World()","world.spawn(Position(x: 0, y: 0), Frozen())","world.spawn(Position(x: 1, y: 1))","","for entity in world.query().with(Frozen.self) {","    world.remove(Frozen.self, from: entity)","}","print(world.query().with(Frozen.self).count)","\/\/ Prints \"0\""],"type":"codeListing"},{"text":"Describe a query once with a query value","level":3,"anchor":"Describe-a-query-once-with-a-query-value","type":"heading"},{"inlineContent":[{"text":"A ","type":"text"},{"identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/Query","type":"reference","isActive":true},{"text":" holds a query’s terms and filter as a value that doesn’t belong to any world. Store it,","type":"text"},{"text":" ","type":"text"},{"text":"compare it with another, and run it against any world:","type":"text"}],"type":"paragraph"},{"syntax":"swift","code":["let movers = Query(Position.self, Velocity.self).without(Frozen.self)","","var level = World()","level.spawn(Position(x: 0, y: 0), Velocity(dx: 1, dy: 0))","level.spawn(Position(x: 0, y: 0), Velocity(dx: 1, dy: 0), Frozen())","","var copy = level","copy.spawn(Position(x: 3, y: 3), Velocity(dx: 0, dy: 1))","","print(level.query(movers).count, copy.query(movers).count)","\/\/ Prints \"1 2\""],"type":"codeListing"},{"text":"Match any of several components","level":3,"anchor":"Match-any-of-several-components","type":"heading"},{"inlineContent":[{"text":"A query’s terms can include an ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/AnyOf"},{"text":" group. An entity matches the group when it holds at least","type":"text"},{"text":" ","type":"text"},{"text":"one of its types, and the row holds a tuple with one optional per type, ","type":"text"},{"type":"codeVoice","code":"nil"},{"text":" where the entity","type":"text"},{"text":" ","type":"text"},{"text":"lacks that type. The following example adds up the forces that push each entity, whichever of","type":"text"},{"text":" ","type":"text"},{"text":"wind and thrust it feels (","type":"text"},{"type":"codeVoice","code":"Wind"},{"text":" and ","type":"text"},{"type":"codeVoice","code":"Thrust"},{"text":" are components with a ","type":"text"},{"type":"codeVoice","code":"force"},{"text":" property):","type":"text"}],"type":"paragraph"},{"syntax":"swift","code":["var world = World()","world.spawn(Name(value: \"kite\"), Wind(force: 3))","world.spawn(Name(value: \"rocket\"), Thrust(force: 5), Wind(force: 1))","world.spawn(Name(value: \"rock\"))","","var forces: [String] = []","for (_, name, (wind, thrust)) in world.query(Query(Name.self, AnyOf<Wind, Thrust>.self)) {","    forces.append(\"\\(name.value): \\((wind?.force ?? 0) + (thrust?.force ?? 0))\")","}","print(forces)","\/\/ Prints \"[\"kite: 3.0\", \"rocket: 6.0\"]\""],"type":"codeListing"},{"inlineContent":[{"type":"text","text":"The rock holds neither type, so the query skips it."}],"type":"paragraph"},{"text":"Change components in place","level":3,"anchor":"Change-components-in-place","type":"heading"},{"inlineContent":[{"type":"text","text":"To change components while you visit them, use an update instead of a view. The method visits"},{"type":"text","text":" "},{"type":"text","text":"every entity that holds the component you change and the components you read. Its closure receives"},{"type":"text","text":" "},{"type":"text","text":"the component to change as an "},{"code":"inout","type":"codeVoice"},{"type":"text","text":" argument, and a "},{"identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/QueryRow","type":"reference","isActive":true},{"type":"text","text":" carrying the entity and the"},{"type":"text","text":" "},{"type":"text","text":"components it reads:"}],"type":"paragraph"},{"syntax":"swift","code":["var world = World()","let comet = world.spawn(Position(x: 0, y: 0), Velocity(dx: 1, dy: 2))","let statue = world.spawn(Position(x: 5, y: 5), Velocity(dx: 1, dy: 1), Frozen())","","world.update(Position.self, reading: Velocity.self, where: .without(Frozen.self)) { position, row in","    position.x += row.components.dx","    position.y += row.components.dy","}","print(world[Position.self, of: comet])","\/\/ Prints \"Position(x: 1.0, y: 2.0)\"","print(world[Position.self, of: statue])","\/\/ Prints \"Position(x: 5.0, y: 5.0)\""],"type":"codeListing"},{"inlineContent":[{"type":"text","text":"An update can change up to three component types at once, and can take a "},{"isActive":true,"type":"reference","identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/Query"},{"type":"text","text":" in place of"},{"type":"text","text":" "},{"type":"text","text":"the types it reads, which lets it read "},{"isActive":true,"type":"reference","identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/AnyOf"},{"type":"text","text":" groups:"}],"type":"paragraph"},{"syntax":"swift","code":["var world = World()","let kite = world.spawn(Position(x: 0, y: 0), Wind(force: 2))","let rocket = world.spawn(Position(x: 0, y: 0), Thrust(force: 5))","","world.update(Position.self, over: Query(AnyOf<Wind, Thrust>.self)) { position, row in","    let (wind, thrust) = row.components","    position.x += (wind?.force ?? 0) + (thrust?.force ?? 0)","}","print(world[Position.self, of: kite].x, world[Position.self, of: rocket].x)","\/\/ Prints \"2.0 5.0\""],"type":"codeListing"},{"inlineContent":[{"text":"An update can’t read a type it changes, and its closure can’t reach the world while it runs. To","type":"text"},{"text":" ","type":"text"},{"text":"spawn, despawn or add components along the way, such as despawning the entities whose health runs","type":"text"},{"text":" ","type":"text"},{"text":"out, record the changes in ","type":"text"},{"identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/Commands","isActive":true,"type":"reference"},{"text":" and apply them after the update.","type":"text"}],"type":"paragraph"},{"text":"Find what changed","level":3,"anchor":"Find-what-changed","type":"heading"},{"inlineContent":[{"text":"The world stamps every component it adds or changes with its current ","type":"text"},{"type":"reference","identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/World\/changeTick","isActive":true},{"text":".","type":"text"},{"text":" ","type":"text"},{"text":"Filter on those stamps to visit only the entities whose components are new or changed:","type":"text"},{"text":" ","type":"text"},{"type":"reference","identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/Query\/added(_:since:)","isActive":true},{"text":" passes the entities that gained a component after a tick, and","type":"text"},{"text":" ","type":"text"},{"type":"reference","identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/Query\/changed(_:since:)","isActive":true},{"text":" the ones whose component was added or changed after it.","type":"text"}],"type":"paragraph"},{"syntax":"swift","code":["var world = World()","let hero = world.spawn(Name(value: \"hero\"), Health(current: 10))","world.spawn(Name(value: \"guard\"), Health(current: 8))","","let checkpoint = world.changeTick","world.advanceChangeTick()","world[Health.self, of: hero].current -= 3","","for (_, name, health) in world.query(Name.self, Health.self).changed(Health.self, since: checkpoint) {","    print(name.value, health.current)","    \/\/ Prints \"hero 7\"","}"],"type":"codeListing"},{"inlineContent":[{"text":"Each filter checks every entity the visit would otherwise walk, so its cost grows with the number","type":"text"},{"text":" ","type":"text"},{"text":"of entities that hold the type, not with the number that changed. When few of many entities change","type":"text"},{"text":" ","type":"text"},{"text":"between visits, log the type’s changes with ","type":"text"},{"identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/World\/trackChanges(of:)","isActive":true,"type":"reference"},{"text":"; the filters then start","type":"text"},{"text":" ","type":"text"},{"text":"from the entities the log records after the tick:","type":"text"}],"type":"paragraph"},{"syntax":"swift","code":["var world = World()","for _ in 0 ..< 1000 { world.spawn(Name(value: \"bystander\"), Health(current: 10)) }","let target = world.spawn(Name(value: \"target\"), Health(current: 10))","world.trackChanges(of: Health.self)","","let checkpoint = world.changeTick","world.advanceChangeTick()","world[Health.self, of: target].current -= 2","","for (_, name, health) in world.query(Name.self, Health.self).changed(Health.self, since: checkpoint) {","    print(name.value, health.current)","    \/\/ Prints \"target 8\"","}"],"type":"codeListing"},{"inlineContent":[{"text":"Without a tick, the filters compare against the world’s ","type":"text"},{"type":"reference","identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/World\/lastRun","isActive":true},{"text":". A schedule sets it to","type":"text"},{"text":" ","type":"text"},{"text":"the running system’s previous run, so in a system, ","type":"text"},{"type":"codeVoice","code":"changed(Health.self)"},{"text":" means “changed since","type":"text"},{"text":" ","type":"text"},{"text":"this system last ran”.","type":"text"}],"type":"paragraph"},{"text":"Filter in a system’s parameters","level":3,"anchor":"Filter-in-a-systems-parameters","type":"heading"},{"inlineContent":[{"text":"A system receives a query as a parameter, already bound to the world it runs on, and iterates it","type":"text"},{"text":" ","type":"text"},{"text":"directly. Because a system’s parameters are types, it names its filter with filter types in","type":"text"},{"text":" ","type":"text"},{"isActive":true,"identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/Query\/Where","type":"reference"},{"text":": ","type":"text"},{"isActive":true,"identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/With","type":"reference"},{"text":", ","type":"text"},{"isActive":true,"identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/Without","type":"reference"},{"text":", ","type":"text"},{"isActive":true,"identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/Added","type":"reference"},{"text":", ","type":"text"},{"isActive":true,"identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/Changed","type":"reference"},{"text":", ","type":"text"},{"isActive":true,"identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/Allows","type":"reference"},{"text":", and ","type":"text"},{"isActive":true,"identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/AnyOf","type":"reference"},{"text":" of filter","type":"text"},{"text":" ","type":"text"},{"text":"types. For example, a system that visits the entities whose health changed since its previous","type":"text"},{"text":" ","type":"text"},{"text":"run, and that aren’t frozen, takes a parameter of type","type":"text"},{"text":" ","type":"text"},{"code":"Query<Health>.Where<Changed<Health>, Without<Frozen>>","type":"codeVoice"},{"text":", and iterates it like a view.","type":"text"}],"type":"paragraph"},{"text":"Speed up frequent queries","level":3,"anchor":"Speed-up-frequent-queries","type":"heading"},{"inlineContent":[{"type":"text","text":"A query of several types walks the storage of the type the fewest entities hold, and looks each"},{"type":"text","text":" "},{"type":"text","text":"entity up in the others. Three tools make frequent visits cheaper. None of them changes which"},{"type":"text","text":" "},{"type":"text","text":"entities a query finds, only how it finds them."}],"type":"paragraph"},{"inlineContent":[{"text":"A ","type":"text"},{"type":"emphasis","inlineContent":[{"type":"text","text":"group"}]},{"text":", made with ","type":"text"},{"code":"group(_:)","type":"codeVoice"},{"text":", keeps a set of component types packed in the same order, so a","type":"text"},{"text":" ","type":"text"},{"text":"query or update of exactly those types walks them side by side with no lookups. Group the types","type":"text"},{"text":" ","type":"text"},{"text":"you visit together on every step:","type":"text"}],"type":"paragraph"},{"syntax":"swift","code":["var world = World()","let comet = world.spawn(Position(x: 0, y: 0), Velocity(dx: 1, dy: 0))","world.group(Position.self, Velocity.self)","","world.update(Position.self, reading: Velocity.self) { position, row in","    position.x += row.components.dx","}","print(world[Position.self, of: comet].x)","\/\/ Prints \"1.0\""],"type":"codeListing"},{"inlineContent":[{"type":"text","text":"A "},{"type":"emphasis","inlineContent":[{"type":"text","text":"cached query"}]},{"type":"text","text":", made with "},{"type":"codeVoice","code":"cache(_:)"},{"type":"text","text":", keeps a list of the entities that match a query’s"},{"type":"text","text":" "},{"type":"text","text":"structure. A visit whose conditions imply the cache’s walks that list instead of a whole column."},{"type":"text","text":" "},{"type":"text","text":"Cache a query you run often that excludes most of the entities it would otherwise walk:"}],"type":"paragraph"},{"syntax":"swift","code":["var world = World()","for index in 0 ..< 10 {","    world.spawn(Position(x: Double(index), y: 0), Velocity(dx: 1, dy: 0), Asleep())","}","world.spawn(Position(x: 0, y: 0), Velocity(dx: 1, dy: 0))","","let awake = Query(Position.self, Velocity.self).without(Asleep.self)","world.cache(awake)","print(world.query(awake).count)","\/\/ Prints \"1\""],"type":"codeListing"},{"inlineContent":[{"type":"text","text":"A "},{"inlineContent":[{"text":"value index","type":"text"}],"type":"emphasis"},{"type":"text","text":", made with "},{"code":"index(_:)","type":"codeVoice"},{"type":"text","text":", maps each value of a "},{"code":"Hashable","type":"codeVoice"},{"type":"text","text":" component type to the"},{"type":"text","text":" "},{"type":"text","text":"entities holding it, so "},{"code":"lookup(_:)","type":"codeVoice"},{"type":"text","text":" finds them without walking the type’s storage. Index a type"},{"type":"text","text":" "},{"type":"text","text":"you look entities up by and whose values change rarely, such as a name:"}],"type":"paragraph"},{"syntax":"swift","code":["var world = World()","let ada = world.spawn(Name(value: \"ada\"), Health(current: 3))","world.spawn(Name(value: \"bob\"), Health(current: 4))","world.index(Name.self)","","print(world.lookup(Name(value: \"ada\")) == [ada])","\/\/ Prints \"true\""],"type":"codeListing"},{"inlineContent":[{"type":"text","text":"To find entities by one property of a component rather than by the whole value, index the"},{"type":"text","text":" "},{"type":"text","text":"property’s key path and look it up with "},{"type":"codeVoice","code":"lookup(_:equals:)"},{"type":"text","text":". The component type doesn’t need to"},{"type":"text","text":" "},{"type":"text","text":"be "},{"type":"codeVoice","code":"Hashable"},{"type":"text","text":", only the property:"}],"type":"paragraph"},{"syntax":"swift","code":["struct Berth: Component { var dock: Int, number: Int }","","var world = World()","let ferry = world.spawn(Berth(dock: 2, number: 14))","world.spawn(Berth(dock: 3, number: 9))","world.index(\\Berth.number)","","print(world.lookup(\\Berth.number, equals: 14) == [ferry])","\/\/ Prints \"true\""],"type":"codeListing"},{"inlineContent":[{"text":"To find the entities whose property falls in a range, or to visit them in the order of a","type":"text"},{"text":" ","type":"text"},{"text":"property, index the key path ordered with ","type":"text"},{"code":"index(ordered:)","type":"codeVoice"},{"text":". The property’s type needs to be","type":"text"},{"text":" ","type":"text"},{"code":"Comparable","type":"codeVoice"},{"text":". ","type":"text"},{"code":"lookup(_:in:)","type":"codeVoice"},{"text":" takes any range and returns the entities in the property’s order,","type":"text"},{"text":" ","type":"text"},{"text":"and ","type":"text"},{"code":"entities(sortedBy:)","type":"codeVoice"},{"text":" returns every entity holding the component in that order:","type":"text"}],"type":"paragraph"},{"syntax":"swift","code":["var world = World()","let fresh = world.spawn(Name(value: \"fresh\"), Health(current: 9))","let wounded = world.spawn(Name(value: \"wounded\"), Health(current: 2))","let dying = world.spawn(Name(value: \"dying\"), Health(current: 1))","world.index(ordered: \\Health.current)","","print(world.lookup(\\Health.current, in: ..<3) == [dying, wounded])","\/\/ Prints \"true\"","print(world.entities(sortedBy: \\Health.current) == [dying, wounded, fresh])","\/\/ Prints \"true\""],"type":"codeListing"},{"inlineContent":[{"text":"An ordered index costs more to keep than an index by value, since each insert, removal and","type":"text"},{"text":" ","type":"text"},{"text":"despawn finds the entity’s place in sorted order, so index a key path ordered only when you look","type":"text"},{"text":" ","type":"text"},{"text":"it up by range or order.","type":"text"}],"type":"paragraph"}]}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/worldmodule\/queryingaworld"]}],"references":{"doc://WorldModule/documentation/WorldModule/QueryRow":{"navigatorTitle":[{"kind":"identifier","text":"QueryRow"}],"role":"symbol","identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/QueryRow","type":"topic","title":"QueryRow","url":"\/documentation\/worldmodule\/queryrow","kind":"symbol","abstract":[{"type":"text","text":"An entity an update visits, with the components the update reads from it."}],"fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"QueryRow"}]},"doc://WorldModule/documentation/WorldModule/EntityQueryView":{"kind":"symbol","role":"symbol","identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/EntityQueryView","title":"EntityQueryView","url":"\/documentation\/worldmodule\/entityqueryview","navigatorTitle":[{"kind":"identifier","text":"EntityQueryView"}],"type":"topic","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"EntityQueryView"}],"abstract":[{"type":"text","text":"A lazy sequence of the entities that pass a filter, without reading any of their components."}]},"doc://WorldModule/documentation/WorldModule/Query/filtered(by:)":{"fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"filtered","kind":"identifier"},{"text":"(","kind":"text"},{"text":"by","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"QueryFilter","preciseIdentifier":"s:11WorldModule11QueryFilterV","kind":"typeIdentifier"},{"text":") -> ","kind":"text"},{"text":"Query","preciseIdentifier":"s:11WorldModule5QueryV","kind":"typeIdentifier"},{"