{"schemaVersion":{"major":0,"patch":0,"minor":3},"sections":[],"hierarchy":{"paths":[["doc:\/\/WorldModule\/documentation\/WorldModule"]]},"identifier":{"url":"doc:\/\/WorldModule\/documentation\/WorldModule\/QueryingAWorld","interfaceLanguage":"swift"},"seeAlsoSections":[{"anchor":"Querying-and-Updating-Entities","identifiers":["doc:\/\/WorldModule\/documentation\/WorldModule\/Query","doc:\/\/WorldModule\/documentation\/WorldModule\/QueryView","doc:\/\/WorldModule\/documentation\/WorldModule\/EntityQueryView","doc:\/\/WorldModule\/documentation\/WorldModule\/QueryRow","doc:\/\/WorldModule\/documentation\/WorldModule\/QueryTerm","doc:\/\/WorldModule\/documentation\/WorldModule\/AnyOf","doc:\/\/WorldModule\/documentation\/WorldModule\/EntitiesView"],"title":"Querying and Updating Entities","generated":true}],"primaryContentSections":[{"kind":"content","content":[{"anchor":"Overview","type":"heading","level":2,"text":"Overview"},{"type":"paragraph","inlineContent":[{"text":"Most of the work in an entity component system is a loop over many similar entities: move","type":"text"},{"text":" ","type":"text"},{"text":"everything that has a velocity, damage everything standing in fire, draw everything that has a","type":"text"},{"text":" ","type":"text"},{"text":"sprite. A ","type":"text"},{"inlineContent":[{"text":"query","type":"text"}],"type":"emphasis"},{"text":" describes which entities such a loop visits and which components it reads. A","type":"text"},{"text":" ","type":"text"},{"text":"world answers a query with a lazy view of the matching entities, and an ","type":"text"},{"inlineContent":[{"type":"text","text":"update"}],"type":"emphasis"},{"text":" uses the same","type":"text"},{"text":" ","type":"text"},{"text":"description to change components where they’re stored.","type":"text"}]},{"anchor":"Read-the-entities-that-hold-a-set-of-components","type":"heading","level":3,"text":"Read the entities that hold a set of components"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Pass component types to a world’s "},{"code":"query(_:)","type":"codeVoice"},{"type":"text","text":" method to visit every entity that holds all of"},{"type":"text","text":" "},{"type":"text","text":"them. Each row is a tuple of the entity, labeled "},{"code":"entity","type":"codeVoice"},{"type":"text","text":", followed by one component per type, in"},{"type":"text","text":" "},{"type":"text","text":"the order you listed them:"}]},{"code":["var world = World()","world.spawn(Name(value: \"comet\"), Position(x: 1, y: 2), Velocity(dx: 3, dy: 4))","world.spawn(Name(value: \"rock\"), Position(x: 0, y: 0))","","for (_, name, position, velocity) in world.query(Name.self, Position.self, Velocity.self) {","    print(name.value, position.x + velocity.dx)","    \/\/ Prints \"comet 4.0\"","}"],"type":"codeListing","syntax":"swift"},{"type":"paragraph","inlineContent":[{"text":"The rock has no velocity, so the query skips it.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"Only the entity is labeled, because a tuple’s labels can’t be named after its element types. To","type":"text"},{"text":" ","type":"text"},{"text":"work with rows in a closure, such as when you sort or filter them, name the components by","type":"text"},{"text":" ","type":"text"},{"text":"destructuring the row rather than reaching for them by position:","type":"text"}]},{"code":["var world = World()","world.spawn(Name(value: \"comet\"), Health(current: 3))","world.spawn(Name(value: \"moon\"), Health(current: 9))","","let strongest = world.query(Name.self, Health.self)","    .sorted { first, second in","        let (_, _, firstHealth) = first","        let (_, _, secondHealth) = second","        return firstHealth.current > secondHealth.current","    }","    .map { (_, name, _) in name.value }","print(strongest)","\/\/ Prints \"[\"moon\", \"comet\"]\""],"type":"codeListing","syntax":"swift"},{"type":"paragraph","inlineContent":[{"type":"text","text":"A view is a snapshot of the world at the moment you asked for it. Changing the world while you"},{"type":"text","text":" "},{"type":"text","text":"iterate the view doesn’t change the rows it shows, so you can despawn entities or insert"},{"type":"text","text":" "},{"type":"text","text":"components from inside the loop."}]},{"anchor":"Narrow-a-query-with-a-filter","type":"heading","level":3,"text":"Narrow a query with a filter"},{"type":"paragraph","inlineContent":[{"text":"Some conditions matter without your needing to read the component. A ","type":"text"},{"inlineContent":[{"text":"filter","type":"text"}],"type":"emphasis"},{"text":" adds them:","type":"text"},{"text":" ","type":"text"},{"type":"reference","identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/QueryView\/with(_:)","isActive":true},{"text":" requires types, ","type":"text"},{"type":"reference","identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/QueryView\/without(_:)","isActive":true},{"text":" excludes them, and","type":"text"},{"text":" ","type":"text"},{"type":"reference","identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/QueryView\/anyOf(_:)","isActive":true},{"text":" requires an entity to pass at least one of several filters. The rows still","type":"text"},{"text":" ","type":"text"},{"text":"carry only the components you asked to read:","type":"text"}]},{"code":["var world = World()","world.spawn(Name(value: \"comet\"), Velocity(dx: 1, dy: 0))","world.spawn(Name(value: \"statue\"), Velocity(dx: 1, dy: 0), Frozen())","world.spawn(Name(value: \"rock\"))","","var moving: [String] = []","for (_, name) in world.query(Name.self).with(Velocity.self).without(Frozen.self) {","    moving.append(name.value)","}","print(moving)","\/\/ Prints \"[\"comet\"]\"","","let still = world.query(Name.self).anyOf(.with(Frozen.self), .without(Velocity.self))","print(still.count)","\/\/ Prints \"2\""],"type":"codeListing","syntax":"swift"},{"type":"paragraph","inlineContent":[{"type":"text","text":"A "},{"isActive":true,"identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/QueryFilter","type":"reference"},{"type":"text","text":" is a value of its own, so you can build one once and apply it with"},{"type":"text","text":" "},{"isActive":true,"identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/QueryView\/filtered(by:)","type":"reference"},{"type":"text","text":", "},{"isActive":true,"identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/Query\/filtered(by:)","type":"reference"},{"type":"text","text":", or the "},{"type":"codeVoice","code":"where"},{"type":"text","text":" argument of an update."}]},{"type":"paragraph","inlineContent":[{"text":"To visit entities without reading any component, call ","type":"text"},{"type":"codeVoice","code":"query()"},{"text":" with no types and narrow the","type":"text"},{"text":" ","type":"text"},{"identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/EntityQueryView","type":"reference","isActive":true},{"text":" it returns:","type":"text"}]},{"code":["var world = World()","world.spawn(Position(x: 0, y: 0), Frozen())","world.spawn(Position(x: 1, y: 1))","","for entity in world.query().with(Frozen.self) {","    world.remove(Frozen.self, from: entity)","}","print(world.query().with(Frozen.self).count)","\/\/ Prints \"0\""],"type":"codeListing","syntax":"swift"},{"anchor":"Describe-a-query-once-with-a-query-value","type":"heading","level":3,"text":"Describe a query once with a query value"},{"type":"paragraph","inlineContent":[{"text":"A ","type":"text"},{"isActive":true,"identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/Query","type":"reference"},{"text":" holds a query’s terms and filter as a value that doesn’t belong to any world. Store it,","type":"text"},{"text":" ","type":"text"},{"text":"compare it with another, and run it against any world:","type":"text"}]},{"code":["let movers = Query(Position.self, Velocity.self).without(Frozen.self)","","var level = World()","level.spawn(Position(x: 0, y: 0), Velocity(dx: 1, dy: 0))","level.spawn(Position(x: 0, y: 0), Velocity(dx: 1, dy: 0), Frozen())","","var copy = level","copy.spawn(Position(x: 3, y: 3), Velocity(dx: 0, dy: 1))","","print(level.query(movers).count, copy.query(movers).count)","\/\/ Prints \"1 2\""],"type":"codeListing","syntax":"swift"},{"anchor":"Match-any-of-several-components","type":"heading","level":3,"text":"Match any of several components"},{"type":"paragraph","inlineContent":[{"type":"text","text":"A query’s terms can include an "},{"identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/AnyOf","isActive":true,"type":"reference"},{"type":"text","text":" group. An entity matches the group when it holds at least"},{"type":"text","text":" "},{"type":"text","text":"one of its types, and the row holds a tuple with one optional per type, "},{"type":"codeVoice","code":"nil"},{"type":"text","text":" where the entity"},{"type":"text","text":" "},{"type":"text","text":"lacks that type. The following example adds up the forces that push each entity, whichever of"},{"type":"text","text":" "},{"type":"text","text":"wind and thrust it feels ("},{"type":"codeVoice","code":"Wind"},{"type":"text","text":" and "},{"type":"codeVoice","code":"Thrust"},{"type":"text","text":" are components with a "},{"type":"codeVoice","code":"force"},{"type":"text","text":" property):"}]},{"code":["var world = World()","world.spawn(Name(value: \"kite\"), Wind(force: 3))","world.spawn(Name(value: \"rocket\"), Thrust(force: 5), Wind(force: 1))","world.spawn(Name(value: \"rock\"))","","var forces: [String] = []","for (_, name, (wind, thrust)) in world.query(Query(Name.self, AnyOf<Wind, Thrust>.self)) {","    forces.append(\"\\(name.value): \\((wind?.force ?? 0) + (thrust?.force ?? 0))\")","}","print(forces)","\/\/ Prints \"[\"kite: 3.0\", \"rocket: 6.0\"]\""],"type":"codeListing","syntax":"swift"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The rock holds neither type, so the query skips it."}]},{"anchor":"Change-components-in-place","type":"heading","level":3,"text":"Change components in place"},{"type":"paragraph","inlineContent":[{"type":"text","text":"To change components while you visit them, use an update instead of a view. The method visits"},{"type":"text","text":" "},{"type":"text","text":"every entity that holds the component you change and the components you read. Its closure receives"},{"type":"text","text":" "},{"type":"text","text":"the component to change as an "},{"type":"codeVoice","code":"inout"},{"type":"text","text":" argument, and a "},{"isActive":true,"type":"reference","identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/QueryRow"},{"type":"text","text":" carrying the entity and the"},{"type":"text","text":" "},{"type":"text","text":"components it reads:"}]},{"code":["var world = World()","let comet = world.spawn(Position(x: 0, y: 0), Velocity(dx: 1, dy: 2))","let statue = world.spawn(Position(x: 5, y: 5), Velocity(dx: 1, dy: 1), Frozen())","","world.update(Position.self, reading: Velocity.self, where: .without(Frozen.self)) { position, row in","    position.x += row.components.dx","    position.y += row.components.dy","}","print(world[Position.self, of: comet])","\/\/ Prints \"Position(x: 1.0, y: 2.0)\"","print(world[Position.self, of: statue])","\/\/ Prints \"Position(x: 5.0, y: 5.0)\""],"type":"codeListing","syntax":"swift"},{"type":"paragraph","inlineContent":[{"type":"text","text":"An update can change up to three component types at once, and can take a "},{"type":"reference","identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/Query","isActive":true},{"type":"text","text":" in place of"},{"type":"text","text":" "},{"type":"text","text":"the types it reads, which lets it read "},{"type":"reference","identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/AnyOf","isActive":true},{"type":"text","text":" groups:"}]},{"code":["var world = World()","let kite = world.spawn(Position(x: 0, y: 0), Wind(force: 2))","let rocket = world.spawn(Position(x: 0, y: 0), Thrust(force: 5))","","world.update(Position.self, over: Query(AnyOf<Wind, Thrust>.self)) { position, row in","    let (wind, thrust) = row.components","    position.x += (wind?.force ?? 0) + (thrust?.force ?? 0)","}","print(world[Position.self, of: kite].x, world[Position.self, of: rocket].x)","\/\/ Prints \"2.0 5.0\""],"type":"codeListing","syntax":"swift"},{"type":"paragraph","inlineContent":[{"text":"An update can’t read a type it changes, and its closure can’t reach the world while it runs. To","type":"text"},{"text":" ","type":"text"},{"text":"spawn, despawn or add components along the way, such as despawning the entities whose health runs","type":"text"},{"text":" ","type":"text"},{"text":"out, record the changes in ","type":"text"},{"type":"reference","identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/Commands","isActive":true},{"text":" and apply them after the update.","type":"text"}]},{"anchor":"Find-what-changed","type":"heading","level":3,"text":"Find what changed"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The world stamps every component it adds or changes with its current "},{"type":"reference","isActive":true,"identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/World\/changeTick"},{"type":"text","text":"."},{"type":"text","text":" "},{"type":"text","text":"Filter on those stamps to visit only the entities whose components are new or changed:"},{"type":"text","text":" "},{"type":"reference","isActive":true,"identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/Query\/added(_:since:)"},{"type":"text","text":" passes the entities that gained a component after a tick, and"},{"type":"text","text":" "},{"type":"reference","isActive":true,"identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/Query\/changed(_:since:)"},{"type":"text","text":" the ones whose component was added or changed after it."}]},{"code":["var world = World()","let hero = world.spawn(Name(value: \"hero\"), Health(current: 10))","world.spawn(Name(value: \"guard\"), Health(current: 8))","","let checkpoint = world.changeTick","world.advanceChangeTick()","world[Health.self, of: hero].current -= 3","","for (_, name, health) in world.query(Name.self, Health.self).changed(Health.self, since: checkpoint) {","    print(name.value, health.current)","    \/\/ Prints \"hero 7\"","}"],"type":"codeListing","syntax":"swift"},{"type":"paragraph","inlineContent":[{"text":"Without a tick, the filters compare against the world’s ","type":"text"},{"isActive":true,"identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/World\/lastRun","type":"reference"},{"text":". A schedule sets it to","type":"text"},{"text":" ","type":"text"},{"text":"the running system’s previous run, so in a system, ","type":"text"},{"code":"changed(Health.self)","type":"codeVoice"},{"text":" means “changed since","type":"text"},{"text":" ","type":"text"},{"text":"this system last ran”.","type":"text"}]},{"anchor":"Filter-in-a-systems-parameters","type":"heading","level":3,"text":"Filter in a system’s parameters"},{"type":"paragraph","inlineContent":[{"type":"text","text":"A system receives a query as a parameter, already bound to the world it runs on, and iterates it"},{"type":"text","text":" "},{"type":"text","text":"directly. Because a system’s parameters are types, it names its filter with filter types in"},{"type":"text","text":" "},{"type":"reference","isActive":true,"identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/Query\/Where"},{"type":"text","text":": "},{"type":"reference","isActive":true,"identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/With"},{"type":"text","text":", "},{"type":"reference","isActive":true,"identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/Without"},{"type":"text","text":", "},{"type":"reference","isActive":true,"identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/Added"},{"type":"text","text":", "},{"type":"reference","isActive":true,"identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/Changed"},{"type":"text","text":", "},{"type":"reference","isActive":true,"identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/Allows"},{"type":"text","text":", and "},{"type":"reference","isActive":true,"identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/AnyOf"},{"type":"text","text":" of filter"},{"type":"text","text":" "},{"type":"text","text":"types. For example, a system that visits the entities whose health changed since its previous"},{"type":"text","text":" "},{"type":"text","text":"run, and that aren’t frozen, takes a parameter of type"},{"type":"text","text":" "},{"type":"codeVoice","code":"Query<Health>.Where<Changed<Health>, Without<Frozen>>"},{"type":"text","text":", and iterates it like a view."}]},{"anchor":"Speed-up-frequent-queries","type":"heading","level":3,"text":"Speed up frequent queries"},{"type":"paragraph","inlineContent":[{"type":"text","text":"A query of several types walks the storage of the type the fewest entities hold, and looks each"},{"type":"text","text":" "},{"type":"text","text":"entity up in the others. Three tools make frequent visits cheaper. None of them changes which"},{"type":"text","text":" "},{"type":"text","text":"entities a query finds, only how it finds them."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"A "},{"type":"emphasis","inlineContent":[{"text":"group","type":"text"}]},{"type":"text","text":", made with "},{"type":"codeVoice","code":"group(_:)"},{"type":"text","text":", keeps a set of component types packed in the same order, so a"},{"type":"text","text":" "},{"type":"text","text":"query or update of exactly those types walks them side by side with no lookups. Group the types"},{"type":"text","text":" "},{"type":"text","text":"you visit together on every step:"}]},{"code":["var world = World()","let comet = world.spawn(Position(x: 0, y: 0), Velocity(dx: 1, dy: 0))","world.group(Position.self, Velocity.self)","","world.update(Position.self, reading: Velocity.self) { position, row in","    position.x += row.components.dx","}","print(world[Position.self, of: comet].x)","\/\/ Prints \"1.0\""],"type":"codeListing","syntax":"swift"},{"type":"paragraph","inlineContent":[{"type":"text","text":"A "},{"type":"emphasis","inlineContent":[{"type":"text","text":"cached query"}]},{"type":"text","text":", made with "},{"type":"codeVoice","code":"cache(_:)"},{"type":"text","text":", keeps a list of the entities that match a query’s"},{"type":"text","text":" "},{"type":"text","text":"structure. A visit whose conditions imply the cache’s walks that list instead of a whole column."},{"type":"text","text":" "},{"type":"text","text":"Cache a query you run often that excludes most of the entities it would otherwise walk:"}]},{"code":["var world = World()","for index in 0 ..< 10 {","    world.spawn(Position(x: Double(index), y: 0), Velocity(dx: 1, dy: 0), Asleep())","}","world.spawn(Position(x: 0, y: 0), Velocity(dx: 1, dy: 0))","","let awake = Query(Position.self, Velocity.self).without(Asleep.self)","world.cache(awake)","print(world.query(awake).count)","\/\/ Prints \"1\""],"type":"codeListing","syntax":"swift"},{"type":"paragraph","inlineContent":[{"text":"A ","type":"text"},{"inlineContent":[{"type":"text","text":"value index"}],"type":"emphasis"},{"text":", made with ","type":"text"},{"code":"index(_:)","type":"codeVoice"},{"text":", maps each value of a ","type":"text"},{"code":"Hashable","type":"codeVoice"},{"text":" component type to the","type":"text"},{"text":" ","type":"text"},{"text":"entities holding it, so ","type":"text"},{"code":"lookup(_:)","type":"codeVoice"},{"text":" finds them without walking the type’s storage. Index a type","type":"text"},{"text":" ","type":"text"},{"text":"you look entities up by and whose values change rarely, such as a name:","type":"text"}]},{"code":["var world = World()","let ada = world.spawn(Name(value: \"ada\"), Health(current: 3))","world.spawn(Name(value: \"bob\"), Health(current: 4))","world.index(Name.self)","","print(world.lookup(Name(value: \"ada\")) == [ada])","\/\/ Prints \"true\""],"type":"codeListing","syntax":"swift"}]}],"metadata":{"title":"Querying a World","role":"article","modules":[{"name":"WorldModule"}],"roleHeading":"Article"},"kind":"article","abstract":[{"type":"text","text":"Find the entities that hold the components you need, read those components, and change them in place."}],"variants":[{"paths":["\/documentation\/worldmodule\/queryingaworld"],"traits":[{"interfaceLanguage":"swift"}]}],"references":{"doc://WorldModule/documentation/WorldModule/Without":{"kind":"symbol","abstract":[{"type":"text","text":"A filter type that passes the entities holding no component of type "},{"type":"codeVoice","code":"C"},{"type":"text","text":"."}],"url":"\/documentation\/worldmodule\/without","role":"symbol","navigatorTitle":[{"kind":"identifier","text":"Without"}],"identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/Without","type":"topic","title":"Without","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"Without"}]},"doc://WorldModule/documentation/WorldModule/Query/changed(_:since:)":{"type":"topic","kind":"symbol","title":"changed(_:since:)","abstract":[{"type":"text","text":"Returns a query that also requires a component added or changed after the given tick."}],"fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"changed","kind":"identifier"},{"text":"<","kind":"text"},{"text":"F","kind":"genericParameter"},{"text":">(","kind":"text"},{"text":"F","kind":"typeIdentifier"},{"text":".Type, ","kind":"text"},{"text":"since","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"ChangeTick","preciseIdentifier":"s:11WorldModule10ChangeTickV","kind":"typeIdentifier"},{"text":"?) -> ","kind":"text"},{"text":"Query","preciseIdentifier":"s:11WorldModule5QueryV","kind":"typeIdentifier"},{"text":"<repeat each ","kind":"text"},{"text":"T","kind":"typeIdentifier"},{"text":">","kind":"text"}],"url":"\/documentation\/worldmodule\/query\/changed(_:since:)","identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/Query\/changed(_:since:)","role":"symbol"},"doc://WorldModule/documentation/WorldModule/Commands":{"type":"topic","identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/Commands","role":"symbol","kind":"symbol","url":"\/documentation\/worldmodule\/commands","title":"Commands","navigatorTitle":[{"text":"Commands","kind":"identifier"}],"fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Commands","kind":"identifier"}],"abstract":[{"type":"text","text":"A buffer of changes to a world, recorded now and applied later in the order they were"},{"type":"text","text":" "},{"type":"text","text":"recorded."}]},"doc://WorldModule/documentation/WorldModule/Added":{"fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"text":"Added","kind":"identifier"}],"navigatorTitle":[{"text":"Added","kind":"identifier"}],"role":"symbol","abstract":[{"text":"A filter type that passes the entities whose component of type ","type":"text"},{"code":"C","type":"codeVoice"},{"text":" was added since the","type":"text"},{"text":" ","type":"text"},{"text":"world’s last run.","type":"text"}],"type":"topic","identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/Added","kind":"symbol","title":"Added","url":"\/documentation\/worldmodule\/added"},"doc://WorldModule/documentation/WorldModule/QueryFilter":{"title":"QueryFilter","identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/QueryFilter","abstract":[{"type":"text","text":"A set of conditions an entity must meet, beyond holding the components a query reads."}],"role":"symbol","type":"topic","url":"\/documentation\/worldmodule\/queryfilter","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"Qu