{"schemaVersion":{"patch":0,"minor":3,"major":0},"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/worldmodule\/queryingaworld"]}],"seeAlsoSections":[{"identifiers":["doc:\/\/WorldModule\/documentation\/WorldModule\/Query","doc:\/\/WorldModule\/documentation\/WorldModule\/QueryView","doc:\/\/WorldModule\/documentation\/WorldModule\/EntityQueryView","doc:\/\/WorldModule\/documentation\/WorldModule\/QueryRow","doc:\/\/WorldModule\/documentation\/WorldModule\/QueryTerm","doc:\/\/WorldModule\/documentation\/WorldModule\/AnyOf","doc:\/\/WorldModule\/documentation\/WorldModule\/EntitiesView"],"generated":true,"anchor":"Querying-and-Updating-Entities","title":"Querying and Updating Entities"}],"metadata":{"roleHeading":"Article","modules":[{"name":"WorldModule"}],"role":"article","title":"Querying a World"},"primaryContentSections":[{"kind":"content","content":[{"level":2,"type":"heading","anchor":"Overview","text":"Overview"},{"inlineContent":[{"text":"Most of the work in an entity component system is a loop over many similar entities: move","type":"text"},{"text":" ","type":"text"},{"text":"everything that has a velocity, damage everything standing in fire, draw everything that has a","type":"text"},{"text":" ","type":"text"},{"text":"sprite. A ","type":"text"},{"inlineContent":[{"text":"query","type":"text"}],"type":"emphasis"},{"text":" describes which entities such a loop visits and which components it reads. A","type":"text"},{"text":" ","type":"text"},{"text":"world answers a query with a lazy view of the matching entities, and an ","type":"text"},{"inlineContent":[{"type":"text","text":"update"}],"type":"emphasis"},{"text":" uses the same","type":"text"},{"text":" ","type":"text"},{"text":"description to change components where they’re stored.","type":"text"}],"type":"paragraph"},{"level":3,"type":"heading","anchor":"Read-the-entities-that-hold-a-set-of-components","text":"Read the entities that hold a set of components"},{"inlineContent":[{"type":"text","text":"Pass component types to a world’s "},{"code":"query(_:)","type":"codeVoice"},{"type":"text","text":" method to visit every entity that holds all of"},{"type":"text","text":" "},{"type":"text","text":"them. Each row is a tuple of the entity, labeled "},{"code":"entity","type":"codeVoice"},{"type":"text","text":", followed by one component per type, in"},{"type":"text","text":" "},{"type":"text","text":"the order you listed them:"}],"type":"paragraph"},{"type":"codeListing","syntax":"swift","code":["var world = World()","world.spawn(Name(value: \"comet\"), Position(x: 1, y: 2), Velocity(dx: 3, dy: 4))","world.spawn(Name(value: \"rock\"), Position(x: 0, y: 0))","","for (_, name, position, velocity) in world.query(Name.self, Position.self, Velocity.self) {","    print(name.value, position.x + velocity.dx)","    \/\/ Prints \"comet 4.0\"","}"]},{"inlineContent":[{"type":"text","text":"The rock has no velocity, so the query skips it."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"Only the entity is labeled, because a tuple’s labels can’t be named after its element types. To"},{"type":"text","text":" "},{"type":"text","text":"work with rows in a closure, such as when you sort or filter them, name the components by"},{"type":"text","text":" "},{"type":"text","text":"destructuring the row rather than reaching for them by position:"}],"type":"paragraph"},{"type":"codeListing","syntax":"swift","code":["var world = World()","world.spawn(Name(value: \"comet\"), Health(current: 3))","world.spawn(Name(value: \"moon\"), Health(current: 9))","","let strongest = world.query(Name.self, Health.self)","    .sorted { first, second in","        let (_, _, firstHealth) = first","        let (_, _, secondHealth) = second","        return firstHealth.current > secondHealth.current","    }","    .map { (_, name, _) in name.value }","print(strongest)","\/\/ Prints \"[\"moon\", \"comet\"]\""]},{"inlineContent":[{"type":"text","text":"A view is a snapshot of the world at the moment you asked for it. Changing the world while you"},{"type":"text","text":" "},{"type":"text","text":"iterate the view doesn’t change the rows it shows, so you can despawn entities or insert"},{"type":"text","text":" "},{"type":"text","text":"components from inside the loop."}],"type":"paragraph"},{"level":3,"type":"heading","anchor":"Narrow-a-query-with-a-filter","text":"Narrow a query with a filter"},{"inlineContent":[{"type":"text","text":"Some conditions matter without your needing to read the component. A "},{"type":"emphasis","inlineContent":[{"type":"text","text":"filter"}]},{"type":"text","text":" adds them:"},{"type":"text","text":" "},{"type":"reference","identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/QueryView\/with(_:)","isActive":true},{"type":"text","text":" requires types, "},{"type":"reference","identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/QueryView\/without(_:)","isActive":true},{"type":"text","text":" excludes them, and"},{"type":"text","text":" "},{"type":"reference","identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/QueryView\/anyOf(_:)","isActive":true},{"type":"text","text":" requires an entity to pass at least one of several filters. The rows still"},{"type":"text","text":" "},{"type":"text","text":"carry only the components you asked to read:"}],"type":"paragraph"},{"type":"codeListing","syntax":"swift","code":["var world = World()","world.spawn(Name(value: \"comet\"), Velocity(dx: 1, dy: 0))","world.spawn(Name(value: \"statue\"), Velocity(dx: 1, dy: 0), Frozen())","world.spawn(Name(value: \"rock\"))","","var moving: [String] = []","for (_, name) in world.query(Name.self).with(Velocity.self).without(Frozen.self) {","    moving.append(name.value)","}","print(moving)","\/\/ Prints \"[\"comet\"]\"","","let still = world.query(Name.self).anyOf(.with(Frozen.self), .without(Velocity.self))","print(still.count)","\/\/ Prints \"2\""]},{"inlineContent":[{"text":"A ","type":"text"},{"identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/QueryFilter","isActive":true,"type":"reference"},{"text":" is a value of its own, so you can build one once and apply it with","type":"text"},{"text":" ","type":"text"},{"identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/QueryView\/filtered(by:)","isActive":true,"type":"reference"},{"text":", ","type":"text"},{"identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/Query\/filtered(by:)","isActive":true,"type":"reference"},{"text":", or the ","type":"text"},{"code":"where","type":"codeVoice"},{"text":" argument of an update.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"To visit entities without reading any component, call "},{"type":"codeVoice","code":"query()"},{"type":"text","text":" with no types and narrow the"},{"type":"text","text":" "},{"isActive":true,"type":"reference","identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/EntityQueryView"},{"type":"text","text":" it returns:"}],"type":"paragraph"},{"type":"codeListing","syntax":"swift","code":["var world = World()","world.spawn(Position(x: 0, y: 0), Frozen())","world.spawn(Position(x: 1, y: 1))","","for entity in world.query().with(Frozen.self) {","    world.remove(Frozen.self, from: entity)","}","print(world.query().with(Frozen.self).count)","\/\/ Prints \"0\""]},{"level":3,"type":"heading","anchor":"Describe-a-query-once-with-a-query-value","text":"Describe a query once with a query value"},{"inlineContent":[{"text":"A ","type":"text"},{"identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/Query","type":"reference","isActive":true},{"text":" holds a query’s terms and filter as a value that doesn’t belong to any world. Store it,","type":"text"},{"text":" ","type":"text"},{"text":"compare it with another, and run it against any world:","type":"text"}],"type":"paragraph"},{"type":"codeListing","syntax":"swift","code":["let movers = Query(Position.self, Velocity.self).without(Frozen.self)","","var level = World()","level.spawn(Position(x: 0, y: 0), Velocity(dx: 1, dy: 0))","level.spawn(Position(x: 0, y: 0), Velocity(dx: 1, dy: 0), Frozen())","","var copy = level","copy.spawn(Position(x: 3, y: 3), Velocity(dx: 0, dy: 1))","","print(level.query(movers).count, copy.query(movers).count)","\/\/ Prints \"1 2\""]},{"level":3,"type":"heading","anchor":"Match-any-of-several-components","text":"Match any of several components"},{"inlineContent":[{"text":"A query’s terms can include an ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/AnyOf"},{"text":" group. An entity matches the group when it holds at least","type":"text"},{"text":" ","type":"text"},{"text":"one of its types, and the row holds a tuple with one optional per type, ","type":"text"},{"code":"nil","type":"codeVoice"},{"text":" where the entity","type":"text"},{"text":" ","type":"text"},{"text":"lacks that type. The following example adds up the forces that push each entity, whichever of","type":"text"},{"text":" ","type":"text"},{"text":"wind and thrust it feels (","type":"text"},{"code":"Wind","type":"codeVoice"},{"text":" and ","type":"text"},{"code":"Thrust","type":"codeVoice"},{"text":" are components with a ","type":"text"},{"code":"force","type":"codeVoice"},{"text":" property):","type":"text"}],"type":"paragraph"},{"type":"codeListing","syntax":"swift","code":["var world = World()","world.spawn(Name(value: \"kite\"), Wind(force: 3))","world.spawn(Name(value: \"rocket\"), Thrust(force: 5), Wind(force: 1))","world.spawn(Name(value: \"rock\"))","","var forces: [String] = []","for (_, name, (wind, thrust)) in world.query(Query(Name.self, AnyOf<Wind, Thrust>.self)) {","    forces.append(\"\\(name.value): \\((wind?.force ?? 0) + (thrust?.force ?? 0))\")","}","print(forces)","\/\/ Prints \"[\"kite: 3.0\", \"rocket: 6.0\"]\""]},{"inlineContent":[{"type":"text","text":"The rock holds neither type, so the query skips it."}],"type":"paragraph"},{"level":3,"type":"heading","anchor":"Change-components-in-place","text":"Change components in place"},{"inlineContent":[{"text":"To change components while you visit them, use an update instead of a view. The method visits","type":"text"},{"text":" ","type":"text"},{"text":"every entity that holds the component you change and the components you read. Its closure receives","type":"text"},{"text":" ","type":"text"},{"text":"the component to change as an ","type":"text"},{"type":"codeVoice","code":"inout"},{"text":" argument, and a ","type":"text"},{"isActive":true,"identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/QueryRow","type":"reference"},{"text":" carrying the entity and the","type":"text"},{"text":" ","type":"text"},{"text":"components it reads:","type":"text"}],"type":"paragraph"},{"type":"codeListing","syntax":"swift","code":["var world = World()","let comet = world.spawn(Position(x: 0, y: 0), Velocity(dx: 1, dy: 2))","let statue = world.spawn(Position(x: 5, y: 5), Velocity(dx: 1, dy: 1), Frozen())","","world.update(Position.self, reading: Velocity.self, where: .without(Frozen.self)) { position, row in","    position.x += row.components.dx","    position.y += row.components.dy","}","print(world[Position.self, of: comet])","\/\/ Prints \"Position(x: 1.0, y: 2.0)\"","print(world[Position.self, of: statue])","\/\/ Prints \"Position(x: 5.0, y: 5.0)\""]},{"inlineContent":[{"type":"text","text":"An update can change up to three component types at once, and can take a "},{"type":"reference","isActive":true,"identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/Query"},{"type":"text","text":" in place of"},{"type":"text","text":" "},{"type":"text","text":"the types it reads, which lets it read "},{"type":"reference","isActive":true,"identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/AnyOf"},{"type":"text","text":" groups:"}],"type":"paragraph"},{"type":"codeListing","syntax":"swift","code":["var world = World()","let kite = world.spawn(Position(x: 0, y: 0), Wind(force: 2))","let rocket = world.spawn(Position(x: 0, y: 0), Thrust(force: 5))","","world.update(Position.self, over: Query(AnyOf<Wind, Thrust>.self)) { position, row in","    let (wind, thrust) = row.components","    position.x += (wind?.force ?? 0) + (thrust?.force ?? 0)","}","print(world[Position.self, of: kite].x, world[Position.self, of: rocket].x)","\/\/ Prints \"2.0 5.0\""]},{"inlineContent":[{"type":"text","text":"An update can’t read a type it changes, and its closure can’t reach the world while it runs. To"},{"type":"text","text":" "},{"type":"text","text":"spawn, despawn or add components along the way, such as despawning the entities whose health runs"},{"type":"text","text":" "},{"type":"text","text":"out, record the changes in "},{"type":"reference","identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/Commands","isActive":true},{"type":"text","text":" and apply them after the update."}],"type":"paragraph"},{"level":3,"type":"heading","anchor":"Find-what-changed","text":"Find what changed"},{"inlineContent":[{"type":"text","text":"The world stamps every component it adds or changes with its current "},{"identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/World\/changeTick","isActive":true,"type":"reference"},{"type":"text","text":"."},{"type":"text","text":" "},{"type":"text","text":"Filter on those stamps to visit only the entities whose components are new or changed:"},{"type":"text","text":" "},{"identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/Query\/added(_:since:)","isActive":true,"type":"reference"},{"type":"text","text":" passes the entities that gained a component after a tick, and"},{"type":"text","text":" "},{"identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/Query\/changed(_:since:)","isActive":true,"type":"reference"},{"type":"text","text":" the ones whose component was added or changed after it."}],"type":"paragraph"},{"type":"codeListing","syntax":"swift","code":["var world = World()","let hero = world.spawn(Name(value: \"hero\"), Health(current: 10))","world.spawn(Name(value: \"guard\"), Health(current: 8))","","let checkpoint = world.changeTick","world.advanceChangeTick()","world[Health.self, of: hero].current -= 3","","for (_, name, health) in world.query(Name.self, Health.self).changed(Health.self, since: checkpoint) {","    print(name.value, health.current)","    \/\/ Prints \"hero 7\"","}"]},{"inlineContent":[{"type":"text","text":"Without a tick, the filters compare against the world’s "},{"type":"reference","identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/World\/lastRun","isActive":true},{"type":"text","text":". A schedule sets it to"},{"type":"text","text":" "},{"type":"text","text":"the running system’s previous run, so in a system, "},{"type":"codeVoice","code":"changed(Health.self)"},{"type":"text","text":" means “changed since"},{"type":"text","text":" "},{"type":"text","text":"this system last ran”."}],"type":"paragraph"},{"level":3,"type":"heading","anchor":"Filter-in-a-systems-parameters","text":"Filter in a system’s parameters"},{"inlineContent":[{"type":"text","text":"A system receives a query as a parameter, already bound to the world it runs on, and iterates it"},{"type":"text","text":" "},{"type":"text","text":"directly. Because a system’s parameters are types, it names its filter with filter types in"},{"type":"text","text":" "},{"type":"reference","isActive":true,"identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/Query\/Where"},{"type":"text","text":": "},{"type":"reference","isActive":true,"identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/With"},{"type":"text","text":", "},{"type":"reference","isActive":true,"identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/Without"},{"type":"text","text":", "},{"type":"reference","isActive":true,"identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/Added"},{"type":"text","text":", "},{"type":"reference","isActive":true,"identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/Changed"},{"type":"text","text":", "},{"type":"reference","isActive":true,"identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/Allows"},{"type":"text","text":", and "},{"type":"reference","isActive":true,"identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/AnyOf"},{"type":"text","text":" of filter"},{"type":"text","text":" "},{"type":"text","text":"types. For example, a system that visits the entities whose health changed since its previous"},{"type":"text","text":" "},{"type":"text","text":"run, and that aren’t frozen, takes a parameter of type"},{"type":"text","text":" "},{"type":"codeVoice","code":"Query<Health>.Where<Changed<Health>, Without<Frozen>>"},{"type":"text","text":", and iterates it like a view."}],"type":"paragraph"},{"level":3,"type":"heading","anchor":"Speed-up-frequent-queries","text":"Speed up frequent queries"},{"inlineContent":[{"type":"text","text":"A query of several types walks the storage of the type the fewest entities hold, and looks each"},{"type":"text","text":" "},{"type":"text","text":"entity up in the others. Three tools make frequent visits cheaper. None of them changes which"},{"type":"text","text":" "},{"type":"text","text":"entities a query finds, only how it finds them."}],"type":"paragraph"},{"inlineContent":[{"text":"A ","type":"text"},{"inlineContent":[{"type":"text","text":"group"}],"type":"emphasis"},{"text":", made with ","type":"text"},{"code":"group(_:)","type":"codeVoice"},{"text":", keeps a set of component types packed in the same order, so a","type":"text"},{"text":" ","type":"text"},{"text":"query or update of exactly those types walks them side by side with no lookups. Group the types","type":"text"},{"text":" ","type":"text"},{"text":"you visit together on every step:","type":"text"}],"type":"paragraph"},{"type":"codeListing","syntax":"swift","code":["var world = World()","let comet = world.spawn(Position(x: 0, y: 0), Velocity(dx: 1, dy: 0))","world.group(Position.self, Velocity.self)","","world.update(Position.self, reading: Velocity.self) { position, row in","    position.x += row.components.dx","}","print(world[Position.self, of: comet].x)","\/\/ Prints \"1.0\""]},{"inlineContent":[{"type":"text","text":"A "},{"inlineContent":[{"type":"text","text":"cached query"}],"type":"emphasis"},{"type":"text","text":", made with "},{"type":"codeVoice","code":"cache(_:)"},{"type":"text","text":", keeps a list of the entities that match a query’s"},{"type":"text","text":" "},{"type":"text","text":"structure. A visit whose conditions imply the cache’s walks that list instead of a whole column."},{"type":"text","text":" "},{"type":"text","text":"Cache a query you run often that excludes most of the entities it would otherwise walk:"}],"type":"paragraph"},{"type":"codeListing","syntax":"swift","code":["var world = World()","for index in 0 ..< 10 {","    world.spawn(Position(x: Double(index), y: 0), Velocity(dx: 1, dy: 0), Asleep())","}","world.spawn(Position(x: 0, y: 0), Velocity(dx: 1, dy: 0))","","let awake = Query(Position.self, Velocity.self).without(Asleep.self)","world.cache(awake)","print(world.query(awake).count)","\/\/ Prints \"1\""]},{"inlineContent":[{"text":"A ","type":"text"},{"type":"emphasis","inlineContent":[{"type":"text","text":"value index"}]},{"text":", made with ","type":"text"},{"code":"index(_:)","type":"codeVoice"},{"text":", maps each value of a ","type":"text"},{"code":"Hashable","type":"codeVoice"},{"text":" component type to the","type":"text"},{"text":" ","type":"text"},{"text":"entities holding it, so ","type":"text"},{"code":"lookup(_:)","type":"codeVoice"},{"text":" finds them without walking the type’s storage. Index a type","type":"text"},{"text":" ","type":"text"},{"text":"you look entities up by and whose values change rarely, such as a name:","type":"text"}],"type":"paragraph"},{"type":"codeListing","syntax":"swift","code":["var world = World()","let ada = world.spawn(Name(value: \"ada\"), Health(current: 3))","world.spawn(Name(value: \"bob\"), Health(current: 4))","world.index(Name.self)","","print(world.lookup(Name(value: \"ada\")) == [ada])","\/\/ Prints \"true\""]},{"inlineContent":[{"type":"text","text":"To find entities by one property of a component rather than by the whole value, index the"},{"type":"text","text":" "},{"type":"text","text":"property’s key path and look it up with "},{"type":"codeVoice","code":"lookup(_:equals:)"},{"type":"text","text":". The component type doesn’t need to"},{"type":"text","text":" "},{"type":"text","text":"be "},{"type":"codeVoice","code":"Hashable"},{"type":"text","text":", only the property:"}],"type":"paragraph"},{"type":"codeListing","syntax":"swift","code":["struct Berth: Component { var dock: Int, number: Int }","","var world = World()","let ferry = world.spawn(Berth(dock: 2, number: 14))","world.spawn(Berth(dock: 3, number: 9))","world.index(\\Berth.number)","","print(world.lookup(\\Berth.number, equals: 14) == [ferry])","\/\/ Prints \"true\""]}]}],"identifier":{"url":"doc:\/\/WorldModule\/documentation\/WorldModule\/QueryingAWorld","interfaceLanguage":"swift"},"hierarchy":{"paths":[["doc:\/\/WorldModule\/documentation\/WorldModule"]]},"kind":"article","sections":[],"abstract":[{"type":"text","text":"Find the entities that hold the components you need, read those components, and change them in place."}],"references":{"doc://WorldModule/documentation/WorldModule/QueryView/with(_:)":{"abstract":[{"text":"Returns a view that also requires every one of the given component types.","type":"text"}],"role":"symbol","identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/QueryView\/with(_:)","title":"with(_:)","url":"\/documentation\/worldmodule\/queryview\/with(_:)","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"with"},{"kind":"text","text":"<each "},{"kind":"genericParameter","text":"F"},{"kind":"text","text":">(repeat (each "},{"kind":"typeIdentifier","text":"F"},{"kind":"text","text":").Type) -> "},{"preciseIdentifier":"s:11WorldModule9QueryViewV","kind":"typeIdentifier","text":"QueryView"},{"kind":"text","text":"<repeat each "},{"kind":"typeIdentifier","text":"C"},{"kind":"text","text":">"}],"kind":"symbol","type":"topic"},"doc://WorldModule/documentation/WorldModule/QueryView/filtered(by:)":{"url":"\/documentation\/worldmodule\/queryview\/filtered(by:)","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"filtered","kind":"identifier"},{"text":"(","kind":"text"},{"text":"by","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"QueryFilter","kind":"typeIdentifier","preciseIdentifier":"s:11WorldModule11QueryFilterV"},{"text":") -> ","kind":"text"},{"text":"QueryView","kind":"typeIdentifier","preciseIdentifier":"s:11WorldModule9QueryViewV"},{"text":"<repeat each ","kind":"text"},{"text":"C","kind":"typeIdentifier"},{"text":">","kind":"text"}],"type":"topic","role":"symbol","kind":"symbol","abstract":[{"type":"text","text":"Returns a view that also requires every condition of the given filter."}],"title":"filtered(by:)","identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/QueryView\/filtered(by:)"},"doc://WorldModule/documentation/WorldModule/Commands":{"role":"symbol","abstract":[{"type":"text","text":"A buffer of changes to a world, recorded now and applied later in the order they were"},{"type":"text","text":" "},{"type":"text","text":"recorded."}],"type":"topic","kind":"symbol","title":"Commands","url":"\/documentation\/worldmodule\/commands","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Commands","kind":"identifier"}],"navigatorTitle":[{"text":"Commands","kind":"identifier"}],"identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/Commands"},"doc://WorldModule/documentation/WorldModule/AnyOf":{"kind":"symbol","url":"\/documentation\/worldmodule\/anyof","identifier