ery":{"role":"symbol","type":"topic","identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/Query","kind":"symbol","abstract":[{"text":"A description of the entities to visit and the components to read from each.","type":"text"}],"url":"\/documentation\/worldmodule\/query","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"Query"}],"navigatorTitle":[{"kind":"identifier","text":"Query"}],"title":"Query"},"doc://WorldModule/documentation/WorldModule/ChangeTick":{"url":"\/documentation\/worldmodule\/changetick","kind":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"ChangeTick"}],"identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/ChangeTick","type":"topic","title":"ChangeTick","abstract":[{"type":"text","text":"A point in a world’s history of changes."}],"role":"symbol","navigatorTitle":[{"kind":"identifier","text":"ChangeTick"}]},"doc://WorldModule/documentation/WorldModule":{"role":"collection","type":"topic","identifier":"doc:\/\/WorldModule\/documentation\/WorldModule","url":"\/documentation\/worldmodule","abstract":[{"type":"text","text":"Store the state of a game or simulation as entities and components, and read and change it with"},{"type":"text","text":" "},{"type":"text","text":"queries, updates, and commands."}],"kind":"symbol","title":"WorldModule"},"doc://WorldModule/documentation/WorldModule/World/trigger(_:on:)":{"role":"symbol","type":"topic","identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/World\/trigger(_:on:)","kind":"symbol","abstract":[{"type":"text","text":"Triggers an event on an entity, running its observers before returning."}],"url":"\/documentation\/worldmodule\/world\/trigger(_:on:)","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"trigger"},{"kind":"text","text":"<"},{"kind":"genericParameter","text":"E"},{"kind":"text","text":">("},{"text"