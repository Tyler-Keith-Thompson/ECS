ype, dropping the events sent before the previous"},{"type":"text","text":" "},{"type":"text","text":"update."}],"type":"topic","title":"updateEvents()"},"doc://WorldModule/documentation/WorldModule/Event":{"fragments":[{"kind":"keyword","text":"protocol"},{"kind":"text","text":" "},{"kind":"identifier","text":"Event"}],"kind":"symbol","navigatorTitle":[{"kind":"identifier","text":"Event"}],"url":"\/documentation\/worldmodule\/event","type":"topic","role":"symbol","title":"Event","identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/Event","abstract":[{"text":"A type that describes a message one part of a program sends and other parts read later.","type":"text"}]},"doc://WorldModule/documentation/WorldModule/World/send(_:)":{"fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"send"},{"kind":"text","text":"<"},{"kind":"genericParameter","text":"E"},{"kind":"text","text":">("},{"kind":"typeIdentifier","text":"E"},{"kind":"text","text":")"}],"kind":"symbol","url":"\/documentation\/worldmodule\/world\/send(_:)","type":"topic","role":"symbol","title":"send(_:)","abstract":[{"type":"text","text":"Sends an event for readers of its type."}],"identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/World\/send(_:)"},"doc://WorldModule/documentation/WorldModule/ChildOf":{"url":"\/documentation\/worldmodule\/childof","kind":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"ChildOf"}],"identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/ChildOf","type":"topic","title":"ChildOf","abstract":[{"text":"The relation that links a child entity to its parent.","type":"text"}],"role":"symbol","navigatorTitle":[{"kind":"identifier","text":"ChildOf"}]},"doc://WorldModule/documentation/WorldModule/World/readEvents(_:by:)":{"fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"readEvents"},{"kind":"text","tex