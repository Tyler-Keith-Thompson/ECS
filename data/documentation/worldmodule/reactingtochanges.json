ny hold the type."}],"type":"topic","title":"trackChanges(of:)"},"doc://WorldModule/documentation/WorldModule/World/changeTick":{"fragments":[{"kind":"keyword","text":"var"},{"kind":"text","text":" "},{"kind":"identifier","text":"changeTick"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:11WorldModule10ChangeTickV","text":"ChangeTick"}],"kind":"symbol","url":"\/documentation\/worldmodule\/world\/changetick","type":"topic","role":"symbol","title":"changeTick","identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/World\/changeTick","abstract":[{"type":"text","text":"The tick the world stamps on every component it adds or changes."}]},"doc://WorldModule/documentation/WorldModule/World/removed(_:by:)":{"role":"symbol","url":"\/documentation\/worldmodule\/world\/removed(_:by:)","kind":"symbol","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"removed","kind":"identifier"},{"text":"<","kind":"text"},{"kind":"genericParameter","text":"C"},{"kind":"text","text":", "},{"kind":"genericParameter","text":"Reader"},{"kind":"text","text":">("},{"kind":"typeIdentifier","text":"C"},{"kind":"text","text":".Type, "},{"kind":"externalParam","text":"by"},{"text":": ","kind":"text"},{"text":"Reader","kind":"typeIdentifier"},{"text":".Type) -> [","kind":"text"},{"text":"Entity","kind":"typeIdentifier","preciseIdentifier":"s:11WorldModule6EntityV"},{"text":"]","kind":"text"}],"type":"topic","identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/World\/removed(_:by:)","title":"removed(_:by:)","abstract":[{"type":"text","text":"Returns the entities that lost a component of the given type since a reader last asked,"},{"type":"text","text":" "},{"type":"text","text":"oldest first."}]},"doc://WorldModule/documentation/WorldModule/World/observe(_:on:perform:)":{"fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"observe"},{"kind":"text","text":"<"},{"text":"E","kind":