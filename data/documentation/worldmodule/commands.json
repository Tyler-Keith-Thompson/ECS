{"hierarchy":{"paths":[["doc:\/\/WorldModule\/documentation\/WorldModule"]]},"kind":"symbol","sections":[],"metadata":{"fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"Commands"}],"modules":[{"name":"WorldModule"}],"roleHeading":"Structure","symbolKind":"struct","remoteSource":{"url":"https:\/\/github.com\/Tyler-Keith-Thompson\/ECS\/blob\/main\/Sources\/WorldModule\/Commands.swift#L55","fileName":"Commands.swift"},"externalID":"s:11WorldModule8CommandsV","navigatorTitle":[{"kind":"identifier","text":"Commands"}],"title":"Commands","role":"symbol"},"schemaVersion":{"major":0,"minor":3,"patch":0},"abstract":[{"type":"text","text":"A buffer of changes to a world, recorded now and applied later in the order they were"},{"type":"text","text":" "},{"type":"text","text":"recorded."}],"topicSections":[{"anchor":"Creating-a-Command-Buffer","identifiers":["doc:\/\/WorldModule\/documentation\/WorldModule\/Commands\/init()"],"title":"Creating a Command Buffer"},{"anchor":"Inspecting-a-Command-Buffer","identifiers":["doc:\/\/WorldModule\/documentation\/WorldModule\/Commands\/count","doc:\/\/WorldModule\/documentation\/WorldModule\/Commands\/isEmpty"],"title":"Inspecting a Command Buffer"},{"anchor":"Spawning-and-Despawning-Entities","identifiers":["doc:\/\/WorldModule\/documentation\/WorldModule\/Commands\/spawn(_:)","doc:\/\/WorldModule\/documentation\/WorldModule\/Commands\/clone(_:)","doc:\/\/WorldModule\/documentation\/WorldModule\/Commands\/spawn(from:)","doc:\/\/WorldModule\/documentation\/WorldModule\/Commands\/despawn(_:)"],"title":"Spawning and Despawning Entities"},{"anchor":"Adding-and-Removing-Components","identifiers":["doc:\/\/WorldModule\/documentation\/WorldModule\/Commands\/insert(_:into:)","doc:\/\/WorldModule\/documentation\/WorldModule\/Commands\/remove(_:from:)"],"title":"Adding and Removing Components"},{"anchor":"Changing-the-Hierarchy-and-Relations","identifiers":["doc:\/\/WorldModule\/documentation\/WorldModule\/Commands\/addChild(_:to:)","doc:\/\/WorldModule\/documentation\/WorldModule\/Commands\/removeParent(of:)","doc:\/\/WorldModule\/documentation\/WorldModule\/Commands\/relate(_:_:to:)","doc:\/\/WorldModule\/documentation\/WorldModule\/Commands\/unrelate(_:_:from:)"],"title":"Changing the Hierarchy and Relations"},{"anchor":"Sending-Events","identifiers":["doc:\/\/WorldModule\/documentation\/WorldModule\/Commands\/send(_:)","doc:\/\/WorldModule\/documentation\/WorldModule\/Commands\/trigger(_:on:)"],"title":"Sending Events"},{"anchor":"Changing-Resources","identifiers":["doc:\/\/WorldModule\/documentation\/WorldModule\/Commands\/insert(resource:)"],"title":"Changing Resources"},{"anchor":"Recording-Any-Change","identifiers":["doc:\/\/WorldModule\/documentation\/WorldModule\/Commands\/record(_:)"],"title":"Recording Any Change"}],"variants":[{"paths":["\/documentation\/worldmodule\/commands"],"traits":[{"interfaceLanguage":"swift"}]}],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/WorldModule\/documentation\/WorldModule\/Commands"},"primaryContentSections":[{"declarations":[{"platforms":["Linux"],"tokens":[{"text":"@frozen","kind":"attribute"},{"text":" ","kind":"text"},{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Commands","kind":"identifier"}],"languages":["swift"]}],"kind":"declarations"},{"mentions":["doc:\/\/WorldModule\/documentation\/WorldModule\/QueryingAWorld"],"kind":"mentions"},{"content":[{"anchor":"overview","type":"heading","text":"Overview","level":2},{"type":"paragraph","inlineContent":[{"text":"While a query or an update visits a world’s entities, the world can’t be changed in other","type":"text"},{"text":" ","type":"text"},{"text":"ways: spawning or despawning an entity, or adding or removing a component, would disturb the","type":"text"},{"text":" ","type":"text"},{"text":"storage being visited. Record such changes in a command buffer instead, and apply them with","type":"text"},{"text":" ","type":"text"},{"isActive":true,"identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/World\/apply(_:)","type":"reference"},{"text":" once the visit is over. The following example despawns every entity whose","type":"text"},{"text":" ","type":"text"},{"text":"health has run out:","type":"text"}]},{"code":["var world = World()","world.spawn(Health(current: 0))","world.spawn(Health(current: 10))","","var commands = Commands()","for (entity, health) in world.query(Health.self) where health.current <= 0 {","    commands.despawn(entity)","}","world.apply(commands)","","print(world.count)","\/\/ Prints \"1\""],"type":"codeListing","syntax":"swift"},{"type":"paragraph","inlineContent":[{"type":"text","text":"A command on an entity that is no longer live when it applies does nothing, so two commands"},{"type":"text","text":" "},{"type":"text","text":"that despawn the same entity are safe."}]},{"anchor":"Naming-Entities-That-Commands-Will-Spawn","type":"heading","text":"Naming Entities That Commands Will Spawn","level":3},{"type":"paragraph","inlineContent":[{"type":"reference","identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/Commands\/spawn(_:)","isActive":true},{"type":"text","text":" returns a placeholder handle for the entity it will create. Later commands in the"},{"type":"text","text":" "},{"type":"text","text":"same buffer can name that placeholder, and "},{"type":"reference","identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/World\/apply(_:)","isActive":true},{"type":"text","text":" returns the real handles of the"},{"type":"text","text":" "},{"type":"text","text":"entities it spawned, in the order their commands were recorded:"}]},{"code":["var world = World()","var commands = Commands()","let ship = commands.spawn(Position(x: 0, y: 0))","let turret = commands.spawn(Position(x: 1, y: 0))","commands.addChild(turret, to: ship)","","let spawned = world.apply(commands)","print(world.parent(of: spawned[1]) == spawned[0])","\/\/ Prints \"true\""],"type":"codeListing","syntax":"swift"},{"type":"paragraph","inlineContent":[{"text":"A placeholder stands for its entity only inside the buffer that returned it; the world holds no","type":"text"},{"text":" ","type":"text"},{"text":"entity with that handle.","type":"text"}]},{"anchor":"Commands-from-Systems","type":"heading","text":"Commands from Systems","level":3},{"type":"paragraph","inlineContent":[{"text":"A system running alongside others can’t apply commands itself, because applying them would","type":"text"},{"text":" ","type":"text"},{"text":"change entities the other systems are reading. It queues them with ","type":"text"},{"isActive":true,"identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/World\/queue(_:)","type":"reference"},{"text":" ","type":"text"},{"text":"instead, and the schedule applies every queued buffer at the end of each wave of systems.","type":"text"}]}],"kind":"content"}],"relationshipsSections":[{"title":"Conforms To","type":"conformsTo","identifiers":["doc:\/\/WorldModule\/s8SendableP","doc:\/\/WorldModule\/s16SendableMetatypeP"],"kind":"relationships"}],"references":{"doc://WorldModule/documentation/WorldModule":{"abstract":[{"type":"text","text":"Store the state of a game or simulation as entities and components, and read and change it with"},{"type":"text","text":" "},{"type":"text","text":"queries, updates, and commands."}],"url":"\/documentation\/worldmodule","identifier":"doc:\/\/WorldModule\/documentation\/WorldModule","role":"collection","type":"topic","title":"WorldModule","kind":"symbol"},"doc://WorldModule/documentation/WorldModule/World/trigger(_:on:)":{"type":"topic","role":"symbol","abstract":[{"type":"text","text":"Triggers an event on an entity, running its observers before returning."}],"fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"trigger"},{"kind":"text","text":"<"},{"kind":"genericParameter","text":"E"},{"kind":"text","text":">("},{"kind":"typeIdentifi