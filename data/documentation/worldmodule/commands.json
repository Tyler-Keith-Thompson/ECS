ts","identifiers":["doc:\/\/WorldModule\/documentation\/WorldModule\/Commands\/send(_:)","doc:\/\/WorldModule\/documentation\/WorldModule\/Commands\/trigger(_:on:)"]},{"title":"Changing Resources","anchor":"Changing-Resources","identifiers":["doc:\/\/WorldModule\/documentation\/WorldModule\/Commands\/insert(resource:)"]},{"title":"Recording Any Change","anchor":"Recording-Any-Change","identifiers":["doc:\/\/WorldModule\/documentation\/WorldModule\/Commands\/record(_:)"]}],"abstract":[{"type":"text","text":"A buffer of changes to a world, recorded now and applied later in the order they were"},{"type":"text","text":" "},{"type":"text","text":"recorded."}],"schemaVersion":{"major":0,"minor":3,"patch":0},"metadata":{"fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Commands","kind":"identifier"}],"remoteSource":{"fileName":"Commands.swift","url":"https:\/\/github.com\/Tyler-Keith-Thompson\/ECS\/blob\/main\/Sources\/WorldModule\/Commands.swift#L55"},"externalID":"s:11WorldModule8CommandsV","roleHeading":"Structure","title":"Commands","modules":[{"name":"WorldModule"}],"role":"symbol","navigatorTitle":[{"text":"Commands","kind":"identifier"}],"symbolKind":"struct"},"variants":[{"paths":["\/documentation\/worldmodule\/commands"],"traits":[{"interfaceLanguage":"swift"}]}],"sections":[],"primaryContentSections":[{"kind":"declarations","declarations":[{"languages":["swift"],"platforms":["Linux"],"tokens":[{"text":"@frozen","kind":"attribute"},{"text":" ","kind":"text"},{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Commands","kind":"identifier"}]}]},{"mentions":["doc:\/\/WorldModule\/documentation\/WorldModule\/QueryingAWorld"],"kind":"mentions"},{"kind":"content","content":[{"type":"heading","text":"Overview","anchor":"overview","level":2},{"type":"paragraph","inlineContent":[{"type":"text","text":"While a query or an update visits a world’s entities, the world can’t be changed in other"},{"type":"text","text":" "},{"type":"text","text":"ways: spawning or despawning an entity, or adding or removing a component, would disturb the"},{"type":"text","text":" "},{"type":"text","text":"storage being visited. Record such changes in a command buffer instead, and apply them with"},{"type":"text","text":" "},{"identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/World\/apply(_:)","type":"reference","isActive":true},{"type":"text","text":" once the visit is over. The following example despawns every entity whose"},{"type":"text","text":" "},{"type":"text","text":"health has run out:"}]},{"type":"codeListing","code":["var world = World()","world.spawn(Health(current: 0))","world.spawn(Health(current: 10))","","var commands = Commands()","for (entity, health) in world.query(Health.self) where health.current <= 0 {","    commands.despawn(entity)","}","world.apply(commands)","","print(world.count)","\/\/ Prints \"1\""],"syntax":"swift"},{"type":"paragraph","inlineContent":[{"type":"text","text":"A command on an entity that is no longer live when it applies does nothing, so two commands"},{"type":"text","text":" "},{"type":"text","text":"that despawn the same entity are safe."}]},{"type":"heading","text":"Naming Entities That Commands Will Spawn","anchor":"Naming-Entities-That-Commands-Will-Spawn","level":3},{"type":"paragraph","inlineContent":[{"identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/Commands\/spawn(_:)","type":"reference","isActive":true},{"type":"text","text":" returns a placeholder handle for the entity it will create. Later commands in the"},{"type":"text","text":" "},{"type":"text","text":"same buffer can name that placeholder, and "},{"identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/World\/apply(_:)","type":"reference","isActive":true},{"type":"text","text":" returns the real handles of the"},{"type":"text","text":" "},{"type":"text","text":"entities it spawned, in the order their commands were recorded:"}]},{"type":"codeListing","code":["var world = World()","var commands = Commands()","let ship = commands.spawn(Position(x: 0, y: 0))","let turret = commands.spawn(Position(x: 1, y: 0))","commands.addChild(turret, to: ship)","","let spawned = world.apply(commands)","print(world.parent(of: spawned[1]) == spawned[0])","\/\/ Prints \"true\""],"syntax":"swift"},{"type":"paragraph","inlineContent":[{"type":"text","text":"A placeholder stands for its entity only inside the buffer that returned it; the world holds no"},{"type":"text","text":" "},{"type":"text","text":"entity with that handle."}]},{"type":"heading","text":"Commands from Systems","anchor":"Commands-from-Systems","level":3},{"type":"paragraph","inlineContent":[{"type":"text","text":"A system running alongside others can’t apply commands itself, because applying them would"},{"type":"text","text":" "},{"type":"text","text":"change entities the other systems are reading. It queues them with "},{"identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/World\/queue(_:)","type":"reference","isActive":true},{"type":"text","text":" "},{"type":"text","text":"instead, and the schedule applies every queued buffer at the end of each wave of systems."}]}]}],"references":{"doc://WorldModule/documentation/WorldModule/World/unrelate(_:_:from:)":{"fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"unrelate"},{"kind":"text","text":"<"},{"kind":"genericParameter","text":"R"},{"kind":"text","text":">("},{"kind":"typeIdentifier","text":"Entity","preciseIdentifier":"s:11WorldModule6EntityV"},{"kind":"text","text":", "},{"kind":"typeIdentifier","text":"R"},{"kind":"text","text":".Type, "},{"kind":"externalParam","text":"from"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"Entity","preciseIdentifier":"s:11WorldModule6EntityV"},{"text":") -> ","kind":"text"},{"text":"R","kind":"typeIdentifier"},{"text":"?","kind":"text"}],"abstract":[{"type":"text","text":"Removes the link between a source entity and