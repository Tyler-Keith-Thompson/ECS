{"kind":"symbol","sections":[],"topicSections":[{"title":"Creating a Command Buffer","anchor":"Creating-a-Command-Buffer","identifiers":["doc:\/\/WorldModule\/documentation\/WorldModule\/Commands\/init()"]},{"title":"Inspecting a Command Buffer","anchor":"Inspecting-a-Command-Buffer","identifiers":["doc:\/\/WorldModule\/documentation\/WorldModule\/Commands\/count","doc:\/\/WorldModule\/documentation\/WorldModule\/Commands\/isEmpty"]},{"title":"Spawning and Despawning Entities","anchor":"Spawning-and-Despawning-Entities","identifiers":["doc:\/\/WorldModule\/documentation\/WorldModule\/Commands\/spawn(_:)","doc:\/\/WorldModule\/documentation\/WorldModule\/Commands\/clone(_:)","doc:\/\/WorldModule\/documentation\/WorldModule\/Commands\/spawn(from:)","doc:\/\/WorldModule\/documentation\/WorldModule\/Commands\/despawn(_:)"]},{"title":"Adding and Removing Components","anchor":"Adding-and-Removing-Components","identifiers":["doc:\/\/WorldModule\/documentation\/WorldModule\/Commands\/insert(_:into:)","doc:\/\/WorldModule\/documentation\/WorldModule\/Commands\/remove(_:from:)"]},{"title":"Changing the Hierarchy and Relations","anchor":"Changing-the-Hierarchy-and-Relations","identifiers":["doc:\/\/WorldModule\/documentation\/WorldModule\/Commands\/addChild(_:to:)","doc:\/\/WorldModule\/documentation\/WorldModule\/Commands\/spawn(_:childOf:)","doc:\/\/WorldModule\/documentation\/WorldModule\/Commands\/removeParent(of:)","doc:\/\/WorldModule\/documentation\/WorldModule\/Commands\/relate(_:_:to:)","doc:\/\/WorldModule\/documentation\/WorldModule\/Commands\/unrelate(_:_:from:)"]},{"title":"Sending Events","anchor":"Sending-Events","identifiers":["doc:\/\/WorldModule\/documentation\/WorldModule\/Commands\/send(_:)","doc:\/\/WorldModule\/documentation\/WorldModule\/Commands\/trigger(_:on:)"]},{"title":"Changing Resources","anchor":"Changing-Resources","identifiers":["doc:\/\/WorldModule\/documentation\/WorldModule\/Commands\/insert(resource:)"]},{"title":"Recording Any Change","anchor":"Recording-Any-Change","identifiers":["doc:\/\/WorldModule\/documentation\/WorldModule\/Commands\/record(_:)"]}],"abstract":[{"type":"text","text":"A buffer of changes to a world, recorded now and applied later in the order they were"},{"type":"text","text":" "},{"type":"text","text":"recorded."}],"primaryContentSections":[{"kind":"declarations","declarations":[{"tokens":[{"kind":"attribute","text":"@frozen"},{"kind":"text","text":" "},{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"Commands"}],"languages":["swift"],"platforms":["Linux"]}]},{"kind":"mentions","mentions":["doc:\/\/WorldModule\/documentation\/WorldModule\/QueryingAWorld"]},{"kind":"content","content":[{"text":"Overview","type":"heading","anchor":"overview","level":2},{"inlineContent":[{"text":"While a query or an update visits a world’s entities, the world can’t be changed in other","type":"text"},{"text":" ","type":"text"},{"text":"ways: spawning or despawning an entity, or adding or removing a component, would disturb the","type":"text"},{"text":" ","type":"text"},{"text":"storage being visited. Record such changes in a command buffer instead, and apply them with","type":"text"},{"text":" ","type":"text"},{"identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/World\/apply(_:)","isActive":true,"type":"reference"},{"text":" once the visit is over. The following example despawns every entity whose","type":"text"},{"text":" ","type":"text"},{"text":"health has run out:","type":"text"}],"type":"paragraph"},{"type":"codeListing","syntax":"swift","code":["var world = World()","world.spawn(Health(current: 0))","world.spawn(Health(current: 10))","","var commands = Commands()","for (entity, health) in world.query(Health.self) where health.current <= 0 {","    commands.despawn(entity)","}","world.apply(commands)","","print(world.count)","\/\/ Prints \"1\""]},{"inlineContent":[{"type":"text","text":"A command on an entity that is no longer live when it applies does nothing, so two commands"},{"type":"text","text":" "},{"type":"text","text":"that despawn the same entity are safe."}],"type":"paragraph"},{"text":"Naming Entities That Commands Will Spawn","type":"heading","anchor":"Naming-Entities-That-Commands-Will-Spawn","level":3},{"inlineContent":[{"type":"reference","identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/Commands\/spawn(_:)","isActive":true},{"type":"text","text":" returns a placeholder handle for the entity it will create. Later commands in the"},{"type":"text","text":" "},{"type":"text","text":"same buffer can name that placeholder, and "},{"type":"reference","identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/World\/apply(_:)","isActive":true},{"type":"text","text":" returns the real handles of the"},{"type":"text","text":" "},{"type":"text","text":"entities it spawned, in the order their commands were recorded:"}],"type":"paragraph"},{"type":"codeListing","syntax":"swift","code":["var world = World()","var commands = Commands()","let ship = commands.spawn(Position(x: 0, y: 0))","let turret = commands.spawn(Position(x: 1, y: 0))","commands.addChild(turret, to: ship)","","let spawned = world.apply(commands)","print(world.parent(of: spawned[1]) == spawned[0])","\/\/ Prints \"true\""]},{"inlineContent":[{"text":"A placeholder stands for its entity only inside the buffer that returned it; the world holds no","type":"text"},{"text":" ","type":"text"},{"text":"entity with that handle.","type":"text"}],"type":"paragraph"},{"text":"Commands from Systems","type":"heading","anchor":"Commands-from-Systems","level":3},{"inlineContent":[{"text":"A system running alongside others can’t apply commands itself, because applying them would","type":"text"},{"text":" ","type":"text"},{"text":"change entities the other systems are reading. It queues them with ","type":"text"},{"identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/World\/queue(_:)","isActive":true,"type":"reference"},{"text":" ","type":"text"},{"text":"instead, and the schedule applies every queued buffer at the end of each wave of systems.","type":"text"}],"type":"paragraph"}]}],"schemaVersion":{"patch":0,"major":0,"minor":3},"hierarchy":{"paths":[["doc:\/\/WorldModule\/documentation\/WorldModule"]]},"variants":[{"paths":["\/documentation\/worldmodule\/commands"],"traits":[{"interfaceLanguage":"swift"}]}],"metadata":{"modules":[{"name":"WorldModule"}],"roleHeading":"Structure","role":"symbol","externalID":"s:11WorldModule8CommandsV","remoteSource":{"url":"https:\/\/github.com\/Tyler-Keith-Thompson\/ECS\/blob\/main\/Sources\/WorldModule\/Commands.swift#L55","fileName":"Commands.swift"},"navigatorTitle":[{"kind":"identifier","text":"Commands"}],"symbolKind":"struct","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"Commands"}],"title":"Commands"},"relationshipsSections":[{"title":"Conforms To","kind":"relationships","type":"conformsTo","identifiers":["doc:\/\/WorldModule\/s8SendableP","doc:\/\/WorldModule\/s16SendableMetatypeP"]}],"identifier":{"url":"doc:\/\/WorldModule\/documentation\/WorldModule\/Commands","interfaceLanguage":"swift"},"references":{"doc://WorldModule/documentation/WorldModule/Commands/count":{"title":"count","identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/Commands\/count","abstract":[{"type":"text","text":"The number of commands recorded in the buffer."}],"role":"symbol","type":"topic","url":"\/documentation\/worldmodule\/commands\/count","fragments":[{"text":"var","kind":"keyword"},{"text":" ","kind":"text"},{"text":"count","kind":"identifier"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:Si","text":"Int","kind":"typeIdentifier"}],"kind":"symbol"},"doc://WorldModule/documentation/WorldModule/QueryingAWorld":{"abstract":[{"type":"text","text":"Find the entities that hold the components you need, read those components, and change them in place."}],"type":"topic","kind":"article","title":"Quer