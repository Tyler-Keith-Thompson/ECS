{"identifier":{"url":"doc:\/\/WorldModule\/documentation\/WorldModule\/Commands","interfaceLanguage":"swift"},"kind":"symbol","schemaVersion":{"minor":3,"patch":0,"major":0},"hierarchy":{"paths":[["doc:\/\/WorldModule\/documentation\/WorldModule"]]},"relationshipsSections":[{"title":"Conforms To","identifiers":["doc:\/\/WorldModule\/s8SendableP","doc:\/\/WorldModule\/s16SendableMetatypeP"],"type":"conformsTo","kind":"relationships"}],"topicSections":[{"title":"Creating a Command Buffer","identifiers":["doc:\/\/WorldModule\/documentation\/WorldModule\/Commands\/init()"],"anchor":"Creating-a-Command-Buffer"},{"title":"Inspecting a Command Buffer","identifiers":["doc:\/\/WorldModule\/documentation\/WorldModule\/Commands\/count","doc:\/\/WorldModule\/documentation\/WorldModule\/Commands\/isEmpty"],"anchor":"Inspecting-a-Command-Buffer"},{"title":"Spawning and Despawning Entities","identifiers":["doc:\/\/WorldModule\/documentation\/WorldModule\/Commands\/spawn(_:)","doc:\/\/WorldModule\/documentation\/WorldModule\/Commands\/clone(_:)","doc:\/\/WorldModule\/documentation\/WorldModule\/Commands\/spawn(from:)","doc:\/\/WorldModule\/documentation\/WorldModule\/Commands\/despawn(_:)"],"anchor":"Spawning-and-Despawning-Entities"},{"title":"Adding and Removing Components","identifiers":["doc:\/\/WorldModule\/documentation\/WorldModule\/Commands\/insert(_:into:)","doc:\/\/WorldModule\/documentation\/WorldModule\/Commands\/remove(_:from:)"],"anchor":"Adding-and-Removing-Components"},{"title":"Changing the Hierarchy and Relations","identifiers":["doc:\/\/WorldModule\/documentation\/WorldModule\/Commands\/addChild(_:to:)","doc:\/\/WorldModule\/documentation\/WorldModule\/Commands\/spawn(_:childOf:)","doc:\/\/WorldModule\/documentation\/WorldModule\/Commands\/removeParent(of:)","doc:\/\/WorldModule\/documentation\/WorldModule\/Commands\/relate(_:_:to:)","doc:\/\/WorldModule\/documentation\/WorldModule\/Commands\/unrelate(_:_:from:)"],"anchor":"Changing-the-Hierarchy-and-Relations"},{"title":"Sending Events","identifiers":["doc:\/\/WorldModule\/documentation\/WorldModule\/Commands\/send(_:)","doc:\/\/WorldModule\/documentation\/WorldModule\/Commands\/trigger(_:on:)"],"anchor":"Sending-Events"},{"title":"Changing Resources","identifiers":["doc:\/\/WorldModule\/documentation\/WorldModule\/Commands\/insert(resource:)"],"anchor":"Changing-Resources"},{"title":"Recording Any Change","identifiers":["doc:\/\/WorldModule\/documentation\/WorldModule\/Commands\/record(_:)"],"anchor":"Recording-Any-Change"}],"abstract":[{"type":"text","text":"A buffer of changes to a world, recorded now and applied later in the order they were"},{"type":"text","text":" "},{"type":"text","text":"recorded."}],"primaryContentSections":[{"declarations":[{"languages":["swift"],"tokens":[{"kind":"attribute","text":"@frozen"},{"kind":"text","text":" "},{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"Commands"}],"platforms":["Linux"]}],"kind":"declarations"},{"kind":"mentions","mentions":["doc:\/\/WorldModule\/documentation\/WorldModule\/QueryingAWorld"]},{"kind":"content","content":[{"anchor":"overview","type":"heading","level":2,"text":"Overview"},{"type":"paragraph","inlineContent":[{"text":"While a query or an update visits a world’s entities, the world can’t be changed in other","type":"text"},{"text":" ","type":"text"},{"text":"ways: spawning or despawning an entity, or adding or removing a component, would disturb the","type":"text"},{"type":"text","text":" "},{"type":"text","text":"storage being visited. Record such changes in a command buffer instead, and apply them with"},{"type":"text","text":" "},{"identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/World\/apply(_:)","type":"reference","isActive":true},{"type":"text","text":" once the visit is over. The following example despawns every entity whose"},{"type":"text","text":" "},{"type":"text","text":"health has run out:"}]},{"code":["var world = World()","world.spawn(Health(current: 0))","world.spawn(Health(current: 10))","","var commands = Commands()","for (entity, health) in world.query(Health.self) where health.current <= 0 {","    commands.despawn(entity)","}","world.apply(commands)","","print(world.count)","\/\/ Prints \"1\""],"type":"codeListing","syntax":"swift"},{"type":"paragraph","inlineContent":[{"text":"A command on an entity that is no longer live when it applies does nothing, so two commands","type":"text"},{"text":" ","type":"text"},{"text":"that despawn the same entity are safe.","type":"text"}]},{"anchor":"Naming-Entities-That-Commands-Will-Spawn","type":"heading","level":3,"text":"Naming Entities That Commands Will Spawn"},{"type":"paragraph","inlineContent":[{"type":"reference","isActive":true,"identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/Commands\/spawn(_:)"},{"type":"text","text":" returns a placeholder handle for the entity it will create. Later commands in the"},{"type":"text","text":" "},{"type":"text","text":"same buffer can name that placeholder, and "},{"type":"reference","isActive":true,"identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/World\/apply(_:)"},{"type":"text","text":" returns the real handles of the"},{"type":"text","text":" "},{"type":"text","text":"entities it spawned, in the order their commands were recorded:"}]},{"code":["var world = World()","var commands = Commands()","let ship = commands.spawn(Position(x: 0, y: 0))","let turret = commands.spawn(Position(x: 1, y: 0))","commands.addChild(turret, to: ship)","","let spawned = world.apply(commands)","print(world.parent(of: spawned[1]) == spawned[0])","\/\/ Prints \"true\""],"type":"codeListing","syntax":"swift"},{"type":"paragraph","inlineContent":[{"text":"A placeholder stands for its entity only inside the buffer that returned it; the world holds no","type":"text"},{"text":" ","type":"text"},{"text":"entity with that handle.","type":"text"}]},{"anchor":"Commands-from-Systems","type":"heading","level":3,"text":"Commands from Systems"},{"type":"paragraph","inlineContent":[{"text":"A system running alongside others can’t apply commands itself, because applying them would","type":"text"},{"text":" ","type":"text"},{"text":"change entities the other systems are reading. It queues them with ","type":"text"},{"identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/World\/queue(_:)","type":"reference","isActive":true},{"text":" ","type":"text"},{"text":"instead, and the schedule applies every queued buffer at the end of each wave of systems.","type":"text"}]}]}],"metadata":{"symbolKind":"struct","role":"symbol","roleHeading":"Structure","remoteSource":{"fileName":"Commands.swift","url":"https:\/\/github.com\/Tyler-Keith-Thompson\/ECS\/blob\/main\/Sources\/WorldModule\/Commands.swift#L55"},"fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"text":"Commands","kind":"identifier"}],"modules":[{"name":"WorldModule"}],"externalID":"s:11WorldModule8CommandsV","navigatorTitle":[{"kind":"identifier","text":"Commands"}],"title":"Commands"},"sections":[],"variants":[{"paths":["\/documentation\/worldmodule\/commands"],"traits":[{"interfaceLanguage":"swift"}]}],"references":{"doc://WorldModule/documentation/WorldModule/World/applyQueuedCommands()":{"fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"applyQueuedCommands","kind":"identifier"},{"text":"() -> [","kind":"text"},{"kind":"typeIdentifier","preciseIdentifier":"s:11WorldModule6EntityV","text":"Entity"},{"kind":"text","text":"]"}],"title":"applyQueuedCommands()","kind":"symbol","identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/World\/applyQueuedCommands()","role":"symbol","type":"topic","abstract":[{"type":"text","text":"Applies every queued command buffer, in the order the buffers were queued, and empties the"},{"type":"text","text":" "},{"type":"text","text":"queue."}],"url":"\/documentation\/worldmodule\/world\/applyqueuedcommands()"},"doc://WorldModule/d