{"sections":[],"hierarchy":{"paths":[["doc:\/\/WorldModule\/documentation\/WorldModule"]]},"abstract":[{"type":"text","text":"A buffer of changes to a world, recorded now and applied later in the order they were"},{"type":"text","text":" "},{"type":"text","text":"recorded."}],"metadata":{"title":"Commands","roleHeading":"Structure","externalID":"s:11WorldModule8CommandsV","symbolKind":"struct","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Commands","kind":"identifier"}],"role":"symbol","navigatorTitle":[{"text":"Commands","kind":"identifier"}],"remoteSource":{"fileName":"Commands.swift","url":"https:\/\/github.com\/Tyler-Keith-Thompson\/ECS\/blob\/main\/Sources\/WorldModule\/Commands.swift#L55"},"modules":[{"name":"WorldModule"}]},"topicSections":[{"title":"Creating a Command Buffer","identifiers":["doc:\/\/WorldModule\/documentation\/WorldModule\/Commands\/init()"],"anchor":"Creating-a-Command-Buffer"},{"title":"Inspecting a Command Buffer","identifiers":["doc:\/\/WorldModule\/documentation\/WorldModule\/Commands\/count","doc:\/\/WorldModule\/documentation\/WorldModule\/Commands\/isEmpty"],"anchor":"Inspecting-a-Command-Buffer"},{"title":"Spawning and Despawning Entities","identifiers":["doc:\/\/WorldModule\/documentation\/WorldModule\/Commands\/spawn(_:)","doc:\/\/WorldModule\/documentation\/WorldModule\/Commands\/clone(_:)","doc:\/\/WorldModule\/documentation\/WorldModule\/Commands\/spawn(from:)","doc:\/\/WorldModule\/documentation\/WorldModule\/Commands\/despawn(_:)"],"anchor":"Spawning-and-Despawning-Entities"},{"title":"Adding and Removing Components","identifiers":["doc:\/\/WorldModule\/documentation\/WorldModule\/Commands\/insert(_:into:)","doc:\/\/WorldModule\/documentation\/WorldModule\/Commands\/remove(_:from:)"],"anchor":"Adding-and-Removing-Components"},{"identifiers":["doc:\/\/WorldModule\/documentation\/WorldModule\/Commands\/addChild(_:to:)","doc:\/\/WorldModule\/documentation\/WorldModule\/Commands\/spawn(_:childOf:)","doc:\/\/WorldModule\/documentation\/WorldModule\/Commands\/removeParent(of:)","doc:\/\/WorldModule\/documentation\/WorldModule\/Commands\/relate(_:_:to:)","doc:\/\/WorldModule\/documentation\/WorldModule\/Commands\/unrelate(_:_:from:)"],"anchor":"Changing-the-Hierarchy-and-Relations","title":"Changing the Hierarchy and Relations"},{"identifiers":["doc:\/\/WorldModule\/documentation\/WorldModule\/Commands\/send(_:)","doc:\/\/WorldModule\/documentation\/WorldModule\/Commands\/trigger(_:on:)"],"anchor":"Sending-Events","title":"Sending Events"},{"identifiers":["doc:\/\/WorldModule\/documentation\/WorldModule\/Commands\/insert(resource:)"],"anchor":"Changing-Resources","title":"Changing Resources"},{"identifiers":["doc:\/\/WorldModule\/documentation\/WorldModule\/Commands\/record(_:)"],"anchor":"Recording-Any-Change","title":"Recording Any Change"}],"primaryContentSections":[{"kind":"declarations","declarations":[{"platforms":["Linux"],"tokens":[{"text":"@frozen","kind":"attribute"},{"text":" ","kind":"text"},{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Commands","kind":"identifier"}],"languages":["swift"]}]},{"mentions":["doc:\/\/WorldModule\/documentation\/WorldModule\/DisablingEntitiesAndUsingPrefabs","doc:\/\/WorldModule\/documentation\/WorldModule\/QueryingAWorld","doc:\/\/WorldModule\/documentation\/WorldModule\/RelatingEntities"],"kind":"mentions"},{"kind":"content","content":[{"type":"heading","text":"Overview","level":2,"anchor":"overview"},{"type":"paragraph","inlineContent":[{"type":"text","text":"While a query or an update visits a world’s entities, the world can’t be changed in other"},{"type":"text","text":" "},{"type":"text","text":"ways: spawning or despawning an entity, or adding or removing a component, would disturb the"},{"type":"text","text":" "},{"type":"text","text":"storage being visited. Record such changes in a command buffer instead, and apply them with"},{"type":"text","text":" "},{"identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/World\/apply(_:)","type":"reference","isActive":true},{"type":"text","text":" once the visit is over. The following example despawns every entity whose"},{"type":"text","text":" "},{"type":"text","text":"health has run out:"}]},{"type":"codeListing","syntax":"swift","code":["var world = World()","world.spawn(Health(current: 0))","world.spawn(Health(current: 10))","","var commands = Commands()","for (entity, health) in world.query(Health.self) where health.current <= 0 {","    commands.despawn(entity)","}","world.apply(commands)","","print(world.count)","\/\/ Prints \"1\""]},{"type":"paragraph","inlineContent":[{"type":"text","text":"A command on an entity that is no longer live when it applies does nothing, so two commands"},{"type":"text","text":" "},{"type":"text","text":"that despawn the same entity are safe."}]},{"type":"heading","text":"Naming Entities That Commands Will Spawn","level":3,"anchor":"Naming-Entities-That-Commands-Will-Spawn"},{"type":"paragraph","inlineContent":[{"type":"reference","isActive":true,"identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/Commands\/spawn(_:)"},{"type":"text","text":" returns a placeholder handle for the entity it will create. Later commands in the"},{"type":"text","text":" "},{"type":"text","text":"same buffer can name that placeholder, and "},{"type":"reference","isActive":true,"identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/World\/apply(_:)"},{"type":"text","text":" returns the real handles of the"},{"type":"text","text":" "},{"type":"text","text":"entities it spawned, in the order their commands were recorded:"}]},{"type":"codeListing","syntax":"swift","code":["var world = World()","var commands = Commands()","let ship = commands.spawn(Position(x: 0, y: 0))","let turret = commands.spawn(Position(x: 1, y: 0))","commands.addChild(turret, to: ship)","","let spawned = world.apply(commands)","print(world.parent(of: spawned[1]) == spawned[0])","\/\/ Prints \"true\""]},{"type":"paragraph","inlineContent":[{"type":"text","text":"A placeholder stands for its entity only inside the buffer that returned it; the world holds no"},{"type":"text","text":" "},{"type":"text","text":"entity with that handle."}]},{"type":"heading","text":"Commands from Systems","level":3,"anchor":"Commands-from-Systems"},{"type":"paragraph","inlineContent":[{"type":"text","text":"A system running alongside others can’t apply commands itself, because applying them would"},{"type":"text","text":" "},{"type":"text","text":"change entities the other systems are reading. It queues them with "},{"identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/World\/queue(_:)","isActive":true,"type":"reference"},{"type":"text","text":" "},{"type":"text","text":"instead, and the schedule applies every queued buffer at the end of each wave of systems."}]}]}],"variants":[{"paths":["\/documentation\/worldmodule\/commands"],"traits":[{"interfaceLanguage":"swift"}]}],"schemaVersion":{"major":0,"patch":0,"minor":3},"kind":"symbol","identifier":{"interfaceLanguage":"swift","url":"doc:\/\/WorldModule\/documentation\/WorldModule\/Commands"},"relationshipsSections":[{"identifiers":["doc:\/\/WorldModule\/s8SendableP","doc:\/\/WorldModule\/s16SendableMetatypeP"],"type":"conformsTo","kind":"relationships","title":"Conforms To"}],"references":{"doc://WorldModule/documentation/WorldModule/World/applyQueuedCommands()":{"type":"topic","identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/World\/applyQueuedCommands()","abstract":[{"type":"text","text":"Applies every queued command buffer, in the order the buffers were queued, and empties the"},{"type":"text","text":" "},{"type":"text","text":"queue."}],"role":"symbol","kind":"symbol","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"applyQueuedCommands","kind":"identifier"},{"text":"() -> [","kind":"text"},{"text":"Entity","kind":"typeIdentifier","preciseIdentifier":"s:11WorldModule6EntityV"},{"text":"]","kind":"text"}],"title":"applyQueuedCommands()","url":"\/documentation\/worldmodule\/world\/applyqueuedcommands()"},"doc://WorldModule/documentation/WorldModule/Commands/record(_:)":{"url":"\/documentation\/worldmodule\/commands\/record(_:)","title":"record(_:)","abstract":[{"type":"text","text":"Records an arbitrary change to the world."}],"role":"symbol","kind":"symbol","identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/Commands\/record(_:)","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"record","kind":"identifier"},{"text":"((","kind":"text"},{"text":"inout","kind":"keyword"},{"text":" ","kind":"text"},{"preciseIdentifier":"s:11WorldModule0A0V","text":"World","kind":"typeIdentifier"},{"text":") -> ","kind":"text"},{"preciseIdentifier":"s:s4Voida","text":"Void","kind":"typeIdentifier"},{"text":")","kind":"text"}],"type":"topic"},"doc://WorldModule/s16SendableMetatypeP":{"title":"Swift.SendableMetatype","identifier":"doc:\/\/WorldModule\/s16SendableMetatypeP","type":"unresolvable"},"doc://WorldModule/documentation/WorldModule/World/queue(_:)":{"abstract":[{"text":"Adds a command buffer to the world’s queue, to apply later with","type":"text"},{"text":" ","type":"text"},{"type":"reference","isActive":true,"identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/World\/applyQueuedCommands()"},{"text":".","type":"text"}],"type":"topic","identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/World\/queue(_:)","title":"queue(_:)","role":"symbol","kind":"symbol","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"queue"},{"kind":"text","text":"("},{"kind":"typeIdentifier","preciseIdentifier":"s:11WorldModule8CommandsV","text":"Commands"},{"kind":"text","text":")"}],"url":"\/documentation\/worldmodule\/world\/queue(_:)"},"doc://WorldModule/documentation/WorldModule/Commands/spawn(from:)":{"abstract":[{"text":"Records spawning an entity from a prefa