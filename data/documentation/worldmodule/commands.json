{"kind":"symbol","schemaVersion":{"patch":0,"minor":3,"major":0},"identifier":{"url":"doc:\/\/WorldModule\/documentation\/WorldModule\/Commands","interfaceLanguage":"swift"},"abstract":[{"type":"text","text":"A buffer of changes to a world, recorded now and applied later in the order they were"},{"type":"text","text":" "},{"type":"text","text":"recorded."}],"relationshipsSections":[{"identifiers":["doc:\/\/WorldModule\/s8SendableP","doc:\/\/WorldModule\/s16SendableMetatypeP"],"type":"conformsTo","kind":"relationships","title":"Conforms To"}],"variants":[{"paths":["\/documentation\/worldmodule\/commands"],"traits":[{"interfaceLanguage":"swift"}]}],"primaryContentSections":[{"declarations":[{"languages":["swift"],"platforms":["Linux"],"tokens":[{"kind":"attribute","text":"@frozen"},{"kind":"text","text":" "},{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"Commands"}]}],"kind":"declarations"},{"kind":"mentions","mentions":["doc:\/\/WorldModule\/documentation\/WorldModule\/QueryingAWorld"]},{"kind":"content","content":[{"level":2,"text":"Overview","anchor":"overview","type":"heading"},{"inlineContent":[{"text":"While a query or an update visits a world’s entities, the world can’t be changed in other","type":"text"},{"text":" ","type":"text"},{"text":"ways: spawning or despawning an entity, or adding or removing a component, would disturb the","type":"text"},{"text":" ","type":"text"},{"text":"storage being visited. Record such changes in a command buffer instead, and apply them with","type":"text"},{"text":" ","type":"text"},{"identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/World\/apply(_:)","type":"reference","isActive":true},{"text":" once the visit is over. The following example despawns every entity whose","type":"text"},{"text":" ","type":"text"},{"text":"health has run out:","type":"text"}],"type":"paragraph"},{"syntax":"swift","code":["var world = World()","world.spawn(Health(current: 0))","world.spawn(Health(current: 10))","","var commands = Commands()","for (entity, health) in world.query(Health.self) where health.current <= 0 {","    commands.despawn(entity)","}","world.apply(commands)","","print(world.count)","\/\/ Prints \"1\""],"type":"codeListing"},{"inlineContent":[{"text":"A command on an entity that is no longer live when it applies does nothing, so two commands","type":"text"},{"text":" ","type":"text"},{"text":"that despawn the same entity are safe.","type":"text"}],"type":"paragraph"},{"level":3,"text":"Naming Entities That Commands Will Spawn","anchor":"Naming-Entities-That-Commands-Will-Spawn","type":"heading"},{"inlineContent":[{"isActive":true,"type":"reference","identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/Commands\/spawn(_:)"},{"type":"text","text":" returns a placeholder handle for the entity it will create. Later commands in the"},{"type":"text","text":" "},{"type":"text","text":"same buffer can name that placeholder, and "},{"isActive":true,"type":"reference","identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/World\/apply(_:)"},{"type":"text","text":" returns the real handles of the"},{"type":"text","text":" "},{"type":"text","text":"entities it spawned, in the order their commands were recorded:"}],"type":"paragraph"},{"syntax":"swift","code":["var world = World()","var commands = Commands()","let ship = commands.spawn(Position(x: 0, y: 0))","let turret = commands.spawn(Position(x: 1, y: 0))","commands.addChild(turret, to: ship)","","let spawned = world.apply(commands)","print(world.parent(of: spawned[1]) == spawned[0])","\/\/ Prints \"true\""],"type":"codeListing"},{"inlineContent":[{"type":"text","text":"A placeholder stands for its entity only inside the buffer that returned it; the world holds no"},{"type":"text","text":" "},{"type":"text","text":"entity with that handle."}],"type":"paragraph"},{"level":3,"text":"Commands from Systems","anchor":"Commands-from-Systems","type":"heading"},{"inlineContent":[{"type":"text","text":"A system running alongside others can’t apply commands itself, because applying them would"},{"type":"text","text":" "},{"type":"text","text":"change entities the other systems are reading. It queues them with "},{"type":"reference","isActive":true,"identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/World\/queue(_:)"},{"type":"text","text":" "},{"type":"text","text":"instead, and the schedule applies every queued buffer at the end of each wave of systems."}],"type":"paragraph"}]}],"metadata":{"roleHeading":"Structure","remoteSource":{"url":"https:\/\/github.com\/Tyler-Keith-Thompson\/ECS\/blob\/main\/Sources\/WorldModule\/Commands.swift#L55","fileName":"Commands.swift"},"symbolKind":"struct","navigatorTitle":[{"text":"Commands","kind":"identifier"}],"externalID":"s:11WorldModule8CommandsV","role":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"Commands"}],"title":"Commands","modules":[{"name":"WorldModule"}]},"sections":[],"hierarchy":{"paths":[["doc:\/\/WorldModule\/documentation\/WorldModule"]]},"topicSections":[{"identifiers":["doc:\/\/WorldModule\/documentation\/WorldModule\/Commands\/init()"],"anchor":"Creating-a-Command-Buffer","title":"Creating a Command Buffer"},{"identifiers":["doc:\/\/WorldModule\/documentation\/WorldModule\/Commands\/count","doc:\/\/WorldModule\/documentation\/WorldModule\/Commands\/isEmpty"],"anchor":"Inspecting-a-Command-Buffer","title":"Inspecting a Command Buffer"},{"identifiers":["doc:\/\/WorldModule\/documentation\/WorldModule\/Commands\/spawn(_:)","doc:\/\/WorldModule\/documentation\/WorldModule\/Commands\/clone(_:)","doc:\/\/WorldModule\/documentation\/WorldModule\/Commands\/spawn(from:)","doc:\/\/WorldModule\/documentation\/WorldModule\/Commands\/despawn(_:)"],"anchor":"Spawning-and-Despawning-Entities","title":"Spawning and Despawning Entities"},{"identifiers":["doc:\/\/WorldModule\/documentation\/WorldModule\/Commands\/insert(_:into:)","do