{"kind":"symbol","schemaVersion":{"major":0,"minor":3,"patch":0},"metadata":{"externalID":"s:11WorldModule8CommandsV","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"Commands"}],"roleHeading":"Structure","navigatorTitle":[{"text":"Commands","kind":"identifier"}],"remoteSource":{"fileName":"Commands.swift","url":"https:\/\/github.com\/Tyler-Keith-Thompson\/ECS\/blob\/main\/Sources\/WorldModule\/Commands.swift#L55"},"role":"symbol","symbolKind":"struct","modules":[{"name":"WorldModule"}],"title":"Commands"},"topicSections":[{"anchor":"Creating-a-Command-Buffer","identifiers":["doc:\/\/WorldModule\/documentation\/WorldModule\/Commands\/init()"],"title":"Creating a Command Buffer"},{"anchor":"Inspecting-a-Command-Buffer","identifiers":["doc:\/\/WorldModule\/documentation\/WorldModule\/Commands\/count","doc:\/\/WorldModule\/documentation\/WorldModule\/Commands\/isEmpty"],"title":"Inspecting a Command Buffer"},{"anchor":"Spawning-and-Despawning-Entities","identifiers":["doc:\/\/WorldModule\/documentation\/WorldModule\/Commands\/spawn(_:)","doc:\/\/WorldModule\/documentation\/WorldModule\/Commands\/clone(_:)","doc:\/\/WorldModule\/documentation\/WorldModule\/Commands\/spawn(from:)","doc:\/\/WorldModule\/documentation\/WorldModule\/Commands\/despawn(_:)"],"title":"Spawning and Despawning Entities"},{"anchor":"Adding-and-Removing-Components","identifiers":["doc:\/\/WorldModule\/documentation\/WorldModule\/Commands\/insert(_:into:)","doc:\/\/WorldModule\/documentation\/WorldModule\/Commands\/remove(_:from:)"],"title":"Adding and Removing Components"},{"anchor":"Changing-the-Hierarchy-and-Relations","identifiers":["doc:\/\/WorldModule\/documentation\/WorldModule\/Commands\/addChild(_:to:)","doc:\/\/WorldModule\/documentation\/WorldModule\/Commands\/spawn(_:childOf:)","doc:\/\/WorldModule\/documentation\/WorldModule\/Commands\/removeParent(of:)","doc:\/\/WorldModule\/documentation\/WorldModule\/Commands\/relate(_:_:to:)","doc:\/\/WorldModule\/documentation\/WorldModule\/Commands\/unrelate(_:_:from:)"],"title":"Changing the Hierarchy and Relations"},{"anchor":"Sending-Events","identifiers":["doc:\/\/WorldModule\/documentation\/WorldModule\/Commands\/send(_:)","doc:\/\/WorldModule\/documentation\/WorldModule\/Commands\/trigger(_:on:)"],"title":"Sending Events"},{"anchor":"Changing-Resources","identifiers":["doc:\/\/WorldModule\/documentation\/WorldModule\/Commands\/insert(resource:)"],"title":"Changing Resources"},{"anchor":"Recording-Any-Change","identifiers":["doc:\/\/WorldModule\/documentation\/WorldModule\/Commands\/record(_:)"],"title":"Recording Any Change"}],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/WorldModule\/documentation\/WorldModule\/Commands"},"abstract":[{"text":"A buffer of changes to a world, recorded now and applied later in the order they were","type":"text"},{"text":" ","type":"text"},{"text":"recorded.","type":"text"}],"primaryContentSections":[{"declarations":[{"tokens":[{"kind":"attribute","text":"@frozen"},{"kind":"text","text":" "},{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"Commands"}],"platforms":["Linux"],"languages":["swift"]}],"kind":"declarations"},{"kind":"mentions","mentions":["doc:\/\/WorldModule\/documentation\/WorldModule\/QueryingAWorld"]},{"content":[{"level":2,"text":"Overview","anchor":"overview","type":"heading"},{"inlineContent":[{"text":"While a query or an update visits a world’s entities, the world can’t be changed in other","type":"text"},{"text":" ","type":"text"},{"text":"ways: spawning or despawning an entity, or adding or removing a component, would disturb the","type":"text"},{"text":" ","type":"text"},{"text":"storage being visited. Record such changes in a command buffer instead, and apply them with","type":"text"},{"text":" ","type":"text"},{"identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/World\/apply(_:)","type":"reference","isActive":true},{"text":" once the visit is over. The following example despawns every entity whose","type":"text"},{"text":" ","type":"text"},{"text":"health has run out:","type":"text"}],"type":"paragraph"},{"syntax":"swift","code":["var world = World()","world.spawn(Health(current: 0))","world.spawn(Health(current: 10))","","var commands = Commands()","for (entity, health) in world.query(Health.self) where health.current <= 0 {","    commands.despawn(entity)","}","world.apply(commands)","","print(world.count)","\/\/ Prints \"1\""],"type":"codeListing"},{"inlineContent":[{"type":"text","text":"A command on an entity that is no longer live when it applies does nothing, so two commands"},{"type":"text","text":" "},{"type":"text","text":"that despawn the same entity are safe."}],"type":"paragraph"},{"level":3,"text":"Naming Entities That Commands Will Spawn","anchor":"Naming-Entities-That-Commands-Will-Spawn","type":"heading"},{"inlineContent":[{"isActive":true,"identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/Commands\/spawn(_:)","type":"reference"},{"text":" returns a placeholder handle for the entity it will create. Later commands in the","type":"text"},{"text":" ","type":"text"},{"text":"same buffer can name that placeholder, and ","type":"text"},{"isActive":true,"identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/World\/apply(_:)","type":"reference"},{"text":" returns the real handles of the","type":"text"},{"text":" ","type":"text"},{"text":"entities it spawned, in the order their commands were recorded:","type":"text"}],"type":"paragraph"},{"syntax":"swift","code":["var world = World()","var commands = Commands()","let ship = commands.spawn(Position(x: 0, y: 0))","let turret = commands.spawn(Position(x: 1, y: 0))","commands.addChild(turret, to: ship)","","let spawned = world.apply(commands)","print(world.parent(of: spawned[1]) == spawned[0])","\/\/ Prints \"true\""],"type":"codeListing"},{"inlineContent":[{"text":"A placeholder stands for its entity only inside the buffer that returned it; the world holds no","type":"text"},{"text":" ","type":"text"},{"text":"entity with that handle.","type":"text"}],"type":"paragraph"},{"level":3,"text":"Commands from Systems","anchor":"Commands-from-Systems","type":"heading"},{"inlineContent":[{"type":"text","text":"A system running alongside others can’t apply commands itself, because applying them would"},{"type":"text","text":" "},{"type":"text","text":"change entities the other systems are reading. It queues them with "},{"identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/World\/queue(_:)","type":"reference","isActive":true},{"type":"text","text":" "},{"type":"text","text":"instead, and the schedule applies every queued buffer at the end of each wave of systems."}],"type":"paragraph"}],"kind":"content"}],"variants":[{"paths":["\/documentation\/worldmodule\/commands"],"traits":[{"interfaceLanguage":"swift"}]}],"hierarchy":{"paths":[["doc:\/\/WorldModule\/documentation\/WorldModule"]]},"relationshipsSections":[{"type":"conformsTo","kind":"relationships","title":"Conforms To","identifiers":["doc:\/\/WorldModule\/s8SendableP","doc:\/\/WorldModule\/s16SendableMetatypeP"]}],"sections":[],"references":{"doc://WorldModule/s16SendableMetatypeP":{"title":"Swift.SendableMetatype","identifier":"doc:\/\/WorldModule\/s16SendableMetatypeP","type":"unresolvable"},"doc://WorldModule/documentation/WorldModule/World/addChild(_:to:)":{"title":"addChild(_:to:)","abstract":[{"text":"Adds an entity to the end of another entity’s children.","type":"text"}],"fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"addChild","kind":"identifier"},{"text":"(","kind":"text"},{"text":"Entity","kind":"typeIdentifier","preciseIdentifier":"s:11WorldModule6EntityV"},{"text":", ","kind":"text"},{"kind":"externalParam","text":"to"},{"kind":"text","text":": "},{"preciseIdentifier":"s:11WorldModule6EntityV","kind":"typeIdentifier","text":"Entity"},{"kind":"text","text":") "},{"kind":"keywor