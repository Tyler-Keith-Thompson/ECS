{"kind":"symbol","metadata":{"roleHeading":"Structure","symbolKind":"struct","title":"Commands","navigatorTitle":[{"text":"Commands","kind":"identifier"}],"role":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"text":"Commands","kind":"identifier"}],"remoteSource":{"url":"https:\/\/github.com\/Tyler-Keith-Thompson\/ECS\/blob\/main\/Sources\/WorldModule\/Commands.swift#L55","fileName":"Commands.swift"},"modules":[{"name":"WorldModule"}],"externalID":"s:11WorldModule8CommandsV"},"relationshipsSections":[{"identifiers":["doc:\/\/WorldModule\/s8SendableP","doc:\/\/WorldModule\/s16SendableMetatypeP"],"type":"conformsTo","kind":"relationships","title":"Conforms To"}],"sections":[],"schemaVersion":{"patch":0,"major":0,"minor":3},"hierarchy":{"paths":[["doc:\/\/WorldModule\/documentation\/WorldModule"]]},"topicSections":[{"title":"Creating a Command Buffer","identifiers":["doc:\/\/WorldModule\/documentation\/WorldModule\/Commands\/init()"],"anchor":"Creating-a-Command-Buffer"},{"title":"Inspecting a Command Buffer","identifiers":["doc:\/\/WorldModule\/documentation\/WorldModule\/Commands\/count","doc:\/\/WorldModule\/documentation\/WorldModule\/Commands\/isEmpty"],"anchor":"Inspecting-a-Command-Buffer"},{"identifiers":["doc:\/\/WorldModule\/documentation\/WorldModule\/Commands\/spawn(_:)","doc:\/\/WorldModule\/documentation\/WorldModule\/Commands\/clone(_:)","doc:\/\/WorldModule\/documentation\/WorldModule\/Commands\/spawn(from:)","doc:\/\/WorldModule\/documentation\/WorldModule\/Commands\/despawn(_:)"],"title":"Spawning and Despawning Entities","anchor":"Spawning-and-Despawning-Entities"},{"identifiers":["doc:\/\/WorldModule\/documentation\/WorldModule\/Commands\/insert(_:into:)","doc:\/\/WorldModule\/documentation\/WorldModule\/Commands\/remove(_:from:)"],"title":"Adding and Removing Components","anchor":"Adding-and-Removing-Components"},{"identifiers":["doc:\/\/WorldModule\/documentation\/WorldModule\/Commands\/addChild(_:to:)","doc:\/\/WorldModule\/documentation\/WorldModule\/Commands\/spawn(_:childOf:)","doc:\/\/WorldModule\/documentation\/WorldModule\/Commands\/removeParent(of:)","doc:\/\/WorldModule\/documentation\/WorldModule\/Commands\/relate(_:_:to:)","doc:\/\/WorldModule\/documentation\/WorldModule\/Commands\/unrelate(_:_:from:)"],"title":"Changing the Hierarchy and Relations","anchor":"Changing-the-Hierarchy-and-Relations"},{"identifiers":["doc:\/\/WorldModule\/documentation\/WorldModule\/Commands\/send(_:)","doc:\/\/WorldModule\/documentation\/WorldModule\/Commands\/trigger(_:on:)"],"title":"Sending Events","anchor":"Sending-Events"},{"identifiers":["doc:\/\/WorldModule\/documentation\/WorldModule\/Commands\/insert(resource:)"],"title":"Changing Resources","anchor":"Changing-Resources"},{"identifiers":["doc:\/\/WorldModule\/documentation\/WorldModule\/Commands\/record(_:)"],"title":"Recording Any Change","anchor":"Recording-Any-Change"}],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/WorldModule\/documentation\/WorldModule\/Commands"},"variants":[{"paths":["\/documentation\/worldmodule\/commands"],"traits":[{"interfaceLanguage":"swift"}]}],"abstract":[{"type":"text","text":"A buffer of changes to a world, recorded now and applied later in the order they were"},{"type":"text","text":" "},{"type":"text","text":"recorded."}],"primaryContentSections":[{"declarations":[{"tokens":[{"kind":"attribute","text":"@frozen"},{"kind":"text","text":" "},{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"Commands"}],"languages":["swift"],"platforms":["Linux"]}],"kind":"declarations"},{"mentions":["doc:\/\/WorldModule\/documentation\/WorldModule\/QueryingAWorld"],"kind":"mentions"},{"content":[{"type":"heading","text":"Overview","level":2,"anchor":"overview"},{"type":"paragraph","inlineContent":[{"type":"text","text":"While a query or an update visits a world’s entities, the world can’t be changed in other"},{"type":"text","text":" "},{"type":"text","text":"ways: spawning or despawning an entity, or adding or removing a component, would disturb the"},{"text":" ","type":"text"},{"text":"storage being visited. Record such changes in a command buffer instead, and apply them with","type":"text"},{"text":" ","type":"text"},{"identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/World\/apply(_:)","isActive":true,"type":"reference"},{"text":" once the visit is over. The following example despawns every entity whose","type":"text"},{"text":" ","type":"text"},{"text":"health has run out:","type":"text"}]},{"code":["var world = World()","world.spawn(Health(current: 0))","world.spawn(Health(current: 10))","","var commands = Commands()","for (entity, health) in world.query(Health.self) where health.current <= 0 {","    commands.despawn(entity)","}","world.apply(commands)","","print(world.count)","\/\/ Prints \"1\""],"type":"codeListing","syntax":"swift"},{"type":"paragraph","inlineContent":[{"text":"A command on an entity that is no longer live when it applies does nothing, so two commands","type":"text"},{"text":" ","type":"text"},{"text":"that despawn the same entity are safe.","type":"text"}]},{"type":"heading","text":"Naming Entities That Commands Will Spawn","level":3,"anchor":"Naming-Entities-That-Commands-Will-Spawn"},{"type":"paragraph","inlineContent":[{"type":"reference","isActive":true,"identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/Commands\/spawn(_:)"},{"type":"text","text":" returns a placeholder handle for the entity it will create. Later commands in the"},{"type":"text","text":" "},{"type":"text","text":"same buffer can name that placeholder, and "},{"type":"reference","isActive":true,"identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/World\/apply(_:)"},{"type":"text","text":" returns the real handles of the"},{"type":"text","text":" "},{"type":"text","text":"entities it spawned, in the order their commands were recorded:"}]},{"code":["var world = World()","var commands = Commands()","let ship = commands.spawn(Position(x: 0, y: 0))","let turret = commands.spawn(Position(x: 1, y: 0))","commands.addChild(turret, to: ship)","","let spawned = world.apply(commands)","print(world.parent(of: spawned[1]) == spawned[0])","\/\/ Prints \"true\""],"type":"codeListing","syntax":"swift"},{"type":"paragraph","inlineContent":[{"type":"text","text":"A placeholder stands for its entity only inside the buffer that returned it; the world holds no"},{"type":"text","text":" "},{"type":"text","text":"entity with that handle."}]},{"type":"heading","text":"Commands from Systems","level":3,"anchor":"Commands-from-Systems"},{"type":"paragraph","inlineContent":[{"type":"text","text":"A system running alongside others can’t apply commands itself, because applying them would"},{"type":"text","text":" "},{"type":"text","text":"change entities the other systems are reading. It queues them with "},{"identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/World\/queue(_:)","isActive":true,"type":"reference"},{"type":"text","text":" "},{"type":"text","text":"instead, and the schedule applies every queued buffer at the end of each wave of systems."}]}],"kind":"content"}],"references":{"doc://WorldModule/documentation/WorldModule/Commands/clone(_:)":{"kind":"symbol","type":"topic","url":"\/documentation\/worldmodule\/commands\/clone(_:)","title":"clone(_:)","role":"symbol","identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/Commands\/clone(_:)","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"clone"},{"kind":"text","text":"("},{"preciseIdentifier":"s:11WorldModule6EntityV","kind":"typeIdentifier","text":"Entity"},{"kind":"text","text":") -> "},{"kind":"typeIdentifier","preciseIdentifier":"s:11WorldModule6EntityV","text":"Entity"}],"abstract":[{"type":"text","text":"Records spawning a copy of an entity, and returns a placeholder handle for the copy."}]},"doc://WorldModule/documentation/WorldModule/World/q