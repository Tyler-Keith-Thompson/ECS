chor":"Sending-Events","title":"Sending Events","identifiers":["doc:\/\/WorldModule\/documentation\/WorldModule\/Commands\/send(_:)","doc:\/\/WorldModule\/documentation\/WorldModule\/Commands\/trigger(_:on:)"]},{"anchor":"Changing-Resources","title":"Changing Resources","identifiers":["doc:\/\/WorldModule\/documentation\/WorldModule\/Commands\/insert(resource:)"]},{"anchor":"Recording-Any-Change","title":"Recording Any Change","identifiers":["doc:\/\/WorldModule\/documentation\/WorldModule\/Commands\/record(_:)"]}],"kind":"symbol","metadata":{"role":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"Commands"}],"navigatorTitle":[{"kind":"identifier","text":"Commands"}],"modules":[{"name":"WorldModule"}],"externalID":"s:11WorldModule8CommandsV","title":"Commands","roleHeading":"Structure","remoteSource":{"fileName":"Commands.swift","url":"https:\/\/github.com\/Tyler-Keith-Thompson\/ECS\/blob\/main\/Sources\/WorldModule\/Commands.swift#L55"},"symbolKind":"struct"},"primaryContentSections":[{"kind":"declarations","declarations":[{"tokens":[{"text":"@frozen","kind":"attribute"},{"text":" ","kind":"text"},{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Commands","kind":"identifier"}],"languages":["swift"],"platforms":["Linux"]}]},{"mentions":["doc:\/\/WorldModule\/documentation\/WorldModule\/DisablingEntitiesAndUsingPrefabs","doc:\/\/WorldModule\/documentation\/WorldModule\/QueryingAWorld","doc:\/\/WorldModule\/documentation\/WorldModule\/RelatingEntities"],"kind":"mentions"},{"content":[{"type":"heading","text":"Overview","anchor":"overview","level":2},{"type":"paragraph","inlineContent":[{"type":"text","text":"While a query or an update visits a world’s entities, the world can’t be changed in other"},{"type":"text","text":" "},{"type":"text","text":"ways: spawning or despawning an entity, or adding or removing a component, would disturb the"},{"type":"text","text":" "},{"type":"text","text":"storage being visited. Record such changes in a command buffer instead, and apply them with"},{"type":"text","text":" "},{"type":"reference","isActive":true,"identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/World\/apply(_:)"},{"type":"text","text":" once the visit is over. The following example despawns every entity whose"},{"type":"text","text":" "},{"type":"text","text":"health has run out:"}]},{"syntax":"swift","type":"codeListing","code":["var world = World()","world.spawn(Health(current: 0))","world.spawn(Health(current: 10))","","var commands = Commands()","for (entity, health) in world.query(Health.self) where health.current <= 0 {","    commands.despawn(entity)","}","world.apply(commands)","","print(world.count)","\/\/ Prints \"1\""]},{"type":"paragraph","inlineContent":[{"text":"A command on an entity that is no longer live when it applies does nothing, so two commands","type":"text"},{"text":" ","type":"text"},{"text":"that despawn the same entity are safe.","type":"text"}]},{"type":"heading","text":"Naming Entities That Commands Will Spawn","anchor":"Naming-Entities-That-Commands-Will-Spawn","level":3},{"type":"paragraph","inlineContent":[{"isActive":true,"identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/Commands\/spawn(_:)","type":"reference"},{"text":" returns a placeholder handle for the entity it will create. Later commands in the","type":"text"},{"text":" ","type":"text"},{"text":"same buffer can name that placeholder, and ","type":"text"},{"isActive":true,"identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/World\/apply(_:)","type":"reference"},{"text":" returns the real handles of the","type":"text"},{"text":" ","type":"text"},{"text":"entities it spawned, in the order their commands were recorded:","type":"text"}]},{"syntax":"swift","type":"codeListing","code":["var world = World()","var commands = Commands()","let ship = commands.spawn(Position(x: 0, y: 0))","let turret = commands.spawn(Position(x: 1, y: 0))","commands.addChild(turret, to: ship)","","let spawned = world.apply(commands)","print(world.parent(of: spawned[1]) == spawned[0])","\/\/ Prints \"true\""]},{"type":"paragraph","inlineContent":[{"type":"text","text":"A placeholder stands for its entity only inside the buffer that returned it; the world holds no"},{"type":"text","text":" "},{"type":"text","text":"entity with that handle."}]},{"type":"heading","text":"Commands from Systems","anchor":"Commands-from-Systems","level":3},{"type":"paragraph","inlineContent":[{"text":"A system running alongside others can’t apply commands itself, because applying them would","type":"text"},{"text":" ","type":"text"},{"text":"change entities the other systems are reading. It queues them with ","type":"text"},{"identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/World\/queue(_:)","isActive":true,"type":"reference"},{"text":" ","type":"text"},{"text":"instead, and the schedule applies every queued buffer at the end of each wave of systems.","type":"text"}]}],"kind":"content"}],"identifier":{"url":"doc:\/\/WorldModule\/documentation\/WorldModule\/Commands","interfaceLanguage":"swift"},"abstract":[{"type":"text","text":"A buffer of changes to a world, recorded now and applied later in the order they were"},{"type":"text","text":" "},{"type":"text","text":"recorded."}],"references":{"doc://WorldModule/documentation/WorldModule/Commands/count":{"url":"\/documentation\/worldmodule\/commands\/count","type":"topic","fragments":[{"kind":"keyword","text":"var"},{"kind":"text","text":" "},{"kind":"identifier","text":"count"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:Si","text":"Int"}],"role":"symbol","title":"count","identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/Commands\/count","kind":"symbol","abstract":[{"text":"The number of commands recorded in the buffer.","type":"text"}]},"doc://WorldModule/documentation/WorldModule/Commands/unrelate(_:_:from:)":{"kind":"symbol","ro