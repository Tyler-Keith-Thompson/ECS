Module\/Query.swift#L338"},"title":"Query.Where","externalID":"s:11WorldModule5QueryV5WhereV","symbolKind":"struct","navigatorTitle":[{"kind":"identifier","text":"Where"}],"modules":[{"name":"WorldModule"}]},"schemaVersion":{"minor":3,"major":0,"patch":0},"kind":"symbol","primaryContentSections":[{"kind":"declarations","declarations":[{"tokens":[{"text":"@frozen","kind":"attribute"},{"text":" ","kind":"text"},{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Where","kind":"identifier"},{"text":"<each ","kind":"text"},{"text":"F","kind":"genericParameter"},{"text":"> ","kind":"text"},{"text":"where","kind":"keyword"},{"text":" repeat each ","kind":"text"},{"text":"F","kind":"typeIdentifier"},{"text":" : ","kind":"text"},{"identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/FilterTerm","text":"FilterTerm","kind":"typeIdentifier","preciseIdentifier":"s:11WorldModule10FilterTermP"}],"platforms":["Linux"],"languages":["swift"]}]},{"mentions":["doc:\/\/WorldModule\/documentation\/WorldModule\/QueryingAWorld"],"kind":"mentions"},{"content":[{"type":"heading","level":2,"anchor":"overview","text":"Overview"},{"inlineContent":[{"text":"A system declares what it reads through the types of its parameters, so it can’t pass a","type":"text"},{"text":" ","type":"text"},{"identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/QueryFilter","isActive":true,"type":"reference"},{"text":" value. Instead, it names the filter with filter types, such as ","type":"text"},{"identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/With","isActive":true,"type":"reference"},{"text":",","type":"text"},{"text":" ","type":"text"},{"identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/Without","isActive":true,"type":"reference"},{"text":", ","type":"text"},{"identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/Added","isActive":true,"type":"reference"},{"text":" and ","type":"text"},{"identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/Changed","isActive":true,"type":"reference"},{"text":". A system that counts the entities with a position","type":"text"},{"text":" ","type":"text"},{"text":"that aren’t frozen declares a parameter of type ","type":"text"},{"code":"Query<Position>.Where<Without<Frozen>>","type":"codeVoice"},{"text":",","type":"text"},{"text":" ","type":"text"},{"text":"and iterates it like the query it holds:","type":"text"}],"type":"paragraph"},{"type":"codeListing","code":["struct ThawedCount: Resource { var value = 0 }","","@System","struct CountThawedPositions {","    func run(_ positions: Query<Position>.Where<Without<Frozen>>, count: ResourceWriter<ThawedCount>) {","        count.value.value = 0","        for _ in positions {","            count.value.value += 1","        }","    }","}","","var world = World()","world.resources.insert(ThawedCount())","world.spawn(Position(x: 0, y: 0))","world.spawn(Position(x: 1, y: 1), Frozen())","","Schedule { CountThawedPositions() }.run(on: &world)","print(world.resources[ThawedCount.self].value)","\/\/ Prints \"1\""],"syntax":"swift"},{"inlineContent":[{"text":"Listing several filter types passes the entities that pass all of them. Each filter type","type":"text"},{"text":" ","type":"text"},{"text":"stands for a ","type":"text"},{"isActive":true,"identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/QueryFilter","type":"reference"},{"text":", and the ","type":"text"},{"type":"codeVoice","code":"Where"},{"text":" type’s ","type":"text"},{"isActive":true,"identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/Query\/Where\/filter","type":"reference"},{"text":" combines them:","type":"text"}],"type":"paragraph"},{"type":"codeListing","code":["let filter = Query<Health>.Where<Changed<Health>, Without<Frozen>>.filter","print(filter == QueryFilter.changed(Health.self).without(Frozen.self))","\/\/ Prints \"true\""],"syntax":"swift"},{"inlineContent":[{"type":"text","text":"Use "},{"isActive":true,"identifier":"doc:\/\/Worl