","world.spawn(Position(x: 1, y: 1), Frozen())","","Schedule { CountThawedPositions() }.run(on: &world)","print(world.resources[ThawedCount.self].value)","\/\/ Prints \"1\""],"type":"codeListing"},{"inlineContent":[{"type":"text","text":"Listing several filter types passes the entities that pass all of them. Each filter type"},{"type":"text","text":" "},{"type":"text","text":"stands for a "},{"type":"reference","isActive":true,"identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/QueryFilter"},{"type":"text","text":", and the "},{"type":"codeVoice","code":"Where"},{"type":"text","text":" type’s "},{"type":"reference","isActive":true,"identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/Query\/Where\/filter"},{"type":"text","text":" combines them:"}],"type":"paragraph"},{"syntax":"swift","code":["let filter = Query<Health>.Where<Changed<Health>, Without<Frozen>>.filter","print(filter == QueryFilter.changed(Health.self).without(Frozen.self))","\/\/ Prints \"true\""],"type":"codeListing"},{"inlineContent":[{"type":"text","text":"Use "},{"isActive":true,"type":"reference","identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/AnyOf"},{"type":"text","text":" of filter types to pass the entities that pass at least one of them."}],"type":"paragraph"}],"kind":"content"}],"metadata":{"title":"Query.Where","extendedModule":"WorldModule","navigatorTitle":[{"text":"Where","kind":"identifier"}],"role":"symbol","remoteSource":{"url":"https:\/\/github.com\/Tyler-Keith-Thompson\/ECS\/blob\/main\/Sources\/WorldModule\/Query.swift#L349","fileName":"Query.swift"},"fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Where","kind":"identifier"}],"externalID":"s:11WorldModule5QueryV5WhereV","modules":[{"name":"WorldModule"}],"symbolKind":"struct","roleHeading":"Structure","conformance":{"availabilityPrefix":[{"type":"text","text":"Available when"}],"constraints":[{"type":"codeVoice","code":"each T"},{"type":"text","text":" conforms