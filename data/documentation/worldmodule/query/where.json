"kind":"content","content":[{"type":"heading","level":2,"text":"Overview","anchor":"overview"},{"inlineContent":[{"text":"A system declares what it reads through the types of its parameters, so it can’t pass a","type":"text"},{"text":" ","type":"text"},{"identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/QueryFilter","type":"reference","isActive":true},{"text":" value. Instead, it names the filter with filter types, such as ","type":"text"},{"identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/With","type":"reference","isActive":true},{"text":",","type":"text"},{"text":" ","type":"text"},{"identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/Without","type":"reference","isActive":true},{"text":", ","type":"text"},{"identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/Added","type":"reference","isActive":true},{"text":" and ","type":"text"},{"identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/Changed","type":"reference","isActive":true},{"text":". A system that counts the entities with a position","type":"text"},{"text":" ","type":"text"},{"text":"that aren’t frozen declares a parameter of type ","type":"text"},{"code":"Query<Position>.Where<Without<Frozen>>","type":"codeVoice"},{"text":",","type":"text"},{"text":" ","type":"text"},{"text":"and iterates it like the query it holds:","type":"text"}],"type":"paragraph"},{"type":"codeListing","code":["struct ThawedCount: Resource { var value = 0 }","","@System","struct CountThawedPositions {","    func run(_ positions: Query<Position>.Where<Without<Frozen>>, count: ResourceWriter<ThawedCount>) {","        count.value.value = 0","        for _ in positions {","            count.value.value += 1","        }","    }","}","","var world = World()","world.resources.insert(ThawedCount())","world.spawn(Position(x: 0, y: 0))","world.spawn(Position(x: 1, y: 1), Frozen())","","Schedule { CountThawedPositions() }.run(on: &world)","print(world.resources[ThawedCount.self].value)","\/\/ Prints \"1\""],"syntax":"swift"},{"inlineContent":[{"type":"text","text":"Listing several filter types passes the entities that pass all of them. Each filter type"},{"type":"text","text":" "},{"type":"text","text":"stands for a "},{"identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/QueryFilter","type":"reference","isActive":true},{"type":"text","text":", and the "},{"code":"Where","type":"codeVoice"},{"type":"text","text":" type’s "},{"identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/Query\/Where\/filter","type":"reference","isActive":true},{"type":"text","text":" combines them:"}],"type":"paragraph"},{"type":"codeListing","code":["let filter = Query<Health>.Where<Changed<Health>, Without<Frozen>>.filter","print(filter == QueryFilter.changed(Health.self).without(Frozen.self))","\/\/ Prints \"true\""],"syntax":"swift"},{"inlineContent":[{"text":"Use ","type":"text"},{"identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/AnyOf","isActive":true,"type":"reference"},{"text":" of filter types to pass the entities that pass at least one of them.","type":"text"}],"type":"paragraph"}]}],"identifier":{"url":"doc:\/\/WorldModule\/documentation\/WorldModule\/Query\/Where","interfaceLanguage":"swift"},"hierarchy":{"paths":[["doc:\/\/WorldModule\/documentation\/WorldModule","doc:\/\/WorldModule\/documentation\/WorldModule\/Query"]]},"topicSections":[{"title":"Instance Properties","identifiers":["doc:\/\/WorldModule\/documentation\/WorldModule\/Query\/Where\/first","doc:\/\/WorldModule\/documentation\/WorldModule\/Query\/Where\/query"],"anchor":"Instance-Properties","generated":true},{"title":"Instance Methods","identifiers":["doc:\/\/WorldModule\/documentation\/WorldModule\/Query\/Where\/makeIterator()"],"anchor":"Instance-Methods","generated":true},{"title":"Type Properties","identifiers":["doc:\/\/WorldModule\/documentation\/WorldModule\/Query\/Where\/filter"],"anchor":"Type-Properties","generated":true},{"title":"Default Implementations","ide