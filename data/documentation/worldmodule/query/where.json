d","isActive":true},{"type":"text","text":" and "},{"type":"reference","identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/Changed","isActive":true},{"type":"text","text":". A system that counts the entities with a position"},{"type":"text","text":" "},{"type":"text","text":"that aren’t frozen declares a parameter of type "},{"type":"codeVoice","code":"Query<Position>.Where<Without<Frozen>>"},{"type":"text","text":","},{"type":"text","text":" "},{"type":"text","text":"and iterates it like the query it holds:"}]},{"code":["struct ThawedCount: Resource { var value = 0 }","","@System","struct CountThawedPositions {","    func run(_ positions: Query<Position>.Where<Without<Frozen>>, count: ResourceWriter<ThawedCount>) {","        count.value.value = 0","        for _ in positions {","            count.value.value += 1","        }","    }","}","","var world = World()","world.resources.insert(ThawedCount())","world.spawn(Position(x: 0, y: 0))","world.spawn(Position(x: 1, y: 1), Frozen())","","Schedule { CountThawedPositions() }.run(on: &world)","print(world.resources[ThawedCount.self].value)","\/\/ Prints \"1\""],"type":"codeListing","syntax":"swift"},{"type":"paragraph","inlineContent":[{"text":"Listing several filter types passes the entities that pass all of them. Each filter type","type":"text"},{"text":" ","type":"text"},{"text":"stands for a ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/QueryFilter"},{"text":", and the ","type":"text"},{"type":"codeVoice","code":"Where"},{"text":" type’s ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/Query\/Where\/filter"},{"text":" combines them:","type":"text"}]},{"code":["let filter = Query<Health>.Where<Changed<Health>, Without<Frozen>>.filter","print(filter == QueryFilter.changed(Health.self).without(Frozen.self))","\/\/ Prints \"true\""],"type":"codeListing","syntax":"swift"},{"t