tions":[{"kind":"declarations","declarations":[{"languages":["swift"],"tokens":[{"text":"@frozen","kind":"attribute"},{"text":" ","kind":"text"},{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Where","kind":"identifier"},{"text":"<each ","kind":"text"},{"text":"F","kind":"genericParameter"},{"text":"> ","kind":"text"},{"text":"where","kind":"keyword"},{"text":" repeat each ","kind":"text"},{"text":"F","kind":"typeIdentifier"},{"text":" : ","kind":"text"},{"text":"FilterTerm","identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/FilterTerm","kind":"typeIdentifier","preciseIdentifier":"s:11WorldModule10FilterTermP"}],"platforms":["Linux"]}]},{"mentions":["doc:\/\/WorldModule\/documentation\/WorldModule\/QueryingAWorld"],"kind":"mentions"},{"content":[{"type":"heading","level":2,"text":"Overview","anchor":"overview"},{"type":"paragraph","inlineContent":[{"text":"A system declares what it reads through the types of its parameters, so it can’t pass a","type":"text"},{"text":" ","type":"text"},{"type":"reference","identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/QueryFilter","isActive":true},{"text":" value. Instead, it names the filter with filter types, such as ","type":"text"},{"type":"reference","identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/With","isActive":true},{"text":",","type":"text"},{"text":" ","type":"text"},{"type":"reference","identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/Without","isActive":true},{"text":", ","type":"text"},{"type":"reference","identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/Added","isActive":true},{"text":" and ","type":"text"},{"type":"reference","identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/Changed","isActive":true},{"text":". A system that counts the entities with a position","type":"text"},{"text":" ","type":"text"},{"text":"that aren’t frozen declares a parameter of type ","type":"text"},{"type":"codeVoice","code":"Query<Position>.Where<Without<Frozen>>"},{"text":",","type":"text"},{"text":" ","type":"text"},{"text":"and iterates it like the query it holds:","type":"text"}]},{"type":"codeListing","syntax":"swift","code":["struct ThawedCount: Resource { var value = 0 }","","@System","struct CountThawedPositions {","    func run(_ positions: Query<Position>.Where<Without<Frozen>>, count: ResourceWriter<ThawedCount>) {","        count.value.value = 0","        for _ in positions {","            count.value.value += 1","        }","    }","}","","var world = World()","world.resources.insert(ThawedCount())","world.spawn(Position(x: 0, y: 0))","world.spawn(Position(x: 1, y: 1), Frozen())","","Schedule { CountThawedPositions() }.run(on: &world)","print(world.resources[ThawedCount.self].value)","\/\/ Prints \"1\""]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Listing several filter types passes the entities that pass all of them. Each filter type"},{"type":"text","text":" "},{"type":"text","text":"stands for a "},{"type":"reference","identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/QueryFilter","isActive":true},{"type":"text","text":", and the "},{"type":"codeVoice","code":"Where"},{"type":"text","text":" type’s "},{"type":"reference","identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/Query\/Where\/filter","isActive":true},{"type":"text","text":" combines them:"}]},{"type":"codeListing","syntax":"swift","code":["let filter = Query<Health>.Where<Changed<Health>, Without<Frozen>>.filter","print(filter == QueryFilter.changed(Health.self).without(Frozen.self))","\/\/ Prints \"true\""]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Use "},{"type":"reference","isActive":true,"identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/AnyOf"},{"type":"text","text":" of filter types to pass the entities that pass at least one of them."}]}],"kind":"content"}],"relationshipsSections":[{"title":"Conforms To","identifiers":["doc:\/\/WorldModule\/s8Sen