cumentation\/WorldModule\/Added","type":"reference","isActive":true},{"type":"text","text":" and "},{"identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/Changed","type":"reference","isActive":true},{"type":"text","text":". A system that counts the entities with a position"},{"type":"text","text":" "},{"type":"text","text":"that aren’t frozen declares a parameter of type "},{"type":"codeVoice","code":"Query<Position>.Where<Without<Frozen>>"},{"type":"text","text":","},{"type":"text","text":" "},{"type":"text","text":"and iterates it like the query it holds:"}],"type":"paragraph"},{"syntax":"swift","type":"codeListing","code":["struct ThawedCount: Resource { var value = 0 }","","@System","struct CountThawedPositions {","    func run(_ positions: Query<Position>.Where<Without<Frozen>>, count: ResourceWriter<ThawedCount>) {","        count.value.value = 0","        for _ in positions {","            count.value.value += 1","        }","    }","}","","var world = World()","world.resources.insert(ThawedCount())","world.spawn(Position(x: 0, y: 0))","world.spawn(Position(x: 1, y: 1), Frozen())","","Schedule { CountThawedPositions() }.run(on: &world)","print(world.resources[ThawedCount.self].value)","\/\/ Prints \"1\""]},{"inlineContent":[{"type":"text","text":"Listing several filter types passes the entities that pass all of them. Each filter type"},{"type":"text","text":" "},{"type":"text","text":"stands for a "},{"identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/QueryFilter","type":"reference","isActive":true},{"type":"text","text":", and the "},{"type":"codeVoice","code":"Where"},{"type":"text","text":" type’s "},{"identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/Query\/Where\/filter","type":"reference","isActive":true},{"type":"text","text":" combines them:"}],"type":"paragraph"},{"syntax":"swift","type":"codeListing","code":["let filter = Query<Health>.Where<Changed<Health>, Without<Frozen>>.filter","print(filter == QueryFilter.changed(Health.self).without(Frozen.self))","\/\/ Prints \"true\""]},{"inlineContent":[{"text":"Use ","type":"text"},{"identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/AnyOf","isActive":true,"type":"reference"},{"text":" of filter types to pass the entities that pass at least one of them.","type":"text"}],"type":"paragraph"}]}],"schemaVersion":{"major":0,"minor":3,"patch":0},"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/WorldModule\/documentation\/WorldModule\/Query\/Where"},"kind":"symbol","metadata":{"extendedModule":"WorldModule","navigatorTitle":[{"kind":"identifier","text":"Where"}],"roleHeading":"Structure","role":"symbol","title":"Query.Where","conformance":{"conformancePrefix":[{"type":"text","text":"Conforms when"}],"constraints":[{"type":"codeVoice","code":"each T"},{"type":"text","text":" conforms to "},{"type":"codeVoice","code":"QueryTerm"},{"type":"text","text":"."}],"availabilityPrefix":[{"type":"text","text":"Available when"}]},"fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"Where"}],"remoteSource":{"fileName":"Query.swift","url":"https:\/\/github.com\/Tyler-Keith-Thompson\/ECS\/blob\/main\/Sources\/WorldModule\/Query.swift#L349"},"externalID":"s:11WorldModule5QueryV5WhereV","modules":[{"name":"WorldModule"}],"symbolKind":"struct"},"hierarchy":{"paths":[["doc:\/\/WorldModule\/documentation\/WorldModule","doc:\/\/WorldModule\/documentation\/WorldModule\/Query"]]},"topicSections":[{"generated":true,"identifiers":["doc:\/\/WorldModule\/documentation\/WorldModule\/Query\/Where\/first","doc:\/\/WorldModule\/documentation\/WorldModule\/Query\/Where\/query"],"title":"Instance Properties","anchor":"Instance-Properties"},{"generated":true,"identifiers":["doc:\/\/WorldModule\/documentation\/WorldModule\/Query\/Where\/makeIterator()"],"title":"Instance Methods","anchor":"Instance-Methods"},{"generated":true,"identifiers":["doc:\/\/WorldModule\/documentation\/WorldModule\/Query\/Where\/f