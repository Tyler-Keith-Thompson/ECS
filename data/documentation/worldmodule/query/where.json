{"sections":[],"relationshipsSections":[{"identifiers":["doc:\/\/WorldModule\/s8SendableP","doc:\/\/WorldModule\/s16SendableMetatypeP","doc:\/\/WorldModule\/ST"],"title":"Conforms To","type":"conformsTo","kind":"relationships"}],"hierarchy":{"paths":[["doc:\/\/WorldModule\/documentation\/WorldModule","doc:\/\/WorldModule\/documentation\/WorldModule\/Query"]]},"schemaVersion":{"patch":0,"major":0,"minor":3},"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/WorldModule\/documentation\/WorldModule\/Query\/Where"},"kind":"symbol","abstract":[{"type":"text","text":"A query whose filter a system spells as types."}],"topicSections":[{"anchor":"Instance-Properties","title":"Instance Properties","generated":true,"identifiers":["doc:\/\/WorldModule\/documentation\/WorldModule\/Query\/Where\/first","doc:\/\/WorldModule\/documentation\/WorldModule\/Query\/Where\/query"]},{"anchor":"Instance-Methods","title":"Instance Methods","generated":true,"identifiers":["doc:\/\/WorldModule\/documentation\/WorldModule\/Query\/Where\/makeIterator()"]},{"anchor":"Type-Properties","title":"Type Properties","generated":true,"identifiers":["doc:\/\/WorldModule\/documentation\/WorldModule\/Query\/Where\/filter"]},{"anchor":"Default-Implementations","title":"Default Implementations","generated":true,"identifiers":["doc:\/\/WorldModule\/documentation\/WorldModule\/Query\/Where\/Sequence-Implementations"]}],"primaryContentSections":[{"declarations":[{"tokens":[{"text":"@frozen","kind":"attribute"},{"text":" ","kind":"text"},{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Where","kind":"identifier"},{"text":"<each ","kind":"text"},{"text":"F","kind":"genericParameter"},{"text":"> ","kind":"text"},{"text":"where","kind":"keyword"},{"text":" repeat each ","kind":"text"},{"text":"F","kind":"typeIdentifier"},{"text":" : ","kind":"text"},{"text":"FilterTerm","preciseIdentifier":"s:11WorldModule10FilterTermP","kind":"typeIdentifier","identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/FilterTerm"}],"platforms":["Linux"],"languages":["swift"]}],"kind":"declarations"},{"mentions":["doc:\/\/WorldModule\/documentation\/WorldModule\/QueryingAWorld"],"kind":"mentions"},{"content":[{"level":2,"text":"Overview","type":"heading","anchor":"overview"},{"inlineContent":[{"type":"text","text":"A system declares what it reads through the types of its parameters, so it can’t pass a"},{"type":"text","text":" "},{"isActive":true,"type":"reference","identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/QueryFilter"},{"type":"text","text":" value. Instead, it names the filter with filter types, such as "},{"isActive":true,"type":"reference","identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/With"},{"type":"text","text":","},{"type":"text","text":" "},{"isActive":true,"type":"reference","identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/Without"},{"type":"text","text":", "},{"isActive":true,"type":"reference","identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/Added"},{"type":"text","text":" and "},{"isActive":true,"type":"reference","identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/Changed"},{"type":"text","text":". A system that counts the entities with a position"},{"type":"text","text":" "},{"type":"text","text":"that aren’t frozen declares a parameter of type "},{"type":"codeVoice","code":"Query<Position>.Where<Without<Frozen>>"},{"type":"text","text":","},{"type":"text","text":" "},{"type":"text","text":"and iterates it like the query it holds:"}],"type":"paragraph"},{"syntax":"swift","type":"codeListing","code":["struct ThawedCount: Resource { var value = 0 }","","@System","struct CountThawedPositions {","    func run(_ positions: Query<Position>.Where<Without<Frozen>>, count: ResourceWriter<ThawedCount>) {","        count.value.value = 0","        for _ in positions {","            count.value.value += 1","        }","    }","}","","var world = World()","world.resources.insert(ThawedCount())","world.spawn(Position(x: 0, y: 0))","world.spawn(Position(x: 1, y: 1), Frozen())","","Schedule { CountThawedPositions() }.run(on: &world)","print(world.resources[ThawedCount.self].value)","\/\/ Prints \"1\""]},{"inlineContent":[{"text":"Listing several filter types passes the entities that pass all of them. Each filter type","type":"text"},{"text":" ","type":"text"},{"text":"stands for a ","type":"text"},{"identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/QueryFilter","isActive":true,"type":"reference"},{"text":", and the ","type":"text"},{"code":"Where","type":"codeVoice"},{"text":" type’s ","type":"text"},{"identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/Query\/Where\/filter","isActive":true,"type":"reference"},{"text":" combines them:","type":"text"}],"type":"paragraph"},{"syntax":"swift","type":"codeListing","code":["let filter = Query<Health>.Where<Changed<Health>, Without<Frozen>>.filter","print(filter == QueryFilter.changed(Health.self).without(Frozen.self))","\/\/ Prints \"true\""]},{"inlineContent":[{"type":"text","text":"Use "},{"type":"reference","identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/AnyOf","isActive":true},{"type":"text","text":" of filter types to pass the entities that pass at least one of them."}],"type":"paragraph"}],"kind":"content"}],"metadata":{"extendedModule":"WorldModule","title":"Query.Where","roleHeading":"Structure","symbolKind":"struct","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Where","kind":"identifier"}],"remoteSource":{"fileName":"Query.swift","url":"https:\/\/github.com\/Tyler-Keith-Thompson\/ECS\/blob\/main\/Sources\/WorldModule\/Query.swift#L349"},"role":"symbol","modules":[{"name":"WorldModule"}],"conformance":{"constraints":[{"code":"each T","type":"codeVoice"},{"text":" conforms to ","type":"text"},{"code":"QueryTerm","type":"codeVoice"},{"text":".","type":"text"}],"conformancePrefix":[{"text":"Conforms when","type":"text"}],"avail