{"schemaVersion":{"minor":3,"major":0,"patch":0},"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/worldmodule\/query\/where"]}],"identifier":{"url":"doc:\/\/WorldModule\/documentation\/WorldModule\/Query\/Where","interfaceLanguage":"swift"},"abstract":[{"text":"A query whose filter a system spells as types.","type":"text"}],"topicSections":[{"title":"Instance Properties","anchor":"Instance-Properties","generated":true,"identifiers":["doc:\/\/WorldModule\/documentation\/WorldModule\/Query\/Where\/first","doc:\/\/WorldModule\/documentation\/WorldModule\/Query\/Where\/query"]},{"title":"Instance Methods","anchor":"Instance-Methods","generated":true,"identifiers":["doc:\/\/WorldModule\/documentation\/WorldModule\/Query\/Where\/makeIterator()"]},{"title":"Type Properties","anchor":"Type-Properties","generated":true,"identifiers":["doc:\/\/WorldModule\/documentation\/WorldModule\/Query\/Where\/filter"]},{"title":"Default Implementations","anchor":"Default-Implementations","generated":true,"identifiers":["doc:\/\/WorldModule\/documentation\/WorldModule\/Query\/Where\/Sequence-Implementations"]}],"kind":"symbol","primaryContentSections":[{"kind":"declarations","declarations":[{"tokens":[{"kind":"attribute","text":"@frozen"},{"kind":"text","text":" "},{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"Where"},{"kind":"text","text":"<each "},{"kind":"genericParameter","text":"F"},{"kind":"text","text":"> "},{"kind":"keyword","text":"where"},{"kind":"text","text":" repeat each "},{"kind":"typeIdentifier","text":"F"},{"kind":"text","text":" : "},{"identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/FilterTerm","kind":"typeIdentifier","preciseIdentifier":"s:11WorldModule10FilterTermP","text":"FilterTerm"}],"languages":["swift"],"platforms":["Linux"]}]},{"mentions":["doc:\/\/WorldModule\/documentation\/WorldModule\/QueryingAWorld"],"kind":"mentions"},{"content":[{"anchor":"overview","level":2,"type":"heading","text":"Overview"},{"inlineContent":[{"text":"A system declares what it reads through the types of its parameters, so it can’t pass a","type":"text"},{"text":" ","type":"text"},{"type":"reference","isActive":true,"identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/QueryFilter"},{"text":" value. Instead, it names the filter with filter types, such as ","type":"text"},{"type":"reference","isActive":true,"identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/With"},{"text":",","type":"text"},{"text":" ","type":"text"},{"type":"reference","isActive":true,"identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/Without"},{"text":", ","type":"text"},{"type":"reference","isActive":true,"identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/Added"},{"text":" and ","type":"text"},{"type":"reference","isActive":true,"identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/Changed"},{"text":". A system that counts the entities with a position","type":"text"},{"text":" ","type":"text"},{"text":"that aren’t frozen declares a parameter of type ","type":"text"},{"type":"codeVoice","code":"Query<Position>.Where<Without<Frozen>>"},{"text":",","type":"text"},{"text":" ","type":"text"},{"text":"and iterates it like the query it holds:","type":"text"}],"type":"paragraph"},{"code":["struct ThawedCount: Resource { var value = 0 }","","@System","struct CountThawedPositions {","    func run(_ positions: Query<Position>.Where<Without<Frozen>>, count: ResourceWriter<ThawedCount>) {","        count.value.value = 0","        for _ in positions {","            count.value.value += 1","        }","    }","}","","var world = World()","world.resources.insert(ThawedCount())","world.spawn(Position(x: 0, y: 0))","world.spawn(Position(x: 1, y: 1), Frozen())","","Schedule { CountThawedPositions() }.run(on: &world)","print(world.resources[ThawedCount.self].value)","\/\/ Prints \"1\""],"type":"codeListing","syntax":"swift"},{"inlineContent":[{"type":"text