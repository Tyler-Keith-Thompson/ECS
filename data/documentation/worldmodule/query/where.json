{"sections":[],"variants":[{"paths":["\/documentation\/worldmodule\/query\/where"],"traits":[{"interfaceLanguage":"swift"}]}],"metadata":{"fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Where","kind":"identifier"}],"remoteSource":{"url":"https:\/\/github.com\/Tyler-Keith-Thompson\/ECS\/blob\/main\/Sources\/WorldModule\/Query.swift#L349","fileName":"Query.swift"},"externalID":"s:11WorldModule5QueryV5WhereV","symbolKind":"struct","roleHeading":"Structure","title":"Query.Where","modules":[{"name":"WorldModule"}],"role":"symbol","conformance":{"availabilityPrefix":[{"type":"text","text":"Available when"}],"conformancePrefix":[{"type":"text","text":"Conforms when"}],"constraints":[{"type":"codeVoice","code":"each T"},{"type":"text","text":" conforms to "},{"type":"codeVoice","code":"QueryTerm"},{"type":"text","text":"."}]},"extendedModule":"WorldModule","navigatorTitle":[{"text":"Where","kind":"identifier"}]},"abstract":[{"text":"A query whose filter a system spells as types.","type":"text"}],"relationshipsSections":[{"kind":"relationships","type":"conformsTo","identifiers":["doc:\/\/WorldModule\/s8SendableP","doc:\/\/WorldModule\/s16SendableMetatypeP","doc:\/\/WorldModule\/ST"],"title":"Conforms To"}],"primaryContentSections":[{"declarations":[{"tokens":[{"text":"@frozen","kind":"attribute"},{"text":" ","kind":"text"},{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Where","kind":"identifier"},{"text":"<each ","kind":"text"},{"text":"F","kind":"genericParameter"},{"text":"> ","kind":"text"},{"text":"where","kind":"keyword"},{"text":" repeat each ","kind":"text"},{"text":"F","kind":"typeIdentifier"},{"text":" : ","kind":"text"},{"text":"FilterTerm","identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/FilterTerm","preciseIdentifier":"s:11WorldModule10FilterTermP","kind":"typeIdentifier"}],"platforms":["Linux"],"languages":["swift"]}],"kind":"declarations"},{"kind":"mentions","mentions":["doc:\/\/WorldModule\/documentation\/WorldModule\/QueryingAWorld"]},{"kind":"content","content":[{"text":"Overview","type":"heading","level":2,"anchor":"overview"},{"inlineContent":[{"text":"A system declares what it reads through the types of its parameters, so it can’t pass a","type":"text"},{"text":" ","type":"text"},{"identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/QueryFilter","isActive":true,"type":"reference"},{"text":" value. Instead, it names the filter with filter types, such as ","type":"text"},{"identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/With","isActive":true,"type":"reference"},{"text":",","type":"text"},{"text":" ","type":"text"},{"identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/Without","isActive":true,"type":"reference"},{"text":", ","type":"text"},{"identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/Added","isActive":true,"type":"reference"},{"text":" and ","type":"text"},{"identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/Changed","isActive":true,"type":"reference"},{"text":". A system that counts the entities with a position","type":"text"},{"text":" ","type":"text"},{"text":"that aren’t frozen declares a parameter of type ","type":"text"},{"code":"Query<Position>.Where<Without<Frozen>>","type":"codeVoice"},{"text":",","type":"text"},{"text":" ","type":"text"},{"text":"and iterates it like the query it holds:","type":"text"}],"type":"paragraph"},{"syntax":"swift","code":["struct ThawedCount: Resource { var value = 0 }","","@System","struct CountThawedPositions {","    func run(_ positions: Query<Position>.Where<Without<Frozen>>, count: ResourceWriter<ThawedCount>) {","        count.value.value = 0","        for _ in positions {","            count.value.value += 1","        }","    }","}","","var world = World()","world.resources.insert(ThawedCount())","world.spawn(Position(x: 0, y: 0))","world.spawn(Position(x: 1, y: 1), Frozen())","","Schedule { CountThawedPositions() }.run(on: &world)","print(world.resources[ThawedCount.self].value)","\/\/ Prints \"1\""],"type":"codeListing"},{"inlineContent":[{"type":"text","text":"Listing several filter types passes the entities that pass all of them. Each filter type"},{"type":"text","text":" "},{"type":"text","text":"stands for a "},{"type":"reference","isActive":true,"identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/QueryFilter"},{"type":"text","text":", and the "},{"type":"codeVoice","code":"Where"},{"type":"text","text":" type’s "},{"type":"reference","isActive":true,"identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/Query\/Where\/filter"},{"type":"text","text":" combines them:"}],"type":"paragraph"},{"syntax":"swift","code":["let filter = Query<Health>.Where<Changed<Health>, Without<Frozen>>.filter","print(filter == QueryFilter.changed(Health.self).without(Frozen.self))","\/\/ Prints \"true\""],"type":"codeListing"},{"inlineContent":[{"type":"text","text":"Use "},{"type":"reference","isActive":true,"identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/AnyOf"},{"type":"text","text":" of filter types to pass the entities that pass at least one of them."}],"type":"paragraph"}]}],"topicSections":[{"generated":true,"anchor":"Instance-Properties","identifiers":["doc:\/\/WorldModule\/documentation\/WorldModule\/Query\/Where\/first","doc:\/\/WorldModule\/documentation\/WorldModule\/Query\/Where\/query"],"title":"Instance Properties"},{"generated":true,"anchor":"Instance-Methods","identifiers":["doc:\/\/WorldModule\/documentation\/WorldModule\/Query\/Where\/makeIterator()"],"title":"Instance Methods"},{"generated":true,"anchor":"Type-Properties","identifiers":["doc:\/\/WorldModule\/documentation\/WorldModule\/Query\/Where\/filter"],"title":"Type Properties"},{"generated":true,"anchor":"Default-Implementations","identifiers":["doc:\/\/WorldModule\/documentation\/WorldModule\/Query\/Where\/Sequence-Implementations"],"title":"Default Implementations"}],"hierarchy":{"paths":[["doc:\/\/WorldMo