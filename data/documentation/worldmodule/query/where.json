"kind":"mentions","mentions":["doc:\/\/WorldModule\/documentation\/WorldModule\/QueryingAWorld"]},{"content":[{"level":2,"text":"Overview","anchor":"overview","type":"heading"},{"inlineContent":[{"type":"text","text":"A system declares what it reads through the types of its parameters, so it can’t pass a"},{"type":"text","text":" "},{"type":"reference","isActive":true,"identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/QueryFilter"},{"type":"text","text":" value. Instead, it names the filter with filter types, such as "},{"type":"reference","isActive":true,"identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/With"},{"type":"text","text":","},{"type":"text","text":" "},{"type":"reference","isActive":true,"identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/Without"},{"type":"text","text":", "},{"type":"reference","isActive":true,"identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/Added"},{"type":"text","text":" and "},{"type":"reference","isActive":true,"identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/Changed"},{"type":"text","text":". A system that counts the entities with a position"},{"type":"text","text":" "},{"type":"text","text":"that aren’t frozen declares a parameter of type "},{"code":"Query<Position>.Where<Without<Frozen>>","type":"codeVoice"},{"type":"text","text":","},{"type":"text","text":" "},{"type":"text","text":"and iterates it like the query it holds:"}],"type":"paragraph"},{"code":["struct ThawedCount: Resource { var value = 0 }","","@System","struct CountThawedPositions {","    func run(_ positions: Query<Position>.Where<Without<Frozen>>, count: ResourceWriter<ThawedCount>) {","        count.value.value = 0","        for _ in positions {","            count.value.value += 1","        }","    }","}","","var world = World()","world.resources.insert(ThawedCount())","world.spawn(Position(x: 0, y: 0))","world.spawn(Position(x: 1, y: 1), Frozen())","","Schedule { CountThawedPositions() }.run(on: &world)","print(world.resources[ThawedCount.self].value)","\/\/ Prints \"1\""],"syntax":"swift","type":"codeListing"},{"inlineContent":[{"text":"Listing several filter types passes the entities that pass all of them. Each filter type","type":"text"},{"text":" ","type":"text"},{"text":"stands for a ","type":"text"},{"identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/QueryFilter","isActive":true,"type":"reference"},{"text":", and the ","type":"text"},{"code":"Where","type":"codeVoice"},{"text":" type’s ","type":"text"},{"identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/Query\/Where\/filter","isActive":true,"type":"reference"},{"text":" combines them:","type":"text"}],"type":"paragraph"},{"code":["let filter = Query<Health>.Where<Changed<Health>, Without<Frozen>>.filter","print(filter == QueryFilter.changed(Health.self).without(Frozen.self))","\/\/ Prints \"true\""],"syntax":"swift","type":"codeListing"},{"inlineContent":[{"type":"text","text":"Use "},{"type":"reference","isActive":true,"identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/AnyOf"},{"type":"text","text":" of filter types to pass the entities that pass at least one of them."}],"type":"paragraph"}],"kind":"content"}],"schemaVersion":{"major":0,"patch":0,"minor":3},"topicSections":[{"title":"Instance Properties","generated":true,"anchor":"Instance-Properties","identifiers":["doc:\/\/WorldModule\/documentation\/WorldModule\/Query\/Where\/first","doc:\/\/WorldModule\/documentation\/WorldModule\/Query\/Where\/query"]},{"title":"Instance Methods","generated":true,"anchor":"Instance-Methods","identifiers":["doc:\/\/WorldModule\/documentation\/WorldModule\/Query\/Where\/makeIterator()"]},{"title":"Type Properties","generated":true,"anchor":"Type-Properties","identifiers":["doc:\/\/WorldModule\/documentation\/WorldModule\/Query\/Where\/filter"]},{"title":"Default Implementations","generated":true,"anchor":"Default-Implementations","identifiers":["doc:\/\/WorldModule\/documentation\