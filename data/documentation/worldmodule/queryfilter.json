orldModule\/QueryingAWorld"]},{"kind":"content","content":[{"level":2,"type":"heading","text":"Overview","anchor":"overview"},{"inlineContent":[{"text":"A filter can require component types, exclude them, require components added or changed since","type":"text"},{"text":" ","type":"text"},{"text":"a tick, and require a relation to a target. Filters read nothing: an entity’s components decide","type":"text"},{"text":" ","type":"text"},{"text":"whether it passes, but a query’s rows carry only the values of its terms.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"Build a filter from a static method such as "},{"type":"reference","identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/QueryFilter\/with(_:)-swift.type.method","isActive":true},{"type":"text","text":" and refine it with"},{"type":"text","text":" "},{"type":"text","text":"the instance methods of the same names. Each method returns a new filter that an entity passes"},{"type":"text","text":" "},{"type":"text","text":"only if it meets every condition. To pass entities that meet at least one of several filters,"},{"type":"text","text":" "},{"type":"text","text":"use "},{"type":"reference","identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/QueryFilter\/anyOf(_:)-swift.type.method","isActive":true},{"type":"text","text":", so you can write any condition on which component types an"},{"type":"text","text":" "},{"type":"text","text":"entity holds:"}],"type":"paragraph"},{"code":["var world = World()","world.spawn(Name(value: \"drifter\"), Velocity(dx: 1, dy: 0))","world.spawn(Name(value: \"statue\"), Frozen())","world.spawn(Name(value: \"ghost\"), Velocity(dx: 1, dy: 0), Frozen())","world.spawn(Name(value: \"rock\"))","","let moving = QueryFilter.with(Velocity.self).without(Frozen.self)","let movingOrFrozen = QueryFilter.anyOf(.with(Velocity.self), .with(Frozen.self))","","let movingNames = world.query(Name.self).filtered(by: moving).map { $0.1.value }","print(movingNames)","\/\/ Prints \"[\"drifter\"]\"","","let movingOrFrozenNames = world.query(Name.self).filtered(by: movingOrFrozen).map { $0.1.value }","print(movingOrFrozenNames)","\/\/ Prints \"[\"drifter\", \"statue\", \"ghost\"]\""],"type":"codeListing","syntax":"swift"},{"inlineContent":[{"text":"Pass a filter to ","type":"text"},{"type":"reference","identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/Query\/init(filter:)","isActive":true},{"text":", to ","type":"text"},{"type":"reference","identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/Query\/filtered(by:)","isActive":true},{"text":", or as the ","type":"text"},{"type":"codeVoice","code":"where"},{"text":" ","type":"text"},{"text":"argument of ","type":"text"},{"type":"codeVoice","code":"update(_:reading:where:body:)"},{"text":". Queries, views and updates also offer the same","type":"text"},{"text":" ","type":"text"},{"text":"methods directly, so you can write ","type":"text"},{"type":"codeVoice","code":"Query(Name.self).without(Frozen.self)"},{"text":".","type":"text"}],"type":"paragraph"}]}],"references":{"doc://WorldModule/documentation/WorldModule/QueryFilter/allowing(_:)-swift.type.method":{"fragments":[{"kind":"keyword","text":"static"},{"kind":"text","text":" "},{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"allowing"},{"kind":"text","text":"<each "},{"kind":"genericParameter","text":"C"},{"kind":"text","text":">(repeat (each "},{"kind":"typeIdentifier","text":"C"},{"kind":"text","text":").Type) -> "},{"kind":"typeIdentifier","text":"QueryFilter","preciseIdentifier":"s:11WorldModule11QueryFilterV"}],"identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/QueryFilter\/allowing(_:)-swift.type.method","kind":"symbol","abstract":[{"type":"text","text":"Returns a filter that also passes the entities holding the given disabling components."}],"url":"\/documentation\/worldmodule\/queryfilter\/allowing(_:)-swift.type.method","title":"allowing(_