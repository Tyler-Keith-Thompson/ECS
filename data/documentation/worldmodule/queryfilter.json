:"text"},{"identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/QueryFilter\/anyOf(_:)-swift.type.method","type":"reference","isActive":true},{"text":", so you can write any condition on which component types an","type":"text"},{"text":" ","type":"text"},{"text":"entity holds:","type":"text"}],"type":"paragraph"},{"syntax":"swift","type":"codeListing","code":["var world = World()","world.spawn(Name(value: \"drifter\"), Velocity(dx: 1, dy: 0))","world.spawn(Name(value: \"statue\"), Frozen())","world.spawn(Name(value: \"ghost\"), Velocity(dx: 1, dy: 0), Frozen())","world.spawn(Name(value: \"rock\"))","","let moving = QueryFilter.with(Velocity.self).without(Frozen.self)","let movingOrFrozen = QueryFilter.anyOf(.with(Velocity.self), .with(Frozen.self))","","let movingNames = world.query(Name.self).filtered(by: moving).map { $0.1.value }","print(movingNames)","\/\/ Prints \"[\"drifter\"]\"","","let movingOrFrozenNames = world.query(Name.self).filtered(by: movingOrFrozen).map { $0.1.value }","print(movingOrFrozenNames)","\/\/ Prints \"[\"drifter\", \"statue\", \"ghost\"]\""]},{"inlineContent":[{"type":"text","text":"Pass a filter to "},{"identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/Query\/init(filter:)","type":"reference","isActive":true},{"type":"text","text":", to "},{"identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/Query\/filtered(by:)","type":"reference","isActive":true},{"type":"text","text":", or as the "},{"type":"codeVoice","code":"where"},{"type":"text","text":" "},{"type":"text","text":"argument of "},{"type":"codeVoice","code":"update(_:reading:where:body:)"},{"type":"text","text":". Queries, views and updates also offer the same"},{"type":"text","text":" "},{"type":"text","text":"methods directly, so you can write "},{"type":"codeVoice","code":"Query(Name.self).without(Frozen.self)"},{"type":"text","text":"."}],"type":"paragraph"}]}],"hierarchy":{"paths":[["doc:\/\/WorldModule\/documentation\/WorldModule"]]},"metadata":{