text"},{"text":" ","type":"text"},{"text":"use ","type":"text"},{"isActive":true,"identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/QueryFilter\/anyOf(_:)-swift.type.method","type":"reference"},{"text":", so you can write any condition on which component types an","type":"text"},{"text":" ","type":"text"},{"text":"entity holds:","type":"text"}]},{"syntax":"swift","type":"codeListing","code":["var world = World()","world.spawn(Name(value: \"drifter\"), Velocity(dx: 1, dy: 0))","world.spawn(Name(value: \"statue\"), Frozen())","world.spawn(Name(value: \"ghost\"), Velocity(dx: 1, dy: 0), Frozen())","world.spawn(Name(value: \"rock\"))","","let moving = QueryFilter.with(Velocity.self).without(Frozen.self)","let movingOrFrozen = QueryFilter.anyOf(.with(Velocity.self), .with(Frozen.self))","","let movingNames = world.query(Name.self).filtered(by: moving).map { $0.1.value }","print(movingNames)","\/\/ Prints \"[\"drifter\"]\"","","let movingOrFrozenNames = world.query(Name.self).filtered(by: movingOrFrozen).map { $0.1.value }","print(movingOrFrozenNames)","\/\/ Prints \"[\"drifter\", \"statue\", \"ghost\"]\""]},{"type":"paragraph","inlineContent":[{"text":"Pass a filter to ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/Query\/init(filter:)"},{"text":", to ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/Query\/filtered(by:)"},{"text":", or as the ","type":"text"},{"code":"where","type":"codeVoice"},{"text":" ","type":"text"},{"text":"argument of ","type":"text"},{"code":"update(_:reading:where:body:)","type":"codeVoice"},{"text":". Queries, views and updates also offer the same","type":"text"},{"text":" ","type":"text"},{"text":"methods directly, so you can write ","type":"text"},{"code":"Query(Name.self).without(Frozen.self)","type":"codeVoice"},{"text":".","type":"text"}]}]}],"identifier":{"url":"doc:\/\/WorldModule\/documentat