{"schemaVersion":{"major":0,"minor":3,"patch":0},"relationshipsSections":[{"title":"Inherits From","type":"inheritsFrom","identifiers":["doc:\/\/WorldModule\/s8SendableP","doc:\/\/WorldModule\/s16SendableMetatypeP"],"kind":"relationships"},{"title":"Conforming Types","type":"conformingTypes","identifiers":["doc:\/\/WorldModule\/documentation\/WorldModule\/ChildOf"],"kind":"relationships"}],"hierarchy":{"paths":[["doc:\/\/WorldModule\/documentation\/WorldModule"]]},"seeAlsoSections":[{"title":"Relating Entities","identifiers":["doc:\/\/WorldModule\/documentation\/WorldModule\/Targets","doc:\/\/WorldModule\/documentation\/WorldModule\/CleanupAction"],"anchor":"Relating-Entities","generated":true}],"kind":"symbol","variants":[{"paths":["\/documentation\/worldmodule\/relation"],"traits":[{"interfaceLanguage":"swift"}]}],"metadata":{"symbolKind":"protocol","navigatorTitle":[{"text":"Relation","kind":"identifier"}],"role":"symbol","roleHeading":"Protocol","title":"Relation","remoteSource":{"fileName":"Relations.swift","url":"https:\/\/github.com\/Tyler-Keith-Thompson\/ECS\/blob\/main\/Sources\/WorldModule\/Relations.swift#L61"},"externalID":"s:11WorldModule8RelationP","modules":[{"name":"WorldModule"}],"fragments":[{"kind":"keyword","text":"protocol"},{"kind":"text","text":" "},{"kind":"identifier","text":"Relation"}]},"identifier":{"url":"doc:\/\/WorldModule\/documentation\/WorldModule\/Relation","interfaceLanguage":"swift"},"abstract":[{"type":"text","text":"A type that describes a kind of link from one entity to others."}],"topicSections":[{"title":"Type Properties","identifiers":["doc:\/\/WorldModule\/documentation\/WorldModule\/Relation\/isExclusive","doc:\/\/WorldModule\/documentation\/WorldModule\/Relation\/onTargetDespawn"],"anchor":"Type-Properties","generated":true}],"primaryContentSections":[{"kind":"declarations","declarations":[{"languages":["swift"],"tokens":[{"text":"protocol","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Relation","kind":"identifier"},{"text":" : ","kind":"text"},{"preciseIdentifier":"s:s8SendableP","text":"Sendable","kind":"typeIdentifier"}],"platforms":["Linux"]}]},{"mentions":["doc:\/\/WorldModule\/documentation\/WorldModule\/RelatingEntities","doc:\/\/WorldModule\/documentation\/WorldModule\/SavingAndLoadingWorlds"],"kind":"mentions"},{"content":[{"type":"heading","anchor":"overview","level":2,"text":"Overview"},{"type":"paragraph","inlineContent":[{"text":"A relation links a ","type":"text"},{"inlineContent":[{"text":"source","type":"text"}],"type":"emphasis"},{"text":" entity to one or more ","type":"text"},{"inlineContent":[{"type":"text","text":"target"}],"type":"emphasis"},{"text":" entities: a unit likes another,","type":"text"},{"text":" ","type":"text"},{"text":"a turret is aimed at a ship, a part is a child of its parent (","type":"text"},{"identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/ChildOf","isActive":true,"type":"reference"},{"text":"). Declare a relation","type":"text"},{"text":" ","type":"text"},{"text":"as a type that conforms to ","type":"text"},{"code":"Relation","type":"codeVoice"},{"text":", then link entities with ","type":"text"},{"identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/World\/relate(_:_:to:)","isActive":true,"type":"reference"},{"text":":","type":"text"}]},{"type":"codeListing","syntax":"swift","code":["struct Likes: Relation {}","","var world = World()","let alice = world.spawn(Name(value: \"Alice\"))","let bob = world.spawn(Name(value: \"Bob\"))","world.relate(alice, Likes(), to: bob)","","print(world.targets(Likes.self, of: alice) == [bob])","\/\/ Prints \"true\"","print(world.sources(Likes.self, of: bob) == [alice])","\/\/ Prints \"true\""]},{"type":"paragraph","inlineContent":[{"text":"The world stores each link as a pair of a target and a value of the relation, so a relation","type":"text"},{"text":" ","type":"text"},{"text":"can carry data about the link:","type":"text"}]},{"type":"codeListing","syntax":"swift","code":["struct Owes: Relation { var amount: Int }","","var world = World()","let alice = world.spawn(Name(value: \"Alice\"))","let bob = world.spawn(Name(value: \"Bob\"))","world.relate(alice, Owes(amount: 20), to: bob)","","if let debt = world[Targets<Owes>.self, of: alice][bob] {","    print(debt.amount)","    \/\/ Prints \"20\"","}"]},{"type":"heading","anchor":"Querying-Relations","level":3,"text":"Querying Relations"},{"type":"paragraph","inlineContent":[{"text":"A source holds its pairs of a relation in a ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/Targets"},{"text":" component, so you can read and filter","type":"text"},{"text":" ","type":"text"},{"text":"on it like any other component. The world also keeps an index of each target’s sources, so","type":"text"},{"text":" ","type":"text"},{"text":"filtering a query with ","type":"text"},{"code":".related(_:to:)","type":"codeVoice"},{"text":" visits only the entities related to that target:","type":"text"}]},{"type":"codeListing","syntax":"swift","code":["var world = World()","let alice = world.spawn(Name(value: \"Alice\"))","let bob = world.spawn(Name(value: \"Bob\"))","let carol = world.spawn(Name(value: \"Carol\"))","world.relate(alice, Likes(), to: bob)","world.relate(carol, Likes(), to: bob)","","let fans = world.query(Name.self).related(Likes.self, to: bob).map { $0.1.value }","print(fans.sorted())","\/\/ Prints \"[\"Alice\", \"Carol\"]\""]},{"type":"heading","anchor":"Customizing-a-Relation","level":3,"text":"Customizing a Relation"},{"type":"paragraph","inlineContent":[{"type":"text","text":"By default a source can relate to any number of targets, and despawning a target removes"},{"type":"text","text":" "},{"type":"text","text":"its pairs from the sources. Implement "},{"isActive":true,"type":"reference","identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/Relation\/isExclusive"},{"type":"text","text":" or "},{"isActive":true,"type":"reference","identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/Relation\/onTargetDespawn"},{"type":"text","text":" to change that."}]}],"kind":"content"}],"sections":[],"references":{"doc://WorldModule/documentation/WorldModule/Relation/isExclusive":{"abstract":[{"text":"A Boolean value indicating whether a source relates to at most one target.","type":"text"}],"defaultImplementations":1,"url":"\/documentation\/worldmodule\/relation\/isexclusive","title":"isExclusive","kind":"symbol","type":"topic","required":true,"role":"symbol","identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/Relation\/isExclusive","fragments":[{"kind":"keyword","text":"static"},{"kind":"text","text":" "},{"kind":"keyword","text":"var"},{"kind":"text","text":" "},{"kind":"identifier","text":"isExclusive"},{"kind":"text","text":": "},{"preciseIdentifier":"s:Sb","kind":"typeIdentifier","text":"Bool"}]},"doc://WorldModule/documentation/WorldModule/RelatingEntities":{"identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/RelatingEntities","type":"topic","title":"Relating Entities","kind":"article","role":"article","abstract":[{"type":"text","text":"Link entities to one another, build trees of parents and children, and query entities by what"},{"type":"text","text":" "},{"type":"text","text":"they’re linked to."}],"url":"\/documentation\/worldmodule\/relatingentities"},"doc://WorldModule/documentation/WorldModule/Relation/onTargetDespawn":{"title":"onTargetDespawn","url":"\/documentation\/worldmodule\/relation\/ontargetdespawn","fragments":[{"text":"static","kind":"keyword"},{"text":" ","kind":"text"},{"text":"var","kind":"keyword"},{"text":" ","kind":"text"},{"text":"onTargetDespawn","kind":"identifier"},{"text":": ","kind":"text"},{"text":"CleanupAction","preciseIdentifier":"s:11WorldModule13CleanupActionO","kind":"typeIdentifier"}],"abstract":[{"type":"text","text":"What despawning a target does to the sources related to it."}],"type":"topic","defaultImplementat