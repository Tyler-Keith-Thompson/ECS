:)","identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/World\/relate(_:_:to:)","title":"relate(_:_:to:)","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"relate","kind":"identifier"},{"text":"<","kind":"text"},{"text":"R","kind":"genericParameter"},{"text":">(","kind":"text"},{"text":"Entity","kind":"typeIdentifier","preciseIdentifier":"s:11WorldModule6EntityV"},{"text":", ","kind":"text"},{"text":"R","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"to","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"Entity","kind":"typeIdentifier","preciseIdentifier":"s:11WorldModule6EntityV"},{"kind":"text","text":")"}],"kind":"symbol","role":"symbol","abstract":[{"type":"text","text":"Links a source entity to a target entity by a relation."}]},"doc://WorldModule/documentation/WorldModule/ChildOf":{"type":"topic","url":"\/documentation\/worldmodule\/childof","identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/ChildOf","title":"ChildOf","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"ChildOf","kind":"identifier"}],"navigatorTitle":[{"text":"ChildOf","kind":"identifier"}],"kind":"symbol","role":"symbol","abstract":[{"text":"The relation that links a child entity to its parent.","type":"text"}]},"doc://WorldModule/s8SendableP":{"title":"Swift.Sendable","type":"unresolvable","identifier":"doc:\/\/WorldModule\/s8SendableP"},"doc://WorldModule/documentation/WorldModule/Relation":{"type":"topic","url":"\/documentation\/worldmodule\/relation","identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/Relation","title":"Relation","fragments":[{"text":"protocol","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Relation","kind":"identifier"}],"navigatorTitle":[{"text":"Relation","kind":"identifier"}],"kind":"symbol","role":"symbol","abstract":[{"text":"A type that describes a kind of link from one entity to others.","type":"text"}]}}}