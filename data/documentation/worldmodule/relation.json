{"primaryContentSections":[{"kind":"declarations","declarations":[{"platforms":["Linux"],"languages":["swift"],"tokens":[{"kind":"keyword","text":"protocol"},{"kind":"text","text":" "},{"kind":"identifier","text":"Relation"},{"kind":"text","text":" : "},{"kind":"typeIdentifier","text":"Sendable","preciseIdentifier":"s:s8SendableP"}]}]},{"kind":"mentions","mentions":["doc:\/\/WorldModule\/documentation\/WorldModule\/SavingAndLoadingWorlds"]},{"kind":"content","content":[{"type":"heading","level":2,"anchor":"overview","text":"Overview"},{"type":"paragraph","inlineContent":[{"type":"text","text":"A relation links a "},{"type":"emphasis","inlineContent":[{"type":"text","text":"source"}]},{"type":"text","text":" entity to one or more "},{"type":"emphasis","inlineContent":[{"text":"target","type":"text"}]},{"type":"text","text":" entities: a unit likes another,"},{"type":"text","text":" "},{"type":"text","text":"a turret is aimed at a ship, a part is a child of its parent ("},{"type":"reference","identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/ChildOf","isActive":true},{"type":"text","text":"). Declare a relation"},{"type":"text","text":" "},{"type":"text","text":"as a type that conforms to "},{"type":"codeVoice","code":"Relation"},{"type":"text","text":", then link entities with "},{"type":"reference","identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/World\/relate(_:_:to:)","isActive":true},{"type":"text","text":":"}]},{"type":"codeListing","syntax":"swift","code":["struct Likes: Relation {}","","var world = World()","let alice = world.spawn(Name(value: \"Alice\"))","let bob = world.spawn(Name(value: \"Bob\"))","world.relate(alice, Likes(), to: bob)","","print(world.targets(Likes.self, of: alice) == [bob])","\/\/ Prints \"true\"","print(world.sources(Likes.self, of: bob) == [alice])","\/\/ Prints \"true\""]},{"type":"paragraph","inlineContent":[{"text":"The world stores each link as a pair of a target and a value of the relation, so a relation","type":"text"},{"text":" ","type":"text"},{"text":"can carry data about the link:","type":"text"}]},{"type":"codeListing","syntax":"swift","code":["struct Owes: Relation { var amount: Int }","","var world = World()","let alice = world.spawn(Name(value: \"Alice\"))","let bob = world.spawn(Name(value: \"Bob\"))","world.relate(alice, Owes(amount: 20), to: bob)","","if let debt = world[Targets<Owes>.self, of: alice][bob] {","    print(debt.amount)","    \/\/ Prints \"20\"","}"]},{"type":"heading","level":3,"anchor":"Querying-Relations","text":"Querying Relations"},{"type":"paragraph","inlineContent":[{"text":"A source holds its pairs of a relation in a ","type":"text"},{"isActive":true,"identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/Targets","type":"reference"},{"text":" component, so you can read and filter","type":"text"},{"text":" ","type":"text"},{"text":"on it like any other component. The world also keeps an index of each target’s sources, so","type":"text"},{"text":" ","type":"text"},{"text":"filtering a query with ","type":"text"},{"code":".related(_:to:)","type":"codeVoice"},{"text":" visits only the entities related to that target:","type":"text"}]},{"type":"codeListing","syntax":"swift","code":["var world = World()","let alice = world.spawn(Name(value: \"Alice\"))","let bob = world.spawn(Name(value: \"Bob\"))","let carol = world.spawn(Name(value: \"Carol\"))","world.relate(alice, Likes(), to: bob)","world.relate(carol, Likes(), to: bob)","","let fans = world.query(Name.self).related(Likes.self, to: bob).map { $0.1.value }","print(fans.sorted())","\/\/ Prints \"[\"Alice\", \"Carol\"]\""]},{"type":"heading","level":3,"anchor":"Customizing-a-Relation","text":"Customizing a Relation"},{"type":"paragraph","inlineContent":[{"type":"text","text":"By default a source can relate to any number of targets, and despawning a target removes"},{"type":"text","text":" "},{"type":"text","text":"its pairs from the sources. Implement "},{"isActive":true,"identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/Relation\/isExclusive","type":"reference"},{"type":"text","text":" or "},{"isActive":true,"identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/Relation\/onTargetDespawn","type":"reference"},{"type":"text","text":" to change that."}]}]}],"variants":[{"paths":["\/documentation\/worldmodule\/relation"],"traits":[{"interfaceLanguage":"swift"}]}],"hierarchy":{"paths":[["doc:\/\/WorldModule\/documentation\/WorldModule"]]},"relationshipsSections":[{"title":"Inherits From","kind":"relationships","type":"inheritsFrom","identifiers":["doc:\/\/WorldModule\/s8SendableP","doc:\/\/WorldModule\/s16SendableMetatypeP"]},{"title":"Conforming Types","kind":"relationships","type":"conformingTypes","identifiers":["doc:\/\/WorldModule\/documentation\/WorldModule\/ChildOf"]}],"sections":[],"kind":"symbol","metadata":{"symbolKind":"protocol","title":"Relation","fragments":[{"kind":"keyword","text":"protocol"},{"kind":"text","text":" "},{"kind":"identifier","text":"Relation"}],"modules":[{"name":"WorldModule"}],"roleHeading":"Protocol","role":"symbol","navigatorTitle":[{"kind":"identifier","text":"Relation"}],"externalID":"s:11WorldModule8RelationP","remoteSource":{"fileName":"Relations.swift","url":"https:\/\/github.com\/Tyler-Keith-Thompson\/ECS\/blob\/main\/Sources\/WorldModule\/Relations.swift#L61"}},"schemaVersion":{"major":0,"patch":0,"minor":3},"abstract":[{"type":"text","text":"A type that describes a kind of link from one entity to others."}],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/WorldModule\/documentation\/WorldModule\/Relation"},"topicSections":[{"title":"Type Properties","anchor":"Type-Properties","generated":true,"identifiers":["doc:\/\/WorldModule\/documentation\/WorldModule\/Relation\/isExclusive","doc:\/\/WorldModule\/documentation\/WorldModule\/Relation\/onTargetDespawn"]}],"seeAlsoSections":[{"title":"Relating Entities","anchor":"Relating-Entities","generated":true,"identifiers":["doc:\/\/W