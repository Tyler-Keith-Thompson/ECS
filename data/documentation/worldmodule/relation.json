{"relationshipsSections":[{"kind":"relationships","type":"inheritsFrom","title":"Inherits From","identifiers":["doc:\/\/WorldModule\/s8SendableP","doc:\/\/WorldModule\/s16SendableMetatypeP"]},{"kind":"relationships","type":"conformingTypes","title":"Conforming Types","identifiers":["doc:\/\/WorldModule\/documentation\/WorldModule\/ChildOf"]}],"seeAlsoSections":[{"generated":true,"anchor":"Relating-Entities","title":"Relating Entities","identifiers":["doc:\/\/WorldModule\/documentation\/WorldModule\/Targets","doc:\/\/WorldModule\/documentation\/WorldModule\/CleanupAction"]}],"abstract":[{"text":"A type that describes a kind of link from one entity to others.","type":"text"}],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/WorldModule\/documentation\/WorldModule\/Relation"},"hierarchy":{"paths":[["doc:\/\/WorldModule\/documentation\/WorldModule"]]},"topicSections":[{"generated":true,"anchor":"Type-Properties","title":"Type Properties","identifiers":["doc:\/\/WorldModule\/documentation\/WorldModule\/Relation\/isExclusive","doc:\/\/WorldModule\/documentation\/WorldModule\/Relation\/onTargetDespawn"]}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/worldmodule\/relation"]}],"metadata":{"fragments":[{"text":"protocol","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Relation","kind":"identifier"}],"roleHeading":"Protocol","title":"Relation","role":"symbol","remoteSource":{"fileName":"Relations.swift","url":"https:\/\/github.com\/Tyler-Keith-Thompson\/ECS\/blob\/main\/Sources\/WorldModule\/Relations.swift#L61"},"navigatorTitle":[{"text":"Relation","kind":"identifier"}],"symbolKind":"protocol","externalID":"s:11WorldModule8RelationP","modules":[{"name":"WorldModule"}]},"primaryContentSections":[{"declarations":[{"languages":["swift"],"platforms":["Linux"],"tokens":[{"text":"protocol","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Relation","kind":"identifier"},{"text":" : ","kind":"text"},{"preciseIdentifier":"s:s8SendableP","text":"Sendable","kind":"typeIdentifier"}]}],"kind":"declarations"},{"kind":"mentions","mentions":["doc:\/\/WorldModule\/documentation\/WorldModule\/SavingAndLoadingWorlds"]},{"content":[{"anchor":"overview","type":"heading","level":2,"text":"Overview"},{"type":"paragraph","inlineContent":[{"text":"A relation links a ","type":"text"},{"inlineContent":[{"text":"source","type":"text"}],"type":"emphasis"},{"text":" entity to one or more ","type":"text"},{"inlineContent":[{"type":"text","text":"target"}],"type":"emphasis"},{"text":" entities: a unit likes another,","type":"text"},{"text":" ","type":"text"},{"text":"a turret is aimed at a ship, a part is a child of its parent (","type":"text"},{"identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/ChildOf","isActive":true,"type":"reference"},{"text":"). Declare a relation","type":"text"},{"text":" ","type":"text"},{"text":"as a type that conforms to ","type":"text"},{"code":"Relation","type":"codeVoice"},{"text":", then link entities with ","type":"text"},{"identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/World\/relate(_:_:to:)","isActive":true,"type":"reference"},{"text":":","type":"text"}]},{"type":"codeListing","code":["struct Likes: Relation {}","","var world = World()","let alice = world.spawn(Name(value: \"Alice\"))","let bob = world.spawn(Name(value: \"Bob\"))","world.relate(alice, Likes(), to: bob)","","print(world.targets(Likes.self, of: alice) == [bob])","\/\/ Prints \"true\"","print(world.sources(Likes.self, of: bob) == [alice])","\/\/ Prints \"true\""],"syntax":"swift"},{"type":"paragraph","inlineContent":[{"text":"The world stores each link as a pair of a target and a value of the relation, so a relation","type":"text"},{"text":" ","type":"text"},{"text":"can carry data about the link:","type":"text"}]},{"type":"codeListing","code":["struct Owes: Relation { var amount: Int }","","var world = World()","let alice = world.spawn(Name(value: \"Alice\"))","let bob = world.spawn(Name(value: \"Bob\"))","world.relate(alice, Owes(amount: 20), to: bob)","","if let debt = world[Targets<Owes>.self, of: alice][bob] {","    print(debt.amount)","    \/\/ Prints \"20\"","}"],"syntax":"swift"},{"anchor":"Querying-Relations","type":"heading","level":3,"text":"Querying Relations"},{"type":"paragraph","inlineContent":[{"type":"text","text":"A source holds its pairs of a relation in a "},{"type":"reference","identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/Targets","isActive":true},{"type":"text","text":" component, so you can read and filter"},{"type":"text","text":" "},{"type":"text","text":"on it like any other component. The world also keeps an index of each target’s sources, so"},{"type":"text","text":" "},{"type":"text","text":"filtering a query with "},{"type":"codeVoice","code":".related(_:to:)"},{"type":"text","text":" visits only the entities related to that target:"}]},{"type":"codeListing","code":["var world = World()","let alice = world.spawn(Name(value: \"Alice\"))","let bob = world.spawn(Name(value: \"Bob\"))","let carol = world.spawn(Name(value: \"Carol\"))","world.relate(alice, Likes(), to: bob)","world.relate(carol, Likes(), to: bob)","","let fans = world.query(Name.self).related(Likes.self, to: bob).map { $0.1.value }","print(fans.sorted())","\/\/ Prints \"[\"Alice\", \"Carol\"]\""],"syntax":"swift"},{"anchor":"Customizing-a-Relation","type":"heading","level":3,"text":"Customizing a Relation"},{"type":"paragraph","inlineContent":[{"type":"text","text":"By default a source can relate to any number of targets, and despawning a target removes"},{"type":"text","text":" "},{"type":"text","text":"its pairs from the sources. Implement "},{"type":"reference","isActive":true,"identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/Relation\/isExclusive"},{"type":"text","text":" or "},{"type":"reference","isActive":true,"identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/Relation\/onTargetDespawn"},{"type":"text","text":" to change that."}]}],"kind":"content"}],"sections":[],"schemaVersion":{"patch":0,"major":0,"minor":3},"kind":"symbol","references":{"doc://WorldModule/documentation/WorldModule/Relation/onTargetDespawn":{"url":"\/documentation\/worldmodule\/relation\/ontargetdespawn","role":"symbol","defaultImplementations":1,"type":"topic","required":true,"kind":"symbol","abstract":[{"type":"text","text":"What despawning a target does to the sources related to it."}],"identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/Relation\/onTargetDespawn","fragments":[{"kind":"keyword","text":"static"},{"kind":"text","text":" "},{"kind":"keyword","text":"var"},{"kind":"text","text":" "},{"kind":"identifier","text":"onTargetDespawn"},{"kind":"text","text":": "},{"preciseIdentifier":"s:11WorldModule13CleanupActionO","text":"CleanupAction","kind":"typeIdentifier"}],"title":"onTargetDespawn"},"doc://WorldModule/documentation/WorldModule/Relation/isExclusive":{"fragments":[{"text":"static","kind":"keyword"},{"text":" ","kind":"text"},{"text":"var","kind":"keyword"},{"text":" ","kind":"text"},{"text":"isExclusive","kind":"identifier"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:Sb","text":"Bool","kind":"typeIdentifier"}],"identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/Relation\/isExclusive","kind":"symbol","abstract":[{"text":"A Boolean value indicating whether a source relates to at most one target.","type":"text"}],"url":"\/documentation\/worldmodule\/relation\/isexclusive","title":"isExclusive","type":"topic","role":"symbol","required":true,"defaultImplementations":1},"doc://WorldModule/s8SendableP":{"title":"Swift.Sendable","type":"unresolvable","identifier":"doc:\/\/WorldModule\/s8SendableP"},"doc://WorldModule/documentation/WorldModule/Relation":{"role":"symbol","abstract":[{"text":"A type that describes a kind of link from one entity to others.","type":"text"}],"type":"topic","identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/Relation","url":"\/do