{"kind":"symbol","abstract":[{"text":"A type that describes a kind of link from one entity to others.","type":"text"}],"variants":[{"paths":["\/documentation\/worldmodule\/relation"],"traits":[{"interfaceLanguage":"swift"}]}],"schemaVersion":{"major":0,"minor":3,"patch":0},"relationshipsSections":[{"title":"Inherits From","identifiers":["doc:\/\/WorldModule\/s8SendableP","doc:\/\/WorldModule\/s16SendableMetatypeP"],"type":"inheritsFrom","kind":"relationships"},{"title":"Conforming Types","identifiers":["doc:\/\/WorldModule\/documentation\/WorldModule\/ChildOf"],"type":"conformingTypes","kind":"relationships"}],"sections":[],"hierarchy":{"paths":[["doc:\/\/WorldModule\/documentation\/WorldModule"]]},"identifier":{"url":"doc:\/\/WorldModule\/documentation\/WorldModule\/Relation","interfaceLanguage":"swift"},"primaryContentSections":[{"declarations":[{"tokens":[{"text":"protocol","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Relation","kind":"identifier"},{"text":" : ","kind":"text"},{"text":"Sendable","kind":"typeIdentifier","preciseIdentifier":"s:s8SendableP"}],"platforms":["Linux"],"languages":["swift"]}],"kind":"declarations"},{"kind":"mentions","mentions":["doc:\/\/WorldModule\/documentation\/WorldModule\/RelatingEntities","doc:\/\/WorldModule\/documentation\/WorldModule\/SavingAndLoadingWorlds"]},{"content":[{"type":"heading","level":2,"text":"Overview","anchor":"overview"},{"type":"paragraph","inlineContent":[{"type":"text","text":"A relation links a "},{"type":"emphasis","inlineContent":[{"type":"text","text":"source"}]},{"type":"text","text":" entity to one or more "},{"type":"emphasis","inlineContent":[{"type":"text","text":"target"}]},{"type":"text","text":" entities: a unit likes another,"},{"type":"text","text":" "},{"type":"text","text":"a turret is aimed at a ship, a part is a child of its parent ("},{"type":"reference","isActive":true,"identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/ChildOf"},{"type":"text","text":"). Declare a relation"},{"type":"text","text":" "},{"type":"text","text":"as a type that conforms to "},{"type":"codeVoice","code":"Relation"},{"type":"text","text":", then link entities with "},{"type":"reference","isActive":true,"identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/World\/relate(_:_:to:)"},{"type":"text","text":":"}]},{"type":"codeListing","syntax":"swift","code":["struct Likes: Relation {}","","var world = World()","let alice = world.spawn(Name(value: \"Alice\"))","let bob = world.spawn(Name(value: \"Bob\"))","world.relate(alice, Likes(), to: bob)","","print(world.targets(Likes.self, of: alice) == [bob])","\/\/ Prints \"true\"","print(world.sources(Likes.self, of: bob) == [alice])","\/\/ Prints \"true\""]},{"type":"paragraph","inlineContent":[{"text":"The world stores each link as a pair of a target and a value of the relation, so a relation","type":"text"},{"text":" ","type":"text"},{"text":"can carry data about the link:","type":"text"}]},{"type":"codeListing","syntax":"swift","code":["struct Owes: Relation { var amount: Int }","","var world = World()","let alice = world.spawn(Name(value: \"Alice\"))","let bob = world.spawn(Name(value: \"Bob\"))","world.relate(alice, Owes(amount: 20), to: bob)","","if let debt = world[Targets<Owes>.self, of: alice][bob] {","    print(debt.amount)","    \/\/ Prints \"20\"","}"]},{"type":"heading","level":3,"text":"Querying Relations","anchor":"Querying-Relations"},{"type":"paragraph","inlineContent":[{"type":"text","text":"A source holds its pairs of a relation in a "},{"type":"reference","identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/Targets","isActive":true},{"type":"text","text":" component, so you can read and filter"},{"type":"text","text":" "},{"type":"text","text":"on it like any other component. The world also keeps an index of each target’s sources, so"},{"type":"text","text":" "},{"type":"text","text":"filtering a query with "},{"type":"codeVoice","code":".related(_:to:)"},{"type":"text","text":" visits only the entities related to that target:"}]},{"type":"codeListing","syntax":"swift","code":["var world = World()","let alice = world.spawn(Name(value: \"Alice\"))","let bob = world.spawn(Name(value: \"Bob\"))","let carol = world.spawn(Name(value: \"Carol\"))","world.relate(alice, Likes(), to: bob)","world.relate(carol, Likes(), to: bob)","","let fans = world.query(Name.self).related(Likes.self, to: bob).map { $0.1.value }","print(fans.sorted())","\/\/ Prints \"[\"Alice\", \"Carol\"]\""]},{"type":"heading","level":3,"text":"Customizing a Relation","anchor":"Customizing-a-Relation"},{"type":"paragraph","inlineContent":[{"text":"By default a source can relate to any number of targets, and despawning a target removes","type":"text"},{"text":" ","type":"text"},{"text":"its pairs from the sources. Implement ","type":"text"},{"isActive":true,"identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/Relation\/isExclusive","type":"reference"},{"text":" or ","type":"text"},{"isActive":true,"identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/Relation\/onTargetDespawn","type":"reference"},{"text":" to change that.","type":"text"}]}],"kind":"content"}],"topicSections":[{"title":"Type Properties","identifiers":["doc:\/\/WorldModule\/documentation\/WorldModule\/Relation\/isExclusive","doc:\/\/WorldModule\/documentation\/WorldModule\/Relation\/onTargetDespawn"],"generated":true,"anchor":"Type-Properties"}],"metadata":{"navigatorTitle":[{"text":"Relation","kind":"identifier"}],"remoteSource":{"url":"https:\/\/github.com\/Tyler-Keith-Thompson\/ECS\/blob\/main\/Sources\/WorldModule\/Relations.swift#L61","fileName":"Relations.swift"},"modules":[{"name":"WorldModule"}],"title":"Relation","role":"symbol","symbolKind":"protocol","fragments":[{"kind":"keyword","text":"protocol"},{"kind":"text","text":" "},{"kind":"identifier","text":"Relation"}],"roleHeading":"Protocol","externalID":"s:11WorldModule8RelationP"},"seeAlsoSections":[{"title":"Relating Entities","id