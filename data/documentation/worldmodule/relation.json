n(Name(value: \"Alice\"))","let bob = world.spawn(Name(value: \"Bob\"))","world.relate(alice, Owes(amount: 20), to: bob)","","if let debt = world[Targets<Owes>.self, of: alice][bob] {","    print(debt.amount)","    \/\/ Prints \"20\"","}"],"syntax":"swift","type":"codeListing"},{"level":3,"text":"Querying Relations","anchor":"Querying-Relations","type":"heading"},{"inlineContent":[{"type":"text","text":"A source holds its pairs of a relation in a "},{"type":"reference","isActive":true,"identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/Targets"},{"type":"text","text":" component, so you can read and filter"},{"type":"text","text":" "},{"type":"text","text":"on it like any other component. The world also keeps an index of each target’s sources, so"},{"type":"text","text":" "},{"type":"text","text":"filtering a query with "},{"type":"codeVoice","code":".related(_:to:)"},{"type":"text","text":" visits only the entities related to that target:"}],"type":"paragraph"},{"code":["var world = World()","let alice = world.spawn(Name(value: \"Alice\"))","let bob = world.spawn(Name(value: \"Bob\"))","let carol = world.spawn(Name(value: \"Carol\"))","world.relate(alice, Likes(), to: bob)","world.relate(carol, Likes(), to: bob)","","let fans = world.query(Name.self).related(Likes.self, to: bob).map { $0.1.value }","print(fans.sorted())","\/\/ Prints \"[\"Alice\", \"Carol\"]\""],"syntax":"swift","type":"codeListing"},{"level":3,"text":"Customizing a Relation","anchor":"Customizing-a-Relation","type":"heading"},{"inlineContent":[{"type":"text","text":"By default a source can relate to any number of targets, and despawning a target removes"},{"type":"text","text":" "},{"type":"text","text":"its pairs from the sources. Implement "},{"type":"reference","identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/Relation\/isExclusive","isActive":true},{"type":"text","text":" or "},{"type":"reference","identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/Relation\/onTargetDespawn","isActive":true},{"type":"text","text":" to change that."}],"type":"paragraph"}],"kind":"content"}],"references":{"doc://WorldModule/documentation/WorldModule/ChildOf":{"type":"topic","role":"symbol","identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/ChildOf","title":"ChildOf","kind":"symbol","url":"\/documentation\/worldmodule\/childof","abstract":[{"text":"The relation that links a child entity to its parent.","type":"text"}],"navigatorTitle":[{"text":"ChildOf","kind":"identifier"}],"fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"ChildOf","kind":"identifier"}]},"doc://WorldModule/documentation/WorldModule/CleanupAction":{"title":"CleanupAction","type":"topic","abstract":[{"text":"What despawning a relation’s target does to the sources related to it.","type":"text"}],"identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/CleanupAction","kind":"symbol","role":"symbol","fragments":[{"kind":"keyword","text":"enum"},{"kind":"text","text":" "},{"kind":"identifier","text":"CleanupAction"}],"navigatorTitle":[{"kind":"identifier","text":"CleanupAction"}],"url":"\/documentation\/worldmodule\/cleanupaction"},"doc://WorldModule/documentation/WorldModule":{"type":"topic","identifier":"doc:\/\/WorldModule\/documentation\/WorldModule","url":"\/documentation\/worldmodule","role":"collection","title":"WorldModule","kind":"symbol","abstract":[{"text":"Store the state of a game or simulation as entities and components, and read and change it with","type":"text"},{"text":" ","type":"text"},{"text":"queries, updates, and commands.","type":"text"}]},"doc://WorldModule/documentation/WorldModule/World/relate(_:_:to:)":{"url":"\/documentation\/worldmodule\/world\/relate(_:_:to:)","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"relate","kind":"identifier"},{"text":"<","kind":"text"},{"text":"R","kind":"genericParameter"},{"text":">(","kind":"text"},{"kind":"typeIdentifier","text":"Ent