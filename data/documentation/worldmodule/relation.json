{"hierarchy":{"paths":[["doc:\/\/WorldModule\/documentation\/WorldModule"]]},"sections":[],"seeAlsoSections":[{"anchor":"Relating-Entities","title":"Relating Entities","generated":true,"identifiers":["doc:\/\/WorldModule\/documentation\/WorldModule\/Targets","doc:\/\/WorldModule\/documentation\/WorldModule\/CleanupAction"]}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/worldmodule\/relation"]}],"identifier":{"url":"doc:\/\/WorldModule\/documentation\/WorldModule\/Relation","interfaceLanguage":"swift"},"topicSections":[{"anchor":"Type-Properties","title":"Type Properties","generated":true,"identifiers":["doc:\/\/WorldModule\/documentation\/WorldModule\/Relation\/isExclusive","doc:\/\/WorldModule\/documentation\/WorldModule\/Relation\/onTargetDespawn"]}],"relationshipsSections":[{"type":"inheritsFrom","title":"Inherits From","kind":"relationships","identifiers":["doc:\/\/WorldModule\/s8SendableP","doc:\/\/WorldModule\/s16SendableMetatypeP"]},{"type":"conformingTypes","title":"Conforming Types","kind":"relationships","identifiers":["doc:\/\/WorldModule\/documentation\/WorldModule\/ChildOf"]}],"abstract":[{"text":"A type that describes a kind of link from one entity to others.","type":"text"}],"metadata":{"role":"symbol","fragments":[{"kind":"keyword","text":"protocol"},{"kind":"text","text":" "},{"kind":"identifier","text":"Relation"}],"roleHeading":"Protocol","remoteSource":{"fileName":"Relations.swift","url":"https:\/\/github.com\/Tyler-Keith-Thompson\/ECS\/blob\/main\/Sources\/WorldModule\/Relations.swift#L61"},"title":"Relation","externalID":"s:11WorldModule8RelationP","symbolKind":"protocol","navigatorTitle":[{"text":"Relation","kind":"identifier"}],"modules":[{"name":"WorldModule"}]},"schemaVersion":{"minor":3,"major":0,"patch":0},"kind":"symbol","primaryContentSections":[{"kind":"declarations","declarations":[{"tokens":[{"text":"protocol","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Relation","kind":"identifier"},{"text":" : ","kind":"text"},{"text":"Sendable","preciseIdentifier":"s:s8SendableP","kind":"typeIdentifier"}],"platforms":["Linux"],"languages":["swift"]}]},{"mentions":["doc:\/\/WorldModule\/documentation\/WorldModule\/SavingAndLoadingWorlds"],"kind":"mentions"},{"kind":"content","content":[{"level":2,"anchor":"overview","type":"heading","text":"Overview"},{"type":"paragraph","inlineContent":[{"type":"text","text":"A relation links a "},{"inlineContent":[{"text":"source","type":"text"}],"type":"emphasis"},{"type":"text","text":" entity to one or more "},{"inlineContent":[{"text":"target","type":"text"}],"type":"emphasis"},{"type":"text","text":" entities: a unit likes another,"},{"type":"text","text":" "},{"type":"text","text":"a turret is aimed at a ship, a part is a child of its parent ("},{"identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/ChildOf","type":"reference","isActive":true},{"type":"text","text":"). Declare a relation"},{"type":"text","text":" "},{"type":"text","text":"as a type that conforms to "},{"code":"Relation","type":"codeVoice"},{"type":"text","text":", then link entities with "},{"identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/World\/relate(_:_:to:)","type":"reference","isActive":true},{"type":"text","text":":"}]},{"code":["struct Likes: Relation {}","","var world = World()","let alice = world.spawn(Name(value: \"Alice\"))","let bob = world.spawn(Name(value: \"Bob\"))","world.relate(alice, Likes(), to: bob)","","print(world.targets(Likes.self, of: alice) == [bob])","\/\/ Prints \"true\"","print(world.sources(Likes.self, of: bob) == [alice])","\/\/ Prints \"true\""],"type":"codeListing","syntax":"swift"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The world stores each link as a pair of a target and a value of the relation, so a relation"},{"type":"text","text":" "},{"type":"text","text":"can carry data about the link:"}]},{"code":["struct Owes: Relation { var amount: Int }","","var world = World()","let alice = world.spawn(Name(value: \"Alice\"))","let bob = world.spawn(Name(value: \"Bob\"))","world.relate(alice, Owes(amount: 20), to: bob)","","if let debt = world[Targets<Owes>.self, of: alice][bob] {","    print(debt.amount)","    \/\/ Prints \"20\"","}"],"type":"codeListing","syntax":"swift"},{"level":3,"anchor":"Querying-Relations","type":"heading","text":"Querying Relations"},{"type":"paragraph","inlineContent":[{"type":"text","text":"A source holds its pairs of a relation in a "},{"identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/Targets","type":"reference","isActive":true},{"type":"text","text":" component, so you can read and filter"},{"type":"text","text":" "},{"type":"text","text":"on it like any other component. The world also keeps an index of each target’s sources, so"},{"type":"text","text":" "},{"type":"text","text":"filtering a query with "},{"code":".related(_:to:)","type":"codeVoice"},{"type":"text","text":" visits only the entities related to that target:"}]},{"code":["var world = World()","let alice = world.spawn(Name(value: \"Alice\"))","let bob = world.spawn(Name(value: \"Bob\"))","let carol = world.spawn(Name(value: \"Carol\"))","world.relate(alice, Likes(), to: bob)","world.relate(carol, Likes(), to: bob)","","let fans = world.query(Name.self).related(Likes.self, to: bob).map { $0.1.value }","print(fans.sorted())","\/\/ Prints \"[\"Alice\", \"Carol\"]\""],"type":"codeListing","syntax":"swift"},{"level":3,"anchor":"Customizing-a-Relation","type":"heading","text":"Customizing a Relation"},{"type":"paragraph","inlineContent":[{"type":"text","text":"By default a source can relate to any number of targets, and despawning a target removes"},{"type":"text","text":" "},{"type":"text","text":"its pairs from the sources. Implement "},{"identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/Relation\/isExclusive","type":"reference","isActive":true},{"type":"text","text":" or "},{"identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/Relation\/onTargetDespawn","type":"reference","isActive":true},{"type":"text","text":" to change that."}]}]}],"references":{"doc://WorldModule/s16SendableMetatypeP":{"title":"Swift.SendableMetatype","type":"unresolvable","identifier":"doc:\/\/WorldModule\/s16SendableMetatypeP"},"doc://WorldModule/documentation/WorldModule/Relation":{"type":"topic","role":"symbol","abstract":[{"type":"text","text":"A type that describes a kind of link from one entity to others."}],"fragments":[{"kind":"keyword","text":"protocol"},{"kind":"text","text":" "},{"kind":"identifier","text":"Relation"}],"navigatorTitle":[{"kind":"identifier","text":"Relation"}],"kind":"symbol","title":"Relation","url":"\/documentation\/worldmodule\/relation","identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/Relation"},"doc://WorldModule/documentation/WorldModule/Relation/isExclusive":{"fragments":[{"kind":"keyword","text":"static"},{"kind":"text","text":" "},{"kind":"keyword","text":"var"},{"kind":"text","text":" "},{"kind":"identifier","text":"isExclusive"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"Bool","preciseIdentifier":"s:Sb"}],"abstract":[{"text":"A Boolean value indicating whether a source relates to at most one target.","type":"text"}],"defaultImplementations":1,"url":"\/documentation\/worldmodule\/relation\/isexclusive","identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/Relation\/isExclusive","role":"symbol","type":"topic","title":"isExclusive","kind":"symbol","required":true},"doc://WorldModule/documentation/WorldModule/SavingAndLoadingWorlds":{"kind":"article","type":"topic","title":"Saving and Loading Worlds","url":"\/documentation\/worldmodule\/savingandloadingworlds","abstract":[{"type":"text","text":"Save a world’s entities and components, restore them later, and spawn saved groups of entities"},{"type":"text","text":" "},{"type":"text","text":"into other worlds."}],"role":"article","identifier":"doc:\/\/WorldModule\/documentation\/WorldModu