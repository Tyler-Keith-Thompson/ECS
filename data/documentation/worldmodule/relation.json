{"abstract":[{"type":"text","text":"A type that describes a kind of link from one entity to others."}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/worldmodule\/relation"]}],"identifier":{"url":"doc:\/\/WorldModule\/documentation\/WorldModule\/Relation","interfaceLanguage":"swift"},"kind":"symbol","schemaVersion":{"major":0,"minor":3,"patch":0},"seeAlsoSections":[{"title":"Relating Entities","anchor":"Relating-Entities","identifiers":["doc:\/\/WorldModule\/documentation\/WorldModule\/Targets","doc:\/\/WorldModule\/documentation\/WorldModule\/CleanupAction"],"generated":true}],"topicSections":[{"title":"Type Properties","anchor":"Type-Properties","identifiers":["doc:\/\/WorldModule\/documentation\/WorldModule\/Relation\/isExclusive","doc:\/\/WorldModule\/documentation\/WorldModule\/Relation\/onTargetDespawn"],"generated":true}],"hierarchy":{"paths":[["doc:\/\/WorldModule\/documentation\/WorldModule"]]},"sections":[],"primaryContentSections":[{"kind":"declarations","declarations":[{"platforms":["Linux"],"tokens":[{"text":"protocol","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Relation","kind":"identifier"},{"text":" : ","kind":"text"},{"text":"Sendable","kind":"typeIdentifier","preciseIdentifier":"s:s8SendableP"}],"languages":["swift"]}]},{"mentions":["doc:\/\/WorldModule\/documentation\/WorldModule\/RelatingEntities","doc:\/\/WorldModule\/documentation\/WorldModule\/SavingAndLoadingWorlds"],"kind":"mentions"},{"content":[{"type":"heading","text":"Overview","anchor":"overview","level":2},{"inlineContent":[{"text":"A relation links a ","type":"text"},{"inlineContent":[{"text":"source","type":"text"}],"type":"emphasis"},{"text":" entity to one or more ","type":"text"},{"inlineContent":[{"text":"target","type":"text"}],"type":"emphasis"},{"text":" entities: a unit likes another,","type":"text"},{"text":" ","type":"text"},{"text":"a turret is aimed at a ship, a part is a child of its parent (","type":"text"},{"identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/ChildOf","isActive":true,"type":"reference"},{"text":"). Declare a relation","type":"text"},{"text":" ","type":"text"},{"text":"as a type that conforms to ","type":"text"},{"code":"Relation","type":"codeVoice"},{"text":", then link entities with ","type":"text"},{"identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/World\/relate(_:_:to:)","isActive":true,"type":"reference"},{"text":":","type":"text"}],"type":"paragraph"},{"type":"codeListing","code":["struct Likes: Relation {}","","var world = World()","let alice = world.spawn(Name(value: \"Alice\"))","let bob = world.spawn(Name(value: \"Bob\"))","world.relate(alice, Likes(), to: bob)","","print(world.targets(Likes.self, of: alice) == [bob])","\/\/ Prints \"true\"","print(world.sources(Likes.self, of: bob) == [alice])","\/\/ Prints \"true\""],"syntax":"swift"},{"inlineContent":[{"text":"The world stores each link as a pair of a target and a value of the relation, so a relation","type":"text"},{"text":" ","type":"text"},{"text":"can carry data about the link:","type":"text"}],"type":"paragraph"},{"type":"codeListing","code":["struct Owes: Relation { var amount: Int }","","var world = World()","let alice = world.spawn(Name(value: \"Alice\"))","let bob = world.spawn(Name(value: \"Bob\"))","world.relate(alice, Owes(amount: 20), to: bob)","","if let debt = world[Targets<Owes>.self, of: alice][bob] {","    print(debt.amount)","    \/\/ Prints \"20\"","}"],"syntax":"swift"},{"type":"heading","text":"Querying Relations","anchor":"Querying-Relations","level":3},{"inlineContent":[{"type":"text","text":"A source holds its pairs of a relation in a "},{"identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/Targets","type":"reference","isActive":true},{"type":"text","text":" component, so you can read and filter"},{"type":"text","text":" "},{"type":"text","text":"on it like any other component. The world also keeps an index of each target’s sources, so"},{"type":"text","text":" "},{"type":"text","text":"filtering a query with "},{"type":"codeVoice","code":".related(_:to:)"},{"type":"text","text":" visits only the entities related to that target:"}],"type":"paragraph"},{"type":"codeListing","code":["var world = World()","let alice = world.spawn(Name(value: \"Alice\"))","let bob = world.spawn(Name(value: \"Bob\"))","let carol = world.spawn(Name(value: \"Carol\"))","world.relate(alice, Likes(), to: bob)","world.relate(carol, Likes(), to: bob)","","let fans = world.query(Name.self).related(Likes.self, to: bob).map { $0.1.value }","print(fans.sorted())","\/\/ Prints \"[\"Alice\", \"Carol\"]\""],"syntax":"swift"},{"type":"heading","text":"Customizing a Relation","anchor":"Customizing-a-Relation","level":3},{"inlineContent":[{"type":"text","text":"By default a source can relate to any number of targets, and despawning a target removes"},{"type":"text","text":" "},{"type":"text","text":"its pairs from the sources. Implement "},{"type":"reference","isActive":true,"identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/Relation\/isExclusive"},{"type":"text","text":" or "},{"type":"reference","isActive":true,"identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/Relation\/onTargetDespawn"},{"type":"text","text":" to change that."}],"type":"paragraph"}],"kind":"content"}],"relationshipsSections":[{"title":"Inherits From","type":"inheritsFrom","kind":"relationships","identifiers":["doc:\/\/WorldModule\/s8SendableP","doc:\/\/WorldModule\/s16SendableMetatypeP"]},{"title":"Conforming Types","type":"conformingTypes","kind":"relationships","identifiers":["doc:\/\/WorldModule\/documentation\/WorldModule\/ChildOf"]}],"metadata":{"modules":[{"name":"WorldModule"}],"remoteSource":{"url":"https:\/\/github.com\/Tyler-Keith-Thompson\/ECS\/blob\/main\/Sources\/WorldModule\/Relations.swift#L61","fileName":"Relations.swift"},"externalID":"s:11WorldModule8RelationP","role":"symbol","symbolKind":"protocol","roleHeading":"Protocol","navigatorTi