 alice = world.spawn(Name(value: \"Alice\"))","let bob = world.spawn(Name(value: \"Bob\"))","world.relate(alice, Likes(), to: bob)","","print(world.targets(Likes.self, of: alice) == [bob])","\/\/ Prints \"true\"","print(world.sources(Likes.self, of: bob) == [alice])","\/\/ Prints \"true\""]},{"inlineContent":[{"text":"The world stores each link as a pair of a target and a value of the relation, so a relation","type":"text"},{"text":" ","type":"text"},{"text":"can carry data about the link:","type":"text"}],"type":"paragraph"},{"type":"codeListing","syntax":"swift","code":["struct Owes: Relation { var amount: Int }","","var world = World()","let alice = world.spawn(Name(value: \"Alice\"))","let bob = world.spawn(Name(value: \"Bob\"))","world.relate(alice, Owes(amount: 20), to: bob)","","if let debt = world[Targets<Owes>.self, of: alice][bob] {","    print(debt.amount)","    \/\/ Prints \"20\"","}"]},{"text":"Querying Relations","level":3,"type":"heading","anchor":"Querying-Relations"},{"inlineContent":[{"type":"text","text":"A source holds its pairs of a relation in a "},{"type":"reference","identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/Targets","isActive":true},{"type":"text","text":" component, so you can read and filter"},{"type":"text","text":" "},{"type":"text","text":"on it like any other component. The world also keeps an index of each target’s sources, so"},{"type":"text","text":" "},{"type":"text","text":"filtering a query with "},{"type":"codeVoice","code":".related(_:to:)"},{"type":"text","text":" visits only the entities related to that target:"}],"type":"paragraph"},{"type":"codeListing","syntax":"swift","code":["var world = World()","let alice = world.spawn(Name(value: \"Alice\"))","let bob = world.spawn(Name(value: \"Bob\"))","let carol = world.spawn(Name(value: \"Carol\"))","world.relate(alice, Likes(), to: bob)","world.relate(carol, Likes(), to: bob)","","let fans = world.query(Name.self).related(Likes.self, to: bob).map { $0.1.value 