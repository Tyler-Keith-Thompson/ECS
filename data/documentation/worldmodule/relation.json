{"abstract":[{"text":"A type that describes a kind of link from one entity to others.","type":"text"}],"seeAlsoSections":[{"identifiers":["doc:\/\/WorldModule\/documentation\/WorldModule\/Targets","doc:\/\/WorldModule\/documentation\/WorldModule\/CleanupAction"],"generated":true,"anchor":"Relating-Entities","title":"Relating Entities"}],"metadata":{"externalID":"s:11WorldModule8RelationP","symbolKind":"protocol","remoteSource":{"url":"https:\/\/github.com\/Tyler-Keith-Thompson\/ECS\/blob\/main\/Sources\/WorldModule\/Relations.swift#L61","fileName":"Relations.swift"},"title":"Relation","roleHeading":"Protocol","modules":[{"name":"WorldModule"}],"role":"symbol","fragments":[{"kind":"keyword","text":"protocol"},{"kind":"text","text":" "},{"kind":"identifier","text":"Relation"}],"navigatorTitle":[{"text":"Relation","kind":"identifier"}]},"sections":[],"relationshipsSections":[{"identifiers":["doc:\/\/WorldModule\/s8SendableP","doc:\/\/WorldModule\/s16SendableMetatypeP"],"kind":"relationships","type":"inheritsFrom","title":"Inherits From"},{"identifiers":["doc:\/\/WorldModule\/documentation\/WorldModule\/ChildOf"],"kind":"relationships","type":"conformingTypes","title":"Conforming Types"}],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/WorldModule\/documentation\/WorldModule\/Relation"},"topicSections":[{"identifiers":["doc:\/\/WorldModule\/documentation\/WorldModule\/Relation\/isExclusive","doc:\/\/WorldModule\/documentation\/WorldModule\/Relation\/onTargetDespawn"],"generated":true,"anchor":"Type-Properties","title":"Type Properties"}],"primaryContentSections":[{"kind":"declarations","declarations":[{"platforms":["Linux"],"tokens":[{"text":"protocol","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Relation","kind":"identifier"},{"text":" : ","kind":"text"},{"text":"Sendable","preciseIdentifier":"s:s8SendableP","kind":"typeIdentifier"}],"languages":["swift"]}]},{"mentions":["doc:\/\/WorldModule\/documentation\/WorldModule\/RelatingEntities","doc:\/\/WorldModule\/documentation\/WorldModule\/SavingAndLoadingWorlds"],"kind":"mentions"},{"content":[{"anchor":"overview","level":2,"type":"heading","text":"Overview"},{"inlineContent":[{"text":"A relation links a ","type":"text"},{"type":"emphasis","inlineContent":[{"type":"text","text":"source"}]},{"text":" entity to one or more ","type":"text"},{"type":"emphasis","inlineContent":[{"type":"text","text":"target"}]},{"text":" entities: a unit likes another,","type":"text"},{"text":" ","type":"text"},{"text":"a turret is aimed at a ship, a part is a child of its parent (","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/ChildOf"},{"text":"). Declare a relation","type":"text"},{"text":" ","type":"text"},{"text":"as a type that conforms to ","type":"text"},{"code":"Relation","type":"codeVoice"},{"text":", then link entities with ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/World\/relate(_:_:to:)"},{"text":":","type":"text"}],"type":"paragraph"},{"syntax":"swift","type":"codeListing","code":["struct Likes: Relation {}","","var world = World()","let alice = world.spawn(Name(value: \"Alice\"))","let bob = world.spawn(Name(value: \"Bob\"))","world.relate(alice, Likes(), to: bob)","","print(world.targets(Likes.self, of: alice) == [bob])","\/\/ Prints \"true\"","print(world.sources(Likes.self, of: bob) == [alice])","\/\/ Prints \"true\""]},{"inlineContent":[{"type":"text","text":"The world stores each link as a pair of a target and a value of the relation, so a relation"},{"type":"text","text":" "},{"type":"text","text":"can carry data about the link:"}],"type":"paragraph"},{"syntax":"swift","type":"codeListing","code":["struct Owes: Relation { var amount: Int }","","var world = World()","let alice = world.spawn(Name(value: \"Alice\"))","let bob = world.spawn(Name(value: \"Bob\"))","world.relate(alice, Owes(amount: 20), to: bob)","","if let debt = world[Targets<Owes>.self, of: alice][bob] {","    print(debt.amount)","    \/\/ Prints \"20\"","}"]},{"anchor":"Querying-Relations","level":3,"type":"heading","text":"Querying Relations"},{"inlineContent":[{"text":"A source holds its pairs of a relation in a ","type":"text"},{"isActive":true,"identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/Targets","type":"reference"},{"text":" component, so you can read and filter","type":"text"},{"text":" ","type":"text"},{"text":"on it like any other component. The world also keeps an index of each target’s sources, so","type":"text"},{"text":" ","type":"text"},{"text":"filtering a query with ","type":"text"},{"code":".related(_:to:)","type":"codeVoice"},{"text":" visits only the entities related to that target:","type":"text"}],"type":"paragraph"},{"syntax":"swift","type":"codeListing","code":["var world = World()","let alice = world.spawn(Name(value: \"Alice\"))","let bob = world.spawn(Name(value: \"Bob\"))","let carol = world.spawn(Name(value: \"Carol\"))","world.relate(alice, Likes(), to: bob)","world.relate(carol, Likes(), to: bob)","","let fans = world.query(Name.self).related(Likes.self, to: bob).map { $0.1.value }","print(fans.sorted())","\/\/ Prints \"[\"Alice\", \"Carol\"]\""]},{"anchor":"Customizing-a-Relation","level":3,"type":"heading","text":"Customizing a Relation"},{"inlineContent":[{"type":"text","text":"By default a source can relate to any number of targets, and despawning a target removes"},{"type":"text","text":" "},{"type":"text","text":"its pairs from the sources. Implement "},{"isActive":true,"identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/Relation\/isExclusive","type":"reference"},{"type":"text","text":" or "},{"isActive":true,"identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/Relation\/onTargetDespawn","type":"reference"},{"type":"text","text":" to change that."}],"type":"paragraph"}],"kind":"content"}],"hierarchy":{"paths":[["doc:\/\/WorldModule\/documentation\/Wo