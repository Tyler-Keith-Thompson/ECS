languages":["swift"]}],"kind":"declarations"},{"mentions":["doc:\/\/WorldModule\/documentation\/WorldModule\/RelatingEntities","doc:\/\/WorldModule\/documentation\/WorldModule\/SavingAndLoadingWorlds"],"kind":"mentions"},{"content":[{"level":2,"type":"heading","anchor":"overview","text":"Overview"},{"inlineContent":[{"type":"text","text":"A relation links a "},{"inlineContent":[{"text":"source","type":"text"}],"type":"emphasis"},{"type":"text","text":" entity to one or more "},{"inlineContent":[{"type":"text","text":"target"}],"type":"emphasis"},{"type":"text","text":" entities: a unit likes another,"},{"type":"text","text":" "},{"type":"text","text":"a turret is aimed at a ship, a part is a child of its parent ("},{"isActive":true,"type":"reference","identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/ChildOf"},{"type":"text","text":"). Declare a relation"},{"type":"text","text":" "},{"type":"text","text":"as a type that conforms to "},{"type":"codeVoice","code":"Relation"},{"type":"text","text":", then link entities with "},{"isActive":true,"type":"reference","identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/World\/relate(_:_:to:)"},{"type":"text","text":":"}],"type":"paragraph"},{"syntax":"swift","type":"codeListing","code":["struct Likes: Relation {}","","var world = World()","let alice = world.spawn(Name(value: \"Alice\"))","let bob = world.spawn(Name(value: \"Bob\"))","world.relate(alice, Likes(), to: bob)","","print(world.targets(Likes.self, of: alice) == [bob])","\/\/ Prints \"true\"","print(world.sources(Likes.self, of: bob) == [alice])","\/\/ Prints \"true\""]},{"inlineContent":[{"text":"The world stores each link as a pair of a target and a value of the relation, so a relation","type":"text"},{"text":" ","type":"text"},{"text":"can carry data about the link:","type":"text"}],"type":"paragraph"},{"syntax":"swift","type":"codeListing","code":["struct Owes: Relation { var amount: Int }","","var world = World()","let alice = world.spawn(Name(value: \"Alice\"))","let bob = world.spawn(Name(value: \"Bob\"))","world.relate(alice, Owes(amount: 20), to: bob)","","if let debt = world[Targets<Owes>.self, of: alice][bob] {","    print(debt.amount)","    \/\/ Prints \"20\"","}"]},{"level":3,"type":"heading","anchor":"Querying-Relations","text":"Querying Relations"},{"inlineContent":[{"text":"A source holds its pairs of a relation in a ","type":"text"},{"isActive":true,"identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/Targets","type":"reference"},{"text":" component, so you can read and filter","type":"text"},{"text":" ","type":"text"},{"text":"on it like any other component. The world also keeps an index of each target’s sources, so","type":"text"},{"text":" ","type":"text"},{"text":"filtering a query with ","type":"text"},{"code":".related(_:to:)","type":"codeVoice"},{"text":" visits only the entities related to that target:","type":"text"}],"type":"paragraph"},{"syntax":"swift","type":"codeListing","code":["var world = World()","let alice = world.spawn(Name(value: \"Alice\"))","let bob = world.spawn(Name(value: \"Bob\"))","let carol = world.spawn(Name(value: \"Carol\"))","world.relate(alice, Likes(), to: bob)","world.relate(carol, Likes(), to: bob)","","let fans = world.query(Name.self).related(Likes.self, to: bob).map { $0.1.value }","print(fans.sorted())","\/\/ Prints \"[\"Alice\", \"Carol\"]\""]},{"level":3,"type":"heading","anchor":"Customizing-a-Relation","text":"Customizing a Relation"},{"inlineContent":[{"type":"text","text":"By default a source can relate to any number of targets, and despawning a target removes"},{"type":"text","text":" "},{"type":"text","text":"its pairs from the sources. Implement "},{"identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/Relation\/isExclusive","type":"reference","isActive":true},{"type":"text","text":" or "},{"identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/Relation\/onTargetDespawn","type":"reference","isActive":true},{"type":"text","text":" to change that."}],"type":"paragraph"}],"kind":"content"}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/worldmodule\/relation"]}],"references":{"doc://WorldModule/documentation/WorldModule/Relation/isExclusive":{"required":true,"title":"isExclusive","role":"symbol","url":"\/documentation\/worldmodule\/relation\/isexclusive","defaultImplementations":1,"kind":"symbol","identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/Relation\/isExclusive","type":"topic","abstract":[{"type":"text","text":"A Boolean value indicating whether a source relates to at most one target."}],"fragments":[{"text":"static","kind":"keyword"},{"text":" ","kind":"text"},{"text":"var","kind":"keyword"},{"text":" ","kind":"text"},{"text":"isExclusive","kind":"identifier"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:Sb","text":"Bool","kind":"typeIdentifier"}]},"doc://WorldModule/documentation/WorldModule/Targets":{"identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/Targets","abstract":[{"type":"text","text":"The component that holds a source entity’s targets of a relation, with the relation’s value"},{"type":"text","text":" "},{"type":"text","text":"for each."}],"fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Targets","kind":"identifier"}],"title":"Targets","role":"symbol","kind":"symbol","url":"\/documentation\/worldmodule\/targets","navigatorTitle":[{"text":"Targets","kind":"identifier"}],"type":"topic"},"doc://WorldModule/documentation/WorldModule":{"kind":"symbol","identifier":"doc:\/\/WorldModule\/documentation\/WorldModule","type":"topic","role":"collection","title":"WorldModule","abstract":[{"type":"text","text":"Store the state of a game or simulation as entities and components, and read and change it with"},{"type":"text","text":" "},{"type":"text","text":"queries, updates, and commands."}],"url":"\/documentation\/worldmodule"},"doc://WorldModule/s16SendableMetatypeP":{"id