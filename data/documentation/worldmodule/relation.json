{"relationshipsSections":[{"title":"Inherits From","kind":"relationships","identifiers":["doc:\/\/WorldModule\/s8SendableP","doc:\/\/WorldModule\/s16SendableMetatypeP"],"type":"inheritsFrom"},{"title":"Conforming Types","kind":"relationships","identifiers":["doc:\/\/WorldModule\/documentation\/WorldModule\/ChildOf"],"type":"conformingTypes"}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/worldmodule\/relation"]}],"sections":[],"primaryContentSections":[{"kind":"declarations","declarations":[{"tokens":[{"kind":"keyword","text":"protocol"},{"kind":"text","text":" "},{"kind":"identifier","text":"Relation"},{"kind":"text","text":" : "},{"kind":"typeIdentifier","text":"Sendable","preciseIdentifier":"s:s8SendableP"}],"platforms":["Linux"],"languages":["swift"]}]},{"mentions":["doc:\/\/WorldModule\/documentation\/WorldModule\/SavingAndLoadingWorlds"],"kind":"mentions"},{"content":[{"text":"Overview","level":2,"anchor":"overview","type":"heading"},{"inlineContent":[{"text":"A relation links a ","type":"text"},{"inlineContent":[{"text":"source","type":"text"}],"type":"emphasis"},{"text":" entity to one or more ","type":"text"},{"inlineContent":[{"type":"text","text":"target"}],"type":"emphasis"},{"text":" entities: a unit likes another,","type":"text"},{"text":" ","type":"text"},{"text":"a turret is aimed at a ship, a part is a child of its parent (","type":"text"},{"identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/ChildOf","isActive":true,"type":"reference"},{"text":"). Declare a relation","type":"text"},{"text":" ","type":"text"},{"text":"as a type that conforms to ","type":"text"},{"code":"Relation","type":"codeVoice"},{"text":", then link entities with ","type":"text"},{"identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/World\/relate(_:_:to:)","isActive":true,"type":"reference"},{"text":":","type":"text"}],"type":"paragraph"},{"syntax":"swift","code":["struct Likes: Relation {}","","var world = World()","let alice = world.spawn(Name(value: \"Alice\"))","let bob = world.spawn(Name(value: \"Bob\"))","world.relate(alice, Likes(), to: bob)","","print(world.targets(Likes.self, of: alice) == [bob])","\/\/ Prints \"true\"","print(world.sources(Likes.self, of: bob) == [alice])","\/\/ Prints \"true\""],"type":"codeListing"},{"inlineContent":[{"text":"The world stores each link as a pair of a target and a value of the relation, so a relation","type":"text"},{"text":" ","type":"text"},{"text":"can carry data about the link:","type":"text"}],"type":"paragraph"},{"syntax":"swift","code":["struct Owes: Relation { var amount: Int }","","var world = World()","let alice = world.spawn(Name(value: \"Alice\"))","let bob = world.spawn(Name(value: \"Bob\"))","world.relate(alice, Owes(amount: 20), to: bob)","","if let debt = world[Targets<Owes>.self, of: alice][bob] {","    print(debt.amount)","    \/\/ Prints \"20\"","}"],"type":"codeListing"},{"text":"Querying Relations","level":3,"anchor":"Querying-Relations","type":"heading"},{"inlineContent":[{"text":"A source holds its pairs of a relation in a ","type":"text"},{"isActive":true,"identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/Targets","type":"reference"},{"text":" component, so you can read and filter","type":"text"},{"text":" ","type":"text"},{"text":"on it like any other component. The world also keeps an index of each target’s sources, so","type":"text"},{"text":" ","type":"text"},{"text":"filtering a query with ","type":"text"},{"code":".related(_:to:)","type":"codeVoice"},{"text":" visits only the entities related to that target:","type":"text"}],"type":"paragraph"},{"syntax":"swift","code":["var world = World()","let alice = world.spawn(Name(value: \"Alice\"))","let bob = world.spawn(Name(value: \"Bob\"))","let carol = world.spawn(Name(value: \"Carol\"))","world.relate(alice, Likes(), to: bob)","world.relate(carol, Likes(), to: bob)","","let fans = world.query(Name.self).related(Likes.self, to: bob).map { $0.1.value }","print(fans.sorted())","\/\/ Prints \"[\"Alice\", \"Carol\"]\""],"type":"codeListing"},{"text":"Customizing a Relation","level":3,"anchor":"Customizing-a-Relation","type":"heading"},{"inlineContent":[{"type":"text","text":"By default a source can relate to any number of targets, and despawning a target removes"},{"type":"text","text":" "},{"type":"text","text":"its pairs from the sources. Implement "},{"type":"reference","identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/Relation\/isExclusive","isActive":true},{"type":"text","text":" or "},{"type":"reference","identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/Relation\/onTargetDespawn","isActive":true},{"type":"text","text":" to change that."}],"type":"paragraph"}],"kind":"content"}],"kind":"symbol","schemaVersion":{"major":0,"patch":0,"minor":3},"identifier":{"url":"doc:\/\/WorldModule\/documentation\/WorldModule\/Relation","interfaceLanguage":"swift"},"seeAlsoSections":[{"title":"Relating Entities","generated":true,"identifiers":["doc:\/\/WorldModule\/documentation\/WorldModule\/Targets","doc:\/\/WorldModule\/documentation\/WorldModule\/CleanupAction"],"anchor":"Relating-Entities"}],"hierarchy":{"paths":[["doc:\/\/WorldModule\/documentation\/WorldModule"]]},"abstract":[{"text":"A type that describes a kind of link from one entity to others.","type":"text"}],"topicSections":[{"title":"Type Properties","generated":true,"identifiers":["doc:\/\/WorldModule\/documentation\/WorldModule\/Relation\/isExclusive","doc:\/\/WorldModule\/documentation\/WorldModule\/Relation\/onTargetDespawn"],"anchor":"Type-Properties"}],"metadata":{"externalID":"s:11WorldModule8RelationP","symbolKind":"protocol","roleHeading":"Protocol","title":"Relation","fragments":[{"text":"protocol","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Relation","kind":"identifier"}],"modules":[{"name":"WorldModule"}],"role":"symbol","navigatorTitle":[{"kind":"identifier","text":"Relation"}],"remoteSource":{"url":"https:\/\/github.c