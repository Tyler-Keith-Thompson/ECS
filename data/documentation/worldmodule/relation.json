{"kind":"symbol","sections":[],"schemaVersion":{"major":0,"minor":3,"patch":0},"topicSections":[{"title":"Type Properties","anchor":"Type-Properties","identifiers":["doc:\/\/WorldModule\/documentation\/WorldModule\/Relation\/isExclusive","doc:\/\/WorldModule\/documentation\/WorldModule\/Relation\/onTargetDespawn"],"generated":true}],"relationshipsSections":[{"type":"inheritsFrom","title":"Inherits From","identifiers":["doc:\/\/WorldModule\/s8SendableP","doc:\/\/WorldModule\/s16SendableMetatypeP"],"kind":"relationships"},{"type":"conformingTypes","title":"Conforming Types","identifiers":["doc:\/\/WorldModule\/documentation\/WorldModule\/ChildOf"],"kind":"relationships"}],"hierarchy":{"paths":[["doc:\/\/WorldModule\/documentation\/WorldModule"]]},"seeAlsoSections":[{"title":"Relating Entities","anchor":"Relating-Entities","identifiers":["doc:\/\/WorldModule\/documentation\/WorldModule\/Targets","doc:\/\/WorldModule\/documentation\/WorldModule\/CleanupAction"],"generated":true}],"variants":[{"paths":["\/documentation\/worldmodule\/relation"],"traits":[{"interfaceLanguage":"swift"}]}],"primaryContentSections":[{"kind":"declarations","declarations":[{"tokens":[{"kind":"keyword","text":"protocol"},{"kind":"text","text":" "},{"kind":"identifier","text":"Relation"},{"kind":"text","text":" : "},{"preciseIdentifier":"s:s8SendableP","kind":"typeIdentifier","text":"Sendable"}],"platforms":["Linux"],"languages":["swift"]}]},{"mentions":["doc:\/\/WorldModule\/documentation\/WorldModule\/SavingAndLoadingWorlds"],"kind":"mentions"},{"content":[{"anchor":"overview","text":"Overview","level":2,"type":"heading"},{"inlineContent":[{"type":"text","text":"A relation links a "},{"inlineContent":[{"text":"source","type":"text"}],"type":"emphasis"},{"type":"text","text":" entity to one or more "},{"inlineContent":[{"type":"text","text":"target"}],"type":"emphasis"},{"type":"text","text":" entities: a unit likes another,"},{"type":"text","text":" "},{"type":"text","text":"a turret is aimed at a ship, a part is a child of its parent ("},{"identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/ChildOf","isActive":true,"type":"reference"},{"type":"text","text":"). Declare a relation"},{"type":"text","text":" "},{"type":"text","text":"as a type that conforms to "},{"code":"Relation","type":"codeVoice"},{"type":"text","text":", then link entities with "},{"identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/World\/relate(_:_:to:)","isActive":true,"type":"reference"},{"type":"text","text":":"}],"type":"paragraph"},{"syntax":"swift","code":["struct Likes: Relation {}","","var world = World()","let alice = world.spawn(Name(value: \"Alice\"))","let bob = world.spawn(Name(value: \"Bob\"))","world.relate(alice, Likes(), to: bob)","","print(world.targets(Likes.self, of: alice) == [bob])","\/\/ Prints \"true\"","print(world.sources(Likes.self, of: bob) == [alice])","\/\/ Prints \"true\""],"type":"codeListing"},{"inlineContent":[{"type":"text","text":"The world stores each link as a pair of a target and a value of the relation, so a relation"},{"type":"text","text":" "},{"type":"text","text":"can carry data about the link:"}],"type":"paragraph"},{"syntax":"swift","code":["struct Owes: Relation { var amount: Int }","","var world = World()","let alice = world.spawn(Name(value: \"Alice\"))","let bob = world.spawn(Name(value: \"Bob\"))","world.relate(alice, Owes(amount: 20), to: bob)","","if let debt = world[Targets<Owes>.self, of: alice][bob] {","    print(debt.amount)","    \/\/ Prints \"20\"","}"],"type":"codeListing"},{"anchor":"Querying-Relations","text":"Querying Relations","level":3,"type":"heading"},{"inlineContent":[{"type":"text","text":"A source holds its pairs of a relation in a "},{"type":"reference","isActive":true,"identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/Targets"},{"type":"text","text":" component, so you can read and filter"},{"type":"text","text":" "},{"type":"text","text":"on it like any other component. The world also keeps an index of each target’s sources, so"},{"type":"text","text":" "},{"type":"text","text":"filtering a query with "},{"type":"codeVoice","code":".related(_:to:)"},{"type":"text","text":" visits only the entities related to that target:"}],"type":"paragraph"},{"syntax":"swift","code":["var world = World()","let alice = world.spawn(Name(value: \"Alice\"))","let bob = world.spawn(Name(value: \"Bob\"))","let carol = world.spawn(Name(value: \"Carol\"))","world.relate(alice, Likes(), to: bob)","world.relate(carol, Likes(), to: bob)","","let fans = world.query(Name.self).related(Likes.self, to: bob).map { $0.1.value }","print(fans.sorted())","\/\/ Prints \"[\"Alice\", \"Carol\"]\""],"type":"codeListing"},{"anchor":"Customizing-a-Relation","text":"Customizing a Relation","level":3,"type":"heading"},{"inlineContent":[{"text":"By default a source can relate to any number of targets, and despawning a target removes","type":"text"},{"text":" ","type":"text"},{"text":"its pairs from the sources. Implement ","type":"text"},{"identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/Relation\/isExclusive","type":"reference","isActive":true},{"text":" or ","type":"text"},{"identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/Relation\/onTargetDespawn","type":"reference","isActive":true},{"text":" to change that.","type":"text"}],"type":"paragraph"}],"kind":"content"}],"identifier":{"url":"doc:\/\/WorldModule\/documentation\/WorldModule\/Relation","interfaceLanguage":"swift"},"abstract":[{"type":"text","text":"A type that describes a kind of link from one entity to others."}],"metadata":{"externalID":"s:11WorldModule8RelationP","modules":[{"name":"WorldModule"}],"symbolKind":"protocol","role":"symbol","remoteSource":{"url":"https:\/\/github.com\/Tyler-Keith-Thompson\/ECS\/blob\/main\/Sources\/WorldModule\/Relations.swift#L61","fileName":"Relations.swift"},"title":"Relation","fragments":[{"kind":"keyword","text":"protocol"},{"kind":"text","text":" "},{"kind":"