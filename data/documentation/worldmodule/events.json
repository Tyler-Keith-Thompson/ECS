-Keith-Thompson\/ECS\/blob\/main\/Sources\/WorldModule\/Events.swift#L54"},"fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Events","kind":"identifier"}],"modules":[{"name":"WorldModule"}],"externalID":"s:11WorldModule6EventsV","navigatorTitle":[{"kind":"identifier","text":"Events"}],"title":"Events"},"sections":[],"seeAlsoSections":[{"generated":true,"anchor":"Sending-Events","title":"Sending Events","identifiers":["doc:\/\/WorldModule\/documentation\/WorldModule\/Event","doc:\/\/WorldModule\/documentation\/WorldModule\/EventsView"]}],"references":{"doc://WorldModule/documentation/WorldModule/Resource":{"role":"symbol","abstract":[{"text":"A type that a world can hold a single value of, outside any entity.","type":"text"}],"type":"topic","kind":"symbol","title":"Resource","url":"\/documentation\/worldmodule\/resource","fragments":[{"kind":"keyword","text":"protocol"},{"kind":"text","text":" "},{"kind":"identifier","text":"Resource"}],"navigatorTitle":[{"kind":"identifier","text":"Resource"}],"identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/Resource"},"doc://WorldModule/documentation/WorldModule/World/readEvents(_:by:)":{"url":"\/documentation\/worldmodule\/world\/readevents(_:by:)","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"readEvents","kind":"identifier"},{"text":"<","kind":"text"},{"kind":"genericParameter","text":"E"},{"kind":"text","text":", "},{"kind":"genericParameter","text":"Reader"},{"kind":"text","text":">("},{"kind":"typeIdentifier","text":"E"},{"kind":"text","text":".Type, "},{"kind":"externalParam","text":"by"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"Reader"},{"kind":"text","text":".Type) -> "},{"kind":"typeIdentifier","text":"EventsView","preciseIdentifier":"s:11WorldModule10EventsViewV"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","text":"E"},{"kind":"text","text":">"}],"type":"topic","role":"symbol","kind":"symbol","abstract":[{"text"