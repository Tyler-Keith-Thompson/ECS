{"hierarchy":{"paths":[["doc:\/\/WorldModule\/documentation\/WorldModule"]]},"kind":"symbol","topicSections":[{"identifiers":["doc:\/\/WorldModule\/documentation\/WorldModule\/EntityEvent\/propagates"],"title":"Type Properties","generated":true,"anchor":"Type-Properties"}],"primaryContentSections":[{"kind":"declarations","declarations":[{"tokens":[{"kind":"keyword","text":"protocol"},{"kind":"text","text":" "},{"kind":"identifier","text":"EntityEvent"},{"kind":"text","text":" : "},{"kind":"typeIdentifier","text":"Sendable","preciseIdentifier":"s:s8SendableP"}],"platforms":["Linux"],"languages":["swift"]}]},{"kind":"content","content":[{"level":2,"type":"heading","text":"Overview","anchor":"overview"},{"inlineContent":[{"type":"text","text":"Use an entity event when one part of a program needs to tell an entity that something"},{"type":"text","text":" "},{"type":"text","text":"happened to it, and other parts need to respond right away: a barrel is hit, a button is"},{"type":"text","text":" "},{"type":"text","text":"clicked. Declare the event as a type that conforms to "},{"type":"codeVoice","code":"EntityEvent"},{"type":"text","text":", register observers with"},{"type":"text","text":" "},{"type":"reference","isActive":true,"identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/World\/observe(_:on:perform:)"},{"type":"text","text":" or "},{"type":"reference","isActive":true,"identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/World\/observe(_:perform:)"},{"type":"text","text":", and trigger it with"},{"type":"text","text":" "},{"type":"reference","isActive":true,"identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/World\/trigger(_:on:)"},{"type":"text","text":". The observers run before "},{"type":"codeVoice","code":"trigger(_:on:)"},{"type":"text","text":" returns."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"The following example despawns a barrel when it explodes:"}],"type":"paragraph"},{"type":"codeListing","syntax":"swift","code":["struct Explode: EntityEvent { var radius: Double }","","var world = World()","let barrel = world.spawn(Name(value: \"Barrel\"))","world.observe(Explode.self, on: barrel) { world, trigger in","    world.despawn(trigger.entity)","}","","world.trigger(Explode(radius: 3), on: barrel)","print(world.contains(barrel))","\/\/ Prints \"false\""]},{"inlineContent":[{"text":"An entity event differs from an ","type":"text"},{"isActive":true,"identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/Event","type":"reference"},{"text":", which waits in a queue until systems read it.","type":"text"}],"type":"paragraph"},{"level":3,"type":"heading","text":"Propagating Up the Hierarchy","anchor":"Propagating-Up-the-Hierarchy"},{"inlineContent":[{"type":"text","text":"An event whose "},{"type":"reference","identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/EntityEvent\/propagates","isActive":true},{"text":" property is ","type":"text"},{"type":"codeVoice","code":"true"},{"text":" moves on to the entity’s parent","type":"text"},{"text":" ","type":"text"},{"text":"(","type":"text"},{"type":"reference","isActive":true,"identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/ChildOf"},{"text":") after the entity’s observers run, then to that entity’s parent, and so on up to","type":"text"},{"text":" ","type":"text"},{"text":"the root. The following example lets a panel respond to clicks on any of its buttons:","type":"text"}],"type":"paragraph"},{"type":"codeListing","syntax":"swift","code":["struct Clicked: EntityEvent {","    static var propagates: Bool { true }","}","struct ClickLog: Resource { var entries: [String] = [] }","","var world = World()","world.resources.insert(ClickLog())","let panel = world.spawn(Name(value: \"Panel\"))","let button = world.spawn(Name(value: \"OK\"))","try world.addChild(button, to: panel)","","world.observe(Clicked.self, on: panel) { world, trigger in","    let name = world[Name.self, of: trigger.originalEntity].value","    world.resources[ClickLog.self].entries.append(\"Panel saw a click on \\(name)\")","}","","world.trigger(Clicked(), on: button)","print(world.resources[ClickLog.self].entries)","\/\/ Prints \"[\"Panel saw a click on OK\"]\""]},{"inlineContent":[{"text":"An observer can stop an event from going further by setting the trigger’s","type":"text"},{"text":" ","type":"text"},{"identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/Trigger\/propagates","isActive":true,"type":"reference"},{"text":" property to ","type":"text"},{"type":"codeVoice","code":"false"},{"text":".","type":"text"}],"type":"paragraph"}]}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/worldmodule\/entityevent"]}],"relationshipsSections":[{"type":"inheritsFrom","identifiers":["doc:\/\/WorldModule\/s8SendableP","doc:\/\/WorldModule\/s16SendableMetatypeP"],"title":"Inherits From","kind":"relationships"}],"seeAlsoSections":[{"identifiers":["doc:\/\/WorldModule\/documentation\/WorldModule\/Trigger"],"anchor":"Reacting-to-Changes-with-Hooks-and-Observers","title":"Reacting to Changes with Hooks and Observers","generated":true}],"schemaVersion":{"minor":3,"patch":0,"major":0},"metadata":{"role":"symbol","remoteSource":{"url":"https:\/\/github.com\/Tyler-Keith-Thompson\/ECS\/blob\/main\/Sources\/WorldModule\/Observers.swift#L58","fileName":"Observers.swift"},"modules":[{"name":"WorldModule"}],"symbolKind":"protocol","fragments":[{"kind":"keyword","text":"protocol"},{"kind":"text","text":" "},{"kind":"identifier","text":"EntityEvent"}],"roleHeading":"Protocol","externalID":"s:11WorldModule11EntityEventP","title":"EntityEvent","navigatorTitle":[{"kind":"identifier","text":"EntityEvent"}]},"sections":[],"identifier":{"url":"doc:\/\/WorldModule\/documentation\/WorldModule\/EntityEvent","interfaceLanguage":"swift"},"abstract":[{"text":"A type that describes something that happens to a particular entity, which its observers","type":"text"},{"text":" ","type":"text"},{