{"topicSections":[{"identifiers":["doc:\/\/WorldModule\/documentation\/WorldModule\/EntityEvent\/propagates"],"generated":true,"title":"Type Properties","anchor":"Type-Properties"}],"sections":[],"seeAlsoSections":[{"identifiers":["doc:\/\/WorldModule\/documentation\/WorldModule\/Trigger"],"generated":true,"title":"Reacting to Changes with Hooks and Observers","anchor":"Reacting-to-Changes-with-Hooks-and-Observers"}],"variants":[{"paths":["\/documentation\/worldmodule\/entityevent"],"traits":[{"interfaceLanguage":"swift"}]}],"primaryContentSections":[{"kind":"declarations","declarations":[{"languages":["swift"],"tokens":[{"kind":"keyword","text":"protocol"},{"kind":"text","text":" "},{"kind":"identifier","text":"EntityEvent"},{"kind":"text","text":" : "},{"kind":"typeIdentifier","preciseIdentifier":"s:s8SendableP","text":"Sendable"}],"platforms":["Linux"]}]},{"kind":"content","content":[{"text":"Overview","anchor":"overview","type":"heading","level":2},{"inlineContent":[{"type":"text","text":"Use an entity event when one part of a program needs to tell an entity that something"},{"type":"text","text":" "},{"type":"text","text":"happened to it, and other parts need to respond right away: a barrel is hit, a button is"},{"type":"text","text":" "},{"type":"text","text":"clicked. Declare the event as a type that conforms to "},{"type":"codeVoice","code":"EntityEvent"},{"type":"text","text":", register observers with"},{"type":"text","text":" "},{"type":"reference","isActive":true,"identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/World\/observe(_:on:perform:)"},{"type":"text","text":" or "},{"type":"reference","isActive":true,"identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/World\/observe(_:perform:)"},{"type":"text","text":", and trigger it with"},{"type":"text","text":" "},{"type":"reference","isActive":true,"identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/World\/trigger(_:on:)"},{"type":"text","text":". The observers run before "},{"type":"codeVoice","code":"trigger(_:on:)"},{"type":"text","text":" returns."}],"type":"paragraph"},{"inlineContent":[{"text":"The following example despawns a barrel when it explodes:","type":"text"}],"type":"paragraph"},{"syntax":"swift","type":"codeListing","code":["struct Explode: EntityEvent { var radius: Double }","","var world = World()","let barrel = world.spawn(Name(value: \"Barrel\"))","world.observe(Explode.self, on: barrel) { world, trigger in","    world.despawn(trigger.entity)","}","","world.trigger(Explode(radius: 3), on: barrel)","print(world.contains(barrel))","\/\/ Prints \"false\""]},{"inlineContent":[{"type":"text","text":"An entity event differs from an "},{"type":"reference","isActive":true,"identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/Event"},{"type":"text","text":", which waits in a queue until systems read it."}],"type":"paragraph"},{"text":"Propagating Up the Hierarchy","anchor":"Propagating-Up-the-Hierarchy","type":"heading","level":3},{"inlineContent":[{"text":"An event whose ","type":"text"},{"identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/EntityEvent\/propagates","type":"reference","isActive":true},{"text":" property is ","type":"text"},{"type":"codeVoice","code":"true"},{"text":" moves on to the entity’s parent","type":"text"},{"text":" ","type":"text"},{"text":"(","type":"text"},{"identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/ChildOf","type":"reference","isActive":true},{"text":") after the entity’s observers run, then to that entity’s parent, and so on up to","type":"text"},{"text":" ","type":"text"},{"text":"the root. The following example lets a panel respond to clicks on any of its buttons:","type":"text"}],"type":"paragraph"},{"syntax":"swift","type":"codeListing","code":["struct Clicked: EntityEvent {","    static var propagates: Bool { true }","}","struct ClickLog: Resource { var entries: [String] = [] }","","var world = World()","world.resources.insert(ClickLog())","let panel = world.spawn(Name(value: \"Panel\"))","let button = world.spawn(Name(value: \"OK\"))","try world.addChild(button, to: panel)","","world.observe(Clicked.self, on: panel) { world, trigger in","    let name = world[Name.self, of: trigger.originalEntity].value","    world.resources[ClickLog.self].entries.append(\"Panel saw a click on \\(name)\")","}","","world.trigger(Clicked(), on: button)","print(world.resources[ClickLog.self].entries)","\/\/ Prints \"[\"Panel saw a click on OK\"]\""]},{"inlineContent":[{"type":"text","text":"An observer can stop an event from going further by setting the trigger’s"},{"type":"text","text":" "},{"type":"reference","identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/Trigger\/propagates","isActive":true},{"type":"text","text":" property to "},{"type":"codeVoice","code":"false"},{"type":"text","text":"."}],"type":"paragraph"}]}],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/WorldModule\/documentation\/WorldModule\/EntityEvent"},"kind":"symbol","metadata":{"role":"symbol","modules":[{"name":"WorldModule"}],"roleHeading":"Protocol","title":"EntityEvent","symbolKind":"protocol","fragments":[{"text":"protocol","kind":"keyword"},{"text":" ","kind":"text"},{"text":"EntityEvent","kind":"identifier"}],"externalID":"s:11WorldModule11EntityEventP","navigatorTitle":[{"text":"EntityEvent","kind":"identifier"}],"remoteSource":{"url":"https:\/\/github.com\/Tyler-Keith-Thompson\/ECS\/blob\/main\/Sources\/WorldModule\/Observers.swift#L58","fileName":"Observers.swift"}},"schemaVersion":{"major":0,"minor":3,"patch":0},"hierarchy":{"paths":[["doc:\/\/WorldModule\/documentation\/WorldModule"]]},"relationshipsSections":[{"kind":"relationships","type":"inheritsFrom","identifiers":["doc:\/\/WorldModule\/s8SendableP","doc:\/\/WorldModule\/s16SendableMetatypeP"],"title":"Inherits From"}],"abstract":[{"text":"A type that describes something that happens to a particular entity, which its observers","type":"text"},{"text":" ","type":"text"},{