{"topicSections":[{"anchor":"Type-Properties","title":"Type Properties","identifiers":["doc:\/\/WorldModule\/documentation\/WorldModule\/EntityEvent\/propagates"],"generated":true}],"kind":"symbol","hierarchy":{"paths":[["doc:\/\/WorldModule\/documentation\/WorldModule"]]},"relationshipsSections":[{"kind":"relationships","title":"Inherits From","identifiers":["doc:\/\/WorldModule\/s8SendableP","doc:\/\/WorldModule\/s16SendableMetatypeP"],"type":"inheritsFrom"}],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/WorldModule\/documentation\/WorldModule\/EntityEvent"},"variants":[{"paths":["\/documentation\/worldmodule\/entityevent"],"traits":[{"interfaceLanguage":"swift"}]}],"sections":[],"metadata":{"fragments":[{"text":"protocol","kind":"keyword"},{"text":" ","kind":"text"},{"text":"EntityEvent","kind":"identifier"}],"modules":[{"name":"WorldModule"}],"roleHeading":"Protocol","remoteSource":{"fileName":"Observers.swift","url":"https:\/\/github.com\/Tyler-Keith-Thompson\/ECS\/blob\/main\/Sources\/WorldModule\/Observers.swift#L58"},"symbolKind":"protocol","role":"symbol","title":"EntityEvent","externalID":"s:11WorldModule11EntityEventP","navigatorTitle":[{"text":"EntityEvent","kind":"identifier"}]},"schemaVersion":{"minor":3,"major":0,"patch":0},"seeAlsoSections":[{"anchor":"Reacting-to-Changes-with-Hooks-and-Observers","title":"Reacting to Changes with Hooks and Observers","identifiers":["doc:\/\/WorldModule\/documentation\/WorldModule\/Trigger"],"generated":true}],"abstract":[{"text":"A type that describes something that happens to a particular entity, which its observers","type":"text"},{"text":" ","type":"text"},{"text":"respond to at once.","type":"text"}],"primaryContentSections":[{"kind":"declarations","declarations":[{"platforms":["Linux"],"tokens":[{"text":"protocol","kind":"keyword"},{"text":" ","kind":"text"},{"text":"EntityEvent","kind":"identifier"},{"text":" : ","kind":"text"},{"text":"Sendable","kind":"typeIdentifier","preciseIdentifier":"s:s8SendableP"}],"languages":["swift"]}]},{"kind":"content","content":[{"type":"heading","anchor":"overview","level":2,"text":"Overview"},{"type":"paragraph","inlineContent":[{"text":"Use an entity event when one part of a program needs to tell an entity that something","type":"text"},{"text":" ","type":"text"},{"text":"happened to it, and other parts need to respond right away: a barrel is hit, a button is","type":"text"},{"text":" ","type":"text"},{"text":"clicked. Declare the event as a type that conforms to ","type":"text"},{"code":"EntityEvent","type":"codeVoice"},{"text":", register observers with","type":"text"},{"text":" ","type":"text"},{"identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/World\/observe(_:on:perform:)","isActive":true,"type":"reference"},{"text":" or ","type":"text"},{"identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/World\/observe(_:perform:)","isActive":true,"type":"reference"},{"text":", and trigger it with","type":"text"},{"text":" ","type":"text"},{"identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/World\/trigger(_:on:)","isActive":true,"type":"reference"},{"text":". The observers run before ","type":"text"},{"code":"trigger(_:on:)","type":"codeVoice"},{"text":" returns.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"The following example despawns a barrel when it explodes:","type":"text"}]},{"type":"codeListing","syntax":"swift","code":["struct Explode: EntityEvent { var radius: Double }","","var world = World()","let barrel = world.spawn(Name(value: \"Barrel\"))","world.observe(Explode.self, on: barrel) { world, trigger in","    world.despawn(trigger.entity)","}","","world.trigger(Explode(radius: 3), on: barrel)","print(world.contains(barrel))","\/\/ Prints \"false\""]},{"type":"paragraph","inlineContent":[{"text":"An entity event differs from an ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/Event"},{"text":", which waits in a queue until systems read it.","type":"text"}]},{"type":"heading","anchor":"Propagating-Up-the-Hierarchy","level":3,"text":"Propagating Up the Hierarchy"},{"type":"paragraph","inlineContent":[{"text":"An event whose ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/EntityEvent\/propagates"},{"text":" property is ","type":"text"},{"code":"true","type":"codeVoice"},{"text":" moves on to the entity’s parent","type":"text"},{"text":" ","type":"text"},{"text":"(","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/ChildOf"},{"text":") after the entity’s observers run, then to that entity’s parent, and so on up to","type":"text"},{"text":" ","type":"text"},{"text":"the root. The following example lets a panel respond to clicks on any of its buttons:","type":"text"}]},{"type":"codeListing","syntax":"swift","code":["struct Clicked: EntityEvent {","    static var propagates: Bool { true }","}","struct ClickLog: Resource { var entries: [String] = [] }","","var world = World()","world.resources.insert(ClickLog())","let panel = world.spawn(Name(value: \"Panel\"))","let button = world.spawn(Name(value: \"OK\"))","try world.addChild(button, to: panel)","","world.observe(Clicked.self, on: panel) { world, trigger in","    let name = world[Name.self, of: trigger.originalEntity].value","    world.resources[ClickLog.self].entries.append(\"Panel saw a click on \\(name)\")","}","","world.trigger(Clicked(), on: button)","print(world.resources[ClickLog.self].entries)","\/\/ Prints \"[\"Panel saw a click on OK\"]\""]},{"type":"paragraph","inlineContent":[{"type":"text","text":"An observer can stop an event from going further by setting the trigger’s"},{"type":"text","text":" "},{"isActive":true,"identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/Trigger\/propagates","type":"reference"},{"type":"text","text":" property to "},{"type":"codeVoice","code":"false"},{"type":"text","text":"."}]}]}],"references":{"doc://WorldModule/documentation/WorldModule/Event":{"url":"\/documentation\/worldmodule\/event","type":"topic","navigatorTitle":[{"kind":"identifier","text":"Event"}],"kind":"symbol","identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/Event","abstract":[{"type":"text","text":"A type that describes a message one part of a program sends and other parts read later."}],"title":"Event","fragments":[{"kind":"keyword","text":"protocol"},{"kind":"text","text":" "},{"kind":"identifier","text":"Event"}],"role":"symbol"},"doc://WorldModule/s8SendableP":{"title":"Swift.Sendable","type":"unresolvable","identifier":"doc:\/\/WorldModule\/s8SendableP"},"doc://WorldModule/documentation/WorldModule/World/trigger(_:on:)":{"role":"symbol","kind":"symbol","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"trigger","kind":"identifier"},{"text":"<","kind":"text"},{"text":"E","kind":"genericParameter"},{"text":">(","kind":"text"},{"text":"E","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"on","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"Entity","preciseIdentifier":"s:11WorldModule6EntityV","kind":"typeIdentifier"},{"text":")","kind":"text"}],"type":"topic","abstract":[{"text":"Triggers an event on an entity, running its observers before returning.","type":"text"}],"url":"\/documentation\/worldmodule\/world\/trigger(_:on:)","title":"trigger(_:on:)","identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/World\/trigger(_:on:)"},"doc://WorldModule/documentation/WorldModule/EntityEvent":{"type":"topic","abstract":[{"type":"text","text":"A type that describes something that happens to a particular entity, which its observers"},{"type":"text","text":" "},{"type":"text","text":"respond to at once."}],"role":"symbol","navigatorTitle":[{"kind":"identifier","text":"EntityEvent"}],"identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/EntityEvent","url":"\