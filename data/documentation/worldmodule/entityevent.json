{"sections":[],"identifier":{"url":"doc:\/\/WorldModule\/documentation\/WorldModule\/EntityEvent","interfaceLanguage":"swift"},"hierarchy":{"paths":[["doc:\/\/WorldModule\/documentation\/WorldModule"]]},"kind":"symbol","topicSections":[{"anchor":"Type-Properties","generated":true,"identifiers":["doc:\/\/WorldModule\/documentation\/WorldModule\/EntityEvent\/propagates"],"title":"Type Properties"}],"relationshipsSections":[{"type":"inheritsFrom","kind":"relationships","identifiers":["doc:\/\/WorldModule\/s8SendableP","doc:\/\/WorldModule\/s16SendableMetatypeP"],"title":"Inherits From"}],"variants":[{"paths":["\/documentation\/worldmodule\/entityevent"],"traits":[{"interfaceLanguage":"swift"}]}],"metadata":{"modules":[{"name":"WorldModule"}],"symbolKind":"protocol","navigatorTitle":[{"text":"EntityEvent","kind":"identifier"}],"fragments":[{"text":"protocol","kind":"keyword"},{"text":" ","kind":"text"},{"text":"EntityEvent","kind":"identifier"}],"remoteSource":{"fileName":"Observers.swift","url":"https:\/\/github.com\/Tyler-Keith-Thompson\/ECS\/blob\/main\/Sources\/WorldModule\/Observers.swift#L58"},"role":"symbol","externalID":"s:11WorldModule11EntityEventP","title":"EntityEvent","roleHeading":"Protocol"},"seeAlsoSections":[{"anchor":"Reacting-to-Changes-with-Hooks-and-Observers","generated":true,"identifiers":["doc:\/\/WorldModule\/documentation\/WorldModule\/Trigger"],"title":"Reacting to Changes with Hooks and Observers"}],"primaryContentSections":[{"kind":"declarations","declarations":[{"tokens":[{"kind":"keyword","text":"protocol"},{"kind":"text","text":" "},{"kind":"identifier","text":"EntityEvent"},{"kind":"text","text":" : "},{"kind":"typeIdentifier","text":"Sendable","preciseIdentifier":"s:s8SendableP"}],"platforms":["Linux"],"languages":["swift"]}]},{"content":[{"anchor":"overview","text":"Overview","type":"heading","level":2},{"inlineContent":[{"type":"text","text":"Use an entity event when one part of a program needs to tell an entity that something"},{"type":"text","text":" "},{"type":"text","text":"happened to it, and other parts need to respond right away: a barrel is hit, a button is"},{"type":"text","text":" "},{"type":"text","text":"clicked. Declare the event as a type that conforms to "},{"code":"EntityEvent","type":"codeVoice"},{"type":"text","text":", register observers with"},{"type":"text","text":" "},{"isActive":true,"type":"reference","identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/World\/observe(_:on:perform:)"},{"type":"text","text":" or "},{"isActive":true,"type":"reference","identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/World\/observe(_:perform:)"},{"type":"text","text":", and trigger it with"},{"type":"text","text":" "},{"isActive":true,"type":"reference","identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/World\/trigger(_:on:)"},{"type":"text","text":". The observers run before "},{"code":"trigger(_:on:)","type":"codeVoice"},{"type":"text","text":" returns."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"The following example despawns a barrel when it explodes:"}],"type":"paragraph"},{"code":["struct Explode: EntityEvent { var radius: Double }","","var world = World()","let barrel = world.spawn(Name(value: \"Barrel\"))","world.observe(Explode.self, on: barrel) { world, trigger in","    world.despawn(trigger.entity)","}","","world.trigger(Explode(radius: 3), on: barrel)","print(world.contains(barrel))","\/\/ Prints \"false\""],"type":"codeListing","syntax":"swift"},{"inlineContent":[{"text":"An entity event differs from an ","type":"text"},{"isActive":true,"identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/Event","type":"reference"},{"text":", which waits in a queue until systems read it.","type":"text"}],"type":"paragraph"},{"anchor":"Propagating-Up-the-Hierarchy","text":"Propagating Up the Hierarchy","type":"heading","level":3},{"inlineContent":[{"text":"An event whose ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/EntityEvent\/propagates"},{"text":" property is ","type":"text"},{"code":"true","type":"codeVoice"},{"text":" moves on to the entity’s parent","type":"text"},{"text":" ","type":"text"},{"text":"(","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/ChildOf"},{"text":") after the entity’s observers run, then to that entity’s parent, and so on up to","type":"text"},{"text":" ","type":"text"},{"text":"the root. The following example lets a panel respond to clicks on any of its buttons:","type":"text"}],"type":"paragraph"},{"code":["struct Clicked: EntityEvent {","    static var propagates: Bool { true }","}","struct ClickLog: Resource { var entries: [String] = [] }","","var world = World()","world.resources.insert(ClickLog())","let panel = world.spawn(Name(value: \"Panel\"))","let button = world.spawn(Name(value: \"OK\"))","try world.addChild(button, to: panel)","","world.observe(Clicked.self, on: panel) { world, trigger in","    let name = world[Name.self, of: trigger.originalEntity].value","    world.resources[ClickLog.self].entries.append(\"Panel saw a click on \\(name)\")","}","","world.trigger(Clicked(), on: button)","print(world.resources[ClickLog.self].entries)","\/\/ Prints \"[\"Panel saw a click on OK\"]\""],"type":"codeListing","syntax":"swift"},{"inlineContent":[{"type":"text","text":"An observer can stop an event from going further by setting the trigger’s"},{"type":"text","text":" "},{"identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/Trigger\/propagates","type":"reference","isActive":true},{"type":"text","text":" property to "},{"type":"codeVoice","code":"false"},{"type":"text","text":"."}],"type":"paragraph"}],"kind":"content"}],"abstract":[{"type":"text","text":"A type that describes something that happens to a particular entity, which its observers"},{"type":"text","text":" "},{"type":"text","text":"respond to at once."}],"sc