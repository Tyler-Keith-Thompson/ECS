{"seeAlsoSections":[{"title":"Reacting to Changes with Hooks and Observers","generated":true,"anchor":"Reacting-to-Changes-with-Hooks-and-Observers","identifiers":["doc:\/\/WorldModule\/documentation\/WorldModule\/Trigger"]}],"topicSections":[{"title":"Type Properties","generated":true,"anchor":"Type-Properties","identifiers":["doc:\/\/WorldModule\/documentation\/WorldModule\/EntityEvent\/propagates"]}],"primaryContentSections":[{"declarations":[{"tokens":[{"text":"protocol","kind":"keyword"},{"text":" ","kind":"text"},{"text":"EntityEvent","kind":"identifier"},{"text":" : ","kind":"text"},{"text":"Sendable","preciseIdentifier":"s:s8SendableP","kind":"typeIdentifier"}],"languages":["swift"],"platforms":["Linux"]}],"kind":"declarations"},{"content":[{"text":"Overview","level":2,"anchor":"overview","type":"heading"},{"type":"paragraph","inlineContent":[{"text":"Use an entity event when one part of a program needs to tell an entity that something","type":"text"},{"text":" ","type":"text"},{"text":"happened to it, and other parts need to respond right away: a barrel is hit, a button is","type":"text"},{"text":" ","type":"text"},{"text":"clicked. Declare the event as a type that conforms to ","type":"text"},{"code":"EntityEvent","type":"codeVoice"},{"text":", register observers with","type":"text"},{"text":" ","type":"text"},{"identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/World\/observe(_:on:perform:)","isActive":true,"type":"reference"},{"text":" or ","type":"text"},{"identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/World\/observe(_:perform:)","isActive":true,"type":"reference"},{"text":", and trigger it with","type":"text"},{"text":" ","type":"text"},{"identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/World\/trigger(_:on:)","isActive":true,"type":"reference"},{"text":". The observers run before ","type":"text"},{"code":"trigger(_:on:)","type":"codeVoice"},{"text":" returns.","type":"text"}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"The following example despawns a barrel when it explodes:"}]},{"syntax":"swift","code":["struct Explode: EntityEvent { var radius: Double }","","var world = World()","let barrel = world.spawn(Name(value: \"Barrel\"))","world.observe(Explode.self, on: barrel) { world, trigger in","    world.despawn(trigger.entity)","}","","world.trigger(Explode(radius: 3), on: barrel)","print(world.contains(barrel))","\/\/ Prints \"false\""],"type":"codeListing"},{"type":"paragraph","inlineContent":[{"type":"text","text":"An entity event differs from an "},{"type":"reference","identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/Event","isActive":true},{"type":"text","text":", which waits in a queue until systems read it."}]},{"text":"Propagating Up the Hierarchy","level":3,"anchor":"Propagating-Up-the-Hierarchy","type":"heading"},{"type":"paragraph","inlineContent":[{"type":"text","text":"An event whose "},{"identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/EntityEvent\/propagates","type":"reference","isActive":true},{"type":"text","text":" property is "},{"code":"true","type":"codeVoice"},{"type":"text","text":" moves on to the entity’s parent"},{"type":"text","text":" "},{"type":"text","text":"("},{"identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/ChildOf","type":"reference","isActive":true},{"type":"text","text":") after the entity’s observers run, then to that entity’s parent, and so on up to"},{"type":"text","text":" "},{"type":"text","text":"the root. The following example lets a panel respond to clicks on any of its buttons:"}]},{"syntax":"swift","code":["struct Clicked: EntityEvent {","    static var propagates: Bool { true }","}","struct ClickLog: Resource { var entries: [String] = [] }","","var world = World()","world.resources.insert(ClickLog())","let panel = world.spawn(Name(value: \"Panel\"))","let button = world.spawn(Name(value: \"OK\"))","try world.addChild(button, to: panel)","","world.observe(Clicked.self, on: panel) { world, trigger in","    let name = world[Name.self, of: trigger.originalEntity].value","    world.resources[ClickLog.self].entries.append(\"Panel saw a click on \\(name)\")","}","","world.trigger(Clicked(), on: button)","print(world.resources[ClickLog.self].entries)","\/\/ Prints \"[\"Panel saw a click on OK\"]\""],"type":"codeListing"},{"type":"paragraph","inlineContent":[{"type":"text","text":"An observer can stop an event from going further by setting the trigger’s"},{"type":"text","text":" "},{"identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/Trigger\/propagates","type":"reference","isActive":true},{"type":"text","text":" property to "},{"type":"codeVoice","code":"false"},{"type":"text","text":"."}]}],"kind":"content"}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/worldmodule\/entityevent"]}],"hierarchy":{"paths":[["doc:\/\/WorldModule\/documentation\/WorldModule"]]},"relationshipsSections":[{"title":"Inherits From","type":"inheritsFrom","kind":"relationships","identifiers":["doc:\/\/WorldModule\/s8SendableP","doc:\/\/WorldModule\/s16SendableMetatypeP"]}],"kind":"symbol","identifier":{"interfaceLanguage":"swift","url":"doc:\/\/WorldModule\/documentation\/WorldModule\/EntityEvent"},"metadata":{"navigatorTitle":[{"text":"EntityEvent","kind":"identifier"}],"roleHeading":"Protocol","modules":[{"name":"WorldModule"}],"title":"EntityEvent","role":"symbol","symbolKind":"protocol","externalID":"s:11WorldModule11EntityEventP","remoteSource":{"fileName":"Observers.swift","url":"https:\/\/github.com\/Tyler-Keith-Thompson\/ECS\/blob\/main\/Sources\/WorldModule\/Observers.swift#L58"},"fragments":[{"kind":"keyword","text":"protocol"},{"kind":"text","text":" "},{"kind":"identifier","text":"EntityEvent"}]},"schemaVersion":{"major":0,"minor":3,"patch":0},"sections":[],"abstract":[{"type":"text","text":"A type that describes something that happens to a particular entity, which its observers"},{"type":"text","text":" "},{