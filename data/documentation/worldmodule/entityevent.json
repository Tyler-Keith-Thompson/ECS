ct":[{"text":"The entity whose observers are running: the entity the event was triggered on, or an","type":"text"},{"text":" ","type":"text"},{"text":"ancestor it propagated to.","type":"text"}]},"doc://WorldModule/documentation/WorldModule/Trigger/propagates":{"abstract":[{"type":"text","text":"A Boolean value indicating whether the event moves on to the parent of "},{"isActive":true,"type":"reference","identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/Trigger\/entity"},{"type":"text","text":" after"},{"type":"text","text":" "},{"type":"text","text":"its observers run."}],"role":"symbol","identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/Trigger\/propagates","kind":"symbol","fragments":[{"text":"var","kind":"keyword"},{"text":" ","kind":"text"},{"text":"propagates","kind":"identifier"},{"text":": ","kind":"text"},{"text":"Bool","kind":"typeIdentifier","preciseIdentifier":"s:Sb"}],"title":"propagates","url":"\/documentation\/worldmodule\/trigger\/propagates","type":"topic"},"doc://WorldModule/s8SendableP":{"title":"Swift.Sendable","identifier":"doc:\/\/WorldModule\/s8SendableP","type":"unresolvable"}}}