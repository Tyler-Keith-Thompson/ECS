{"seeAlsoSections":[{"anchor":"Reacting-to-Changes-with-Hooks-and-Observers","title":"Reacting to Changes with Hooks and Observers","identifiers":["doc:\/\/WorldModule\/documentation\/WorldModule\/Trigger"],"generated":true}],"kind":"symbol","identifier":{"interfaceLanguage":"swift","url":"doc:\/\/WorldModule\/documentation\/WorldModule\/EntityEvent"},"abstract":[{"type":"text","text":"A type that describes something that happens to a particular entity, which its observers"},{"type":"text","text":" "},{"type":"text","text":"respond to at once."}],"schemaVersion":{"patch":0,"major":0,"minor":3},"primaryContentSections":[{"kind":"declarations","declarations":[{"languages":["swift"],"tokens":[{"text":"protocol","kind":"keyword"},{"text":" ","kind":"text"},{"text":"EntityEvent","kind":"identifier"},{"text":" : ","kind":"text"},{"preciseIdentifier":"s:s8SendableP","text":"Sendable","kind":"typeIdentifier"}],"platforms":["Linux"]}]},{"content":[{"type":"heading","text":"Overview","level":2,"anchor":"overview"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Use an entity event when one part of a program needs to tell an entity that something"},{"type":"text","text":" "},{"type":"text","text":"happened to it, and other parts need to respond right away: a barrel is hit, a button is"},{"type":"text","text":" "},{"type":"text","text":"clicked. Declare the event as a type that conforms to "},{"type":"codeVoice","code":"EntityEvent"},{"type":"text","text":", register observers with"},{"type":"text","text":" "},{"identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/World\/observe(_:on:perform:)","type":"reference","isActive":true},{"type":"text","text":" or "},{"identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/World\/observe(_:perform:)","type":"reference","isActive":true},{"type":"text","text":", and trigger it with"},{"type":"text","text":" "},{"identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/World\/trigger(_:on:)","type":"reference","isActive":true},{"type":"text","text":". The observers run before "},{"type":"codeVoice","code":"trigger(_:on:)"},{"type":"text","text":" returns."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"The following example despawns a barrel when it explodes:"}]},{"type":"codeListing","syntax":"swift","code":["struct Explode: EntityEvent { var radius: Double }","","var world = World()","let barrel = world.spawn(Name(value: \"Barrel\"))","world.observe(Explode.self, on: barrel) { world, trigger in","    world.despawn(trigger.entity)","}","","world.trigger(Explode(radius: 3), on: barrel)","print(world.contains(barrel))","\/\/ Prints \"false\""]},{"type":"paragraph","inlineContent":[{"text":"An entity event differs from an ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/Event"},{"text":", which waits in a queue until systems read it.","type":"text"}]},{"type":"heading","text":"Propagating Up the Hierarchy","level":3,"anchor":"Propagating-Up-the-Hierarchy"},{"type":"paragraph","inlineContent":[{"text":"An event whose ","type":"text"},{"type":"reference","identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/EntityEvent\/propagates","isActive":true},{"text":" property is ","type":"text"},{"type":"codeVoice","code":"true"},{"text":" moves on to the entity’s parent","type":"text"},{"text":" ","type":"text"},{"text":"(","type":"text"},{"type":"reference","identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/ChildOf","isActive":true},{"text":") after the entity’s observers run, then to that entity’s parent, and so on up to","type":"text"},{"text":" ","type":"text"},{"text":"the root. The following example lets a panel respond to clicks on any of its buttons:","type":"text"}]},{"type":"codeListing","syntax":"swift","code":["struct Clicked: EntityEvent {","    static var propagates: Bool { true }","}","struct ClickLog: Resource { var entries: [String] = [] }","","var world = World()","world.resources.insert(ClickLog())","let panel = world.spawn(Name(value: \"Panel\"))","let button = world.spawn(Name(value: \"OK\"))","try world.addChild(button, to: panel)","","world.observe(Clicked.self, on: panel) { world, trigger in","    let name = world[Name.self, of: trigger.originalEntity].value","    world.resources[ClickLog.self].entries.append(\"Panel saw a click on \\(name)\")","}","","world.trigger(Clicked(), on: button)","print(world.resources[ClickLog.self].entries)","\/\/ Prints \"[\"Panel saw a click on OK\"]\""]},{"type":"paragraph","inlineContent":[{"type":"text","text":"An observer can stop an event from going further by setting the trigger’s"},{"type":"text","text":" "},{"type":"reference","isActive":true,"identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/Trigger\/propagates"},{"type":"text","text":" property to "},{"code":"false","type":"codeVoice"},{"type":"text","text":"."}]}],"kind":"content"}],"sections":[],"topicSections":[{"anchor":"Type-Properties","title":"Type Properties","identifiers":["doc:\/\/WorldModule\/documentation\/WorldModule\/EntityEvent\/propagates"],"generated":true}],"variants":[{"paths":["\/documentation\/worldmodule\/entityevent"],"traits":[{"interfaceLanguage":"swift"}]}],"hierarchy":{"paths":[["doc:\/\/WorldModule\/documentation\/WorldModule"]]},"relationshipsSections":[{"title":"Inherits From","type":"inheritsFrom","identifiers":["doc:\/\/WorldModule\/s8SendableP","doc:\/\/WorldModule\/s16SendableMetatypeP"],"kind":"relationships"}],"metadata":{"modules":[{"name":"WorldModule"}],"navigatorTitle":[{"text":"EntityEvent","kind":"identifier"}],"roleHeading":"Protocol","fragments":[{"text":"protocol","kind":"keyword"},{"text":" ","kind":"text"},{"text":"EntityEvent","kind":"identifier"}],"remoteSource":{"url":"https:\/\/github.com\/Tyler-Keith-Thompson\/ECS\/blob\/main\/Sources\/WorldModule\/Observers.swift#L58","fileName":"Observers.swift"},"symbolKind":"protocol","role":"symbol","title":"EntityEvent","