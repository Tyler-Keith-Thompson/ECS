\/observe(_:perform:)","identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/World\/observe(_:perform:)"},"doc://WorldModule/documentation/WorldModule/EntityEvent":{"type":"topic","role":"symbol","title":"EntityEvent","navigatorTitle":[{"text":"EntityEvent","kind":"identifier"}],"abstract":[{"type":"text","text":"A type that describes something that happens to a particular entity, which its observers"},{"type":"text","text":" "},{"type":"text","text":"respond to at once."}],"fragments":[{"text":"protocol","kind":"keyword"},{"text":" ","kind":"text"},{"text":"EntityEvent","kind":"identifier"}],"url":"\/documentation\/worldmodule\/entityevent","kind":"symbol","identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/EntityEvent"},"doc://WorldModule/s8SendableP":{"type":"unresolvable","identifier":"doc:\/\/WorldModule\/s8SendableP","title":"Swift.Sendable"},"doc://WorldModule/documentation/WorldModule/Trigger/propagates":{"identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/Trigger\/propagates","role":"symbol","title":"propagates","abstract":[{"type":"text","text":"A Boolean value indicating whether the event moves on to the parent of "},{"type":"reference","identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/Trigger\/entity","isActive":true},{"type":"text","text":" after"},{"type":"text","text":" "},{"type":"text","text":"its observers run."}],"fragments":[{"text":"var","kind":"keyword"},{"text":" ","kind":"text"},{"text":"propagates","kind":"identifier"},{"text":": ","kind":"text"},{"text":"Bool","preciseIdentifier":"s:Sb","kind":"typeIdentifier"}],"type":"topic","url":"\/documentation\/worldmodule\/trigger\/propagates","kind":"symbol"},"doc://WorldModule/s16SendableMetatypeP":{"title":"Swift.SendableMetatype","identifier":"doc:\/\/WorldModule\/s16SendableMetatypeP","type":"unresolvable"},"doc://WorldModule/documentation/WorldModule/Event":{"kind":"symbol","title":"Event","fragments":[{"kind":"keyword","text":"protocol"},{"kind":"tex