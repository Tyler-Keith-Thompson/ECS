xt":", register observers with","type":"text"},{"text":" ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/World\/observe(_:on:perform:)"},{"text":" or ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/World\/observe(_:perform:)"},{"text":", and trigger it with","type":"text"},{"text":" ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/World\/trigger(_:on:)"},{"text":". The observers run before ","type":"text"},{"code":"trigger(_:on:)","type":"codeVoice"},{"text":" returns.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"The following example despawns a barrel when it explodes:","type":"text"}]},{"code":["struct Explode: EntityEvent { var radius: Double }","","var world = World()","let barrel = world.spawn(Name(value: \"Barrel\"))","world.observe(Explode.self, on: barrel) { world, trigger in","    world.despawn(trigger.entity)","}","","world.trigger(Explode(radius: 3), on: barrel)","print(world.contains(barrel))","\/\/ Prints \"false\""],"type":"codeListing","syntax":"swift"},{"type":"paragraph","inlineContent":[{"text":"An entity event differs from an ","type":"text"},{"isActive":true,"identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/Event","type":"reference"},{"text":", which waits in a queue until systems read it.","type":"text"}]},{"type":"heading","anchor":"Propagating-Up-the-Hierarchy","level":3,"text":"Propagating Up the Hierarchy"},{"type":"paragraph","inlineContent":[{"type":"text","text":"An event whose "},{"isActive":true,"type":"reference","identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/EntityEvent\/propagates"},{"type":"text","text":" property is "},{"type":"codeVoice","code":"true"},{"type":"text","text":" moves on to the entity’s parent"},{"type":"text","text":" "},{"type":"text","text":"("},{"isActive":true,"type":"reference","identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/ChildOf"},{"type":"text","text":") after the entity’s observers run, then to that entity’s parent, and so on up to"},{"type":"text","text":" "},{"type":"text","text":"the root. The following example lets a panel respond to clicks on any of its buttons:"}]},{"code":["struct Clicked: EntityEvent {","    static var propagates: Bool { true }","}","struct ClickLog: Resource { var entries: [String] = [] }","","var world = World()","world.resources.insert(ClickLog())","let panel = world.spawn(Name(value: \"Panel\"))","let button = world.spawn(Name(value: \"OK\"))","try world.addChild(button, to: panel)","","world.observe(Clicked.self, on: panel) { world, trigger in","    let name = world[Name.self, of: trigger.originalEntity].value","    world.resources[ClickLog.self].entries.append(\"Panel saw a click on \\(name)\")","}","","world.trigger(Clicked(), on: button)","print(world.resources[ClickLog.self].entries)","\/\/ Prints \"[\"Panel saw a click on OK\"]\""],"type":"codeListing","syntax":"swift"},{"type":"paragraph","inlineContent":[{"type":"text","text":"An observer can stop an event from going further by setting the trigger’s"},{"type":"text","text":" "},{"type":"reference","identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/Trigger\/propagates","isActive":true},{"type":"text","text":" property to "},{"type":"codeVoice","code":"false"},{"type":"text","text":"."}]}]}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/worldmodule\/entityevent"]}],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/WorldModule\/documentation\/WorldModule\/EntityEvent"},"metadata":{"remoteSource":{"fileName":"Observers.swift","url":"https:\/\/github.com\/Tyler-Keith-Thompson\/ECS\/blob\/main\/Sources\/WorldModule\/Observers.swift#L58"},"symbolKind":"protocol","fragments":[{"text":"protocol","kind":"keyword"},{"text":" ","kind":"text"},{"kind":"identifier","text":"Entity