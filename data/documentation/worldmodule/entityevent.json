to clicks on any of its buttons:","type":"text"}]},{"type":"codeListing","syntax":"swift","code":["struct Clicked: EntityEvent {","    static var propagates: Bool { true }","}","struct ClickLog: Resource { var entries: [String] = [] }","","var world = World()","world.resources.insert(ClickLog())","let panel = world.spawn(Name(value: \"Panel\"))","let button = world.spawn(Name(value: \"OK\"))","try world.addChild(button, to: panel)","","world.observe(Clicked.self, on: panel) { world, trigger in","    let name = world[Name.self, of: trigger.originalEntity].value","    world.resources[ClickLog.self].entries.append(\"Panel saw a click on \\(name)\")","}","","world.trigger(Clicked(), on: button)","print(world.resources[ClickLog.self].entries)","\/\/ Prints \"[\"Panel saw a click on OK\"]\""]},{"type":"paragraph","inlineContent":[{"type":"text","text":"An observer can stop an event from going further by setting the trigger’s"},{"type":"text","text":" "},{"type":"reference","identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/Trigger\/propagates","isActive":true},{"type":"text","text":" property to "},{"code":"false","type":"codeVoice"},{"type":"text","text":"."}]}]}],"schemaVersion":{"major":0,"minor":3,"patch":0},"sections":[],"abstract":[{"type":"text","text":"A type that describes something that happens to a particular entity, which its observers"},{"type":"text","text":" "},{"type":"text","text":"respond to at once."}],"hierarchy":{"paths":[["doc:\/\/WorldModule\/documentation\/WorldModule"]]},"identifier":{"url":"doc:\/\/WorldModule\/documentation\/WorldModule\/EntityEvent","interfaceLanguage":"swift"},"topicSections":[{"generated":true,"identifiers":["doc:\/\/WorldModule\/documentation\/WorldModule\/EntityEvent\/propagates"],"anchor":"Type-Properties","title":"Type Properties"}],"seeAlsoSections":[{"anchor":"Reacting-to-Changes-with-Hooks-and-Observers","identifiers":["doc:\/\/WorldModule\/documentation\/WorldModule\/Trigger"],"generated":true,"title":"Rea