{"abstract":[{"text":"A type that describes something that happens to a particular entity, which its observers","type":"text"},{"text":" ","type":"text"},{"text":"respond to at once.","type":"text"}],"relationshipsSections":[{"type":"inheritsFrom","kind":"relationships","title":"Inherits From","identifiers":["doc:\/\/WorldModule\/s8SendableP","doc:\/\/WorldModule\/s16SendableMetatypeP"]}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/worldmodule\/entityevent"]}],"kind":"symbol","identifier":{"interfaceLanguage":"swift","url":"doc:\/\/WorldModule\/documentation\/WorldModule\/EntityEvent"},"schemaVersion":{"major":0,"minor":3,"patch":0},"topicSections":[{"generated":true,"title":"Type Properties","identifiers":["doc:\/\/WorldModule\/documentation\/WorldModule\/EntityEvent\/propagates"],"anchor":"Type-Properties"}],"metadata":{"symbolKind":"protocol","fragments":[{"kind":"keyword","text":"protocol"},{"kind":"text","text":" "},{"kind":"identifier","text":"EntityEvent"}],"role":"symbol","roleHeading":"Protocol","remoteSource":{"fileName":"Observers.swift","url":"https:\/\/github.com\/Tyler-Keith-Thompson\/ECS\/blob\/main\/Sources\/WorldModule\/Observers.swift#L58"},"navigatorTitle":[{"kind":"identifier","text":"EntityEvent"}],"modules":[{"name":"WorldModule"}],"externalID":"s:11WorldModule11EntityEventP","title":"EntityEvent"},"primaryContentSections":[{"kind":"declarations","declarations":[{"languages":["swift"],"platforms":["Linux"],"tokens":[{"kind":"keyword","text":"protocol"},{"kind":"text","text":" "},{"kind":"identifier","text":"EntityEvent"},{"kind":"text","text":" : "},{"preciseIdentifier":"s:s8SendableP","kind":"typeIdentifier","text":"Sendable"}]}]},{"kind":"content","content":[{"type":"heading","anchor":"overview","level":2,"text":"Overview"},{"type":"paragraph","inlineContent":[{"text":"Use an entity event when one part of a program needs to tell an entity that something","type":"text"},{"text":" ","type":"text"},{"text":"happened to it, and other parts need to respond right away: a barrel is hit, a button is","type":"text"},{"text":" ","type":"text"},{"text":"clicked. Declare the event as a type that conforms to ","type":"text"},{"code":"EntityEvent","type":"codeVoice"},{"text":", register observers with","type":"text"},{"text":" ","type":"text"},{"identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/World\/observe(_:on:perform:)","isActive":true,"type":"reference"},{"text":" or ","type":"text"},{"identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/World\/observe(_:perform:)","isActive":true,"type":"reference"},{"text":", and trigger it with","type":"text"},{"text":" ","type":"text"},{"identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/World\/trigger(_:on:)","isActive":true,"type":"reference"},{"text":". The observers run before ","type":"text"},{"code":"trigger(_:on:)","type":"codeVoice"},{"text":" returns.","type":"text"}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"The following example despawns a barrel when it explodes:"}]},{"type":"codeListing","syntax":"swift","code":["struct Explode: EntityEvent { var radius: Double }","","var world = World()","let barrel = world.spawn(Name(value: \"Barrel\"))","world.observe(Explode.self, on: barrel) { world, trigger in","    world.despawn(trigger.entity)","}","","world.trigger(Explode(radius: 3), on: barrel)","print(world.contains(barrel))","\/\/ Prints \"false\""]},{"type":"paragraph","inlineContent":[{"type":"text","text":"An entity event differs from an "},{"identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/Event","isActive":true,"type":"reference"},{"type":"text","text":", which waits in a queue until systems read it."}]},{"type":"heading","anchor":"Propagating-Up-the-Hierarchy","level":3,"text":"Propagating Up the Hierarchy"},{"type":"paragraph","inlineContent":[{"text":"An event whose ","type":"text"},{"identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/EntityEvent\/propagates","isActive":true,"type":"reference"},{"text":" property is ","type":"text"},{"code":"true","type":"codeVoice"},{"text":" moves on to the entity’s parent","type":"text"},{"text":" ","type":"text"},{"text":"(","type":"text"},{"identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/ChildOf","isActive":true,"type":"reference"},{"text":") after the entity’s observers run, then to that entity’s parent, and so on up to","type":"text"},{"text":" ","type":"text"},{"text":"the root. The following example lets a panel respond to clicks on any of its buttons:","type":"text"}]},{"type":"codeListing","syntax":"swift","code":["struct Clicked: EntityEvent {","    static var propagates: Bool { true }","}","struct ClickLog: Resource { var entries: [String] = [] }","","var world = World()","world.resources.insert(ClickLog())","let panel = world.spawn(Name(value: \"Panel\"))","let button = world.spawn(Name(value: \"OK\"))","try world.addChild(button, to: panel)","","world.observe(Clicked.self, on: panel) { world, trigger in","    let name = world[Name.self, of: trigger.originalEntity].value","    world.resources[ClickLog.self].entries.append(\"Panel saw a click on \\(name)\")","}","","world.trigger(Clicked(), on: button)","print(world.resources[ClickLog.self].entries)","\/\/ Prints \"[\"Panel saw a click on OK\"]\""]},{"type":"paragraph","inlineContent":[{"type":"text","text":"An observer can stop an event from going further by setting the trigger’s"},{"type":"text","text":" "},{"identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/Trigger\/propagates","type":"reference","isActive":true},{"type":"text","text":" property to "},{"type":"codeVoice","code":"false"},{"type":"text","text":"."}]}]}],"sections":[],"hierarchy":{"paths":[["doc:\/\/WorldModule\/documentation\/WorldModule"]]},"seeAlsoSections":[{"generated":true,"title":"Reacting to Changes with Hooks and Observers","identifiers":["doc:\/\/WorldModule\/documentation\/WorldModule\/Trigger"],"anchor":"Rea