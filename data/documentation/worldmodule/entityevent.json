{"abstract":[{"type":"text","text":"A type that describes something that happens to a particular entity, which its observers"},{"type":"text","text":" "},{"type":"text","text":"respond to at once."}],"topicSections":[{"identifiers":["doc:\/\/WorldModule\/documentation\/WorldModule\/EntityEvent\/propagates"],"generated":true,"title":"Type Properties","anchor":"Type-Properties"}],"sections":[],"identifier":{"url":"doc:\/\/WorldModule\/documentation\/WorldModule\/EntityEvent","interfaceLanguage":"swift"},"hierarchy":{"paths":[["doc:\/\/WorldModule\/documentation\/WorldModule"]]},"seeAlsoSections":[{"identifiers":["doc:\/\/WorldModule\/documentation\/WorldModule\/Trigger"],"generated":true,"title":"Reacting to Changes with Hooks and Observers","anchor":"Reacting-to-Changes-with-Hooks-and-Observers"}],"kind":"symbol","relationshipsSections":[{"identifiers":["doc:\/\/WorldModule\/s8SendableP","doc:\/\/WorldModule\/s16SendableMetatypeP"],"title":"Inherits From","type":"inheritsFrom","kind":"relationships"}],"primaryContentSections":[{"kind":"declarations","declarations":[{"platforms":["Linux"],"tokens":[{"text":"protocol","kind":"keyword"},{"text":" ","kind":"text"},{"text":"EntityEvent","kind":"identifier"},{"text":" : ","kind":"text"},{"preciseIdentifier":"s:s8SendableP","text":"Sendable","kind":"typeIdentifier"}],"languages":["swift"]}]},{"mentions":["doc:\/\/WorldModule\/documentation\/WorldModule\/ReactingToChanges","doc:\/\/WorldModule\/documentation\/WorldModule\/RelatingEntities"],"kind":"mentions"},{"content":[{"anchor":"overview","text":"Overview","level":2,"type":"heading"},{"type":"paragraph","inlineContent":[{"text":"Use an entity event when one part of a program needs to tell an entity that something","type":"text"},{"text":" ","type":"text"},{"text":"happened to it, and other parts need to respond right away: a barrel is hit, a button is","type":"text"},{"text":" ","type":"text"},{"text":"clicked. Declare the event as a type that conforms to ","type":"text"},{"type":"codeVoice","code":"EntityEvent"},{"text":", register observers with","type":"text"},{"text":" ","type":"text"},{"identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/World\/observe(_:on:perform:)","isActive":true,"type":"reference"},{"text":" or ","type":"text"},{"identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/World\/observe(_:perform:)","isActive":true,"type":"reference"},{"text":", and trigger it with","type":"text"},{"text":" ","type":"text"},{"identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/World\/trigger(_:on:)","isActive":true,"type":"reference"},{"text":". The observers run before ","type":"text"},{"type":"codeVoice","code":"trigger(_:on:)"},{"text":" returns.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"The following example despawns a barrel when it explodes:","type":"text"}]},{"syntax":"swift","code":["struct Explode: EntityEvent { var radius: Double }","","var world = World()","let barrel = world.spawn(Name(value: \"Barrel\"))","world.observe(Explode.self, on: barrel) { world, trigger in","    world.despawn(trigger.entity)","}","","world.trigger(Explode(radius: 3), on: barrel)","print(world.contains(barrel))","\/\/ Prints \"false\""],"type":"codeListing"},{"type":"paragraph","inlineContent":[{"type":"text","text":"An entity event differs from an "},{"identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/Event","type":"reference","isActive":true},{"type":"text","text":", which waits in a queue until systems read it."}]},{"anchor":"Propagating-Up-the-Hierarchy","text":"Propagating Up the Hierarchy","level":3,"type":"heading"},{"type":"paragraph","inlineContent":[{"text":"An event whose ","type":"text"},{"isActive":true,"identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/EntityEvent\/propagates","type":"reference"},{"text":" property is ","type":"text"},{"code":"true","type":"codeVoice"},{"text":" moves on to the entity’s parent","type":"text"},{"text":" ","type":"text"},{"text":"(","type":"text"},{"isActive":true,"identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/ChildOf","type":"reference"},{"text":") after the entity’s observers run, then to that entity’s parent, and so on up to","type":"text"},{"text":" ","type":"text"},{"text":"the root. The following example lets a panel respond to clicks on any of its buttons:","type":"text"}]},{"syntax":"swift","code":["struct Clicked: EntityEvent {","    static var propagates: Bool { true }","}","struct ClickLog: Resource { var entries: [String] = [] }","","var world = World()","world.resources.insert(ClickLog())","let panel = world.spawn(Name(value: \"Panel\"))","let button = world.spawn(Name(value: \"OK\"))","try world.addChild(button, to: panel)","","world.observe(Clicked.self, on: panel) { world, trigger in","    let name = world[Name.self, of: trigger.originalEntity].value","    world.resources[ClickLog.self].entries.append(\"Panel saw a click on \\(name)\")","}","","world.trigger(Clicked(), on: button)","print(world.resources[ClickLog.self].entries)","\/\/ Prints \"[\"Panel saw a click on OK\"]\""],"type":"codeListing"},{"type":"paragraph","inlineContent":[{"text":"An observer can stop an event from going further by setting the trigger’s","type":"text"},{"text":" ","type":"text"},{"isActive":true,"identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/Trigger\/propagates","type":"reference"},{"text":" property to ","type":"text"},{"code":"false","type":"codeVoice"},{"text":".","type":"text"}]}],"kind":"content"}],"metadata":{"role":"symbol","modules":[{"name":"WorldModule"}],"fragments":[{"text":"protocol","kind":"keyword"},{"text":" ","kind":"text"},{"text":"EntityEvent","kind":"identifier"}],"navigatorTitle":[{"text":"EntityEvent","kind":"identifier"}],"symbolKind":"protocol","externalID":"s:11WorldModule11EntityEventP","roleHeading":"Protocol","remoteSource":{"url":"https:\/\/github.com\/Tyler-Keith-Thompson\/ECS\/blob\/main\/Sources\/WorldModule\/Observers.swift#L