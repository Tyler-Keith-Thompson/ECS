{"metadata":{"role":"symbol","modules":[{"name":"WorldModule"}],"externalID":"s:11WorldModule11EntityEventP","roleHeading":"Protocol","navigatorTitle":[{"kind":"identifier","text":"EntityEvent"}],"remoteSource":{"url":"https:\/\/github.com\/Tyler-Keith-Thompson\/ECS\/blob\/main\/Sources\/WorldModule\/Observers.swift#L58","fileName":"Observers.swift"},"symbolKind":"protocol","title":"EntityEvent","fragments":[{"text":"protocol","kind":"keyword"},{"text":" ","kind":"text"},{"text":"EntityEvent","kind":"identifier"}]},"identifier":{"url":"doc:\/\/WorldModule\/documentation\/WorldModule\/EntityEvent","interfaceLanguage":"swift"},"abstract":[{"type":"text","text":"A type that describes something that happens to a particular entity, which its observers"},{"type":"text","text":" "},{"type":"text","text":"respond to at once."}],"kind":"symbol","schemaVersion":{"major":0,"minor":3,"patch":0},"relationshipsSections":[{"identifiers":["doc:\/\/WorldModule\/s8SendableP","doc:\/\/WorldModule\/s16SendableMetatypeP"],"kind":"relationships","type":"inheritsFrom","title":"Inherits From"}],"primaryContentSections":[{"declarations":[{"platforms":["Linux"],"languages":["swift"],"tokens":[{"kind":"keyword","text":"protocol"},{"kind":"text","text":" "},{"kind":"identifier","text":"EntityEvent"},{"kind":"text","text":" : "},{"kind":"typeIdentifier","preciseIdentifier":"s:s8SendableP","text":"Sendable"}]}],"kind":"declarations"},{"kind":"content","content":[{"level":2,"type":"heading","anchor":"overview","text":"Overview"},{"inlineContent":[{"type":"text","text":"Use an entity event when one part of a program needs to tell an entity that something"},{"type":"text","text":" "},{"type":"text","text":"happened to it, and other parts need to respond right away: a barrel is hit, a button is"},{"type":"text","text":" "},{"type":"text","text":"clicked. Declare the event as a type that conforms to "},{"code":"EntityEvent","type":"codeVoice"},{"type":"text","text":", register observers with"},{"type":"text","text":" "},{"identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/World\/observe(_:on:perform:)","isActive":true,"type":"reference"},{"type":"text","text":" or "},{"identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/World\/observe(_:perform:)","isActive":true,"type":"reference"},{"type":"text","text":", and trigger it with"},{"type":"text","text":" "},{"identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/World\/trigger(_:on:)","isActive":true,"type":"reference"},{"type":"text","text":". The observers run before "},{"code":"trigger(_:on:)","type":"codeVoice"},{"type":"text","text":" returns."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"The following example despawns a barrel when it explodes:"}],"type":"paragraph"},{"code":["struct Explode: EntityEvent { var radius: Double }","","var world = World()","let barrel = world.spawn(Name(value: \"Barrel\"))","world.observe(Explode.self, on: barrel) { world, trigger in","    world.despawn(trigger.entity)","}","","world.trigger(Explode(radius: 3), on: barrel)","print(world.contains(barrel))","\/\/ Prints \"false\""],"type":"codeListing","syntax":"swift"},{"inlineContent":[{"type":"text","text":"An entity event differs from an "},{"identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/Event","type":"reference","isActive":true},{"type":"text","text":", which waits in a queue until systems read it."}],"type":"paragraph"},{"level":3,"type":"heading","anchor":"Propagating-Up-the-Hierarchy","text":"Propagating Up the Hierarchy"},{"inlineContent":[{"type":"text","text":"An event whose "},{"type":"reference","identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/EntityEvent\/propagates","isActive":true},{"type":"text","text":" property is "},{"type":"codeVoice","code":"true"},{"type":"text","text":" moves on to the entity’s parent"},{"type":"text","text":" "},{"type":"text","text":"("},{"type":"reference","identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/ChildOf","isActive":true},{"type":"text","text":") after the entity’s observers run, then to that entity’s parent, and so on up to"},{"type":"text","text":" "},{"type":"text","text":"the root. The following example lets a panel respond to clicks on any of its buttons:"}],"type":"paragraph"},{"code":["struct Clicked: EntityEvent {","    static var propagates: Bool { true }","}","struct ClickLog: Resource { var entries: [String] = [] }","","var world = World()","world.resources.insert(ClickLog())","let panel = world.spawn(Name(value: \"Panel\"))","let button = world.spawn(Name(value: \"OK\"))","try world.addChild(button, to: panel)","","world.observe(Clicked.self, on: panel) { world, trigger in","    let name = world[Name.self, of: trigger.originalEntity].value","    world.resources[ClickLog.self].entries.append(\"Panel saw a click on \\(name)\")","}","","world.trigger(Clicked(), on: button)","print(world.resources[ClickLog.self].entries)","\/\/ Prints \"[\"Panel saw a click on OK\"]\""],"type":"codeListing","syntax":"swift"},{"inlineContent":[{"type":"text","text":"An observer can stop an event from going further by setting the trigger’s"},{"type":"text","text":" "},{"type":"reference","isActive":true,"identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/Trigger\/propagates"},{"type":"text","text":" property to "},{"code":"false","type":"codeVoice"},{"type":"text","text":"."}],"type":"paragraph"}]}],"topicSections":[{"identifiers":["doc:\/\/WorldModule\/documentation\/WorldModule\/EntityEvent\/propagates"],"anchor":"Type-Properties","generated":true,"title":"Type Properties"}],"seeAlsoSections":[{"identifiers":["doc:\/\/WorldModule\/documentation\/WorldModule\/Trigger"],"anchor":"Reacting-to-Changes-with-Hooks-and-Observers","generated":true,"title":"Reacting to Changes with Hooks and Observers"}],"sections":[],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/worldmodule\/entityevent"]}],"hierarchy":{"paths":[["doc:\/\