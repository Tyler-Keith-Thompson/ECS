:", register them with"},{"type":"text","text":" "},{"type":"reference","isActive":true,"identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/World\/registerDisablingComponent(_:)"},{"type":"text","text":"."}],"type":"paragraph"}]}],"topicSections":[{"generated":true,"anchor":"Initializers","title":"Initializers","identifiers":["doc:\/\/WorldModule\/documentation\/WorldModule\/Disabled\/init()"]},{"generated":true,"anchor":"Default-Implementations","title":"Default Implementations","identifiers":["doc:\/\/WorldModule\/documentation\/WorldModule\/Disabled\/Bundle-Implementations","doc:\/\/WorldModule\/documentation\/WorldModule\/Disabled\/Component-Implementations","doc:\/\/WorldModule\/documentation\/WorldModule\/Disabled\/Equatable-Implementations"]}],"seeAlsoSections":[{"generated":true,"anchor":"Disabling-Entities-and-Using-Prefabs","title":"Disabling Entities and Using Prefabs","identifiers":["doc:\/\/WorldModule\/documentation\/WorldModule\/DisablingEntitiesAndUsingPrefabs","doc:\/\/WorldModule\/documentation\/WorldModule\/Prefab"]}],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/WorldModule\/documentation\/WorldModule\/Disabled"},"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/worldmodule\/disabled"]}],"schemaVersion":{"major":0,"minor":3,"patch":0},"kind":"symbol","abstract":[{"type":"text","text":"A component that makes queries and updates skip an entity, unless they ask for it."}],"relationshipsSections":[{"type":"conformsTo","kind":"relationships","title":"Conforms To","identifiers":["doc:\/\/WorldModule\/documentation\/WorldModule\/Bundle","doc:\/\/WorldModule\/documentation\/WorldModule\/Component","doc:\/\/WorldModule\/documentation\/WorldModule\/QueryTerm","doc:\/\/WorldModule\/s15BitwiseCopyableP","doc:\/\/WorldModule\/SQ","doc:\/\/WorldModule\/SH","doc:\/\/WorldModule\/s8SendableP","doc:\/\/WorldModule\/s16SendableMetatypeP"]}],"sections":[],"metadata":{"externalID":"s:11WorldModule8DisabledV","role