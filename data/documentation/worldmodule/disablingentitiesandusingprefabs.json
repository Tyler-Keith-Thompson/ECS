{"variants":[{"paths":["\/documentation\/worldmodule\/disablingentitiesandusingprefabs"],"traits":[{"interfaceLanguage":"swift"}]}],"sections":[],"schemaVersion":{"minor":3,"major":0,"patch":0},"hierarchy":{"paths":[["doc:\/\/WorldModule\/documentation\/WorldModule"]]},"seeAlsoSections":[{"identifiers":["doc:\/\/WorldModule\/documentation\/WorldModule\/Disabled","doc:\/\/WorldModule\/documentation\/WorldModule\/Prefab"],"title":"Disabling Entities and Using Prefabs","generated":true,"anchor":"Disabling-Entities-and-Using-Prefabs"}],"kind":"article","metadata":{"role":"article","roleHeading":"Article","modules":[{"name":"WorldModule"}],"title":"Disabling Entities and Using Prefabs"},"primaryContentSections":[{"kind":"content","content":[{"level":2,"text":"Overview","type":"heading","anchor":"Overview"},{"inlineContent":[{"type":"text","text":"A game often keeps entities that shouldn’t take part in a step: an enemy waiting off screen, or"},{"type":"text","text":" "},{"type":"text","text":"the template every goblin is copied from. A world hides those entities from queries and updates"},{"type":"text","text":" "},{"type":"text","text":"while keeping their components, and it can copy any entity into a new one."}],"type":"paragraph"},{"level":3,"text":"Disable an Entity","type":"heading","anchor":"Disable-an-Entity"},{"inlineContent":[{"type":"text","text":"Insert "},{"type":"reference","isActive":true,"identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/Disabled"},{"type":"text","text":" into an entity to hide it from queries and updates. The entity stays live and"},{"type":"text","text":" "},{"type":"text","text":"keeps its components, and reading it through its handle still works. A query or update reaches it"},{"type":"text","text":" "},{"type":"text","text":"only when it reads or writes "},{"type":"codeVoice","code":"Disabled"},{"type":"text","text":", names it in a filter, or allows it with"},{"type":"text","text":" "},{"type":"codeVoice","code":".allowing(Disabled.self)"},{"type":"text","text":". Remove the mark to bring the entity back."}],"type":"paragraph"},{"inlineContent":[{"text":"To make your own component types hide entities the same way, register them with","type":"text"},{"text":" ","type":"text"},{"type":"reference","identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/World\/registerDisablingComponent(_:)","isActive":true},{"text":".","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"Disabling hides an entity from queries and updates only. The world’s ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/World\/count"},{"text":",","type":"text"},{"text":" ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/World\/entities"},{"text":" and the spans of ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/World\/withSpan(of:_:)"},{"text":" still include it.","type":"text"}],"type":"paragraph"},{"level":3,"text":"Clone an Entity","type":"heading","anchor":"Clone-an-Entity"},{"inlineContent":[{"identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/World\/clone(_:)","type":"reference","isActive":true},{"type":"text","text":" spawns a new entity holding a copy of every component of another. The copies"},{"type":"text","text":" "},{"type":"text","text":"are new components, so they count as added and fire add and insert hooks. A clone keeps the"},{"type":"text","text":" "},{"type":"text","text":"original’s relations, so a clone of a child is its sibling, but the original’s children aren’t"},{"type":"text","text":" "},{"type":"text","text":"cloned."}],"type":"paragraph"},{"level":3,"text":"Spawn from a Prefab","type":"heading","anchor":"Spawn-from-a-Prefab"},{"inlineContent":[{"text":"A ","type":"text"},{"type":"emphasis","inlineContent":[{"text":"prefab","type":"text"}]},{"text":" is an entity marked with ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/Prefab"},{"text":" that holds a ready-made set of components. Queries","type":"text"},{"text":" ","type":"text"},{"text":"and updates skip it, as they skip disabled entities, so the template never moves or takes damage","type":"text"},{"text":" ","type":"text"},{"text":"along with its copies. ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/World\/spawn(from:)"},{"text":" copies a prefab without its mark, so the new entity","type":"text"},{"text":" ","type":"text"},{"text":"takes part like any other.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/Commands","type":"reference","isActive":true},{"text":" record clones and spawns from prefabs too, so a system can spawn copies during a","type":"text"},{"text":" ","type":"text"},{"text":"step. The following example spawns two goblins from a prefab through commands:","type":"text"}],"type":"paragraph"},{"code":["var world = World()","let goblin = world.spawn(Prefab(), Name(value: \"goblin\"), Health(current: 10))","","var commands = Commands()","commands.spawn(from: goblin)","commands.spawn(from: goblin)","world.apply(commands)","","print(world.query(Name.self).count)","\/\/ Prints \"2\"","print(world.count)","\/\/ Prints \"3\""],"type":"codeListing","syntax":"swift"},{"inlineContent":[{"type":"text","text":"To keep a prefab outside any world, such as in a file, save it as a "},{"type":"reference","identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/Scene","isActive":true},{"type":"text","text":" and spawn its"},{"type":"text","text":" "},{"type":"text","text":"entities into a world with "},{"code":"spawn(contentsOf:)","type":"codeVoice"},{"type":"text","text":"; see "},{"type":"reference","identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/SavingAndLoadingWorlds","isActive":true},{"type":"text","text":"."}],"type":"paragraph"}]}],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/WorldModule\/documentation\/WorldModule\/DisablingEntitiesAndUsingPrefabs"},"abstract":[{"type":"text","text":"Take entities out of play without despawning them, and spawn copies of entities and templates."}],"references":{"doc://WorldModule/documentation/WorldModule/Disabled":{"navigatorTitle":[{"text":"Disabled","kind":"identifier"}],"abstract":[{"type":"text","text":"A component that makes queries and updates skip an entity, unless they ask for it."}],"role":"symbol","type":"topic","kind":"symbol","identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/Disabled","url":"\/documentation\/worldmodule\/disabled","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Disabled","kind":"identifier"}],"title":"Disabled"},"doc://WorldModule/documentation/WorldModule/World/registerDisablingComponent(_:)":{"url":"\/documentation\/worldmodule\/world\/registerdisablingcomponent(_:)","role":"symbol","identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/World\/registerDisablingComponent(_:)","kind":"symbol","abstract":[{"type":"text","text":"Makes queries and updates skip the entities holding a component of the given type, as"},{"type":"text","text":" "},{"type":"text","text":"they skip "},{"identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/Disabled","type":"reference","isActive":true},{"type":"text","text":" entities."}],"fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"kind":"identifier","text":"registerDisablingComponent"},{"kind":"text","text":"<"},{"kind":"genericParameter","text":"C"},{"kind":"text","text":">("},{"kind":"typeIdentifier","text":"C"},{"kind":"text","text":".Type)"}],"type":"topic","title":"registerDisablingComponent(_:)"},"doc://WorldModule/documentation/WorldModule/Prefab":{"navigatorTitle":[{"text":"Prefab","kind":"identifier"}],"a