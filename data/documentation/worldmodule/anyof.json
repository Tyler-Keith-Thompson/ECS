,"type":"heading","text":"Overview","level":2},{"type":"paragraph","inlineContent":[{"type":"text","text":"As a term of a "},{"type":"reference","identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/Query","isActive":true},{"type":"text","text":", "},{"type":"codeVoice","code":"AnyOf"},{"type":"text","text":" of component types matches the entities that hold at least"},{"type":"text","text":" "},{"type":"text","text":"one of the types, and reads a tuple with one optional per type: the entity’s component, or"},{"type":"text","text":" "},{"type":"codeVoice","code":"nil"},{"type":"text","text":" where the entity lacks that type. Use it to visit entities that may carry any of several"},{"type":"text","text":" "},{"type":"text","text":"related components:"}]},{"syntax":"swift","type":"codeListing","code":["var world = World()","world.spawn(Name(value: \"frozen comet\"), Velocity(dx: 4, dy: 0), Frozen())","world.spawn(Name(value: \"comet\"), Velocity(dx: 2, dy: 0))","world.spawn(Name(value: \"ice\"), Frozen())","world.spawn(Name(value: \"rock\"))","","var descriptions: [String] = []","for (_, name, (velocity, frozen)) in world.query(Query(Name.self, AnyOf<Velocity, Frozen>.self)) {","    let state = frozen == nil ? \"moving at \\(velocity?.dx ?? 0)\" : \"frozen\"","    descriptions.append(\"\\(name.value) is \\(state)\")","}","print(descriptions)","\/\/ Prints \"[\"frozen comet is frozen\", \"comet is moving at 2.0\", \"ice is frozen\"]\""]},{"type":"paragraph","inlineContent":[{"type":"text","text":"The rock holds neither type, so the query skips it."}]},{"type":"paragraph","inlineContent":[{"text":"As a filter type of a system’s query (","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/Query\/Where"},{"text":"), ","type":"text"},{"type":"codeVoice","code":"AnyOf"},{"text":" of filter types passes the","type":"text"},{"text":" ","type":"text"},{"text":"entities that pass at least one of them: ","ty