 \\(state)\")","}","print(descriptions)","\/\/ Prints \"[\"frozen comet is frozen\", \"comet is moving at 2.0\", \"ice is frozen\"]\""],"syntax":"swift"},{"inlineContent":[{"text":"The rock holds neither type, so the query skips it.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"As a filter type of a system’s query (","type":"text"},{"isActive":true,"identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/Query\/Where","type":"reference"},{"text":"), ","type":"text"},{"code":"AnyOf","type":"codeVoice"},{"text":" of filter types passes the","type":"text"},{"text":" ","type":"text"},{"text":"entities that pass at least one of them: ","type":"text"},{"code":"Query<Health>.Where<AnyOf<Changed<Health>, Without<Frozen>>>","type":"codeVoice"},{"text":" visits the entities whose health changed and the ones that aren’t frozen.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"Queries of one to three terms, with "},{"type":"codeVoice","code":"AnyOf"},{"type":"text","text":" groups of two to four types, run through code"},{"type":"text","text":" "},{"type":"text","text":"specialized for their exact shape."}],"type":"paragraph"}]}],"variants":[{"paths":["\/documentation\/worldmodule\/anyof"],"traits":[{"interfaceLanguage":"swift"}]}],"references":{"doc://WorldModule/s8CopyableP":{"type":"unresolvable","identifier":"doc:\/\/WorldModule\/s8CopyableP","title":"Swift.Copyable"},"doc://WorldModule/documentation/WorldModule":{"identifier":"doc:\/\/WorldModule\/documentation\/WorldModule","role":"collection","kind":"symbol","type":"topic","abstract":[{"type":"text","text":"Store the state of a game or simulation as entities and components, and read and change it with"},{"type":"text","text":" "},{"type":"text","text":"queries, updates, and commands."}],"url":"\/documentation\/worldmodule","title":"WorldModule"},"doc://WorldModule/documentation/WorldModule/QueryRow":{"role":"symbol","type":"topic","abstract":[{"text":"An entity an upda