{"identifier":{"url":"doc:\/\/WorldModule\/documentation\/WorldModule\/AnyOf","interfaceLanguage":"swift"},"metadata":{"role":"symbol","externalID":"s:11WorldModule5AnyOfV","remoteSource":{"fileName":"QueryTerm.swift","url":"https:\/\/github.com\/Tyler-Keith-Thompson\/ECS\/blob\/main\/Sources\/WorldModule\/QueryTerm.swift#L112"},"symbolKind":"struct","title":"AnyOf","navigatorTitle":[{"kind":"identifier","text":"AnyOf"}],"modules":[{"name":"WorldModule"}],"fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"AnyOf"}],"roleHeading":"Structure"},"sections":[],"kind":"symbol","hierarchy":{"paths":[["doc:\/\/WorldModule\/documentation\/WorldModule"]]},"schemaVersion":{"patch":0,"major":0,"minor":3},"relationshipsSections":[{"type":"conformsTo","kind":"relationships","identifiers":["doc:\/\/WorldModule\/documentation\/WorldModule\/FilterTerm","doc:\/\/WorldModule\/documentation\/WorldModule\/QueryTerm","doc:\/\/WorldModule\/s15BitwiseCopyableP","doc:\/\/WorldModule\/s8CopyableP","doc:\/\/WorldModule\/s9EscapableP","doc:\/\/WorldModule\/s8SendableP","doc:\/\/WorldModule\/s16SendableMetatypeP"],"title":"Conforms To"}],"topicSections":[{"generated":true,"identifiers":["doc:\/\/WorldModule\/documentation\/WorldModule\/AnyOf\/FilterTerm-Implementations","doc:\/\/WorldModule\/documentation\/WorldModule\/AnyOf\/QueryTerm-Implementations"],"anchor":"Default-Implementations","title":"Default Implementations"}],"seeAlsoSections":[{"generated":true,"identifiers":["doc:\/\/WorldModule\/documentation\/WorldModule\/QueryingAWorld","doc:\/\/WorldModule\/documentation\/WorldModule\/Query","doc:\/\/WorldModule\/documentation\/WorldModule\/QueryView","doc:\/\/WorldModule\/documentation\/WorldModule\/EntityQueryView","doc:\/\/WorldModule\/documentation\/WorldModule\/QueryRow","doc:\/\/WorldModule\/documentation\/WorldModule\/QueryTerm","doc:\/\/WorldModule\/documentation\/WorldModule\/EntitiesView"],"anchor":"Querying-and-Updating-Entities","title":"Querying and Updating Entities"}],"abstract":[{"type":"text","text":"A group of types an entity matches by matching at least one of them."}],"primaryContentSections":[{"declarations":[{"platforms":["Linux"],"languages":["swift"],"tokens":[{"kind":"attribute","text":"@frozen"},{"kind":"text","text":" "},{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"AnyOf"},{"kind":"text","text":"<each "},{"kind":"genericParameter","text":"C"},{"kind":"text","text":">"}]}],"kind":"declarations"},{"kind":"mentions","mentions":["doc:\/\/WorldModule\/documentation\/WorldModule\/QueryingAWorld"]},{"kind":"content","content":[{"type":"heading","level":2,"anchor":"overview","text":"Overview"},{"type":"paragraph","inlineContent":[{"text":"As a term of a ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/Query"},{"text":", ","type":"text"},{"type":"codeVoice","code":"AnyOf"},{"text":" of component types matches the entities that hold at least","type":"text"},{"text":" ","type":"text"},{"text":"one of the types, and reads a tuple with one optional per type: the entity’s component, or","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"nil"},{"text":" where the entity lacks that type. Use it to visit entities that may carry any of several","type":"text"},{"text":" ","type":"text"},{"text":"related components:","type":"text"}]},{"type":"codeListing","syntax":"swift","code":["var world = World()","world.spawn(Name(value: \"frozen comet\"), Velocity(dx: 4, dy: 0), Frozen())","world.spawn(Name(value: \"comet\"), Velocity(dx: 2, dy: 0))","world.spawn(Name(value: \"ice\"), Frozen())","world.spawn(Name(value: \"rock\"))","","var descriptions: [String] = []","for (_, name, (velocity, frozen)) in world.query(Query(Name.self, AnyOf<Velocity, Frozen>.self)) {","    let state = frozen == nil ? \"moving at \\(velocity?.dx ?? 0)\" : \"frozen\"","    descriptions.append(\"\\(name.value) is \\(state)\")","}","print(descriptions)","\/\/ Prints \"[\"frozen comet is frozen\", \"comet is moving at 2.0\", \"ice is frozen\"]\""]},{"type":"paragraph","inlineContent":[{"text":"The rock holds neither type, so the query skips it.","type":"text"}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"As a filter type of a system’s query ("},{"identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/Query\/Where","isActive":true,"type":"reference"},{"type":"text","text":"), "},{"code":"AnyOf","type":"codeVoice"},{"type":"text","text":" of filter types passes the"},{"type":"text","text":" "},{"type":"text","text":"entities that pass at least one of them: "},{"code":"Query<Health>.Where<AnyOf<Changed<Health>, Without<Frozen>>>","type":"codeVoice"},{"type":"text","text":" visits the entities whose health changed and the ones that aren’t frozen."}]},{"type":"paragraph","inlineContent":[{"text":"Queries of one to three terms, with ","type":"text"},{"code":"AnyOf","type":"codeVoice"},{"text":" groups of two to four types, run through code","type":"text"},{"text":" ","type":"text"},{"text":"specialized for their exact shape.","type":"text"}]}]}],"variants":[{"paths":["\/documentation\/worldmodule\/anyof"],"traits":[{"interfaceLanguage":"swift"}]}],"references":{"doc://WorldModule/documentation/WorldModule/AnyOf/FilterTerm-Implementations":{"kind":"article","identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/AnyOf\/FilterTerm-Implementations","role":"collectionGroup","title":"FilterTerm Implementations","type":"topic","abstract":[],"url":"\/documentation\/worldmodule\/anyof\/filterterm-implementations"},"doc://WorldModule/s9EscapableP":{"identifier":"doc:\/\/WorldModule\/s9EscapableP","title":"Swift.Escapable","type":"unresolvable"},"doc://WorldModule/s16SendableMetatypeP":{"type":"unresolvable","identifier":"doc:\/\/WorldModule\/s16SendableMetatypeP","title":"Swift.SendableMetatype"},"doc://WorldModule/documentation/WorldModule/Fi