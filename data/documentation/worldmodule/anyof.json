{"identifier":{"url":"doc:\/\/WorldModule\/documentation\/WorldModule\/AnyOf","interfaceLanguage":"swift"},"abstract":[{"text":"A group of types an entity matches by matching at least one of them.","type":"text"}],"metadata":{"navigatorTitle":[{"text":"AnyOf","kind":"identifier"}],"fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"AnyOf","kind":"identifier"}],"remoteSource":{"fileName":"QueryTerm.swift","url":"https:\/\/github.com\/Tyler-Keith-Thompson\/ECS\/blob\/main\/Sources\/WorldModule\/QueryTerm.swift#L112"},"externalID":"s:11WorldModule5AnyOfV","title":"AnyOf","roleHeading":"Structure","role":"symbol","symbolKind":"struct","modules":[{"name":"WorldModule"}]},"hierarchy":{"paths":[["doc:\/\/WorldModule\/documentation\/WorldModule"]]},"seeAlsoSections":[{"anchor":"Querying-and-Updating-Entities","title":"Querying and Updating Entities","generated":true,"identifiers":["doc:\/\/WorldModule\/documentation\/WorldModule\/QueryingAWorld","doc:\/\/WorldModule\/documentation\/WorldModule\/Query","doc:\/\/WorldModule\/documentation\/WorldModule\/QueryView","doc:\/\/WorldModule\/documentation\/WorldModule\/EntityQueryView","doc:\/\/WorldModule\/documentation\/WorldModule\/QueryRow","doc:\/\/WorldModule\/documentation\/WorldModule\/QueryTerm","doc:\/\/WorldModule\/documentation\/WorldModule\/EntitiesView"]}],"relationshipsSections":[{"kind":"relationships","type":"conformsTo","title":"Conforms To","identifiers":["doc:\/\/WorldModule\/documentation\/WorldModule\/FilterTerm","doc:\/\/WorldModule\/documentation\/WorldModule\/QueryTerm","doc:\/\/WorldModule\/s15BitwiseCopyableP","doc:\/\/WorldModule\/s8CopyableP","doc:\/\/WorldModule\/s9EscapableP","doc:\/\/WorldModule\/s8SendableP","doc:\/\/WorldModule\/s16SendableMetatypeP"]}],"kind":"symbol","topicSections":[{"anchor":"Default-Implementations","title":"Default Implementations","generated":true,"identifiers":["doc:\/\/WorldModule\/documentation\/WorldModule\/AnyOf\/FilterTerm-Implementations