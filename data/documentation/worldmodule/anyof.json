{"sections":[],"hierarchy":{"paths":[["doc:\/\/WorldModule\/documentation\/WorldModule"]]},"abstract":[{"type":"text","text":"A group of types an entity matches by matching at least one of them."}],"metadata":{"title":"AnyOf","roleHeading":"Structure","symbolKind":"struct","externalID":"s:11WorldModule5AnyOfV","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"AnyOf","kind":"identifier"}],"role":"symbol","navigatorTitle":[{"kind":"identifier","text":"AnyOf"}],"remoteSource":{"url":"https:\/\/github.com\/Tyler-Keith-Thompson\/ECS\/blob\/main\/Sources\/WorldModule\/QueryTerm.swift#L112","fileName":"QueryTerm.swift"},"modules":[{"name":"WorldModule"}]},"topicSections":[{"generated":true,"anchor":"Default-Implementations","title":"Default Implementations","identifiers":["doc:\/\/WorldModule\/documentation\/WorldModule\/AnyOf\/FilterTerm-Implementations","doc:\/\/WorldModule\/documentation\/WorldModule\/AnyOf\/QueryTerm-Implementations"]}],"primaryContentSections":[{"declarations":[{"platforms":["Linux"],"languages":["swift"],"tokens":[{"text":"@frozen","kind":"attribute"},{"kind":"text","text":" "},{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"AnyOf"},{"kind":"text","text":"<each "},{"kind":"genericParameter","text":"C"},{"kind":"text","text":">"}]}],"kind":"declarations"},{"mentions":["doc:\/\/WorldModule\/documentation\/WorldModule\/QueryingAWorld"],"kind":"mentions"},{"content":[{"type":"heading","text":"Overview","level":2,"anchor":"overview"},{"type":"paragraph","inlineContent":[{"type":"text","text":"As a term of a "},{"type":"reference","isActive":true,"identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/Query"},{"type":"text","text":", "},{"type":"codeVoice","code":"AnyOf"},{"type":"text","text":" of component types matches the entities that hold at least"},{"type":"text","text":" "},{"type":"text","text":"one of the types, and reads a tuple with one optional per type: the entity’s component, or"},{"type":"text","text":" "},{"type":"codeVoice","code":"nil"},{"type":"text","text":" where the entity lacks that type. Use it to visit entities that may carry any of several"},{"type":"text","text":" "},{"type":"text","text":"related components:"}]},{"type":"codeListing","syntax":"swift","code":["var world = World()","world.spawn(Name(value: \"frozen comet\"), Velocity(dx: 4, dy: 0), Frozen())","world.spawn(Name(value: \"comet\"), Velocity(dx: 2, dy: 0))","world.spawn(Name(value: \"ice\"), Frozen())","world.spawn(Name(value: \"rock\"))","","var descriptions: [String] = []","for (_, name, (velocity, frozen)) in world.query(Query(Name.self, AnyOf<Velocity, Frozen>.self)) {","    let state = frozen == nil ? \"moving at \\(velocity?.dx ?? 0)\" : \"frozen\"","    descriptions.append(\"\\(name.value) is \\(state)\")","}","print(descriptions)","\/\/ Prints \"[\"frozen comet is frozen\", \"comet is moving at 2.0\", \"ice is frozen\"]\""]},{"type":"paragraph","inlineContent":[{"type":"text","text":"The rock holds neither type, so the query skips it."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"As a filter type of a system’s query ("},{"type":"reference","identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/Query\/Where","isActive":true},{"type":"text","text":"), "},{"type":"codeVoice","code":"AnyOf"},{"type":"text","text":" of filter types passes the"},{"type":"text","text":" "},{"type":"text","text":"entities that pass at least one of them: "},{"type":"codeVoice","code":"Query<Health>.Where<AnyOf<Changed<Health>, Without<Frozen>>>"},{"type":"text","text":" visits the entities whose health changed and the ones that aren’t frozen."}]},{"type":"paragraph","inlineContent":[{"text":"Queries of one to three terms, with ","type":"text"},{"code":"AnyOf","type":"codeVoice"},{"text":" groups of two to four types, run through code","type":"text"},{"text":" ","type":"text"},{"text":"specialized for their exact shape.","type":"text"}]}]