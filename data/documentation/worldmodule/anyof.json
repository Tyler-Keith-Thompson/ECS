ldModule\/documentation\/WorldModule\/QueryTerm","doc:\/\/WorldModule\/documentation\/WorldModule\/EntitiesView"],"generated":true}],"kind":"symbol","primaryContentSections":[{"kind":"declarations","declarations":[{"platforms":["Linux"],"languages":["swift"],"tokens":[{"text":"@frozen","kind":"attribute"},{"text":" ","kind":"text"},{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"AnyOf","kind":"identifier"},{"text":"<each ","kind":"text"},{"text":"C","kind":"genericParameter"},{"text":">","kind":"text"}]}]},{"kind":"mentions","mentions":["doc:\/\/WorldModule\/documentation\/WorldModule\/QueryingAWorld"]},{"kind":"content","content":[{"type":"heading","text":"Overview","anchor":"overview","level":2},{"type":"paragraph","inlineContent":[{"type":"text","text":"As a term of a "},{"identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/Query","type":"reference","isActive":true},{"type":"text","text":", "},{"type":"codeVoice","code":"AnyOf"},{"type":"text","text":" of component types matches the entities that hold at least"},{"type":"text","text":" "},{"type":"text","text":"one of the types, and reads a tuple with one optional per type: the entity’s component, or"},{"type":"text","text":" "},{"type":"codeVoice","code":"nil"},{"type":"text","text":" where the entity lacks that type. Use it to visit entities that may carry any of several"},{"type":"text","text":" "},{"type":"text","text":"related components:"}]},{"type":"codeListing","code":["var world = World()","world.spawn(Name(value: \"frozen comet\"), Velocity(dx: 4, dy: 0), Frozen())","world.spawn(Name(value: \"comet\"), Velocity(dx: 2, dy: 0))","world.spawn(Name(value: \"ice\"), Frozen())","world.spawn(Name(value: \"rock\"))","","var descriptions: [String] = []","for (_, name, (velocity, frozen)) in world.query(Query(Name.self, AnyOf<Velocity, Frozen>.self)) {","    let state = frozen == nil ? \"moving at \\(velocity?.dx ?? 0)\" : \"frozen\"","    descriptions.append(\"\\(name.value) is \\(state)\")","}","print(descriptions)","\/\/ Prints \"[\"frozen comet is frozen\", \"comet is moving at 2.0\", \"ice is frozen\"]\""],"syntax":"swift"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The rock holds neither type, so the query skips it."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"As a filter type of a system’s query ("},{"identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/Query\/Where","type":"reference","isActive":true},{"type":"text","text":"), "},{"type":"codeVoice","code":"AnyOf"},{"type":"text","text":" of filter types passes the"},{"type":"text","text":" "},{"type":"text","text":"entities that pass at least one of them: "},{"type":"codeVoice","code":"Query<Health>.Where<AnyOf<Changed<Health>, Without<Frozen>>>"},{"type":"text","text":" visits the entities whose health changed and the ones that aren’t frozen."}]},{"type":"paragraph","inlineContent":[{"text":"Queries of one to three terms, with ","type":"text"},{"code":"AnyOf","type":"codeVoice"},{"text":" groups of two to four types, run through code","type":"text"},{"text":" ","type":"text"},{"text":"specialized for their exact shape.","type":"text"}]}]}],"identifier":{"url":"doc:\/\/WorldModule\/documentation\/WorldModule\/AnyOf","interfaceLanguage":"swift"},"references":{"doc://WorldModule/documentation/WorldModule/Query":{"navigatorTitle":[{"text":"Query","kind":"identifier"}],"title":"Query","role":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Query","kind":"identifier"}],"url":"\/documentation\/worldmodule\/query","type":"topic","kind":"symbol","identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/Query","abstract":[{"text":"A description of the entities to visit and the components to read from each.","type":"text"}]},"doc://WorldModule/documentation/WorldModule/FilterTerm":{"navigatorTitle":[{"kind":"identifier","text":"FilterTerm"}],"kind":"symbol","type":"topic","title":"FilterTerm","abstra