{"metadata":{"navigatorTitle":[{"kind":"identifier","text":"AnyOf"}],"roleHeading":"Structure","symbolKind":"struct","externalID":"s:11WorldModule5AnyOfV","role":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"AnyOf"}],"remoteSource":{"fileName":"QueryTerm.swift","url":"https:\/\/github.com\/Tyler-Keith-Thompson\/ECS\/blob\/main\/Sources\/WorldModule\/QueryTerm.swift#L112"},"title":"AnyOf","modules":[{"name":"WorldModule"}]},"kind":"symbol","abstract":[{"type":"text","text":"A group of types an entity matches by matching at least one of them."}],"relationshipsSections":[{"kind":"relationships","title":"Conforms To","identifiers":["doc:\/\/WorldModule\/documentation\/WorldModule\/FilterTerm","doc:\/\/WorldModule\/documentation\/WorldModule\/QueryTerm","doc:\/\/WorldModule\/s15BitwiseCopyableP","doc:\/\/WorldModule\/s8CopyableP","doc:\/\/WorldModule\/s9EscapableP","doc:\/\/WorldModule\/s8SendableP","doc:\/\/WorldModule\/s16SendableMetatypeP"],"type":"conformsTo"}],"schemaVersion":{"minor":3,"major":0,"patch":0},"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/worldmodule\/anyof"]}],"primaryContentSections":[{"kind":"declarations","declarations":[{"tokens":[{"kind":"attribute","text":"@frozen"},{"kind":"text","text":" "},{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"AnyOf"},{"kind":"text","text":"<each "},{"kind":"genericParameter","text":"C"},{"kind":"text","text":">"}],"platforms":["Linux"],"languages":["swift"]}]},{"kind":"mentions","mentions":["doc:\/\/WorldModule\/documentation\/WorldModule\/QueryingAWorld"]},{"kind":"content","content":[{"type":"heading","level":2,"text":"Overview","anchor":"overview"},{"type":"paragraph","inlineContent":[{"type":"text","text":"As a term of a "},{"type":"reference","isActive":true,"identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/Query"},{"type":"text","text":", "},{"type":"codeVoice","code":"AnyOf"},{"type":"text","text":" of component types matches the entities that hold at least"},{"type":"text","text":" "},{"type":"text","text":"one of the types, and reads a tuple with one optional per type: the entity’s component, or"},{"type":"text","text":" "},{"type":"codeVoice","code":"nil"},{"type":"text","text":" where the entity lacks that type. Use it to visit entities that may carry any of several"},{"type":"text","text":" "},{"type":"text","text":"related components:"}]},{"type":"codeListing","code":["var world = World()","world.spawn(Name(value: \"frozen comet\"), Velocity(dx: 4, dy: 0), Frozen())","world.spawn(Name(value: \"comet\"), Velocity(dx: 2, dy: 0))","world.spawn(Name(value: \"ice\"), Frozen())","world.spawn(Name(value: \"rock\"))","","var descriptions: [String] = []","for (_, name, (velocity, frozen)) in world.query(Query(Name.self, AnyOf<Velocity, Frozen>.self)) {","    let state = frozen == nil ? \"moving at \\(velocity?.dx ?? 0)\" : \"frozen\"","    descriptions.append(\"\\(name.value) is \\(state)\")","}","print(descriptions)","\/\/ Prints \"[\"frozen comet is frozen\", \"comet is moving at 2.0\", \"ice is frozen\"]\""],"syntax":"swift"},{"type":"paragraph","inlineContent":[{"text":"The rock holds neither type, so the query skips it.","type":"text"}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"As a filter type of a system’s query ("},{"type":"reference","isActive":true,"identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/Query\/Where"},{"type":"text","text":"), "},{"type":"codeVoice","code":"AnyOf"},{"type":"text","text":" of filter types passes the"},{"type":"text","text":" "},{"type":"text","text":"entities that pass at least one of them: "},{"type":"codeVoice","code":"Query<Health>.Where<AnyOf<Changed<Health>, Without<Frozen>>>"},{"type":"text","text":" visits the entities whose health changed and the ones that aren’t frozen."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Queries of one to three terms, with "},{"code":"AnyOf","type":"codeVoice"},{"type":"text","text":" groups of two to four types, run through code"},{"type":"text","text":" "},{"type":"text","text":"specialized for their exact shape."}]}]}],"topicSections":[{"generated":true,"title":"Default Implementations","identifiers":["doc:\/\/WorldModule\/documentation\/WorldModule\/AnyOf\/FilterTerm-Implementations","doc:\/\/WorldModule\/documentation\/WorldModule\/AnyOf\/QueryTerm-Implementations"],"anchor":"Default-Implementations"}],"seeAlsoSections":[{"generated":true,"title":"Querying and Updating Entities","identifiers":["doc:\/\/WorldModule\/documentation\/WorldModule\/QueryingAWorld","doc:\/\/WorldModule\/documentation\/WorldModule\/Query","doc:\/\/WorldModule\/documentation\/WorldModule\/QueryView","doc:\/\/WorldModule\/documentation\/WorldModule\/EntityQueryView","doc:\/\/WorldModule\/documentation\/WorldModule\/QueryRow","doc:\/\/WorldModule\/documentation\/WorldModule\/QueryTerm","doc:\/\/WorldModule\/documentation\/WorldModule\/EntitiesView"],"anchor":"Querying-and-Updating-Entities"}],"hierarchy":{"paths":[["doc:\/\/WorldModule\/documentation\/WorldModule"]]},"identifier":{"url":"doc:\/\/WorldModule\/documentation\/WorldModule\/AnyOf","interfaceLanguage":"swift"},"sections":[],"references":{"doc://WorldModule/documentation/WorldModule/Query":{"identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/Query","url":"\/documentation\/worldmodule\/query","title":"Query","kind":"symbol","type":"topic","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Query","kind":"identifier"}],"navigatorTitle":[{"text":"Query","kind":"identifier"}],"abstract":[{"type":"text","text":"A description of the entities to visit and the components to read from each."}],"role":"symbol"},"doc://WorldModule/documentation/WorldModule/QueryTerm":{"fragments":[{"text":"protocol","kind":"keyword"},{"text":" ","kind":"text"},{"text":"QueryTerm","kind":"identifier"}],"k