{"abstract":[{"text":"A group of types an entity matches by matching at least one of them.","type":"text"}],"topicSections":[{"title":"Default Implementations","identifiers":["doc:\/\/WorldModule\/documentation\/WorldModule\/AnyOf\/FilterTerm-Implementations","doc:\/\/WorldModule\/documentation\/WorldModule\/AnyOf\/QueryTerm-Implementations"],"anchor":"Default-Implementations","generated":true}],"relationshipsSections":[{"kind":"relationships","title":"Conforms To","identifiers":["doc:\/\/WorldModule\/documentation\/WorldModule\/FilterTerm","doc:\/\/WorldModule\/documentation\/WorldModule\/QueryTerm","doc:\/\/WorldModule\/s15BitwiseCopyableP","doc:\/\/WorldModule\/s8CopyableP","doc:\/\/WorldModule\/s9EscapableP","doc:\/\/WorldModule\/s8SendableP","doc:\/\/WorldModule\/s16SendableMetatypeP"],"type":"conformsTo"}],"sections":[],"seeAlsoSections":[{"title":"Querying and Updating Entities","identifiers":["doc:\/\/WorldModule\/documentation\/WorldModule\/QueryingAWorld","doc:\/\/WorldModule\/documentation\/WorldModule\/Query","doc:\/\/WorldModule\/documentation\/WorldModule\/QueryView","doc:\/\/WorldModule\/documentation\/WorldModule\/EntityQueryView","doc:\/\/WorldModule\/documentation\/WorldModule\/QueryRow","doc:\/\/WorldModule\/documentation\/WorldModule\/QueryTerm","doc:\/\/WorldModule\/documentation\/WorldModule\/EntitiesView"],"anchor":"Querying-and-Updating-Entities","generated":true}],"primaryContentSections":[{"kind":"declarations","declarations":[{"tokens":[{"text":"@frozen","kind":"attribute"},{"text":" ","kind":"text"},{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"AnyOf","kind":"identifier"},{"text":"<each ","kind":"text"},{"text":"C","kind":"genericParameter"},{"text":">","kind":"text"}],"platforms":["Linux"],"languages":["swift"]}]},{"kind":"mentions","mentions":["doc:\/\/WorldModule\/documentation\/WorldModule\/QueryingAWorld"]},{"content":[{"type":"heading","text":"Overview","anchor":"overview","level":2},{"type":"paragraph","inlineContent":[{"text":"As a term of a ","type":"text"},{"identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/Query","isActive":true,"type":"reference"},{"text":", ","type":"text"},{"type":"codeVoice","code":"AnyOf"},{"text":" of component types matches the entities that hold at least","type":"text"},{"text":" ","type":"text"},{"text":"one of the types, and reads a tuple with one optional per type: the entity’s component, or","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"nil"},{"text":" where the entity lacks that type. Use it to visit entities that may carry any of several","type":"text"},{"text":" ","type":"text"},{"text":"related components:","type":"text"}]},{"type":"codeListing","syntax":"swift","code":["var world = World()","world.spawn(Name(value: \"frozen comet\"), Velocity(dx: 4, dy: 0), Frozen())","world.spawn(Name(value: \"comet\"), Velocity(dx: 2, dy: 0))","world.spawn(Name(value: \"ice\"), Frozen())","world.spawn(Name(value: \"rock\"))","","var descriptions: [String] = []","for (_, name, (velocity, frozen)) in world.query(Query(Name.self, AnyOf<Velocity, Frozen>.self)) {","    let state = frozen == nil ? \"moving at \\(velocity?.dx ?? 0)\" : \"frozen\"","    descriptions.append(\"\\(name.value) is \\(state)\")","}","print(descriptions)","\/\/ Prints \"[\"frozen comet is frozen\", \"comet is moving at 2.0\", \"ice is frozen\"]\""]},{"type":"paragraph","inlineContent":[{"type":"text","text":"The rock holds neither type, so the query skips it."}]},{"type":"paragraph","inlineContent":[{"text":"As a filter type of a system’s query (","type":"text"},{"isActive":true,"identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/Query\/Where","type":"reference"},{"text":"), ","type":"text"},{"type":"codeVoice","code":"AnyOf"},{"text":" of filter types passes the","type":"text"},{"text":" ","type":"text"},{"text":"entities that pass at least one of them: ","type":"text"},{"type":"codeVoice","code":"Query<Health>.Where<AnyOf<Changed<Health>, Without<Frozen>>>"},{"text":" visits the entities whose health changed and the ones that aren’t frozen.","type":"text"}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Queries of one to three terms, with "},{"code":"AnyOf","type":"codeVoice"},{"type":"text","text":" groups of two to four types, run through code"},{"type":"text","text":" "},{"type":"text","text":"specialized for their exact shape."}]}],"kind":"content"}],"kind":"symbol","identifier":{"url":"doc:\/\/WorldModule\/documentation\/WorldModule\/AnyOf","interfaceLanguage":"swift"},"hierarchy":{"paths":[["doc:\/\/WorldModule\/documentation\/WorldModule"]]},"schemaVersion":{"major":0,"minor":3,"patch":0},"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/worldmodule\/anyof"]}],"metadata":{"title":"AnyOf","modules":[{"name":"WorldModule"}],"symbolKind":"struct","externalID":"s:11WorldModule5AnyOfV","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"AnyOf"}],"remoteSource":{"url":"https:\/\/github.com\/Tyler-Keith-Thompson\/ECS\/blob\/main\/Sources\/WorldModule\/QueryTerm.swift#L112","fileName":"QueryTerm.swift"},"navigatorTitle":[{"kind":"identifier","text":"AnyOf"}],"role":"symbol","roleHeading":"Structure"},"references":{"doc://WorldModule/documentation/WorldModule/AnyOf/QueryTerm-Implementations":{"kind":"article","identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/AnyOf\/QueryTerm-Implementations","abstract":[],"url":"\/documentation\/worldmodule\/anyof\/queryterm-implementations","type":"topic","role":"collectionGroup","title":"QueryTerm Implementations"},"doc://WorldModule/documentation/WorldModule/FilterTerm":{"identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/FilterTerm","role":"symbol","type":"topic","url":"\/documentation\/worldmodule\/filterterm","kind":"symbol","fragments":[{"kind":"keyword","text":"protocol"},{"kind":"text","text":" "},{"kind":"identifier","text":"Fil