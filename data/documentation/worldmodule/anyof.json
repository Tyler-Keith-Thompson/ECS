entity lacks that type. Use it to visit entities that may carry any of several","type":"text"},{"text":" ","type":"text"},{"text":"related components:","type":"text"}]},{"syntax":"swift","type":"codeListing","code":["var world = World()","world.spawn(Name(value: \"frozen comet\"), Velocity(dx: 4, dy: 0), Frozen())","world.spawn(Name(value: \"comet\"), Velocity(dx: 2, dy: 0))","world.spawn(Name(value: \"ice\"), Frozen())","world.spawn(Name(value: \"rock\"))","","var descriptions: [String] = []","for (_, name, (velocity, frozen)) in world.query(Query(Name.self, AnyOf<Velocity, Frozen>.self)) {","    let state = frozen == nil ? \"moving at \\(velocity?.dx ?? 0)\" : \"frozen\"","    descriptions.append(\"\\(name.value) is \\(state)\")","}","print(descriptions)","\/\/ Prints \"[\"frozen comet is frozen\", \"comet is moving at 2.0\", \"ice is frozen\"]\""]},{"type":"paragraph","inlineContent":[{"type":"text","text":"The rock holds neither type, so the query skips it."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"As a filter type of a system’s query ("},{"type":"reference","identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/Query\/Where","isActive":true},{"type":"text","text":"), "},{"type":"codeVoice","code":"AnyOf"},{"type":"text","text":" of filter types passes the"},{"type":"text","text":" "},{"type":"text","text":"entities that pass at least one of them: "},{"type":"codeVoice","code":"Query<Health>.Where<AnyOf<Changed<Health>, Without<Frozen>>>"},{"type":"text","text":" visits the entities whose health changed and the ones that aren’t frozen."}]},{"type":"paragraph","inlineContent":[{"text":"Queries of one to three terms, with ","type":"text"},{"type":"codeVoice","code":"AnyOf"},{"text":" groups of two to four types, run through code","type":"text"},{"text":" ","type":"text"},{"text":"specialized for their exact shape.","type":"text"}]}]}],"sections":[],"schemaVersion":{"minor":3,"patch":0,"major":0},"identifier":{"url":"doc:\/\/WorldModul