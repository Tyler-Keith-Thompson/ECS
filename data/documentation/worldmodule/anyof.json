{"metadata":{"externalID":"s:11WorldModule5AnyOfV","title":"AnyOf","roleHeading":"Structure","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"AnyOf","kind":"identifier"}],"navigatorTitle":[{"text":"AnyOf","kind":"identifier"}],"modules":[{"name":"WorldModule"}],"remoteSource":{"url":"https:\/\/github.com\/Tyler-Keith-Thompson\/ECS\/blob\/main\/Sources\/WorldModule\/QueryTerm.swift#L112","fileName":"QueryTerm.swift"},"symbolKind":"struct","role":"symbol"},"sections":[],"identifier":{"url":"doc:\/\/WorldModule\/documentation\/WorldModule\/AnyOf","interfaceLanguage":"swift"},"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/worldmodule\/anyof"]}],"relationshipsSections":[{"identifiers":["doc:\/\/WorldModule\/documentation\/WorldModule\/FilterTerm","doc:\/\/WorldModule\/documentation\/WorldModule\/QueryTerm","doc:\/\/WorldModule\/s15BitwiseCopyableP","doc:\/\/WorldModule\/s8CopyableP","doc:\/\/WorldModule\/s9EscapableP","doc:\/\/WorldModule\/s8SendableP","doc:\/\/WorldModule\/s16SendableMetatypeP"],"kind":"relationships","title":"Conforms To","type":"conformsTo"}],"hierarchy":{"paths":[["doc:\/\/WorldModule\/documentation\/WorldModule"]]},"kind":"symbol","seeAlsoSections":[{"identifiers":["doc:\/\/WorldModule\/documentation\/WorldModule\/QueryingAWorld","doc:\/\/WorldModule\/documentation\/WorldModule\/Query","doc:\/\/WorldModule\/documentation\/WorldModule\/QueryView","doc:\/\/WorldModule\/documentation\/WorldModule\/EntityQueryView","doc:\/\/WorldModule\/documentation\/WorldModule\/QueryRow","doc:\/\/WorldModule\/documentation\/WorldModule\/QueryTerm","doc:\/\/WorldModule\/documentation\/WorldModule\/EntitiesView"],"generated":true,"title":"Querying and Updating Entities","anchor":"Querying-and-Updating-Entities"}],"topicSections":[{"identifiers":["doc:\/\/WorldModule\/documentation\/WorldModule\/AnyOf\/FilterTerm-Implementations","doc:\/\/WorldModule\/documentation\/WorldModule\/AnyOf\/QueryTerm-Implementations"],"generated":true,"title":"Default Implementations","anchor":"Default-Implementations"}],"abstract":[{"type":"text","text":"A group of types an entity matches by matching at least one of them."}],"primaryContentSections":[{"kind":"declarations","declarations":[{"tokens":[{"kind":"attribute","text":"@frozen"},{"kind":"text","text":" "},{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"AnyOf"},{"kind":"text","text":"<each "},{"kind":"genericParameter","text":"C"},{"kind":"text","text":">"}],"languages":["swift"],"platforms":["Linux"]}]},{"kind":"mentions","mentions":["doc:\/\/WorldModule\/documentation\/WorldModule\/QueryingAWorld"]},{"kind":"content","content":[{"type":"heading","level":2,"anchor":"overview","text":"Overview"},{"type":"paragraph","inlineContent":[{"type":"text","text":"As a term of a "},{"type":"reference","identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/Query","isActive":true},{"type":"text","text":", "},{"type":"codeVoice","code":"AnyOf"},{"type":"text","text":" of component types matches the entities that hold at least"},{"type":"text","text":" "},{"type":"text","text":"one of the types, and reads a tuple with one optional per type: the entity’s component, or"},{"type":"text","text":" "},{"type":"codeVoice","code":"nil"},{"type":"text","text":" where the entity lacks that type. Use it to visit entities that may carry any of several"},{"type":"text","text":" "},{"type":"text","text":"related components:"}]},{"type":"codeListing","syntax":"swift","code":["var world = World()","world.spawn(Name(value: \"frozen comet\"), Velocity(dx: 4, dy: 0), Frozen())","world.spawn(Name(value: \"comet\"), Velocity(dx: 2, dy: 0))","world.spawn(Name(value: \"ice\"), Frozen())","world.spawn(Name(value: \"rock\"))","","var descriptions: [String] = []","for (_, name, (velocity, frozen)) in world.query(Query(Name.self, AnyOf<Velocity, Frozen>.self)) {","    let state = frozen == nil ? \"moving at \\(velocity?.dx ?? 0)\" : \"frozen\"","    descriptions.append(\"\\(name.value) is \\(state)\")","}","print(descriptions)","\/\/ Prints \"[\"frozen comet is frozen\", \"comet is moving at 2.0\", \"ice is frozen\"]\""]},{"type":"paragraph","inlineContent":[{"type":"text","text":"The rock holds neither type, so the query skips it."}]},{"type":"paragraph","inlineContent":[{"text":"As a filter type of a system’s query (","type":"text"},{"identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/Query\/Where","isActive":true,"type":"reference"},{"text":"), ","type":"text"},{"code":"AnyOf","type":"codeVoice"},{"text":" of filter types passes the","type":"text"},{"text":" ","type":"text"},{"text":"entities that pass at least one of them: ","type":"text"},{"code":"Query<Health>.Where<AnyOf<Changed<Health>, Without<Frozen>>>","type":"codeVoice"},{"text":" visits the entities whose health changed and the ones that aren’t frozen.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"Queries of one to three terms, with ","type":"text"},{"type":"codeVoice","code":"AnyOf"},{"text":" groups of two to four types, run through code","type":"text"},{"text":" ","type":"text"},{"text":"specialized for their exact shape.","type":"text"}]}]}],"schemaVersion":{"patch":0,"major":0,"minor":3},"references":{"doc://WorldModule/s16SendableMetatypeP":{"type":"unresolvable","identifier":"doc:\/\/WorldModule\/s16SendableMetatypeP","title":"Swift.SendableMetatype"},"doc://WorldModule/documentation/WorldModule/EntityQueryView":{"title":"EntityQueryView","url":"\/documentation\/worldmodule\/entityqueryview","type":"topic","identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/EntityQueryView","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"EntityQueryView"}],"abstract":[{"text":"A lazy sequence of the entities that pass a filter, without reading any of their components.","type":"text"}],"role":"symbol","navigatorTitle":[{"kind":"ide