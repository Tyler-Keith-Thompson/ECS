{"abstract":[{"type":"text","text":"A group of types an entity matches by matching at least one of them."}],"sections":[],"identifier":{"url":"doc:\/\/WorldModule\/documentation\/WorldModule\/AnyOf","interfaceLanguage":"swift"},"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/worldmodule\/anyof"]}],"primaryContentSections":[{"kind":"declarations","declarations":[{"languages":["swift"],"tokens":[{"text":"@frozen","kind":"attribute"},{"text":" ","kind":"text"},{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"AnyOf","kind":"identifier"},{"text":"<each ","kind":"text"},{"text":"C","kind":"genericParameter"},{"kind":"text","text":">"}],"platforms":["Linux"]}]},{"kind":"mentions","mentions":["doc:\/\/WorldModule\/documentation\/WorldModule\/QueryingAWorld"]},{"kind":"content","content":[{"anchor":"overview","text":"Overview","type":"heading","level":2},{"inlineContent":[{"text":"As a term of a ","type":"text"},{"identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/Query","isActive":true,"type":"reference"},{"type":"text","text":", "},{"code":"AnyOf","type":"codeVoice"},{"type":"text","text":" of component types matches the entities that hold at least"},{"type":"text","text":" "},{"type":"text","text":"one of the types, and reads a tuple with one optional per type: the entity’s component, or"},{"type":"text","text":" "},{"code":"nil","type":"codeVoice"},{"type":"text","text":" where the entity lacks that type. Use it to visit entities that may carry any of several"},{"type":"text","text":" "},{"type":"text","text":"related components:"}],"type":"paragraph"},{"code":["var world = World()","world.spawn(Name(value: \"frozen comet\"), Velocity(dx: 4, dy: 0), Frozen())","world.spawn(Name(value: \"comet\"), Velocity(dx: 2, dy: 0))","world.spawn(Name(value: \"ice\"), Frozen())","world.spawn(Name(value: \"rock\"))","","var descriptions: [String] = []","for (_, name, (velocity, frozen)) in world.query(Query(Name.self, AnyOf<Velocity, Frozen>.self)) {","    let state = frozen == nil ? \"moving at \\(velocity?.dx ?? 0)\" : \"frozen\"","    descriptions.append(\"\\(name.value) is \\(state)\")","}","print(descriptions)","\/\/ Prints \"[\"frozen comet is frozen\", \"comet is moving at 2.0\", \"ice is frozen\"]\""],"type":"codeListing","syntax":"swift"},{"inlineContent":[{"type":"text","text":"The rock holds neither type, so the query skips it."}],"type":"paragraph"},{"inlineContent":[{"text":"As a filter type of a system’s query (","type":"text"},{"identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/Query\/Where","isActive":true,"type":"reference"},{"text":"), ","type":"text"},{"code":"AnyOf","type":"codeVoice"},{"text":" of filter types passes the","type":"text"},{"text":" ","type":"text"},{"text":"entities that pass at least one of them: ","type":"text"},{"code":"Query<Health>.Where<AnyOf<Changed<Health>, Without<Frozen>>>","type":"codeVoice"},{"text":" visits the entities whose health changed and the ones that aren’t frozen.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"Queries of one to three terms, with "},{"type":"codeVoice","code":"AnyOf"},{"type":"text","text":" groups of two to four types, run through code"},{"type":"text","text":" "},{"type":"text","text":"specialized for their exact shape."}],"type":"paragraph"}]}],"topicSections":[{"title":"Default Implementations","identifiers":["doc:\/\/WorldModule\/documentation\/WorldModule\/AnyOf\/FilterTerm-Implementations","doc:\/\/WorldModule\/documentation\/WorldModule\/AnyOf\/QueryTerm-Implementations"],"generated":true,"anchor":"Default-Implementations"}],"kind":"symbol","relationshipsSections":[{"title":"Conforms To","type":"conformsTo","kind":"relationships","identifiers":["doc:\/\/WorldModule\/documentation\/WorldModule\/FilterTerm","doc:\/\/WorldModule\/documentation\/WorldModule\/QueryTerm","doc:\/\/WorldModule\/s15BitwiseCopyableP","doc:\/\/WorldModule\/s8CopyableP","doc:\/\/WorldMo