{"hierarchy":{"paths":[[]]},"abstract":[{"text":"Declare the rules of a simulation as systems, and run them on a world in a schedule.","type":"text"}],"topicSections":[{"identifiers":["doc:\/\/Systems\/documentation\/Systems\/DeclaringSystems","doc:\/\/Systems\/documentation\/Systems\/DrivingAWorldFromAnApp","doc:\/\/Systems\/documentation\/Systems\/System()","doc:\/\/Systems\/documentation\/Systems\/System"],"title":"Essentials","anchor":"Essentials"},{"identifiers":["doc:\/\/Systems\/documentation\/Systems\/SystemParameter","doc:\/\/Systems\/documentation\/Systems\/Update","doc:\/\/Systems\/documentation\/Systems\/ResourceReader","doc:\/\/Systems\/documentation\/Systems\/ResourceWriter","doc:\/\/Systems\/documentation\/Systems\/EventReader","doc:\/\/Systems\/documentation\/Systems\/EventWriter","doc:\/\/Systems\/documentation\/Systems\/RemovedComponents"],"title":"System Parameters","anchor":"System-Parameters"},{"identifiers":["doc:\/\/Systems\/documentation\/Systems\/Schedule","doc:\/\/Systems\/documentation\/Systems\/ScheduleBuilder","doc:\/\/Systems\/documentation\/Systems\/ScheduledSystem","doc:\/\/Systems\/documentation\/Systems\/SystemSet","doc:\/\/Systems\/documentation\/Systems\/CyclicOrdering","doc:\/\/Systems\/documentation\/Systems\/Ambiguity"],"title":"Building and Running Schedules","anchor":"Building-and-Running-Schedules"},{"identifiers":["doc:\/\/Systems\/documentation\/Systems\/MainActorSystem"],"title":"Main-Actor Systems","anchor":"Main-Actor-Systems"},{"identifiers":["doc:\/\/Systems\/documentation\/Systems\/UpdateEvents","doc:\/\/Systems\/documentation\/Systems\/ForwardEvents","doc:\/\/Systems\/documentation\/Systems\/ForwardChanges"],"title":"Built-In Systems","anchor":"Built-In-Systems"},{"identifiers":["doc:\/\/Systems\/documentation\/Systems\/SystemProfile","doc:\/\/Systems\/documentation\/Systems\/SystemTiming"],"title":"Profiling","anchor":"Profiling"}],"metadata":{"modules":[{"name":"Systems"}],"symbolKind":"module","title":"Systems","externalID":"Systems","role":"collection","roleHeading":"Framework"},"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/Systems\/documentation\/Systems"},"kind":"symbol","primaryContentSections":[{"content":[{"anchor":"Overview","level":2,"type":"heading","text":"Overview"},{"type":"paragraph","inlineContent":[{"text":"A world holds data: entities and their components, and resources. A ","type":"text"},{"inlineContent":[{"type":"text","text":"system"}],"type":"emphasis"},{"text":" holds a rule: a","type":"text"},{"text":" ","type":"text"},{"text":"step that reads part of the world and changes part of it, such as “every entity with a velocity","type":"text"},{"text":" ","type":"text"},{"text":"moves” or “gravity pulls on everything that isn’t frozen.” A ","type":"text"},{"inlineContent":[{"text":"schedule","type":"text"}],"type":"emphasis"},{"text":" lists the systems of one","type":"text"},{"text":" ","type":"text"},{"text":"frame or step and runs them on a world, each once per run.","type":"text"}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"The examples throughout this module use these components, resources and event:"}]},{"type":"codeListing","syntax":"swift","code":["struct Position: Component { var x: Double, y: Double }","struct Velocity: Component { var dx: Double, dy: Double }","struct Health: Component { var current: Int }","struct Frozen: Component {}","","struct Score: Resource { var points: Int }","struct TimeStep: Resource { var seconds: Double }","struct Paused: Resource {}","","struct Damage: Event { var target: Entity, amount: Int }"]},{"anchor":"Declare-a-System","level":3,"type":"heading","text":"Declare a System"},{"type":"paragraph","inlineContent":[{"text":"The simplest way to write a system is to mark a type with the ","type":"text"},{"type":"codeVoice","code":"@System"},{"text":" macro and give it a","type":"text"},{"text":" ","type":"text"},{"code":"run","type":"codeVoice"},{"text":" method. The method’s parameters say what the system works on, and their types say how:","type":"text"},{"text":" ","type":"text"},{"text":"an ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/Systems\/documentation\/Systems\/Update"},{"text":" writes components, a ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/Query"},{"text":" reads them, and a ","type":"text"},{"identifier":"doc:\/\/Systems\/documentation\/Systems\/ResourceReader","type":"reference","isActive":true},{"text":" ","type":"text"},{"type":"text","text":"reads a resource. The following two systems pull everything that isn’t frozen downward, then move"},{"type":"text","text":" "},{"type":"text","text":"it by its velocity:"}]},{"type":"codeListing","syntax":"swift","code":["@System","struct Gravity {","    func run(_ falling: Update<Velocity>.Where<Without<Frozen>>) {","        falling { velocity, _ in velocity.dy -= 10 }","    }","}","","@System","struct Movement {","    func run(_ movers: Update<Position>.Over<Velocity>.Where<Without<Frozen>>) {","        movers { position, row in","            position.x += row.components.dx","            position.y += row.components.dy","        }","    }","}"]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Because the parameters’ types state what each system reads and writes, the macro writes the"},{"type":"text","text":" "},{"type":"text","text":"system’s "},{"identifier":"doc:\/\/Systems\/documentation\/Systems\/System\/access","isActive":true,"type":"reference"},{"text":" for you: ","type":"text"},{"type":"codeVoice","code":"Gravity"},{"text":" writes ","type":"text"},{"code":"Velocity","type":"codeVoice"},{"text":"; ","type":"text"},{"type":"codeVoice","code":"Movement"},{"type":"text","text":" writes "},{"type":"codeVoice","code":"Position"},{"text":" and","type":"text"},{"text":" ","type":"text"},{"text":"reads ","type":"text"},{"type":"codeVoice","code":"Velocity"},{"text":". A schedule uses the access to decide which systems can run at the same time.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"You can also conform a type to ","type":"text"},{"type":"reference","identifier":"doc:\/\/Systems\/documentation\/Systems\/System","isActive":true},{"text":" by hand and write its ","type":"text"},{"type":"reference","identifier":"doc:\/\/Systems\/documentation\/Systems\/System\/run(in:)","isActive":true},{"text":" method, which","type":"text"},{"text":" ","type":"text"},{"text":"receives the whole world. See ","type":"text"},{"type":"reference","identifier":"doc:\/\/Systems\/documentation\/Systems\/System","isActive":true},{"text":" for when to do that.","type":"text"}]},{"anchor":"Run-Systems-in-a-Schedule","level":3,"type":"heading","text":"Run Systems in a Schedule"},{"type":"paragraph","inlineContent":[{"text":"A ","type":"text"},{"identifier":"doc:\/\/Systems\/documentation\/Systems\/Schedule","isActive":true,"type":"reference"},{"text":" is built from a list of systems, written in a result builder. Running it runs each","type":"text"},{"text":" ","type":"text"},{"text":"system once. The following example drops a ball for one frame:","type":"text"}]},{"type":"codeListing","syntax":"swift","code":["var world = World()","let ball = world.spawn(Position(x: 0, y: 100), Velocity(dx: 1, dy: 0))","","let frame = Schedule {","    Gravity()","    Movement().after(Gravity.self)","}","frame.run(on: &world)","","print(world[Position.self, of: ball])","\/\/ Prints \"Position(x: 1.0, y: 90.0)\""]},{"type":"paragraph","inlineContent":[{"text":"Systems run in the order you write them, unless an ordering constraint says otherwise.","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"after(_:)"},{"text":" and ","type":"text"},{"type":"codeVoice","code":"before(_:)"},{"type":"text","text":" require one system to run after or before another; "},{"type":"reference","identifier":"doc:\/\/Systems\/documentation\/Systems\/SystemSet","isActive":true},{"type":"text","text":" "},{"type":"text","text":"names a group of systems so constraints can refer to all of them at once; and "},{"type":"codeVoice","code":"runIf(_:)"},{"type":"text","text":" skips"},{"type":"text","text":" "},{"type":"text","text":"a system when a condition doesn’t hold."}]},{"type":"paragraph","inlineContent":[{"text":"Systems whose accesses don’t conflict, because neither writes what the other reads or writes,","type":"text"},{"text":" ","type":"text"},{"text":"run at the same time, and the world ends as though they had run one after another (commands","type":"text"},{"text":" ","type":"text"},{"text":"apply when each wave finishes). Systems that","type":"text"},{"text":" ","type":"text"},{"text":"conflict run in order. When two conflicting systems aren’t ordered by any constraint, their order","type":"text"},{"text":" ","type":"text"},{"text":"rests only on how they happen to be written; ","type":"text"},{"identifier":"doc:\/\/Systems\/documentation\/Systems\/Schedule\/ambiguities()","isActive":true,"type":"reference"},{"text":" finds those pairs so a","type":"text"},{"text":" ","type":"text"},{"text":"test can keep a schedule free of them.","type":"text"}]}],"kind":"content"}],"variants":[{"paths":["\/documentation\/systems"],"traits":[{"interfaceLanguage":"swift"}]}],"sections":[],"schemaVersion":{"minor":3,"patch":0,"major":0},"references":{"doc://Systems/documentation/Systems/SystemSet":{"role":"symbol","type":"topic","title":"SystemSet","url":"\/documentation\/systems\/systemset","fragments":[{"text":"protocol","kind":"keyword"},{"text":" ","kind":"text"},{"text":"SystemSet","kind":"identifier"}],"abstract":[{"text":"A type that names a group of systems, so ordering constraints can refer to all of them at","type":"text"},{"text":" ","type":"text"},{"text":"once.","type":"text"}],"identifier":"doc:\/\/Systems\/documentation\/Systems\/SystemSet","navigatorTitle":[{"text":"SystemSet","kind":"identifier"}],"kind":"symbol"},"doc://Systems/documentation/Systems/UpdateEvents":{"title":"UpdateEvents","kind":"symbol","type":"topic","role":"symbol","navigatorTitle":[{"text":"UpdateEvents","kind":"identifier"}],"url":"\/documentation\/systems\/updateevents","identifier":"doc:\/\/Systems\/documentation\/Systems\/UpdateEvents","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"UpdateEvents","kind":"identifier"}],"abstract":[{"type":"text","text":"A system that ends the current event update, dropping events old enough that every reader"},{"type":"text","text":" "},{"type":"text","text":"has had its chance to read them."}]},"doc://Systems/documentation/Systems/DeclaringSystems":{"abstract":[{"text":"Write the rules of a simulation as systems, and let their parameters state what they read and","type":"text"},{"text":" ","type":"text"},{"text":"write.","type":"text"}],"kind":"article","identifier":"doc:\/\/Systems\/documentation\/Systems\/DeclaringSystems","url":"\/documentation\/systems\/declaringsystems","role":"collectionGroup","title":"Declaring Systems","type":"topic"},"doc://Systems/documentation/Systems":{"title":"Systems","kind":"symbol","type":"topic","role":"collection","url":"\/documentation\/systems","identifier":"doc:\/\/Systems\/documentation\/Systems","abstract":[{"text":"Declare the rules of a simulation as systems, and run them on a world in a schedule.","type":"text"}]},"doc://Systems/documentation/Systems/EventReader":{"identifier":"doc:\/\/Systems\/documentation\/Systems\/EventReader","title":"EventReader","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"EventReader"}],"abstract":[{"text":"A system parameter that reads the events of one type sent since the system last read them.","type":"text"}],"navigatorTitle":[{"kind":"identifier","text":"EventReader"}],"role":"symbol","kind":"symbol","url":"\/documentation\/systems\/eventreader","type":"topic"},"doc://Systems/documentation/Systems/DrivingAWorldFromAnApp":{"title":"Driving a World from an App","kind":"article","type":"topic","role":"article","url":"\/documentation\/systems\/drivingaworldfromanapp","identifier":"doc:\/\/Systems\/documentation\/Systems\/DrivingAWorldFromAnApp","abstract":[{"type":"text","text":"Hold a world in your app or game engine, feed it each frame’s input, and let the objects outside"},{"type":"text","text":" "},{"type":"text","text":"it read results and take part in a step."}]},"doc://WorldModule/documentation/WorldModule/Query":{"abstract":[{"text":"A description of the entities to visit and the components to read from each.","type":"text"}],"url":"\/documentation\/worldmodule\/query","identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/Query","kind":"symbol","navigatorTitle":[{"text":"Query","kind":"identifier"}],"role":"symbol","title":"Query","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Query","kind":"identifier"}],"type":"topic"},"doc://Systems/documentation/Systems/MainActorSystem":{"title":"MainActorSystem","kind":"symbol","type":"topic","role":"symbol","navigatorTitle":[{"kind":"identifier","text":"MainActorSystem"}],"url":"\/documentation\/systems\/mainactorsystem","identifier":"doc:\/\/Systems\/documentation\/Systems\/MainActorSystem","fragments":[{"kind":"keyword","text":"protocol"},{"kind":"text","text":" "},{"kind":"identifier","text":"MainActorSystem"}],"abstract":[{"text":"A system that runs on the main actor, for work that touches main-actor state such as a user","type":"text"},{"text":" ","type":"text"},{"text":"interface.","type":"text"}]},"doc://Systems/documentation/Systems/Schedule":{"title":"Schedule","kind":"symbol","type":"topic","role":"symbol","navigatorTitle":[{"text":"Schedule","kind":"identifier"}],"url":"\/documentation\/systems\/schedule","identifier":"doc:\/\/Systems\/documentation\/Systems\/Schedule","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Schedule","kind":"identifier"}],"abstract":[{"text":"A list of systems that run on a world, in order, and at the same time where they can.","type":"text"}]},"doc://Systems/documentation/Systems/System/run(in:)":{"abstract":[{"text":"Runs the system’s rule once on a world.","type":"text"}],"kind":"symbol","identifier":"doc:\/\/Systems\/documentation\/Systems\/System\/run(in:)","url":"\/documentation\/systems\/system\/run(in:)","role":"symbol","title":"run(in:)","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"run","kind":"identifier"},{"text":"(","kind":"text"},{"text":"in","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"inout","kind":"keyword"},{"text":" ","kind":"text"},{"text":"World","kind":"typeIdentifier","preciseIdentifier":"s:11WorldModule0A0V"},{"text":")","kind":"text"}],"type":"topic","required":true},"doc://Systems/documentation/Systems/System/access":{"title":"access","kind":"symbol","type":"topic","role":"symbol","url":"\/documentation\/systems\/system\/access","required":true,"defaultImplementations":1,"identifier":"doc:\/\/Systems\/documentation\/Systems\/System\/access","fragments":[{"text":"var","kind":"keyword"},{"text":" ","kind":"text"},{"text":"access","kind":"identifier"},{"text":": ","kind":"text"},{"text":"Access","preciseIdentifier":"s:11WorldModule6AccessV","kind":"typeIdentifier"},{"text":"?","kind":"text"}],"abstract":[{"type":"text","text":"The component, resource and event types the system reads and writes, or "},{"type":"codeVoice","code":"nil"},{"type":"text","text":" if it may"},{"type":"text","text":" "},{"type":"text","text":"change anything."}]},"doc://Systems/documentation/Systems/System()":{"abstract":[{"text":"Makes a type a system whose access comes from the parameters of its ","type":"text"},{"code":"run","type":"codeVoice"},{"text":" method.","type":"text"}],"identifier":"doc:\/\/Systems\/documentation\/Systems\/System()","url":"\/documentation\/systems\/system()","kind":"symbol","role":"symbol","title":"System()","fragments":[{"text":"macro","kind":"keyword"},{"text":" ","kind":"text"},{"text":"System","kind":"identifier"},{"text":"()","kind":"text"}],"type":"topic"},"doc://Systems/documentation/Systems/SystemParameter":{"title":"SystemParameter","kind":"symbol","type":"topic","role":"symbol","navigatorTitle":[{"kind":"identifier","text":"SystemParameter"}],"url":"\/documentation\/systems\/systemparameter","identifier":"doc:\/\/Systems\/documentation\/Systems\/SystemParameter","fragments":[{"kind":"keyword","text":"protocol"},{"kind":"text","text":" "},{"kind":"identifier","text":"SystemParameter"}],"abstract":[{"text":"A type a system’s ","type":"text"},{"code":"run","type":"codeVoice"},{"text":" method can take in place of the whole world, whose type states what","type":"text"},{"text":" ","type":"text"},{"text":"the system reads and writes.","type":"text"}]},"doc://Systems/documentation/Systems/ForwardEvents":{"abstract":[{"type":"text","text":"A system that yields each event of one type to an asynchronous stream, so code outside the"},{"type":"text","text":" "},{"type":"text","text":"schedule can await the events."}],"identifier":"doc:\/\/Systems\/documentation\/Systems\/ForwardEvents","url":"\/documentation\/systems\/forwardevents","kind":"symbol","navigatorTitle":[{"text":"ForwardEvents","kind":"identifier"}],"role":"symbol","title":"ForwardEvents","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"ForwardEvents","kind":"identifier"}],"type":"topic"},"doc://Systems/documentation/Systems/ResourceWriter":{"title":"ResourceWriter","kind":"symbol","type":"topic","role":"symbol","navigatorTitle":[{"text":"ResourceWriter","kind":"identifier"}],"url":"\/documentation\/systems\/resourcewriter","identifier":"doc:\/\/Systems\/documentation\/Systems\/ResourceWriter","fragments":[{"text":"class","kind":"keyword"},{"text":" ","kind":"text"},{"text":"ResourceWriter","kind":"identifier"}],"abstract":[{"text":"A system parameter that reads and writes a resource.","type":"text"}]},"doc://Systems/documentation/Systems/ForwardChanges":{"abstract":[{"text":"A system that yields each component of one type added or changed since it last ran to an","type":"text"},{"text":" ","type":"text"},{"text":"asynchronous stream, with its entity.","type":"text"}],"identifier":"doc:\/\/Systems\/documentation\/Systems\/ForwardChanges","kind":"symbol","url":"\/documentation\/systems\/forwardchanges","navigatorTitle":[{"text":"ForwardChanges","kind":"identifier"}],"role":"symbol","title":"ForwardChanges","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"ForwardChanges","kind":"identifier"}],"type":"topic"},"doc://Systems/documentation/Systems/System":{"title":"System","kind":"symbol","type":"topic","role":"symbol","navigatorTitle":[{"kind":"identifier","text":"System"}],"url":"\/documentation\/systems\/system","identifier":"doc:\/\/Systems\/documentation\/Systems\/System","fragments":[{"kind":"keyword","text":"protocol"},{"kind":"text","text":" "},{"kind":"identifier","text":"System"}],"abstract":[{"text":"A rule that reads and changes a world, run once each time its schedule runs.","type":"text"}]},"doc://Systems/documentation/Systems/Schedule/ambiguities()":{"title":"ambiguities()","type":"topic","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"ambiguities"},{"kind":"text","text":"() -> ["},{"kind":"typeIdentifier","preciseIdentifier":"s:7Systems9AmbiguityV","text":"Ambiguity"},{"kind":"text","text":"]"}],"abstract":[{"text":"Returns every pair of systems whose accesses conflict but that no ordering constraint","type":"text"},{"text":" ","type":"text"},{"text":"orders.","type":"text"}],"role":"symbol","kind":"symbol","url":"\/documentation\/systems\/schedule\/ambiguities()","identifier":"doc:\/\/Systems\/documentation\/Systems\/Schedule\/ambiguities()"},"doc://Systems/documentation/Systems/SystemTiming":{"abstract":[{"type":"text","text":"The times one system of a schedule has taken to run."}],"url":"\/documentation\/systems\/systemtiming","identifier":"doc:\/\/Systems\/documentation\/Systems\/SystemTiming","kind":"symbol","navigatorTitle":[{"text":"SystemTiming","kind":"identifier"}],"role":"symbol","title":"SystemTiming","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"SystemTiming","kind":"identifier"}],"type":"topic"},"doc://Systems/documentation/Systems/EventWriter":{"title":"EventWriter","kind":"symbol","type":"topic","role":"symbol","navigatorTitle":[{"text":"EventWriter","kind":"identifier"}],"url":"\/documentation\/systems\/eventwriter","identifier":"doc:\/\/Systems\/documentation\/Systems\/EventWriter","fragments":[{"text":"class","kind":"keyword"},{"text":" ","kind":"text"},{"text":"EventWriter","kind":"identifier"}],"abstract":[{"text":"A system parameter that sends events of one type.","type":"text"}]},"doc://Systems/documentation/Systems/RemovedComponents":{"identifier":"doc:\/\/Systems\/documentation\/Systems\/RemovedComponents","title":"RemovedComponents","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"RemovedComponents","kind":"identifier"}],"abstract":[{"text":"A system parameter that lists the entities that lost a component since the system last read","type":"text"},{"text":" ","type":"text"},{"text":"them.","type":"text"}],"navigatorTitle":[{"text":"RemovedComponents","kind":"identifier"}],"role":"symbol","kind":"symbol","url":"\/documentation\/systems\/removedcomponents","type":"topic"},"doc://Systems/documentation/Systems/Update":{"abstract":[{"type":"text","text":"A system parameter that changes a component of every entity that holds it."}],"identifier":"doc:\/\/Systems\/documentation\/Systems\/Update","kind":"symbol","url":"\/documentation\/systems\/update","navigatorTitle":[{"text":"Update","kind":"identifier"}],"role":"symbol","title":"Update","fragments":[{"text":"class","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Update","kind":"identifier"}],"type":"topic"},"doc://Systems/documentation/Systems/CyclicOrdering":{"title":"CyclicOrdering","kind":"symbol","type":"topic","role":"symbol","navigatorTitle":[{"text":"CyclicOrdering","kind":"identifier"}],"url":"\/documentation\/systems\/cyclicordering","identifier":"doc:\/\/Systems\/documentation\/Systems\/CyclicOrdering","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"CyclicOrdering","kind":"identifier"}],"abstract":[{"text":"An error indicating that the ordering constraints of a schedule’s systems form a cycle, so no","type":"text"},{"text":" ","type":"text"},{"text":"order satisfies them all.","type":"text"}]},"doc://Systems/documentation/Systems/Ambiguity":{"identifier":"doc:\/\/Systems\/documentation\/Systems\/Ambiguity","title":"Ambiguity","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Ambiguity","kind":"identifier"}],"abstract":[{"text":"Two systems of a schedule whose accesses conflict but that no ordering constraint orders, so","type":"text"},{"text":" ","type":"text"},{"text":"the order they run in rests only on the order they were written in.","type":"text"}],"navigatorTitle":[{"text":"Ambiguity","kind":"identifier"}],"role":"symbol","kind":"symbol","url":"\/documentation\/systems\/ambiguity","type":"topic"},"doc://Systems/documentation/Systems/SystemProfile":{"abstract":[{"type":"text","text":"A resource that records how long each system takes to run."}],"identifier":"doc:\/\/Systems\/documentation\/Systems\/SystemProfile","kind":"symbol","url":"\/documentation\/systems\/systemprofile","navigatorTitle":[{"text":"SystemProfile","kind":"identifier"}],"role":"symbol","title":"SystemProfile","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"SystemProfile","kind":"identifier"}],"type":"topic"},"doc://Systems/documentation/Systems/ScheduledSystem":{"title":"ScheduledSystem","kind":"symbol","type":"topic","role":"symbol","navigatorTitle":[{"text":"ScheduledSystem","kind":"identifier"}],"url":"\/documentation\/systems\/scheduledsystem","identifier":"doc:\/\/Systems\/documentation\/Systems\/ScheduledSystem","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"ScheduledSystem","kind":"identifier"}],"abstract":[{"text":"A system together with the ordering constraints, sets and conditions a schedule runs it with.","type":"text"}]},"doc://Systems/documentation/Systems/ResourceReader":{"abstract":[{"text":"A system parameter that reads a resource.","type":"text"}],"identifier":"doc:\/\/Systems\/documentation\/Systems\/ResourceReader","kind":"symbol","url":"\/documentation\/systems\/resourcereader","navigatorTitle":[{"text":"ResourceReader","kind":"identifier"}],"role":"symbol","title":"ResourceReader","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"ResourceReader","kind":"identifier"}],"type":"topic"},"doc://Systems/documentation/Systems/ScheduleBuilder":{"title":"ScheduleBuilder","kind":"symbol","type":"topic","role":"symbol","navigatorTitle":[{"text":"ScheduleBuilder","kind":"identifier"}],"url":"\/documentation\/systems\/schedulebuilder","identifier":"doc:\/\/Systems\/documentation\/Systems\/ScheduleBuilder","fragments":[{"text":"enum","kind":"keyword"},{"text":" ","kind":"text"},{"text":"ScheduleBuilder","kind":"identifier"}],"abstract":[{"text":"A result builder that collects the systems written in a ","type":"text"},{"identifier":"doc:\/\/Systems\/documentation\/Systems\/Schedule","isActive":true,"type":"reference"},{"text":"’s closure.","type":"text"}]}}}