{"metadata":{"title":"Systems","symbolKind":"module","modules":[{"name":"Systems"}],"externalID":"Systems","roleHeading":"Framework","role":"collection"},"schemaVersion":{"major":0,"patch":0,"minor":3},"identifier":{"url":"doc:\/\/Systems\/documentation\/Systems","interfaceLanguage":"swift"},"abstract":[{"type":"text","text":"Declare the rules of a simulation as systems, and run them on a world in a schedule."}],"kind":"symbol","topicSections":[{"title":"Essentials","anchor":"Essentials","identifiers":["doc:\/\/Systems\/documentation\/Systems\/DeclaringSystems","doc:\/\/Systems\/documentation\/Systems\/DrivingAWorldFromAnApp","doc:\/\/Systems\/documentation\/Systems\/System()","doc:\/\/Systems\/documentation\/Systems\/System"]},{"title":"System Parameters","anchor":"System-Parameters","identifiers":["doc:\/\/Systems\/documentation\/Systems\/SystemParameter","doc:\/\/Systems\/documentation\/Systems\/Update","doc:\/\/Systems\/documentation\/Systems\/ResourceReader","doc:\/\/Systems\/documentation\/Systems\/ResourceWriter","doc:\/\/Systems\/documentation\/Systems\/EventReader","doc:\/\/Systems\/documentation\/Systems\/EventWriter","doc:\/\/Systems\/documentation\/Systems\/RemovedComponents"]},{"title":"Building and Running Schedules","anchor":"Building-and-Running-Schedules","identifiers":["doc:\/\/Systems\/documentation\/Systems\/Schedule","doc:\/\/Systems\/documentation\/Systems\/ScheduleBuilder","doc:\/\/Systems\/documentation\/Systems\/ScheduledSystem","doc:\/\/Systems\/documentation\/Systems\/SystemSet","doc:\/\/Systems\/documentation\/Systems\/CyclicOrdering","doc:\/\/Systems\/documentation\/Systems\/Ambiguity"]},{"title":"Main-Actor Systems","anchor":"Main-Actor-Systems","identifiers":["doc:\/\/Systems\/documentation\/Systems\/MainActorSystem"]},{"title":"Built-In Systems","anchor":"Built-In-Systems","identifiers":["doc:\/\/Systems\/documentation\/Systems\/UpdateEvents","doc:\/\/Systems\/documentation\/Systems\/ForwardEvents","doc:\/\/Systems\/documentation\/Systems\/ForwardChanges"]},{"title":"Profiling","anchor":"Profiling","identifiers":["doc:\/\/Systems\/documentation\/Systems\/SystemProfile","doc:\/\/Systems\/documentation\/Systems\/SystemTiming"]}],"primaryContentSections":[{"content":[{"text":"Overview","anchor":"Overview","type":"heading","level":2},{"type":"paragraph","inlineContent":[{"text":"A world holds data: entities and their components, and resources. A ","type":"text"},{"inlineContent":[{"text":"system","type":"text"}],"type":"emphasis"},{"text":" holds a rule: a","type":"text"},{"text":" ","type":"text"},{"text":"step that reads part of the world and changes part of it, such as “every entity with a velocity","type":"text"},{"text":" ","type":"text"},{"text":"moves” or “gravity pulls on everything that isn’t frozen.” A ","type":"text"},{"inlineContent":[{"type":"text","text":"schedule"}],"type":"emphasis"},{"text":" lists the systems of one","type":"text"},{"text":" ","type":"text"},{"text":"frame or step and runs them on a world, each once per run.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"The examples throughout this module use these components, resources and event:","type":"text"}]},{"code":["struct Position: Component { var x: Double, y: Double }","struct Velocity: Component { var dx: Double, dy: Double }","struct Health: Component { var current: Int }","struct Frozen: Component {}","","struct Score: Resource { var points: Int }","struct TimeStep: Resource { var seconds: Double }","struct Paused: Resource {}","","struct Damage: Event { var target: Entity, amount: Int }"],"syntax":"swift","type":"codeListing"},{"text":"Declare a System","anchor":"Declare-a-System","type":"heading","level":3},{"type":"paragraph","inlineContent":[{"type":"text","text":"The simplest way to write a system is to mark a type with the "},{"type":"codeVoice","code":"@System"},{"type":"text","text":" macro and give it a"},{"type":"text","text":" "},{"type":"codeVoice","code":"run"},{"type":"text","text":" method. The method’s parameters say what the system works on, and their types say how:"},{"type":"text","text":" "},{"type":"text","text":"an "},{"type":"reference","isActive":true,"identifier":"doc:\/\/Systems\/documentation\/Systems\/Update"},{"type":"text","text":" writes components, a "},{"type":"reference","isActive":true,"identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/Query"},{"type":"text","text":" reads them, and a "},{"type":"reference","isActive":true,"identifier":"doc:\/\/Systems\/documentation\/Systems\/ResourceReader"},{"type":"text","text":" "},{"type":"text","text":"reads a resource. The following two systems pull everything that isn’t frozen downward, then move"},{"type":"text","text":" "},{"type":"text","text":"it by its velocity:"}]},{"code":["@System","struct Gravity {","    func run(_ falling: Update<Velocity>.Where<Without<Frozen>>) {","        falling { velocity, _ in velocity.dy -= 10 }","    }","}","","@System","struct Movement {","    func run(_ movers: Update<Position>.Over<Velocity>.Where<Without<Frozen>>) {","        movers { position, row in","            position.x += row.components.dx","            position.y += row.components.dy","        }","    }","}"],"syntax":"swift","type":"codeListing"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Because the parameters’ types state what each system reads and writes, the macro writes the"},{"type":"text","text":" "},{"type":"text","text":"system’s "},{"identifier":"doc:\/\/Systems\/documentation\/Systems\/System\/access","isActive":true,"type":"reference"},{"type":"text","text":" for you: "},{"code":"Gravity","type":"codeVoice"},{"type":"text","text":" writes "},{"code":"Velocity","type":"codeVoice"},{"type":"text","text":"; "},{"code":"Movement","type":"codeVoice"},{"type":"text","text":" writes "},{"code":"Position","type":"codeVoice"},{"type":"text","text":" and"},{"type":"text","text":" "},{"type":"text","text":"reads "},{"code":"Velocity","type":"codeVoice"},{"type":"text","text":". A schedule uses the access to decide which systems can run at the same time."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"You can also conform a type to "},{"type":"reference","isActive":true,"identifier":"doc:\/\/Systems\/documentation\/Systems\/System"},{"type":"text","text":" by hand and write its "},{"type":"reference","isActive":true,"identifier":"doc:\/\/Systems\/documentation\/Systems\/System\/run(in:)"},{"type":"text","text":" method, which"},{"type":"text","text":" "},{"type":"text","text":"receives the whole world. See "},{"type":"reference","isActive":true,"identifier":"doc:\/\/Systems\/documentation\/Systems\/System"},{"type":"text","text":" for when to do that."}]},{"text":"Run Systems in a Schedule","anchor":"Run-Systems-in-a-Schedule","type":"heading","level":3},{"type":"paragraph","inlineContent":[{"type":"text","text":"A "},{"identifier":"doc:\/\/Systems\/documentation\/Systems\/Schedule","type":"reference","isActive":true},{"type":"text","text":" is built from a list of systems, written in a result builder. Running it runs each"},{"type":"text","text":" "},{"type":"text","text":"system once. The following example drops a ball for one frame:"}]},{"code":["var world = World()","let ball = world.spawn(Position(x: 0, y: 100), Velocity(dx: 1, dy: 0))","","let frame = Schedule {","    Gravity()","    Movement().after(Gravity.self)","}","frame.run(on: &world)","","print(world[Position.self, of: ball])","\/\/ Prints \"Position(x: 1.0, y: 90.0)\""],"syntax":"swift","type":"codeListing"},{"type":"paragraph","inlineContent":[{"text":"Systems run in the order you write them, unless an ordering constraint says otherwise.","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"after(_:)"},{"text":" and ","type":"text"},{"type":"codeVoice","code":"before(_:)"},{"text":" require one system to run after or before another; ","type":"text"},{"identifier":"doc:\/\/Systems\/documentation\/Systems\/SystemSet","isActive":true,"type":"reference"},{"text":" ","type":"text"},{"text":"names a group of systems so constraints can refer to all of them at once; and ","type":"text"},{"type":"codeVoice","code":"runIf(_:)"},{"text":" skips","type":"text"},{"text":" ","type":"text"},{"text":"a system when a condition doesn’t hold.","type":"text"}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Systems whose accesses don’t conflict, because neither writes what the other reads or writes,"},{"type":"text","text":" "},{"type":"text","text":"run at the same time, and the world ends as though they had run one after another (commands"},{"type":"text","text":" "},{"type":"text","text":"apply when each wave finishes). Systems that"},{"type":"text","text":" "},{"type":"text","text":"conflict run in order. When two conflicting systems aren’t ordered by any constraint, their order"},{"type":"text","text":" "},{"type":"text","text":"rests only on how they happen to be written; "},{"type":"reference","isActive":true,"identifier":"doc:\/\/Systems\/documentation\/Systems\/Schedule\/ambiguities()"},{"type":"text","text":" finds those pairs so a"},{"type":"text","text":" "},{"type":"text","text":"test can keep a schedule free of them."}]}],"kind":"content"}],"hierarchy":{"paths":[[]]},"sections":[],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/systems"]}],"references":{"doc://Systems/documentation/Systems/UpdateEvents":{"identifier":"doc:\/\/Systems\/documentation\/Systems\/UpdateEvents","navigatorTitle":[{"text":"UpdateEvents","kind":"identifier"}],"url":"\/documentation\/systems\/updateevents","title":"UpdateEvents","kind":"symbol","role":"symbol","type":"topic","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"UpdateEvents","kind":"identifier"}],"abstract":[{"type":"text","text":"A system that ends the current event update, dropping events old enough that every reader"},{"type":"text","text":" "},{"type":"text","text":"has had its chance to read them."}]},"doc://Systems/documentation/Systems/ForwardEvents":{"abstract":[{"text":"A system that yields each event of one type to an asynchronous stream, so code outside the","type":"text"},{"text":" ","type":"text"},{"text":"schedule can await the events.","type":"text"}],"title":"ForwardEvents","url":"\/documentation\/systems\/forwardevents","identifier":"doc:\/\/Systems\/documentation\/Systems\/ForwardEvents","kind":"symbol","type":"topic","role":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"ForwardEvents"}],"navigatorTitle":[{"kind":"identifier","text":"ForwardEvents"}]},"doc://WorldModule/documentation/WorldModule/Query":{"url":"\/documentation\/worldmodule\/query","abstract":[{"text":"A description of the entities to visit and the components to read from each.","type":"text"}],"kind":"symbol","navigatorTitle":[{"kind":"identifier","text":"Query"}],"identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/Query","type":"topic","role":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"Query"}],"title":"Query"},"doc://Systems/documentation/Systems/CyclicOrdering":{"identifier":"doc:\/\/Systems\/documentation\/Systems\/CyclicOrdering","navigatorTitle":[{"kind":"identifier","text":"CyclicOrdering"}],"title":"CyclicOrdering","url":"\/documentation\/systems\/cyclicordering","kind":"symbol","role":"symbol","type":"topic","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"CyclicOrdering"}],"abstract":[{"type":"text","text":"An error indicating that the ordering constraints of a schedule’s systems form a cycle, so no"},{"type":"text","text":" "},{"type":"text","text":"order satisfies them all."}]},"doc://Systems/documentation/Systems/ForwardChanges":{"title":"ForwardChanges","abstract":[{"text":"A system that yields each component of one type added or changed since it last ran to an","type":"text"},{"text":" ","type":"text"},{"text":"asynchronous stream, with its entity.","type":"text"}],"kind":"symbol","type":"topic","role":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"ForwardChanges","kind":"identifier"}],"url":"\/documentation\/systems\/forwardchanges","identifier":"doc:\/\/Systems\/documentation\/Systems\/ForwardChanges","navigatorTitle":[{"text":"ForwardChanges","kind":"identifier"}]},"doc://Systems/documentation/Systems/SystemTiming":{"url":"\/documentation\/systems\/systemtiming","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"SystemTiming","kind":"identifier"}],"type":"topic","title":"SystemTiming","abstract":[{"text":"The times one system of a schedule has taken to run.","type":"text"}],"kind":"symbol","role":"symbol","identifier":"doc:\/\/Systems\/documentation\/Systems\/SystemTiming","navigatorTitle":[{"text":"SystemTiming","kind":"identifier"}]},"doc://Systems/documentation/Systems/SystemSet":{"identifier":"doc:\/\/Systems\/documentation\/Systems\/SystemSet","navigatorTitle":[{"text":"SystemSet","kind":"identifier"}],"url":"\/documentation\/systems\/systemset","title":"SystemSet","kind":"symbol","role":"symbol","type":"topic","fragments":[{"text":"protocol","kind":"keyword"},{"text":" ","kind":"text"},{"text":"SystemSet","kind":"identifier"}],"abstract":[{"type":"text","text":"A type that names a group of systems, so ordering constraints can refer to all of them at"},{"type":"text","text":" "},{"type":"text","text":"once."}]},"doc://Systems/documentation/Systems/SystemParameter":{"abstract":[{"text":"A type a system’s ","type":"text"},{"code":"run","type":"codeVoice"},{"text":" method can take in place of the whole world, whose type states what","type":"text"},{"text":" ","type":"text"},{"text":"the system reads and writes.","type":"text"}],"url":"\/documentation\/systems\/systemparameter","kind":"symbol","identifier":"doc:\/\/Systems\/documentation\/Systems\/SystemParameter","title":"SystemParameter","type":"topic","fragments":[{"text":"protocol","kind":"keyword"},{"text":" ","kind":"text"},{"kind":"identifier","text":"SystemParameter"}],"role":"symbol","navigatorTitle":[{"kind":"identifier","text":"SystemParameter"}]},"doc://Systems/documentation/Systems/Update":{"identifier":"doc:\/\/Systems\/documentation\/Systems\/Update","navigatorTitle":[{"text":"Update","kind":"identifier"}],"url":"\/documentation\/systems\/update","title":"Update","kind":"symbol","role":"symbol","type":"topic","fragments":[{"text":"class","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Update","kind":"identifier"}],"abstract":[{"text":"A system parameter that changes a component of every entity that holds it.","type":"text"}]},"doc://Systems/documentation/Systems/EventWriter":{"title":"EventWriter","abstract":[{"text":"A system parameter that sends events of one type.","type":"text"}],"kind":"symbol","type":"topic","role":"symbol","fragments":[{"text":"class","kind":"keyword"},{"text":" ","kind":"text"},{"text":"EventWriter","kind":"identifier"}],"url":"\/documentation\/systems\/eventwriter","identifier":"doc:\/\/Systems\/documentation\/Systems\/EventWriter","navigatorTitle":[{"text":"EventWriter","kind":"identifier"}]},"doc://Systems/documentation/Systems/System/access":{"url":"\/documentation\/systems\/system\/access","required":true,"fragments":[{"text":"var","kind":"keyword"},{"text":" ","kind":"text"},{"text":"access","kind":"identifier"},{"text":": ","kind":"text"},{"text":"Access","kind":"typeIdentifier","preciseIdentifier":"s:11WorldModule6AccessV"},{"text":"?","kind":"text"}],"type":"topic","title":"access","abstract":[{"type":"text","text":"The component, resource and event types the system reads and writes, or "},{"type":"codeVoice","code":"nil"},{"type":"text","text":" if it may"},{"type":"text","text":" "},{"type":"text","text":"change anything."}],"kind":"symbol","role":"symbol","identifier":"d