{"hierarchy":{"paths":[[]]},"schemaVersion":{"major":0,"patch":0,"minor":3},"metadata":{"title":"Systems","externalID":"Systems","role":"collection","symbolKind":"module","roleHeading":"Framework","modules":[{"name":"Systems"}]},"topicSections":[{"anchor":"Essentials","title":"Essentials","identifiers":["doc:\/\/Systems\/documentation\/Systems\/DeclaringSystems","doc:\/\/Systems\/documentation\/Systems\/DrivingAWorldFromAnApp","doc:\/\/Systems\/documentation\/Systems\/System()","doc:\/\/Systems\/documentation\/Systems\/System"]},{"anchor":"System-Parameters","title":"System Parameters","identifiers":["doc:\/\/Systems\/documentation\/Systems\/SystemParameter","doc:\/\/Systems\/documentation\/Systems\/Update","doc:\/\/Systems\/documentation\/Systems\/ResourceReader","doc:\/\/Systems\/documentation\/Systems\/ResourceWriter","doc:\/\/Systems\/documentation\/Systems\/EventReader","doc:\/\/Systems\/documentation\/Systems\/EventWriter","doc:\/\/Systems\/documentation\/Systems\/RemovedComponents"]},{"anchor":"Building-and-Running-Schedules","title":"Building and Running Schedules","identifiers":["doc:\/\/Systems\/documentation\/Systems\/Schedule","doc:\/\/Systems\/documentation\/Systems\/ScheduleBuilder","doc:\/\/Systems\/documentation\/Systems\/ScheduledSystem","doc:\/\/Systems\/documentation\/Systems\/SystemSet","doc:\/\/Systems\/documentation\/Systems\/CyclicOrdering","doc:\/\/Systems\/documentation\/Systems\/Ambiguity"]},{"anchor":"Main-Actor-Systems","title":"Main-Actor Systems","identifiers":["doc:\/\/Systems\/documentation\/Systems\/MainActorSystem"]},{"anchor":"Built-In-Systems","title":"Built-In Systems","identifiers":["doc:\/\/Systems\/documentation\/Systems\/UpdateEvents","doc:\/\/Systems\/documentation\/Systems\/ForwardEvents","doc:\/\/Systems\/documentation\/Systems\/ForwardChanges"]},{"anchor":"Profiling","title":"Profiling","identifiers":["doc:\/\/Systems\/documentation\/Systems\/SystemProfile","doc:\/\/Systems\/documentation\/Systems\/SystemTiming"]}],"abstract":[{"type":"text","text":"Declare the rules of a simulation as systems, and run them on a world in a schedule."}],"kind":"symbol","variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/systems"]}],"sections":[],"identifier":{"url":"doc:\/\/Systems\/documentation\/Systems","interfaceLanguage":"swift"},"primaryContentSections":[{"content":[{"text":"Overview","level":2,"type":"heading","anchor":"Overview"},{"type":"paragraph","inlineContent":[{"type":"text","text":"A world holds data: entities and their components, and resources. A "},{"type":"emphasis","inlineContent":[{"text":"system","type":"text"}]},{"type":"text","text":" holds a rule: a"},{"type":"text","text":" "},{"type":"text","text":"step that reads part of the world and changes part of it, such as “every entity with a velocity"},{"type":"text","text":" "},{"type":"text","text":"moves” or “gravity pulls on everything that isn’t frozen.” A "},{"type":"emphasis","inlineContent":[{"text":"schedule","type":"text"}]},{"type":"text","text":" lists the systems of one"},{"type":"text","text":" "},{"type":"text","text":"frame or step and runs them on a world, each once per run."}]},{"type":"paragraph","inlineContent":[{"text":"The examples throughout this module use these components, resources and event:","type":"text"}]},{"syntax":"swift","type":"codeListing","code":["struct Position: Component { var x: Double, y: Double }","struct Velocity: Component { var dx: Double, dy: Double }","struct Health: Component { var current: Int }","struct Frozen: Component {}","","struct Score: Resource { var points: Int }","struct TimeStep: Resource { var seconds: Double }","struct Paused: Resource {}","","struct Damage: Event { var target: Entity, amount: Int }"]},{"text":"Declare a System","level":3,"type":"heading","anchor":"Declare-a-System"},{"type":"paragraph","inlineContent":[{"text":"The simplest way to write a system is to mark a type with the ","type":"text"},{"code":"@System","type":"codeVoice"},{"text":" macro and give it a","type":"text"},{"text":" ","type":"text"},{"code":"run","type":"codeVoice"},{"text":" method. The method’s parameters say what the system works on, and their types say how:","type":"text"},{"text":" ","type":"text"},{"text":"an ","type":"text"},{"identifier":"doc:\/\/Systems\/documentation\/Systems\/Update","type":"reference","isActive":true},{"text":" writes components, a ","type":"text"},{"identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/Query","type":"reference","isActive":true},{"text":" reads them, and a ","type":"text"},{"identifier":"doc:\/\/Systems\/documentation\/Systems\/ResourceReader","type":"reference","isActive":true},{"text":" ","type":"text"},{"text":"reads a resource. The following two systems pull everything that isn’t frozen downward, then move","type":"text"},{"text":" ","type":"text"},{"text":"it by its velocity:","type":"text"}]},{"syntax":"swift","type":"codeListing","code":["@System","struct Gravity {","    func run(_ falling: Update<Velocity>.Where<Without<Frozen>>) {","        falling { velocity, _ in velocity.dy -= 10 }","    }","}","","@System","struct Movement {","    func run(_ movers: Update<Position>.Over<Velocity>.Where<Without<Frozen>>) {","        movers { position, row in","            position.x += row.components.dx","            position.y += row.components.dy","        }","    }","}"]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Because the parameters’ types state what each system reads and writes, the macro writes the"},{"type":"text","text":" "},{"type":"text","text":"system’s "},{"isActive":true,"identifier":"doc:\/\/Systems\/documentation\/Systems\/System\/access","type":"reference"},{"type":"text","text":" for you: "},{"type":"codeVoice","code":"Gravity"},{"type":"text","text":" writes "},{"type":"codeVoice","code":"Velocity"},{"type":"text","text":"; "},{"type":"codeVoice","code":"Movement"},{"type":"text","text":" writes "},{"type":"codeVoice","code":"Position"},{"type":"text","text":" and"},{"type":"text","text":" "},{"type":"text","text":"reads "},{"type":"codeVoice","code":"Velocity"},{"type":"text","text":". A schedule uses the access to decide which systems can run at the same time."}]},{"type":"paragraph","inlineContent":[{"text":"You can also conform a type to ","type":"text"},{"identifier":"doc:\/\/Systems\/documentation\/Systems\/System","type":"reference","isActive":true},{"text":" by hand and write its ","type":"text"},{"identifier":"doc:\/\/Systems\/documentation\/Systems\/System\/run(in:)","type":"reference","isActive":true},{"text":" method, which","type":"text"},{"text":" ","type":"text"},{"text":"receives the whole world. See ","type":"text"},{"identifier":"doc:\/\/Systems\/documentation\/Systems\/System","type":"reference","isActive":true},{"text":" for when to do that.","type":"text"}]},{"text":"Run Systems in a Schedule","level":3,"type":"heading","anchor":"Run-Systems-in-a-Schedule"},{"type":"paragraph","inlineContent":[{"type":"text","text":"A "},{"type":"reference","isActive":true,"identifier":"doc:\/\/Systems\/documentation\/Systems\/Schedule"},{"type":"text","text":" is built from a list of systems, written in a result builder. Running it runs each"},{"type":"text","text":" "},{"type":"text","text":"system once. The following example drops a ball for one frame:"}]},{"syntax":"swift","type":"codeListing","code":["var world = World()","let ball = world.spawn(Position(x: 0, y: 100), Velocity(dx: 1, dy: 0))","","let frame = Schedule {","    Gravity()","    Movement().after(Gravity.self)","}","frame.run(on: &world)","","print(world[Position.self, of: ball])","\/\/ Prints \"Position(x: 1.0, y: 90.0)\""]},{"type":"paragraph","inlineContent":[{"text":"Systems run in the order you write them, unless an ordering constraint says otherwise.","type":"text"},{"text":" ","type":"text"},{"code":"after(_:)","type":"codeVoice"},{"text":" and ","type":"text"},{"code":"before(_:)","type":"codeVoice"},{"text":" require one system to run after or before another; ","type":"text"},{"type":"reference","identifier":"doc:\/\/Systems\/documentation\/Systems\/SystemSet","isActive":true},{"text":" ","type":"text"},{"text":"names a group of systems so constraints can refer to all of them at once; and ","type":"text"},{"code":"runIf(_:)","type":"codeVoice"},{"text":" skips","type":"text"},{"text":" ","type":"text"},{"text":"a system when a condition doesn’t hold.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"Systems whose accesses don’t conflict, because neither writes what the other reads or writes,","type":"text"},{"text":" ","type":"text"},{"text":"run at the same time, and the world ends as though they had run one after another (commands","type":"text"},{"text":" ","type":"text"},{"text":"apply when each wave finishes). Systems that","type":"text"},{"text":" ","type":"text"},{"text":"conflict run in order. When two conflicting systems aren’t ordered by any constraint, their order","type":"text"},{"text":" ","type":"text"},{"text":"rests only on how they happen to be written; ","type":"text"},{"identifier":"doc:\/\/Systems\/documentation\/Systems\/Schedule\/ambiguities()","type":"reference","isActive":true},{"text":" finds those pairs so a","type":"text"},{"text":" ","type":"text"},{"text":"test can keep a schedule free of them.","type":"text"}]}],"kind":"content"}],"references":{"doc://Systems/documentation/Systems/SystemProfile":{"role":"symbol","navigatorTitle":[{"kind":"identifier","text":"SystemProfile"}],"identifier":"doc:\/\/Systems\/documentation\/Systems\/SystemProfile","kind":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"SystemProfile"}],"title":"SystemProfile","abstract":[{"type":"text","text":"A resource that records how long each system takes to run."}],"type":"topic","url":"\/documentation\/systems\/systemprofile"},"doc://Systems/documentation/Systems/SystemSet":{"title":"SystemSet","type":"topic","kind":"symbol","abstract":[{"text":"A type that names a group of systems, so ordering constraints can refer to all of them at","type":"text"},{"text":" ","type":"text"},{"text":"once.","type":"text"}],"role":"symbol","url":"\/documentation\/systems\/systemset","identifier":"doc:\/\/Systems\/documentation\/Systems\/SystemSet","fragments":[{"kind":"keyword","text":"protocol"},{"kind":"text","text":" "},{"kind":"identifier","text":"SystemSet"}],"navigatorTitle":[{"kind":"identifier","text":"SystemSet"}]},"doc://Systems/documentation/Systems/EventWriter":{"role":"symbol","navigatorTitle":[{"text":"EventWriter","kind":"identifier"}],"identifier":"doc:\/\/Systems\/documentation\/Systems\/EventWriter","kind":"symbol","fragments":[{"text":"class","kind":"keyword"},{"text":" ","kind":"text"},{"text":"EventWriter","kind":"identifier"}],"title":"EventWriter","abstract":[{"text":"A system parameter that sends events of one type.","type":"text"}],"type":"topic","url":"\/documentation\/systems\/eventwriter"},"doc://Systems/documentation/Systems/MainActorSystem":{"role":"symbol","navigatorTitle":[{"text":"MainActorSystem","kind":"identifier"}],"identifier":"doc:\/\/Systems\/documentation\/Systems\/MainActorSystem","kind":"symbol","fragments":[{"text":"protocol","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MainActorSystem","kind":"identifier"}],"title":"MainActorSystem","abstract":[{"type":"text","text":"A system that runs on the main actor, for work that touches main-actor state such as a user"},{"type":"text","text":" "},{"type":"text","text":"interface."}],"type":"topic","url":"\/documentation\/systems\/mainactorsystem"},"doc://Systems/documentation/Systems/ForwardChanges":{"url":"\/documentation\/systems\/forwardchanges","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"ForwardChanges"}],"abstract":[{"type":"text","text":"A system that yields each component of one type added or changed since it last ran to an"},{"type":"text","text":" "},{"type":"text","text":"asynchronous stream, with its entity."}],"role":"symbol","type":"topic","navigatorTitle":[{"kind":"identifier","text":"ForwardChanges"}],"kind":"symbol","identifier":"doc:\/\/Systems\/documentation\/Systems\/ForwardChanges","title":"ForwardChanges"},"doc://Systems/documentation/Systems/EventReader":{"fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"EventReader","kind":"identifier"}],"navigatorTitle":[{"text":"EventReader","kind":"identifier"}],"abstract":[{"type":"text","text":"A system parameter that reads the events of one type sent since the system last read them."}],"url":"\/documentation\/systems\/eventreader","role":"symbol","title":"EventReader","type":"topic","kind":"symbol","identifier":"doc:\/\/Systems\/documentation\/Systems\/EventReader"},"doc://Systems/documentation/Systems/Schedule":{"role":"symbol","navigatorTitle":[{"kind":"identifier","text":"Schedule"}],"kind":"symbol","identifier":"doc:\/\/Systems\/documentation\/Systems\/Schedule","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"Schedule"}],"title":"Schedule","abstract":[{"text":"A list of systems that run on a world, in order, and at the same time where they can.","type":"text"}],"type":"topic","url":"\/documentation\/systems\/schedule"},"doc://Systems/documentation/Systems/SystemTiming":{"identifier":"doc:\/\/Systems\/documentation\/Systems\/SystemTiming","kind":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"SystemTiming","kind":"identifier"}],"abstract":[{"type":"text","text":"The times one system of a schedule has taken to run."}],"role":"symbol","url":"\/documentation\/systems\/systemtiming","type":"topic","title":"SystemTiming","navigatorTitle":[{"text":"SystemTiming","kind":"identifier"}]},"doc://Systems/documentation/Systems/System/access":{"role":"symbol","required":true,"identifier":"doc:\/\/Systems\/documentation\/Systems\/System\/access","kind":"symbol","fragments":[{"kind":"keyword","text":"var"},{"kind":"text","text":" "},{"kind":"identifier","text":"access"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:11WorldModule6AccessV","text":"Access"},{"kind":"text","text":"?"}],"defaultImplementations":1,"title":"access","abstract":[{"text":"The component, resource and event types the system reads and writes, or ","type":"text"},{"code":"nil","type":"codeVoice"},{"text":" if it may","type":"text"},{"text":" ","type":"text"},{"text":"change anything.","type":"text"}],"type":"topic","url":"\/documentation\/systems\/system\/access"},"doc://Systems/documentation/Systems/System()":{"role":"symbol","kind":"symbol","identifier":"doc:\/\/Systems\/documentation\/Systems\/System()","fragments":[{"text":"macro","kind":"keyword"},{"text":" ","kind":"text"},{"text":"System","kind":"identifier"},{"text":"()","kind":"text"}],"title":"System()","abstract":[{"type":"text","text":"Makes a type a system whose access comes from the parameters of its "},{"type":"codeVoice","code":"run"},{"type":"text","text":" method."}],"type":"topic","url":"\/documentation\/systems\/system()"},"doc://Systems/documentation/Systems/Ambiguity":{"title":"Ambiguity","type":"topic","kind":"symbol","abstract":[{"type":"text","text":"Two systems of a schedule whose accesses conflict but that no ordering constraint orders, so"},{"type":"text","text":" "},{"type":"text","text":"the order they run in rests only on the order they were written in."}],"role":"symbol","url":"\/documentation\/systems\/ambiguity","identifier":"doc:\/\/Systems\/documentation\/Systems\/Ambiguity","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Ambiguity","kind":"identifier"}],"navigatorTitle":[{"text":"Ambiguity","kind":"identifier"}]},"doc://Systems/documentation/Systems/RemovedComponents":{"navigatorTitle":[{"kind":"identifier","text":"RemovedComponents"}],"type":"topic","abstract":[{"text":"A system parameter that lists the entities that lost a component since the system last read","type":"text"},{"text":" ","type":"text"},{"text":"them.","type":"text"}],"fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"RemovedComponents"}],"role":"symbol","url":"\/documentation\/systems\/removedcomponents","kind":"symbol","identifier":"doc:\/\/Systems\/documentation\/Systems\/RemovedComponents","title":"RemovedComponents"},"doc://Systems/documentation/Systems/DrivingAWorldFromAnApp":{"title":"Driving a World from an App","type":"topic","kind":"article","abstract":[{"text":"Hold a world in your app or game engine, feed it each frame’s input, and let the objects outside","type":"text"},{"text":" ","type":"text"},{"text":"it read results and take part in a step.","type":"text"}],"role":"article","url":"\/documentation\/systems\/drivingaworldfromanapp","identifier":"doc:\/\/Systems\/documentation\/Systems\/DrivingAWorldFromAnApp"},"doc://Systems/documentation/Systems/Schedule/ambiguities()":{"identifier":"doc:\/\/Systems\/documentation\/Systems\/Schedule\/ambiguities()","kind":"symbol","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"ambiguities","kind":"identifier"},{"text":"() -> [","kind":"text"},{"text":"Ambiguity","kind":"typeIdentifier","preciseIdentifier":"s:7Systems9AmbiguityV"},{"text":"]","kind":"text"}],"abstract":[{"type":"text","text":"Returns every pair of systems whose accesses conflict but that no ordering constraint"},{"type":"text","text":" "},{"type":"text","text":"orders."}],"role":"symbol","url":"\/documentation\/systems\/schedule\/ambiguities()","type":"topic","title":"ambiguities()"},"doc://Systems/documentation/Systems/SystemParameter":{"role":"symbol","navigatorTitle":[{"kind":"identifier","text":"SystemParameter"}],"kind":"symbol","identifier":"doc:\/\/Systems\/documentation\/Systems\/SystemParameter","fragments":[{"text":"protocol","kind":"keyword"},{"text":" ","kind":"text"},{"kind":"identifier","text":"SystemParameter"}],"title":"SystemParameter","abstract":[{"text":"A type a system’s ","type":"text"},{"code":"run","type":"codeVoice"},{"text":" method can take in place of the whole world, whose type states what","type":"text"},{"text":" ","type":"text"},{"text":"the system reads and writes.","type":"text"}],"type":"topic","url":"\/documentation\/systems\/systemparameter"},"doc://Systems/documentation/Systems/DeclaringSystems":{"title":"Declaring Systems","type":"topic","kind":"article","abstract":[{"text":"Write the rules of a simulation as systems, and let their parameters state what they read and","type":"text"},{"text":" ","type":"text"},{"text":"write.","type":"text"}],"role":"collectionGroup","url":"\/documentation\/systems\/declaringsystems","identifier":"doc:\/\/Systems\/documentation\/Systems\/DeclaringSystems"},"doc://Systems/documentation/Systems/System/run(in:)":{"title":"run(in:)","type":"topic","kind":"symbol","abstract":[{"text":"Runs the system’s rule once on a world.","type":"text"}],"required":true,"role":"symbol","url":"\/documentation\/systems\/system\/run(in:)","identifier":"doc:\/\/Systems\/documentation\/Systems\/System\/run(in:)","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"run","kind":"identifier"},{"text":"(","kind":"text"},{"text":"in","kind":"externalParam"},{"text":": ","kind":"text"},{"kind":"keyword","text":"inout"},{"kind":"text","text":" "},{"preciseIdentifier":"s:11WorldModule0A0V","kind":"typeIdentifier","text":"World"},{"kind":"text","text":")"}]},"doc://Systems/documentation/Systems/ScheduleBuilder":{"role":"symbol","navigatorTitle":[{"text":"ScheduleBuilder","kind":"identifier"}],"identifier":"doc:\/\/Systems\/documentation\/Systems\/ScheduleBuilder","kind":"symbol","fragments":[{"text":"enum","kind":"keyword"},{"text":" ","kind":"text"},{"text":"ScheduleBuilder","kind":"identifier"}],"title":"ScheduleBuilder","type":"topic","abstract":[{"text":"A result builder that collects the systems written in a ","type":"text"},{"identifier":"doc:\/\/Systems\/documentation\/Systems\/Schedule","isActive":true,"type":"reference"},{"text":"’s closure.","type":"text"}],"url":"\/documentation\/systems\/schedulebuilder"},"doc://Systems/documentation/Systems":{"kind":"symbol","url":"\/documentation\/systems","title":"Systems","role":"collection","type":"topic","identifier":"doc:\/\/Systems\/documentation\/Systems","abstract":[{"type":"text","text":"Declare the rules of a simulation as systems, and run them on a world in a schedule."}]},"doc://Systems/documentation/Systems/ForwardEvents":{"title":"ForwardEvents","type":"topic","kind":"symbol","abstract":[{"text":"A system that yields each event of one type to an asynchronous stream, so code outside the","type":"text"},{"text":" ","type":"text"},{"text":"schedule can await the events.","type":"text"}],"role":"symbol","url":"\/documentation\/systems\/forwardevents","identifier":"doc:\/\/Systems\/documentation\/Systems\/ForwardEvents","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"ForwardEvents","kind":"identifier"}],"navigatorTitle":[{"text":"ForwardEvents","kind":"identifier"}]},"doc://WorldModule/documentation/WorldModule/Query":{"role":"symbol","navigatorTitle":[{"text":"Query","kind":"identifier"}],"identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/Query","kind":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Query","kind":"identifier"}],"title":"Query","abstract":[{"type":"text","text":"A description of the entities to visit and the components to read from each."}],"type":"topic","url":"\/documentation\/worldmodule\/query"},"doc://Systems/documentation/Systems/System":{"title":"System","type":"topic","kind":"symbol","abstract":[{"text":"A rule that reads and changes a world, run once each time its schedule runs.","type":"text"}],"role":"symbol","url":"\/documentation\/systems\/system","identifier":"doc:\/\/Systems\/documentation\/Systems\/System","fragments":[{"text":"protocol","kind":"keyword"},{"text":" ","kind":"text"},{"text":"System","kind":"identifier"}],"navigatorTitle":[{"text":"System","kind":"identifier"}]},"doc://Systems/documentation/Systems/ScheduledSystem":{"fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"ScheduledSystem"}],"navigatorTitle":[{"kind":"identifier","text":"ScheduledSystem"}],"abstract":[{"type":"text","text":"A system together with the ordering constraints, sets and conditions a schedule runs it with."}],"url":"\/documentation\/systems\/scheduledsystem","role":"symbol","title":"ScheduledSystem","kind":"symbol","type":"topic","identifier":"doc:\/\/Systems\/documentation\/Systems\/ScheduledSystem"},"doc://Systems/documentation/Systems/ResourceReader":{"title":"ResourceReader","type":"topic","kind":"symbol","abstract":[{"text":"A system parameter that reads a resource.","type":"text"}],"role":"symbol","url":"\/documentation\/systems\/resourcereader","identifier":"doc:\/\/Systems\/documentation\/Systems\/ResourceReader","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"ResourceReader","kind":"identifier"}],"navigatorTitle":[{"text":"ResourceReader","kind":"identifier"}]},"doc://Systems/documentation/Systems/Update":{"kind":"symbol","navigatorTitle":[{"kind":"identifier","text":"Update"}],"title":"Update","url":"\/documentation\/systems\/update","role":"symbol","fragments":[{"kind":"keyword","text":"class"},{"kind":"text","text":" "},{"kind":"identifier","text":"Update"}],"type":"topic","abstract":[{"text":"A system parameter that changes a component of every entity that holds it.","type":"text"}],"identifier":"doc:\/\/Systems\/documentation\/Systems\/Update"},"doc://Systems/documentation/Systems/UpdateEvents":{"kind":"symbol","navigatorTitle":[{"text":"UpdateEvents","kind":"identifier"}],"url":"\/documentation\/systems\/updateevents","title":"UpdateEvents","role":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"UpdateEvents","kind":"identifier"}],"type":"topic","identifier":"doc:\/\/Systems\/documentation\/Systems\/UpdateEvents","abstract":[{"text":"A system that ends the current event update, dropping events old enough that every reader","type":"text"},{"text":" ","type":"text"},{"text":"has had its chance to read them.","type":"text"}]},"doc://Systems/documentation/Systems/ResourceWriter":{"fragments":[{"kind":"keyword","text":"class"},{"kind":"text","text":" "},{"kind":"identifier","text":"ResourceWriter"}],"navigatorTitle":[{"kind":"identifier","text":"ResourceWriter"}],"abstract":[{"type":"text","text":"A system parameter that reads and writes a resource."}],"url":"\/documentation\/systems\/resourcewriter","role":"symbol","title":"ResourceWriter","type":"topic","kind":"symbol","identifier":"doc:\/\/Systems\/documentation\/Systems\/ResourceWriter"},"doc://Systems/documentation/Systems/CyclicOrdering":{"role":"symbol","navigatorTitle":[{"kind":"identifier","text":"CyclicOrdering"}],"kind":"symbol","identifier":"doc:\/\/Systems\/documentation\/Systems\/CyclicOrdering","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"CyclicOrdering"}],"title":"CyclicOrdering","abstract":[{"type":"text","text":"An error indicating that the ordering constraints of a schedule’s systems form a cycle, so no"},{"type":"text","text":" "},{"type":"text","text":"order satisfies them all."}],"type":"topic","url":"\/documentation\/systems\/cyclicordering"}}}