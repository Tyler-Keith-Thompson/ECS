":"Declaring Systems","url":"\/documentation\/systems\/declaringsystems","identifier":"doc:\/\/Systems\/documentation\/Systems\/DeclaringSystems","type":"topic","role":"collectionGroup","kind":"article","abstract":[{"type":"text","text":"Write the rules of a simulation as systems, and let their parameters state what they read and"},{"type":"text","text":" "},{"type":"text","text":"write."}]},"doc://Systems/documentation/Systems/SystemTiming":{"title":"SystemTiming","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"SystemTiming"}],"url":"\/documentation\/systems\/systemtiming","identifier":"doc:\/\/Systems\/documentation\/Systems\/SystemTiming","type":"topic","navigatorTitle":[{"kind":"identifier","text":"SystemTiming"}],"role":"symbol","kind":"symbol","abstract":[{"type":"text","text":"The times one system of a schedule has taken to run."}]},"doc://Systems/documentation/Systems/SystemParameter":{"kind":"symbol","fragments":[{"text":"protocol","kind":"keyword"},{"text":" ","kind":"text"},{"text":"SystemParameter","kind":"identifier"}],"navigatorTitle":[{"text":"SystemParameter","kind":"identifier"}],"identifier":"doc:\/\/Systems\/documentation\/Systems\/SystemParameter","title":"SystemParameter","abstract":[{"text":"A type a system’s ","type":"text"},{"code":"run","type":"codeVoice"},{"text":" method can take in place of the whole world, whose type states what","type":"text"},{"text":" ","type":"text"},{"text":"the system reads and writes.","type":"text"}],"url":"\/documentation\/systems\/systemparameter","type":"topic","role":"symbol"},"doc://Systems/documentation/Systems/SystemSet":{"title":"SystemSet","fragments":[{"text":"protocol","kind":"keyword"},{"text":" ","kind":"text"},{"text":"SystemSet","kind":"identifier"}],"url":"\/documentation\/systems\/systemset","identifier":"doc:\/\/Systems\/documentation\/Systems\/SystemSet","type":"topic","navigatorTitle":[{"text":"SystemSet","kind":"identifier"}],"role":"symbol","kind":"symbol","abstract":[{"type":"text","text":"A type that names a group of systems, so ordering constraints can refer to all of them at"},{"type":"text","text":" "},{"type":"text","text":"once."}]},"doc://Systems/documentation/Systems/System/access":{"kind":"symbol","required":true,"fragments":[{"text":"var","kind":"keyword"},{"text":" ","kind":"text"},{"text":"access","kind":"identifier"},{"text":": ","kind":"text"},{"text":"Access","kind":"typeIdentifier","preciseIdentifier":"s:11WorldModule6AccessV"},{"text":"?","kind":"text"}],"identifier":"doc:\/\/Systems\/documentation\/Systems\/System\/access","defaultImplementations":1,"title":"access","abstract":[{"type":"text","text":"The component, resource and event types the system reads and writes, or "},{"code":"nil","type":"codeVoice"},{"type":"text","text":" if it may"},{"type":"text","text":" "},{"type":"text","text":"change anything."}],"url":"\/documentation\/systems\/system\/access","type":"topic","role":"symbol"},"doc://Systems/documentation/Systems/System":{"navigatorTitle":[{"text":"System","kind":"identifier"}],"abstract":[{"type":"text","text":"A rule that reads and changes a world, run once each time its schedule runs."}],"role":"symbol","fragments":[{"text":"protocol","kind":"keyword"},{"text":" ","kind":"text"},{"text":"System","kind":"identifier"}],"type":"topic","kind":"symbol","identifier":"doc:\/\/Systems\/documentation\/Systems\/System","title":"System","url":"\/documentation\/systems\/system"},"doc://Systems/documentation/Systems/CyclicOrdering":{"identifier":"doc:\/\/Systems\/documentation\/Systems\/CyclicOrdering","type":"topic","kind":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"CyclicOrdering"}],"role":"symbol","title":"CyclicOrdering","url":"\/documentation\/systems\/cyclicordering","abstract":[{"type":"text","text":"An error indicating that the ordering constraints of a schedule’s systems form a cycle, so no"},{"typ