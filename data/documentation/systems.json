{"abstract":[{"type":"text","text":"Declare the rules of a simulation as systems, and run them on a world in a schedule."}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/systems"]}],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/Systems\/documentation\/Systems"},"metadata":{"modules":[{"name":"Systems"}],"roleHeading":"Framework","symbolKind":"module","externalID":"Systems","title":"Systems","role":"collection"},"kind":"symbol","topicSections":[{"title":"Essentials","identifiers":["doc:\/\/Systems\/documentation\/Systems\/DeclaringSystems","doc:\/\/Systems\/documentation\/Systems\/System()","doc:\/\/Systems\/documentation\/Systems\/System"],"anchor":"Essentials"},{"title":"System Parameters","identifiers":["doc:\/\/Systems\/documentation\/Systems\/SystemParameter","doc:\/\/Systems\/documentation\/Systems\/Update","doc:\/\/Systems\/documentation\/Systems\/ResourceReader","doc:\/\/Systems\/documentation\/Systems\/ResourceWriter","doc:\/\/Systems\/documentation\/Systems\/EventReader","doc:\/\/Systems\/documentation\/Systems\/EventWriter","doc:\/\/Systems\/documentation\/Systems\/RemovedComponents"],"anchor":"System-Parameters"},{"title":"Building and Running Schedules","identifiers":["doc:\/\/Systems\/documentation\/Systems\/Schedule","doc:\/\/Systems\/documentation\/Systems\/ScheduleBuilder","doc:\/\/Systems\/documentation\/Systems\/ScheduledSystem","doc:\/\/Systems\/documentation\/Systems\/SystemSet","doc:\/\/Systems\/documentation\/Systems\/CyclicOrdering","doc:\/\/Systems\/documentation\/Systems\/Ambiguity"],"anchor":"Building-and-Running-Schedules"},{"title":"Main-Actor Systems","identifiers":["doc:\/\/Systems\/documentation\/Systems\/MainActorSystem"],"anchor":"Main-Actor-Systems"},{"title":"Built-In Systems","identifiers":["doc:\/\/Systems\/documentation\/Systems\/UpdateEvents","doc:\/\/Systems\/documentation\/Systems\/ForwardEvents","doc:\/\/Systems\/documentation\/Systems\/ForwardChanges"],"anchor":"Built-In-Systems"},{"title":"Profiling","identifiers":["doc:\/\/Systems\/documentation\/Systems\/SystemProfile","doc:\/\/Systems\/documentation\/Systems\/SystemTiming"],"anchor":"Profiling"}],"primaryContentSections":[{"kind":"content","content":[{"anchor":"Overview","text":"Overview","level":2,"type":"heading"},{"inlineContent":[{"type":"text","text":"A world holds data: entities and their components, and resources. A "},{"type":"emphasis","inlineContent":[{"type":"text","text":"system"}]},{"type":"text","text":" holds a rule: a"},{"type":"text","text":" "},{"type":"text","text":"step that reads part of the world and changes part of it, such as “every entity with a velocity"},{"type":"text","text":" "},{"type":"text","text":"moves” or “gravity pulls on everything that isn’t frozen.” A "},{"type":"emphasis","inlineContent":[{"type":"text","text":"schedule"}]},{"type":"text","text":" lists the systems of one"},{"type":"text","text":" "},{"type":"text","text":"frame or step and runs them on a world, each once per run."}],"type":"paragraph"},{"inlineContent":[{"text":"The examples throughout this module use these components, resources and event:","type":"text"}],"type":"paragraph"},{"syntax":"swift","code":["struct Position: Component { var x: Double, y: Double }","struct Velocity: Component { var dx: Double, dy: Double }","struct Health: Component { var current: Int }","struct Frozen: Component {}","","struct Score: Resource { var points: Int }","struct TimeStep: Resource { var seconds: Double }","struct Paused: Resource {}","","struct Damage: Event { var target: Entity, amount: Int }"],"type":"codeListing"},{"anchor":"Declare-a-System","text":"Declare a System","level":3,"type":"heading"},{"inlineContent":[{"text":"The simplest way to write a system is to mark a type with the ","type":"text"},{"code":"@System","type":"codeVoice"},{"text":" macro and give it a","type":"text"},{"text":" ","type":"text"},{"code":"run","type":"codeVoice"},{"text":" method. The method’s parameters say what the system works on, and their types say how:","type":"text"},{"text":" ","type":"text"},{"text":"an ","type":"text"},{"isActive":true,"identifier":"doc:\/\/Systems\/documentation\/Systems\/Update","type":"reference"},{"text":" writes components, a ","type":"text"},{"isActive":true,"identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/Query","type":"reference"},{"text":" reads them, and a ","type":"text"},{"isActive":true,"identifier":"doc:\/\/Systems\/documentation\/Systems\/ResourceReader","type":"reference"},{"text":" ","type":"text"},{"text":"reads a resource. The following two systems pull everything that isn’t frozen downward, then move","type":"text"},{"text":" ","type":"text"},{"text":"it by its velocity:","type":"text"}],"type":"paragraph"},{"syntax":"swift","code":["@System","struct Gravity {","    func run(_ falling: Update<Velocity>.Where<Without<Frozen>>) {","        falling { velocity, _ in velocity.dy -= 10 }","    }","}","","@System","struct Movement {","    func run(_ movers: Update<Position>.Over<Velocity>.Where<Without<Frozen>>) {","        movers { position, row in","            position.x += row.components.dx","            position.y += row.components.dy","        }","    }","}"],"type":"codeListing"},{"inlineContent":[{"text":"Because the parameters’ types state what each system reads and writes, the macro writes the","type":"text"},{"text":" ","type":"text"},{"text":"system’s ","type":"text"},{"type":"reference","isActive":true,"identifier":"doc:\/\/Systems\/documentation\/Systems\/System\/access"},{"text":" for you: ","type":"text"},{"type":"codeVoice","code":"Gravity"},{"text":" writes ","type":"text"},{"type":"codeVoice","code":"Velocity"},{"text":"; ","type":"text"},{"type":"codeVoice","code":"Movement"},{"text":" writes ","type":"text"},{"type":"codeVoice","code":"Position"},{"text":" and","type":"text"},{"text":" ","type":"text"},{"text":"reads ","type":"text"},{"type":"codeVoice","code":"Velocity"},{"text":". A schedule uses the access to decide which systems can run at the same time.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"You can also conform a type to "},{"type":"reference","identifier":"doc:\/\/Systems\/documentation\/Systems\/System","isActive":true},{"type":"text","text":" by hand and write its "},{"type":"reference","identifier":"doc:\/\/Systems\/documentation\/Systems\/System\/run(in:)","isActive":true},{"type":"text","text":" method, which"},{"type":"text","text":" "},{"type":"text","text":"receives the whole world. See "},{"type":"reference","identifier":"doc:\/\/Systems\/documentation\/Systems\/System","isActive":true},{"type":"text","text":" for when to do that."}],"type":"paragraph"},{"anchor":"Run-Systems-in-a-Schedule","text":"Run Systems in a Schedule","level":3,"type":"heading"},{"inlineContent":[{"type":"text","text":"A "},{"type":"reference","identifier":"doc:\/\/Systems\/documentation\/Systems\/Schedule","isActive":true},{"type":"text","text":" is built from a list of systems, written in a result builder. Running it runs each"},{"type":"text","text":" "},{"type":"text","text":"system once. The following example drops a ball for one frame:"}],"type":"paragraph"},{"syntax":"swift","code":["var world = World()","let ball = world.spawn(Position(x: 0, y: 100), Velocity(dx: 1, dy: 0))","","let frame = Schedule {","    Gravity()","    Movement().after(Gravity.self)","}","frame.run(on: &world)","","print(world[Position.self, of: ball])","\/\/ Prints \"Position(x: 1.0, y: 90.0)\""],"type":"codeListing"},{"inlineContent":[{"type":"text","text":"Systems run in the order you write them, unless an ordering constraint says otherwise."},{"type":"text","text":" "},{"type":"codeVoice","code":"after(_:)"},{"type":"text","text":" and "},{"type":"codeVoice","code":"before(_:)"},{"type":"text","text":" require one system to run after or before another; "},{"type":"reference","isActive":true,"identifier":"doc:\/\/Systems\/documentation\/Systems\/SystemSet"},{"type":"text","text":" "},{"type":"text","text":"names a group of systems so constraints can refer to all of them at once; and "},{"type":"codeVoice","code":"runIf(_:)"},{"type":"text","text":" skips"},{"type":"text","text":" "},{"type":"text","text":"a system when a condition doesn’t hold."}],"type":"paragraph"},{"inlineContent":[{"text":"Systems whose accesses don’t conflict, because neither writes what the other reads or writes,","type":"text"},{"text":" ","type":"text"},{"text":"run at the same time, and the world ends as though they had run one after another (commands","type":"text"},{"text":" ","type":"text"},{"text":"apply when each wave finishes). Systems that","type":"text"},{"text":" ","type":"text"},{"text":"conflict run in order. When two conflicting systems aren’t ordered by any constraint, their order","type":"text"},{"text":" ","type":"text"},{"text":"rests only on how they happen to be written; ","type":"text"},{"isActive":true,"identifier":"doc:\/\/Systems\/documentation\/Systems\/Schedule\/ambiguities()","type":"reference"},{"text":" finds those pairs so a","type":"text"},{"text":" ","type":"text"},{"text":"test can keep a schedule free of them.","type":"text"}],"type":"paragraph"}]}],"hierarchy":{"paths":[[]]},"sections":[],"schemaVersion":{"minor":3,"patch":0,"major":0},"references":{"doc://Systems/documentation/Systems/Ambiguity":{"type":"topic","identifier":"doc:\/\/Systems\/documentation\/Systems\/Ambiguity","title":"Ambiguity","abstract":[{"text":"Two systems of a schedule whose accesses conflict but that no ordering constraint orders, so","type":"text"},{"text":" ","type":"text"},{"text":"the order they run in rests only on the order they were written in.","type":"text"}],"role":"symbol","url":"\/documentation\/systems\/ambiguity","kind":"symbol","navigatorTitle":[{"kind":"identifier","text":"Ambiguity"}],"fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"Ambiguity"}]},"doc://Systems/documentation/Systems/SystemSet":{"title":"SystemSet","url":"\/documentation\/systems\/systemset","identifier":"doc:\/\/Systems\/documentation\/Systems\/SystemSet","fragments":[{"text":"protocol","kind":"keyword"},{"text":" ","kind":"text"},{"text":"SystemSet","kind":"identifier"}],"kind":"symbol","type":"topic","role":"symbol","navigatorTitle":[{"text":"SystemSet","kind":"identifier"}],"abstract":[{"type":"text","text":"A type that names a group of systems, so ordering constraints can refer to all of them at"},{"type":"text","text":" "},{"type":"text","text":"once."}]},"doc://Systems/documentation/Systems/ResourceWriter":{"role":"symbol","navigatorTitle":[{"kind":"identifier","text":"ResourceWriter"}],"fragments":[{"kind":"keyword","text":"class"},{"kind":"text","text":" "},{"kind":"identifier","text":"ResourceWriter"}],"abstract":[{"type":"text","text":"A system parameter that reads and writes a resource."}],"url":"\/documentation\/systems\/resourcewriter","identifier":"doc:\/\/Systems\/documentation\/Systems\/ResourceWriter","title":"ResourceWriter","type":"topic","kind":"symbol"},"doc://Systems/documentation/Systems/ForwardEvents":{"identifier":"doc:\/\/Systems\/documentation\/Systems\/ForwardEvents","role":"symbol","url":"\/documentation\/systems\/forwardevents","title":"ForwardEvents","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"ForwardEvents","kind":"identifier"}],"abstract":[{"type":"text","text":"A system that yields each event of one type to an asynchronous stream, so code outside the"},{"type":"text","text":" "},{"type":"text","text":"schedule can await the events."}],"navigatorTitle":[{"text":"ForwardEvents","kind":"identifier"}],"kind":"symbol","type":"topic"},"doc://Systems/documentation/Systems/ForwardChanges":{"title":"ForwardChanges","url":"\/documentation\/systems\/forwardchanges","identifier":"doc:\/\/Systems\/documentation\/Systems\/ForwardChanges","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"ForwardChanges"}],"kind":"symbol","type":"topic","role":"symbol","navigatorTitle":[{"kind":"identifier","text":"ForwardChanges"}],"abstract":[{"text":"A system that yields each component of one type added or changed since it last ran to an","type":"text"},{"text":" ","type":"text"},{"text":"asynchronous stream, with its entity.","type":"text"}]},"doc://Systems/documentation/Systems/System/access":{"title":"access","url":"\/documentation\/systems\/system\/access","kind":"symbol","identifier":"doc:\/\/Systems\/documentation\/Systems\/System\/access","defaultImplementations":1,"type":"topic","required":true,"abstract":[{"type":"text","text":"The component, resource and event types the system reads and writes, or "},{"type":"codeVoice","code":"nil"},{"type":"text","text":" if it may"},{"type":"text","text":" "},{"type":"text","text":"change anything."}],"role":"symbol","fragments":[{"kind":"keyword","text":"var"},{"kind":"text","text":" "},{"kind":"identifier","text":"access"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"Access","preciseIdentifier":"s:11WorldModule6AccessV"},{"kind":"text","text":"?"}]},"doc://Systems/documentation/Systems/System":{"title":"System","url":"\/documentation\/systems\/system","identifier":"doc:\/\/Systems\/documentation\/Systems\/System","fragments":[{"text":"protocol","kind":"keyword"},{"text":" ","kind":"text"},{"text":"System","kind":"identifier"}],"kind":"symbol","type":"topic","role":"symbol","navigatorTitle":[{"text":"System","kind":"identifier"}],"abstract":[{"type":"text","text":"A rule that reads and changes a world, run once each time its schedule runs."}]},"doc://Systems/documentation/Systems/SystemTiming":{"title":"SystemTiming","url":"\/documentation\/systems\/systemtiming","identifier":"doc:\/\/Systems\/documentation\/Systems\/SystemTiming","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"SystemTiming","kind":"identifier"}],"kind":"symbol","type":"topic","role":"symbol","navigatorTitle":[{"text":"SystemTiming","kind":"identifier"}],"abstract":[{"text":"The times one system of a schedule has taken to run.","type":"text"}]},"doc://Systems/documentation/Systems/UpdateEvents":{"identifier":"doc:\/\/Systems\/documentation\/Systems\/UpdateEvents","role":"symbol","url":"\/documentation\/systems\/updateevents","title":"UpdateEvents","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"UpdateEvents","kind":"identifier"}],"abstract":[{"type":"text","text":"A system that ends the current event update, dropping events old enough that every reader"},{"type":"text","text":" "},{"type":"text","text":"has had its chance to read them."}],"navigatorTitle":[{"text":"UpdateEvents","kind":"identifier"}],"kind":"symbol","type":"topic"},"doc://Systems/documentation/Systems/DeclaringSystems":{"url":"\/documentation\/systems\/declaringsystems","title":"Declaring Systems","kind":"article","identifier":"doc:\/\/Systems\/documentation\/Systems\/DeclaringSystems","type":"topic","abstract":[{"type":"text","text":"Write the rules of a simulation as systems, and let their parameters state what they read and"},{"type":"text","text":" "},{"type":"text","text":"write."}],"role":"collectionGroup"},"doc://Systems/documentation/Systems/EventWriter":{"title":"EventWriter","url":"\/documentation\/systems\/eventwriter","identifier":"doc:\/\/Systems\/documentation\/Systems\/EventWriter","fragments":[{"text":"class","kind":"keyword"},{"text":" ","kind":"text"},{"text":"EventWriter","kind":"identifier"}],"kind":"symbol","type":"topic","role":"symbol","navigatorTitle":[{"text":"EventWriter","kind":"identifier"}],"abstract":[{"text":"A system parameter that sends events of one type.","type":"text"}]},"doc://Systems/documentation/Systems/RemovedComponents":{"url":"\/documentation\/systems\/removedcomponents","abstract":[{"type":"text","text":"A system parameter that lists the entities that lost a component since the system last read"},{"type":"text","text":" "},{"type":"text","text":"them."}],"title":"RemovedComponents","type":"topic","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"RemovedComponents","kind":"identifier"}],"navigatorTitle":[{"text":"RemovedComponents","kind":"identifier"}],"identifier":"doc:\/\/Systems\/documentation\/Systems\/RemovedComponents","kind":"symbol","role":"symbol"},"doc://Systems/documentation/Systems/SystemProfile":{"role":"symbol","navigatorTitle":[{"text":"SystemProfile","kind":"identifier"}],"fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"SystemProfile","kind":"identifier"}],"abstract":[{"type":"text","text":"A resource that records how long each system takes to run."}],"url":"\/documentation\/systems\/systemprofile","identifier":"doc:\/\/Systems\/documentation\/Systems\/SystemProfile","title":"SystemProfile","type":"topic","kind":"symbol"},"doc://Systems/documentation/Systems/System()":{"identifier":"doc:\/\/Systems\/documentation\/Systems\/System()","title":"System()","kind":"symbol","url":"\/documentation\/systems\/system()","type":"topic","abstract":[{"text":"Makes a type a system whose access comes from the parameters of its ","type":"text"},{"type":"codeVoice","code":"run"},{"text":" method.","type":"text"}],"role":"symbol","fragments":[{"kind":"keyword","text":"macro"},{"kind":"text","text":" "},{"kind":"identifier","text":"System"},{"kind":"text","text":"()"}]},"doc://Systems/documentation/Systems/ScheduleBuilder":{"identifier":"doc:\/\/Systems\/documentation\/Systems\/ScheduleBuilder","url":"\/documentation\/systems\/schedulebuilder","kind":"symbol","title":"ScheduleBuilder","type":"topic","abstract":[{"type":"text","text":"A result builder that collects the systems written in a "},{"type":"reference","isActive":true,"identifier":"doc:\/\/Systems\/documentation\/Systems\/Schedule"},{"type":"text","text":"’s closure."}],"navigatorTitle":[{"text":"ScheduleBuilder","kind":"identifier"}],"role":"symbol","fragments":[{"text":"enum","kind":"keyword"},{"text":" ","kind":"text"},{"text":"ScheduleBuilder","kind":"identifier"}]},"doc://Systems/documentation/Systems/EventReader":{"title":"EventReader","url":"\/documentation\/systems\/eventreader","identifier":"doc:\/\/Systems\/documentation\/Systems\/EventReader","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"EventReader","kind":"identifier"}],"kind":"symbol","type":"topic","role":"symbol","navigatorTitle":[{"text":"EventReader","kind":"identifier"}],"abstract":[{"text":"A system parameter that reads the events of one type sent since the system last read them.","type":"text"}]},"doc://WorldModule/documentation/WorldModule/Query":{"url":"\/documentation\/worldmodule\/query","identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/Query","navigatorTitle":[{"kind":"identifier","text":"Query"}],"type":"topic","title":"Query","kind":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"Query"}],"role":"symbol","abstract":[{"text":"A description of the entities to visit and the components to read from each.","type":"text"}]},"doc://Systems/documentation/Systems/System/run(in:)":{"identifier":"doc:\/\/Systems\/documentation\/Systems\/System\/run(in:)","url":"\/documentation\/systems\/system\/run(in:)","title":"run(in:)","kind":"symbol","type":"topic","required":true,"abstract":[{"text":"Runs the system’s rule once on a world.","type":"text"}],"role":"symbol","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"run","kind":"identifier"},{"text":"(","kind":"text"},{"text":"in","kind":"externalParam"},{"text":": ","kind":"text"},{"kind":"keyword","text":"inout"},{"kind":"text","text":" "},{"kind":"typeIdentifier","text":"World","preciseIdentifier":"s:11WorldModule0A0V"},{"kind":"text","text":")"}]},"doc://Systems/documentation/Systems/Schedule":{"url":"\/documentation\/systems\/schedule","identifier":"doc:\/\/Systems\/documentation\/Systems\/Schedule","title":"Schedule","kind":"symbol","type":"topic","abstract":[{"type":"text","text":"A list of systems that run on a world, in order, and at the same time where they can."}],"navigatorTitle":[{"kind":"identifier","text":"Schedule"}],"role":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"Schedule"}]},"doc://Systems/documentation/Systems/ScheduledSystem":{"url":"\/documentation\/systems\/scheduledsystem","abstract":[{"text":"A system together with the ordering constraints, sets and conditions a schedule runs it with.","type":"text"}],"title":"ScheduledSystem","type":"topic","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"ScheduledSystem","kind":"identifier"}],"navigatorTitle":[{"text":"ScheduledSystem","kind":"identifier"}],"identifier":"doc:\/\/Systems\/documentation\/Systems\/ScheduledSystem","kind":"symbol","role":"symbol"},"doc://Systems/documentation/Systems/Update":{"url":"\/documentation\/systems\/update","title":"Update","kind":"symbol","identifier":"doc:\/\/Systems\/documentation\/Systems\/Update","type":"topic","abstract":[{"type":"text","text":"A system parameter that changes a component of every entity that holds it."}],"navigatorTitle":[{"text":"Update","kind":"identifier"}],"role":"symbol","fragments":[{"text":"class","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Update","kind":"identifier"}]},"doc://Systems/documentation/Systems/CyclicOrdering":{"identifier":"doc:\/\/Systems\/documentation\/Systems\/CyclicOrdering","title":"CyclicOrdering","kind":"symbol","url":"\/documentation\/systems\/cyclicordering","type":"topic","abstract":[{"type":"text","text":"An error indicating that the ordering constraints of a schedule’s systems form a cycle, so no"},{"type":"text","text":" "},{"type":"text","text":"order satisfies them all."}],"navigatorTitle":[{"kind":"identifier","text":"CyclicOrdering"}],"role":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"CyclicOrdering"}]},"doc://Systems/documentation/Systems/SystemParameter":{"identifier":"doc:\/\/Systems\/documentation\/Systems\/SystemParameter","role":"symbol","url":"\/documentation\/systems\/systemparameter","title":"SystemParameter","fragments":[{"kind":"keyword","text":"protocol"},{"kind":"text","text":" "},{"kind":"identifier","text":"SystemParameter"}],"abstract":[{"text":"A type a system’s ","type":"text"},{"code":"run","type":"codeVoice"},{"text":" method can take in place of the whole world, whose type states what","type":"text"},{"text":" ","type":"text"},{"text":"the system reads and writes.","type":"text"}],"navigatorTitle":[{"kind":"identifier","text":"SystemParameter"}],"kind":"symbol","type":"topic"},"doc://Systems/documentation/Systems/Schedule/ambiguities()":{"abstract":[{"type":"text","text":"Returns every pair of systems whose accesses conflict but that no ordering constraint"},{"type":"text","text":" "},{"type":"text","text":"orders."}],"type":"topic","title":"ambiguities()","identifier":"doc:\/\/Systems\/documentation\/Systems\/Schedule\/ambiguities()","role":"symbol","url":"\/documentation\/systems\/schedule\/ambiguities()","kind":"symbol","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"ambiguities"},{"kind":"text","text":"() -> ["},{"text":"Ambiguity","kind":"typeIdentifier","preciseIdentifier":"s:7Systems9AmbiguityV"},{"text":"]","kind":"text"}]},"doc://Systems/documentation/Systems/ResourceReader":{"abstract":[{"type":"text","text":"A system parameter that reads a resource."}],"url":"\/documentation\/systems\/resourcereader","identifier":"doc:\/\/Systems\/documentation\/Systems\/ResourceReader","navigatorTitle":[{"text":"ResourceReader","kind":"identifier"}],"title":"ResourceReader","kind":"symbol","role":"symbol","type":"topic","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"ResourceReader","kind":"identifier"}]},"doc://Systems/documentation/Systems":{"title":"Systems","url":"\/documentation\/systems","identifier":"doc:\/\/Systems\/documentation\/Systems","kind":"symbol","type":"topic","role":"collection","abstract":[{"text":"Declare the rules of a simulation as systems, and run them on a world in a schedule.","type":"text"}]},"doc://Systems/documentation/Systems/MainActorSystem":{"type":"topic","abstract":[{"text":"A system that runs on the main actor, for work that touches main-actor state such as a user","type":"text"},{"text":" ","type":"text"},{"text":"interface.","type":"text"}],"identifier":"doc:\/\/Systems\/documentation\/Systems\/MainActorSystem","title":"MainActorSystem","role":"symbol","url":"\/documentation\/systems\/mainactorsystem","kind":"symbol","navigatorTitle":[{"text":"MainActorSystem","kind":"identifier"}],"fragments":[{"text":"protocol","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MainActorSystem","kind":"identifier"}]}}}