ion\/systems\/schedulebuilder","identifier":"doc:\/\/Systems\/documentation\/Systems\/ScheduleBuilder","kind":"symbol","fragments":[{"text":"enum","kind":"keyword"},{"text":" ","kind":"text"},{"text":"ScheduleBuilder","kind":"identifier"}],"role":"symbol","title":"ScheduleBuilder"},"doc://Systems/documentation/Systems/System":{"navigatorTitle":[{"text":"System","kind":"identifier"}],"type":"topic","abstract":[{"type":"text","text":"A rule that reads and changes a world, run once each time its schedule runs."}],"url":"\/documentation\/systems\/system","identifier":"doc:\/\/Systems\/documentation\/Systems\/System","kind":"symbol","fragments":[{"text":"protocol","kind":"keyword"},{"text":" ","kind":"text"},{"text":"System","kind":"identifier"}],"role":"symbol","title":"System"},"doc://Systems/documentation/Systems/SystemTiming":{"navigatorTitle":[{"kind":"identifier","text":"SystemTiming"}],"abstract":[{"text":"The times one system of a schedule has taken to run.","type":"text"}],"url":"\/documentation\/systems\/systemtiming","kind":"symbol","identifier":"doc:\/\/Systems\/documentation\/Systems\/SystemTiming","type":"topic","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"SystemTiming"}],"role":"symbol","title":"SystemTiming"},"doc://Systems/documentation/Systems/SystemSet":{"type":"topic","url":"\/documentation\/systems\/systemset","navigatorTitle":[{"text":"SystemSet","kind":"identifier"}],"fragments":[{"text":"protocol","kind":"keyword"},{"text":" ","kind":"text"},{"text":"SystemSet","kind":"identifier"}],"identifier":"doc:\/\/Systems\/documentation\/Systems\/SystemSet","title":"SystemSet","kind":"symbol","abstract":[{"text":"A type that names a group of systems, so ordering constraints can refer to all of them at","type":"text"},{"text":" ","type":"text"},{"text":"once.","type":"text"}],"role":"symbol"},"doc://Systems/documentation/Systems/SystemProfile":{"title":"SystemProfile","fragments":[{"text":"struct","k