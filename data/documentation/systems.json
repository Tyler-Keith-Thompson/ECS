text":"MainActorSystem"}],"title":"MainActorSystem","url":"\/documentation\/systems\/mainactorsystem"},"doc://Systems/documentation/Systems/DrivingAWorldFromAnApp":{"role":"article","identifier":"doc:\/\/Systems\/documentation\/Systems\/DrivingAWorldFromAnApp","title":"Driving a World from an App","abstract":[{"text":"Hold a world in your app or game engine, feed it each frame’s input, and let the objects outside","type":"text"},{"text":" ","type":"text"},{"text":"it read results and take part in a step.","type":"text"}],"kind":"article","type":"topic","url":"\/documentation\/systems\/drivingaworldfromanapp"},"doc://Systems/documentation/Systems/ScheduleBuilder":{"url":"\/documentation\/systems\/schedulebuilder","kind":"symbol","title":"ScheduleBuilder","identifier":"doc:\/\/Systems\/documentation\/Systems\/ScheduleBuilder","type":"topic","abstract":[{"text":"A result builder that collects the systems written in a ","type":"text"},{"type":"reference","isActive":true,"identifier":"doc:\/\/Systems\/documentation\/Systems\/Schedule"},{"text":"’s closure.","type":"text"}],"fragments":[{"kind":"keyword","text":"enum"},{"kind":"text","text":" "},{"kind":"identifier","text":"ScheduleBuilder"}],"navigatorTitle":[{"kind":"identifier","text":"ScheduleBuilder"}],"role":"symbol"},"doc://Systems/documentation/Systems/SystemParameter":{"navigatorTitle":[{"kind":"identifier","text":"SystemParameter"}],"type":"topic","abstract":[{"type":"text","text":"A type a system’s "},{"type":"codeVoice","code":"run"},{"type":"text","text":" method can take in place of the whole world, whose type states what"},{"type":"text","text":" "},{"type":"text","text":"the system reads and writes."}],"kind":"symbol","role":"symbol","identifier":"doc:\/\/Systems\/documentation\/Systems\/SystemParameter","fragments":[{"kind":"keyword","text":"protocol"},{"kind":"text","text":" "},{"kind":"identifier","text":"SystemParameter"}],"title":"SystemParameter","url":"\/documentation\/systems\/systemparameter"},"doc://Systems/documentation/Systems/EventWriter":{"navigatorTitle":[{"kind":"identifier","text":"EventWriter"}],"type":"topic","abstract":[{"text":"A system parameter that sends events of one type.","type":"text"}],"kind":"symbol","role":"symbol","identifier":"doc:\/\/Systems\/documentation\/Systems\/EventWriter","fragments":[{"kind":"keyword","text":"class"},{"kind":"text","text":" "},{"kind":"identifier","text":"EventWriter"}],"title":"EventWriter","url":"\/documentation\/systems\/eventwriter"},"doc://Systems/documentation/Systems/ForwardEvents":{"url":"\/documentation\/systems\/forwardevents","kind":"symbol","title":"ForwardEvents","identifier":"doc:\/\/Systems\/documentation\/Systems\/ForwardEvents","type":"topic","abstract":[{"type":"text","text":"A system that yields each event of one type to an asynchronous stream, so code outside the"},{"type":"text","text":" "},{"type":"text","text":"schedule can await the events."}],"fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"ForwardEvents"}],"navigatorTitle":[{"kind":"identifier","text":"ForwardEvents"}],"role":"symbol"},"doc://WorldModule/documentation/WorldModule/Query":{"role":"symbol","identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/Query","title":"Query","navigatorTitle":[{"kind":"identifier","text":"Query"}],"abstract":[{"type":"text","text":"A description of the entities to visit and the components to read from each."}],"kind":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"Query"}],"type":"topic","url":"\/documentation\/worldmodule\/query"}}}