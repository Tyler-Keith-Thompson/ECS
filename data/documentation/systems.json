ule","kind":"identifier"}],"type":"topic","url":"\/documentation\/systems\/schedule","identifier":"doc:\/\/Systems\/documentation\/Systems\/Schedule","kind":"symbol","abstract":[{"text":"A list of systems that run on a world, in order, and at the same time where they can.","type":"text"}],"title":"Schedule"},"doc://Systems/documentation/Systems/ScheduleBuilder":{"abstract":[{"type":"text","text":"A result builder that collects the systems written in a "},{"isActive":true,"type":"reference","identifier":"doc:\/\/Systems\/documentation\/Systems\/Schedule"},{"type":"text","text":"’s closure."}],"navigatorTitle":[{"text":"ScheduleBuilder","kind":"identifier"}],"identifier":"doc:\/\/Systems\/documentation\/Systems\/ScheduleBuilder","url":"\/documentation\/systems\/schedulebuilder","role":"symbol","title":"ScheduleBuilder","fragments":[{"text":"enum","kind":"keyword"},{"text":" ","kind":"text"},{"text":"ScheduleBuilder","kind":"identifier"}],"type":"topic","kind":"symbol"}}}