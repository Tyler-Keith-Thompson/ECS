 its entity."}],"navigatorTitle":[{"text":"ForwardChanges","kind":"identifier"}]},"doc://Systems/documentation/Systems/SchedulingSystems":{"type":"topic","abstract":[{"text":"Order the systems of a schedule, run them only when a condition holds, and find out how a","type":"text"},{"text":" ","type":"text"},{"text":"schedule runs them.","type":"text"}],"title":"Scheduling Systems","url":"\/documentation\/systems\/schedulingsystems","identifier":"doc:\/\/Systems\/documentation\/Systems\/SchedulingSystems","role":"article","kind":"article"},"doc://Systems/documentation/Systems/SystemParameter":{"url":"\/documentation\/systems\/systemparameter","identifier":"doc:\/\/Systems\/documentation\/Systems\/SystemParameter","abstract":[{"type":"text","text":"A type a system’s "},{"type":"codeVoice","code":"run"},{"type":"text","text":" method can take in place of the whole world, whose type states what"},{"type":"text","text":" "},{"type":"text","text":"the system reads and writes."}],"title":"SystemParameter","fragments":[{"text":"protocol","kind":"keyword"},{"text":" ","kind":"text"},{"text":"SystemParameter","kind":"identifier"}],"kind":"symbol","navigatorTitle":[{"text":"SystemParameter","kind":"identifier"}],"type":"topic","role":"symbol"},"doc://Systems/documentation/Systems/System/run(in:)":{"type":"topic","abstract":[{"text":"Runs the system’s rule once on a world.","type":"text"}],"title":"run(in:)","url":"\/documentation\/systems\/system\/run(in:)","identifier":"doc:\/\/Systems\/documentation\/Systems\/System\/run(in:)","required":true,"role":"symbol","kind":"symbol","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"run","kind":"identifier"},{"text":"(","kind":"text"},{"text":"in","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"inout","kind":"keyword"},{"text":" ","kind":"text"},{"text":"World","kind":"typeIdentifier","preciseIdentifier":"s:11WorldModule0A0V"},{"text":")","kind":"text"}]},"doc://Systems/documentation/Systems/DrivingAWorldFromAnApp":{"type":"topic","abstract":[{"type":"text","text":"Hold a world in your app or game engine, feed it each frame’s input, and let the objects outside"},{"type":"text","text":" "},{"type":"text","text":"it read results and take part in a step."}],"title":"Driving a World from an App","url":"\/documentation\/systems\/drivingaworldfromanapp","identifier":"doc:\/\/Systems\/documentation\/Systems\/DrivingAWorldFromAnApp","role":"article","kind":"article"},"doc://Systems/documentation/Systems/System/access":{"defaultImplementations":1,"kind":"symbol","title":"access","url":"\/documentation\/systems\/system\/access","type":"topic","role":"symbol","required":true,"fragments":[{"text":"var","kind":"keyword"},{"text":" ","kind":"text"},{"text":"access","kind":"identifier"},{"text":": ","kind":"text"},{"text":"Access","kind":"typeIdentifier","preciseIdentifier":"s:11WorldModule6AccessV"},{"text":"?","kind":"text"}],"identifier":"doc:\/\/Systems\/documentation\/Systems\/System\/access","abstract":[{"text":"The component, resource and event types the system reads and writes, or ","type":"text"},{"code":"nil","type":"codeVoice"},{"text":" if it may","type":"text"},{"text":" ","type":"text"},{"text":"change anything.","type":"text"}]},"doc://Systems/documentation/Systems/System()":{"abstract":[{"type":"text","text":"Makes a type a system whose access comes from the parameters of its "},{"code":"run","type":"codeVoice"},{"type":"text","text":" method."}],"role":"symbol","title":"System()","type":"topic","identifier":"doc:\/\/Systems\/documentation\/Systems\/System()","url":"\/documentation\/systems\/system()","kind":"symbol","fragments":[{"kind":"keyword","text":"macro"},{"kind":"text","text":" "},{"kind":"identifier","text":"System"},{"kind":"text","text":"()"}]},"doc://Systems/documentation/Systems/System":{"abstract":[{"text":"A rule that reads and changes a world, run once each time its schedule runs.","type":"text"}],"role":"symbol","title":"System","url":"\/documentation\/systems\/system","type":"topic","identifier":"doc:\/\/Systems\/documentation\/Systems\/System","kind":"symbol","navigatorTitle":[{"kind":"identifier","text":"System"}],"fragments":[{"kind":"keyword","text":"protocol"},{"kind":"text","text":" "},{"kind":"identifier","text":"System"}]},"doc://Systems/documentation/Systems/EventReader":{"abstract":[{"type":"text","text":"A system parameter that reads the events of one type sent since the system last read them."}],"role":"symbol","title":"EventReader","identifier":"doc:\/\/Systems\/documentation\/Systems\/EventReader","url":"\/documentation\/systems\/eventreader","type":"topic","kind":"symbol","navigatorTitle":[{"text":"EventReader","kind":"identifier"}],"fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"EventReader","kind":"identifier"}]},"doc://Systems/documentation/Systems/ResourceReader":{"abstract":[{"type":"text","text":"A system parameter that reads a resource."}],"role":"symbol","title":"ResourceReader","identifier":"doc:\/\/Systems\/documentation\/Systems\/ResourceReader","type":"topic","url":"\/documentation\/systems\/resourcereader","kind":"symbol","navigatorTitle":[{"kind":"identifier","text":"ResourceReader"}],"fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"ResourceReader"}]},"doc://Systems/documentation/Systems/DeclaringSystems":{"abstract":[{"text":"Write the rules of a simulation as systems, and let their parameters state what they read and","type":"text"},{"text":" ","type":"text"},{"text":"write.","type":"text"}],"role":"collectionGroup","title":"Declaring Systems","identifier":"doc:\/\/Systems\/documentation\/Systems\/DeclaringSystems","type":"topic","url":"\/documentation\/systems\/declaringsystems","kind":"article"},"doc://WorldModule/documentation/WorldModule/Query":{"abstract":[{"type":"text","text":"A description of the entities to visit and the components to read from each."}],"role":"symbol","title":"Query","identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/Query","type":"topic","url":"\/documentation\/worldmodule\/query","kind":"symbol","navigatorTitle":[{"kind":"identifier","text":"Query"}],"fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"Query"}]}}}