":" ","type":"text"},{"text":"them.","type":"text"}],"kind":"symbol","role":"symbol","title":"RemovedComponents"},"doc://Systems/documentation/Systems/SystemParameter":{"fragments":[{"text":"protocol","kind":"keyword"},{"text":" ","kind":"text"},{"text":"SystemParameter","kind":"identifier"}],"identifier":"doc:\/\/Systems\/documentation\/Systems\/SystemParameter","navigatorTitle":[{"text":"SystemParameter","kind":"identifier"}],"type":"topic","url":"\/documentation\/systems\/systemparameter","abstract":[{"text":"A type a system’s ","type":"text"},{"code":"run","type":"codeVoice"},{"text":" method can take in place of the whole world, whose type states what","type":"text"},{"text":" ","type":"text"},{"text":"the system reads and writes.","type":"text"}],"kind":"symbol","role":"symbol","title":"SystemParameter"},"doc://Systems/documentation/Systems/System/run(in:)":{"role":"symbol","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"run"},{"kind":"text","text":"("},{"kind":"externalParam","text":"in"},{"kind":"text","text":": "},{"text":"inout","kind":"keyword"},{"text":" ","kind":"text"},{"text":"World","kind":"typeIdentifier","preciseIdentifier":"s:11WorldModule0A0V"},{"text":")","kind":"text"}],"identifier":"doc:\/\/Systems\/documentation\/Systems\/System\/run(in:)","type":"topic","url":"\/documentation\/systems\/system\/run(in:)","abstract":[{"text":"Runs the system’s rule once on a world.","type":"text"}],"kind":"symbol","required":true,"title":"run(in:)"},"doc://Systems/documentation/Systems/DrivingAWorldFromAnApp":{"kind":"article","role":"article","url":"\/documentation\/systems\/drivingaworldfromanapp","identifier":"doc:\/\/Systems\/documentation\/Systems\/DrivingAWorldFromAnApp","type":"topic","abstract":[{"text":"Hold a world in your app or game engine, feed it each frame’s input, and let the objects outside","type":"text"},{"text":" ","type":"text"},{"text":"it read results and take part in a step.","type":"text"}],"title":"Driving a World from an App"},"doc://Systems/documentation/Systems/SystemTiming":{"fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"SystemTiming","kind":"identifier"}],"type":"topic","abstract":[{"type":"text","text":"The times one system of a schedule has taken to run."}],"identifier":"doc:\/\/Systems\/documentation\/Systems\/SystemTiming","kind":"symbol","title":"SystemTiming","navigatorTitle":[{"text":"SystemTiming","kind":"identifier"}],"url":"\/documentation\/systems\/systemtiming","role":"symbol"},"doc://Systems/documentation/Systems/Ambiguity":{"fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Ambiguity","kind":"identifier"}],"type":"topic","abstract":[{"text":"Two systems of a schedule whose accesses conflict but that no ordering constraint orders, so","type":"text"},{"text":" ","type":"text"},{"text":"the order they run in rests only on the order they were written in.","type":"text"}],"identifier":"doc:\/\/Systems\/documentation\/Systems\/Ambiguity","kind":"symbol","title":"Ambiguity","navigatorTitle":[{"text":"Ambiguity","kind":"identifier"}],"url":"\/documentation\/systems\/ambiguity","role":"symbol"},"doc://Systems/documentation/Systems/System":{"fragments":[{"kind":"keyword","text":"protocol"},{"kind":"text","text":" "},{"kind":"identifier","text":"System"}],"type":"topic","abstract":[{"type":"text","text":"A rule that reads and changes a world, run once each time its schedule runs."}],"identifier":"doc:\/\/Systems\/documentation\/Systems\/System","kind":"symbol","title":"System","navigatorTitle":[{"kind":"identifier","text":"System"}],"url":"\/documentation\/systems\/system","role":"symbol"},"doc://Systems/documentation/Systems/DeclaringSystems":{"type":"topic","abstract":[{"type":"text","text":"Write the rules of a simulation as systems, and let their parameters state what they read and"},{"type":"text","text":" "},{"type":"text","text":"write."}],"identifier":"doc:\/\/Systems\/documentation\/Systems\/DeclaringSystems","kind":"article","title":"Declaring Systems","url":"\/documentation\/systems\/declaringsystems","role":"collectionGroup"},"doc://Systems/documentation/Systems/ResourceWriter":{"fragments":[{"kind":"keyword","text":"class"},{"kind":"text","text":" "},{"kind":"identifier","text":"ResourceWriter"}],"type":"topic","abstract":[{"text":"A system parameter that reads and writes a resource.","type":"text"}],"identifier":"doc:\/\/Systems\/documentation\/Systems\/ResourceWriter","kind":"symbol","title":"ResourceWriter","navigatorTitle":[{"kind":"identifier","text":"ResourceWriter"}],"url":"\/documentation\/systems\/resourcewriter","role":"symbol"},"doc://Systems/documentation/Systems":{"identifier":"doc:\/\/Systems\/documentation\/Systems","type":"topic","url":"\/documentation\/systems","abstract":[{"type":"text","text":"Declare the rules of a simulation as systems, and run them on a world in a schedule."}],"kind":"symbol","role":"collection","title":"Systems"},"doc://Systems/documentation/Systems/UpdateEvents":{"kind":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"UpdateEvents","kind":"identifier"}],"role":"symbol","navigatorTitle":[{"text":"UpdateEvents","kind":"identifier"}],"url":"\/documentation\/systems\/updateevents","identifier":"doc:\/\/Systems\/documentation\/Systems\/UpdateEvents","type":"topic","abstract":[{"type":"text","text":"A system that ends the current event update, dropping events old enough that every reader"},{"type":"text","text":" "},{"type":"text","text":"has had its chance to read them."}],"title":"UpdateEvents"}}}