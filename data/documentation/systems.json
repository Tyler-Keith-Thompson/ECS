{"hierarchy":{"paths":[[]]},"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/systems"]}],"schemaVersion":{"major":0,"minor":3,"patch":0},"identifier":{"url":"doc:\/\/Systems\/documentation\/Systems","interfaceLanguage":"swift"},"primaryContentSections":[{"kind":"content","content":[{"anchor":"Overview","type":"heading","text":"Overview","level":2},{"inlineContent":[{"type":"text","text":"A world holds data: entities and their components, and resources. A "},{"type":"emphasis","inlineContent":[{"type":"text","text":"system"}]},{"type":"text","text":" holds a rule: a"},{"type":"text","text":" "},{"type":"text","text":"step that reads part of the world and changes part of it, such as “every entity with a velocity"},{"type":"text","text":" "},{"type":"text","text":"moves” or “gravity pulls on everything that isn’t frozen.” A "},{"type":"emphasis","inlineContent":[{"type":"text","text":"schedule"}]},{"type":"text","text":" lists the systems of one"},{"type":"text","text":" "},{"type":"text","text":"frame or step and runs them on a world, each once per run."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"The examples throughout this module use these components, resources and event:"}],"type":"paragraph"},{"type":"codeListing","code":["struct Position: Component { var x: Double, y: Double }","struct Velocity: Component { var dx: Double, dy: Double }","struct Health: Component { var current: Int }","struct Frozen: Component {}","","struct Score: Resource { var points: Int }","struct TimeStep: Resource { var seconds: Double }","struct Paused: Resource {}","","struct Damage: Event { var target: Entity, amount: Int }"],"syntax":"swift"},{"anchor":"Declare-a-System","type":"heading","text":"Declare a System","level":3},{"inlineContent":[{"type":"text","text":"The simplest way to write a system is to mark a type with the "},{"type":"codeVoice","code":"@System"},{"type":"text","text":" macro and give it a"},{"type":"text","text":" "},{"type":"codeVoice","code":"run"},{"type":"text","text":" method. The method’s parameters say what the system works on, and their types say how:"},{"type":"text","text":" "},{"type":"text","text":"an "},{"identifier":"doc:\/\/Systems\/documentation\/Systems\/Update","isActive":true,"type":"reference"},{"type":"text","text":" writes components, a "},{"identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/Query","isActive":true,"type":"reference"},{"type":"text","text":" reads them, and a "},{"identifier":"doc:\/\/Systems\/documentation\/Systems\/ResourceReader","isActive":true,"type":"reference"},{"type":"text","text":" "},{"type":"text","text":"reads a resource. The following two systems pull everything that isn’t frozen downward, then move"},{"type":"text","text":" "},{"type":"text","text":"it by its velocity:"}],"type":"paragraph"},{"type":"codeListing","code":["@System","struct Gravity {","    func run(_ falling: Update<Velocity>.Where<Without<Frozen>>) {","        falling { velocity, _ in velocity.dy -= 10 }","    }","}","","@System","struct Movement {","    func run(_ movers: Update<Position>.Over<Velocity>.Where<Without<Frozen>>) {","        movers { position, row in","            position.x += row.components.dx","            position.y += row.components.dy","        }","    }","}"],"syntax":"swift"},{"inlineContent":[{"type":"text","text":"Because the parameters’ types state what each system reads and writes, the macro writes the"},{"type":"text","text":" "},{"type":"text","text":"system’s "},{"type":"reference","isActive":true,"identifier":"doc:\/\/Systems\/documentation\/Systems\/System\/access"},{"type":"text","text":" for you: "},{"type":"codeVoice","code":"Gravity"},{"type":"text","text":" writes "},{"type":"codeVoice","code":"Velocity"},{"type":"text","text":"; "},{"type":"codeVoice","code":"Movement"},{"type":"text","text":" writes "},{"type":"codeVoice","code":"Position"},{"type":"text","text":" and"},{"type":"text","text":" "},{"type":"text","text":"reads "},{"type":"codeVoice","code":"Velocity"},{"type":"text","text":". A schedule uses the access to decide which systems can run at the same time."}],"type":"paragraph"},{"inlineContent":[{"text":"You can also conform a type to ","type":"text"},{"identifier":"doc:\/\/Systems\/documentation\/Systems\/System","isActive":true,"type":"reference"},{"text":" by hand and write its ","type":"text"},{"identifier":"doc:\/\/Systems\/documentation\/Systems\/System\/run(in:)","isActive":true,"type":"reference"},{"text":" method, which","type":"text"},{"text":" ","type":"text"},{"text":"receives the whole world. See ","type":"text"},{"identifier":"doc:\/\/Systems\/documentation\/Systems\/System","isActive":true,"type":"reference"},{"text":" for when to do that.","type":"text"}],"type":"paragraph"},{"anchor":"Run-Systems-in-a-Schedule","type":"heading","text":"Run Systems in a Schedule","level":3},{"inlineContent":[{"type":"text","text":"A "},{"type":"reference","identifier":"doc:\/\/Systems\/documentation\/Systems\/Schedule","isActive":true},{"type":"text","text":" is built from a list of systems, written in a result builder. Running it runs each"},{"type":"text","text":" "},{"type":"text","text":"system once. The following example drops a ball for one frame:"}],"type":"paragraph"},{"type":"codeListing","code":["var world = World()","let ball = world.spawn(Position(x: 0, y: 100), Velocity(dx: 1, dy: 0))","","let frame = Schedule {","    Gravity()","    Movement().after(Gravity.self)","}","frame.run(on: &world)","","print(world[Position.self, of: ball])","\/\/ Prints \"Position(x: 1.0, y: 90.0)\""],"syntax":"swift"},{"inlineContent":[{"type":"text","text":"Systems run in the order you write them, unless an ordering constraint says otherwise."},{"type":"text","text":" "},{"type":"codeVoice","code":"after(_:)"},{"type":"text","text":" and "},{"type":"codeVoice","code":"before(_:)"},{"type":"text","text":" require one system to run after or before another; "},{"type":"reference","isActive":true,"identifier":"doc:\/\/Systems\/documentation\/Systems\/SystemSet"},{"type":"text","text":" "},{"type":"text","text":"names a group of systems so constraints can refer to all of them at once; and "},{"type":"codeVoice","code":"runIf(_:)"},{"type":"text","text":" skips"},{"type":"text","text":" "},{"type":"text","text":"a system when a condition doesn’t hold."}],"type":"paragraph"},{"inlineContent":[{"text":"Systems whose accesses don’t conflict, because neither writes what the other reads or writes,","type":"text"},{"text":" ","type":"text"},{"text":"run at the same time, and the world ends as though they had run one after another. Systems that","type":"text"},{"text":" ","type":"text"},{"text":"conflict run in order. When two conflicting systems aren’t ordered by any constraint, their order","type":"text"},{"text":" ","type":"text"},{"text":"rests only on how they happen to be written; ","type":"text"},{"identifier":"doc:\/\/Systems\/documentation\/Systems\/Schedule\/ambiguities()","type":"reference","isActive":true},{"text":" finds those pairs so a","type":"text"},{"text":" ","type":"text"},{"text":"test can keep a schedule free of them.","type":"text"}],"type":"paragraph"}]}],"metadata":{"modules":[{"name":"Systems"}],"role":"collection","title":"Systems","externalID":"Systems","symbolKind":"module","roleHeading":"Framework"},"kind":"symbol","sections":[],"abstract":[{"type":"text","text":"Declare the rules of a simulation as systems, and run them on a world in a schedule."}],"topicSections":[{"anchor":"Essentials","title":"Essentials","identifiers":["doc:\/\/Systems\/documentation\/Systems\/DeclaringSystems","doc:\/\/Systems\/documentation\/Systems\/System()","doc:\/\/Systems\/documentation\/Systems\/System"]},{"anchor":"System-Parameters","title":"System Parameters","identifiers":["doc:\/\/Systems\/documentation\/Systems\/SystemParameter","doc:\/\/Systems\/documentation\/Systems\/Update","doc:\/\/Systems\/documentation\/Systems\/ResourceReader","doc:\/\/Systems\/documentation\/Systems\/ResourceWriter","doc:\/\/Systems\/documentation\/Systems\/EventReader","doc:\/\/Systems\/documentation\/Systems\/EventWriter","doc:\/\/Systems\/documentation\/Systems\/RemovedComponents"]},{"anchor":"Building-and-Running-Schedules","title":"Building and Running Schedules","identifiers":["doc:\/\/Systems\/documentation\/Systems\/Schedule","doc:\/\/Systems\/documentation\/Systems\/ScheduleBuilder","doc:\/\/Systems\/documentation\/Systems\/ScheduledSystem","doc:\/\/Systems\/documentation\/Systems\/SystemSet","doc:\/\/Systems\/documentation\/Systems\/CyclicOrdering","doc:\/\/Systems\/documentation\/Systems\/Ambiguity"]},{"anchor":"Main-Actor-Systems","title":"Main-Actor Systems","identifiers":["doc:\/\/Systems\/documentation\/Systems\/MainActorSystem"]},{"anchor":"Built-In-Systems","title":"Built-In Systems","identifiers":["doc:\/\/Systems\/documentation\/Systems\/UpdateEvents","doc:\/\/Systems\/documentation\/Systems\/ForwardEvents","doc:\/\/Systems\/documentation\/Systems\/ForwardChanges"]},{"anchor":"Profiling","title":"Profiling","identifiers":["doc:\/\/Systems\/documentation\/Systems\/SystemProfile","doc:\/\/Systems\/documentation\/Systems\/SystemTiming"]}],"references":{"doc://Systems/documentation/Systems/SystemSet":{"kind":"symbol","title":"SystemSet","abstract":[{"type":"text","text":"A type that names a group of systems, so ordering constraints can refer to all of them at"},{"type":"text","text":" "},{"type":"text","text":"once."}],"type":"topic","fragments":[{"text":"protocol","kind":"keyword"},{"text":" ","kind":"text"},{"text":"SystemSet","kind":"identifier"}],"navigatorTitle":[{"text":"SystemSet","kind":"identifier"}],"url":"\/documentation\/systems\/systemset","role":"symbol","identifier":"doc:\/\/Systems\/documentation\/Systems\/SystemSet"},"doc://Systems/documentation/Systems/SystemTiming":{"abstract":[{"text":"The times one system of a schedule has taken to run.","type":"text"}],"navigatorTitle":[{"kind":"identifier","text":"SystemTiming"}],"url":"\/documentation\/systems\/systemtiming","identifier":"doc:\/\/Systems\/documentation\/Systems\/SystemTiming","role":"symbol","title":"SystemTiming","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"SystemTiming"}],"type":"topic","kind":"symbol"},"doc://Systems/documentation/Systems/Ambiguity":{"abstract":[{"type":"text","text":"Two systems of a schedule whose accesses conflict but that no ordering constraint orders, so"},{"type":"text","text":" "},{"type":"text","text":"the order they run in rests only on the order they were written in."}],"navigatorTitle":[{"text":"Ambiguity","kind":"identifier"}],"identifier":"doc:\/\/Systems\/documentation\/Systems\/Ambiguity","url":"\/documentation\/systems\/ambiguity","role":"symbol","title":"Ambiguity","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Ambiguity","kind":"identifier"}],"type":"topic","kind":"symbol"},"doc://Systems/documentation/Systems/DeclaringSystems":{"role":"collectionGroup","type":"topic","url":"\/documentation\/systems\/declaringsystems","kind":"article","identifier":"doc:\/\/Systems\/documentation\/Systems\/DeclaringSystems","abstract":[{"text":"Write the rules of a simulation as systems, and let their parameters state what they read and","type":"text"},{"text":" ","type":"text"},{"text":"write.","type":"text"}],"title":"Declaring Systems"},"doc://Systems/documentation/Systems/UpdateEvents":{"kind":"symbol","title":"UpdateEvents","abstract":[{"type":"text","text":"A system that ends the current event update, dropping events old enough that every reader"},{"type":"text","text":" "},{"type":"text","text":"has had its chance to read them."}],"type":"topic","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"UpdateEvents"}],"navigatorTitle":[{"kind":"identifier","text":"UpdateEvents"}],"url":"\/documentation\/systems\/updateevents","role":"symbol","identifier":"doc:\/\/Systems\/documentation\/Systems\/UpdateEvents"},"doc://Systems/documentation/Systems/System/access":{"identifier":"doc:\/\/Systems\/documentation\/Systems\/System\/access","required":true,"type":"topic","abstract":[{"type":"text","text":"The component, resource and event types the system reads and writes, or "},{"type":"codeVoice","code":"nil"},{"type":"text","text":" if it may"},{"type":"text","text":" "},{"type":"text","text":"change anything."}],"title":"access","role":"symbol","url":"\/documentation\/systems\/system\/access","defaultImplementations":1,"fragments":[{"kind":"keyword","text":"var"},{"kind":"text","text":" "},{"kind":"identifier","text":"access"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"Access","preciseIdentifier":"s:11WorldModule6AccessV"},{"kind":"text","text":"?"}],"kind":"symbol"},"doc://Systems/documentation/Systems/CyclicOrdering":{"identifier":"doc:\/\/Systems\/documentation\/Systems\/CyclicOrdering","title":"CyclicOrdering","navigatorTitle":[{"kind":"identifier","text":"CyclicOrdering"}],"url":"\/documentation\/systems\/cyclicordering","kind":"symbol","role":"symbol","abstract":[{"type":"text","text":"An error indicating that the ordering constraints of a schedule’s systems form a cycle, so no"},{"type":"text","text":" "},{"type":"text","text":"order satisfies them all."}],"type":"topic","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"CyclicOrdering"}]},"doc://Systems/documentation/Systems/Update":{"kind":"symbol","identifier":"doc:\/\/Systems\/documentation\/Systems\/Update","abstract":[{"type":"text","text":"A system parameter that changes a component of every entity that holds it."}],"type":"topic","fragments":[{"kind":"keyword","text":"class"},{"kind":"text","text":" "},{"kind":"identifier","text":"Update"}],"navigatorTitle":[{"kind":"identifier","text":"Update"}],"url":"\/documentation\/systems\/update","role":"symbol","title":"Update"},"doc://Systems/documentation/Systems/System()":{"role":"symbol","fragments":[{"text":"macro","kind":"keyword"},{"text":" ","kind":"text"},{"text":"System","kind":"identifier"},{"text":"()","kind":"text"}],"abstract":[{"type":"text","text":"Makes a type a system whose access comes from the parameters of its "},{"type":"codeVoice","code":"run"},{"type":"text","text":" method."}],"type":"topic","identifier":"doc:\/\/Systems\/documentation\/Systems\/System()","url":"\/documentation\/systems\/system()","kind":"symbol","title":"System()"},"doc://Systems/documentation/Systems/EventReader":{"url":"\/documentation\/systems\/eventreader","kind":"symbol","title":"EventReader","identifier":"doc:\/\/Systems\/documentation\/Systems\/EventReader","navigatorTitle":[{"text":"EventReader","kind":"identifier"}],"abstract":[{"text":"A system parameter that reads the events of one type sent since the system last read them.","type":"text"}],"fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"EventReader","kind":"identifier"}],"type":"topic","role":"symbol"},"doc://Systems/documentation/Systems/ScheduledSystem":{"abstract":[{"text":"A system together with the ordering constraints, sets and conditions a schedule runs it with.","type":"text"}],"navigatorTitle":[{"text":"ScheduledSystem","kind":"identifier"}],"identifier":"doc:\/\/Systems\/documentation\/Systems\/ScheduledSystem","url":"\/documentation\/systems\/scheduledsystem","role":"symbol","title":"ScheduledSystem","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"ScheduledSystem","kind":"identifier"}],"type":"topic","kind":"symbol"},"doc://Systems/documentation/Systems/SystemParameter":{"role":"symbol","fragments":[{"text":"protocol","kind":"keyword"},{"text":" ","kind":"text"},{"text":"SystemParameter","kind":"identifier"}],"abstract":[{"type":"text","text":"A type a system’s "},{"type":"codeVoice","code":"run"},{"type":"text","text":" method can take in place of the whole world, whose type states what"},{"type":"text","text":" "},{"type":"text","text":"the system reads and writes."}],"type":"topic","identifier":"doc:\/\/Systems\/documentation\/Systems\/SystemParameter","url":"\/documentation\/systems\/systemparameter","navigatorTitle":[{"text":"SystemParameter","kind":"identifier"}],"title":"SystemParameter","kind":"symbol"},"doc://Systems/documentation/Systems/RemovedComponents":{"identifier":"doc:\/\/Systems\/documentation\/Systems\/RemovedComponents","kind":"symbol","abstract":[{"type":"text","text":"A system parameter that lists the entities that lost a component since the system last read"},{"type":"text","text":" "},{"type":"text","text":"them."}],"type":"topic","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"RemovedComponents","kind":"identifier"}],"navigatorTitle":[{"text":"RemovedComponents","kind":"identifier"}],"url":"\/documentation\/systems\/removedcomponents","role":"symbol","title":"RemovedComponents"},"doc://Systems/documentation/Systems":{"identifier":"doc:\/\/Systems\/documentation\/Systems","kind":"symbol","url":"\/documentation\/systems","title":"Systems","abstract":[{"type":"text","text":"Declare the rules of a simulation as systems, and run them on a world in a schedule."}],"type":"topic","role":"collection"},"doc://Systems/documentation/Systems/ForwardChanges":{"abstract":[{"type":"text","text":"A system that yields each component of one type added or changed since it last ran to an"},{"type":"text","text":" "},{"type":"text","text":"asynchronous stream, with its entity."}],"navigatorTitle":[{"kind":"identifier","text":"ForwardChanges"}],"identifier":"doc:\/\/Systems\/documentation\/Systems\/ForwardChanges","title":"ForwardChanges","url":"\/documentation\/systems\/forwardchanges","role":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"ForwardChanges"}],"kind":"symbol","type":"topic"},"doc: