{"hierarchy":{"paths":[[]]},"kind":"symbol","schemaVersion":{"minor":3,"patch":0,"major":0},"sections":[],"topicSections":[{"identifiers":["doc:\/\/Systems\/documentation\/Systems\/DeclaringSystems","doc:\/\/Systems\/documentation\/Systems\/DrivingAWorldFromAnApp","doc:\/\/Systems\/documentation\/Systems\/System()","doc:\/\/Systems\/documentation\/Systems\/System"],"anchor":"Essentials","title":"Essentials"},{"identifiers":["doc:\/\/Systems\/documentation\/Systems\/SystemParameter","doc:\/\/Systems\/documentation\/Systems\/Update","doc:\/\/Systems\/documentation\/Systems\/ResourceReader","doc:\/\/Systems\/documentation\/Systems\/ResourceWriter","doc:\/\/Systems\/documentation\/Systems\/EventReader","doc:\/\/Systems\/documentation\/Systems\/EventWriter","doc:\/\/Systems\/documentation\/Systems\/RemovedComponents"],"anchor":"System-Parameters","title":"System Parameters"},{"identifiers":["doc:\/\/Systems\/documentation\/Systems\/Schedule","doc:\/\/Systems\/documentation\/Systems\/ScheduleBuilder","doc:\/\/Systems\/documentation\/Systems\/ScheduledSystem","doc:\/\/Systems\/documentation\/Systems\/SystemSet","doc:\/\/Systems\/documentation\/Systems\/CyclicOrdering","doc:\/\/Systems\/documentation\/Systems\/Ambiguity"],"anchor":"Building-and-Running-Schedules","title":"Building and Running Schedules"},{"identifiers":["doc:\/\/Systems\/documentation\/Systems\/MainActorSystem"],"anchor":"Main-Actor-Systems","title":"Main-Actor Systems"},{"identifiers":["doc:\/\/Systems\/documentation\/Systems\/UpdateEvents","doc:\/\/Systems\/documentation\/Systems\/ForwardEvents","doc:\/\/Systems\/documentation\/Systems\/ForwardChanges"],"anchor":"Built-In-Systems","title":"Built-In Systems"},{"identifiers":["doc:\/\/Systems\/documentation\/Systems\/SystemProfile","doc:\/\/Systems\/documentation\/Systems\/SystemTiming"],"anchor":"Profiling","title":"Profiling"}],"abstract":[{"text":"Declare the rules of a simulation as systems, and run them on a world in a schedule.","type":"text"}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/systems"]}],"metadata":{"symbolKind":"module","externalID":"Systems","modules":[{"name":"Systems"}],"role":"collection","title":"Systems","roleHeading":"Framework"},"primaryContentSections":[{"content":[{"text":"Overview","type":"heading","anchor":"Overview","level":2},{"type":"paragraph","inlineContent":[{"type":"text","text":"A world holds data: entities and their components, and resources. A "},{"inlineContent":[{"text":"system","type":"text"}],"type":"emphasis"},{"type":"text","text":" holds a rule: a"},{"type":"text","text":" "},{"type":"text","text":"step that reads part of the world and changes part of it, such as “every entity with a velocity"},{"type":"text","text":" "},{"type":"text","text":"moves” or “gravity pulls on everything that isn’t frozen.” A "},{"inlineContent":[{"type":"text","text":"schedule"}],"type":"emphasis"},{"type":"text","text":" lists the systems of one"},{"type":"text","text":" "},{"type":"text","text":"frame or step and runs them on a world, each once per run."}]},{"type":"paragraph","inlineContent":[{"text":"The examples throughout this module use these components, resources and event:","type":"text"}]},{"code":["struct Position: Component { var x: Double, y: Double }","struct Velocity: Component { var dx: Double, dy: Double }","struct Health: Component { var current: Int }","struct Frozen: Component {}","","struct Score: Resource { var points: Int }","struct TimeStep: Resource { var seconds: Double }","struct Paused: Resource {}","","struct Damage: Event { var target: Entity, amount: Int }"],"type":"codeListing","syntax":"swift"},{"text":"Declare a System","type":"heading","anchor":"Declare-a-System","level":3},{"type":"paragraph","inlineContent":[{"type":"text","text":"The simplest way to write a system is to mark a type with the "},{"code":"@System","type":"codeVoice"},{"type":"text","text":" macro and give it a"},{"type":"text","text":" "},{"code":"run","type":"codeVoice"},{"type":"text","text":" method. The method’s parameters say what the system works on, and their types say how:"},{"type":"text","text":" "},{"type":"text","text":"an "},{"identifier":"doc:\/\/Systems\/documentation\/Systems\/Update","type":"reference","isActive":true},{"type":"text","text":" writes components, a "},{"identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/Query","type":"reference","isActive":true},{"type":"text","text":" reads them, and a "},{"identifier":"doc:\/\/Systems\/documentation\/Systems\/ResourceReader","type":"reference","isActive":true},{"type":"text","text":" "},{"type":"text","text":"reads a resource. The following two systems pull everything that isn’t frozen downward, then move"},{"type":"text","text":" "},{"type":"text","text":"it by its velocity:"}]},{"code":["@System","struct Gravity {","    func run(_ falling: Update<Velocity>.Where<Without<Frozen>>) {","        falling { velocity, _ in velocity.dy -= 10 }","    }","}","","@System","struct Movement {","    func run(_ movers: Update<Position>.Over<Velocity>.Where<Without<Frozen>>) {","        movers { position, row in","            position.x += row.components.dx","            position.y += row.components.dy","        }","    }","}"],"type":"codeListing","syntax":"swift"},{"type":"paragraph","inlineContent":[{"text":"Because the parameters’ types state what each system reads and writes, the macro writes the","type":"text"},{"text":" ","type":"text"},{"text":"system’s ","type":"text"},{"type":"reference","identifier":"doc:\/\/Systems\/documentation\/Systems\/System\/access","isActive":true},{"text":" for you: ","type":"text"},{"code":"Gravity","type":"codeVoice"},{"text":" writes ","type":"text"},{"code":"Velocity","type":"codeVoice"},{"text":"; ","type":"text"},{"code":"Movement","type":"codeVoice"},{"text":" writes ","type":"text"},{"code":"Position","type":"codeVoice"},{"text":" and","type":"text"},{"text":" ","type":"text"},{"text":"reads ","type":"text"},{"code":"Velocity","type":"codeVoice"},{"text":". A schedule uses the access to decide which systems can run at the same time.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"You can also conform a type to ","type":"text"},{"identifier":"doc:\/\/Systems\/documentation\/Systems\/System","isActive":true,"type":"reference"},{"text":" by hand and write its ","type":"text"},{"identifier":"doc:\/\/Systems\/documentation\/Systems\/System\/run(in:)","isActive":true,"type":"reference"},{"text":" method, which","type":"text"},{"text":" ","type":"text"},{"text":"receives the whole world. See ","type":"text"},{"identifier":"doc:\/\/Systems\/documentation\/Systems\/System","isActive":true,"type":"reference"},{"text":" for when to do that.","type":"text"}]},{"text":"Run Systems in a Schedule","type":"heading","anchor":"Run-Systems-in-a-Schedule","level":3},{"type":"paragraph","inlineContent":[{"type":"text","text":"A "},{"type":"reference","identifier":"doc:\/\/Systems\/documentation\/Systems\/Schedule","isActive":true},{"type":"text","text":" is built from a list of systems, written in a result builder. Running it runs each"},{"type":"text","text":" "},{"type":"text","text":"system once. The following example drops a ball for one frame:"}]},{"code":["var world = World()","let ball = world.spawn(Position(x: 0, y: 100), Velocity(dx: 1, dy: 0))","","let frame = Schedule {","    Gravity()","    Movement().after(Gravity.self)","}","frame.run(on: &world)","","print(world[Position.self, of: ball])","\/\/ Prints \"Position(x: 1.0, y: 90.0)\""],"type":"codeListing","syntax":"swift"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Systems run in the order you write them, unless an ordering constraint says otherwise."},{"type":"text","text":" "},{"code":"after(_:)","type":"codeVoice"},{"type":"text","text":" and "},{"code":"before(_:)","type":"codeVoice"},{"type":"text","text":" require one system to run after or before another; "},{"identifier":"doc:\/\/Systems\/documentation\/Systems\/SystemSet","type":"reference","isActive":true},{"type":"text","text":" "},{"type":"text","text":"names a group of systems so constraints can refer to all of them at once; and "},{"code":"runIf(_:)","type":"codeVoice"},{"type":"text","text":" skips"},{"type":"text","text":" "},{"type":"text","text":"a system when a condition doesn’t hold."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Systems whose accesses don’t conflict, because neither writes what the other reads or writes,"},{"type":"text","text":" "},{"type":"text","text":"run at the same time, and the world ends as though they had run one after another (commands"},{"type":"text","text":" "},{"type":"text","text":"apply when each wave finishes). Systems that"},{"type":"text","text":" "},{"type":"text","text":"conflict run in order. When two conflicting systems aren’t ordered by any constraint, their order"},{"type":"text","text":" "},{"type":"text","text":"rests only on how they happen to be written; "},{"identifier":"doc:\/\/Systems\/documentation\/Systems\/Schedule\/ambiguities()","type":"reference","isActive":true},{"type":"text","text":" finds those pairs so a"},{"type":"text","text":" "},{"type":"text","text":"test can keep a schedule free of them."}]}],"kind":"content"}],"identifier":{"url":"doc:\/\/Systems\/documentation\/Systems","interfaceLanguage":"swift"},"references":{"doc://WorldModule/documentation/WorldModule/Query":{"navigatorTitle":[{"kind":"identifier","text":"Query"}],"kind":"symbol","identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/Query","abstract":[{"type":"text","text":"A description of the entities to visit and the components to read from each."}],"url":"\/documentation\/worldmodule\/query","title":"Query","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"Query"}],"type":"topic","role":"symbol"},"doc://Systems/documentation/Systems/UpdateEvents":{"title":"UpdateEvents","identifier":"doc:\/\/Systems\/documentation\/Systems\/UpdateEvents","role":"symbol","url":"\/documentation\/systems\/updateevents","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"UpdateEvents","kind":"identifier"}],"abstract":[{"text":"A system that ends the current event update, dropping events old enough that every reader","type":"text"},{"text":" ","type":"text"},{"text":"has had its chance to read them.","type":"text"}],"navigatorTitle":[{"text":"UpdateEvents","kind":"identifier"}],"type":"topic","kind":"symbol"},"doc://Systems/documentation/Systems/ForwardEvents":{"navigatorTitle":[{"kind":"identifier","text":"ForwardEvents"}],"kind":"symbol","identifier":"doc:\/\/Systems\/documentation\/Systems\/ForwardEvents","abstract":[{"type":"text","text":"A system that yields each event of one type to an asynchronous stream, so code outside the"},{"type":"text","text":" "},{"type":"text","text":"schedule can await the events."}],"url":"\/documentation\/systems\/forwardevents","title":"ForwardEvents","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"ForwardEvents"}],"type":"topic","role":"symbol"},"doc://Systems/documentation/Systems/SystemTiming":{"kind":"symbol","abstract":[{"text":"The times one system of a schedule has taken to run.","type":"text"}],"role":"symbol","type":"topic","identifier":"doc:\/\/Systems\/documentation\/Systems\/SystemTiming","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"SystemTiming","kind":"identifier"}],"navigatorTitle":[{"text":"SystemTiming","kind":"identifier"}],"url":"\/documentation\/systems\/systemtiming","title":"SystemTiming"},"doc://Systems/documentation/Systems/System()":{"kind":"symbol","abstract":[{"type":"text","text":"Makes a type a system whose access comes from the parameters of its "},{"type":"codeVoice","code":"run"},{"type":"text","text":" method."}],"role":"symbol","type":"topic","identifier":"doc:\/\/Systems\/documentation\/Systems\/System()","fragments":[{"kind":"keyword","text":"macro"},{"kind":"text","text":" "},{"kind":"identifier","text":"System"},{"kind":"text","text":"()"}],"url":"\/documentation\/systems\/system()","title":"System()"},"doc://Systems/documentation/Systems/ForwardChanges":{"title":"ForwardChanges","identifier":"doc:\/\/Systems\/documentation\/Systems\/ForwardChanges","role":"symbol","url":"\/documentation\/systems\/forwardchanges","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"ForwardChanges","kind":"identifier"}],"abstract":[{"type":"text","text":"A system that yields each component of one type added or changed since it last ran to an"},{"type":"text","text":" "},{"type":"text","text":"asynchronous stream, with its entity."}],"navigatorTitle":[{"text":"ForwardChanges","kind":"identifier"}],"type":"topic","kind":"symbol"},"doc://Systems/documentation/Systems/DeclaringSystems":{"kind":"article","abstract":[{"text":"Write the rules of a simulation as systems, and let their parameters state what they read and","type":"text"},{"text":" ","type":"text"},{"text":"write.","type":"text"}],"role":"collectionGroup","type":"topic","identifier":"doc:\/\/Systems\/documentation\/Systems\/DeclaringSystems","url":"\/documentation\/systems\/declaringsystems","title":"Declaring Systems"},"doc://Systems/documentation/Systems":{"kind":"symbol","url":"\/documentation\/systems","title":"Systems","role":"collection","type":"topic","identifier":"doc:\/\/Systems\/documentation\/Systems","abstract":[{"text":"Declare the rules of a simulation as systems, and run them on a world in a schedule.","type":"text"}]},"doc://Systems/documentation/Systems/EventWriter":{"kind":"symbol","title":"EventWriter","role":"symbol","url":"\/documentation\/systems\/eventwriter","fragments":[{"text":"class","kind":"keyword"},{"text":" ","kind":"text"},{"text":"EventWriter","kind":"identifier"}],"abstract":[{"type":"text","text":"A system parameter that sends events of one type."}],"navigatorTitle":[{"text":"EventWriter","kind":"identifier"}],"type":"topic","identifier":"doc:\/\/Systems\/documentation\/Systems\/EventWriter"},"doc://Systems/documentation/Systems/Ambiguity":{"kind":"symbol","abstract":[{"text":"Two systems of a schedule whose accesses conflict but that no ordering constraint orders, so","type":"text"},{"text":" ","type":"text"},{"text":"the order they run in rests only on the order they were written in.","type":"text"}],"role":"symbol","type":"topic","identifier":"doc:\/\/Systems\/documentation\/Systems\/Ambiguity","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Ambiguity","kind":"identifier"}],"navigatorTitle":[{"text":"Ambiguity","kind":"identifier"}],"url":"\/documentation\/systems\/ambiguity","title":"Ambiguity"},"doc://Systems/documentation/Systems/MainActorSystem":{"title":"MainActorSystem","role":"symbol","navigatorTitle":[{"kind":"identifier","text":"MainActorSystem"}],"type":"topic","url":"\/documentation\/systems\/mainactorsystem","kind":"symbol","identifier":"doc:\/\/Systems\/documentation\/Systems\/MainActorSystem","abstract":[{"type":"text","text":"A system that runs on the main actor, for work that touches main-actor state such as a user"},{"type":"text","text":" "},{"type":"text","text":"interface."}],"fragments":[{"kind":"keyword","text":"protocol"},{"kind":"text","text":" "},{"kind":"identifier","text":"MainActorSystem"}]},"doc://Systems/documentation/Systems/SystemParameter":{"title":"SystemParameter","kind":"symbol","role":"symbol","url":"\/documentation\/systems\/systemparameter","fragments":[{"text":"protocol","kind":"keyword"},{"text":" ","kind":"text"},{"kind":"identifier","text":"SystemParameter"}],"abstract":[{"type":"text","text":"A type a system’s "},{"type":"codeVoice","code":"run"},{"type":"text","text":" method can take in place of the whole world, whose type states what"},{"type":"text","text":" "},{"type":"text","text":"the system reads and writes."}],"navigatorTitle":[{"kind":"identifier","text":"SystemParameter"}],"type":"topic","identifier":"doc:\/\/Systems\/documentation\/Systems\/SystemParameter"},"doc://Systems/documentation/Systems/RemovedComponents":{"title":"RemovedComponents","role":"symbol","navigatorTitle":[{"kind":"identifier","text":"RemovedComponents"}],"type":"topic","url":"\/documentation\/systems\/removedcomponents","kind":"symbol","abstract":[{"type":"text","text":"A system parameter that lists the entities that lost a component since the system last read"},{"type":"text","text":" "},{"type":"text","text":"them."}],"identifier":"doc:\/\/Systems\/documentation\/Systems\/RemovedComponents","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"RemovedComponents"}]},"doc://Systems/documentation/Systems/ResourceWriter":{"title":"ResourceWriter","identifier":"doc:\/\/Systems\/documentation\/Systems\/ResourceWriter","role":"symbol","url":"\/documentation\/systems\/resourcewriter","fragments":[{"text":"class","kind":"keyword"},{"text":" ","kind":"text"},{"text":"ResourceWriter","kind":"identifier"}],"abstract":[{"type":"text","text":"A system parameter that reads and writes a resource."}],"navigatorTitle":[{"text":"ResourceWriter","kind":"identifier"}],"type":"topic","kind":"symbol"},"doc://Systems/documentation/Systems/ScheduleBuilder":{"identifier":"doc:\/\/Systems\/documentation\/Systems\/ScheduleBuilder","title":"ScheduleBuilder","role":"symbol","url":"\/documentation\/systems\/schedulebuilder","fragments":[{"text":"enum","kind":"keyword"},{"text":" ","kind":"text"},{"text":"ScheduleBuilder","kind":"identifier"}],"abstract":[{"type":"text","text":"A result builder that collects the systems written in a "},{"type":"reference","isActive":true,"identifier":"doc:\/\/Systems\/documentation\/Systems\/Schedule"},{"type":"text","text":"’s closure."}],"navigatorTitle":[{"text":"ScheduleBuilder","kind":"identifier"}],"type":"topic","kind":"symbol"},"doc://Systems/documentation/Systems/DrivingAWorldFromAnApp":{"title":"Driving a World from an App","type":"topic","url":"\/documentation\/systems\/drivingaworldfromanapp","abstract":[{"type":"text","text":"Hold a world in your app or game engine, feed it each frame’s input, and let the objects outside"},{"type":"text","text":" "},{"type":"text","text":"it read results and take part in a step."}],"kind":"article","role":"article","identifier":"doc:\/\/Systems\/documentation\/Systems\/DrivingAWorldFromAnApp"},"doc://Systems/documentation/Systems/System/access":{"abstract":[{"type":"text","text":"The component, resource and event types the system reads and writes, or "},{"type":"codeVoice","code":"nil"},{"type":"text","text":" if it may"},{"type":"text","text":" "},{"type":"text","text":"change anything."}],"role":"symbol","fragments":[{"kind":"keyword","text":"var"},{"kind":"text","text":" "},{"text":"access","kind":"identifier"},{"text":": ","kind":"text"},{"text":"Access","kind":"typeIdentifier","preciseIdentifier":"s:11WorldModule6AccessV"},{"text":"?","kind":"text"}],"defaultImplementations":1,"url":"\/documentation\/systems\/system\/access","required":true,"kind":"symbol","type":"topic","identifier":"doc:\/\/Systems\/documentation\/Systems\/System\/access","title":"access"},"doc://Systems/documentation/Systems/CyclicOrdering":{"navigatorTitle":[{"kind":"identifier","text":"CyclicOrdering"}],"kind":"symbol","identifier":"doc:\/\/Systems\/documentation\/Systems\/CyclicOrdering","abstract":[{"type":"text","text":"An error indicating that the ordering constraints of a schedule’s systems form a cycle, so no"},{"type":"text","text":" "},{"type":"text","text":"order satisfies them all."}],"url":"\/documentation\/systems\/cyclicordering","title":"CyclicOrdering","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"CyclicOrdering"}],"type":"topic","role":"symbol"},"doc://Systems/documentation/Systems/ScheduledSystem":{"identifier":"doc:\/\/Systems\/documentation\/Systems\/ScheduledSystem","title":"ScheduledSystem","role":"symbol","url":"\/documentation\/systems\/scheduledsystem","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"ScheduledSystem","kind":"identifier"}],"abstract":[{"type":"text","text":"A system together with the ordering constraints, sets and conditions a schedule runs it with."}],"navigatorTitle":[{"text":"ScheduledSystem","kind":"identifier"}],"type":"topic","kind":"symbol"},"doc://Systems/documentation/Systems/EventReader":{"navigatorTitle":[{"text":"EventReader","kind":"identifier"}],"title":"EventReader","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"EventReader","kind":"identifier"}],"type":"topic","url":"\/documentation\/systems\/eventreader","abstract":[{"type":"text","text":"A system parameter that reads the events of one type sent since the system last read them."}],"kind":"symbol","role":"symbol","identifier":"doc:\/\/Systems\/documentation\/Systems\/EventReader"},"doc://Systems/documentation/Systems/SystemSet":{"kind":"symbol","url":"\/documentation\/systems\/systemset","fragments":[{"kind":"keyword","text":"protocol"},{"kind":"text","text":" "},{"kind":"identifier","text":"SystemSet"}],"title":"SystemSet","role":"symbol","type":"topic","identifier":"doc:\/\/Systems\/documentation\/Systems\/SystemSet","navigatorTitle":[{"kind":"identifier","text":"SystemSet"}],"abstract":[{"text":"A type that names a group of systems, so ordering constraints can refer to all of them at","type":"text"},{"text":" ","type":"text"},{"text":"once.","type":"text"}]},"doc://Systems/documentation/Systems/System/run(in:)":{"title":"run(in:)","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"run"},{"kind":"text","text":"("},{"kind":"externalParam","text":"in"},{"kind":"text","text":": "},{"kind":"keyword","text":"inout"},{"kind":"text","text":" "},{"kind":"typeIdentifier","preciseIdentifier":"s:11WorldModule0A0V","text":"World"},{"kind":"text","text":")"}],"type":"topic","abstract":[{"text":"Runs the system’s rule once on a world.","type":"text"}],"url":"\/documentation\/systems\/system\/run(in:)","kind":"symbol","required":true,"role":"symbol","identifier":"doc:\/\/Systems\/documentation\/Systems\/System\/run(in:)"},"doc://Systems/documentation/Systems/ResourceReader":{"title":"ResourceReader","kind":"symbol","role":"symbol","url":"\/documentation\/systems\/resourcereader","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"ResourceReader","kind":"identifier"}],"abstract":[{"type":"text","text":"A system parameter that reads a resource."}],"navigatorTitle":[{"text":"ResourceReader","kind":"identifier"}],"type":"topic","identifier":"doc:\/\/Systems\/documentation\/Systems\/ResourceReader"},"doc://Systems/documentation/Systems/Update":{"title":"Update","role":"symbol","navigatorTitle":[{"kind":"identifier","text":"Update"}],"type":"topic","url":"\/documentation\/systems\/update","kind":"symbol","identifier":"doc:\/\/Systems\/documentation\/Systems\/Update","abstract":[{"type":"text","text":"A system parameter that changes a component of every entity that holds it."}],"fragments":[{"kind":"keyword","text":"class"},{"kind":"text","text":" "},{"kind":"identifier","text":"Update"}]},"doc://Systems/documentation/Systems/SystemProfile":{"identifier":"doc:\/\/Systems\/documentation\/Systems\/SystemProfile","title":"SystemProfile","role":"symbol","url":"\/documentation\/systems\/systemprofile","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"SystemProfile"}],"abstract":[{"text":"A resource that records how long each system takes to run.","type":"text"}],"navigatorTitle":[{"kind":"identifier","text":"SystemProfile"}],"type":"topic","kind":"symbol"},"doc://Systems/documentation/Systems/System":{"kind":"symbol","url":"\/documentation\/systems\/system","fragments":[{"kind":"keyword","text":"protocol"},{"kind":"text","text":" "},{"kind":"identifier","text":"System"}],"title":"System","role":"symbol","type":"topic","identifier":"doc:\/\/Systems\/documentation\/Systems\/System","navigatorTitle":[{"kind":"identifier","text":"System"}],"abstract":[{"type":"text","text":"A rule that reads and changes a world, run once each time its schedule runs."}]},"doc://Systems/documentation/Systems/Schedule/ambiguities()":{"kind":"symbol","abstract":[{"type":"text","text":"Returns every pair of systems whose accesses conflict but that no ordering constraint"},{"type":"text","text":" "},{"type":"text","text":"orders."}],"role":"symbol","type":"topic","identifier":"doc:\/\/Systems\/documentation\/Systems\/Schedule\/ambiguities()","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"ambiguities","kind":"identifier"},{"text":"() -> [","kind":"text"},{"text":"Ambiguity","preciseIdentifier":"s:7Systems9AmbiguityV","kind":"typeIdentifier"},{"text":"]","kind":"text"}],"url":"\/documentation\/systems\/schedule\/ambiguities()","title":"ambiguities()"},"doc://Systems/documentation/Systems/Schedule":{"abstract":[{"type":"text","text":"A list of systems that run on a world, in order, and at the same time where they can."}],"role":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Schedule","kind":"identifier"}],"url":"\/documentation\/systems\/schedule","navigatorTitle":[{"text":"Schedule","kind":"identifier"}],"kind":"symbol","type":"topic","identifier":"doc:\/\/Systems\/documentation\/Systems\/Schedule","title":"Schedule"}}}