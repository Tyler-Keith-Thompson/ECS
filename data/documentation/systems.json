{"kind":"symbol","abstract":[{"text":"Declare the rules of a simulation as systems, and run them on a world in a schedule.","type":"text"}],"hierarchy":{"paths":[[]]},"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/systems"]}],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/Systems\/documentation\/Systems"},"topicSections":[{"anchor":"Essentials","title":"Essentials","identifiers":["doc:\/\/Systems\/documentation\/Systems\/DeclaringSystems","doc:\/\/Systems\/documentation\/Systems\/DrivingAWorldFromAnApp","doc:\/\/Systems\/documentation\/Systems\/System()","doc:\/\/Systems\/documentation\/Systems\/System"]},{"anchor":"System-Parameters","title":"System Parameters","identifiers":["doc:\/\/Systems\/documentation\/Systems\/SystemParameter","doc:\/\/Systems\/documentation\/Systems\/Update","doc:\/\/Systems\/documentation\/Systems\/ResourceReader","doc:\/\/Systems\/documentation\/Systems\/ResourceWriter","doc:\/\/Systems\/documentation\/Systems\/EventReader","doc:\/\/Systems\/documentation\/Systems\/EventWriter","doc:\/\/Systems\/documentation\/Systems\/RemovedComponents"]},{"anchor":"Building-and-Running-Schedules","title":"Building and Running Schedules","identifiers":["doc:\/\/Systems\/documentation\/Systems\/Schedule","doc:\/\/Systems\/documentation\/Systems\/ScheduleBuilder","doc:\/\/Systems\/documentation\/Systems\/ScheduledSystem","doc:\/\/Systems\/documentation\/Systems\/SystemSet","doc:\/\/Systems\/documentation\/Systems\/CyclicOrdering","doc:\/\/Systems\/documentation\/Systems\/Ambiguity"]},{"anchor":"Main-Actor-Systems","title":"Main-Actor Systems","identifiers":["doc:\/\/Systems\/documentation\/Systems\/MainActorSystem"]},{"anchor":"Built-In-Systems","title":"Built-In Systems","identifiers":["doc:\/\/Systems\/documentation\/Systems\/UpdateEvents","doc:\/\/Systems\/documentation\/Systems\/ForwardEvents","doc:\/\/Systems\/documentation\/Systems\/ForwardChanges"]},{"anchor":"Profiling","title":"Profiling","identifiers":["doc:\/\/Systems\/documentation\/Systems\/SystemProfile","doc:\/\/Systems\/documentation\/Systems\/SystemTiming"]}],"sections":[],"schemaVersion":{"major":0,"patch":0,"minor":3},"primaryContentSections":[{"content":[{"type":"heading","level":2,"text":"Overview","anchor":"Overview"},{"type":"paragraph","inlineContent":[{"type":"text","text":"A world holds data: entities and their components, and resources. A "},{"type":"emphasis","inlineContent":[{"type":"text","text":"system"}]},{"type":"text","text":" holds a rule: a"},{"type":"text","text":" "},{"type":"text","text":"step that reads part of the world and changes part of it, such as “every entity with a velocity"},{"type":"text","text":" "},{"type":"text","text":"moves” or “gravity pulls on everything that isn’t frozen.” A "},{"type":"emphasis","inlineContent":[{"text":"schedule","type":"text"}]},{"type":"text","text":" lists the systems of one"},{"type":"text","text":" "},{"type":"text","text":"frame or step and runs them on a world, each once per run."}]},{"type":"paragraph","inlineContent":[{"text":"The examples throughout this module use these components, resources and event:","type":"text"}]},{"type":"codeListing","syntax":"swift","code":["struct Position: Component { var x: Double, y: Double }","struct Velocity: Component { var dx: Double, dy: Double }","struct Health: Component { var current: Int }","struct Frozen: Component {}","","struct Score: Resource { var points: Int }","struct TimeStep: Resource { var seconds: Double }","struct Paused: Resource {}","","struct Damage: Event { var target: Entity, amount: Int }"]},{"type":"heading","level":3,"text":"Declare a System","anchor":"Declare-a-System"},{"type":"paragraph","inlineContent":[{"text":"The simplest way to write a system is to mark a type with the ","type":"text"},{"type":"codeVoice","code":"@System"},{"text":" macro and give it a","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"run"},{"text":" method. The method’s parameters say what the system works on, and their types say how:","type":"text"},{"text":" ","type":"text"},{"text":"an ","type":"text"},{"type":"reference","identifier":"doc:\/\/Systems\/documentation\/Systems\/Update","isActive":true},{"text":" writes components, a ","type":"text"},{"type":"reference","identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/Query","isActive":true},{"text":" reads them, and a ","type":"text"},{"type":"reference","identifier":"doc:\/\/Systems\/documentation\/Systems\/ResourceReader","isActive":true},{"text":" ","type":"text"},{"text":"reads a resource. The following two systems pull everything that isn’t frozen downward, then move","type":"text"},{"text":" ","type":"text"},{"text":"it by its velocity:","type":"text"}]},{"type":"codeListing","syntax":"swift","code":["@System","struct Gravity {","    func run(_ falling: Update<Velocity>.Where<Without<Frozen>>) {","        falling { velocity, _ in velocity.dy -= 10 }","    }","}","","@System","struct Movement {","    func run(_ movers: Update<Position>.Over<Velocity>.Where<Without<Frozen>>) {","        movers { position, row in","            position.x += row.components.dx","            position.y += row.components.dy","        }","    }","}"]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Because the parameters’ types state what each system reads and writes, the macro writes the"},{"type":"text","text":" "},{"type":"text","text":"system’s "},{"identifier":"doc:\/\/Systems\/documentation\/Systems\/System\/access","type":"reference","isActive":true},{"type":"text","text":" for you: "},{"code":"Gravity","type":"codeVoice"},{"type":"text","text":" writes "},{"code":"Velocity","type":"codeVoice"},{"type":"text","text":"; "},{"code":"Movement","type":"codeVoice"},{"type":"text","text":" writes "},{"code":"Position","type":"codeVoice"},{"type":"text","text":" and"},{"type":"text","text":" "},{"type":"text","text":"reads "},{"code":"Velocity","type":"codeVoice"},{"type":"text","text":". A schedule uses the access to decide which systems can run at the same time."}]},{"type":"paragraph","inlineContent":[{"text":"You can also conform a type to ","type":"text"},{"identifier":"doc:\/\/Systems\/documentation\/Systems\/System","isActive":true,"type":"reference"},{"text":" by hand and write its ","type":"text"},{"identifier":"doc:\/\/Systems\/documentation\/Systems\/System\/run(in:)","isActive":true,"type":"reference"},{"text":" method, which","type":"text"},{"text":" ","type":"text"},{"text":"receives the whole world. See ","type":"text"},{"identifier":"doc:\/\/Systems\/documentation\/Systems\/System","isActive":true,"type":"reference"},{"text":" for when to do that.","type":"text"}]},{"type":"heading","level":3,"text":"Run Systems in a Schedule","anchor":"Run-Systems-in-a-Schedule"},{"type":"paragraph","inlineContent":[{"type":"text","text":"A "},{"type":"reference","isActive":true,"identifier":"doc:\/\/Systems\/documentation\/Systems\/Schedule"},{"type":"text","text":" is built from a list of systems, written in a result builder. Running it runs each"},{"type":"text","text":" "},{"type":"text","text":"system once. The following example drops a ball for one frame:"}]},{"type":"codeListing","syntax":"swift","code":["var world = World()","let ball = world.spawn(Position(x: 0, y: 100), Velocity(dx: 1, dy: 0))","","let frame = Schedule {","    Gravity()","    Movement().after(Gravity.self)","}","frame.run(on: &world)","","print(world[Position.self, of: ball])","\/\/ Prints \"Position(x: 1.0, y: 90.0)\""]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Systems run in the order you write them, unless an ordering constraint says otherwise."},{"type":"text","text":" "},{"code":"after(_:)","type":"codeVoice"},{"type":"text","text":" and "},{"code":"before(_:)","type":"codeVoice"},{"type":"text","text":" require one system to run after or before another; "},{"identifier":"doc:\/\/Systems\/documentation\/Systems\/SystemSet","isActive":true,"type":"reference"},{"type":"text","text":" "},{"type":"text","text":"names a group of systems so constraints can refer to all of them at once; and "},{"code":"runIf(_:)","type":"codeVoice"},{"type":"text","text":" skips"},{"type":"text","text":" "},{"type":"text","text":"a system when a condition doesn’t hold."}]},{"type":"paragraph","inlineContent":[{"text":"Systems whose accesses don’t conflict, because neither writes what the other reads or writes,","type":"text"},{"text":" ","type":"text"},{"text":"run at the same time, and the world ends as though they had run one after another (commands","type":"text"},{"text":" ","type":"text"},{"text":"apply when each wave finishes). Systems that","type":"text"},{"text":" ","type":"text"},{"text":"conflict run in order. When two conflicting systems aren’t ordered by any constraint, their order","type":"text"},{"text":" ","type":"text"},{"text":"rests only on how they happen to be written; ","type":"text"},{"type":"reference","identifier":"doc:\/\/Systems\/documentation\/Systems\/Schedule\/ambiguities()","isActive":true},{"text":" finds those pairs so a","type":"text"},{"text":" ","type":"text"},{"text":"test can keep a schedule free of them.","type":"text"}]}],"kind":"content"}],"metadata":{"modules":[{"name":"Systems"}],"symbolKind":"module","title":"Systems","role":"collection","roleHeading":"Framework","externalID":"Systems"},"references":{"doc://Systems/documentation/Systems/Update":{"url":"\/documentation\/systems\/update","kind":"symbol","title":"Update","identifier":"doc:\/\/Systems\/documentation\/Systems\/Update","type":"topic","abstract":[{"type":"text","text":"A system parameter that changes a component of every entity that holds it."}],"fragments":[{"kind":"keyword","text":"class"},{"kind":"text","text":" "},{"kind":"identifier","text":"Update"}],"navigatorTitle":[{"kind":"identifier","text":"Update"}],"role":"symbol"},"doc://Systems/documentation/Systems/SystemTiming":{"navigatorTitle":[{"text":"SystemTiming","kind":"identifier"}],"abstract":[{"type":"text","text":"The times one system of a schedule has taken to run."}],"type":"topic","kind":"symbol","role":"symbol","identifier":"doc:\/\/Systems\/documentation\/Systems\/SystemTiming","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"SystemTiming","kind":"identifier"}],"title":"SystemTiming","url":"\/documentation\/systems\/systemtiming"},"doc://Systems/documentation/Systems/CyclicOrdering":{"identifier":"doc:\/\/Systems\/documentation\/Systems\/CyclicOrdering","url":"\/documentation\/systems\/cyclicordering","type":"topic","kind":"symbol","navigatorTitle":[{"text":"CyclicOrdering","kind":"identifier"}],"fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"CyclicOrdering","kind":"identifier"}],"title":"CyclicOrdering","role":"symbol","abstract":[{"type":"text","text":"An error indicating that the ordering constraints of a schedule’s systems form a cycle, so no"},{"type":"text","text":" "},{"type":"text","text":"order satisfies them all."}]},"doc://Systems/documentation/Systems/System()":{"type":"topic","abstract":[{"type":"text","text":"Makes a type a system whose access comes from the parameters of its "},{"code":"run","type":"codeVoice"},{"type":"text","text":" method."}],"kind":"symbol","role":"symbol","identifier":"doc:\/\/Systems\/documentation\/Systems\/System()","fragments":[{"text":"macro","kind":"keyword"},{"text":" ","kind":"text"},{"text":"System","kind":"identifier"},{"text":"()","kind":"text"}],"title":"System()","url":"\/documentation\/systems\/system()"},"doc://Systems/documentation/Systems/Schedule/ambiguities()":{"identifier":"doc:\/\/Systems\/documentation\/Systems\/Schedule\/ambiguities()","type":"topic","url":"\/documentation\/systems\/schedule\/ambiguities()","kind":"symbol","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"ambiguities","kind":"identifier"},{"text":"() -> [","kind":"text"},{"text":"Ambiguity","preciseIdentifier":"s:7Systems9AmbiguityV","kind":"typeIdentifier"},{"text":"]","kind":"text"}],"title":"ambiguities()","role":"symbol","abstract":[{"text":"Returns every pair of systems whose accesses conflict but that no ordering constraint","type":"text"},{"text":" ","type":"text"},{"text":"orders.","type":"text"}]},"doc://Systems/documentation/Systems/Ambiguity":{"role":"symbol","identifier":"doc:\/\/Systems\/documentation\/Systems\/Ambiguity","title":"Ambiguity","navigatorTitle":[{"text":"Ambiguity","kind":"identifier"}],"abstract":[{"type":"text","text":"Two systems of a schedule whose accesses conflict but that no ordering constraint orders, so"},{"type":"text","text":" "},{"type":"text","text":"the order they run in rests only on the order they were written in."}],"kind":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Ambiguity","kind":"identifier"}],"type":"topic","url":"\/documentation\/systems\/ambiguity"},"doc://Systems/documentation/Systems/UpdateEvents":{"navigatorTitle":[{"kind":"identifier","text":"UpdateEvents"}],"abstract":[{"type":"text","text":"A system that ends the current event update, dropping events old enough that every reader"},{"type":"text","text":" "},{"type":"text","text":"has had its chance to read them."}],"type":"topic","kind":"symbol","role":"symbol","identifier":"doc:\/\/Systems\/documentation\/Systems\/UpdateEvents","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"UpdateEvents"}],"title":"UpdateEvents","url":"\/documentation\/systems\/updateevents"},"doc://Systems/documentation/Systems/RemovedComponents":{"navigatorTitle":[{"kind":"identifier","text":"RemovedComponents"}],"abstract":[{"text":"A system parameter that lists the entities that lost a component since the system last read","type":"text"},{"text":" ","type":"text"},{"text":"them.","type":"text"}],"type":"topic","kind":"symbol","role":"symbol","identifier":"doc:\/\/Systems\/documentation\/Systems\/RemovedComponents","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"RemovedComponents"}],"title":"RemovedComponents","url":"\/documentation\/systems\/removedcomponents"},"doc://Systems/documentation/Systems/SystemProfile":{"role":"symbol","identifier":"doc:\/\/Systems\/documentation\/Systems\/SystemProfile","title":"SystemProfile","navigatorTitle":[{"text":"SystemProfile","kind":"identifier"}],"abstract":[{"text":"A resource that records how long each system takes to run.","type":"text"}],"kind":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"SystemProfile","kind":"identifier"}],"type":"topic","url":"\/documentation\/systems\/systemprofile"},"doc://Systems/documentation/Systems/DeclaringSystems":{"url":"\/documentation\/systems\/declaringsystems","role":"collectionGroup","kind":"article","title":"Declaring Systems","identifier":"doc:\/\/Systems\/documentation\/Systems\/DeclaringSystems","abstract":[{"text":"Write the rules of a simulation as systems, and let their parameters state what they read and","type":"text"},{"text":" ","type":"text"},{"text":"write.","type":"text"}],"type":"topic"},"doc://Systems/documentation/Systems/Schedule":{"navigatorTitle":[{"text":"Schedule","kind":"identifier"}],"type":"topic","abstract":[{"type":"text","text":"A list of systems that run on a world, in order, and at the same time where they can."}],"kind":"symbol","role":"symbol","identifier":"doc:\/\/Systems\/documentation\/Systems\/Schedule","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Schedule","kind":"identifier"}],"title":"Schedule","url":"\/documentation\/systems\/schedule"},"doc://Systems/documentation/Systems/ForwardChanges":{"abstract":[{"type":"text","text":"A system that yields each component of one type added or changed since it last ran to an"},{"type":"text","text":" "},{"type":"text","text":"asynchronous stream, with its entity."}],"role":"symbol","kind":"symbol","identifier":"doc:\/\/Systems\/documentation\/Systems\/ForwardChanges","type":"topic","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"ForwardChanges","kind":"identifier"}],"url":"\/documentation\/systems\/forwardchanges","title":"ForwardChanges","navigatorTitle":[{"text":"ForwardChanges","kind":"identifier"}]},"doc://Systems/documentation/Systems/System/run(in:)":{"url":"\/documentation\/systems\/system\/run(in:)","type":"topic","identifier":"doc:\/\/Systems\/documentation\/Systems\/System\/run(in:)","kind":"symbol","required":true,"fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"run"},{"kind":"text","text":"("},{"kind":"externalParam","text":"in"},{"kind":"text","text":": "},{"kind":"keyword","text":"inout"},{"kind":"text","text":" "},{"kind":"typeIdentifier","preciseIdentifier":"s:11WorldModule0A0V","text":"World"},{"kind":"text","text":")"}],"title":"run(in:)","role":"symbol","abstract":[{"text":"Runs the system’s rule once on a world.","type":"text"}]},"doc://Systems/documentation/Systems/ScheduledSystem":{"kind":"symbol","url":"\/documentation\/systems\/scheduledsystem","title":"ScheduledSystem","identifier":"doc:\/\/Systems\/documentation\/Systems\/ScheduledSystem","type":"topic","abstract":[{"type":"text","text":"A system together with the ordering constraints, sets and conditions a schedule runs it with."}],"fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"ScheduledSystem"}],"navigatorTitle":[{"kind":"identifier","text":"ScheduledSystem"}],"role":"symbol"},"doc://Systems/documentation/Systems/ResourceWriter":{"url":"\/documentation\/systems\/resourcewriter","kind":"symbol","title":"ResourceWriter","identifier":"doc:\/\/Systems\/documentation\/Systems\/ResourceWriter","type":"topic","abstract":[{"text":"A system parameter that reads and writes a resource.","type":"text"}],"fragments":[{"kind":"keyword","text":"class"},{"kind":"text","text":" "},{"kind":"identifier","text":"ResourceWriter"}],"navigatorTitle":[{"kind":"identifier","text":"ResourceWriter"}],"role":"symbol"},"doc://Systems/documentation/Systems/System/access":{"defaultImplementations":1,"kind":"symbol","url":"\/documentation\/systems\/system\/access","required":true,"title":"access","identifier":"doc:\/\/Systems\/documentation\/Systems\/System\/access","type":"topic","abstract":[{"text":"The component, resource and event types the system reads and writes, or ","type":"text"},{"code":"nil","type":"codeVoice"},{"text":" if it may","type":"text"},{"text":" ","type":"text"},{"text":"change anything.","type":"text"}],"fragments":[{"text":"var","kind":"keyword"},{"text":" ","kind":"text"},{"kind":"identifier","text":"access"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"Access","preciseIdentifier":"s:11WorldModule6AccessV"},{"kind":"text","text":"?"}],"role":"symbol"},"doc://Systems/documentation/Systems/ResourceReader":{"kind":"symbol","url":"\/documentation\/systems\/resourcereader","title":"ResourceReader","identifier":"doc:\/\/Systems\/documentation\/Systems\/ResourceReader","type":"topic","abstract":[{"text":"A system parameter that reads a resource.","type":"text"}],"fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"ResourceReader","kind":"identifier"}],"navigatorTitle":[{"text":"ResourceReader","kind":"identifier"}],"role":"symbol"},"doc://Systems/documentation/Systems":{"abstract":[{"type":"text","text":"Declare the rules of a simulation as systems, and run them on a world in a schedule."}],"type":"topic","kind":"symbol","role":"collection","identifier":"doc:\/\/Systems\/documentation\/Systems","title":"Systems","url":"\/documentation\/systems"},"doc://Systems/documentation/Systems/System":{"navigatorTitle":[{"kind":"identifier","text":"System"}],"abstract":[{"text":"A rule that reads and changes a world, run once 