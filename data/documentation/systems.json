et":{"type":"topic","abstract":[{"type":"text","text":"A type that names a group of systems, so ordering constraints can refer to all of them at"},{"type":"text","text":" "},{"type":"text","text":"once."}],"kind":"symbol","identifier":"doc:\/\/Systems\/documentation\/Systems\/SystemSet","role":"symbol","url":"\/documentation\/systems\/systemset","navigatorTitle":[{"kind":"identifier","text":"SystemSet"}],"title":"SystemSet","fragments":[{"kind":"keyword","text":"protocol"},{"kind":"text","text":" "},{"kind":"identifier","text":"SystemSet"}]},"doc://Systems/documentation/Systems/SystemParameter":{"type":"topic","kind":"symbol","identifier":"doc:\/\/Systems\/documentation\/Systems\/SystemParameter","url":"\/documentation\/systems\/systemparameter","navigatorTitle":[{"kind":"identifier","text":"SystemParameter"}],"role":"symbol","abstract":[{"type":"text","text":"A type a system’s "},{"type":"codeVoice","code":"run"},{"type":"text","text":" method can take in place of the whole world, whose type states what"},{"type":"text","text":" "},{"type":"text","text":"the system reads and writes."}],"title":"SystemParameter","fragments":[{"kind":"keyword","text":"protocol"},{"kind":"text","text":" "},{"kind":"identifier","text":"SystemParameter"}]},"doc://Systems/documentation/Systems/SystemProfile":{"url":"\/documentation\/systems\/systemprofile","kind":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"SystemProfile"}],"role":"symbol","title":"SystemProfile","navigatorTitle":[{"kind":"identifier","text":"SystemProfile"}],"abstract":[{"text":"A resource that records how long each system takes to run.","type":"text"}],"type":"topic","identifier":"doc:\/\/Systems\/documentation\/Systems\/SystemProfile"},"doc://Systems/documentation/Systems/ScheduleBuilder":{"type":"topic","abstract":[{"type":"text","text":"A result builder that collects the systems written in a "},{"identifier":"doc:\/\/Systems\/documentation\/Systems\/Schedule","type":"reference","isActive":true},{"type":"text","text":"’s closure."}],"kind":"symbol","identifier":"doc:\/\/Systems\/documentation\/Systems\/ScheduleBuilder","role":"symbol","url":"\/documentation\/systems\/schedulebuilder","navigatorTitle":[{"text":"ScheduleBuilder","kind":"identifier"}],"title":"ScheduleBuilder","fragments":[{"text":"enum","kind":"keyword"},{"text":" ","kind":"text"},{"text":"ScheduleBuilder","kind":"identifier"}]},"doc://Systems/documentation/Systems/Ambiguity":{"type":"topic","kind":"symbol","identifier":"doc:\/\/Systems\/documentation\/Systems\/Ambiguity","url":"\/documentation\/systems\/ambiguity","navigatorTitle":[{"text":"Ambiguity","kind":"identifier"}],"role":"symbol","abstract":[{"text":"Two systems of a schedule whose accesses conflict but that no ordering constraint orders, so","type":"text"},{"text":" ","type":"text"},{"text":"the order they run in rests only on the order they were written in.","type":"text"}],"title":"Ambiguity","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Ambiguity","kind":"identifier"}]},"doc://Systems/documentation/Systems/MainActorSystem":{"navigatorTitle":[{"kind":"identifier","text":"MainActorSystem"}],"title":"MainActorSystem","fragments":[{"kind":"keyword","text":"protocol"},{"kind":"text","text":" "},{"kind":"identifier","text":"MainActorSystem"}],"type":"topic","identifier":"doc:\/\/Systems\/documentation\/Systems\/MainActorSystem","abstract":[{"type":"text","text":"A system that runs on the main actor, for work that touches main-actor state such as a user"},{"type":"text","text":" "},{"type":"text","text":"interface."}],"url":"\/documentation\/systems\/mainactorsystem","role":"symbol","kind":"symbol"},"doc://Systems/documentation/Systems/EventWriter":{"type":"topic","abstract":[{"type":"text","text":"A system parameter that sends events of one type."}],"kind":"symbol","identifier":"doc:\/\/Systems\/documentation\/Systems\/EventWriter","role":"symbol","url":"\/documentation\/systems\/eventwriter","navigatorTitle":[{"kind":"identifier","text":"EventWriter"}],"title":"EventWriter","fragments":[{"kind":"keyword","text":"class"},{"kind":"text","text":" "},{"kind":"identifier","text":"EventWriter"}]},"doc://Systems/documentation/Systems/System/access":{"defaultImplementations":1,"required":true,"kind":"symbol","title":"access","role":"symbol","identifier":"doc:\/\/Systems\/documentation\/Systems\/System\/access","abstract":[{"type":"text","text":"The component, resource and event types the system reads and writes, or "},{"code":"nil","type":"codeVoice"},{"type":"text","text":" if it may"},{"type":"text","text":" "},{"type":"text","text":"change anything."}],"url":"\/documentation\/systems\/system\/access","type":"topic","fragments":[{"kind":"keyword","text":"var"},{"kind":"text","text":" "},{"text":"access","kind":"identifier"},{"text":": ","kind":"text"},{"text":"Access","kind":"typeIdentifier","preciseIdentifier":"s:11WorldModule6AccessV"},{"text":"?","kind":"text"}]},"doc://Systems/documentation/Systems/RemovedComponents":{"type":"topic","kind":"symbol","identifier":"doc:\/\/Systems\/documentation\/Systems\/RemovedComponents","url":"\/documentation\/systems\/removedcomponents","navigatorTitle":[{"text":"RemovedComponents","kind":"identifier"}],"role":"symbol","abstract":[{"text":"A system parameter that lists the entities that lost a component since the system last read","type":"text"},{"text":" ","type":"text"},{"text":"them.","type":"text"}],"title":"RemovedComponents","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"RemovedComponents","kind":"identifier"}]},"doc://Systems/documentation/Systems/UpdateEvents":{"type":"topic","abstract":[{"type":"text","text":"A system that ends the current event update, dropping events old enough that every reader"},{"type":"text","text":" "},{"type":"text","text":"has had its chance to read them."}],"identifier":"doc:\/\/Systems\/documentation\/Sys