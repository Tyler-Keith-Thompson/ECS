rSystem","navigatorTitle":[{"text":"MainActorSystem","kind":"identifier"}],"type":"topic","title":"MainActorSystem","abstract":[{"type":"text","text":"A system that runs on the main actor, for work that touches main-actor state such as a user"},{"type":"text","text":" "},{"type":"text","text":"interface."}],"role":"symbol","url":"\/documentation\/systems\/mainactorsystem","fragments":[{"text":"protocol","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MainActorSystem","kind":"identifier"}],"kind":"symbol"},"doc://WorldModule/documentation/WorldModule/Query":{"identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/Query","title":"Query","navigatorTitle":[{"kind":"identifier","text":"Query"}],"url":"\/documentation\/worldmodule\/query","kind":"symbol","role":"symbol","abstract":[{"type":"text","text":"A description of the entities to visit and the components to read from each."}],"type":"topic","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"Query"}]},"doc://Systems/documentation/Systems/EventWriter":{"identifier":"doc:\/\/Systems\/documentation\/Systems\/EventWriter","title":"EventWriter","navigatorTitle":[{"kind":"identifier","text":"EventWriter"}],"url":"\/documentation\/systems\/eventwriter","kind":"symbol","role":"symbol","type":"topic","abstract":[{"type":"text","text":"A system parameter that sends events of one type."}],"fragments":[{"kind":"keyword","text":"class"},{"kind":"text","text":" "},{"kind":"identifier","text":"EventWriter"}]},"doc://Systems/documentation/Systems/System":{"abstract":[{"text":"A rule that reads and changes a world, run once each time its schedule runs.","type":"text"}],"navigatorTitle":[{"kind":"identifier","text":"System"}],"url":"\/documentation\/systems\/system","identifier":"doc:\/\/Systems\/documentation\/Systems\/System","role":"symbol","title":"System","fragments":[{"kind":"keyword","text":"protocol"},{"kind":"text","text":" "},{"kind":"identifier","text":"Syst