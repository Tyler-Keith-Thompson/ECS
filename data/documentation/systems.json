{"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/systems"]}],"topicSections":[{"anchor":"Essentials","title":"Essentials","identifiers":["doc:\/\/Systems\/documentation\/Systems\/DeclaringSystems","doc:\/\/Systems\/documentation\/Systems\/SchedulingSystems","doc:\/\/Systems\/documentation\/Systems\/DrivingAWorldFromAnApp","doc:\/\/Systems\/documentation\/Systems\/System()","doc:\/\/Systems\/documentation\/Systems\/System"]},{"anchor":"System-Parameters","title":"System Parameters","identifiers":["doc:\/\/Systems\/documentation\/Systems\/SystemParameter","doc:\/\/Systems\/documentation\/Systems\/Update","doc:\/\/Systems\/documentation\/Systems\/ResourceReader","doc:\/\/Systems\/documentation\/Systems\/ResourceWriter","doc:\/\/Systems\/documentation\/Systems\/EventReader","doc:\/\/Systems\/documentation\/Systems\/EventWriter","doc:\/\/Systems\/documentation\/Systems\/RemovedComponents"]},{"anchor":"Building-and-Running-Schedules","title":"Building and Running Schedules","identifiers":["doc:\/\/Systems\/documentation\/Systems\/Schedule","doc:\/\/Systems\/documentation\/Systems\/ScheduleBuilder","doc:\/\/Systems\/documentation\/Systems\/ScheduledSystem","doc:\/\/Systems\/documentation\/Systems\/SystemSet","doc:\/\/Systems\/documentation\/Systems\/CyclicOrdering","doc:\/\/Systems\/documentation\/Systems\/Ambiguity"]},{"anchor":"Main-Actor-Systems","title":"Main-Actor Systems","identifiers":["doc:\/\/Systems\/documentation\/Systems\/MainActorSystem"]},{"anchor":"Built-In-Systems","title":"Built-In Systems","identifiers":["doc:\/\/Systems\/documentation\/Systems\/UpdateEvents","doc:\/\/Systems\/documentation\/Systems\/ForwardEvents","doc:\/\/Systems\/documentation\/Systems\/ForwardChanges"]},{"anchor":"Profiling","title":"Profiling","identifiers":["doc:\/\/Systems\/documentation\/Systems\/SystemProfile","doc:\/\/Systems\/documentation\/Systems\/SystemTiming"]}],"primaryContentSections":[{"kind":"content","content":[{"level":2,"anchor":"Overview","type":"heading","text":"Overview"},{"type":"paragraph","inlineContent":[{"text":"A world holds data: entities and their components, and resources. A ","type":"text"},{"inlineContent":[{"type":"text","text":"system"}],"type":"emphasis"},{"text":" holds a rule: a","type":"text"},{"text":" ","type":"text"},{"text":"step that reads part of the world and changes part of it, such as “every entity with a velocity","type":"text"},{"text":" ","type":"text"},{"text":"moves” or “gravity pulls on everything that isn’t frozen.” A ","type":"text"},{"inlineContent":[{"type":"text","text":"schedule"}],"type":"emphasis"},{"text":" lists the systems of one","type":"text"},{"text":" ","type":"text"},{"text":"frame or step and runs them on a world, each once per run.","type":"text"}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"The examples throughout this module use these components, resources and event:"}]},{"type":"codeListing","syntax":"swift","code":["struct Position: Component { var x: Double, y: Double }","struct Velocity: Component { var dx: Double, dy: Double }","struct Health: Component { var current: Int }","struct Frozen: Component {}","","struct Score: Resource { var points: Int }","struct TimeStep: Resource { var seconds: Double }","struct Paused: Resource {}","","struct Damage: Event { var target: Entity, amount: Int }"]},{"level":3,"anchor":"Declare-a-System","type":"heading","text":"Declare a System"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The simplest way to write a system is to mark a type with the "},{"type":"codeVoice","code":"@System"},{"type":"text","text":" macro and give it a"},{"type":"text","text":" "},{"type":"codeVoice","code":"run"},{"type":"text","text":" method. The method’s parameters say what the system works on, and their types say how:"},{"type":"text","text":" "},{"type":"text","text":"an "},{"type":"reference","identifier":"doc:\/\/Systems\/documentation\/Systems\/Update","isActive":true},{"type":"text","text":" writes components, a "},{"type":"reference","identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/Query","isActive":true},{"type":"text","text":" reads them, and a "},{"type":"reference","identifier":"doc:\/\/Systems\/documentation\/Systems\/ResourceReader","isActive":true},{"type":"text","text":" "},{"type":"text","text":"reads a resource. The following two systems pull everything that isn’t frozen downward, then move"},{"type":"text","text":" "},{"type":"text","text":"it by its velocity:"}]},{"type":"codeListing","syntax":"swift","code":["@System","struct Gravity {","    func run(_ falling: Update<Velocity>.Where<Without<Frozen>>) {","        falling { velocity, _ in velocity.dy -= 10 }","    }","}","","@System","struct Movement {","    func run(_ movers: Update<Position>.Over<Velocity>.Where<Without<Frozen>>) {","        movers { position, row in","            position.x += row.components.dx","            position.y += row.components.dy","        }","    }","}"]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Because the parameters’ types state what each system reads and writes, the macro writes the"},{"type":"text","text":" "},{"type":"text","text":"system’s "},{"isActive":true,"type":"reference","identifier":"doc:\/\/Systems\/documentation\/Systems\/System\/access"},{"type":"text","text":" for you: "},{"type":"codeVoice","code":"Gravity"},{"type":"text","text":" writes "},{"type":"codeVoice","code":"Velocity"},{"type":"text","text":"; "},{"type":"codeVoice","code":"Movement"},{"type":"text","text":" writes "},{"type":"codeVoice","code":"Position"},{"type":"text","text":" and"},{"type":"text","text":" "},{"type":"text","text":"reads "},{"type":"codeVoice","code":"Velocity"},{"type":"text","text":". A schedule uses the access to decide which systems can run at the same time."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"You can also conform a type to "},{"type":"reference","isActive":true,"identifier":"doc:\/\/Systems\/documentation\/Systems\/System"},{"type":"text","text":" by hand and write its "},{"type":"reference","isActive":true,"identifier":"doc:\/\/Systems\/documentation\/Systems\/System\/run(in:)"},{"type":"text","text":" method, which"},{"type":"text","text":" "},{"type":"text","text":"receives the whole world. See "},{"type":"reference","isActive":true,"identifier":"doc:\/\/Systems\/documentation\/Systems\/System"},{"type":"text","text":" for when to do that."}]},{"level":3,"anchor":"Run-Systems-in-a-Schedule","type":"heading","text":"Run Systems in a Schedule"},{"type":"paragraph","inlineContent":[{"text":"A ","type":"text"},{"isActive":true,"identifier":"doc:\/\/Systems\/documentation\/Systems\/Schedule","type":"reference"},{"text":" is built from a list of systems, written in a result builder. Running it runs each","type":"text"},{"text":" ","type":"text"},{"text":"system once. The following example drops a ball for one frame:","type":"text"}]},{"type":"codeListing","syntax":"swift","code":["var world = World()","let ball = world.spawn(Position(x: 0, y: 100), Velocity(dx: 1, dy: 0))","","let frame = Schedule {","    Gravity()","    Movement().after(Gravity.self)","}","frame.run(on: &world)","","print(world[Position.self, of: ball])","\/\/ Prints \"Position(x: 1.0, y: 90.0)\""]},{"type":"paragraph","inlineContent":[{"text":"Systems run in the order you write them, unless an ordering constraint says otherwise.","type":"text"},{"text":" ","type":"text"},{"code":"after(_:)","type":"codeVoice"},{"text":" and ","type":"text"},{"code":"before(_:)","type":"codeVoice"},{"text":" require one system to run after or before another; ","type":"text"},{"isActive":true,"identifier":"doc:\/\/Systems\/documentation\/Systems\/SystemSet","type":"reference"},{"text":" ","type":"text"},{"text":"names a group of systems so constraints can refer to all of them at once; and ","type":"text"},{"code":"runIf(_:)","type":"codeVoice"},{"text":" skips","type":"text"},{"text":" ","type":"text"},{"text":"a system when a condition doesn’t hold.","type":"text"}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Systems whose accesses don’t conflict, because neither writes what the other reads or writes,"},{"type":"text","text":" "},{"type":"text","text":"run at the same time, and the world ends as though they had run one after another (commands"},{"type":"text","text":" "},{"type":"text","text":"apply when each wave finishes). Systems that"},{"type":"text","text":" "},{"type":"text","text":"conflict run in order. When two conflicting systems aren’t ordered by any constraint, their order"},{"type":"text","text":" "},{"type":"text","text":"rests only on how they happen to be written; "},{"identifier":"doc:\/\/Systems\/documentation\/Systems\/Schedule\/ambiguities()","type":"reference","isActive":true},{"type":"text","text":" finds those pairs so a"},{"type":"text","text":" "},{"type":"text","text":"test can keep a schedule free of them. To learn more, see "},{"identifier":"doc:\/\/Systems\/documentation\/Systems\/SchedulingSystems","type":"reference","isActive":true},{"type":"text","text":"."}]}]}],"abstract":[{"text":"Declare the rules of a simulation as systems, and run them on a world in a schedule.","type":"text"}],"schemaVersion":{"patch":0,"major":0,"minor":3},"hierarchy":{"paths":[[]]},"sections":[],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/Systems\/documentation\/Systems"},"metadata":{"role":"collection","roleHeading":"Framework","externalID":"Systems","symbolKind":"module","title":"Systems","modules":[{"name":"Systems"}]},"kind":"symbol","references":{"doc://Systems/documentation/Systems/System":{"kind":"symbol","navigatorTitle":[{"kind":"identifier","text":"System"}],"url":"\/documentation\/systems\/system","title":"System","role":"symbol","identifier":"doc:\/\/Systems\/documentation\/Systems\/System","abstract":[{"type":"text","text":"A rule that reads and changes a world, run once each time its schedule runs."}],"type":"topic","fragments":[{"kind":"keyword","text":"protocol"},{"kind":"text","text":" "},{"kind":"identifier","text":"System"}]},"doc://Systems/documentation/Systems/DeclaringSystems":{"url":"\/documentation\/systems\/declaringsystems","kind":"article","title":"Declaring Systems","type":"topic","identifier":"doc:\/\/Systems\/documentation\/Systems\/DeclaringSystems","abstract":[{"text":"Write the rules of a simulation as systems, and let their parameters state what they read and","type":"text"},{"text":" ","type":"text"},{"text":"write.","type":"text"}],"role":"collectionGroup"},"doc://Systems/documentation/Systems/CyclicOrdering":{"role":"symbol","navigatorTitle":[{"kind":"identifier","text":"CyclicOrdering"}],"fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"CyclicOrdering"}],"url":"\/documentation\/systems\/cyclicordering","abstract":[{"type":"text","text":"An error indicating that the ordering constraints of a schedule’s systems form a cycle, so no"},{"type":"text","text":" "},{"type":"text","text":"order satisfies them all."}],"identifier":"doc:\/\/Systems\/documentation\/Systems\/CyclicOrdering","kind":"symbol","type":"topic","title":"CyclicOrdering"},"doc://Systems/documentation/Systems/ResourceReader":{"role":"symbol","navigatorTitle":[{"kind":"identifier","text":"ResourceReader"}],"fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"ResourceReader"}],"url":"\/documentation\/systems\/resourcereader","identifier":"doc:\/\/Systems\/documentation\/Systems\/ResourceReader","abstract":[{"text":"A system parameter that reads a resource.","type":"text"}],"kind":"symbol","type":"topic","title":"ResourceReader"},"doc://Systems/documentation/Systems/SystemSet":{"role":"symbol","navigatorTitle":[{"text":"SystemSet","kind":"identifier"}],"fragments":[{"text":"protocol","kind":"keyword"},{"text":" ","kind":"text"},{"text":"SystemSet","kind":"identifier"}],"url":"\/documentation\/systems\/systemset","identifier":"doc:\/\/Systems\/documentation\/Systems\/SystemSet","abstract":[{"text":"A type that names a group of systems, so ordering constraints can refer to all of them at","type":"text"},{"text":" ","type":"text"},{"text":"once.","type":"text"}],"kind":"symbol","type":"topic","title":"SystemSet"},"doc://Systems/documentation/Systems/ForwardEvents":{"navigatorTitle":[{"text":"ForwardEvents","kind":"identifier"}],"url":"\/documentation\/systems\/forwardevents","identifier":"doc:\/\/Systems\/documentation\/Systems\/ForwardEvents","abstract":[{"text":"A system that yields each event of one type to an asynchronous stream, so code outside the","type":"text"},{"text":" ","type":"text"},{"text":"schedule can await the events.","type":"text"}],"kind":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"ForwardEvents","kind":"identifier"}],"type":"topic","title":"ForwardEvents","role":"symbol"},"doc://Systems/documentation/Systems/SystemTiming":{"role":"symbol","navigatorTitle":[{"text":"SystemTiming","kind":"identifier"}],"fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"SystemTiming","kind":"identifier"}],"url":"\/documentation\/systems\/systemtiming","abstract":[{"type":"text","text":"The times one system of a schedule has taken to run."}],"identifier":"doc:\/\/Systems\/documentation\/Systems\/SystemTiming","kind":"symbol","type":"topic","title":"SystemTiming"},"doc://Systems/documentation/Systems/Ambiguity":{"title":"Ambiguity","kind":"symbol","navigatorTitle":[{"kind":"identifier","text":"Ambiguity"}],"type":"topic","role":"symbol","url":"\/documentation\/systems\/ambiguity","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"Ambiguity"}],"abstract":[{"text":"Two systems of a schedule whose accesses conflict but that no ordering constraint orders, so","type":"text"},{"text":" ","type":"text"},{"text":"the order they run in rests only on the order they were written in.","type":"text"}],"identifier":"doc:\/\/Systems\/documentation\/Systems\/Ambiguity"},"doc://Systems/documentation/Systems/Schedule/ambiguities()":{"kind":"symbol","identifier":"doc:\/\/Systems\/documentation\/Systems\/Schedule\/ambiguities()","url":"\/documentation\/systems\/schedule\/ambiguities()","role":"symbol","title":"ambiguities()","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"ambiguities","kind":"identifier"},{"text":"() -> [","kind":"text"},{"preciseIdentifier":"s:7Systems9AmbiguityV","kind":"typeIdentifier","text":"Ambiguity"},{"kind":"text","text":"]"}],"type":"topic","abstract":[{"type":"text","text":"Returns every pair of systems whose accesses conflict but that no ordering constraint"},{"type":"text","text":" "},{"type":"text","text":"orders."}]},"doc://Systems/documentation/Systems/SystemProfile":{"role":"symbol","navigatorTitle":[{"kind":"identifier","text":"SystemProfile"}],"fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"SystemProfile"}],"url":"\/documentation\/systems\/systemprofile","identifier":"doc:\/\/Systems\/documentation\/Systems\/SystemProfile","abstract":[{"text":"A resource that records how long each system takes to run.","type":"text"}],"kind":"symbol","type":"topic","title":"SystemProfile"},"doc://Systems/documentation/Systems/Schedule":{"kind":"symbol","navigatorTitle":[{"text":"Schedule","kind":"identifier"}],"url":"\/documentation\/systems\/schedule","title":"Schedule","role":"symbol","identifier":"doc:\/\/Systems\/documentation\/Systems\/Schedule","abstract":[{"text":"A list of systems that run on a world, in order, and at the same time where they can.","type":"text"}],"type":"topic","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Schedule","kind":"identifier"}]},"doc://Systems/documentation/Systems/EventWriter":{"title":"EventWriter","kind":"symbol","navigatorTitle":[{"text":"EventWriter","kind":"identifier"}],"type":"topic","role":"symbol","url":"\/documentation\/systems\/eventwriter","fragments":[{"text":"class","kind":"keyword"},{"text":" ","kind":"text"},{"text":"EventWriter","kind":"identifier"}],"abstract":[{"text":"A system parameter that sends events of one type.","type":"text"}],"identifier":"doc:\/\/Systems\/documentation\/Systems\/EventWriter"},"doc://Systems/documentation/Systems/System/access":{"title":"access","identifier":"doc:\/\/Systems\/documentation\/Systems\/System\/access","defaultImplementations":1,"url":"\/documentation\/systems\/system\/access","abstract":[{"type":"text","text":"The component, resource and event types the system reads and writes, or "},{"code":"nil","type":"codeVoice"},{"type":"text","text":" if it may"},{"type":"text","text":" "},{"type":"text","text":"change anything."}],"fragments":[{"text":"var","kind":"keyword"},{"text":" ","kind":"text"},{"kind":"identifier","text":"access"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"Access","preciseIdentifier":"s:11WorldModule6AccessV"},{"kind":"text","text":"?"}],"kind":"symbol","type":"topic","required":true,"role":"symbol"},"doc://Systems/documentation/Systems/DrivingAWorldFromAnApp":{"title":"Driving a World from an App","identifier":"doc:\/\/Systems\/documentation\/Systems\/DrivingAWorldFromAnApp","url":"\/documentation\/systems\/drivingaworldfromanapp","abstract":[{"type":"text","text":"Hold a world in your app or game engine, feed it each frame’s input, and let the objects outside"},{"type":"text","text":" "},{"type":"text","text":"it read results and take part in a step."}],"kind":"article","type":"topic","role":"article"},"doc://Systems/documentation/Systems/System/run(in:)":{"role":"symbol","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"run","kind":"identifier"},{"text":"(","kind":"text"},{"text":"in","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"inout","kind":"keyword"},{"text":" ","kind":"text"},{"text":"World","preciseIdentifier":"s:11WorldModule0A0V","kind":"typeIdentifier"},{"text":")","kind":"text"}],"url":"\/documentation\/systems\/system\/run(in:)","identifier":"doc:\/\/Systems\/documentation\/Systems\/System\/run(in:)","abstract":[{"type":"text","text":"Runs the system’s rule once on a world."}],"kind":"symbol","required":true,"type":"topic","title":"run(in:)"},"doc://Systems/documentation/Systems/ScheduledSystem":{"kind":"symbol","navigatorTitle":[{"kind":"identifier","text":"ScheduledSystem"}],"url":"\/documentation\/systems\/scheduledsystem","title":"ScheduledSystem","role":"symbol","identifier":"doc:\/\/Systems\/documentation\/Systems\/ScheduledSystem","abstract":[{"text":"A system together with the ordering constraints, sets and conditions a schedule runs it with.","type":"text"}],"type":"topic","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"ScheduledSystem"}]},"doc://Systems/documentation/Systems/RemovedComponents":{"navigatorTitle":[{"kind":"identifier","text":"RemovedComponents"}],"kind":"symbol","role":"symbol","title":"RemovedComponents","identifier":"doc:\/\/Systems\/documentation\/Systems\/RemovedComponents","url":"\/documentation\/systems\/removedcomponents","abstract":[{"text":"A system parameter that lists the entities that lost a component since the system last read","type":"text"},{"text":" ","type":"text"},{"text":"them.","type":"text"}],"fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"RemovedComponents"}],"type":"topic"},"doc://Systems/documentation/Systems":{"kind":"symbol","role":"collection","title":"Systems","identifier":"doc:\/\/Systems\/documentation\/Systems","url":"\/documentation\/systems","abstract":[{"text":"Declare the rules of a simulation as systems, and run them on a world in a schedule.","type":"text"}],"type":"topic"},"doc://Systems/documentation/Systems/ScheduleBuilder":{"identifier":"doc:\/\/Systems\/documentation\/Systems\/ScheduleBuilder","role":"symbol","abstract":[{"type":"text","text":"A result builder that collects the systems written in a "},{"type":"reference","isActive":true,"identifier":"doc:\/\/Systems\/documentation\/Systems\/Schedule"},{"type":"text","text":"’s closure."}],"title":"ScheduleBuilder","fragments":[{"text":"enum","kind":"keyword"},{"text":" ","kind":"text"},{"text":"ScheduleBuilder","kind":"identifier"}],"navigatorTitle":[{"text":"ScheduleBuilder","kind":"identifier"}],"url":"\/documentation\/systems\/schedulebuilder","kind":"symbol","type":"topic"},"doc://Systems/documentation/Systems/System()":{"kind":"symbol","identifier":"doc:\/\/Systems\/documentation\/Systems\/System()","url":"\/documentation\/systems\/system()","role":"symbol","title":"System()","fragments":[{"kind":"keyword","text":"macro"},{"kind":"text","text":" "},{"kind":"identifier","text":"System"},{"kind":"text","text":"()"}],"type":"topic","abstract":[{"type":"text","text":"Makes a type a system whose access comes from the parameters of its "},{"type":"codeVoice","code":"run"},{"type":"text","text":" method."}]},"doc://Systems/documentation/Systems/ForwardChanges":{"role":"symbol","navigatorTitle":[{"text":"ForwardChanges","kind":"identifier"}],"fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"ForwardChanges","kind":"identifier"}],"url":"\/documentation\/systems\/forwardchanges","identifier":"doc:\/\/Systems\/documentation\/Systems\/ForwardChanges","abstract":[{"type":"text","text":"A system that yields each component of one type added or changed since it last ran to an"},{"type":"text","text":" "},{"type":"text","text":"asynchronous stream, with its entity."}],"kind":"symbol","type":"topic","title":"ForwardChanges"},"doc://Systems/documentation/Systems/EventReader":{"kind":"symbol","navigatorTitle":[{"text":"EventReader","kind":"identifier"}],"url":"\/documentation\/systems\/eventreader","title":"EventReader","role":"symbol","identifier":"doc:\/\/Systems\/documentation\/Systems\/EventReader","abstract":[{"text":"A system parameter that reads the events of one type sent since the system last read them.","type":"text"}],"type":"topic","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"EventReader","kind":"identifier"}]},"doc://WorldModule/documentation/WorldModule/Query":{"abstract":[{"text":"A description of the entities to visit and the components to read from each.","type":"text"}],"navigatorTitle":[{"text":"Query","kind":"identifier"}],"role":"symbol","identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/Query","kind":"symbol","url":"\/documentation\/worldmodule\/query","type":"topic","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Query","kind":"identifier"}],"title":"Query"},"doc://Systems/documentation/Systems/MainActorSystem":{"kind":"symbol","navigatorTitle":[{"kind":"identifier","text":"MainActorSystem"}],"url":"\/documentation\/systems\/mainactorsystem","title":"MainActorSystem","role":"symbol","identifier":"doc:\/\/Systems\/documentation\/Systems\/MainActorSystem","abstract":[{"type":"text","text":"A system that runs on the main actor, for work that touches main-actor state such as a user"},{"type":"text","text":" "},{"type":"text","text":"interface."}],"type":"topic","fragments":[{"kind":"keyword","text":"protocol"},{"kind":"text","text":" "},{"kind":"identifier","text":"MainActorSystem"}]},"doc://Systems/documentation/Systems/Update":{"kind":"symbol","navigatorTitle":[{"kind":"identifier","text":"Update"}],"url":"\/documentation\/systems\/update","title":"Update","role":"symbol","identifier":"doc:\/\/Systems\/documentation\/Systems\/Update","abstract":[{"text":"A system parameter that changes a component of every entity that holds it.","type":"text"}],"type":"topic","fragments":[{"kind":"keyword","text":"class"},{"kind":"text","text":" "},{"kind":"identifier","text":"Update"}]},"doc://Systems/documentation/Systems/SchedulingSystems":{"role":"article","url":"\/documentation\/systems\/schedulingsystems","abstract":[{"type":"text","text":"Order the systems of a schedule, run them only when a condition holds, and find out how a"},{"type":"text","text":" "},{"type":"text","text":"schedule runs them."}],"identifier":"doc:\/\/Systems\/documentation\/Systems\/SchedulingSystems","kind":"article","type":"topic","title":"Scheduling Systems"},"doc://Systems/documentation/Systems/SystemParameter":{"title":"SystemParameter","identifier":"doc:\/\/Systems\/documentation\/Systems\/SystemParameter","url":"\/documentation\/systems\/systemparameter","abstract":[{"text":"A type a system’s ","type":"text"},{"code":"run","type":"codeVoice"},{"text":" method can take in place of the whole world, whose type states what","type":"text"},{"text":" ","type":"text"},{"text":"the system reads and writes.","type":"text"}],"fragments":[{"text":"protocol","kind":"keyword"},{"text":" ","kind":"text"},{"kind":"identifier","text":"SystemParameter"}],"navigatorTitle":[{"kind":"identifier","text":"SystemParameter"}],"kind":"symbol","type":"topic","role":"symbol"},"doc://Systems/documentation/Systems/ResourceWriter":{"title":"ResourceWriter","kind":"symbol","navigatorTitle":[{"text":"ResourceWriter","kind":"identifier"}],"type":"topic","role":"symbol","url":"\/documentation\/systems\/resourcewriter","fragments":[{"text":"class","kind":"keyword"},{"text":" ","kind":"text"},{"text":"ResourceWriter","kind":"identifier"}],"abstract":[{"text":"A system parameter that reads and writes a resource.","type":"text"}],"identifier":"doc:\/\/Systems\/documentation\/Systems\/ResourceWriter"},"doc://Systems/documentation/Systems/UpdateEvents":{"title":"UpdateEvents","identifier":"doc:\/\/Systems\/documentation\/Systems\/UpdateEvents","url":"\/documentation\/systems\/updateevents","abstract":[{"text":"A system that ends the current event update, dropping events old enough that every reader","type":"text"},{"text":" ","type":"text"},{"text":"has had its chance to read them.","type":"text"}],"fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"UpdateEvents","kind":"identifier"}],"navigatorTitle":[{"text":"UpdateEvents","kind":"identifier"}],"kind":"symbol","type":"topic","role":"symbol"}}}