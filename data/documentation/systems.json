{"variants":[{"paths":["\/documentation\/systems"],"traits":[{"interfaceLanguage":"swift"}]}],"identifier":{"url":"doc:\/\/Systems\/documentation\/Systems","interfaceLanguage":"swift"},"topicSections":[{"identifiers":["doc:\/\/Systems\/documentation\/Systems\/DeclaringSystems","doc:\/\/Systems\/documentation\/Systems\/DrivingAWorldFromAnApp","doc:\/\/Systems\/documentation\/Systems\/System()","doc:\/\/Systems\/documentation\/Systems\/System"],"title":"Essentials","anchor":"Essentials"},{"identifiers":["doc:\/\/Systems\/documentation\/Systems\/SystemParameter","doc:\/\/Systems\/documentation\/Systems\/Update","doc:\/\/Systems\/documentation\/Systems\/ResourceReader","doc:\/\/Systems\/documentation\/Systems\/ResourceWriter","doc:\/\/Systems\/documentation\/Systems\/EventReader","doc:\/\/Systems\/documentation\/Systems\/EventWriter","doc:\/\/Systems\/documentation\/Systems\/RemovedComponents"],"title":"System Parameters","anchor":"System-Parameters"},{"identifiers":["doc:\/\/Systems\/documentation\/Systems\/Schedule","doc:\/\/Systems\/documentation\/Systems\/ScheduleBuilder","doc:\/\/Systems\/documentation\/Systems\/ScheduledSystem","doc:\/\/Systems\/documentation\/Systems\/SystemSet","doc:\/\/Systems\/documentation\/Systems\/CyclicOrdering","doc:\/\/Systems\/documentation\/Systems\/Ambiguity"],"title":"Building and Running Schedules","anchor":"Building-and-Running-Schedules"},{"identifiers":["doc:\/\/Systems\/documentation\/Systems\/MainActorSystem"],"title":"Main-Actor Systems","anchor":"Main-Actor-Systems"},{"identifiers":["doc:\/\/Systems\/documentation\/Systems\/UpdateEvents","doc:\/\/Systems\/documentation\/Systems\/ForwardEvents","doc:\/\/Systems\/documentation\/Systems\/ForwardChanges"],"title":"Built-In Systems","anchor":"Built-In-Systems"},{"identifiers":["doc:\/\/Systems\/documentation\/Systems\/SystemProfile","doc:\/\/Systems\/documentation\/Systems\/SystemTiming"],"title":"Profiling","anchor":"Profiling"}],"sections":[],"schemaVersion":{"patch":0,"minor":3,"major":0},"kind":"symbol","abstract":[{"type":"text","text":"Declare the rules of a simulation as systems, and run them on a world in a schedule."}],"primaryContentSections":[{"content":[{"text":"Overview","level":2,"type":"heading","anchor":"Overview"},{"inlineContent":[{"text":"A world holds data: entities and their components, and resources. A ","type":"text"},{"type":"emphasis","inlineContent":[{"text":"system","type":"text"}]},{"text":" holds a rule: a","type":"text"},{"text":" ","type":"text"},{"text":"step that reads part of the world and changes part of it, such as “every entity with a velocity","type":"text"},{"text":" ","type":"text"},{"text":"moves” or “gravity pulls on everything that isn’t frozen.” A ","type":"text"},{"type":"emphasis","inlineContent":[{"text":"schedule","type":"text"}]},{"text":" lists the systems of one","type":"text"},{"text":" ","type":"text"},{"text":"frame or step and runs them on a world, each once per run.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"The examples throughout this module use these components, resources and event:","type":"text"}],"type":"paragraph"},{"syntax":"swift","code":["struct Position: Component { var x: Double, y: Double }","struct Velocity: Component { var dx: Double, dy: Double }","struct Health: Component { var current: Int }","struct Frozen: Component {}","","struct Score: Resource { var points: Int }","struct TimeStep: Resource { var seconds: Double }","struct Paused: Resource {}","","struct Damage: Event { var target: Entity, amount: Int }"],"type":"codeListing"},{"text":"Declare a System","level":3,"type":"heading","anchor":"Declare-a-System"},{"inlineContent":[{"type":"text","text":"The simplest way to write a system is to mark a type with the "},{"type":"codeVoice","code":"@System"},{"type":"text","text":" macro and give it a"},{"type":"text","text":" "},{"type":"codeVoice","code":"run"},{"type":"text","text":" method. The method’s parameters say what the system works on, and their types say how:"},{"type":"text","text":" "},{"type":"text","text":"an "},{"type":"reference","identifier":"doc:\/\/Systems\/documentation\/Systems\/Update","isActive":true},{"type":"text","text":" writes components, a "},{"type":"reference","identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/Query","isActive":true},{"type":"text","text":" reads them, and a "},{"type":"reference","identifier":"doc:\/\/Systems\/documentation\/Systems\/ResourceReader","isActive":true},{"type":"text","text":" "},{"type":"text","text":"reads a resource. The following two systems pull everything that isn’t frozen downward, then move"},{"type":"text","text":" "},{"type":"text","text":"it by its velocity:"}],"type":"paragraph"},{"syntax":"swift","code":["@System","struct Gravity {","    func run(_ falling: Update<Velocity>.Where<Without<Frozen>>) {","        falling { velocity, _ in velocity.dy -= 10 }","    }","}","","@System","struct Movement {","    func run(_ movers: Update<Position>.Over<Velocity>.Where<Without<Frozen>>) {","        movers { position, row in","            position.x += row.components.dx","            position.y += row.components.dy","        }","    }","}"],"type":"codeListing"},{"inlineContent":[{"type":"text","text":"Because the parameters’ types state what each system reads and writes, the macro writes the"},{"type":"text","text":" "},{"type":"text","text":"system’s "},{"type":"reference","identifier":"doc:\/\/Systems\/documentation\/Systems\/System\/access","isActive":true},{"type":"text","text":" for you: "},{"type":"codeVoice","code":"Gravity"},{"type":"text","text":" writes "},{"type":"codeVoice","code":"Velocity"},{"type":"text","text":"; "},{"type":"codeVoice","code":"Movement"},{"type":"text","text":" writes "},{"type":"codeVoice","code":"Position"},{"type":"text","text":" and"},{"type":"text","text":" "},{"type":"text","text":"reads "},{"type":"codeVoice","code":"Velocity"},{"type":"text","text":". A schedule uses the access to decide which systems can run at the same time."}],"type":"paragraph"},{"inlineContent":[{"text":"You can also conform a type to ","type":"text"},{"identifier":"doc:\/\/Systems\/documentation\/Systems\/System","isActive":true,"type":"reference"},{"text":" by hand and write its ","type":"text"},{"identifier":"doc:\/\/Systems\/documentation\/Systems\/System\/run(in:)","isActive":true,"type":"reference"},{"text":" method, which","type":"text"},{"text":" ","type":"text"},{"text":"receives the whole world. See ","type":"text"},{"identifier":"doc:\/\/Systems\/documentation\/Systems\/System","isActive":true,"type":"reference"},{"text":" for when to do that.","type":"text"}],"type":"paragraph"},{"text":"Run Systems in a Schedule","level":3,"type":"heading","anchor":"Run-Systems-in-a-Schedule"},{"inlineContent":[{"text":"A ","type":"text"},{"isActive":true,"identifier":"doc:\/\/Systems\/documentation\/Systems\/Schedule","type":"reference"},{"text":" is built from a list of systems, written in a result builder. Running it runs each","type":"text"},{"text":" ","type":"text"},{"text":"system once. The following example drops a ball for one frame:","type":"text"}],"type":"paragraph"},{"syntax":"swift","code":["var world = World()","let ball = world.spawn(Position(x: 0, y: 100), Velocity(dx: 1, dy: 0))","","let frame = Schedule {","    Gravity()","    Movement().after(Gravity.self)","}","frame.run(on: &world)","","print(world[Position.self, of: ball])","\/\/ Prints \"Position(x: 1.0, y: 90.0)\""],"type":"codeListing"},{"inlineContent":[{"type":"text","text":"Systems run in the order you write them, unless an ordering constraint says otherwise."},{"type":"text","text":" "},{"type":"codeVoice","code":"after(_:)"},{"type":"text","text":" and "},{"type":"codeVoice","code":"before(_:)"},{"type":"text","text":" require one system to run after or before another; "},{"identifier":"doc:\/\/Systems\/documentation\/Systems\/SystemSet","type":"reference","isActive":true},{"type":"text","text":" "},{"type":"text","text":"names a group of systems so constraints can refer to all of them at once; and "},{"type":"codeVoice","code":"runIf(_:)"},{"type":"text","text":" skips"},{"type":"text","text":" "},{"type":"text","text":"a system when a condition doesn’t hold."}],"type":"paragraph"},{"inlineContent":[{"text":"Systems whose accesses don’t conflict, because neither writes what the other reads or writes,","type":"text"},{"text":" ","type":"text"},{"text":"run at the same time, and the world ends as though they had run one after another (commands","type":"text"},{"text":" ","type":"text"},{"text":"apply when each wave finishes). Systems that","type":"text"},{"text":" ","type":"text"},{"text":"conflict run in order. When two conflicting systems aren’t ordered by any constraint, their order","type":"text"},{"text":" ","type":"text"},{"text":"rests only on how they happen to be written; ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/Systems\/documentation\/Systems\/Schedule\/ambiguities()"},{"text":" finds those pairs so a","type":"text"},{"text":" ","type":"text"},{"text":"test can keep a schedule free of them.","type":"text"}],"type":"paragraph"}],"kind":"content"}],"metadata":{"role":"collection","title":"Systems","externalID":"Systems","symbolKind":"module","modules":[{"name":"Systems"}],"roleHeading":"Framework"},"hierarchy":{"paths":[[]]},"references":{"doc://WorldModule/documentation/WorldModule/Query":{"url":"\/documentation\/worldmodule\/query","identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/Query","navigatorTitle":[{"kind":"identifier","text":"Query"}],"type":"topic","abstract":[{"text":"A description of the entities to visit and the components to read from each.","type":"text"}],"kind":"symbol","title":"Query","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"Query"}],"role":"symbol"},"doc://Systems/documentation/Systems/ForwardChanges":{"url":"\/documentation\/systems\/forwardchanges","identifier":"doc:\/\/Systems\/documentation\/Systems\/ForwardChanges","navigatorTitle":[{"kind":"identifier","text":"ForwardChanges"}],"type":"topic","abstract":[{"text":"A system that yields each component of one type added or changed since it last ran to an","type":"text"},{"text":" ","type":"text"},{"text":"asynchronous stream, with its entity.","type":"text"}],"kind":"symbol","title":"ForwardChanges","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"ForwardChanges"}],"role":"symbol"},"doc://Systems/documentation/Systems/SystemProfile":{"url":"\/documentation\/systems\/systemprofile","identifier":"doc:\/\/Systems\/documentation\/Systems\/SystemProfile","navigatorTitle":[{"kind":"identifier","text":"SystemProfile"}],"type":"topic","abstract":[{"text":"A resource that records how long each system takes to run.","type":"text"}],"kind":"symbol","title":"SystemProfile","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"SystemProfile"}],"role":"symbol"},"doc://Systems/documentation/Systems/EventReader":{"navigatorTitle":[{"text":"EventReader","kind":"identifier"}],"title":"EventReader","abstract":[{"type":"text","text":"A system parameter that reads the events of one type sent since the system last read them."}],"kind":"symbol","identifier":"doc:\/\/Systems\/documentation\/Systems\/EventReader","role":"symbol","type":"topic","url":"\/documentation\/systems\/eventreader","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"EventReader","kind":"identifier"}]},"doc://Systems/documentation/Systems/MainActorSystem":{"role":"symbol","kind":"symbol","type":"topic","identifier":"doc:\/\/Systems\/documentation\/Systems\/MainActorSystem","abstract":[{"type":"text","text":"A system that runs on the main actor, for work that touches main-actor state such as a user"},{"type":"text","text":" "},{"type":"text","text":"interface."}],"fragments":[{"kind":"keyword","text":"protocol"},{"kind":"text","text":" "},{"kind":"identifier","text":"MainActorSystem"}],"navigatorTitle":[{"kind":"identifier","text":"MainActorSystem"}],"title":"MainActorSystem","url":"\/documentation\/systems\/mainactorsystem"},"doc://Systems/documentation/Systems/UpdateEvents":{"type":"topic","url":"\/documentation\/systems\/updateevents","abstract":[{"type":"text","text":"A system that ends the current event update, dropping events old enough that every reader"},{"type":"text","text":" "},{"type":"text","text":"has had its chance to read them."}],"fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"UpdateEvents"}],"role":"symbol","identifier":"doc:\/\/Systems\/documentation\/Systems\/UpdateEvents","navigatorTitle":[{"kind":"identifier","text":"UpdateEvents"}],"kind":"symbol","title":"UpdateEvents"},"doc://Systems/documentation/Systems/System/access":{"role":"symbol","title":"access","fragments":[{"text":"var","kind":"keyword"},{"text":" ","kind":"text"},{"text":"access","kind":"identifier"},{"text":": ","kind":"text"},{"text":"Access","kind":"typeIdentifier","preciseIdentifier":"s:11WorldModule6AccessV"},{"text":"?","kind":"text"}],"required":true,"defaultImplementations":1,"identifier":"doc:\/\/Systems\/documentation\/Systems\/System\/access","kind":"symbol","abstract":[{"type":"text","text":"The component, resource and event types the system reads and writes, or "},{"type":"codeVoice","code":"nil"},{"type":"text","text":" if it may"},{"type":"text","text":" "},{"type":"text","text":"change anything."}],"type":"topic","url":"\/documentation\/systems\/system\/access"},"doc://Systems/documentation/Systems/SystemTiming":{"url":"\/documentation\/systems\/systemtiming","identifier":"doc:\/\/Systems\/documentation\/Systems\/SystemTiming","navigatorTitle":[{"kind":"identifier","text":"SystemTiming"}],"type":"topic","abstract":[{"text":"The times one system of a schedule has taken to run.","type":"text"}],"kind":"symbol","title":"SystemTiming","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"SystemTiming"}],"role":"symbol"},"doc://Systems/documentation/Systems/ScheduledSystem":{"role":"symbol","kind":"symbol","type":"topic","identifier":"doc:\/\/Systems\/documentation\/Systems\/ScheduledSystem","abstract":[{"type":"text","text":"A system together with the ordering constraints, sets and conditions a schedule runs it with."}],"fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"ScheduledSystem","kind":"identifier"}],"navigatorTitle":[{"text":"ScheduledSystem","kind":"identifier"}],"title":"ScheduledSystem","url":"\/documentation\/systems\/scheduledsystem"},"doc://Systems/documentation/Systems/DrivingAWorldFromAnApp":{"role":"article","kind":"article","type":"topic","identifier":"doc:\/\/Systems\/documentation\/Systems\/DrivingAWorldFromAnApp","abstract":[{"text":"Hold a world in your app or game engine, feed it each frame’s input, and let the objects outside","type":"text"},{"text":" ","type":"text"},{"text":"it read results and take part in a step.","type":"text"}],"title":"Driving a World from an App","url":"\/documentation\/systems\/drivingaworldfromanapp"},"doc://Systems/documentation/Systems/Update":{"navigatorTitle":[{"text":"Update","kind":"identifier"}],"abstract":[{"text":"A system parameter that changes a component of every entity that holds it.","type":"text"}],"title":"Update","kind":"symbol","identifier":"doc:\/\/Systems\/documentation\/Systems\/Update","role":"symbol","type":"topic","url":"\/documentation\/systems\/update","fragments":[{"text":"class","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Update","kind":"identifier"}]},"doc://Systems/documentation/Systems/System":{"url":"\/documentation\/systems\/system","identifier":"doc:\/\/Systems\/documentation\/Systems\/System","navigatorTitle":[{"kind":"identifier","text":"System"}],"type":"topic","abstract":[{"type":"text","text":"A rule that reads and changes a world, run once each time its schedule runs."}],"kind":"symbol","title":"System","fragments":[{"kind":"keyword","text":"protocol"},{"kind":"text","text":" "},{"kind":"identifier","text":"System"}],"role":"symbol"},"doc://Systems/documentation/Systems/DeclaringSystems":{"abstract":[{"type":"text","text":"Write the rules of a simulation as systems, and let their parameters state what they read and"},{"type":"text","text":" "},{"type":"text","text":"write."}],"kind":"article","title":"Declaring Systems","identifier":"doc:\/\/Systems\/documentation\/Systems\/DeclaringSystems","role":"collectionGroup","type":"topic","url":"\/documentation\/systems\/declaringsystems"},"doc://Systems/documentation/Systems/Schedule":{"type":"topic","url":"\/documentation\/systems\/schedule","abstract":[{"text":"A list of systems that run on a world, in order, and at the same time where they can.","type":"text"}],"fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"Schedule"}],"role":"symbol","identifier":"doc:\/\/Systems\/documentation\/Systems\/Schedule","navigatorTitle":[{"kind":"identifier","text":"Schedule"}],"kind":"symbol","title":"Schedule"},"doc://Systems/documentation/Systems/ForwardEvents":{"role":"symbol","kind":"symbol","type":"topic","identifier":"doc:\/\/Systems\/documentation\/Systems\/ForwardEvents","abstract":[{"type":"text","text":"A system that yields each event of one type to an asynchronous stream, so code outside the"},{"type":"text","text":" "},{"type":"text","text":"schedule can await the events."}],"fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"ForwardEvents","kind":"identifier"}],"navigatorTitle":[{"text":"ForwardEvents","kind":"identifier"}],"title":"ForwardEvents","url":"\/documentation\/systems\/forwardevents"},"doc://Systems/documentation/Systems/Ambiguity":{"type":"topic","url":"\/documentation\/systems\/ambiguity","abstract":[{"type":"text","text":"Two systems of a schedule whose accesses conflict but that no ordering constraint orders, so"},{"type":"text","text":" "},{"type":"text","text":"the order they run in rests only on the order they were written in."}],"fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"Ambiguity"}],"role":"symbol","identifier":"doc:\/\/Systems\/documentation\/Systems\/Ambiguity","navigatorTitle":[{"kind":"identifier","text":"Ambiguity"}],"kind":"symbol","title":"Ambiguity"},"doc://Systems/documentation/Systems/CyclicOrdering":{"type":"topic","url":"\/documentation\/systems\/cyclicordering","abstract":[{"text":"An error indicating that the ordering constraints of a schedule’s systems form a cycle, so no","type":"text"},{"text":" ","type":"text"},{"text":"order satisfies them all.","type":"text"}],"fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"CyclicOrdering"}],"role":"symbol","identifier":"doc:\/\/Systems\/documentation\/Systems\/CyclicOrdering","navigatorTitle":[{"kind":"identifier","text":"CyclicOrdering"}],"kind":"symbol","title":"CyclicOrdering"},"doc://Systems/documentation/Systems/Schedule/ambiguities()":{"abstract":[{"type":"text","text":"Returns every pair of systems whose accesses conflict but that no ordering constraint"},{"type":"text","text":" "},{"type":"text","text":"orders."}],"kind":"symbol","title":"ambiguities()","identifier":"doc:\/\/Systems\/documentation\/Systems\/Schedule\/ambiguities()","role":"symbol","type":"topic","url":"\/documentation\/systems\/schedule\/ambiguities()","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"ambiguities"},{"kind":"text","text":"() -> ["},{"text":"Ambiguity","kind":"typeIdentifier","preciseIdentifier":"s:7Systems9AmbiguityV"},{"text":"]","kind":"text"}]},"doc://Systems/documentation/Systems/ResourceReader":{"title":"ResourceReader","role":"symbol","identifier":"doc:\/\/Systems\/documentation\/Systems\/ResourceReader","type":"topic","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"ResourceReader","kind":"identifier"}],"url":"\/documentation\/systems\/resourcereader","kind":"symbol","navigatorTitle":[{"text":"ResourceReader","kind":"identifier"}],"abstract":[{"type":"text","text":"A system parameter that reads a resource."}]},"doc://Systems/documentation/Systems/ResourceWriter":{"url":"\/documentation\/systems\/resourcewriter","identifier":"doc:\/\/Systems\/documentation\/Systems\/ResourceWriter","navigatorTitle":[{"text":"ResourceWriter","kind":"identifier"}],"type":"topic","abstract":[{"type":"text","text":"A system parameter that reads and writes a resource."}],"kind":"symbol","title":"ResourceWriter","fragments":[{"text":"class","kind":"keyword"},{"text":" ","kind":"text"},{"text":"ResourceWriter","kind":"identifier"}],"role":"symbol"},"doc://Systems/documentation/Systems/SystemParameter":{"title":"SystemParameter","role":"symbol","identifier":"doc:\/\/Systems\/documentation\/Systems\/SystemParameter","type":"topic","fragments":[{"text":"protocol","kind":"keyword"},{"text":" ","kind":"text"},{"text":"SystemParameter","kind":"identifier"}],"url":"\/documentation\/systems\/systemparameter","kind":"symbol","navigatorTitle":[{"text":"SystemParameter","kind":"identifier"}],"abstract":[{"text":"A type a system’s ","type":"text"},{"type":"codeVoice","code":"run"},{"text":" method can take in place of the whole world, whose type states what","type":"text"},{"text":" ","type":"text"},{"text":"the system reads and writes.","type":"text"}]},"doc://Systems/documentation/Systems/System()":{"role":"symbol","kind":"symbol","type":"topic","identifier":"doc:\/\/Systems\/documentation\/Systems\/System()","abstract":[{"type":"text","text":"Makes a type a system whose access comes from the parameters of its "},{"code":"run","type":"codeVoice"},{"type":"text","text":" method."}],"fragments":[{"text":"macro","kind":"keyword"},{"text":" ","kind":"text"},{"text":"System","kind":"identifier"},{"text":"()","kind":"text"}],"title":"System()","url":"\/documentation\/systems\/system()"},"doc://Systems/documentation/Systems":{"role":"collection","kind":"symbol","type":"topic","identifier":"doc:\/\/Systems\/documentation\/Systems","abstract":[{"text":"Declare the rules of a simulation as systems, and run them on a world in a schedule.","type":"text"}],"title":"Systems","url":"\/documentation\/systems"},"doc://Systems/documentation/Systems/SystemSet":{"navigatorTitle":[{"text":"SystemSet","kind":"identifier"}],"abstract":[{"text":"A type that names a group of systems, so ordering constraints can refer to all of them at","type":"text"},{"text":" ","type":"text"},{"text":"once.","type":"text"}],"kind":"symbol","title":"SystemSet","identifier":"doc:\/\/Systems\/documentation\/Systems\/SystemSet","role":"symbol","type":"topic","url":"\/documentation\/systems\/systemset","fragments":[{"text":"protocol","kind":"keyword"},{"text":" ","kind":"text"},{"text":"SystemSet","kind":"identifier"}]},"doc://Systems/documentation/Systems/ScheduleBuilder":{"type":"topic","url":"\/documentation\/systems\/schedulebuilder","abstract":[{"text":"A result builder that collects the systems written in a ","type":"text"},{"isActive":true,"identifier":"doc:\/\/Systems\/documentation\/Systems\/Schedule","type":"reference"},{"text":"’s closure.","type":"text"}],"fragments":[{"kind":"keyword","text":"enum"},{"kind":"text","text":" "},{"kind":"identifier","text":"ScheduleBuilder"}],"role":"symbol","identifier":"doc:\/\/Systems\/documentation\/Systems\/ScheduleBuilder","navigatorTitle":[{"kind":"identifier","text":"ScheduleBuilder"}],"kind":"symbol","title":"ScheduleBuilder"},"doc://Systems/documentation/Systems/System/run(in:)":{"title":"run(in:)","role":"symbol","identifier":"doc:\/\/Systems\/documentation\/Systems\/System\/run(in:)","type":"topic","fragments":[{"kind":"