\/Systems\/UpdateEvents","role":"symbol","url":"\/documentation\/systems\/updateevents","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"UpdateEvents","kind":"identifier"}],"abstract":[{"text":"A system that ends the current event update, dropping events old enough that every reader","type":"text"},{"text":" ","type":"text"},{"text":"has had its chance to read them.","type":"text"}],"navigatorTitle":[{"text":"UpdateEvents","kind":"identifier"}],"type":"topic","kind":"symbol"},"doc://Systems/documentation/Systems/ForwardEvents":{"navigatorTitle":[{"kind":"identifier","text":"ForwardEvents"}],"kind":"symbol","identifier":"doc:\/\/Systems\/documentation\/Systems\/ForwardEvents","abstract":[{"type":"text","text":"A system that yields each event of one type to an asynchronous stream, so code outside the"},{"type":"text","text":" "},{"type":"text","text":"schedule can await the events."}],"url":"\/documentation\/systems\/forwardevents","title":"ForwardEvents","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"ForwardEvents"}],"type":"topic","role":"symbol"},"doc://Systems/documentation/Systems/System":{"kind":"symbol","url":"\/documentation\/systems\/system","fragments":[{"kind":"keyword","text":"protocol"},{"kind":"text","text":" "},{"kind":"identifier","text":"System"}],"title":"System","role":"symbol","type":"topic","identifier":"doc:\/\/Systems\/documentation\/Systems\/System","navigatorTitle":[{"kind":"identifier","text":"System"}],"abstract":[{"type":"text","text":"A rule that reads and changes a world, run once each time its schedule runs."}]},"doc://Systems/documentation/Systems/SystemSet":{"kind":"symbol","url":"\/documentation\/systems\/systemset","fragments":[{"kind":"keyword","text":"protocol"},{"kind":"text","text":" "},{"kind":"identifier","text":"SystemSet"}],"title":"SystemSet","role":"symbol","type":"topic","identifier":"doc:\/\/Systems\/documentation\/Systems\/SystemS