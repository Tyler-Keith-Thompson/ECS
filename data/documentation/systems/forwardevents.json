{"primaryContentSections":[{"declarations":[{"languages":["swift"],"tokens":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"ForwardEvents"},{"kind":"text","text":"<"},{"kind":"genericParameter","text":"E"},{"kind":"text","text":"> "},{"kind":"keyword","text":"where"},{"kind":"text","text":" "},{"kind":"typeIdentifier","text":"E"},{"kind":"text","text":" : "},{"identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/Event","kind":"typeIdentifier","text":"Event","preciseIdentifier":"s:11WorldModule5EventP"}],"platforms":["Linux"]}],"kind":"declarations"},{"kind":"content","content":[{"text":"Overview","level":2,"anchor":"overview","type":"heading"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Use this system to hand events to code that doesn’t run in a schedule, such as a task that"},{"type":"text","text":" "},{"type":"text","text":"plays a sound for each hit. Make a stream, put a "},{"code":"ForwardEvents","type":"codeVoice"},{"type":"text","text":" with the stream’s"},{"type":"text","text":" "},{"type":"text","text":"continuation in the schedule after the systems that send the events, and iterate the stream"},{"type":"text","text":" "},{"type":"text","text":"elsewhere:"}]},{"syntax":"swift","type":"codeListing","code":["let (damages, continuation) = AsyncStream.makeStream(of: Damage.self)","var world = World()","world.spawn(Position(x: 0, y: -1))","","let frame = Schedule {","    UpdateEvents()","    Combat()","    ForwardEvents(to: continuation).after(Combat.self)","}","frame.run(on: &world)","continuation.finish()","","var amounts: [Int] = []","for await damage in damages {","    amounts.append(damage.amount)","}","print(amounts)","\/\/ Prints \"[10]\""]},{"type":"paragraph","inlineContent":[{"text":"Each run yields the events the system hasn’t forwarded yet, oldest first, as an","type":"text"},{"text":" ","type":"text"},{"type":"reference","isActive":true,"identifier":"doc:\/\/Systems\/documentation\/Systems\/EventReader"},{"text":" reads them. Each ","type":"text"},{"type":"codeVoice","code":"ForwardEvents"},{"text":" you create has its own place in the events,","type":"text"},{"text":" ","type":"text"},{"text":"which its copies share. A stream whose consumer has stopped drops what it’s given. The stream","type":"text"},{"text":" ","type":"text"},{"text":"ends when you finish the continuation, not when the system leaves a schedule.","type":"text"}]}]}],"seeAlsoSections":[{"generated":true,"anchor":"Built-In-Systems","identifiers":["doc:\/\/Systems\/documentation\/Systems\/UpdateEvents","doc:\/\/Systems\/documentation\/Systems\/ForwardChanges"],"title":"Built-In Systems"}],"metadata":{"roleHeading":"Structure","navigatorTitle":[{"text":"ForwardEvents","kind":"identifier"}],"fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"ForwardEvents"}],"symbolKind":"struct","remoteSource":{"fileName":"Streams.swift","url":"https:\/\/github.com\/Tyler-Keith-Thompson\/ECS\/blob\/main\/Sources\/Systems\/Streams.swift#L37"},"title":"ForwardEvents","modules":[{"name":"Systems"}],"role":"symbol","externalID":"s:7Systems13ForwardEventsV"},"kind":"symbol","schemaVersion":{"major":0,"patch":0,"minor":3},"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/Systems\/documentation\/Systems\/ForwardEvents"},"sections":[],"relationshipsSections":[{"kind":"relationships","type":"conformsTo","identifiers":["doc:\/\/Systems\/s8SendableP","doc:\/\/Systems\/s16SendableMetatypeP","doc:\/\/Systems\/documentation\/Systems\/System","doc:\/\/Systems\/documentation\/Systems\/SystemSet"],"title":"Conforms To"}],"hierarchy":{"paths":[["doc:\/\/Systems\/documentation\/Systems"]]},"topicSections":[{"generated":true,"title":"Initializers","identifiers":["doc:\/\/Systems\/documentation\/Systems\/ForwardEvents\/init(to:)"],"anchor":"Initializers"},{"generated":true,"title":"Instance Properties","identifiers":["doc:\/\/Systems\/documentation\/System