{"identifier":{"url":"doc:\/\/Systems\/documentation\/Systems\/ForwardEvents","interfaceLanguage":"swift"},"schemaVersion":{"major":0,"patch":0,"minor":3},"kind":"symbol","hierarchy":{"paths":[["doc:\/\/Systems\/documentation\/Systems"]]},"metadata":{"title":"ForwardEvents","symbolKind":"struct","remoteSource":{"fileName":"Streams.swift","url":"https:\/\/github.com\/Tyler-Keith-Thompson\/ECS\/blob\/main\/Sources\/Systems\/Streams.swift#L37"},"roleHeading":"Structure","navigatorTitle":[{"kind":"identifier","text":"ForwardEvents"}],"role":"symbol","externalID":"s:7Systems13ForwardEventsV","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"text":"ForwardEvents","kind":"identifier"}],"modules":[{"name":"Systems"}]},"primaryContentSections":[{"kind":"declarations","declarations":[{"tokens":[{"text":"struct","kind":"keyword"},{"kind":"text","text":" "},{"kind":"identifier","text":"ForwardEvents"},{"kind":"text","text":"<"},{"kind":"genericParameter","text":"E"},{"kind":"text","text":"> "},{"kind":"keyword","text":"where"},{"kind":"text","text":" "},{"kind":"typeIdentifier","text":"E"},{"kind":"text","text":" : "},{"preciseIdentifier":"s:11WorldModule5EventP","identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/Event","kind":"typeIdentifier","text":"Event"}],"platforms":["Linux"],"languages":["swift"]}]},{"kind":"content","content":[{"anchor":"overview","level":2,"text":"Overview","type":"heading"},{"type":"paragraph","inlineContent":[{"text":"Use this system to hand events to code that doesn’t run in a schedule, such as a task that","type":"text"},{"text":" ","type":"text"},{"text":"plays a sound for each hit. Make a stream, put a ","type":"text"},{"code":"ForwardEvents","type":"codeVoice"},{"text":" with the stream’s","type":"text"},{"text":" ","type":"text"},{"text":"continuation in the schedule after the systems that send the events, and iterate the stream","type":"text"},{"text":" ","type":"text"},{"text":"elsewhere:","type":"text"}]},{"syntax":"swift","type":"codeListing","code":["let (damages, continuation) = AsyncStream.makeStream(of: Damage.self)","var world = World()","world.spawn(Position(x: 0, y: -1))","","let frame = Schedule {","    UpdateEvents()","    Combat()","    ForwardEvents(to: continuation).after(Combat.self)","}","frame.run(on: &world)","continuation.finish()","","var amounts: [Int] = []","for await damage in damages {","    amounts.append(damage.amount)","}","print(amounts)","\/\/ Prints \"[10]\""]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Each run yields the events the system hasn’t forwarded yet, oldest first, as an"},{"type":"text","text":" "},{"type":"reference","isActive":true,"identifier":"doc:\/\/Systems\/documentation\/Systems\/EventReader"},{"type":"text","text":" reads them. Each "},{"type":"codeVoice","code":"ForwardEvents"},{"type":"text","text":" you create has its own place in the events,"},{"type":"text","text":" "},{"type":"text","text":"which its copies share. A stream whose consumer has stopped drops what it’s given. The stream"},{"type":"text","text":" "},{"type":"text","text":"ends when you finish the continuation, not when the system leaves a schedule."}]}]}],"variants":[{"paths":["\/documentation\/systems\/forwardevents"],"traits":[{"interfaceLanguage":"swift"}]}],"sections":[],"abstract":[{"text":"A system that yields each event of one type to an asynchronous stream, so code outside the","type":"text"},{"text":" ","type":"text"},{"text":"schedule can await the events.","type":"text"}],"seeAlsoSections":[{"title":"Built-In Systems","identifiers":["doc:\/\/Systems\/documentation\/Systems\/UpdateEvents","doc:\/\/Systems\/documentation\/Systems\/ForwardChanges"],"anchor":"Built-In-Systems","generated":true}],"topicSections":[{"generated":true,"title":"Initializers","anchor":"Initializers","identifiers":["doc:\/\/Systems\/documentation\/Systems\/ForwardEvents\/init(to:)"]},{"generated":true,"title":"Instance Properties","anchor":"Instanc