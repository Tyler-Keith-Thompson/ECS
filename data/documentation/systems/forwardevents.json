{"hierarchy":{"paths":[["doc:\/\/Systems\/documentation\/Systems"]]},"sections":[],"seeAlsoSections":[{"identifiers":["doc:\/\/Systems\/documentation\/Systems\/UpdateEvents","doc:\/\/Systems\/documentation\/Systems\/ForwardChanges"],"generated":true,"anchor":"Built-In-Systems","title":"Built-In Systems"}],"metadata":{"fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"kind":"identifier","text":"ForwardEvents"}],"modules":[{"name":"Systems"}],"role":"symbol","roleHeading":"Structure","navigatorTitle":[{"kind":"identifier","text":"ForwardEvents"}],"title":"ForwardEvents","remoteSource":{"fileName":"Streams.swift","url":"https:\/\/github.com\/Tyler-Keith-Thompson\/ECS\/blob\/main\/Sources\/Systems\/Streams.swift#L37"},"symbolKind":"struct","externalID":"s:7Systems13ForwardEventsV"},"schemaVersion":{"patch":0,"major":0,"minor":3},"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/Systems\/documentation\/Systems\/ForwardEvents"},"topicSections":[{"title":"Initializers","anchor":"Initializers","generated":true,"identifiers":["doc:\/\/Systems\/documentation\/Systems\/ForwardEvents\/init(to:)"]},{"title":"Instance Properties","anchor":"Instance-Properties","generated":true,"identifiers":["doc:\/\/Systems\/documentation\/Systems\/ForwardEvents\/access"]},{"identifiers":["doc:\/\/Systems\/documentation\/Systems\/ForwardEvents\/run(in:)"],"generated":true,"anchor":"Instance-Methods","title":"Instance Methods"},{"identifiers":["doc:\/\/Systems\/documentation\/Systems\/ForwardEvents\/System-Implementations"],"generated":true,"anchor":"Default-Implementations","title":"Default Implementations"}],"primaryContentSections":[{"declarations":[{"tokens":[{"kind":"keyword","text":"struct"},{"text":" ","kind":"text"},{"text":"ForwardEvents","kind":"identifier"},{"text":"<","kind":"text"},{"text":"E","kind":"genericParameter"},{"text":"> ","kind":"text"},{"text":"where","kind":"keyword"},{"text":" ","kind":"text"},{"text":"E","kind":"typeIdentifier"},{"text":" : ","kind":"text"},{"identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/Event","text":"Event","preciseIdentifier":"s:11WorldModule5EventP","kind":"typeIdentifier"}],"platforms":["Linux"],"languages":["swift"]}],"kind":"declarations"},{"content":[{"level":2,"anchor":"overview","text":"Overview","type":"heading"},{"inlineContent":[{"text":"Use this system to hand events to code that doesn’t run in a schedule, such as a task that","type":"text"},{"text":" ","type":"text"},{"text":"plays a sound for each hit. Make a stream, put a ","type":"text"},{"code":"ForwardEvents","type":"codeVoice"},{"text":" with the stream’s","type":"text"},{"text":" ","type":"text"},{"text":"continuation in the schedule after the systems that send the events, and iterate the stream","type":"text"},{"text":" ","type":"text"},{"text":"elsewhere:","type":"text"}],"type":"paragraph"},{"syntax":"swift","code":["let (damages, continuation) = AsyncStream.makeStream(of: Damage.self)","var world = World()","world.spawn(Position(x: 0, y: -1))","","let frame = Schedule {","    UpdateEvents()","    Combat()","    ForwardEvents(to: continuation).after(Combat.self)","}","frame.run(on: &world)","continuation.finish()","","var amounts: [Int] = []","for await damage in damages {","    amounts.append(damage.amount)","}","print(amounts)","\/\/ Prints \"[10]\""],"type":"codeListing"},{"inlineContent":[{"text":"Each run yields the events the system hasn’t forwarded yet, oldest first, as an","type":"text"},{"text":" ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/Systems\/documentation\/Systems\/EventReader"},{"text":" reads them. Each ","type":"text"},{"code":"ForwardEvents","type":"codeVoice"},{"text":" you create has its own place in the events,","type":"text"},{"text":" ","type":"text"},{"text":"which its copies share. A stream whose consumer has stopped drops what it’s given. The stream","type":"text"},{"text":" ","type":"text"},{"text":"ends when you finish the continuation, not when the system leaves a schedule.","type":"text"}],"type":"paragraph"}],"kind":"content"}],"abstract":[{"type":"text","text":"A system that yields each event of one type to an asynchronous stream, so code outside the"},{"type":"text","text":" "},{"type":"text","text":"schedule can await the events."}],"relationshipsSections":[{"identifiers":["doc:\/\/Systems\/s8SendableP","doc:\/\/Systems\/s16SendableMetatypeP","doc:\/\/Systems\/documentation\/Systems\/System","doc:\/\/Systems\/documentation\/Systems\/SystemSet"],"title":"Conforms To","type":"conformsTo","kind":"relationships"}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/systems\/forwardevents"]}],"kind":"symbol","references":{"doc://Systems/documentation/Systems/ForwardEvents/run(in:)":{"role":"symbol","type":"topic","title":"run(in:)","abstract":[{"type":"text","text":"Runs the system’s rule once on a world."}],"kind":"symbol","url":"\/documentation\/systems\/forwardevents\/run(in:)","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"run"},{"kind":"text","text":"("},{"kind":"externalParam","text":"in"},{"kind":"text","text":": "},{"text":"inout","kind":"keyword"},{"text":" ","kind":"text"},{"text":"World","kind":"typeIdentifier","preciseIdentifier":"s:11WorldModule0A0V"},{"text":")","kind":"text"}],"identifier":"doc:\/\/Systems\/documentation\/Systems\/ForwardEvents\/run(in:)"},"doc://Systems/documentation/Systems/ForwardChanges":{"identifier":"doc:\/\/Systems\/documentation\/Systems\/ForwardChanges","kind":"symbol","type":"topic","title":"ForwardChanges","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"ForwardChanges"}],"navigatorTitle":[{"kind":"identifier","text":"ForwardChanges"}],"role":"symbol","abstract":[{"text":"A system that yields each component of one type added or changed since it last ran to an","type":"text"},{"text":" ","type":"text"},{"text":"a