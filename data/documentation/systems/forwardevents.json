{"seeAlsoSections":[{"anchor":"Built-In-Systems","identifiers":["doc:\/\/Systems\/documentation\/Systems\/UpdateEvents","doc:\/\/Systems\/documentation\/Systems\/ForwardChanges"],"generated":true,"title":"Built-In Systems"}],"abstract":[{"type":"text","text":"A system that yields each event of one type to an asynchronous stream, so code outside the"},{"type":"text","text":" "},{"type":"text","text":"schedule can await the events."}],"hierarchy":{"paths":[["doc:\/\/Systems\/documentation\/Systems"]]},"relationshipsSections":[{"type":"conformsTo","kind":"relationships","identifiers":["doc:\/\/Systems\/s8SendableP","doc:\/\/Systems\/s16SendableMetatypeP","doc:\/\/Systems\/documentation\/Systems\/System","doc:\/\/Systems\/documentation\/Systems\/SystemSet"],"title":"Conforms To"}],"metadata":{"title":"ForwardEvents","symbolKind":"struct","navigatorTitle":[{"kind":"identifier","text":"ForwardEvents"}],"externalID":"s:7Systems13ForwardEventsV","remoteSource":{"fileName":"Streams.swift","url":"https:\/\/github.com\/Tyler-Keith-Thompson\/ECS\/blob\/main\/Sources\/Systems\/Streams.swift#L37"},"roleHeading":"Structure","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"text":"ForwardEvents","kind":"identifier"}],"role":"symbol","modules":[{"name":"Systems"}]},"primaryContentSections":[{"kind":"declarations","declarations":[{"tokens":[{"text":"struct","kind":"keyword"},{"kind":"text","text":" "},{"kind":"identifier","text":"ForwardEvents"},{"kind":"text","text":"<"},{"kind":"genericParameter","text":"E"},{"kind":"text","text":"> "},{"kind":"keyword","text":"where"},{"kind":"text","text":" "},{"kind":"typeIdentifier","text":"E"},{"kind":"text","text":" : "},{"kind":"typeIdentifier","preciseIdentifier":"s:11WorldModule5EventP","identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/Event","text":"Event"}],"platforms":["Linux"],"languages":["swift"]}]},{"kind":"content","content":[{"level":2,"anchor":"overview","type":"heading","text":"Overview"},{"inlineContent":[{"text":"Use this system to hand events to code that doesn’t run in a schedule, such as a task that","type":"text"},{"text":" ","type":"text"},{"text":"plays a sound for each hit. Make a stream, put a ","type":"text"},{"code":"ForwardEvents","type":"codeVoice"},{"text":" with the stream’s","type":"text"},{"text":" ","type":"text"},{"text":"continuation in the schedule after the systems that send the events, and iterate the stream","type":"text"},{"text":" ","type":"text"},{"text":"elsewhere:","type":"text"}],"type":"paragraph"},{"code":["let (damages, continuation) = AsyncStream.makeStream(of: Damage.self)","var world = World()","world.spawn(Position(x: 0, y: -1))","","let frame = Schedule {","    UpdateEvents()","    Combat()","    ForwardEvents(to: continuation).after(Combat.self)","}","frame.run(on: &world)","continuation.finish()","","var amounts: [Int] = []","for await damage in damages {","    amounts.append(damage.amount)","}","print(amounts)","\/\/ Prints \"[10]\""],"type":"codeListing","syntax":"swift"},{"inlineContent":[{"text":"Each run yields the events the system hasn’t forwarded yet, oldest first, as an","type":"text"},{"text":" ","type":"text"},{"type":"reference","identifier":"doc:\/\/Systems\/documentation\/Systems\/EventReader","isActive":true},{"text":" reads them. Each ","type":"text"},{"type":"codeVoice","code":"ForwardEvents"},{"text":" you create has its own place in the events,","type":"text"},{"text":" ","type":"text"},{"text":"which its copies share. A stream whose consumer has stopped drops what it’s given. The stream","type":"text"},{"text":" ","type":"text"},{"text":"ends when you finish the continuation, not when the system leaves a schedule.","type":"text"}],"type":"paragraph"}]}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/systems\/forwardevents"]}],"schemaVersion":{"patch":0,"major":0,"minor":3},"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/Systems\/documentation\/Syst