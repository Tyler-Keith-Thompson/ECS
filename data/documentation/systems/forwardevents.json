s":[{"languages":["swift"],"tokens":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"ForwardEvents"},{"kind":"text","text":"<"},{"kind":"genericParameter","text":"E"},{"kind":"text","text":"> "},{"kind":"keyword","text":"where"},{"kind":"text","text":" "},{"kind":"typeIdentifier","text":"E"},{"kind":"text","text":" : "},{"preciseIdentifier":"s:11WorldModule5EventP","kind":"typeIdentifier","text":"Event","identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/Event"}],"platforms":["Linux"]}]},{"kind":"content","content":[{"anchor":"overview","level":2,"text":"Overview","type":"heading"},{"inlineContent":[{"type":"text","text":"Use this system to hand events to code that doesn’t run in a schedule, such as a task that"},{"type":"text","text":" "},{"type":"text","text":"plays a sound for each hit. Make a stream, put a "},{"type":"codeVoice","code":"ForwardEvents"},{"type":"text","text":" with the stream’s"},{"type":"text","text":" "},{"type":"text","text":"continuation in the schedule after the systems that send the events, and iterate the stream"},{"type":"text","text":" "},{"type":"text","text":"elsewhere:"}],"type":"paragraph"},{"syntax":"swift","code":["let (damages, continuation) = AsyncStream.makeStream(of: Damage.self)","var world = World()","world.spawn(Position(x: 0, y: -1))","","let frame = Schedule {","    UpdateEvents()","    Combat()","    ForwardEvents(to: continuation).after(Combat.self)","}","frame.run(on: &world)","continuation.finish()","","var amounts: [Int] = []","for await damage in damages {","    amounts.append(damage.amount)","}","print(amounts)","\/\/ Prints \"[10]\""],"type":"codeListing"},{"inlineContent":[{"text":"Each run yields the events the system hasn’t forwarded yet, oldest first, as an","type":"text"},{"text":" ","type":"text"},{"isActive":true,"identifier":"doc:\/\/Systems\/documentation\/Systems\/EventReader","type":"reference"},{"text":" reads them. Each ","type":"text"},{"code":"ForwardEvents","type":"codeVoice"},{"text":" you create has its own place in the events,","type":"text"},{"text":" ","type":"text"},{"text":"which its copies share. A stream whose consumer has stopped drops what it’s given. The stream","type":"text"},{"text":" ","type":"text"},{"text":"ends when you finish the continuation, not when the system leaves a schedule.","type":"text"}],"type":"paragraph"}]}],"abstract":[{"type":"text","text":"A system that yields each event of one type to an asynchronous stream, so code outside the"},{"type":"text","text":" "},{"type":"text","text":"schedule can await the events."}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/systems\/forwardevents"]}],"references":{"doc://Systems/documentation/Systems/ForwardEvents":{"abstract":[{"text":"A system that yields each event of one type to an asynchronous stream, so code outside the","type":"text"},{"text":" ","type":"text"},{"text":"schedule can await the events.","type":"text"}],"title":"ForwardEvents","url":"\/documentation\/systems\/forwardevents","identifier":"doc:\/\/Systems\/documentation\/Systems\/ForwardEvents","kind":"symbol","type":"topic","role":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"ForwardEvents"}],"navigatorTitle":[{"kind":"identifier","text":"ForwardEvents"}]},"doc://Systems/documentation/Systems/ForwardEvents/init(to:)":{"url":"\/documentation\/systems\/forwardevents\/init(to:)","abstract":[{"text":"Creates a system that yields each new event to a stream’s continuation.","type":"text"}],"kind":"symbol","identifier":"doc:\/\/Systems\/documentation\/Systems\/ForwardEvents\/init(to:)","type":"topic","role":"symbol","fragments":[{"text":"init","kind":"identifier"},{"text":"(","kind":"text"},{"text":"to","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"AsyncStream","kind":"typeIdentifier","preciseIdentifier":"s:ScS"},{"text":"<","kind":"text"},{"kind":"typeIdentifi