{"relationshipsSections":[{"identifiers":["doc:\/\/Systems\/s8SendableP","doc:\/\/Systems\/s16SendableMetatypeP","doc:\/\/Systems\/documentation\/Systems\/System","doc:\/\/Systems\/documentation\/Systems\/SystemSet"],"kind":"relationships","title":"Conforms To","type":"conformsTo"}],"hierarchy":{"paths":[["doc:\/\/Systems\/documentation\/Systems"]]},"topicSections":[{"identifiers":["doc:\/\/Systems\/documentation\/Systems\/ForwardEvents\/init(to:)"],"anchor":"Initializers","title":"Initializers","generated":true},{"identifiers":["doc:\/\/Systems\/documentation\/Systems\/ForwardEvents\/access"],"anchor":"Instance-Properties","title":"Instance Properties","generated":true},{"identifiers":["doc:\/\/Systems\/documentation\/Systems\/ForwardEvents\/run(in:)"],"anchor":"Instance-Methods","title":"Instance Methods","generated":true},{"identifiers":["doc:\/\/Systems\/documentation\/Systems\/ForwardEvents\/System-Implementations"],"anchor":"Default-Implementations","title":"Default Implementations","generated":true}],"seeAlsoSections":[{"identifiers":["doc:\/\/Systems\/documentation\/Systems\/UpdateEvents","doc:\/\/Systems\/documentation\/Systems\/ForwardChanges"],"anchor":"Built-In-Systems","title":"Built-In Systems","generated":true}],"primaryContentSections":[{"declarations":[{"languages":["swift"],"tokens":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"ForwardEvents","kind":"identifier"},{"text":"<","kind":"text"},{"text":"E","kind":"genericParameter"},{"text":"> ","kind":"text"},{"text":"where","kind":"keyword"},{"text":" ","kind":"text"},{"text":"E","kind":"typeIdentifier"},{"text":" : ","kind":"text"},{"text":"Event","preciseIdentifier":"s:11WorldModule5EventP","kind":"typeIdentifier","identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/Event"}],"platforms":["Linux"]}],"kind":"declarations"},{"content":[{"text":"Overview","anchor":"overview","level":2,"type":"heading"},{"inlineContent":[{"type":"text","text":"Use this system to hand events to code that doesn’t run in a schedule, such as a task that"},{"type":"text","text":" "},{"type":"text","text":"plays a sound for each hit. Make a stream, put a "},{"type":"codeVoice","code":"ForwardEvents"},{"type":"text","text":" with the stream’s"},{"type":"text","text":" "},{"type":"text","text":"continuation in the schedule after the systems that send the events, and iterate the stream"},{"type":"text","text":" "},{"type":"text","text":"elsewhere:"}],"type":"paragraph"},{"syntax":"swift","code":["let (damages, continuation) = AsyncStream.makeStream(of: Damage.self)","var world = World()","world.spawn(Position(x: 0, y: -1))","","let frame = Schedule {","    UpdateEvents()","    Combat()","    ForwardEvents(to: continuation).after(Combat.self)","}","frame.run(on: &world)","continuation.finish()","","var amounts: [Int] = []","for await damage in damages {","    amounts.append(damage.amount)","}","print(amounts)","\/\/ Prints \"[10]\""],"type":"codeListing"},{"inlineContent":[{"text":"Each run yields the events the system hasn’t forwarded yet, oldest first, as an","type":"text"},{"text":" ","type":"text"},{"identifier":"doc:\/\/Systems\/documentation\/Systems\/EventReader","type":"reference","isActive":true},{"text":" reads them. Each ","type":"text"},{"type":"codeVoice","code":"ForwardEvents"},{"text":" you create has its own place in the events,","type":"text"},{"text":" ","type":"text"},{"text":"which its copies share. A stream whose consumer has stopped drops what it’s given. The stream","type":"text"},{"text":" ","type":"text"},{"text":"ends when you finish the continuation, not when the system leaves a schedule.","type":"text"}],"type":"paragraph"}],"kind":"content"}],"sections":[],"metadata":{"externalID":"s:7Systems13ForwardEventsV","modules":[{"name":"Systems"}],"role":"symbol","roleHeading":"Structure","symbolKind":"struct","title":"ForwardEvents","navigatorTitle":[{"text":"ForwardEvents","kind":"identifier"}],"remoteSource":{"fileName":"Streams.swi