{"metadata":{"role":"symbol","title":"ForwardEvents","symbolKind":"struct","roleHeading":"Structure","remoteSource":{"url":"https:\/\/github.com\/Tyler-Keith-Thompson\/ECS\/blob\/main\/Sources\/Systems\/Streams.swift#L37","fileName":"Streams.swift"},"fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"ForwardEvents"}],"navigatorTitle":[{"kind":"identifier","text":"ForwardEvents"}],"externalID":"s:7Systems13ForwardEventsV","modules":[{"name":"Systems"}]},"hierarchy":{"paths":[["doc:\/\/Systems\/documentation\/Systems"]]},"topicSections":[{"generated":true,"anchor":"Initializers","title":"Initializers","identifiers":["doc:\/\/Systems\/documentation\/Systems\/ForwardEvents\/init(to:)"]},{"generated":true,"anchor":"Instance-Properties","title":"Instance Properties","identifiers":["doc:\/\/Systems\/documentation\/Systems\/ForwardEvents\/access"]},{"anchor":"Instance-Methods","identifiers":["doc:\/\/Systems\/documentation\/Systems\/ForwardEvents\/run(in:)"],"generated":true,"title":"Instance Methods"},{"anchor":"Default-Implementations","identifiers":["doc:\/\/Systems\/documentation\/Systems\/ForwardEvents\/System-Implementations"],"generated":true,"title":"Default Implementations"}],"schemaVersion":{"minor":3,"major":0,"patch":0},"kind":"symbol","variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/systems\/forwardevents"]}],"identifier":{"url":"doc:\/\/Systems\/documentation\/Systems\/ForwardEvents","interfaceLanguage":"swift"},"sections":[],"abstract":[{"text":"A system that yields each event of one type to an asynchronous stream, so code outside the","type":"text"},{"text":" ","type":"text"},{"text":"schedule can await the events.","type":"text"}],"seeAlsoSections":[{"anchor":"Built-In-Systems","identifiers":["doc:\/\/Systems\/documentation\/Systems\/UpdateEvents","doc:\/\/Systems\/documentation\/Systems\/ForwardChanges"],"generated":true,"title":"Built-In Systems"}],"relationshipsSections":