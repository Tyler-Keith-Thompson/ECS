{"schemaVersion":{"major":0,"patch":0,"minor":3},"kind":"symbol","metadata":{"role":"symbol","modules":[{"name":"Systems"}],"remoteSource":{"fileName":"Streams.swift","url":"https:\/\/github.com\/Tyler-Keith-Thompson\/ECS\/blob\/main\/Sources\/Systems\/Streams.swift#L37"},"roleHeading":"Structure","title":"ForwardEvents","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"ForwardEvents"}],"externalID":"s:7Systems13ForwardEventsV","navigatorTitle":[{"text":"ForwardEvents","kind":"identifier"}],"symbolKind":"struct"},"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/Systems\/documentation\/Systems\/ForwardEvents"},"abstract":[{"text":"A system that yields each event of one type to an asynchronous stream, so code outside the","type":"text"},{"text":" ","type":"text"},{"text":"schedule can await the events.","type":"text"}],"topicSections":[{"generated":true,"identifiers":["doc:\/\/Systems\/documentation\/Systems\/ForwardEvents\/init(to:)"],"title":"Initializers","anchor":"Initializers"},{"generated":true,"identifiers":["doc:\/\/Systems\/documentation\/Systems\/ForwardEvents\/access"],"title":"Instance Properties","anchor":"Instance-Properties"},{"generated":true,"identifiers":["doc:\/\/Systems\/documentation\/Systems\/ForwardEvents\/run(in:)"],"title":"Instance Methods","anchor":"Instance-Methods"},{"generated":true,"identifiers":["doc:\/\/Systems\/documentation\/Systems\/ForwardEvents\/System-Implementations"],"title":"Default Implementations","anchor":"Default-Implementations"}],"relationshipsSections":[{"type":"conformsTo","kind":"relationships","identifiers":["doc:\/\/Systems\/s8SendableP","doc:\/\/Systems\/s16SendableMetatypeP","doc:\/\/Systems\/documentation\/Systems\/System","doc:\/\/Systems\/documentation\/Systems\/SystemSet"],"title":"Conforms To"}],"primaryContentSections":[{"kind":"declarations","declarations":[{"tokens":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"ForwardEvents"},{"kind":"text","text":"<"},{"kind":"genericParameter","text":"E"},{"kind":"text","text":"> "},{"kind":"keyword","text":"where"},{"kind":"text","text":" "},{"kind":"typeIdentifier","text":"E"},{"kind":"text","text":" : "},{"kind":"typeIdentifier","preciseIdentifier":"s:11WorldModule5EventP","identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/Event","text":"Event"}],"platforms":["Linux"],"languages":["swift"]}]},{"kind":"content","content":[{"text":"Overview","anchor":"overview","type":"heading","level":2},{"inlineContent":[{"type":"text","text":"Use this system to hand events to code that doesn’t run in a schedule, such as a task that"},{"type":"text","text":" "},{"type":"text","text":"plays a sound for each hit. Make a stream, put a "},{"type":"codeVoice","code":"ForwardEvents"},{"type":"text","text":" with the stream’s"},{"type":"text","text":" "},{"type":"text","text":"continuation in the schedule after the systems that send the events, and iterate the stream"},{"type":"text","text":" "},{"type":"text","text":"elsewhere:"}],"type":"paragraph"},{"syntax":"swift","code":["let (damages, continuation) = AsyncStream.makeStream(of: Damage.self)","var world = World()","world.spawn(Position(x: 0, y: -1))","","let frame = Schedule {","    UpdateEvents()","    Combat()","    ForwardEvents(to: continuation).after(Combat.self)","}","frame.run(on: &world)","continuation.finish()","","var amounts: [Int] = []","for await damage in damages {","    amounts.append(damage.amount)","}","print(amounts)","\/\/ Prints \"[10]\""],"type":"codeListing"},{"inlineContent":[{"type":"text","text":"Each run yields the events the system hasn’t forwarded yet, oldest first, as an"},{"type":"text","text":" "},{"type":"reference","identifier":"doc:\/\/Systems\/documentation\/Systems\/EventReader","isActive":true},{"type":"text","text":" reads them. Each "},{"type":"codeVoice","code":"ForwardEvents"},{"type":"text","text":" you create has its own place in the events,"},{"type":"text","text":" "},{"type":"text","text":"which its copies share. A stream whose consumer has stopped drops what it’s given. The stream"},{"type":"text","text":" "},{"type":"text","text":"ends when you finish the continuation, not when the system leaves a schedule."}],"type":"paragraph"}]}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/systems\/forwardevents"]}],"sections":[],"seeAlsoSections":[{"generated":true,"identifiers":["doc:\/\/Systems\/documentation\/Systems\/UpdateEvents","doc:\/\/Systems\/documentation\/Systems\/ForwardChanges"],"title":"Built-In Systems","anchor":"Built-In-Systems"}],"hierarchy":{"paths":[["doc:\/\/Systems\/documentation\/Systems"]]},"references":{"doc://Systems/documentation/Systems":{"kind":"symbol","url":"\/documentation\/systems","title":"Systems","role":"collection","type":"topic","identifier":"doc:\/\/Systems\/documentation\/Systems","abstract":[{"text":"Declare the rules of a simulation as systems, and run them on a world in a schedule.","type":"text"}]},"doc://Systems/documentation/Systems/ForwardEvents/run(in:)":{"abstract":[{"type":"text","text":"Runs the system’s rule once on a world."}],"kind":"symbol","type":"topic","url":"\/documentation\/systems\/forwardevents\/run(in:)","identifier":"doc:\/\/Systems\/documentation\/Systems\/ForwardEvents\/run(in:)","title":"run(in:)","role":"symbol","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"run","kind":"identifier"},{"text":"(","kind":"text"},{"text":"in","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"inout","kind":"keyword"},{"text":" ","kind":"text"},{"text":"World","kind":"typeIdentifier","preciseIdentifier":"s:11WorldModule0A0V"},{"text":")","kind":"text"}]},"doc://Systems/documentation/Systems/ForwardEvents/init(to:)":{"identifier":"doc:\/\/Systems\/documentation\/Systems\/ForwardEvents\/init(to:)","title":"init(to:)","url":"\/documentation\/systems\/forwardevents\/init(to:)","kin