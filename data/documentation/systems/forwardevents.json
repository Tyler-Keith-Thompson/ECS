 forwarded yet, oldest first, as an"},{"type":"text","text":" "},{"isActive":true,"identifier":"doc:\/\/Systems\/documentation\/Systems\/EventReader","type":"reference"},{"type":"text","text":" reads them. Each "},{"code":"ForwardEvents","type":"codeVoice"},{"type":"text","text":" you create has its own place in the events,"},{"type":"text","text":" "},{"type":"text","text":"which its copies share. A stream whose consumer has stopped drops what it’s given. The stream"},{"type":"text","text":" "},{"type":"text","text":"ends when you finish the continuation, not when the system leaves a schedule."}]}]}],"abstract":[{"type":"text","text":"A system that yields each event of one type to an asynchronous stream, so code outside the"},{"type":"text","text":" "},{"type":"text","text":"schedule can await the events."}],"references":{"doc://Systems/documentation/Systems/ForwardEvents":{"type":"topic","kind":"symbol","identifier":"doc:\/\/Systems\/documentation\/Systems\/ForwardEvents","url":"\/documentation\/systems\/forwardevents","navigatorTitle":[{"text":"ForwardEvents","kind":"identifier"}],"role":"symbol","abstract":[{"text":"A system that yields each event of one type to an asynchronous stream, so code outside the","type":"text"},{"text":" ","type":"text"},{"text":"schedule can await the events.","type":"text"}],"title":"ForwardEvents","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"ForwardEvents","kind":"identifier"}]},"doc://Systems/documentation/Systems/ForwardEvents/init(to:)":{"fragments":[{"kind":"identifier","text":"init"},{"kind":"text","text":"("},{"kind":"externalParam","text":"to"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:ScS","text":"AsyncStream"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","text":"E"},{"kind":"text","text":">."},{"kind":"typeIdentifier","preciseIdentifier":"s:ScS12ContinuationV","text":"Continuation"},{"kind":"text","text":")"}],"kind":"symbol","title":"init(to:)"