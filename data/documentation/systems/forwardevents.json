Content":[{"type":"text","text":"Each run yields the events the system hasn’t forwarded yet, oldest first, as an"},{"type":"text","text":" "},{"type":"reference","identifier":"doc:\/\/Systems\/documentation\/Systems\/EventReader","isActive":true},{"type":"text","text":" reads them. Each "},{"code":"ForwardEvents","type":"codeVoice"},{"type":"text","text":" you create has its own place in the events,"},{"type":"text","text":" "},{"type":"text","text":"which its copies share. A stream whose consumer has stopped drops what it’s given. The stream"},{"type":"text","text":" "},{"type":"text","text":"ends when you finish the continuation, not when the system leaves a schedule."}],"type":"paragraph"}],"kind":"content"}],"references":{"doc://Systems/documentation/Systems":{"role":"collection","kind":"symbol","type":"topic","identifier":"doc:\/\/Systems\/documentation\/Systems","abstract":[{"text":"Declare the rules of a simulation as systems, and run them on a world in a schedule.","type":"text"}],"title":"Systems","url":"\/documentation\/systems"},"doc://Systems/documentation/Systems/ForwardChanges":{"url":"\/documentation\/systems\/forwardchanges","identifier":"doc:\/\/Systems\/documentation\/Systems\/ForwardChanges","navigatorTitle":[{"kind":"identifier","text":"ForwardChanges"}],"type":"topic","abstract":[{"text":"A system that yields each component of one type added or changed since it last ran to an","type":"text"},{"text":" ","type":"text"},{"text":"asynchronous stream, with its entity.","type":"text"}],"kind":"symbol","title":"ForwardChanges","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"ForwardChanges"}],"role":"symbol"},"doc://Systems/documentation/Systems/SystemSet":{"navigatorTitle":[{"text":"SystemSet","kind":"identifier"}],"abstract":[{"text":"A type that names a group of systems, so ordering constraints can refer to all of them at","type":"text"},{"text":" ","type":"text"},{"text":"once.","type":"text"}