{"topicSections":[{"title":"Initializers","generated":true,"identifiers":["doc:\/\/Systems\/documentation\/Systems\/ForwardEvents\/init(to:)"],"anchor":"Initializers"},{"title":"Instance Properties","generated":true,"identifiers":["doc:\/\/Systems\/documentation\/Systems\/ForwardEvents\/access"],"anchor":"Instance-Properties"},{"title":"Instance Methods","generated":true,"identifiers":["doc:\/\/Systems\/documentation\/Systems\/ForwardEvents\/run(in:)"],"anchor":"Instance-Methods"},{"title":"Default Implementations","generated":true,"identifiers":["doc:\/\/Systems\/documentation\/Systems\/ForwardEvents\/System-Implementations"],"anchor":"Default-Implementations"}],"primaryContentSections":[{"kind":"declarations","declarations":[{"platforms":["Linux"],"tokens":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"ForwardEvents","kind":"identifier"},{"text":"<","kind":"text"},{"text":"E","kind":"genericParameter"},{"text":"> ","kind":"text"},{"text":"where","kind":"keyword"},{"text":" ","kind":"text"},{"text":"E","kind":"typeIdentifier"},{"text":" : ","kind":"text"},{"text":"Event","kind":"typeIdentifier","identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/Event","preciseIdentifier":"s:11WorldModule5EventP"}],"languages":["swift"]}]},{"kind":"content","content":[{"text":"Overview","type":"heading","anchor":"overview","level":2},{"inlineContent":[{"text":"Use this system to hand events to code that doesn’t run in a schedule, such as a task that","type":"text"},{"text":" ","type":"text"},{"text":"plays a sound for each hit. Make a stream, put a ","type":"text"},{"code":"ForwardEvents","type":"codeVoice"},{"text":" with the stream’s","type":"text"},{"text":" ","type":"text"},{"text":"continuation in the schedule after the systems that send the events, and iterate the stream","type":"text"},{"text":" ","type":"text"},{"text":"elsewhere:","type":"text"}],"type":"paragraph"},{"type":"codeListing","code":["let (damages, continuation) = AsyncStream.makeStream(of: Damage.self)","var world = World()","world.spawn(Position(x: 0, y: -1))","","let frame = Schedule {","    UpdateEvents()","    Combat()","    ForwardEvents(to: continuation).after(Combat.self)","}","frame.run(on: &world)","continuation.finish()","","var amounts: [Int] = []","for await damage in damages {","    amounts.append(damage.amount)","}","print(amounts)","\/\/ Prints \"[10]\""],"syntax":"swift"},{"inlineContent":[{"type":"text","text":"Each run yields the events the system hasn’t forwarded yet, oldest first, as an"},{"type":"text","text":" "},{"type":"reference","isActive":true,"identifier":"doc:\/\/Systems\/documentation\/Systems\/EventReader"},{"type":"text","text":" reads them. Each "},{"type":"codeVoice","code":"ForwardEvents"},{"type":"text","text":" you create has its own place in the events,"},{"type":"text","text":" "},{"type":"text","text":"which its copies share. A stream whose consumer has stopped drops what it’s given. The stream"},{"type":"text","text":" "},{"type":"text","text":"ends when you finish the continuation, not when the system leaves a schedule."}],"type":"paragraph"}]}],"schemaVersion":{"patch":0,"major":0,"minor":3},"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/Systems\/documentation\/Systems\/ForwardEvents"},"kind":"symbol","relationshipsSections":[{"kind":"relationships","title":"Conforms To","identifiers":["doc:\/\/Systems\/s8SendableP","doc:\/\/Systems\/s16SendableMetatypeP","doc:\/\/Systems\/documentation\/Systems\/System","doc:\/\/Systems\/documentation\/Systems\/SystemSet"],"type":"conformsTo"}],"metadata":{"role":"symbol","symbolKind":"struct","modules":[{"name":"Systems"}],"externalID":"s:7Systems13ForwardEventsV","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"ForwardEvents"}],"roleHeading":"Structure","title":"ForwardEvents","navigatorTitle":[{"kind":"identifier","text":"ForwardEvents"}],"remoteSource":{"url":"https:\/\/github.com\/Tyler-Kei