{"identifier":{"url":"doc:\/\/Systems\/documentation\/Systems\/ForwardEvents","interfaceLanguage":"swift"},"abstract":[{"type":"text","text":"A system that yields each event of one type to an asynchronous stream, so code outside the"},{"type":"text","text":" "},{"type":"text","text":"schedule can await the events."}],"variants":[{"paths":["\/documentation\/systems\/forwardevents"],"traits":[{"interfaceLanguage":"swift"}]}],"topicSections":[{"identifiers":["doc:\/\/Systems\/documentation\/Systems\/ForwardEvents\/init(to:)"],"anchor":"Initializers","generated":true,"title":"Initializers"},{"identifiers":["doc:\/\/Systems\/documentation\/Systems\/ForwardEvents\/access"],"anchor":"Instance-Properties","generated":true,"title":"Instance Properties"},{"identifiers":["doc:\/\/Systems\/documentation\/Systems\/ForwardEvents\/run(in:)"],"anchor":"Instance-Methods","generated":true,"title":"Instance Methods"},{"identifiers":["doc:\/\/Systems\/documentation\/Systems\/ForwardEvents\/System-Implementations"],"anchor":"Default-Implementations","generated":true,"title":"Default Implementations"}],"primaryContentSections":[{"declarations":[{"tokens":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"ForwardEvents","kind":"identifier"},{"text":"<","kind":"text"},{"text":"E","kind":"genericParameter"},{"text":"> ","kind":"text"},{"text":"where","kind":"keyword"},{"text":" ","kind":"text"},{"text":"E","kind":"typeIdentifier"},{"text":" : ","kind":"text"},{"text":"Event","preciseIdentifier":"s:11WorldModule5EventP","kind":"typeIdentifier","identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/Event"}],"languages":["swift"],"platforms":["Linux"]}],"kind":"declarations"},{"kind":"content","content":[{"text":"Overview","level":2,"type":"heading","anchor":"overview"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Use this system to hand events to code that doesn’t run in a schedule, such as a task that"},{"type":"text","text":" "},{"type":"text","text":"plays a sound for each hit. Make a stream, put a "},{"type":"codeVoice","code":"ForwardEvents"},{"type":"text","text":" with the stream’s"},{"type":"text","text":" "},{"type":"text","text":"continuation in the schedule after the systems that send the events, and iterate the stream"},{"type":"text","text":" "},{"type":"text","text":"elsewhere:"}]},{"syntax":"swift","type":"codeListing","code":["let (damages, continuation) = AsyncStream.makeStream(of: Damage.self)","var world = World()","world.spawn(Position(x: 0, y: -1))","","let frame = Schedule {","    UpdateEvents()","    Combat()","    ForwardEvents(to: continuation).after(Combat.self)","}","frame.run(on: &world)","continuation.finish()","","var amounts: [Int] = []","for await damage in damages {","    amounts.append(damage.amount)","}","print(amounts)","\/\/ Prints \"[10]\""]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Each run yields the events the system hasn’t forwarded yet, oldest first, as an"},{"type":"text","text":" "},{"type":"reference","identifier":"doc:\/\/Systems\/documentation\/Systems\/EventReader","isActive":true},{"type":"text","text":" reads them. Each "},{"type":"codeVoice","code":"ForwardEvents"},{"type":"text","text":" you create has its own place in the events,"},{"type":"text","text":" "},{"type":"text","text":"which its copies share. A stream whose consumer has stopped drops what it’s given. The stream"},{"type":"text","text":" "},{"type":"text","text":"ends when you finish the continuation, not when the system leaves a schedule."}]}]}],"schemaVersion":{"major":0,"minor":3,"patch":0},"sections":[],"metadata":{"title":"ForwardEvents","role":"symbol","modules":[{"name":"Systems"}],"navigatorTitle":[{"text":"ForwardEvents","kind":"identifier"}],"roleHeading":"Structure","symbolKind":"struct","remoteSource":{"url":"https:\/\/github.com\/Tyler-Keith-Thompson\/ECS\/blob\/main\/Sources\/Systems\/Streams.swift#L37","fileName":"Streams.swift"},"externalID":"s:7Systems13ForwardEventsV","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"ForwardEvents"}]},"relationshipsSections":[{"identifiers":["doc:\/\/Systems\/s8SendableP","doc:\/\/Systems\/s16SendableMetatypeP","doc:\/\/Systems\/documentation\/Systems\/System","doc:\/\/Systems\/documentation\/Systems\/SystemSet"],"type":"conformsTo","kind":"relationships","title":"Conforms To"}],"hierarchy":{"paths":[["doc:\/\/Systems\/documentation\/Systems"]]},"seeAlsoSections":[{"identifiers":["doc:\/\/Systems\/documentation\/Systems\/UpdateEvents","doc:\/\/Systems\/documentation\/Systems\/ForwardChanges"],"anchor":"Built-In-Systems","generated":true,"title":"Built-In Systems"}],"kind":"symbol","references":{"doc://Systems/documentation/Systems/SystemSet":{"type":"topic","url":"\/documentation\/systems\/systemset","abstract":[{"type":"text","text":"A type that names a group of systems, so ordering constraints can refer to all of them at"},{"type":"text","text":" "},{"type":"text","text":"once."}],"identifier":"doc:\/\/Systems\/documentation\/Systems\/SystemSet","title":"SystemSet","kind":"symbol","navigatorTitle":[{"text":"SystemSet","kind":"identifier"}],"fragments":[{"text":"protocol","kind":"keyword"},{"text":" ","kind":"text"},{"text":"SystemSet","kind":"identifier"}],"role":"symbol"},"doc://Systems/documentation/Systems":{"identifier":"doc:\/\/Systems\/documentation\/Systems","type":"topic","role":"collection","abstract":[{"text":"Declare the rules of a simulation as systems, and run them on a world in a schedule.","type":"text"}],"url":"\/documentation\/systems","kind":"symbol","title":"Systems"},"doc://Systems/documentation/Systems/ForwardEvents/init(to:)":{"fragments":[{"text":"init","kind":"identifier"},{"text":"(","kind":"text"},{"text":"to","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"AsyncStream","kind":"typeIdentifier","preciseIdentifier":"s:ScS"},{"text":"<","kind":"text"},{"kind":"typeIdentifier","text":"E"},{"kind":"