a schedule, such as a task that"},{"type":"text","text":" "},{"type":"text","text":"plays a sound for each hit. Make a stream, put a "},{"type":"codeVoice","code":"ForwardEvents"},{"type":"text","text":" with the stream’s"},{"type":"text","text":" "},{"type":"text","text":"continuation in the schedule after the systems that send the events, and iterate the stream"},{"type":"text","text":" "},{"type":"text","text":"elsewhere:"}]},{"code":["let (damages, continuation) = AsyncStream.makeStream(of: Damage.self)","var world = World()","world.spawn(Position(x: 0, y: -1))","","let frame = Schedule {","    UpdateEvents()","    Combat()","    ForwardEvents(to: continuation).after(Combat.self)","}","frame.run(on: &world)","continuation.finish()","","var amounts: [Int] = []","for await damage in damages {","    amounts.append(damage.amount)","}","print(amounts)","\/\/ Prints \"[10]\""],"syntax":"swift","type":"codeListing"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Each run yields the events the system hasn’t forwarded yet, oldest first, as an"},{"type":"text","text":" "},{"isActive":true,"type":"reference","identifier":"doc:\/\/Systems\/documentation\/Systems\/EventReader"},{"type":"text","text":" reads them. Each "},{"code":"ForwardEvents","type":"codeVoice"},{"type":"text","text":" you create has its own place in the events,"},{"type":"text","text":" "},{"type":"text","text":"which its copies share. A stream whose consumer has stopped drops what it’s given. The stream"},{"type":"text","text":" "},{"type":"text","text":"ends when you finish the continuation, not when the system leaves a schedule."}]}],"kind":"content"}],"seeAlsoSections":[{"title":"Built-In Systems","identifiers":["doc:\/\/Systems\/documentation\/Systems\/UpdateEvents","doc:\/\/Systems\/documentation\/Systems\/ForwardChanges"],"generated":true,"anchor":"Built-In-Systems"}],"hierarchy":{"paths":[["doc:\/\/Systems\/documentation\/Systems"]]},"schemaVersion":{"minor":3,"major":0,"patch":0},"id