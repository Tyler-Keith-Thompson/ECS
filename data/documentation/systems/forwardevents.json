eam whose consumer has stopped drops what it’s given. The stream"},{"type":"text","text":" "},{"type":"text","text":"ends when you finish the continuation, not when the system leaves a schedule."}]}]}],"variants":[{"paths":["\/documentation\/systems\/forwardevents"],"traits":[{"interfaceLanguage":"swift"}]}],"abstract":[{"type":"text","text":"A system that yields each event of one type to an asynchronous stream, so code outside the"},{"type":"text","text":" "},{"type":"text","text":"schedule can await the events."}],"relationshipsSections":[{"identifiers":["doc:\/\/Systems\/s8SendableP","doc:\/\/Systems\/s16SendableMetatypeP","doc:\/\/Systems\/documentation\/Systems\/System","doc:\/\/Systems\/documentation\/Systems\/SystemSet"],"kind":"relationships","type":"conformsTo","title":"Conforms To"}],"kind":"symbol","references":{"doc://Systems/documentation/Systems":{"identifier":"doc:\/\/Systems\/documentation\/Systems","url":"\/documentation\/systems","type":"topic","role":"collection","title":"Systems","abstract":[{"type":"text","text":"Declare the rules of a simulation as systems, and run them on a world in a schedule."}],"kind":"symbol"},"doc://Systems/documentation/Systems/SystemSet":{"role":"symbol","identifier":"doc:\/\/Systems\/documentation\/Systems\/SystemSet","type":"topic","navigatorTitle":[{"text":"SystemSet","kind":"identifier"}],"fragments":[{"text":"protocol","kind":"keyword"},{"text":" ","kind":"text"},{"text":"SystemSet","kind":"identifier"}],"abstract":[{"text":"A type that names a group of systems, so ordering constraints can refer to all of them at","type":"text"},{"text":" ","type":"text"},{"text":"once.","type":"text"}],"title":"SystemSet","kind":"symbol","url":"\/documentation\/systems\/systemset"},"doc://Systems/s8SendableP":{"identifier":"doc:\/\/Systems\/s8SendableP","title":"Swift.Sendable","type":"unresolvable"},"doc://Systems/documentation/Systems/UpdateEvents":{"identifier":"doc:\/\/Systems\/documentation\/Systems\/UpdateEvents","type":"top