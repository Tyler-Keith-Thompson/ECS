{"sections":[],"variants":[{"paths":["\/documentation\/systems\/schedule"],"traits":[{"interfaceLanguage":"swift"}]}],"metadata":{"externalID":"s:7Systems8ScheduleV","navigatorTitle":[{"text":"Schedule","kind":"identifier"}],"symbolKind":"struct","title":"Schedule","modules":[{"name":"Systems"}],"roleHeading":"Structure","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Schedule","kind":"identifier"}],"remoteSource":{"fileName":"Schedule.swift","url":"https:\/\/github.com\/Tyler-Keith-Thompson\/ECS\/blob\/main\/Sources\/Systems\/Schedule.swift#L97"},"role":"symbol"},"schemaVersion":{"major":0,"patch":0,"minor":3},"kind":"symbol","topicSections":[{"identifiers":["doc:\/\/Systems\/documentation\/Systems\/Schedule\/init(_:)","doc:\/\/Systems\/documentation\/Systems\/Schedule\/init(checked:)","doc:\/\/Systems\/documentation\/Systems\/ScheduleBuilder","doc:\/\/Systems\/documentation\/Systems\/CyclicOrdering"],"anchor":"Creating-a-Schedule","title":"Creating a Schedule"},{"identifiers":["doc:\/\/Systems\/documentation\/Systems\/Schedule\/run(on:)","doc:\/\/Systems\/documentation\/Systems\/Schedule\/runSerially(on:)"],"anchor":"Running-Systems","title":"Running Systems"},{"identifiers":["doc:\/\/Systems\/documentation\/Systems\/Schedule\/after(_:)","doc:\/\/Systems\/documentation\/Systems\/Schedule\/before(_:)","doc:\/\/Systems\/documentation\/Systems\/Schedule\/inSet(_:)","doc:\/\/Systems\/documentation\/Systems\/Schedule\/ambiguous(with:)","doc:\/\/Systems\/documentation\/Systems\/Schedule\/runIf(_:)"],"anchor":"Ordering-and-Conditioning-Every-System","title":"Ordering and Conditioning Every System"},{"identifiers":["doc:\/\/Systems\/documentation\/Systems\/Schedule\/systems","doc:\/\/Systems\/documentation\/Systems\/Schedule\/names","doc:\/\/Systems\/documentation\/Systems\/Schedule\/ambiguities()","doc:\/\/Systems\/documentation\/Systems\/Ambiguity","doc:\/\/Systems\/documentation\/Systems\/Schedule\/writeDOT(to:)"],"anchor":"Inspecting-a-Schedule","title":"Inspecting a Schedule"}],"hierarchy":{"paths":[["doc:\/\/Systems\/documentation\/Systems"]]},"relationshipsSections":[{"identifiers":["doc:\/\/Systems\/s8SendableP","doc:\/\/Systems\/s16SendableMetatypeP"],"kind":"relationships","title":"Conforms To","type":"conformsTo"}],"primaryContentSections":[{"declarations":[{"platforms":["Linux"],"languages":["swift"],"tokens":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"Schedule"}]}],"kind":"declarations"},{"content":[{"anchor":"overview","level":2,"text":"Overview","type":"heading"},{"inlineContent":[{"text":"A schedule holds the systems of one frame or step of a simulation. You build it by listing","type":"text"},{"text":" ","type":"text"},{"text":"the systems in a closure, and run it on a world with ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/Systems\/documentation\/Systems\/Schedule\/run(on:)"},{"text":", which runs each system once:","type":"text"}],"type":"paragraph"},{"syntax":"swift","code":["var world = World()","let ball = world.spawn(Position(x: 0, y: 100), Velocity(dx: 2, dy: 0))","","let frame = Schedule {","    Gravity()","    Movement().after(Gravity.self)","}","frame.run(on: &world)","frame.run(on: &world)","print(world[Position.self, of: ball])","\/\/ Prints \"Position(x: 4.0, y: 70.0)\""],"type":"codeListing"},{"anchor":"Ordering-Systems","level":3,"text":"Ordering Systems","type":"heading"},{"inlineContent":[{"text":"Systems run in the order they’re written, except where an ordering constraint requires","type":"text"},{"text":" ","type":"text"},{"text":"otherwise. A system that must run after one written later, by ","type":"text"},{"type":"codeVoice","code":"after(_:)"},{"text":", or before one","type":"text"},{"text":" ","type":"text"},{"text":"written earlier, by ","type":"text"},{"type":"codeVoice","code":"before(_:)"},{"text":", is moved to satisfy the constraint, and every other system","type":"text"},{"text":" ","type":"text"},{"text":"keeps its written place:","type":"text"}],"type":"paragraph"},{"syntax":"swift","code":["let frame = Schedule {","    Scoring().after(Movement.self)","    Movement()","    Gravity().before(Movement.self)","}","print(frame.names)","\/\/ Prints \"[\"Gravity\", \"Movement\", \"Scoring\"]\""],"type":"codeListing"},{"inlineContent":[{"type":"text","text":"A constraint naming a type with no system in the schedule is ignored, and one naming a"},{"type":"text","text":" "},{"type":"text","text":"system’s own type doesn’t order the system against itself. Constraints that form a cycle,"},{"type":"text","text":" "},{"type":"text","text":"so that no order satisfies them all, trap; build the schedule with "},{"type":"reference","isActive":true,"identifier":"doc:\/\/Systems\/documentation\/Systems\/Schedule\/init(checked:)"},{"type":"text","text":" to throw"},{"type":"text","text":" "},{"type":"reference","isActive":true,"identifier":"doc:\/\/Systems\/documentation\/Systems\/CyclicOrdering"},{"type":"text","text":" instead."}],"type":"paragraph"},{"anchor":"Running-Systems-at-the-Same-Time","level":3,"text":"Running Systems at the Same Time","type":"heading"},{"inlineContent":[{"text":"Two systems ","type":"text"},{"inlineContent":[{"text":"conflict","type":"text"}],"type":"emphasis"},{"text":" when one writes a type the other reads or writes, or when either has no","type":"text"},{"text":" ","type":"text"},{"identifier":"doc:\/\/Systems\/documentation\/Systems\/System\/access","type":"reference","isActive":true},{"text":". ","type":"text"},{"identifier":"doc:\/\/Systems\/documentation\/Systems\/Schedule\/run(on:)","type":"reference","isActive":true},{"text":" runs conflicting systems in order and the rest at the same","type":"text"},{"text":" ","type":"text"},{"text":"time. The world ends as though the systems had run one after another in order, except that","type":"text"},{"text":" ","type":"text"},{"text":"the commands systems queue apply when their wave finishes.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"When two conflicting systems aren’t ordered by any constraint, the order they run in rests","type":"text"},{"text":" ","type":"text"},{"text":"only on how they happen to be written. ","type":"text"},{"identifier":"doc:\/\/Systems\/documentation\/Systems\/Schedule\/ambiguities()","type":"reference","isActive":true},{"text":" lists those pairs, so a test can","type":"text"},{"text":" ","type":"text"},{"text":"keep a schedule free of them.","type":"text"}],"type":"paragraph"}],"kind":"content"}],"abstract":[{"text":"A list of systems that run on a world, in order, and at the same time where they can.","type":"text"}],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/Systems\/documentation\/Systems\/Schedule"},"seeAlsoSections":[{"identifiers":["doc:\/\/Systems\/documentation\/Systems\/ScheduleBuilder","doc:\/\/Systems\/documentation\/Systems\/ScheduledSystem","doc:\/\/Systems\/documentation\/Systems\/SystemSet","doc:\/\/Systems\/documentation\/Systems\/CyclicOrdering","doc:\/\/Systems\/documentation\/Systems\/Ambiguity"],"anchor":"Building-and-Running-Schedules","title":"Building and Running Schedules","generated":true}],"references":{"doc://Systems/documentation/Systems":{"identifier":"doc:\/\/Systems\/documentation\/Systems","type":"topic","url":"\/documentation\/systems","abstract":[{"type":"text","text":"Declare the rules of a simulation as systems, and run them on a world in a schedule."}],"kind":"symbol","role":"collection","title":"Systems"},"doc://Systems/s16SendableMetatypeP":{"identifier":"doc:\/\/Systems\/s16SendableMetatypeP","type":"unresolvable","title":"Swift.SendableMetatype"},"doc://Systems/documentation/Systems/SystemSet":{"kind":"symbol","fragments":[{"kind":"keyword","text":"protocol"},{"kind":"text","text":" "},{"kind":"identifier","text":"SystemSet"}],"role":"symbol","navigatorTitle":[{"kind":"identifier","text":"SystemSet"}],"url":"\/documentation\/syste