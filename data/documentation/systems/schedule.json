{"metadata":{"title":"Schedule","role":"symbol","externalID":"s:7Systems8ScheduleV","remoteSource":{"url":"https:\/\/github.com\/Tyler-Keith-Thompson\/ECS\/blob\/main\/Sources\/Systems\/Schedule.swift#L100","fileName":"Schedule.swift"},"fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"Schedule"}],"modules":[{"name":"Systems"}],"roleHeading":"Structure","symbolKind":"struct","navigatorTitle":[{"text":"Schedule","kind":"identifier"}]},"schemaVersion":{"minor":3,"major":0,"patch":0},"identifier":{"url":"doc:\/\/Systems\/documentation\/Systems\/Schedule","interfaceLanguage":"swift"},"abstract":[{"text":"A list of systems that run on a world, in order, and at the same time where they can.","type":"text"}],"kind":"symbol","topicSections":[{"anchor":"Creating-a-Schedule","identifiers":["doc:\/\/Systems\/documentation\/Systems\/Schedule\/init(_:)","doc:\/\/Systems\/documentation\/Systems\/Schedule\/init(checked:)","doc:\/\/Systems\/documentation\/Systems\/ScheduleBuilder","doc:\/\/Systems\/documentation\/Systems\/CyclicOrdering"],"title":"Creating a Schedule"},{"anchor":"Running-Systems","identifiers":["doc:\/\/Systems\/documentation\/Systems\/Schedule\/run(on:)","doc:\/\/Systems\/documentation\/Systems\/Schedule\/runSerially(on:)"],"title":"Running Systems"},{"anchor":"Ordering-and-Conditioning-Every-System","identifiers":["doc:\/\/Systems\/documentation\/Systems\/Schedule\/after(_:)","doc:\/\/Systems\/documentation\/Systems\/Schedule\/before(_:)","doc:\/\/Systems\/documentation\/Systems\/Schedule\/inSet(_:)","doc:\/\/Systems\/documentation\/Systems\/Schedule\/ambiguous(with:)","doc:\/\/Systems\/documentation\/Systems\/Schedule\/runIf(_:)"],"title":"Ordering and Conditioning Every System"},{"anchor":"Inspecting-a-Schedule","identifiers":["doc:\/\/Systems\/documentation\/Systems\/Schedule\/systems","doc:\/\/Systems\/documentation\/Systems\/Schedule\/names","doc:\/\/Systems\/documentation\/Systems\/Schedule\/ambiguities()","doc:\/\/Systems\/documentation\/Systems\/Ambiguity","doc:\/\/Systems\/documentation\/Systems\/Schedule\/writeDOT(to:)"],"title":"Inspecting a Schedule"}],"primaryContentSections":[{"kind":"declarations","declarations":[{"platforms":["Linux"],"languages":["swift"],"tokens":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Schedule","kind":"identifier"}]}]},{"content":[{"level":2,"anchor":"overview","text":"Overview","type":"heading"},{"inlineContent":[{"text":"A schedule holds the systems of one frame or step of a simulation. You build it by listing","type":"text"},{"text":" ","type":"text"},{"text":"the systems in a closure, and run it on a world with ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/Systems\/documentation\/Systems\/Schedule\/run(on:)"},{"text":", which runs each system once:","type":"text"}],"type":"paragraph"},{"code":["var world = World()","let ball = world.spawn(Position(x: 0, y: 100), Velocity(dx: 2, dy: 0))","","let frame = Schedule {","    Gravity()","    Movement().after(Gravity.self)","}","frame.run(on: &world)","frame.run(on: &world)","print(world[Position.self, of: ball])","\/\/ Prints \"Position(x: 4.0, y: 70.0)\""],"syntax":"swift","type":"codeListing"},{"level":3,"anchor":"Ordering-Systems","text":"Ordering Systems","type":"heading"},{"inlineContent":[{"type":"text","text":"Systems run in the order they’re written, except where an ordering constraint requires"},{"type":"text","text":" "},{"type":"text","text":"otherwise. A system that must run after one written later, by "},{"type":"codeVoice","code":"after(_:)"},{"type":"text","text":", or before one"},{"type":"text","text":" "},{"type":"text","text":"written earlier, by "},{"type":"codeVoice","code":"before(_:)"},{"type":"text","text":", is moved to satisfy the constraint, and every other system"},{"type":"text","text":" "},{"type":"text","text":"keeps its written place:"}],"type":"paragraph"},{"code":["let frame = Schedule {","    Scoring().after(Movement.self)","    Movement()","    Gravity().before(Movement.self)","}","print(frame.names)","\/\/ Prints \"[\"Gravity\", \"Movement\", \"Scoring\"]\""],"syntax":"swift","type":"codeListing"},{"inlineContent":[{"type":"text","text":"A constraint naming a type with no system in the schedule is ignored, and one naming a"},{"type":"text","text":" "},{"type":"text","text":"system’s own type doesn’t order the system against itself. Constraints that form a cycle,"},{"type":"text","text":" "},{"type":"text","text":"so that no order satisfies them all, trap; build the schedule with "},{"identifier":"doc:\/\/Systems\/documentation\/Systems\/Schedule\/init(checked:)","isActive":true,"type":"reference"},{"type":"text","text":" to throw"},{"type":"text","text":" "},{"identifier":"doc:\/\/Systems\/documentation\/Systems\/CyclicOrdering","isActive":true,"type":"reference"},{"type":"text","text":" instead."}],"type":"paragraph"},{"level":3,"anchor":"Running-Systems-at-the-Same-Time","text":"Running Systems at the Same Time","type":"heading"},{"inlineContent":[{"type":"text","text":"Two systems "},{"inlineContent":[{"type":"text","text":"conflict"}],"type":"emphasis"},{"type":"text","text":" when one writes a type the other reads or writes, or when either has no"},{"type":"text","text":" "},{"type":"reference","identifier":"doc:\/\/Systems\/documentation\/Systems\/System\/access","isActive":true},{"type":"text","text":". "},{"type":"reference","identifier":"doc:\/\/Systems\/documentation\/Systems\/Schedule\/run(on:)","isActive":true},{"type":"text","text":" runs conflicting systems in order and the rest at the same"},{"type":"text","text":" "},{"type":"text","text":"time. The world ends as though the systems had run one after another in order, except that"},{"type":"text","text":" "},{"type":"text","text":"the commands systems queue apply when their wave finishes."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"When two conflicting systems aren’t ordered by any constraint, the order they run in rests"},{"type":"text","text":" "},{"type":"text","text":"only on how they happen to be written. "},{"type":"reference","isActive":true,"identifier":"doc:\/\/Systems\/documentation\/Systems\/Schedule\/ambiguities()"},{"type":"text","text":" lists those pairs, so a test can"},{"type":"text","text":" "},{"type":"text","text":"keep a schedule free of them."}],"type":"paragraph"}],"kind":"content"}],"hierarchy":{"paths":[["doc:\/\/Systems\/documentation\/Systems"]]},"sections":[],"seeAlsoSections":[{"title":"Building and Running Schedules","generated":true,"identifiers":["doc:\/\/Systems\/documentation\/Systems\/ScheduleBuilder","doc:\/\/Systems\/documentation\/Systems\/ScheduledSystem","doc:\/\/Systems\/documentation\/Systems\/SystemSet","doc:\/\/Systems\/documentation\/Systems\/CyclicOrdering","doc:\/\/Systems\/documentation\/Systems\/Ambiguity"],"anchor":"Building-and-Running-Schedules"}],"relationshipsSections":[{"title":"Conforms To","type":"conformsTo","kind":"relationships","identifiers":["doc:\/\/Systems\/s8SendableP","doc:\/\/Systems\/s16SendableMetatypeP"]}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/systems\/schedule"]}],"references":{"doc://Systems/documentation/Systems/Schedule/inSet(_:)":{"url":"\/documentation\/systems\/schedule\/inset(_:)","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"inSet"},{"kind":"text","text":"<each "},{"kind":"genericParameter","text":"S"},{"kind":"text","text":">(repeat (each "},{"kind":"typeIdentifier","text":"S"},{"kind":"text","text":").Type) -> "},{"kind":"typeIdentifier","preciseIdentifier":"s:7Systems8ScheduleV","text":"Schedule"}],"title":"inSet(_:)","type":"topic","abstract":[{"text":"Returns this schedule with each of its systems a member of each of the given system sets.","type":"text"}],"kind":"symbol","role":"symbol","identifier":"doc:\/\/Systems\/documentation\/Systems\/Schedule\