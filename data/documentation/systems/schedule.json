4.0, y: 70.0)\""],"syntax":"swift"},{"text":"Ordering Systems","anchor":"Ordering-Systems","type":"heading","level":3},{"inlineContent":[{"text":"Systems run in the order they’re written, except where an ordering constraint requires","type":"text"},{"text":" ","type":"text"},{"text":"otherwise. A system that must run after one written later, by ","type":"text"},{"code":"after(_:)","type":"codeVoice"},{"text":", or before one","type":"text"},{"text":" ","type":"text"},{"text":"written earlier, by ","type":"text"},{"code":"before(_:)","type":"codeVoice"},{"text":", is moved to satisfy the constraint, and every other system","type":"text"},{"text":" ","type":"text"},{"text":"keeps its written place:","type":"text"}],"type":"paragraph"},{"type":"codeListing","code":["let frame = Schedule {","    Scoring().after(Movement.self)","    Movement()","    Gravity().before(Movement.self)","}","print(frame.names)","\/\/ Prints \"[\"Gravity\", \"Movement\", \"Scoring\"]\""],"syntax":"swift"},{"inlineContent":[{"type":"text","text":"A constraint naming a type with no system in the schedule is ignored, and one naming a"},{"type":"text","text":" "},{"type":"text","text":"system’s own type doesn’t order the system against itself. Constraints that form a cycle,"},{"type":"text","text":" "},{"type":"text","text":"so that no order satisfies them all, trap; build the schedule with "},{"type":"reference","isActive":true,"identifier":"doc:\/\/Systems\/documentation\/Systems\/Schedule\/init(checked:)"},{"type":"text","text":" to throw"},{"type":"text","text":" "},{"type":"reference","isActive":true,"identifier":"doc:\/\/Systems\/documentation\/Systems\/CyclicOrdering"},{"type":"text","text":" instead."}],"type":"paragraph"},{"text":"Running Systems at the Same Time","anchor":"Running-Systems-at-the-Same-Time","type":"heading","level":3},{"inlineContent":[{"text":"Two systems ","type":"text"},{"inlineContent":[{"type":"text","text":"conflict"}],"type":"emphasis"},{"text":" when one writes a type the other reads or writes, or when either has no","type":"text"},{"text":" ","type":"text"},{"isActive":true,"identifier":"doc:\/\/Systems\/documentation\/Systems\/System\/access","type":"reference"},{"text":". ","type":"text"},{"isActive":true,"identifier":"doc:\/\/Systems\/documentation\/Systems\/Schedule\/run(on:)","type":"reference"},{"text":" runs conflicting systems in order and the rest at the same","type":"text"},{"text":" ","type":"text"},{"text":"time, and the world ends as though the systems had run one after another in order.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"When two conflicting systems aren’t ordered by any constraint, the order they run in rests"},{"type":"text","text":" "},{"type":"text","text":"only on how they happen to be written. "},{"identifier":"doc:\/\/Systems\/documentation\/Systems\/Schedule\/ambiguities()","type":"reference","isActive":true},{"type":"text","text":" lists those pairs, so a test can"},{"type":"text","text":" "},{"type":"text","text":"keep a schedule free of them."}],"type":"paragraph"}],"kind":"content"}],"references":{"doc://Systems/documentation/Systems":{"abstract":[{"type":"text","text":"Declare the rules of a simulation as systems, and run them on a world in a schedule."}],"type":"topic","title":"Systems","identifier":"doc:\/\/Systems\/documentation\/Systems","url":"\/documentation\/systems","role":"collection","kind":"symbol"},"doc://Systems/documentation/Systems/Schedule":{"navigatorTitle":[{"text":"Schedule","kind":"identifier"}],"type":"topic","url":"\/documentation\/systems\/schedule","kind":"symbol","identifier":"doc:\/\/Systems\/documentation\/Systems\/Schedule","abstract":[{"text":"A list of systems that run on a world, in order, and at the same time where they can.","type":"text"}],"fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Schedule","kind":"identifier"}],"role":"symbol","title":"Schedule"},"doc://Systems/documentation/Syst