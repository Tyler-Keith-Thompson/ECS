{"schemaVersion":{"patch":0,"minor":3,"major":0},"kind":"symbol","metadata":{"symbolKind":"struct","modules":[{"name":"Systems"}],"remoteSource":{"url":"https:\/\/github.com\/Tyler-Keith-Thompson\/ECS\/blob\/main\/Sources\/Systems\/Schedule.swift#L100","fileName":"Schedule.swift"},"roleHeading":"Structure","title":"Schedule","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"Schedule"}],"externalID":"s:7Systems8ScheduleV","navigatorTitle":[{"kind":"identifier","text":"Schedule"}],"role":"symbol"},"identifier":{"url":"doc:\/\/Systems\/documentation\/Systems\/Schedule","interfaceLanguage":"swift"},"abstract":[{"type":"text","text":"A list of systems that run on a world, in order, and at the same time where they can."}],"topicSections":[{"anchor":"Creating-a-Schedule","identifiers":["doc:\/\/Systems\/documentation\/Systems\/Schedule\/init(_:)","doc:\/\/Systems\/documentation\/Systems\/Schedule\/init(checked:)","doc:\/\/Systems\/documentation\/Systems\/ScheduleBuilder","doc:\/\/Systems\/documentation\/Systems\/CyclicOrdering"],"title":"Creating a Schedule"},{"anchor":"Running-Systems","identifiers":["doc:\/\/Systems\/documentation\/Systems\/Schedule\/run(on:)","doc:\/\/Systems\/documentation\/Systems\/Schedule\/runSerially(on:)"],"title":"Running Systems"},{"anchor":"Ordering-and-Conditioning-Every-System","identifiers":["doc:\/\/Systems\/documentation\/Systems\/Schedule\/after(_:)","doc:\/\/Systems\/documentation\/Systems\/Schedule\/before(_:)","doc:\/\/Systems\/documentation\/Systems\/Schedule\/inSet(_:)","doc:\/\/Systems\/documentation\/Systems\/Schedule\/ambiguous(with:)","doc:\/\/Systems\/documentation\/Systems\/Schedule\/runIf(_:)"],"title":"Ordering and Conditioning Every System"},{"anchor":"Inspecting-a-Schedule","identifiers":["doc:\/\/Systems\/documentation\/Systems\/Schedule\/systems","doc:\/\/Systems\/documentation\/Systems\/Schedule\/names","doc:\/\/Systems\/documentation\/Systems\/Schedule\/ambiguities()","doc:\/\/Systems\/documentation\/Systems\/Ambiguity","doc:\/\/Systems\/documentation\/Systems\/Schedule\/writeDOT(to:)"],"title":"Inspecting a Schedule"}],"relationshipsSections":[{"identifiers":["doc:\/\/Systems\/s8SendableP","doc:\/\/Systems\/s16SendableMetatypeP"],"kind":"relationships","title":"Conforms To","type":"conformsTo"}],"primaryContentSections":[{"declarations":[{"platforms":["Linux"],"languages":["swift"],"tokens":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Schedule","kind":"identifier"}]}],"kind":"declarations"},{"kind":"content","content":[{"level":2,"anchor":"overview","type":"heading","text":"Overview"},{"inlineContent":[{"type":"text","text":"A schedule holds the systems of one frame or step of a simulation. You build it by listing"},{"type":"text","text":" "},{"type":"text","text":"the systems in a closure, and run it on a world with "},{"identifier":"doc:\/\/Systems\/documentation\/Systems\/Schedule\/run(on:)","type":"reference","isActive":true},{"type":"text","text":", which runs each system once:"}],"type":"paragraph"},{"code":["var world = World()","let ball = world.spawn(Position(x: 0, y: 100), Velocity(dx: 2, dy: 0))","","let frame = Schedule {","    Gravity()","    Movement().after(Gravity.self)","}","frame.run(on: &world)","frame.run(on: &world)","print(world[Position.self, of: ball])","\/\/ Prints \"Position(x: 4.0, y: 70.0)\""],"syntax":"swift","type":"codeListing"},{"level":3,"anchor":"Ordering-Systems","type":"heading","text":"Ordering Systems"},{"inlineContent":[{"text":"Systems run in the order they’re written, except where an ordering constraint requires","type":"text"},{"text":" ","type":"text"},{"text":"otherwise. A system that must run after one written later, by ","type":"text"},{"type":"codeVoice","code":"after(_:)"},{"text":", or before one","type":"text"},{"text":" ","type":"text"},{"text":"written earlier, by ","type":"text"},{"type":"codeVoice","code":"before(_:)"},{"text":", is moved to satisfy the constraint, and every other system","type":"text"},{"text":" ","type":"text"},{"text":"keeps its written place:","type":"text"}],"type":"paragraph"},{"code":["let frame = Schedule {","    Scoring().after(Movement.self)","    Movement()","    Gravity().before(Movement.self)","}","print(frame.names)","\/\/ Prints \"[\"Gravity\", \"Movement\", \"Scoring\"]\""],"syntax":"swift","type":"codeListing"},{"inlineContent":[{"type":"text","text":"A constraint naming a type with no system in the schedule is ignored, and one naming a"},{"type":"text","text":" "},{"type":"text","text":"system’s own type doesn’t order the system against itself. Constraints that form a cycle,"},{"type":"text","text":" "},{"type":"text","text":"so that no order satisfies them all, trap; build the schedule with "},{"identifier":"doc:\/\/Systems\/documentation\/Systems\/Schedule\/init(checked:)","type":"reference","isActive":true},{"type":"text","text":" to throw"},{"type":"text","text":" "},{"identifier":"doc:\/\/Systems\/documentation\/Systems\/CyclicOrdering","type":"reference","isActive":true},{"type":"text","text":" instead."}],"type":"paragraph"},{"level":3,"anchor":"Running-Systems-at-the-Same-Time","type":"heading","text":"Running Systems at the Same Time"},{"inlineContent":[{"type":"text","text":"Two systems "},{"inlineContent":[{"type":"text","text":"conflict"}],"type":"emphasis"},{"type":"text","text":" when one writes a type the other reads or writes, or when either has no"},{"type":"text","text":" "},{"identifier":"doc:\/\/Systems\/documentation\/Systems\/System\/access","type":"reference","isActive":true},{"type":"text","text":". "},{"identifier":"doc:\/\/Systems\/documentation\/Systems\/Schedule\/run(on:)","type":"reference","isActive":true},{"type":"text","text":" runs conflicting systems in order and the rest at the same"},{"type":"text","text":" "},{"type":"text","text":"time. The world ends as though the systems had run one after another in order, except that"},{"type":"text","text":" "},{"type":"text","text":"the commands systems queue apply when their wave finishes."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"When two conflicting systems aren’t ordered by any constraint, the order they run in rests"},{"type":"text","text":" "},{"type":"text","text":"only on how they happen to be written. "},{"type":"reference","identifier":"doc:\/\/Systems\/documentation\/Systems\/Schedule\/ambiguities()","isActive":true},{"type":"text","text":" lists those pairs, so a test can"},{"type":"text","text":" "},{"type":"text","text":"keep a schedule free of them."}],"type":"paragraph"}]}],"variants":[{"paths":["\/documentation\/systems\/schedule"],"traits":[{"interfaceLanguage":"swift"}]}],"sections":[],"seeAlsoSections":[{"anchor":"Building-and-Running-Schedules","identifiers":["doc:\/\/Systems\/documentation\/Systems\/ScheduleBuilder","doc:\/\/Systems\/documentation\/Systems\/ScheduledSystem","doc:\/\/Systems\/documentation\/Systems\/SystemSet","doc:\/\/Systems\/documentation\/Systems\/CyclicOrdering","doc:\/\/Systems\/documentation\/Systems\/Ambiguity"],"generated":true,"title":"Building and Running Schedules"}],"hierarchy":{"paths":[["doc:\/\/Systems\/documentation\/Systems"]]},"references":{"doc://Systems/documentation/Systems/Schedule":{"abstract":[{"type":"text","text":"A list of systems that run on a world, in order, and at the same time where they can."}],"role":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Schedule","kind":"identifier"}],"url":"\/documentation\/systems\/schedule","navigatorTitle":[{"text":"Schedule","kind":"identifier"}],"kind":"symbol","type":"topic","identifier":"doc:\/\/Systems\/documentation\/Systems\/Schedule","title":"Schedule"},"doc://Systems/documentation/Systems/Schedule/ambiguities()":{"kind":"symbol","abstract":[{"type":"text","text":"Returns every pair of systems whose accesses conflict but that no ordering constraint"},{"type":"text","text":" "},{"typ