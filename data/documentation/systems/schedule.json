"code":"before(_:)"},{"type":"text","text":", is moved to satisfy the constraint, and every other system"},{"type":"text","text":" "},{"type":"text","text":"keeps its written place:"}]},{"code":["let frame = Schedule {","    Scoring().after(Movement.self)","    Movement()","    Gravity().before(Movement.self)","}","print(frame.names)","\/\/ Prints \"[\"Gravity\", \"Movement\", \"Scoring\"]\""],"type":"codeListing","syntax":"swift"},{"type":"paragraph","inlineContent":[{"text":"A constraint naming a type with no system in the schedule is ignored, and one naming a","type":"text"},{"text":" ","type":"text"},{"text":"system’s own type doesn’t order the system against itself. Constraints that form a cycle,","type":"text"},{"text":" ","type":"text"},{"text":"so that no order satisfies them all, trap; build the schedule with ","type":"text"},{"type":"reference","identifier":"doc:\/\/Systems\/documentation\/Systems\/Schedule\/init(checked:)","isActive":true},{"text":" to throw","type":"text"},{"text":" ","type":"text"},{"type":"reference","identifier":"doc:\/\/Systems\/documentation\/Systems\/CyclicOrdering","isActive":true},{"text":" instead.","type":"text"}]},{"text":"Running Systems at the Same Time","anchor":"Running-Systems-at-the-Same-Time","type":"heading","level":3},{"type":"paragraph","inlineContent":[{"text":"Two systems ","type":"text"},{"inlineContent":[{"text":"conflict","type":"text"}],"type":"emphasis"},{"text":" when one writes a type the other reads or writes, or when either has no","type":"text"},{"text":" ","type":"text"},{"identifier":"doc:\/\/Systems\/documentation\/Systems\/System\/access","isActive":true,"type":"reference"},{"text":". ","type":"text"},{"identifier":"doc:\/\/Systems\/documentation\/Systems\/Schedule\/run(on:)","isActive":true,"type":"reference"},{"text":" runs conflicting systems in order and the rest at the same","type":"text"},{"text":" ","type":"text"},{"text":"time. The world ends as though the systems had run one after another in order, except that","type":"text"},{"text":" ","type":"text"},{"text":"the commands systems queue apply when their wave finishes.","type":"text"}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"When two conflicting systems aren’t ordered by any constraint, the order they run in rests"},{"type":"text","text":" "},{"type":"text","text":"only on how they happen to be written. "},{"isActive":true,"type":"reference","identifier":"doc:\/\/Systems\/documentation\/Systems\/Schedule\/ambiguities()"},{"type":"text","text":" lists those pairs, so a test can"},{"type":"text","text":" "},{"type":"text","text":"keep a schedule free of them."}]}],"kind":"content"}],"metadata":{"modules":[{"name":"Systems"}],"externalID":"s:7Systems8ScheduleV","role":"symbol","roleHeading":"Structure","remoteSource":{"url":"https:\/\/github.com\/Tyler-Keith-Thompson\/ECS\/blob\/main\/Sources\/Systems\/Schedule.swift#L97","fileName":"Schedule.swift"},"title":"Schedule","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"Schedule"}],"navigatorTitle":[{"kind":"identifier","text":"Schedule"}],"symbolKind":"struct"},"hierarchy":{"paths":[["doc:\/\/Systems\/documentation\/Systems"]]},"references":{"doc://Systems/documentation/Systems/Schedule/names":{"title":"names","kind":"symbol","role":"symbol","abstract":[{"type":"text","text":"The names of the schedule’s systems’ types, in the order the systems run."}],"identifier":"doc:\/\/Systems\/documentation\/Systems\/Schedule\/names","fragments":[{"text":"var","kind":"keyword"},{"text":" ","kind":"text"},{"text":"names","kind":"identifier"},{"text":": [","kind":"text"},{"text":"String","kind":"typeIdentifier","preciseIdentifier":"s:SS"},{"text":"]","kind":"text"}],"type":"topic","url":"\/documentation\/systems\/schedule\/names"},"doc://Systems/documentation/Systems/Schedule/writeDOT(to:)":{"identifier":"doc:\/\/Systems\/documentation\/Systems\/Schedule\/writeDOT(to:)","type":"topic","kind":"symb