nts \"Position(x: 4.0, y: 70.0)\""],"syntax":"swift"},{"text":"Ordering Systems","type":"heading","anchor":"Ordering-Systems","level":3},{"inlineContent":[{"text":"Systems run in the order they’re written, except where an ordering constraint requires","type":"text"},{"text":" ","type":"text"},{"text":"otherwise. A system that must run after one written later, by ","type":"text"},{"code":"after(_:)","type":"codeVoice"},{"text":", or before one","type":"text"},{"text":" ","type":"text"},{"text":"written earlier, by ","type":"text"},{"code":"before(_:)","type":"codeVoice"},{"text":", is moved to satisfy the constraint, and every other system","type":"text"},{"text":" ","type":"text"},{"text":"keeps its written place:","type":"text"}],"type":"paragraph"},{"type":"codeListing","code":["let frame = Schedule {","    Scoring().after(Movement.self)","    Movement()","    Gravity().before(Movement.self)","}","print(frame.names)","\/\/ Prints \"[\"Gravity\", \"Movement\", \"Scoring\"]\""],"syntax":"swift"},{"inlineContent":[{"type":"text","text":"A constraint naming a type with no system in the schedule is ignored, and one naming a"},{"type":"text","text":" "},{"type":"text","text":"system’s own type doesn’t order the system against itself. Constraints that form a cycle,"},{"type":"text","text":" "},{"type":"text","text":"so that no order satisfies them all, trap; build the schedule with "},{"type":"reference","identifier":"doc:\/\/Systems\/documentation\/Systems\/Schedule\/init(checked:)","isActive":true},{"type":"text","text":" to throw"},{"type":"text","text":" "},{"type":"reference","identifier":"doc:\/\/Systems\/documentation\/Systems\/CyclicOrdering","isActive":true},{"type":"text","text":" instead."}],"type":"paragraph"},{"text":"Running Systems at the Same Time","type":"heading","anchor":"Running-Systems-at-the-Same-Time","level":3},{"inlineContent":[{"text":"Two systems ","type":"text"},{"type":"emphasis","inlineContent":[{"text":"conflict","type":"text"}]},{"text":" when one writes a type the other reads or writes, or when either has no","type":"text"},{"text":" ","type":"text"},{"identifier":"doc:\/\/Systems\/documentation\/Systems\/System\/access","isActive":true,"type":"reference"},{"text":". ","type":"text"},{"identifier":"doc:\/\/Systems\/documentation\/Systems\/Schedule\/run(on:)","isActive":true,"type":"reference"},{"text":" runs conflicting systems in order and the rest at the same","type":"text"},{"text":" ","type":"text"},{"text":"time. The world ends as though the systems had run one after another in order, except that","type":"text"},{"text":" ","type":"text"},{"text":"the commands systems queue apply when their wave finishes.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"When two conflicting systems aren’t ordered by any constraint, the order they run in rests","type":"text"},{"text":" ","type":"text"},{"text":"only on how they happen to be written. ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/Systems\/documentation\/Systems\/Schedule\/ambiguities()"},{"text":" lists those pairs, so a test can","type":"text"},{"text":" ","type":"text"},{"text":"keep a schedule free of them.","type":"text"}],"type":"paragraph"}]}],"references":{"doc://Systems/documentation/Systems/Schedule/inSet(_:)":{"role":"symbol","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"inSet"},{"kind":"text","text":"<each "},{"kind":"genericParameter","text":"S"},{"kind":"text","text":">(repeat (each "},{"text":"S","kind":"typeIdentifier"},{"text":").Type) -> ","kind":"text"},{"text":"Schedule","kind":"typeIdentifier","preciseIdentifier":"s:7Systems8ScheduleV"}],"identifier":"doc:\/\/Systems\/documentation\/Systems\/Schedule\/inSet(_:)","title":"inSet(_:)","type":"topic","kind":"symbol","url":"\/documentation\/systems\/schedule\/inset(_:)","abstract":[{"text":"Returns this schedule with each of its systems a member of each of the given system sets.","typ