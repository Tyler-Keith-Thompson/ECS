{"sections":[],"kind":"symbol","abstract":[{"text":"A system parameter that reads the events of one type sent since the system last read them.","type":"text"}],"relationshipsSections":[{"identifiers":["doc:\/\/Systems\/SK","doc:\/\/Systems\/Sl","doc:\/\/Systems\/Sk","doc:\/\/Systems\/s8SendableP","doc:\/\/Systems\/s16SendableMetatypeP","doc:\/\/Systems\/ST","doc:\/\/Systems\/documentation\/Systems\/SystemParameter"],"type":"conformsTo","kind":"relationships","title":"Conforms To"}],"hierarchy":{"paths":[["doc:\/\/Systems\/documentation\/Systems"]]},"schemaVersion":{"major":0,"minor":3,"patch":0},"seeAlsoSections":[{"generated":true,"anchor":"System-Parameters","identifiers":["doc:\/\/Systems\/documentation\/Systems\/SystemParameter","doc:\/\/Systems\/documentation\/Systems\/Update","doc:\/\/Systems\/documentation\/Systems\/ResourceReader","doc:\/\/Systems\/documentation\/Systems\/ResourceWriter","doc:\/\/Systems\/documentation\/Systems\/EventWriter","doc:\/\/Systems\/documentation\/Systems\/RemovedComponents"],"title":"System Parameters"}],"primaryContentSections":[{"declarations":[{"platforms":["Linux"],"tokens":[{"text":"@frozen","kind":"attribute"},{"text":" ","kind":"text"},{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"EventReader","kind":"identifier"},{"text":"<","kind":"text"},{"text":"E","kind":"genericParameter"},{"text":"> ","kind":"text"},{"text":"where","kind":"keyword"},{"text":" ","kind":"text"},{"text":"E","kind":"typeIdentifier"},{"text":" : ","kind":"text"},{"preciseIdentifier":"s:11WorldModule5EventP","text":"Event","kind":"typeIdentifier","identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/Event"}],"languages":["swift"]}],"kind":"declarations"},{"content":[{"type":"heading","text":"Overview","level":2,"anchor":"overview"},{"type":"paragraph","inlineContent":[{"type":"text","text":"An event reader is a collection of the new events, oldest first. Each system type has its own"},{"type":"text","text":" "},{"type":"text","text":"place in the events, so it sees each event once however many other systems read them too. The"},{"type":"text","text":" "},{"type":"text","text":"following system applies each "},{"type":"codeVoice","code":"Damage"},{"type":"text","text":" event to the health of its target:"}]},{"type":"codeListing","syntax":"swift","code":["@System","struct ApplyDamage {","    func run(_ damages: EventReader<Damage>, _ health: Update<Health>) {","        health { health, entity in","            for damage in damages where damage.target == entity {","                health.current -= damage.amount","            }","        }","    }","}","","var world = World()","let knight = world.spawn(Health(current: 30))","world.send(Damage(target: knight, amount: 12))","Schedule { ApplyDamage() }.run(on: &world)","print(world[Health.self, of: knight].current)","\/\/ Prints \"18\""]},{"type":"paragraph","inlineContent":[{"type":"text","text":"A world keeps an event for the rest of the update it was sent in and all of the next; see"},{"type":"text","text":" "},{"type":"reference","isActive":true,"identifier":"doc:\/\/Systems\/documentation\/Systems\/UpdateEvents"},{"type":"text","text":". A system that doesn’t run for longer than that misses the events dropped in"},{"type":"text","text":" "},{"type":"text","text":"between."}]}],"kind":"content"}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/systems\/eventreader"]}],"metadata":{"title":"EventReader","role":"symbol","navigatorTitle":[{"text":"EventReader","kind":"identifier"}],"externalID":"s:7Systems11EventReaderV","modules":[{"name":"Systems"}],"roleHeading":"Structure","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"EventReader","kind":"identifier"}],"remoteSource":{"fileName":"SystemParameters.swift","url":"https:\/\/github.com\/Tyler-Keith-Thompson\/ECS\/blob\/main\/Sources\/Systems\/SystemParameters.swift#L236"},"symbolKind":"struct"},"topicSections":[{"genera