Identifier":"s:11WorldModule5EventP"}],"platforms":["Linux"],"languages":["swift"]}],"kind":"declarations"},{"content":[{"text":"Overview","type":"heading","level":2,"anchor":"overview"},{"inlineContent":[{"type":"text","text":"An event reader is a collection of the new events, oldest first. Each system type has its own"},{"type":"text","text":" "},{"type":"text","text":"place in the events, so it sees each event once however many other systems read them too. The"},{"type":"text","text":" "},{"type":"text","text":"following system applies each "},{"type":"codeVoice","code":"Damage"},{"type":"text","text":" event to the health of its target:"}],"type":"paragraph"},{"syntax":"swift","type":"codeListing","code":["@System","struct ApplyDamage {","    func run(_ damages: EventReader<Damage>, _ health: Update<Health>) {","        health { health, entity in","            for damage in damages where damage.target == entity {","                health.current -= damage.amount","            }","        }","    }","}","","var world = World()","let knight = world.spawn(Health(current: 30))","world.send(Damage(target: knight, amount: 12))","Schedule { ApplyDamage() }.run(on: &world)","print(world[Health.self, of: knight].current)","\/\/ Prints \"18\""]},{"inlineContent":[{"text":"A world keeps an event for the rest of the update it was sent in and all of the next; see","type":"text"},{"text":" ","type":"text"},{"identifier":"doc:\/\/Systems\/documentation\/Systems\/UpdateEvents","isActive":true,"type":"reference"},{"text":". A system that doesn’t run for longer than that misses the events dropped in","type":"text"},{"text":" ","type":"text"},{"text":"between.","type":"text"}],"type":"paragraph"}],"kind":"content"}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/systems\/eventreader"]}],"identifier":{"url":"doc:\/\/Systems\/documentation\/Systems\/EventReader","interfaceLanguage":"swift"},"hierarchy":{"paths":[["doc:\/\/Systems\/documentation\/Sys