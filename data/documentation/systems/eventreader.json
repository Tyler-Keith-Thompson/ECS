{"metadata":{"externalID":"s:7Systems11EventReaderV","modules":[{"name":"Systems"}],"roleHeading":"Structure","role":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"EventReader","kind":"identifier"}],"title":"EventReader","symbolKind":"struct","navigatorTitle":[{"text":"EventReader","kind":"identifier"}],"remoteSource":{"url":"https:\/\/github.com\/Tyler-Keith-Thompson\/ECS\/blob\/main\/Sources\/Systems\/SystemParameters.swift#L236","fileName":"SystemParameters.swift"}},"identifier":{"url":"doc:\/\/Systems\/documentation\/Systems\/EventReader","interfaceLanguage":"swift"},"abstract":[{"text":"A system parameter that reads the events of one type sent since the system last read them.","type":"text"}],"primaryContentSections":[{"kind":"declarations","declarations":[{"languages":["swift"],"platforms":["Linux"],"tokens":[{"kind":"attribute","text":"@frozen"},{"kind":"text","text":" "},{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"EventReader"},{"kind":"text","text":"<"},{"kind":"genericParameter","text":"E"},{"kind":"text","text":"> "},{"kind":"keyword","text":"where"},{"kind":"text","text":" "},{"kind":"typeIdentifier","text":"E"},{"kind":"text","text":" : "},{"kind":"typeIdentifier","identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/Event","text":"Event","preciseIdentifier":"s:11WorldModule5EventP"}]}]},{"kind":"content","content":[{"anchor":"overview","type":"heading","level":2,"text":"Overview"},{"inlineContent":[{"text":"An event reader is a collection of the new events, oldest first. Each system type has its own","type":"text"},{"text":" ","type":"text"},{"text":"place in the events, so it sees each event once however many other systems read them too. The","type":"text"},{"text":" ","type":"text"},{"text":"following system applies each ","type":"text"},{"type":"codeVoice","code":"Damage"},{"text":" event to the health of its target:","type":"text"}],"type":"paragraph"},{"code":["@System","struct ApplyDamage {","    func run(_ damages: EventReader<Damage>, _ health: Update<Health>) {","        health { health, entity in","            for damage in damages where damage.target == entity {","                health.current -= damage.amount","            }","        }","    }","}","","var world = World()","let knight = world.spawn(Health(current: 30))","world.send(Damage(target: knight, amount: 12))","Schedule { ApplyDamage() }.run(on: &world)","print(world[Health.self, of: knight].current)","\/\/ Prints \"18\""],"syntax":"swift","type":"codeListing"},{"inlineContent":[{"type":"text","text":"A world keeps an event for the rest of the update it was sent in and all of the next; see"},{"type":"text","text":" "},{"isActive":true,"type":"reference","identifier":"doc:\/\/Systems\/documentation\/Systems\/UpdateEvents"},{"type":"text","text":". A system that doesn’t run for longer than that misses the events dropped in"},{"type":"text","text":" "},{"type":"text","text":"between."}],"type":"paragraph"}]}],"seeAlsoSections":[{"identifiers":["doc:\/\/Systems\/documentation\/Systems\/SystemParameter","doc:\/\/Systems\/documentation\/Systems\/Update","doc:\/\/Systems\/documentation\/Systems\/ResourceReader","doc:\/\/Systems\/documentation\/Systems\/ResourceWriter","doc:\/\/Systems\/documentation\/Systems\/EventWriter","doc:\/\/Systems\/documentation\/Systems\/RemovedComponents"],"title":"System Parameters","anchor":"System-Parameters","generated":true}],"sections":[],"schemaVersion":{"minor":3,"patch":0,"major":0},"topicSections":[{"identifiers":["doc:\/\/Systems\/documentation\/Systems\/EventReader\/endIndex","doc:\/\/Systems\/documentation\/Systems\/EventReader\/events","doc:\/\/Systems\/documentation\/Systems\/EventReader\/startIndex"],"title":"Instance Properties","anchor":"Instance-Properties","generated":true},{"identifiers":["doc:\/\/Systems\/documentation\/Systems\/EventReader\/subscript(_:)"],"title":"Subscripts","anchor":"Subscripts",