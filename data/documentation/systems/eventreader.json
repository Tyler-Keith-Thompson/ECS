{"identifier":{"url":"doc:\/\/Systems\/documentation\/Systems\/EventReader","interfaceLanguage":"swift"},"abstract":[{"text":"A system parameter that reads the events of one type sent since the system last read them.","type":"text"}],"relationshipsSections":[{"title":"Conforms To","identifiers":["doc:\/\/Systems\/SK","doc:\/\/Systems\/Sl","doc:\/\/Systems\/Sk","doc:\/\/Systems\/s8SendableP","doc:\/\/Systems\/s16SendableMetatypeP","doc:\/\/Systems\/ST","doc:\/\/Systems\/documentation\/Systems\/SystemParameter"],"type":"conformsTo","kind":"relationships"}],"seeAlsoSections":[{"title":"System Parameters","anchor":"System-Parameters","identifiers":["doc:\/\/Systems\/documentation\/Systems\/SystemParameter","doc:\/\/Systems\/documentation\/Systems\/Update","doc:\/\/Systems\/documentation\/Systems\/ResourceReader","doc:\/\/Systems\/documentation\/Systems\/ResourceWriter","doc:\/\/Systems\/documentation\/Systems\/EventWriter","doc:\/\/Systems\/documentation\/Systems\/RemovedComponents"],"generated":true}],"primaryContentSections":[{"declarations":[{"tokens":[{"text":"@frozen","kind":"attribute"},{"text":" ","kind":"text"},{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"EventReader","kind":"identifier"},{"text":"<","kind":"text"},{"text":"E","kind":"genericParameter"},{"text":"> ","kind":"text"},{"text":"where","kind":"keyword"},{"text":" ","kind":"text"},{"text":"E","kind":"typeIdentifier"},{"text":" : ","kind":"text"},{"preciseIdentifier":"s:11WorldModule5EventP","text":"Event","kind":"typeIdentifier","identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/Event"}],"languages":["swift"],"platforms":["Linux"]}],"kind":"declarations"},{"content":[{"anchor":"overview","type":"heading","text":"Overview","level":2},{"inlineContent":[{"type":"text","text":"An event reader is a collection of the new events, oldest first. Each system type has its own"},{"type":"text","text":" "},{"type":"text","text":"place in the events, so it sees each event once however many other systems read them too. The"},{"type":"text","text":" "},{"type":"text","text":"following system applies each "},{"type":"codeVoice","code":"Damage"},{"type":"text","text":" event to the health of its target:"}],"type":"paragraph"},{"syntax":"swift","type":"codeListing","code":["@System","struct ApplyDamage {","    func run(_ damages: EventReader<Damage>, _ health: Update<Health>) {","        health { health, entity in","            for damage in damages where damage.target == entity {","                health.current -= damage.amount","            }","        }","    }","}","","var world = World()","let knight = world.spawn(Health(current: 30))","world.send(Damage(target: knight, amount: 12))","Schedule { ApplyDamage() }.run(on: &world)","print(world[Health.self, of: knight].current)","\/\/ Prints \"18\""]},{"inlineContent":[{"text":"A world keeps an event for the rest of the update it was sent in and all of the next; see","type":"text"},{"text":" ","type":"text"},{"identifier":"doc:\/\/Systems\/documentation\/Systems\/UpdateEvents","isActive":true,"type":"reference"},{"text":". A system that doesn’t run for longer than that misses the events dropped in","type":"text"},{"text":" ","type":"text"},{"text":"between.","type":"text"}],"type":"paragraph"}],"kind":"content"}],"sections":[],"kind":"symbol","variants":[{"paths":["\/documentation\/systems\/eventreader"],"traits":[{"interfaceLanguage":"swift"}]}],"topicSections":[{"title":"Instance Properties","anchor":"Instance-Properties","identifiers":["doc:\/\/Systems\/documentation\/Systems\/EventReader\/endIndex","doc:\/\/Systems\/documentation\/Systems\/EventReader\/events","doc:\/\/Systems\/documentation\/Systems\/EventReader\/startIndex"],"generated":true},{"title":"Subscripts","anchor":"Subscripts","identifiers":["doc:\/\/Systems\/documentation\/Systems\/EventReader\/subscript(_:)"],"generated":true},{"title":"Default Implementations","anchor":"Default-Implementations","identifiers":["doc:\/\/System