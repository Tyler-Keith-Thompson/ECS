typeIdentifier"}]}]},{"kind":"content","content":[{"anchor":"overview","level":2,"text":"Overview","type":"heading"},{"inlineContent":[{"type":"text","text":"An event reader is a collection of the new events, oldest first. Each system type has its own"},{"type":"text","text":" "},{"type":"text","text":"place in the events, so it sees each event once however many other systems read them too. The"},{"type":"text","text":" "},{"type":"text","text":"following system applies each "},{"type":"codeVoice","code":"Damage"},{"type":"text","text":" event to the health of its target:"}],"type":"paragraph"},{"syntax":"swift","type":"codeListing","code":["@System","struct ApplyDamage {","    func run(_ damages: EventReader<Damage>, _ health: Update<Health>) {","        health { health, entity in","            for damage in damages where damage.target == entity {","                health.current -= damage.amount","            }","        }","    }","}","","var world = World()","let knight = world.spawn(Health(current: 30))","world.send(Damage(target: knight, amount: 12))","Schedule { ApplyDamage() }.run(on: &world)","print(world[Health.self, of: knight].current)","\/\/ Prints \"18\""]},{"inlineContent":[{"type":"text","text":"A world keeps an event for the rest of the update it was sent in and all of the next; see"},{"type":"text","text":" "},{"identifier":"doc:\/\/Systems\/documentation\/Systems\/UpdateEvents","isActive":true,"type":"reference"},{"type":"text","text":". A system that doesn’t run for longer than that misses the events dropped in"},{"type":"text","text":" "},{"type":"text","text":"between."}],"type":"paragraph"}]}],"abstract":[{"type":"text","text":"A system parameter that reads the events of one type sent since the system last read them."}],"schemaVersion":{"major":0,"minor":3,"patch":0},"hierarchy":{"paths":[["doc:\/\/Systems\/documentation\/Systems"]]},"seeAlsoSections":[{"generated":true,"anchor":"System-Parameters","title":"System Parameters","identifiers":["d