{"schemaVersion":{"patch":0,"major":0,"minor":3},"relationshipsSections":[{"type":"conformsTo","title":"Conforms To","kind":"relationships","identifiers":["doc:\/\/Systems\/SK","doc:\/\/Systems\/Sl","doc:\/\/Systems\/Sk","doc:\/\/Systems\/s8SendableP","doc:\/\/Systems\/s16SendableMetatypeP","doc:\/\/Systems\/ST","doc:\/\/Systems\/documentation\/Systems\/SystemParameter"]}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/systems\/eventreader"]}],"primaryContentSections":[{"kind":"declarations","declarations":[{"platforms":["Linux"],"languages":["swift"],"tokens":[{"text":"@frozen","kind":"attribute"},{"text":" ","kind":"text"},{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"EventReader","kind":"identifier"},{"text":"<","kind":"text"},{"text":"E","kind":"genericParameter"},{"text":"> ","kind":"text"},{"text":"where","kind":"keyword"},{"text":" ","kind":"text"},{"text":"E","kind":"typeIdentifier"},{"text":" : ","kind":"text"},{"text":"Event","kind":"typeIdentifier","identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/Event","preciseIdentifier":"s:11WorldModule5EventP"}]}]},{"content":[{"level":2,"text":"Overview","type":"heading","anchor":"overview"},{"type":"paragraph","inlineContent":[{"text":"An event reader is a collection of the new events, oldest first. Each system type has its own","type":"text"},{"text":" ","type":"text"},{"text":"place in the events, so it sees each event once however many other systems read them too. The","type":"text"},{"text":" ","type":"text"},{"text":"following system applies each ","type":"text"},{"code":"Damage","type":"codeVoice"},{"text":" event to the health of its target:","type":"text"}]},{"type":"codeListing","syntax":"swift","code":["@System","struct ApplyDamage {","    func run(_ damages: EventReader<Damage>, _ health: Update<Health>) {","        health { health, entity in","            for damage in damages where damage.target == entity {","                health.current -= damage.amount","            }","        }","    }","}","","var world = World()","let knight = world.spawn(Health(current: 30))","world.send(Damage(target: knight, amount: 12))","Schedule { ApplyDamage() }.run(on: &world)","print(world[Health.self, of: knight].current)","\/\/ Prints \"18\""]},{"type":"paragraph","inlineContent":[{"type":"text","text":"A world keeps an event for the rest of the update it was sent in and all of the next; see"},{"type":"text","text":" "},{"identifier":"doc:\/\/Systems\/documentation\/Systems\/UpdateEvents","isActive":true,"type":"reference"},{"type":"text","text":". A system that doesn’t run for longer than that misses the events dropped in"},{"type":"text","text":" "},{"type":"text","text":"between."}]}],"kind":"content"}],"identifier":{"url":"doc:\/\/Systems\/documentation\/Systems\/EventReader","interfaceLanguage":"swift"},"kind":"symbol","topicSections":[{"generated":true,"anchor":"Instance-Properties","title":"Instance Properties","identifiers":["doc:\/\/Systems\/documentation\/Systems\/EventReader\/endIndex","doc:\/\/Systems\/documentation\/Systems\/EventReader\/events","doc:\/\/Systems\/documentation\/Systems\/EventReader\/startIndex"]},{"generated":true,"anchor":"Subscripts","title":"Subscripts","identifiers":["doc:\/\/Systems\/documentation\/Systems\/EventReader\/subscript(_:)"]},{"generated":true,"anchor":"Default-Implementations","title":"Default Implementations","identifiers":["doc:\/\/Systems\/documentation\/Systems\/EventReader\/BidirectionalCollection-Implementations","doc:\/\/Systems\/documentation\/Systems\/EventReader\/Collection-Implementations","doc:\/\/Systems\/documentation\/Systems\/EventReader\/RandomAccessCollection-Implementations","doc:\/\/Systems\/documentation\/Systems\/EventReader\/Sequence-Implementations"]}],"metadata":{"externalID":"s:7Systems11EventReaderV","role":"symbol","symbolKind":"struct","roleHeading":"Structure","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text