{"sections":[],"schemaVersion":{"minor":3,"major":0,"patch":0},"primaryContentSections":[{"kind":"declarations","declarations":[{"tokens":[{"kind":"attribute","text":"@frozen"},{"kind":"text","text":" "},{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"EventReader"},{"kind":"text","text":"<"},{"kind":"genericParameter","text":"E"},{"kind":"text","text":"> "},{"kind":"keyword","text":"where"},{"kind":"text","text":" "},{"kind":"typeIdentifier","text":"E"},{"kind":"text","text":" : "},{"kind":"typeIdentifier","preciseIdentifier":"s:11WorldModule5EventP","text":"Event","identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/Event"}],"platforms":["Linux"],"languages":["swift"]}]},{"content":[{"type":"heading","anchor":"overview","level":2,"text":"Overview"},{"type":"paragraph","inlineContent":[{"text":"An event reader is a collection of the new events, oldest first. Each system type has its own","type":"text"},{"text":" ","type":"text"},{"text":"place in the events, so it sees each event once however many other systems read them too. The","type":"text"},{"text":" ","type":"text"},{"text":"following system applies each ","type":"text"},{"type":"codeVoice","code":"Damage"},{"text":" event to the health of its target:","type":"text"}]},{"type":"codeListing","code":["@System","struct ApplyDamage {","    func run(_ damages: EventReader<Damage>, _ health: Update<Health>) {","        health { health, entity in","            for damage in damages where damage.target == entity {","                health.current -= damage.amount","            }","        }","    }","}","","var world = World()","let knight = world.spawn(Health(current: 30))","world.send(Damage(target: knight, amount: 12))","Schedule { ApplyDamage() }.run(on: &world)","print(world[Health.self, of: knight].current)","\/\/ Prints \"18\""],"syntax":"swift"},{"type":"paragraph","inlineContent":[{"text":"A world keeps an event for the rest of the update it was sent in and all of the next; see","type":"text"},{"text":" ","type":"text"},{"isActive":true,"identifier":"doc:\/\/Systems\/documentation\/Systems\/UpdateEvents","type":"reference"},{"text":". A system that doesn’t run for longer than that misses the events dropped in","type":"text"},{"text":" ","type":"text"},{"text":"between.","type":"text"}]}],"kind":"content"}],"topicSections":[{"anchor":"Instance-Properties","identifiers":["doc:\/\/Systems\/documentation\/Systems\/EventReader\/endIndex","doc:\/\/Systems\/documentation\/Systems\/EventReader\/events","doc:\/\/Systems\/documentation\/Systems\/EventReader\/startIndex"],"generated":true,"title":"Instance Properties"},{"anchor":"Subscripts","identifiers":["doc:\/\/Systems\/documentation\/Systems\/EventReader\/subscript(_:)"],"generated":true,"title":"Subscripts"},{"anchor":"Default-Implementations","identifiers":["doc:\/\/Systems\/documentation\/Systems\/EventReader\/BidirectionalCollection-Implementations","doc:\/\/Systems\/documentation\/Systems\/EventReader\/Collection-Implementations","doc:\/\/Systems\/documentation\/Systems\/EventReader\/RandomAccessCollection-Implementations","doc:\/\/Systems\/documentation\/Systems\/EventReader\/Sequence-Implementations"],"generated":true,"title":"Default Implementations"}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/systems\/eventreader"]}],"identifier":{"url":"doc:\/\/Systems\/documentation\/Systems\/EventReader","interfaceLanguage":"swift"},"metadata":{"roleHeading":"Structure","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"EventReader"}],"remoteSource":{"url":"https:\/\/github.com\/Tyler-Keith-Thompson\/ECS\/blob\/main\/Sources\/Systems\/SystemParameters.swift#L236","fileName":"SystemParameters.swift"},"symbolKind":"struct","title":"EventReader","role":"symbol","navigatorTitle":[{"kind":"identifier","text":"EventReader"}],"modules":[{"name":"Systems"}],"externalID":"s:7Systems11EventReaderV"