 ApplyDamage {","    func run(_ damages: EventReader<Damage>, _ health: Update<Health>) {","        health { health, entity in","            for damage in damages where damage.target == entity {","                health.current -= damage.amount","            }","        }","    }","}","","var world = World()","let knight = world.spawn(Health(current: 30))","world.send(Damage(target: knight, amount: 12))","Schedule { ApplyDamage() }.run(on: &world)","print(world[Health.self, of: knight].current)","\/\/ Prints \"18\""]},{"type":"paragraph","inlineContent":[{"type":"text","text":"A world keeps an event for the rest of the update it was sent in and all of the next; see"},{"type":"text","text":" "},{"type":"reference","isActive":true,"identifier":"doc:\/\/Systems\/documentation\/Systems\/UpdateEvents"},{"type":"text","text":". A system that doesn’t run for longer than that misses the events dropped in"},{"type":"text","text":" "},{"type":"text","text":"between."}]}],"kind":"content"}],"references":{"doc://Systems/documentation/Systems":{"title":"Systems","kind":"symbol","type":"topic","role":"collection","url":"\/documentation\/systems","identifier":"doc:\/\/Systems\/documentation\/Systems","abstract":[{"text":"Declare the rules of a simulation as systems, and run them on a world in a schedule.","type":"text"}]},"doc://Systems/documentation/Systems/EventReader/endIndex":{"type":"topic","url":"\/documentation\/systems\/eventreader\/endindex","kind":"symbol","abstract":[],"role":"symbol","fragments":[{"kind":"keyword","text":"var"},{"kind":"text","text":" "},{"kind":"identifier","text":"endIndex"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:Si","text":"Int"}],"title":"endIndex","identifier":"doc:\/\/Systems\/documentation\/Systems\/EventReader\/endIndex"},"doc://Systems/Sl":{"title":"Swift.Collection","type":"unresolvable","identifier":"doc:\/\/Systems\/Sl"},"doc://Systems/documentation/Systems/EventReader/startIndex":{"identifier":"doc:\/\/