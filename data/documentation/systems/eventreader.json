mage>, _ health: Update<Health>) {","        health { health, entity in","            for damage in damages where damage.target == entity {","                health.current -= damage.amount","            }","        }","    }","}","","var world = World()","let knight = world.spawn(Health(current: 30))","world.send(Damage(target: knight, amount: 12))","Schedule { ApplyDamage() }.run(on: &world)","print(world[Health.self, of: knight].current)","\/\/ Prints \"18\""],"syntax":"swift","type":"codeListing"},{"type":"paragraph","inlineContent":[{"type":"text","text":"A world keeps an event for the rest of the update it was sent in and all of the next; see"},{"type":"text","text":" "},{"type":"reference","identifier":"doc:\/\/Systems\/documentation\/Systems\/UpdateEvents","isActive":true},{"type":"text","text":". A system that doesn’t run for longer than that misses the events dropped in"},{"type":"text","text":" "},{"type":"text","text":"between."}]}]}],"variants":[{"paths":["\/documentation\/systems\/eventreader"],"traits":[{"interfaceLanguage":"swift"}]}],"metadata":{"remoteSource":{"url":"https:\/\/github.com\/Tyler-Keith-Thompson\/ECS\/blob\/main\/Sources\/Systems\/SystemParameters.swift#L236","fileName":"SystemParameters.swift"},"navigatorTitle":[{"text":"EventReader","kind":"identifier"}],"title":"EventReader","externalID":"s:7Systems11EventReaderV","role":"symbol","modules":[{"name":"Systems"}],"symbolKind":"struct","roleHeading":"Structure","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"EventReader","kind":"identifier"}]},"schemaVersion":{"minor":3,"patch":0,"major":0},"identifier":{"url":"doc:\/\/Systems\/documentation\/Systems\/EventReader","interfaceLanguage":"swift"},"topicSections":[{"title":"Instance Properties","identifiers":["doc:\/\/Systems\/documentation\/Systems\/EventReader\/endIndex","doc:\/\/Systems\/documentation\/Systems\/EventReader\/events","doc:\/\/Systems\/documentation\/Systems\/EventReader\/startIndex"],"ge