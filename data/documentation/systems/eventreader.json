est first. Each system type has its own"},{"type":"text","text":" "},{"type":"text","text":"place in the events, so it sees each event once however many other systems read them too. The"},{"type":"text","text":" "},{"type":"text","text":"following system applies each "},{"code":"Damage","type":"codeVoice"},{"type":"text","text":" event to the health of its target:"}]},{"type":"codeListing","code":["@System","struct ApplyDamage {","    func run(_ damages: EventReader<Damage>, _ health: Update<Health>) {","        health { health, entity in","            for damage in damages where damage.target == entity {","                health.current -= damage.amount","            }","        }","    }","}","","var world = World()","let knight = world.spawn(Health(current: 30))","world.send(Damage(target: knight, amount: 12))","Schedule { ApplyDamage() }.run(on: &world)","print(world[Health.self, of: knight].current)","\/\/ Prints \"18\""],"syntax":"swift"},{"type":"paragraph","inlineContent":[{"text":"A world keeps an event for the rest of the update it was sent in and all of the next; see","type":"text"},{"text":" ","type":"text"},{"type":"reference","isActive":true,"identifier":"doc:\/\/Systems\/documentation\/Systems\/UpdateEvents"},{"text":". A system that doesn’t run for longer than that misses the events dropped in","type":"text"},{"text":" ","type":"text"},{"text":"between.","type":"text"}]}]}],"relationshipsSections":[{"title":"Conforms To","kind":"relationships","type":"conformsTo","identifiers":["doc:\/\/Systems\/SK","doc:\/\/Systems\/Sl","doc:\/\/Systems\/Sk","doc:\/\/Systems\/s8SendableP","doc:\/\/Systems\/s16SendableMetatypeP","doc:\/\/Systems\/ST","doc:\/\/Systems\/documentation\/Systems\/SystemParameter"]}],"identifier":{"url":"doc:\/\/Systems\/documentation\/Systems\/EventReader","interfaceLanguage":"swift"},"abstract":[{"text":"A system parameter that reads the events of one type sent since the system last read them.","type":"text"}],"topicSections":[{"title":"