oc:\/\/WorldModule\/documentation\/WorldModule\/Event","kind":"typeIdentifier","text":"Event"}],"languages":["swift"]}]},{"content":[{"type":"heading","level":2,"text":"Overview","anchor":"overview"},{"type":"paragraph","inlineContent":[{"type":"text","text":"An event reader is a collection of the new events, oldest first. Each system type has its own"},{"type":"text","text":" "},{"type":"text","text":"place in the events, so it sees each event once however many other systems read them too. The"},{"type":"text","text":" "},{"type":"text","text":"following system applies each "},{"type":"codeVoice","code":"Damage"},{"type":"text","text":" event to the health of its target:"}]},{"type":"codeListing","syntax":"swift","code":["@System","struct ApplyDamage {","    func run(_ damages: EventReader<Damage>, _ health: Update<Health>) {","        health { health, entity in","            for damage in damages where damage.target == entity {","                health.current -= damage.amount","            }","        }","    }","}","","var world = World()","let knight = world.spawn(Health(current: 30))","world.send(Damage(target: knight, amount: 12))","Schedule { ApplyDamage() }.run(on: &world)","print(world[Health.self, of: knight].current)","\/\/ Prints \"18\""]},{"type":"paragraph","inlineContent":[{"type":"text","text":"A world keeps an event for the rest of the update it was sent in and all of the next; see"},{"type":"text","text":" "},{"type":"reference","isActive":true,"identifier":"doc:\/\/Systems\/documentation\/Systems\/UpdateEvents"},{"type":"text","text":". A system that doesn’t run for longer than that misses the events dropped in"},{"type":"text","text":" "},{"type":"text","text":"between."}]}],"kind":"content"}],"seeAlsoSections":[{"title":"System Parameters","identifiers":["doc:\/\/Systems\/documentation\/Systems\/SystemParameter","doc:\/\/Systems\/documentation\/Systems\/Update","doc:\/\/Systems\/documentation\/Systems\/ResourceReader","doc:\/\/Systems\/document