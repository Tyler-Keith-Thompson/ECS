he new events, oldest first. Each system type has its own","type":"text"},{"text":" ","type":"text"},{"text":"place in the events, so it sees each event once however many other systems read them too. The","type":"text"},{"text":" ","type":"text"},{"text":"following system applies each ","type":"text"},{"code":"Damage","type":"codeVoice"},{"text":" event to the health of its target:","type":"text"}],"type":"paragraph"},{"type":"codeListing","code":["@System","struct ApplyDamage {","    func run(_ damages: EventReader<Damage>, _ health: Update<Health>) {","        health { health, entity in","            for damage in damages where damage.target == entity {","                health.current -= damage.amount","            }","        }","    }","}","","var world = World()","let knight = world.spawn(Health(current: 30))","world.send(Damage(target: knight, amount: 12))","Schedule { ApplyDamage() }.run(on: &world)","print(world[Health.self, of: knight].current)","\/\/ Prints \"18\""],"syntax":"swift"},{"inlineContent":[{"text":"A world keeps an event for the rest of the update it was sent in and all of the next; see","type":"text"},{"text":" ","type":"text"},{"type":"reference","identifier":"doc:\/\/Systems\/documentation\/Systems\/UpdateEvents","isActive":true},{"text":". A system that doesn’t run for longer than that misses the events dropped in","type":"text"},{"text":" ","type":"text"},{"text":"between.","type":"text"}],"type":"paragraph"}]}],"sections":[],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/Systems\/documentation\/Systems\/EventReader"},"kind":"symbol","relationshipsSections":[{"identifiers":["doc:\/\/Systems\/SK","doc:\/\/Systems\/Sl","doc:\/\/Systems\/Sk","doc:\/\/Systems\/s8SendableP","doc:\/\/Systems\/s16SendableMetatypeP","doc:\/\/Systems\/ST","doc:\/\/Systems\/documentation\/Systems\/SystemParameter"],"type":"conformsTo","kind":"relationships","title":"Conforms To"}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documenta