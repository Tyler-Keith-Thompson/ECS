{"primaryContentSections":[{"kind":"declarations","declarations":[{"platforms":["Linux"],"languages":["swift"],"tokens":[{"kind":"attribute","text":"@attached"},{"kind":"text","text":"(extension, conformances: "},{"preciseIdentifier":"s:7Systems6SystemP","identifier":"doc:\/\/Systems\/documentation\/Systems\/System","kind":"typeIdentifier","text":"System"},{"kind":"text","text":", "},{"preciseIdentifier":"s:7Systems15MainActorSystemP","identifier":"doc:\/\/Systems\/documentation\/Systems\/MainActorSystem","kind":"typeIdentifier","text":"MainActorSystem"},{"kind":"text","text":", names: named(access), named(run), named(initialize)) "},{"kind":"keyword","text":"macro"},{"kind":"text","text":" "},{"kind":"identifier","text":"System"},{"kind":"text","text":"()"}]}]},{"kind":"content","content":[{"text":"Overview","type":"heading","anchor":"overview","level":2},{"type":"paragraph","inlineContent":[{"text":"Attach ","type":"text"},{"type":"codeVoice","code":"@System"},{"text":" to a structure with a method named ","type":"text"},{"type":"codeVoice","code":"run"},{"text":". The method’s parameters are","type":"text"},{"text":" ","type":"text"},{"text":"system parameters, values the schedule fetches from the world before each run, and their","type":"text"},{"text":" ","type":"text"},{"text":"types state exactly what the system reads and writes. The macro conforms the type to","type":"text"},{"text":" ","type":"text"},{"isActive":true,"identifier":"doc:\/\/Systems\/documentation\/Systems\/System","type":"reference"},{"text":", writing its ","type":"text"},{"isActive":true,"identifier":"doc:\/\/Systems\/documentation\/Systems\/System\/access","type":"reference"},{"text":" from those types and a ","type":"text"},{"isActive":true,"identifier":"doc:\/\/Systems\/documentation\/Systems\/System\/run(in:)","type":"reference"},{"text":" that","type":"text"},{"text":" ","type":"text"},{"text":"fetches the parameters and calls your method.","type":"text"}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"The following system moves each entity by its velocity plus whichever of a wind and a"},{"type":"text","text":" "},{"type":"text","text":"current act on it, scaled by the time step:"}]},{"syntax":"swift","type":"codeListing","code":["struct Wind: Component { var speed: Double }","struct Current: Component { var speed: Double }","","@System","struct Drift {","    func run(","        _ drifters: Update<Position>.Over<Velocity, AnyOf<Wind, Current>>,","        _ step: ResourceReader<TimeStep>","    ) {","        drifters { position, row in","            let (velocity, (wind, current)) = row.components","            let push = (wind?.speed ?? 0) + (current?.speed ?? 0)","            position.x += (velocity.dx + push) * step.value.seconds","        }","    }","}","","var world = World()","world.resources.insert(TimeStep(seconds: 0.5))","let boat = world.spawn(Position(x: 0, y: 0), Velocity(dx: 2, dy: 0), Wind(speed: 4))","Schedule { Drift() }.run(on: &world)","print(world[Position.self, of: boat].x)","\/\/ Prints \"3.0\""]},{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"Drift"},{"text":" writes ","type":"text"},{"type":"codeVoice","code":"Position"},{"text":", reads ","type":"text"},{"type":"codeVoice","code":"Velocity"},{"text":", ","type":"text"},{"type":"codeVoice","code":"Wind"},{"text":", ","type":"text"},{"type":"codeVoice","code":"Current"},{"text":" and the ","type":"text"},{"type":"codeVoice","code":"TimeStep"},{"text":" resource,","type":"text"},{"text":" ","type":"text"},{"text":"and nothing else, so a schedule runs it at the same time as any system that doesn’t write","type":"text"},{"text":" ","type":"text"},{"text":"those types.","type":"text"}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"These are the parameter types a "},{"type":"codeVoice","code":"run"},{"type":"text","text":" method can take:"}]},{"items":[{"term":{"inlineContent":[{"identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/Query","isActive":true,"type":"reference"},{"text":" and ","type":"text"},{"identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/Query\/Where","isActive":true,"type":"reference"}]},"definition":{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Reads components."}]}]}},{"term":{"inlineContent":[{"identifier":"doc:\/\/Systems\/documentation\/Systems\/Update","type":"reference","isActive":true}]},"definition":{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Writes components, optionally reading others."}]}]}},{"term":{"inlineContent":[{"isActive":true,"identifier":"doc:\/\/Systems\/documentation\/Systems\/ResourceReader","type":"reference"},{"text":" and ","type":"text"},{"isActive":true,"identifier":"doc:\/\/Systems\/documentation\/Systems\/ResourceWriter","type":"reference"}]},"definition":{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Read or write a resource."}]}]}},{"term":{"inlineContent":[{"isActive":true,"type":"reference","identifier":"doc:\/\/Systems\/documentation\/Systems\/EventReader"},{"type":"text","text":" and "},{"isActive":true,"type":"reference","identifier":"doc:\/\/Systems\/documentation\/Systems\/EventWriter"}]},"definition":{"content":[{"inlineContent":[{"text":"Read or send events.","type":"text"}],"type":"paragraph"}]}},{"term":{"inlineContent":[{"identifier":"doc:\/\/Systems\/documentation\/Systems\/RemovedComponents","isActive":true,"type":"reference"}]},"definition":{"content":[{"type":"paragraph","inlineContent":[{"text":"Lists the entities that lost a component.","type":"text"}]}]}},{"term":{"inlineContent":[{"code":"inout","type":"codeVoice"},{"text":" ","type":"text"},{"identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/Commands","isActive":true,"type":"reference"}]},"definition":{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Queues structural changes, which apply at the end of the system’s wave and conflict with nothing."}]}]}}],"type":"termList"},{"type":"paragraph","inlineContent":[{"text":"A ","type":"text"},{"type":"codeVoice","code":"run"},{"text":" method that takes the world instead, as ","type":"text"},{"type":"codeVoice","code":"inout World"},{"text":", makes a system with no access,","type":"text"},{"text":" ","type":"text"},{"text":"which can change anything and so runs alone:","type":"text"}]},{"syntax":"swift","type":"codeListing","code":["@System","struct SpawnBall {","    func run(in world: inout World) {","        world.spawn(Position(x: 0, y: 100), Velocity(dx: 0, dy: 0))","    }","}","","var world = World()","Schedule { SpawnBall() }.run(on: &world)","print(world.count)","\/\/ Prints \"1\""]},{"type":"paragraph","inlineContent":[{"text":"Mark the type or its ","type":"text"},{"code":"run","type":"codeVoice"},{"text":" method ","type":"text"},{"code":"@MainActor","type":"codeVoice"},{"text":" to make a ","type":"text"},{"identifier":"doc:\/\/Systems\/documentation\/Systems\/MainActorSystem","isActive":true,"type":"reference"},{"text":" instead.","type":"text"}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"The macro reads only the method’s signature. Two parameters whose written types conflict,"},{"type":"text","text":" "},{"type":"text","text":"such as an "},{"type":"codeVoice","code":"Update<Position>"},{"type":"text","text":" and a "},{"type":"codeVoice","code":"Query<Position>"},{"type":"text","text":", are a compile-time error. A conflict the"},{"type":"text","text":" "},{"type":"text","text":"written types hide, such as one type spelled through a type alias, traps when the system is"},{"type":"text","text":" "},{"type":"text","text":"scheduled."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"The code the macro generates refers to "},{"type":"codeVoice","code":"World"},{"type":"text","text":", "},{"type":"codeVoice","code":"Access"},{"type":"text","text":" and "},{"type":"codeVoice","code":"Commands"},{"type":"text","text":", so the file must"},{"type":"text","text":" "},{"type":"text","text":"import "},{"type":"codeVoice","code":"ECS"},{"type":"text","text":", or both "},{"type":"codeVoice","code":"WorldModule"},{"type":"text","text":" and "},{"type":"codeVoice","code":"Systems"},{"type":"text","text":"."}]}]}],"kind":"symbol","variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/systems\/system()"]}],"hierarchy":{"paths":[["doc:\/\/Systems\/documentation\/Systems"]]},"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/Systems\/documentation\/Systems\/System()"},"sections":[],"seeAlsoSections":[{"identifiers":["doc:\/\/Systems\/documentation\/Systems\/DeclaringSystems","doc:\/\/Systems\/documentation\/Systems\/DrivingAWorldFromAnApp","doc:\/\/Systems\/documentation\/Systems\/System"],"generated":true,"title":"Essentials","anchor":"Essentials"}],"metadata":{"roleHeading":"Macro","fragments":[{"kind":"keyword","text":"macro"},{"kind":"text","text":" "},{"kind":"identifier","text":"System"},{"kind":"text","text":"()"}],"role":"symbol","title":"System()","symbolKind":"macro","remoteSource":{"fileName":"SystemMacro.swift","url":"https:\/\/github.com\/Tyler-Keith-Thompson\/ECS\/blob\/main\/Sources\/Systems\/SystemMacro.swift#L81"},"externalID":"s:7Systems6Systemyycfm","modules":[{"name":"Systems"}]},"schemaVersion":{"major":0,"minor":3,"patch":0},"abstract":[{"text":"Makes a type a system whose access comes from the parameters of its ","type":"text"},{"code":"run","type":"codeVoice"},{"text":" method.","type":"text"}],"references":{"doc://Systems/documentation/Systems/DeclaringSystems":{"url":"\/documentation\/systems\/declaringsystems","title":"Declaring Systems","type":"topic","abstract":[{"text":"Write the rules of a simulation as systems, and let their parameters state what they read and","type":"text"},{"text":" ","type":"text"},{"text":"write.","type":"text"}],"kind":"article","role":"collectionGroup","identifier":"doc:\/\/Systems\/documentation\/System