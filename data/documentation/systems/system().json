{"abstract":[{"type":"text","text":"Makes a type a system whose access comes from the parameters of its "},{"code":"run","type":"codeVoice"},{"type":"text","text":" method."}],"hierarchy":{"paths":[["doc:\/\/Systems\/documentation\/Systems"]]},"metadata":{"title":"System()","symbolKind":"macro","externalID":"s:7Systems6Systemyycfm","remoteSource":{"url":"https:\/\/github.com\/Tyler-Keith-Thompson\/ECS\/blob\/main\/Sources\/Systems\/SystemMacro.swift#L81","fileName":"SystemMacro.swift"},"roleHeading":"Macro","fragments":[{"text":"macro","kind":"keyword"},{"text":" ","kind":"text"},{"kind":"identifier","text":"System"},{"kind":"text","text":"()"}],"role":"symbol","modules":[{"name":"Systems"}]},"primaryContentSections":[{"kind":"declarations","declarations":[{"tokens":[{"text":"@attached","kind":"attribute"},{"text":"(extension, conformances: ","kind":"text"},{"text":"System","preciseIdentifier":"s:7Systems6SystemP","kind":"typeIdentifier","identifier":"doc:\/\/Systems\/documentation\/Systems\/System"},{"text":", ","kind":"text"},{"text":"MainActorSystem","preciseIdentifier":"s:7Systems15MainActorSystemP","kind":"typeIdentifier","identifier":"doc:\/\/Systems\/documentation\/Systems\/MainActorSystem"},{"text":", names: named(access), named(run), named(initialize)) ","kind":"text"},{"text":"macro","kind":"keyword"},{"text":" ","kind":"text"},{"text":"System","kind":"identifier"},{"text":"()","kind":"text"}],"languages":["swift"],"platforms":["Linux"]}]},{"kind":"content","content":[{"text":"Overview","level":2,"anchor":"overview","type":"heading"},{"inlineContent":[{"type":"text","text":"Attach "},{"code":"@System","type":"codeVoice"},{"type":"text","text":" to a structure with a method named "},{"code":"run","type":"codeVoice"},{"type":"text","text":". The method’s parameters are"},{"type":"text","text":" "},{"type":"text","text":"system parameters, values the schedule fetches from the world before each run, and their"},{"type":"text","text":" "},{"type":"text","text":"types state exactly what the system reads and writes. The macro conforms the type to"},{"type":"text","text":" "},{"type":"reference","identifier":"doc:\/\/Systems\/documentation\/Systems\/System","isActive":true},{"type":"text","text":", writing its "},{"type":"reference","identifier":"doc:\/\/Systems\/documentation\/Systems\/System\/access","isActive":true},{"type":"text","text":" from those types and a "},{"type":"reference","identifier":"doc:\/\/Systems\/documentation\/Systems\/System\/run(in:)","isActive":true},{"type":"text","text":" that"},{"type":"text","text":" "},{"type":"text","text":"fetches the parameters and calls your method."}],"type":"paragraph"},{"inlineContent":[{"text":"The following system moves each entity by its velocity plus whichever of a wind and a","type":"text"},{"text":" ","type":"text"},{"text":"current act on it, scaled by the time step:","type":"text"}],"type":"paragraph"},{"syntax":"swift","type":"codeListing","code":["struct Wind: Component { var speed: Double }","struct Current: Component { var speed: Double }","","@System","struct Drift {","    func run(","        _ drifters: Update<Position>.Over<Velocity, AnyOf<Wind, Current>>,","        _ step: ResourceReader<TimeStep>","    ) {","        drifters { position, row in","            let (velocity, (wind, current)) = row.components","            let push = (wind?.speed ?? 0) + (current?.speed ?? 0)","            position.x += (velocity.dx + push) * step.value.seconds","        }","    }","}","","var world = World()","world.resources.insert(TimeStep(seconds: 0.5))","let boat = world.spawn(Position(x: 0, y: 0), Velocity(dx: 2, dy: 0), Wind(speed: 4))","Schedule { Drift() }.run(on: &world)","print(world[Position.self, of: boat].x)","\/\/ Prints \"3.0\""]},{"inlineContent":[{"code":"Drift","type":"codeVoice"},{"type":"text","text":" writes "},{"code":"Position","type":"codeVoice"},{"type":"text","text":", reads "},{"code":"Velocity","type":"codeVoice"},{"type":"text","text":", "},{"code":"Wind","type":"codeVoice"},{"type":"text","text":", "},{"code":"Current","type":"codeVoice"},{"type":"text","text":" and the "},{"code":"TimeStep","type":"codeVoice"},{"type":"text","text":" resource,"},{"type":"text","text":" "},{"type":"text","text":"and nothing else, so a schedule runs it at the same time as any system that doesn’t write"},{"type":"text","text":" "},{"type":"text","text":"those types."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"These are the parameter types a "},{"type":"codeVoice","code":"run"},{"type":"text","text":" method can take:"}],"type":"paragraph"},{"items":[{"term":{"inlineContent":[{"type":"reference","isActive":true,"identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/Query"},{"type":"text","text":" and "},{"type":"reference","isActive":true,"identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/Query\/Where"}]},"definition":{"content":[{"inlineContent":[{"text":"Reads components.","type":"text"}],"type":"paragraph"}]}},{"term":{"inlineContent":[{"identifier":"doc:\/\/Systems\/documentation\/Systems\/Update","isActive":true,"type":"reference"}]},"definition":{"content":[{"inlineContent":[{"text":"Writes components, optionally reading others.","type":"text"}],"type":"paragraph"}]}},{"term":{"inlineContent":[{"isActive":true,"identifier":"doc:\/\/Systems\/documentation\/Systems\/ResourceReader","type":"reference"},{"type":"text","text":" and "},{"isActive":true,"identifier":"doc:\/\/Systems\/documentation\/Systems\/ResourceWriter","type":"reference"}]},"definition":{"content":[{"inlineContent":[{"text":"Read or write a resource.","type":"text"}],"type":"paragraph"}]}},{"term":{"inlineContent":[{"identifier":"doc:\/\/Systems\/documentation\/Systems\/EventReader","type":"reference","isActive":true},{"type":"text","text":" and "},{"identifier":"doc:\/\/Systems\/documentation\/Systems\/EventWriter","type":"reference","isActive":true}]},"definition":{"content":[{"inlineContent":[{"type":"text","text":"Read or send events."}],"type":"paragraph"}]}},{"term":{"inlineContent":[{"identifier":"doc:\/\/Systems\/documentation\/Systems\/RemovedComponents","type":"reference","isActive":true}]},"definition":{"content":[{"inlineContent":[{"text":"Lists the entities that lost a component.","type":"text"}],"type":"paragraph"}]}},{"term":{"inlineContent":[{"code":"inout","type":"codeVoice"},{"text":" ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/Commands"}]},"definition":{"content":[{"type":"paragraph","inlineContent":[{"text":"Queues structural changes, which apply at the end of the system’s wave and conflict with nothing.","type":"text"}]}]}}],"type":"termList"},{"inlineContent":[{"type":"text","text":"A "},{"code":"run","type":"codeVoice"},{"type":"text","text":" method that takes the world instead, as "},{"code":"inout World","type":"codeVoice"},{"type":"text","text":", makes a system with no access,"},{"type":"text","text":" "},{"type":"text","text":"which can change anything and so runs alone:"}],"type":"paragraph"},{"syntax":"swift","type":"codeListing","code":["@System","struct SpawnBall {","    func run(in world: inout World) {","        world.spawn(Position(x: 0, y: 100), Velocity(dx: 0, dy: 0))","    }","}","","var world = World()","Schedule { SpawnBall() }.run(on: &world)","print(world.count)","\/\/ Prints \"1\""]},{"inlineContent":[{"type":"text","text":"Mark the type or its "},{"type":"codeVoice","code":"run"},{"type":"text","text":" method "},{"type":"codeVoice","code":"@MainActor"},{"type":"text","text":" to make a "},{"type":"reference","isActive":true,"identifier":"doc:\/\/Systems\/documentation\/Systems\/MainActorSystem"},{"type":"text","text":" instead."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"The macro reads only the method’s signature. Two parameters whose written types conflict,"},{"type":"text","text":" "},{"type":"text","text":"such as an "},{"type":"codeVoice","code":"Update<Position>"},{"type":"text","text":" and a "},{"type":"codeVoice","code":"Query<Position>"},{"type":"text","text":", are a compile-time error. A conflict the"},{"type":"text","text":" "},{"type":"text","text":"written types hide, such as one type spelled through a type alias, traps when the system is"},{"type":"text","text":" "},{"type":"text","text":"scheduled."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"The code the macro generates refers to "},{"code":"World","type":"codeVoice"},{"type":"text","text":", "},{"code":"Access","type":"codeVoice"},{"type":"text","text":" and "},{"code":"Commands","type":"codeVoice"},{"type":"text","text":", so the file must"},{"type":"text","text":" "},{"type":"text","text":"import "},{"code":"ECS","type":"codeVoice"},{"type":"text","text":", or both "},{"code":"WorldModule","type":"codeVoice"},{"type":"text","text":" and "},{"code":"Systems","type":"codeVoice"},{"type":"text","text":"."}],"type":"paragraph"}]}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/systems\/system()"]}],"schemaVersion":{"major":0,"patch":0,"minor":3},"identifier":{"url":"doc:\/\/Systems\/documentation\/Systems\/System()","interfaceLanguage":"swift"},"sections":[],"kind":"symbol","seeAlsoSections":[{"identifiers":["doc:\/\/Systems\/documentation\/Systems\/DeclaringSystems","doc:\/\/Systems\/documentation\/Systems\/DrivingAWorldFromAnApp","doc:\/\/Systems\/documentation\/Systems\/System"],"title":"Essentials","generated":true,"anchor":"Essentials"}],"references":{"doc://Systems/documentation/Systems/EventReader":{"kind":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"EventReader","kind":"identifier"}],"role":"symbol","navigatorTitle":[{"text":"EventReader","kind":"identifier"}],"url":"\/documentation\/systems\/eventreader","identifier":"doc:\/\/Systems\/documentation\/Systems\/EventReader","type":"topic","abstract":[{"text":"A system parameter th