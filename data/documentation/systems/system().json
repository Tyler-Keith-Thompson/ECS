tation/Systems/ResourceWriter":{"fragments":[{"kind":"keyword","text":"class"},{"kind":"text","text":" "},{"kind":"identifier","text":"ResourceWriter"}],"type":"topic","abstract":[{"text":"A system parameter that reads and writes a resource.","type":"text"}],"identifier":"doc:\/\/Systems\/documentation\/Systems\/ResourceWriter","kind":"symbol","title":"ResourceWriter","navigatorTitle":[{"kind":"identifier","text":"ResourceWriter"}],"url":"\/documentation\/systems\/resourcewriter","role":"symbol"},"doc://Systems/documentation/Systems/DrivingAWorldFromAnApp":{"kind":"article","role":"article","url":"\/documentation\/systems\/drivingaworldfromanapp","identifier":"doc:\/\/Systems\/documentation\/Systems\/DrivingAWorldFromAnApp","type":"topic","abstract":[{"text":"Hold a world in your app or game engine, feed it each frame’s input, and let the objects outside","type":"text"},{"text":" ","type":"text"},{"text":"it read results and take part in a step.","type":"text"}],"title":"Driving a World from an App"},"doc://Systems/documentation/Systems/System/access":{"title":"access","required":true,"url":"\/documentation\/systems\/system\/access","abstract":[{"type":"text","text":"The component, resource and event types the system reads and writes, or "},{"code":"nil","type":"codeVoice"},{"type":"text","text":" if it may"},{"type":"text","text":" "},{"type":"text","text":"change anything."}],"identifier":"doc:\/\/Systems\/documentation\/Systems\/System\/access","role":"symbol","fragments":[{"text":"var","kind":"keyword"},{"text":" ","kind":"text"},{"text":"access","kind":"identifier"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:11WorldModule6AccessV","text":"Access","kind":"typeIdentifier"},{"text":"?","kind":"text"}],"type":"topic","kind":"symbol","defaultImplementations":1},"doc://Systems/documentation/Systems/System/run(in:)":{"role":"symbol","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"run"},{"kind":"text","text