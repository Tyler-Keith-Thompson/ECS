/commands","abstract":[{"text":"A buffer of changes to a world, recorded now and applied later in the order they were","type":"text"},{"text":" ","type":"text"},{"text":"recorded.","type":"text"}],"kind":"symbol","role":"symbol","title":"Commands"},"doc://Systems/documentation/Systems/MainActorSystem":{"fragments":[{"kind":"keyword","text":"protocol"},{"kind":"text","text":" "},{"kind":"identifier","text":"MainActorSystem"}],"type":"topic","abstract":[{"type":"text","text":"A system that runs on the main actor, for work that touches main-actor state such as a user"},{"type":"text","text":" "},{"type":"text","text":"interface."}],"identifier":"doc:\/\/Systems\/documentation\/Systems\/MainActorSystem","kind":"symbol","title":"MainActorSystem","navigatorTitle":[{"kind":"identifier","text":"MainActorSystem"}],"url":"\/documentation\/systems\/mainactorsystem","role":"symbol"}}}