ts to read from each.","type":"text"}],"role":"symbol","navigatorTitle":[{"text":"Query","kind":"identifier"}],"url":"\/documentation\/worldmodule\/query","kind":"symbol"},"doc://Systems/documentation/Systems/System/run(in:)":{"url":"\/documentation\/systems\/system\/run(in:)","identifier":"doc:\/\/Systems\/documentation\/Systems\/System\/run(in:)","type":"topic","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"run"},{"kind":"text","text":"("},{"kind":"externalParam","text":"in"},{"kind":"text","text":": "},{"kind":"keyword","text":"inout"},{"kind":"text","text":" "},{"kind":"typeIdentifier","preciseIdentifier":"s:11WorldModule0A0V","text":"World"},{"kind":"text","text":")"}],"abstract":[{"text":"Runs the system’s rule once on a world.","type":"text"}],"role":"symbol","required":true,"kind":"symbol","title":"run(in:)"}}}