he system is"},{"type":"text","text":" "},{"type":"text","text":"scheduled."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"The code the macro generates refers to "},{"type":"codeVoice","code":"World"},{"type":"text","text":", "},{"type":"codeVoice","code":"Access"},{"type":"text","text":" and "},{"type":"codeVoice","code":"Commands"},{"type":"text","text":", so the file must"},{"type":"text","text":" "},{"type":"text","text":"import "},{"type":"codeVoice","code":"ECS"},{"type":"text","text":", or both "},{"type":"codeVoice","code":"WorldModule"},{"type":"text","text":" and "},{"type":"codeVoice","code":"Systems"},{"type":"text","text":"."}]}],"kind":"content"}],"hierarchy":{"paths":[["doc:\/\/Systems\/documentation\/Systems"]]},"abstract":[{"type":"text","text":"Makes a type a system whose access comes from the parameters of its "},{"type":"codeVoice","code":"run"},{"type":"text","text":" method."}],"schemaVersion":{"major":0,"minor":3,"patch":0},"metadata":{"roleHeading":"Macro","title":"System()","symbolKind":"macro","externalID":"s:7Systems6Systemyycfm","fragments":[{"text":"macro","kind":"keyword"},{"text":" ","kind":"text"},{"text":"System","kind":"identifier"},{"text":"()","kind":"text"}],"modules":[{"name":"Systems"}],"remoteSource":{"fileName":"SystemMacro.swift","url":"https:\/\/github.com\/Tyler-Keith-Thompson\/ECS\/blob\/main\/Sources\/Systems\/SystemMacro.swift#L81"},"role":"symbol"},"sections":[],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/Systems\/documentation\/Systems\/System()"},"references":{"doc://WorldModule/documentation/WorldModule/Query/Where":{"title":"Query.Where","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"Where"}],"type":"topic","identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/Query\/Where","abstract":[{"type":"text","text":"A query whose filter a system spells as types."}],"role":"symbol","navigatorTitle":[{"kind":"identifier","text":"W