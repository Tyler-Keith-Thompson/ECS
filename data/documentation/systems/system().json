{"seeAlsoSections":[{"anchor":"Essentials","title":"Essentials","identifiers":["doc:\/\/Systems\/documentation\/Systems\/DeclaringSystems","doc:\/\/Systems\/documentation\/Systems\/DrivingAWorldFromAnApp","doc:\/\/Systems\/documentation\/Systems\/System"],"generated":true}],"schemaVersion":{"minor":3,"patch":0,"major":0},"identifier":{"url":"doc:\/\/Systems\/documentation\/Systems\/System()","interfaceLanguage":"swift"},"variants":[{"paths":["\/documentation\/systems\/system()"],"traits":[{"interfaceLanguage":"swift"}]}],"kind":"symbol","primaryContentSections":[{"kind":"declarations","declarations":[{"tokens":[{"text":"@attached","kind":"attribute"},{"text":"(extension, conformances: ","kind":"text"},{"preciseIdentifier":"s:7Systems6SystemP","identifier":"doc:\/\/Systems\/documentation\/Systems\/System","text":"System","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"preciseIdentifier":"s:7Systems15MainActorSystemP","identifier":"doc:\/\/Systems\/documentation\/Systems\/MainActorSystem","text":"MainActorSystem","kind":"typeIdentifier"},{"text":", names: named(access), named(run), named(initialize)) ","kind":"text"},{"text":"macro","kind":"keyword"},{"text":" ","kind":"text"},{"text":"System","kind":"identifier"},{"text":"()","kind":"text"}],"platforms":["Linux"],"languages":["swift"]}]},{"content":[{"anchor":"overview","text":"Overview","level":2,"type":"heading"},{"inlineContent":[{"type":"text","text":"Attach "},{"type":"codeVoice","code":"@System"},{"type":"text","text":" to a structure with a method named "},{"type":"codeVoice","code":"run"},{"type":"text","text":". The method’s parameters are"},{"type":"text","text":" "},{"type":"text","text":"system parameters, values the schedule fetches from the world before each run, and their"},{"type":"text","text":" "},{"type":"text","text":"types state exactly what the system reads and writes. The macro conforms the type to"},{"type":"text","text":" "},{"type":"reference","identifier":"doc:\/\/Systems\/documentation\/Systems\/System","isActive":true},{"type":"text","text":", writing its "},{"type":"reference","identifier":"doc:\/\/Systems\/documentation\/Systems\/System\/access","isActive":true},{"type":"text","text":" from those types and a "},{"type":"reference","identifier":"doc:\/\/Systems\/documentation\/Systems\/System\/run(in:)","isActive":true},{"type":"text","text":" that"},{"type":"text","text":" "},{"type":"text","text":"fetches the parameters and calls your method."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"The following system moves each entity by its velocity plus whichever of a wind and a"},{"type":"text","text":" "},{"type":"text","text":"current act on it, scaled by the time step:"}],"type":"paragraph"},{"syntax":"swift","code":["struct Wind: Component { var speed: Double }","struct Current: Component { var speed: Double }","","@System","struct Drift {","    func run(","        _ drifters: Update<Position>.Over<Velocity, AnyOf<Wind, Current>>,","        _ step: ResourceReader<TimeStep>","    ) {","        drifters { position, row in","            let (velocity, (wind, current)) = row.components","            let push = (wind?.speed ?? 0) + (current?.speed ?? 0)","            position.x += (velocity.dx + push) * step.value.seconds","        }","    }","}","","var world = World()","world.resources.insert(TimeStep(seconds: 0.5))","let boat = world.spawn(Position(x: 0, y: 0), Velocity(dx: 2, dy: 0), Wind(speed: 4))","Schedule { Drift() }.run(on: &world)","print(world[Position.self, of: boat].x)","\/\/ Prints \"3.0\""],"type":"codeListing"},{"inlineContent":[{"type":"codeVoice","code":"Drift"},{"type":"text","text":" writes "},{"type":"codeVoice","code":"Position"},{"type":"text","text":", reads "},{"type":"codeVoice","code":"Velocity"},{"type":"text","text":", "},{"type":"codeVoice","code":"Wind"},{"type":"text","text":", "},{"type":"codeVoice","code":"Current"},{"type":"text","text":" and the "},{"type":"codeVoice","code":"TimeStep"},{"type":"text","text":" resource,"},{"type":"text","text":" "},{"type":"text","text":"and nothing else, so a schedule runs it at the same time as any system that doesn’t write"},{"type":"text","text":" "},{"type":"text","text":"those types."}],"type":"paragraph"},{"inlineContent":[{"text":"These are the parameter types a ","type":"text"},{"code":"run","type":"codeVoice"},{"text":" method can take:","type":"text"}],"type":"paragraph"},{"items":[{"term":{"inlineContent":[{"isActive":true,"type":"reference","identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/Query"},{"type":"text","text":" and "},{"isActive":true,"type":"reference","identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/Query\/Where"}]},"definition":{"content":[{"type":"paragraph","inlineContent":[{"text":"Reads components.","type":"text"}]}]}},{"term":{"inlineContent":[{"type":"reference","identifier":"doc:\/\/Systems\/documentation\/Systems\/Update","isActive":true}]},"definition":{"content":[{"inlineContent":[{"text":"Writes components, optionally reading others.","type":"text"}],"type":"paragraph"}]}},{"term":{"inlineContent":[{"identifier":"doc:\/\/Systems\/documentation\/Systems\/ResourceReader","isActive":true,"type":"reference"},{"text":" and ","type":"text"},{"identifier":"doc:\/\/Systems\/documentation\/Systems\/ResourceWriter","isActive":true,"type":"reference"}]},"definition":{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Read or write a resource."}]}]}},{"term":{"inlineContent":[{"isActive":true,"type":"reference","identifier":"doc:\/\/Systems\/documentation\/Systems\/EventReader"},{"text":" and ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/Systems\/documentation\/Systems\/EventWriter"}]},"definition":{"content":[{"inlineContent":[{"text":"Read or send events.","type":"text"}],"type":"paragraph"}]}},{"term":{"inlineContent":[{"isActive":true,"type":"reference","identifier":"doc:\/\/Systems\/documentation\/Systems\/RemovedComponents"}]},"definition":{"content":[{"inlineContent":[{"type":"text","text":"Lists the entities that lost a component."}],"type":"paragraph"}]}},{"term":{"inlineContent":[{"code":"inout","type":"codeVoice"},{"type":"text","text":" "},{"identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/Commands","type":"reference","isActive":true}]},"definition":{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Queues structural changes, which apply at the end of the system’s wave and conflict with nothing."}]}]}}],"type":"termList"},{"inlineContent":[{"type":"text","text":"A "},{"code":"run","type":"codeVoice"},{"type":"text","text":" method that takes the world instead, as "},{"code":"inout World","type":"codeVoice"},{"type":"text","text":", makes a system with no access,"},{"type":"text","text":" "},{"type":"text","text":"which can change anything and so runs alone:"}],"type":"paragraph"},{"syntax":"swift","code":["@System","struct SpawnBall {","    func run(in world: inout World) {","        world.spawn(Position(x: 0, y: 100), Velocity(dx: 0, dy: 0))","    }","}","","var world = World()","Schedule { SpawnBall() }.run(on: &world)","print(world.count)","\/\/ Prints \"1\""],"type":"codeListing"},{"inlineContent":[{"type":"text","text":"Mark the type or its "},{"type":"codeVoice","code":"run"},{"type":"text","text":" method "},{"type":"codeVoice","code":"@MainActor"},{"type":"text","text":" to make a "},{"type":"reference","identifier":"doc:\/\/Systems\/documentation\/Systems\/MainActorSystem","isActive":true},{"type":"text","text":" instead."}],"type":"paragraph"},{"inlineContent":[{"text":"The macro reads only the method’s signature. Two parameters whose written types conflict,","type":"text"},{"text":" ","type":"text"},{"text":"such as an ","type":"text"},{"code":"Update<Position>","type":"codeVoice"},{"text":" and a ","type":"text"},{"code":"Query<Position>","type":"codeVoice"},{"text":", are a compile-time error. A conflict the","type":"text"},{"text":" ","type":"text"},{"text":"written types hide, such as one type spelled through a type alias, traps when the system is","type":"text"},{"text":" ","type":"text"},{"text":"scheduled.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"The code the macro generates refers to "},{"type":"codeVoice","code":"World"},{"type":"text","text":", "},{"type":"codeVoice","code":"Access"},{"type":"text","text":" and "},{"type":"codeVoice","code":"Commands"},{"type":"text","text":", so the file must"},{"type":"text","text":" "},{"type":"text","text":"import "},{"type":"codeVoice","code":"ECS"},{"type":"text","text":", or both "},{"type":"codeVoice","code":"WorldModule"},{"type":"text","text":" and "},{"type":"codeVoice","code":"Systems"},{"type":"text","text":"."}],"type":"paragraph"}],"kind":"content"}],"metadata":{"roleHeading":"Macro","role":"symbol","title":"System()","modules":[{"name":"Systems"}],"symbolKind":"macro","externalID":"s:7Systems6Systemyycfm","fragments":[{"kind":"keyword","text":"macro"},{"kind":"text","text":" "},{"kind":"identifier","text":"System"},{"kind":"text","text":"()"}],"remoteSource":{"fileName":"SystemMacro.swift","url":"https:\/\/github.com\/Tyler-Keith-Thompson\/ECS\/blob\/main\/Sources\/Systems\/SystemMacro.swift#L81"}},"sections":[],"abstract":[{"text":"Makes a type a system whose access comes from the parameters of its ","type":"text"},{"code":"run","type":"codeVoice"},{"text":" method.","type":"text"}],"hierarchy":{"paths":[["doc:\/\/Systems\/documentation\/Systems"]]},"references":{"doc://WorldModule/documentation/WorldModule/Commands":{"navigatorTitle":[{"text":"Commands","kind":"identifier"}],"identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/Commands","kind":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Commands","kind":"identifier"}],"abstract":[{"type":"text","text":"A buffer of changes to a world, recorded now and applied later in the order they