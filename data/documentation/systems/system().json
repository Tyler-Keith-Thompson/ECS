{"hierarchy":{"paths":[["doc:\/\/Systems\/documentation\/Systems"]]},"schemaVersion":{"patch":0,"minor":3,"major":0},"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/systems\/system()"]}],"kind":"symbol","primaryContentSections":[{"kind":"declarations","declarations":[{"tokens":[{"kind":"attribute","text":"@attached"},{"kind":"text","text":"(extension, conformances: "},{"identifier":"doc:\/\/Systems\/documentation\/Systems\/System","preciseIdentifier":"s:7Systems6SystemP","kind":"typeIdentifier","text":"System"},{"kind":"text","text":", "},{"identifier":"doc:\/\/Systems\/documentation\/Systems\/MainActorSystem","preciseIdentifier":"s:7Systems15MainActorSystemP","kind":"typeIdentifier","text":"MainActorSystem"},{"kind":"text","text":", names: named(access), named(run), named(initialize)) "},{"kind":"keyword","text":"macro"},{"kind":"text","text":" "},{"kind":"identifier","text":"System"},{"kind":"text","text":"()"}],"platforms":["Linux"],"languages":["swift"]}]},{"kind":"mentions","mentions":["doc:\/\/Systems\/documentation\/Systems\/SchedulingSystems"]},{"kind":"content","content":[{"anchor":"overview","level":2,"text":"Overview","type":"heading"},{"inlineContent":[{"text":"Attach ","type":"text"},{"code":"@System","type":"codeVoice"},{"text":" to a structure with a method named ","type":"text"},{"code":"run","type":"codeVoice"},{"text":". The method’s parameters are","type":"text"},{"text":" ","type":"text"},{"text":"system parameters, values the schedule fetches from the world before each run, and their","type":"text"},{"text":" ","type":"text"},{"text":"types state exactly what the system reads and writes. The macro conforms the type to","type":"text"},{"text":" ","type":"text"},{"type":"reference","isActive":true,"identifier":"doc:\/\/Systems\/documentation\/Systems\/System"},{"text":", writing its ","type":"text"},{"type":"reference","isActive":true,"identifier":"doc:\/\/Systems\/documentation\/Systems\/System\/access"},{"text":" from those types and a ","type":"text"},{"type":"reference","isActive":true,"identifier":"doc:\/\/Systems\/documentation\/Systems\/System\/run(in:)"},{"text":" that","type":"text"},{"text":" ","type":"text"},{"text":"fetches the parameters and calls your method.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"The following system moves each entity by its velocity plus whichever of a wind and a","type":"text"},{"text":" ","type":"text"},{"text":"current act on it, scaled by the time step:","type":"text"}],"type":"paragraph"},{"syntax":"swift","code":["struct Wind: Component { var speed: Double }","struct Current: Component { var speed: Double }","","@System","struct Drift {","    func run(","        _ drifters: Update<Position>.Over<Velocity, AnyOf<Wind, Current>>,","        _ step: ResourceReader<TimeStep>","    ) {","        drifters { position, row in","            let (velocity, (wind, current)) = row.components","            let push = (wind?.speed ?? 0) + (current?.speed ?? 0)","            position.x += (velocity.dx + push) * step.value.seconds","        }","    }","}","","var world = World()","world.resources.insert(TimeStep(seconds: 0.5))","let boat = world.spawn(Position(x: 0, y: 0), Velocity(dx: 2, dy: 0), Wind(speed: 4))","Schedule { Drift() }.run(on: &world)","print(world[Position.self, of: boat].x)","\/\/ Prints \"3.0\""],"type":"codeListing"},{"inlineContent":[{"code":"Drift","type":"codeVoice"},{"text":" writes ","type":"text"},{"code":"Position","type":"codeVoice"},{"text":", reads ","type":"text"},{"code":"Velocity","type":"codeVoice"},{"text":", ","type":"text"},{"code":"Wind","type":"codeVoice"},{"text":", ","type":"text"},{"code":"Current","type":"codeVoice"},{"text":" and the ","type":"text"},{"code":"TimeStep","type":"codeVoice"},{"text":" resource,","type":"text"},{"text":" ","type":"text"},{"text":"and nothing else, so a schedule runs it at the same time as any system that doesn’t write","type":"text"},{"text":" ","type":"text"},{"text":"those types.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"These are the parameter types a "},{"type":"codeVoice","code":"run"},{"type":"text","text":" method can take:"}],"type":"paragraph"},{"items":[{"definition":{"content":[{"inlineContent":[{"type":"text","text":"Reads components."}],"type":"paragraph"}]},"term":{"inlineContent":[{"type":"reference","identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/Query","isActive":true},{"type":"text","text":" and "},{"type":"reference","identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/Query\/Where","isActive":true}]}},{"term":{"inlineContent":[{"isActive":true,"identifier":"doc:\/\/Systems\/documentation\/Systems\/Update","type":"reference"}]},"definition":{"content":[{"type":"paragraph","inlineContent":[{"text":"Writes components, optionally reading others.","type":"text"}]}]}},{"term":{"inlineContent":[{"identifier":"doc:\/\/Systems\/documentation\/Systems\/ResourceReader","isActive":true,"type":"reference"},{"text":" and ","type":"text"},{"identifier":"doc:\/\/Systems\/documentation\/Systems\/ResourceWriter","isActive":true,"type":"reference"}]},"definition":{"content":[{"inlineContent":[{"type":"text","text":"Read or write a resource."}],"type":"paragraph"}]}},{"term":{"inlineContent":[{"isActive":true,"type":"reference","identifier":"doc:\/\/Systems\/documentation\/Systems\/EventReader"},{"type":"text","text":" and "},{"isActive":true,"type":"reference","identifier":"doc:\/\/Systems\/documentation\/Systems\/EventWriter"}]},"definition":{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Read or send events."}]}]}},{"term":{"inlineContent":[{"identifier":"doc:\/\/Systems\/documentation\/Systems\/RemovedComponents","type":"reference","isActive":true}]},"definition":{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Lists the entities that lost a component."}]}]}},{"term":{"inlineContent":[{"code":"inout","type":"codeVoice"},{"text":" ","type":"text"},{"identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/Commands","type":"reference","isActive":true}]},"definition":{"content":[{"type":"paragraph","inlineContent":[{"text":"Queues structural changes, which apply at the end of the system’s wave and conflict with nothing.","type":"text"}]}]}}],"type":"termList"},{"inlineContent":[{"text":"A ","type":"text"},{"code":"run","type":"codeVoice"},{"text":" method that takes the world instead, as ","type":"text"},{"code":"inout World","type":"codeVoice"},{"text":", makes a system with no access,","type":"text"},{"text":" ","type":"text"},{"text":"which can change anything and so runs alone:","type":"text"}],"type":"paragraph"},{"syntax":"swift","code":["@System","struct SpawnBall {","    func run(in world: inout World) {","        world.spawn(Position(x: 0, y: 100), Velocity(dx: 0, dy: 0))","    }","}","","var world = World()","Schedule { SpawnBall() }.run(on: &world)","print(world.count)","\/\/ Prints \"1\""],"type":"codeListing"},{"inlineContent":[{"text":"Mark the type or its ","type":"text"},{"type":"codeVoice","code":"run"},{"text":" method ","type":"text"},{"type":"codeVoice","code":"@MainActor"},{"text":" to make a ","type":"text"},{"type":"reference","identifier":"doc:\/\/Systems\/documentation\/Systems\/MainActorSystem","isActive":true},{"text":" instead.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"The macro reads only the method’s signature. Two parameters whose written types conflict,","type":"text"},{"text":" ","type":"text"},{"text":"such as an ","type":"text"},{"code":"Update<Position>","type":"codeVoice"},{"text":" and a ","type":"text"},{"code":"Query<Position>","type":"codeVoice"},{"text":", are a compile-time error. A conflict the","type":"text"},{"text":" ","type":"text"},{"text":"written types hide, such as one type spelled through a type alias, traps when the system is","type":"text"},{"text":" ","type":"text"},{"text":"scheduled.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"The code the macro generates refers to ","type":"text"},{"code":"World","type":"codeVoice"},{"text":", ","type":"text"},{"code":"Access","type":"codeVoice"},{"text":" and ","type":"text"},{"code":"Commands","type":"codeVoice"},{"text":", so the file must","type":"text"},{"text":" ","type":"text"},{"text":"import ","type":"text"},{"code":"ECS","type":"codeVoice"},{"text":", or both ","type":"text"},{"code":"WorldModule","type":"codeVoice"},{"text":" and ","type":"text"},{"code":"Systems","type":"codeVoice"},{"text":".","type":"text"}],"type":"paragraph"}]}],"seeAlsoSections":[{"generated":true,"title":"Essentials","identifiers":["doc:\/\/Systems\/documentation\/Systems\/DeclaringSystems","doc:\/\/Systems\/documentation\/Systems\/SchedulingSystems","doc:\/\/Systems\/documentation\/Systems\/DrivingAWorldFromAnApp","doc:\/\/Systems\/documentation\/Systems\/System"],"anchor":"Essentials"}],"identifier":{"url":"doc:\/\/Systems\/documentation\/Systems\/System()","interfaceLanguage":"swift"},"metadata":{"remoteSource":{"url":"https:\/\/github.com\/Tyler-Keith-Thompson\/ECS\/blob\/main\/Sources\/Systems\/SystemMacro.swift#L81","fileName":"SystemMacro.swift"},"externalID":"s:7Systems6Systemyycfm","symbolKind":"macro","title":"System()","role":"symbol","modules":[{"name":"Systems"}],"roleHeading":"Macro","fragments":[{"text":"macro","kind":"keyword"},{"text":" ","kind":"text"},{"text":"System","kind":"identifier"},{"text":"()","kind":"text"}]},"sections":[],"abstract":[{"text":"Makes a type a system whose access comes from the parameters of its ","type":"text"},{"type":"codeVoice","code":"run"},{"text":" method.","type":"text"}],"references":{"doc://Systems/documentation/Systems/DeclaringSystems":{"abstract":[{"text":"Write the rules of a simulation as systems, and let their parameters state what they read and","type":"text"},{"text":" ","type":"text"},{"text":"write.","type":"text"}],"role":"collectionGroup","title":