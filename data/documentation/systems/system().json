{"kind":"symbol","abstract":[{"text":"Makes a type a system whose access comes from the parameters of its ","type":"text"},{"type":"codeVoice","code":"run"},{"text":" method.","type":"text"}],"hierarchy":{"paths":[["doc:\/\/Systems\/documentation\/Systems"]]},"variants":[{"paths":["\/documentation\/systems\/system()"],"traits":[{"interfaceLanguage":"swift"}]}],"identifier":{"url":"doc:\/\/Systems\/documentation\/Systems\/System()","interfaceLanguage":"swift"},"sections":[],"seeAlsoSections":[{"generated":true,"title":"Essentials","anchor":"Essentials","identifiers":["doc:\/\/Systems\/documentation\/Systems\/DeclaringSystems","doc:\/\/Systems\/documentation\/Systems\/DrivingAWorldFromAnApp","doc:\/\/Systems\/documentation\/Systems\/System"]}],"schemaVersion":{"minor":3,"major":0,"patch":0},"primaryContentSections":[{"declarations":[{"languages":["swift"],"platforms":["Linux"],"tokens":[{"text":"@attached","kind":"attribute"},{"text":"(extension, conformances: ","kind":"text"},{"text":"System","identifier":"doc:\/\/Systems\/documentation\/Systems\/System","preciseIdentifier":"s:7Systems6SystemP","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"MainActorSystem","identifier":"doc:\/\/Systems\/documentation\/Systems\/MainActorSystem","preciseIdentifier":"s:7Systems15MainActorSystemP","kind":"typeIdentifier"},{"text":", names: named(access), named(run), named(initialize)) ","kind":"text"},{"text":"macro","kind":"keyword"},{"text":" ","kind":"text"},{"text":"System","kind":"identifier"},{"text":"()","kind":"text"}]}],"kind":"declarations"},{"content":[{"type":"heading","level":2,"text":"Overview","anchor":"overview"},{"inlineContent":[{"type":"text","text":"Attach "},{"code":"@System","type":"codeVoice"},{"type":"text","text":" to a structure with a method named "},{"code":"run","type":"codeVoice"},{"type":"text","text":". The method’s parameters are"},{"type":"text","text":" "},{"type":"text","text":"system parameters, values the schedule fetches from the world before each run, and their"},{"type":"text","text":" "},{"type":"text","text":"types state exactly what the system reads and writes. The macro conforms the type to"},{"type":"text","text":" "},{"isActive":true,"type":"reference","identifier":"doc:\/\/Systems\/documentation\/Systems\/System"},{"type":"text","text":", writing its "},{"isActive":true,"type":"reference","identifier":"doc:\/\/Systems\/documentation\/Systems\/System\/access"},{"type":"text","text":" from those types and a "},{"isActive":true,"type":"reference","identifier":"doc:\/\/Systems\/documentation\/Systems\/System\/run(in:)"},{"type":"text","text":" that"},{"type":"text","text":" "},{"type":"text","text":"fetches the parameters and calls your method."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"The following system moves each entity by its velocity plus whichever of a wind and a"},{"type":"text","text":" "},{"type":"text","text":"current act on it, scaled by the time step:"}],"type":"paragraph"},{"syntax":"swift","code":["struct Wind: Component { var speed: Double }","struct Current: Component { var speed: Double }","","@System","struct Drift {","    func run(","        _ drifters: Update<Position>.Over<Velocity, AnyOf<Wind, Current>>,","        _ step: ResourceReader<TimeStep>","    ) {","        drifters { position, row in","            let (velocity, (wind, current)) = row.components","            let push = (wind?.speed ?? 0) + (current?.speed ?? 0)","            position.x += (velocity.dx + push) * step.value.seconds","        }","    }","}","","var world = World()","world.resources.insert(TimeStep(seconds: 0.5))","let boat = world.spawn(Position(x: 0, y: 0), Velocity(dx: 2, dy: 0), Wind(speed: 4))","Schedule { Drift() }.run(on: &world)","print(world[Position.self, of: boat].x)","\/\/ Prints \"3.0\""],"type":"codeListing"},{"inlineContent":[{"type":"codeVoice","code":"Drift"},{"text":" writes ","type":"text"},{"type":"codeVoice","code":"Position"},{"text":", reads ","type":"text"},{"type":"codeVoice","code":"Velocity"},{"text":", ","type":"text"},{"type":"codeVoice","code":"Wind"},{"text":", ","type":"text"},{"type":"codeVoice","code":"Current"},{"text":" and the ","type":"text"},{"type":"codeVoice","code":"TimeStep"},{"text":" resource,","type":"text"},{"text":" ","type":"text"},{"text":"and nothing else, so a schedule runs it at the same time as any system that doesn’t write","type":"text"},{"text":" ","type":"text"},{"text":"those types.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"These are the parameter types a "},{"code":"run","type":"codeVoice"},{"type":"text","text":" method can take:"}],"type":"paragraph"},{"type":"termList","items":[{"term":{"inlineContent":[{"identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/Query","type":"reference","isActive":true},{"type":"text","text":" and "},{"identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/Query\/Where","type":"reference","isActive":true}]},"definition":{"content":[{"inlineContent":[{"type":"text","text":"Reads components."}],"type":"paragraph"}]}},{"term":{"inlineContent":[{"isActive":true,"identifier":"doc:\/\/Systems\/documentation\/Systems\/Update","type":"reference"}]},"definition":{"content":[{"inlineContent":[{"text":"Writes components, optionally reading others.","type":"text"}],"type":"paragraph"}]}},{"term":{"inlineContent":[{"isActive":true,"identifier":"doc:\/\/Systems\/documentation\/Systems\/ResourceReader","type":"reference"},{"text":" and ","type":"text"},{"isActive":true,"identifier":"doc:\/\/Systems\/documentation\/Systems\/ResourceWriter","type":"reference"}]},"definition":{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Read or write a resource."}]}]}},{"term":{"inlineContent":[{"identifier":"doc:\/\/Systems\/documentation\/Systems\/EventReader","isActive":true,"type":"reference"},{"text":" and ","type":"text"},{"identifier":"doc:\/\/Systems\/documentation\/Systems\/EventWriter","isActive":true,"type":"reference"}]},"definition":{"content":[{"type":"paragraph","inlineContent":[{"text":"Read or send events.","type":"text"}]}]}},{"term":{"inlineContent":[{"isActive":true,"identifier":"doc:\/\/Systems\/documentation\/Systems\/RemovedComponents","type":"reference"}]},"definition":{"content":[{"inlineContent":[{"type":"text","text":"Lists the entities that lost a component."}],"type":"paragraph"}]}},{"term":{"inlineContent":[{"code":"inout","type":"codeVoice"},{"type":"text","text":" "},{"isActive":true,"identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/Commands","type":"reference"}]},"definition":{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Queues structural changes, which apply at the end of the system’s wave and conflict with nothing."}]}]}}]},{"inlineContent":[{"text":"A ","type":"text"},{"code":"run","type":"codeVoice"},{"text":" method that takes the world instead, as ","type":"text"},{"code":"inout World","type":"codeVoice"},{"text":", makes a system with no access,","type":"text"},{"text":" ","type":"text"},{"text":"which can change anything and so runs alone:","type":"text"}],"type":"paragraph"},{"syntax":"swift","code":["@System","struct SpawnBall {","    func run(in world: inout World) {","        world.spawn(Position(x: 0, y: 100), Velocity(dx: 0, dy: 0))","    }","}","","var world = World()","Schedule { SpawnBall() }.run(on: &world)","print(world.count)","\/\/ Prints \"1\""],"type":"codeListing"},{"inlineContent":[{"type":"text","text":"Mark the type or its "},{"code":"run","type":"codeVoice"},{"type":"text","text":" method "},{"code":"@MainActor","type":"codeVoice"},{"type":"text","text":" to make a "},{"type":"reference","isActive":true,"identifier":"doc:\/\/Systems\/documentation\/Systems\/MainActorSystem"},{"type":"text","text":" instead."}],"type":"paragraph"},{"inlineContent":[{"text":"The macro reads only the method’s signature. Two parameters whose written types conflict,","type":"text"},{"text":" ","type":"text"},{"text":"such as an ","type":"text"},{"code":"Update<Position>","type":"codeVoice"},{"text":" and a ","type":"text"},{"code":"Query<Position>","type":"codeVoice"},{"text":", are a compile-time error. A conflict the","type":"text"},{"text":" ","type":"text"},{"text":"written types hide, such as one type spelled through a type alias, traps when the system is","type":"text"},{"text":" ","type":"text"},{"text":"scheduled.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"The code the macro generates refers to "},{"type":"codeVoice","code":"World"},{"type":"text","text":", "},{"type":"codeVoice","code":"Access"},{"type":"text","text":" and "},{"type":"codeVoice","code":"Commands"},{"type":"text","text":", so the file must"},{"type":"text","text":" "},{"type":"text","text":"import "},{"type":"codeVoice","code":"ECS"},{"type":"text","text":", or both "},{"type":"codeVoice","code":"WorldModule"},{"type":"text","text":" and "},{"type":"codeVoice","code":"Systems"},{"type":"text","text":"."}],"type":"paragraph"}],"kind":"content"}],"metadata":{"symbolKind":"macro","title":"System()","modules":[{"name":"Systems"}],"role":"symbol","roleHeading":"Macro","fragments":[{"kind":"keyword","text":"macro"},{"kind":"text","text":" "},{"kind":"identifier","text":"System"},{"kind":"text","text":"()"}],"externalID":"s:7Systems6Systemyycfm","remoteSource":{"url":"https:\/\/github.com\/Tyler-Keith-Thompson\/ECS\/blob\/main\/Sources\/Systems\/SystemMacro.swift#L81","fileName":"SystemMacro.swift"}},"references":{"doc://Systems/documentation/Systems/System":{"navigatorTitle":[{"kind":"identifier","text":"System"}],"abstract":[{"text":"A rule that reads and changes a world, run once each time its schedule runs.","type":"text"}],"type":"topic","kind":"symbol","role":"symbol","identifier":"doc:\/\/Systems\/documentation\/Systems\/System","fragments":[{"kind":"keyword","text":"protocol"},{"kind":"text","text":" "},{"kind":"identifier","text":"S