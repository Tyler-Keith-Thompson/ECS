{"primaryContentSections":[{"declarations":[{"platforms":["Linux"],"tokens":[{"text":"@attached","kind":"attribute"},{"text":"(extension, conformances: ","kind":"text"},{"text":"System","identifier":"doc:\/\/Systems\/documentation\/Systems\/System","preciseIdentifier":"s:7Systems6SystemP","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"MainActorSystem","identifier":"doc:\/\/Systems\/documentation\/Systems\/MainActorSystem","preciseIdentifier":"s:7Systems15MainActorSystemP","kind":"typeIdentifier"},{"text":", names: named(access), named(run), named(initialize)) ","kind":"text"},{"text":"macro","kind":"keyword"},{"text":" ","kind":"text"},{"text":"System","kind":"identifier"},{"text":"()","kind":"text"}],"languages":["swift"]}],"kind":"declarations"},{"content":[{"anchor":"overview","level":2,"text":"Overview","type":"heading"},{"inlineContent":[{"type":"text","text":"Attach "},{"type":"codeVoice","code":"@System"},{"type":"text","text":" to a structure with a method named "},{"type":"codeVoice","code":"run"},{"type":"text","text":". The method’s parameters are"},{"type":"text","text":" "},{"type":"text","text":"system parameters, values the schedule fetches from the world before each run, and their"},{"type":"text","text":" "},{"type":"text","text":"types state exactly what the system reads and writes. The macro conforms the type to"},{"type":"text","text":" "},{"type":"reference","identifier":"doc:\/\/Systems\/documentation\/Systems\/System","isActive":true},{"type":"text","text":", writing its "},{"type":"reference","identifier":"doc:\/\/Systems\/documentation\/Systems\/System\/access","isActive":true},{"type":"text","text":" from those types and a "},{"type":"reference","identifier":"doc:\/\/Systems\/documentation\/Systems\/System\/run(in:)","isActive":true},{"type":"text","text":" that"},{"type":"text","text":" "},{"type":"text","text":"fetches the parameters and calls your method."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"The following system moves each entity by its velocity plus whichever of a wind and a"},{"type":"text","text":" "},{"type":"text","text":"current act on it, scaled by the time step:"}],"type":"paragraph"},{"syntax":"swift","code":["struct Wind: Component { var speed: Double }","struct Current: Component { var speed: Double }","","@System","struct Drift {","    func run(","        _ drifters: Update<Position>.Over<Velocity, AnyOf<Wind, Current>>,","        _ step: ResourceReader<TimeStep>","    ) {","        drifters { position, row in","            let (velocity, (wind, current)) = row.components","            let push = (wind?.speed ?? 0) + (current?.speed ?? 0)","            position.x += (velocity.dx + push) * step.value.seconds","        }","    }","}","","var world = World()","world.resources.insert(TimeStep(seconds: 0.5))","let boat = world.spawn(Position(x: 0, y: 0), Velocity(dx: 2, dy: 0), Wind(speed: 4))","Schedule { Drift() }.run(on: &world)","print(world[Position.self, of: boat].x)","\/\/ Prints \"3.0\""],"type":"codeListing"},{"inlineContent":[{"type":"codeVoice","code":"Drift"},{"type":"text","text":" writes "},{"type":"codeVoice","code":"Position"},{"type":"text","text":", reads "},{"type":"codeVoice","code":"Velocity"},{"type":"text","text":", "},{"type":"codeVoice","code":"Wind"},{"type":"text","text":", "},{"type":"codeVoice","code":"Current"},{"type":"text","text":" and the "},{"type":"codeVoice","code":"TimeStep"},{"type":"text","text":" resource,"},{"type":"text","text":" "},{"type":"text","text":"and nothing else, so a schedule runs it at the same time as any system that doesn’t write"},{"type":"text","text":" "},{"type":"text","text":"those types."}],"type":"paragraph"},{"inlineContent":[{"text":"These are the parameter types a ","type":"text"},{"code":"run","type":"codeVoice"},{"text":" method can take:","type":"text"}],"type":"paragraph"},{"items":[{"definition":{"content":[{"inlineContent":[{"type":"text","text":"Reads components."}],"type":"paragraph"}]},"term":{"inlineContent":[{"type":"reference","isActive":true,"identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/Query"},{"type":"text","text":" and "},{"type":"reference","isActive":true,"identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/Query\/Where"}]}},{"definition":{"content":[{"inlineContent":[{"text":"Writes components, optionally reading others.","type":"text"}],"type":"paragraph"}]},"term":{"inlineContent":[{"identifier":"doc:\/\/Systems\/documentation\/Systems\/Update","type":"reference","isActive":true}]}},{"definition":{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Read or write a resource."}]}]},"term":{"inlineContent":[{"isActive":true,"identifier":"doc:\/\/Systems\/documentation\/Systems\/ResourceReader","type":"reference"},{"text":" and ","type":"text"},{"isActive":true,"identifier":"doc:\/\/Systems\/documentation\/Systems\/ResourceWriter","type":"reference"}]}},{"definition":{"content":[{"inlineContent":[{"type":"text","text":"Read or send events."}],"type":"paragraph"}]},"term":{"inlineContent":[{"type":"reference","identifier":"doc:\/\/Systems\/documentation\/Systems\/EventReader","isActive":true},{"type":"text","text":" and "},{"type":"reference","identifier":"doc:\/\/Systems\/documentation\/Systems\/EventWriter","isActive":true}]}},{"definition":{"content":[{"inlineContent":[{"text":"Lists the entities that lost a component.","type":"text"}],"type":"paragraph"}]},"term":{"inlineContent":[{"identifier":"doc:\/\/Systems\/documentation\/Systems\/RemovedComponents","type":"reference","isActive":true}]}},{"definition":{"content":[{"inlineContent":[{"text":"Queues structural changes, which apply at the end of the system’s wave and conflict with nothing.","type":"text"}],"type":"paragraph"}]},"term":{"inlineContent":[{"type":"codeVoice","code":"inout"},{"text":" ","type":"text"},{"isActive":true,"identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/Commands","type":"reference"}]}}],"type":"termList"},{"inlineContent":[{"text":"A ","type":"text"},{"code":"run","type":"codeVoice"},{"text":" method that takes the world instead, as ","type":"text"},{"code":"inout World","type":"codeVoice"},{"text":", makes a system with no access,","type":"text"},{"text":" ","type":"text"},{"text":"which can change anything and so runs alone:","type":"text"}],"type":"paragraph"},{"syntax":"swift","code":["@System","struct SpawnBall {","    func run(in world: inout World) {","        world.spawn(Position(x: 0, y: 100), Velocity(dx: 0, dy: 0))","    }","}","","var world = World()","Schedule { SpawnBall() }.run(on: &world)","print(world.count)","\/\/ Prints \"1\""],"type":"codeListing"},{"inlineContent":[{"text":"Mark the type or its ","type":"text"},{"code":"run","type":"codeVoice"},{"text":" method ","type":"text"},{"code":"@MainActor","type":"codeVoice"},{"text":" to make a ","type":"text"},{"identifier":"doc:\/\/Systems\/documentation\/Systems\/MainActorSystem","type":"reference","isActive":true},{"text":" instead.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"The macro reads only the method’s signature. Two parameters whose written types conflict,"},{"type":"text","text":" "},{"type":"text","text":"such as an "},{"type":"codeVoice","code":"Update<Position>"},{"type":"text","text":" and a "},{"type":"codeVoice","code":"Query<Position>"},{"type":"text","text":", are a compile-time error. A conflict the"},{"type":"text","text":" "},{"type":"text","text":"written types hide, such as one type spelled through a type alias, traps when the system is"},{"type":"text","text":" "},{"type":"text","text":"scheduled."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"The code the macro generates refers to "},{"type":"codeVoice","code":"World"},{"type":"text","text":", "},{"type":"codeVoice","code":"Access"},{"type":"text","text":" and "},{"type":"codeVoice","code":"Commands"},{"type":"text","text":", so the file must"},{"type":"text","text":" "},{"type":"text","text":"import "},{"type":"codeVoice","code":"ECS"},{"type":"text","text":", or both "},{"type":"codeVoice","code":"WorldModule"},{"type":"text","text":" and "},{"type":"codeVoice","code":"Systems"},{"type":"text","text":"."}],"type":"paragraph"}],"kind":"content"}],"sections":[],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/Systems\/documentation\/Systems\/System()"},"variants":[{"paths":["\/documentation\/systems\/system()"],"traits":[{"interfaceLanguage":"swift"}]}],"abstract":[{"type":"text","text":"Makes a type a system whose access comes from the parameters of its "},{"type":"codeVoice","code":"run"},{"type":"text","text":" method."}],"seeAlsoSections":[{"generated":true,"anchor":"Essentials","title":"Essentials","identifiers":["doc:\/\/Systems\/documentation\/Systems\/DeclaringSystems","doc:\/\/Systems\/documentation\/Systems\/DrivingAWorldFromAnApp","doc:\/\/Systems\/documentation\/Systems\/System"]}],"metadata":{"role":"symbol","modules":[{"name":"Systems"}],"title":"System()","externalID":"s:7Systems6Systemyycfm","remoteSource":{"url":"https:\/\/github.com\/Tyler-Keith-Thompson\/ECS\/blob\/main\/Sources\/Systems\/SystemMacro.swift#L81","fileName":"SystemMacro.swift"},"fragments":[{"kind":"keyword","text":"macro"},{"kind":"text","text":" "},{"kind":"identifier","text":"System"},{"kind":"text","text":"()"}],"symbolKind":"macro","roleHeading":"Macro"},"kind":"symbol","hierarchy":{"paths":[["doc:\/\/Systems\/documentation\/Systems"]]},"schemaVersion":{"major":0,"minor":3,"patch":0},"references":{"doc://Systems/documentation/Systems/System/access":{"fragments":[{"kind":"keyword","text":"var"},{"kind":"text","text":" "},{"text":"access","kind":"identifier"},{"text":": ","kind":"text"},{"text":"Access","preciseIdentifier":"s:11WorldModule6AccessV","kind":"typeIdentifier"},{"text":"?","kind":"text"}],"kind":"symbol","identifier":"doc:\/\/Systems\/documentation\/Systems\/System\/access","title":"access","url":"\/documentation\/systems\/system\/access","type":"topic","role":"symbol","abstract":[{"type":"text","text":"The component, resource and event types the system reads and writes, or "},{"type":"codeVoice","code":"nil"},{"type":"text","text":" if it may"},{"type":"text","text":" "},{"type":"text","text":"change anything."}],"defaultImplementations":1,"required":true},"doc://Systems/documentation/Systems/ResourceReader":{"fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"ResourceReader"}],"identifier":"doc:\/\/Systems\/documentation\/Systems\/ResourceReader","kind":"symbol","title":"ResourceReader","navigatorTitle":[{"kind":"identifier","text":"ResourceReader"}],"type":"topic","url":"\/documentation\/systems\/resourcereader","role":"symbol","abstract":[{"type":"text","text":"A system parameter that reads a resource."}]},"doc://Systems/documentation/Systems/EventWriter":{"fragments":[{"kind":"keyword","text":"class"},{"kind":"text","text":" "},{"kind":"identifier","text":"EventWriter"}],"identifier":"doc:\/\/Systems\/documentation\/Systems\/EventWriter","kind":"symbol","title":"EventWriter","navigatorTitle":[{"kind":"identifier","text":"EventWriter"}],"type":"topic","url":"\/documentation\/systems\/eventwriter","role":"symbol","abstract":[{"type":"text","text":"A system parameter that sends events of one type."}]},"doc://WorldModule/documentation/WorldModule/Commands":{"fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Commands","kind":"identifier"}],"kind":"symbol","identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/Commands","title":"Commands","navigatorTitle":[{"text":"Commands","kind":"identifier"}],"type":"topic","url":"\/documentation\/worldmodule\/commands","role":"symbol","abstract":[{"type":"text","text":"A buffer of changes to a world, recorded now and applied later in the order they were"},{"type":"text","text":" "},{"type":"text","text":"recorded."}]},"doc://Systems/documentation/