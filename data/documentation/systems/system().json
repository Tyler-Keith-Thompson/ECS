{"identifier":{"url":"doc:\/\/Systems\/documentation\/Systems\/System()","interfaceLanguage":"swift"},"sections":[],"variants":[{"paths":["\/documentation\/systems\/system()"],"traits":[{"interfaceLanguage":"swift"}]}],"metadata":{"roleHeading":"Macro","symbolKind":"macro","externalID":"s:7Systems6Systemyycfm","fragments":[{"kind":"keyword","text":"macro"},{"kind":"text","text":" "},{"kind":"identifier","text":"System"},{"kind":"text","text":"()"}],"role":"symbol","modules":[{"name":"Systems"}],"title":"System()","remoteSource":{"url":"https:\/\/github.com\/Tyler-Keith-Thompson\/ECS\/blob\/main\/Sources\/Systems\/SystemMacro.swift#L81","fileName":"SystemMacro.swift"}},"hierarchy":{"paths":[["doc:\/\/Systems\/documentation\/Systems"]]},"kind":"symbol","schemaVersion":{"patch":0,"major":0,"minor":3},"primaryContentSections":[{"declarations":[{"tokens":[{"text":"@attached","kind":"attribute"},{"text":"(extension, conformances: ","kind":"text"},{"identifier":"doc:\/\/Systems\/documentation\/Systems\/System","text":"System","kind":"typeIdentifier","preciseIdentifier":"s:7Systems6SystemP"},{"text":", ","kind":"text"},{"identifier":"doc:\/\/Systems\/documentation\/Systems\/MainActorSystem","text":"MainActorSystem","kind":"typeIdentifier","preciseIdentifier":"s:7Systems15MainActorSystemP"},{"text":", names: named(access), named(run), named(initialize)) ","kind":"text"},{"text":"macro","kind":"keyword"},{"text":" ","kind":"text"},{"text":"System","kind":"identifier"},{"text":"()","kind":"text"}],"languages":["swift"],"platforms":["Linux"]}],"kind":"declarations"},{"content":[{"text":"Overview","type":"heading","anchor":"overview","level":2},{"type":"paragraph","inlineContent":[{"text":"Attach ","type":"text"},{"code":"@System","type":"codeVoice"},{"text":" to a structure with a method named ","type":"text"},{"code":"run","type":"codeVoice"},{"text":". The method’s parameters are","type":"text"},{"text":" ","type":"text"},{"text":"system parameters, values the schedule fetches from the world before each run, and their","type":"text"},{"text":" ","type":"text"},{"text":"types state exactly what the system reads and writes. The macro conforms the type to","type":"text"},{"text":" ","type":"text"},{"isActive":true,"identifier":"doc:\/\/Systems\/documentation\/Systems\/System","type":"reference"},{"text":", writing its ","type":"text"},{"isActive":true,"identifier":"doc:\/\/Systems\/documentation\/Systems\/System\/access","type":"reference"},{"text":" from those types and a ","type":"text"},{"isActive":true,"identifier":"doc:\/\/Systems\/documentation\/Systems\/System\/run(in:)","type":"reference"},{"text":" that","type":"text"},{"text":" ","type":"text"},{"text":"fetches the parameters and calls your method.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"The following system moves each entity by its velocity plus whichever of a wind and a","type":"text"},{"text":" ","type":"text"},{"text":"current act on it, scaled by the time step:","type":"text"}]},{"type":"codeListing","code":["struct Wind: Component { var speed: Double }","struct Current: Component { var speed: Double }","","@System","struct Drift {","    func run(","        _ drifters: Update<Position>.Over<Velocity, AnyOf<Wind, Current>>,","        _ step: ResourceReader<TimeStep>","    ) {","        drifters { position, row in","            let (velocity, (wind, current)) = row.components","            let push = (wind?.speed ?? 0) + (current?.speed ?? 0)","            position.x += (velocity.dx + push) * step.value.seconds","        }","    }","}","","var world = World()","world.resources.insert(TimeStep(seconds: 0.5))","let boat = world.spawn(Position(x: 0, y: 0), Velocity(dx: 2, dy: 0), Wind(speed: 4))","Schedule { Drift() }.run(on: &world)","print(world[Position.self, of: boat].x)","\/\/ Prints \"3.0\""],"syntax":"swift"},{"type":"paragraph","inlineContent":[{"code":"Drift","type":"codeVoice"},{"text":" writes ","type":"text"},{"code":"Position","type":"codeVoice"},{"text":", reads ","type":"text"},{"code":"Velocity","type":"codeVoice"},{"text":", ","type":"text"},{"code":"Wind","type":"codeVoice"},{"text":", ","type":"text"},{"code":"Current","type":"codeVoice"},{"text":" and the ","type":"text"},{"code":"TimeStep","type":"codeVoice"},{"text":" resource,","type":"text"},{"text":" ","type":"text"},{"text":"and nothing else, so a schedule runs it at the same time as any system that doesn’t write","type":"text"},{"text":" ","type":"text"},{"text":"those types.","type":"text"}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"These are the parameter types a "},{"code":"run","type":"codeVoice"},{"type":"text","text":" method can take:"}]},{"type":"termList","items":[{"term":{"inlineContent":[{"type":"reference","identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/Query","isActive":true},{"type":"text","text":" and "},{"type":"reference","identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/Query\/Where","isActive":true}]},"definition":{"content":[{"type":"paragraph","inlineContent":[{"text":"Reads components.","type":"text"}]}]}},{"term":{"inlineContent":[{"isActive":true,"type":"reference","identifier":"doc:\/\/Systems\/documentation\/Systems\/Update"}]},"definition":{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Writes components, optionally reading others."}]}]}},{"term":{"inlineContent":[{"type":"reference","identifier":"doc:\/\/Systems\/documentation\/Systems\/ResourceReader","isActive":true},{"type":"text","text":" and "},{"type":"reference","identifier":"doc:\/\/Systems\/documentation\/Systems\/ResourceWriter","isActive":true}]},"definition":{"content":[{"inlineContent":[{"type":"text","text":"Read or write a resource."}],"type":"paragraph"}]}},{"term":{"inlineContent":[{"identifier":"doc:\/\/Systems\/documentation\/Systems\/EventReader","isActive":true,"type":"reference"},{"text":" and ","type":"text"},{"identifier":"doc:\/\/Systems\/documentation\/Systems\/EventWriter","isActive":true,"type":"reference"}]},"definition":{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Read or send events."}]}]}},{"term":{"inlineContent":[{"type":"reference","identifier":"doc:\/\/Systems\/documentation\/Systems\/RemovedComponents","isActive":true}]},"definition":{"content":[{"type":"paragraph","inlineContent":[{"text":"Lists the entities that lost a component.","type":"text"}]}]}},{"term":{"inlineContent":[{"code":"inout","type":"codeVoice"},{"text":" ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/Commands"}]},"definition":{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Queues structural changes, which apply at the end of the system’s wave and conflict with nothing."}]}]}}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"A "},{"type":"codeVoice","code":"run"},{"type":"text","text":" method that takes the world instead, as "},{"type":"codeVoice","code":"inout World"},{"type":"text","text":", makes a system with no access,"},{"type":"text","text":" "},{"type":"text","text":"which can change anything and so runs alone:"}]},{"type":"codeListing","code":["@System","struct SpawnBall {","    func run(in world: inout World) {","        world.spawn(Position(x: 0, y: 100), Velocity(dx: 0, dy: 0))","    }","}","","var world = World()","Schedule { SpawnBall() }.run(on: &world)","print(world.count)","\/\/ Prints \"1\""],"syntax":"swift"},{"type":"paragraph","inlineContent":[{"text":"Mark the type or its ","type":"text"},{"type":"codeVoice","code":"run"},{"text":" method ","type":"text"},{"type":"codeVoice","code":"@MainActor"},{"text":" to make a ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/Systems\/documentation\/Systems\/MainActorSystem"},{"text":" instead.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"The macro reads only the method’s signature. Two parameters whose written types conflict,","type":"text"},{"text":" ","type":"text"},{"text":"such as an ","type":"text"},{"type":"codeVoice","code":"Update<Position>"},{"text":" and a ","type":"text"},{"type":"codeVoice","code":"Query<Position>"},{"text":", are a compile-time error. A conflict the","type":"text"},{"text":" ","type":"text"},{"text":"written types hide, such as one type spelled through a type alias, traps when the system is","type":"text"},{"text":" ","type":"text"},{"text":"scheduled.","type":"text"}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"The code the macro generates refers to "},{"type":"codeVoice","code":"World"},{"type":"text","text":", "},{"type":"codeVoice","code":"Access"},{"type":"text","text":" and "},{"type":"codeVoice","code":"Commands"},{"type":"text","text":", so the file must"},{"type":"text","text":" "},{"type":"text","text":"import "},{"type":"codeVoice","code":"ECS"},{"type":"text","text":", or both "},{"type":"codeVoice","code":"WorldModule"},{"type":"text","text":" and "},{"type":"codeVoice","code":"Systems"},{"type":"text","text":"."}]}],"kind":"content"}],"abstract":[{"text":"Makes a type a system whose access comes from the parameters of its ","type":"text"},{"code":"run","type":"codeVoice"},{"text":" method.","type":"text"}],"seeAlsoSections":[{"anchor":"Essentials","generated":true,"identifiers":["doc:\/\/Systems\/documentation\/Systems\/DeclaringSystems","doc:\/\/Systems\/documentation\/Systems\/System"],"title":"Essentials"}],"references":{"doc://WorldModule/documentation/WorldModule/Query/Where":{"identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/Query\/Where","kind":"symbol","url":"\/documentation\/worldmodule\/query\/where","type":"topic","abstract":[{"text":"A query whose filter a system spells as types.","type":"text"}],"title":"Query.Where","navigatorTitle":[{"text":"Where","kind":"identifier"}],"role":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Where","kind":"ident