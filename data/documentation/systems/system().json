{"abstract":[{"text":"Makes a type a system whose access comes from the parameters of its ","type":"text"},{"code":"run","type":"codeVoice"},{"text":" method.","type":"text"}],"sections":[],"primaryContentSections":[{"kind":"declarations","declarations":[{"tokens":[{"text":"@attached","kind":"attribute"},{"text":"(extension, conformances: ","kind":"text"},{"text":"System","preciseIdentifier":"s:7Systems6SystemP","identifier":"doc:\/\/Systems\/documentation\/Systems\/System","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"MainActorSystem","preciseIdentifier":"s:7Systems15MainActorSystemP","identifier":"doc:\/\/Systems\/documentation\/Systems\/MainActorSystem","kind":"typeIdentifier"},{"text":", names: named(access), named(run), named(initialize)) ","kind":"text"},{"text":"macro","kind":"keyword"},{"text":" ","kind":"text"},{"text":"System","kind":"identifier"},{"text":"()","kind":"text"}],"languages":["swift"],"platforms":["Linux"]}]},{"content":[{"type":"heading","anchor":"overview","text":"Overview","level":2},{"type":"paragraph","inlineContent":[{"type":"text","text":"Attach "},{"code":"@System","type":"codeVoice"},{"type":"text","text":" to a structure with a method named "},{"code":"run","type":"codeVoice"},{"type":"text","text":". The method’s parameters are"},{"type":"text","text":" "},{"type":"text","text":"system parameters, values the schedule fetches from the world before each run, and their"},{"type":"text","text":" "},{"type":"text","text":"types state exactly what the system reads and writes. The macro conforms the type to"},{"type":"text","text":" "},{"identifier":"doc:\/\/Systems\/documentation\/Systems\/System","type":"reference","isActive":true},{"type":"text","text":", writing its "},{"identifier":"doc:\/\/Systems\/documentation\/Systems\/System\/access","type":"reference","isActive":true},{"type":"text","text":" from those types and a "},{"identifier":"doc:\/\/Systems\/documentation\/Systems\/System\/run(in:)","type":"reference","isActive":true},{"type":"text","text":" that"},{"type":"text","text":" "},{"type":"text","text":"fetches the parameters and calls your method."}]},{"type":"paragraph","inlineContent":[{"text":"The following system moves each entity by its velocity plus whichever of a wind and a","type":"text"},{"text":" ","type":"text"},{"text":"current act on it, scaled by the time step:","type":"text"}]},{"type":"codeListing","code":["struct Wind: Component { var speed: Double }","struct Current: Component { var speed: Double }","","@System","struct Drift {","    func run(","        _ drifters: Update<Position>.Over<Velocity, AnyOf<Wind, Current>>,","        _ step: ResourceReader<TimeStep>","    ) {","        drifters { position, row in","            let (velocity, (wind, current)) = row.components","            let push = (wind?.speed ?? 0) + (current?.speed ?? 0)","            position.x += (velocity.dx + push) * step.value.seconds","        }","    }","}","","var world = World()","world.resources.insert(TimeStep(seconds: 0.5))","let boat = world.spawn(Position(x: 0, y: 0), Velocity(dx: 2, dy: 0), Wind(speed: 4))","Schedule { Drift() }.run(on: &world)","print(world[Position.self, of: boat].x)","\/\/ Prints \"3.0\""],"syntax":"swift"},{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"Drift"},{"type":"text","text":" writes "},{"type":"codeVoice","code":"Position"},{"type":"text","text":", reads "},{"type":"codeVoice","code":"Velocity"},{"type":"text","text":", "},{"type":"codeVoice","code":"Wind"},{"type":"text","text":", "},{"type":"codeVoice","code":"Current"},{"type":"text","text":" and the "},{"type":"codeVoice","code":"TimeStep"},{"type":"text","text":" resource,"},{"type":"text","text":" "},{"type":"text","text":"and nothing else, so a schedule runs it at the same time as any system that doesn’t write"},{"type":"text","text":" "},{"type":"text","text":"those types."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"These are the parameter types a "},{"type":"codeVoice","code":"run"},{"type":"text","text":" method can take:"}]},{"type":"termList","items":[{"definition":{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Reads components."}]}]},"term":{"inlineContent":[{"identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/Query","type":"reference","isActive":true},{"type":"text","text":" and "},{"identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/Query\/Where","type":"reference","isActive":true}]}},{"definition":{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Writes components, optionally reading others."}]}]},"term":{"inlineContent":[{"isActive":true,"type":"reference","identifier":"doc:\/\/Systems\/documentation\/Systems\/Update"}]}},{"definition":{"content":[{"type":"paragraph","inlineContent":[{"text":"Read or write a resource.","type":"text"}]}]},"term":{"inlineContent":[{"identifier":"doc:\/\/Systems\/documentation\/Systems\/ResourceReader","isActive":true,"type":"reference"},{"text":" and ","type":"text"},{"identifier":"doc:\/\/Systems\/documentation\/Systems\/ResourceWriter","isActive":true,"type":"reference"}]}},{"definition":{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Read or send events."}]}]},"term":{"inlineContent":[{"type":"reference","isActive":true,"identifier":"doc:\/\/Systems\/documentation\/Systems\/EventReader"},{"type":"text","text":" and "},{"type":"reference","isActive":true,"identifier":"doc:\/\/Systems\/documentation\/Systems\/EventWriter"}]}},{"definition":{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Lists the entities that lost a component."}]}]},"term":{"inlineContent":[{"identifier":"doc:\/\/Systems\/documentation\/Systems\/RemovedComponents","isActive":true,"type":"reference"}]}},{"definition":{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Queues structural changes, which apply at the end of the system’s wave and conflict with nothing."}]}]},"term":{"inlineContent":[{"type":"codeVoice","code":"inout"},{"type":"text","text":" "},{"identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/Commands","type":"reference","isActive":true}]}}]},{"type":"paragraph","inlineContent":[{"text":"A ","type":"text"},{"code":"run","type":"codeVoice"},{"text":" method that takes the world instead, as ","type":"text"},{"code":"inout World","type":"codeVoice"},{"text":", makes a system with no access,","type":"text"},{"text":" ","type":"text"},{"text":"which can change anything and so runs alone:","type":"text"}]},{"type":"codeListing","code":["@System","struct SpawnBall {","    func run(in world: inout World) {","        world.spawn(Position(x: 0, y: 100), Velocity(dx: 0, dy: 0))","    }","}","","var world = World()","Schedule { SpawnBall() }.run(on: &world)","print(world.count)","\/\/ Prints \"1\""],"syntax":"swift"},{"type":"paragraph","inlineContent":[{"text":"Mark the type or its ","type":"text"},{"code":"run","type":"codeVoice"},{"text":" method ","type":"text"},{"code":"@MainActor","type":"codeVoice"},{"text":" to make a ","type":"text"},{"identifier":"doc:\/\/Systems\/documentation\/Systems\/MainActorSystem","type":"reference","isActive":true},{"text":" instead.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"The macro reads only the method’s signature. Two parameters whose written types conflict,","type":"text"},{"text":" ","type":"text"},{"text":"such as an ","type":"text"},{"code":"Update<Position>","type":"codeVoice"},{"text":" and a ","type":"text"},{"code":"Query<Position>","type":"codeVoice"},{"text":", are a compile-time error. A conflict the","type":"text"},{"text":" ","type":"text"},{"text":"written types hide, such as one type spelled through a type alias, traps when the system is","type":"text"},{"text":" ","type":"text"},{"text":"scheduled.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"The code the macro generates refers to ","type":"text"},{"type":"codeVoice","code":"World"},{"text":", ","type":"text"},{"type":"codeVoice","code":"Access"},{"text":" and ","type":"text"},{"type":"codeVoice","code":"Commands"},{"text":", so the file must","type":"text"},{"text":" ","type":"text"},{"text":"import ","type":"text"},{"type":"codeVoice","code":"ECS"},{"text":", or both ","type":"text"},{"type":"codeVoice","code":"WorldModule"},{"text":" and ","type":"text"},{"type":"codeVoice","code":"Systems"},{"text":".","type":"text"}]}],"kind":"content"}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/systems\/system()"]}],"kind":"symbol","hierarchy":{"paths":[["doc:\/\/Systems\/documentation\/Systems"]]},"seeAlsoSections":[{"title":"Essentials","anchor":"Essentials","generated":true,"identifiers":["doc:\/\/Systems\/documentation\/Systems\/DeclaringSystems","doc:\/\/Systems\/documentation\/Systems\/DrivingAWorldFromAnApp","doc:\/\/Systems\/documentation\/Systems\/System"]}],"identifier":{"url":"doc:\/\/Systems\/documentation\/Systems\/System()","interfaceLanguage":"swift"},"metadata":{"role":"symbol","title":"System()","symbolKind":"macro","externalID":"s:7Systems6Systemyycfm","fragments":[{"kind":"keyword","text":"macro"},{"kind":"text","text":" "},{"kind":"identifier","text":"System"},{"kind":"text","text":"()"}],"roleHeading":"Macro","modules":[{"name":"Systems"}],"remoteSource":{"fileName":"SystemMacro.swift","url":"https:\/\/github.com\/Tyler-Keith-Thompson\/ECS\/blob\/main\/Sources\/Systems\/SystemMacro.swift#L81"}},"schemaVersion":{"patch":0,"minor":3,"major":0},"references":{"doc://Systems/documentation/Systems/DrivingAWorldFromAnApp":{"identifier":"doc:\/\/Systems\/documentation\/Systems\/DrivingAWorldFromAnApp","type":"topic","abstract":[{"type":"text","text":"Hold a world in your app or game engine, feed it each frame’s input, and let the objects outside"},{"type":"text","text":" "},{"type":"text","text":"it read results and take part in a step."}],"role":"article","title":"Driving a World from an A