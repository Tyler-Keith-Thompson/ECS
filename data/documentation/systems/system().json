},{"identifier":"doc:\/\/Systems\/documentation\/Systems\/System\/access","type":"reference","isActive":true},{"text":" from those types and a ","type":"text"},{"identifier":"doc:\/\/Systems\/documentation\/Systems\/System\/run(in:)","type":"reference","isActive":true},{"text":" that","type":"text"},{"text":" ","type":"text"},{"text":"fetches the parameters and calls your method.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"The following system moves each entity by its velocity plus whichever of a wind and a","type":"text"},{"text":" ","type":"text"},{"text":"current act on it, scaled by the time step:","type":"text"}]},{"syntax":"swift","type":"codeListing","code":["struct Wind: Component { var speed: Double }","struct Current: Component { var speed: Double }","","@System","struct Drift {","    func run(","        _ drifters: Update<Position>.Over<Velocity, AnyOf<Wind, Current>>,","        _ step: ResourceReader<TimeStep>","    ) {","        drifters { position, row in","            let (velocity, (wind, current)) = row.components","            let push = (wind?.speed ?? 0) + (current?.speed ?? 0)","            position.x += (velocity.dx + push) * step.value.seconds","        }","    }","}","","var world = World()","world.resources.insert(TimeStep(seconds: 0.5))","let boat = world.spawn(Position(x: 0, y: 0), Velocity(dx: 2, dy: 0), Wind(speed: 4))","Schedule { Drift() }.run(on: &world)","print(world[Position.self, of: boat].x)","\/\/ Prints \"3.0\""]},{"type":"paragraph","inlineContent":[{"code":"Drift","type":"codeVoice"},{"text":" writes ","type":"text"},{"code":"Position","type":"codeVoice"},{"text":", reads ","type":"text"},{"code":"Velocity","type":"codeVoice"},{"text":", ","type":"text"},{"code":"Wind","type":"codeVoice"},{"text":", ","type":"text"},{"code":"Current","type":"codeVoice"},{"text":" and the ","type":"text"},{"code":"TimeStep","type":"codeVoice"},{"text":" resource,","type":"text"},{"text":" ","type":"text"},{"text":"and nothin