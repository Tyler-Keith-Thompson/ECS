Systems/System/run(in:)":{"required":true,"title":"run(in:)","role":"symbol","identifier":"doc:\/\/Systems\/documentation\/Systems\/System\/run(in:)","kind":"symbol","type":"topic","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"run","kind":"identifier"},{"text":"(","kind":"text"},{"text":"in","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"inout","kind":"keyword"},{"text":" ","kind":"text"},{"preciseIdentifier":"s:11WorldModule0A0V","text":"World","kind":"typeIdentifier"},{"text":")","kind":"text"}],"url":"\/documentation\/systems\/system\/run(in:)","abstract":[{"type":"text","text":"Runs the system’s rule once on a world."}]},"doc://WorldModule/documentation/WorldModule/Query/Where":{"identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/Query\/Where","title":"Query.Where","abstract":[{"type":"text","text":"A query whose filter a system spells as types."}],"role":"symbol","navigatorTitle":[{"kind":"identifier","text":"Where"}],"url":"\/documentation\/worldmodule\/query\/where","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"Where"}],"type":"topic","kind":"symbol"},"doc://Systems/documentation/Systems":{"identifier":"doc:\/\/Systems\/documentation\/Systems","type":"topic","role":"collection","abstract":[{"text":"Declare the rules of a simulation as systems, and run them on a world in a schedule.","type":"text"}],"url":"\/documentation\/systems","kind":"symbol","title":"Systems"},"doc://Systems/documentation/Systems/Update":{"identifier":"doc:\/\/Systems\/documentation\/Systems\/Update","type":"topic","navigatorTitle":[{"kind":"identifier","text":"Update"}],"role":"symbol","url":"\/documentation\/systems\/update","abstract":[{"text":"A system parameter that changes a component of every entity that holds it.","type":"text"}],"fragments":[{"kind":"keyword","text":"class"},{"kind":"text","text":" "},{"kind":"identifier","text":"Update"}],"title":"Update","kind