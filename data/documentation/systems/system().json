{"schemaVersion":{"major":0,"patch":0,"minor":3},"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/Systems\/documentation\/Systems\/System()"},"primaryContentSections":[{"kind":"declarations","declarations":[{"languages":["swift"],"platforms":["Linux"],"tokens":[{"text":"@attached","kind":"attribute"},{"text":"(extension, conformances: ","kind":"text"},{"text":"System","identifier":"doc:\/\/Systems\/documentation\/Systems\/System","kind":"typeIdentifier","preciseIdentifier":"s:7Systems6SystemP"},{"text":", ","kind":"text"},{"text":"MainActorSystem","identifier":"doc:\/\/Systems\/documentation\/Systems\/MainActorSystem","kind":"typeIdentifier","preciseIdentifier":"s:7Systems15MainActorSystemP"},{"text":", names: named(access), named(run), named(initialize)) ","kind":"text"},{"text":"macro","kind":"keyword"},{"text":" ","kind":"text"},{"text":"System","kind":"identifier"},{"text":"()","kind":"text"}]}]},{"kind":"content","content":[{"anchor":"overview","type":"heading","level":2,"text":"Overview"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Attach "},{"type":"codeVoice","code":"@System"},{"type":"text","text":" to a structure with a method named "},{"type":"codeVoice","code":"run"},{"type":"text","text":". The method’s parameters are"},{"type":"text","text":" "},{"type":"text","text":"system parameters, values the schedule fetches from the world before each run, and their"},{"type":"text","text":" "},{"type":"text","text":"types state exactly what the system reads and writes. The macro conforms the type to"},{"type":"text","text":" "},{"type":"reference","identifier":"doc:\/\/Systems\/documentation\/Systems\/System","isActive":true},{"type":"text","text":", writing its "},{"type":"reference","identifier":"doc:\/\/Systems\/documentation\/Systems\/System\/access","isActive":true},{"type":"text","text":" from those types and a "},{"type":"reference","identifier":"doc:\/\/Systems\/documentation\/Systems\/System\/run(in:)","isActive":true},{"type":"text","text":" that"},{"type":"text","text":" "},{"type":"text","text":"fetches the parameters and calls your method."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"The following system moves each entity by its velocity plus whichever of a wind and a"},{"type":"text","text":" "},{"type":"text","text":"current act on it, scaled by the time step:"}]},{"syntax":"swift","type":"codeListing","code":["struct Wind: Component { var speed: Double }","struct Current: Component { var speed: Double }","","@System","struct Drift {","    func run(","        _ drifters: Update<Position>.Over<Velocity, AnyOf<Wind, Current>>,","        _ step: ResourceReader<TimeStep>","    ) {","        drifters { position, row in","            let (velocity, (wind, current)) = row.components","            let push = (wind?.speed ?? 0) + (current?.speed ?? 0)","            position.x += (velocity.dx + push) * step.value.seconds","        }","    }","}","","var world = World()","world.resources.insert(TimeStep(seconds: 0.5))","let boat = world.spawn(Position(x: 0, y: 0), Velocity(dx: 2, dy: 0), Wind(speed: 4))","Schedule { Drift() }.run(on: &world)","print(world[Position.self, of: boat].x)","\/\/ Prints \"3.0\""]},{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"Drift"},{"type":"text","text":" writes "},{"type":"codeVoice","code":"Position"},{"type":"text","text":", reads "},{"type":"codeVoice","code":"Velocity"},{"type":"text","text":", "},{"type":"codeVoice","code":"Wind"},{"type":"text","text":", "},{"type":"codeVoice","code":"Current"},{"type":"text","text":" and the "},{"type":"codeVoice","code":"TimeStep"},{"type":"text","text":" resource,"},{"type":"text","text":" "},{"type":"text","text":"and nothing else, so a schedule runs it at the same time as any system that doesn’t write"},{"type":"text","text":" "},{"type":"text","text":"those types."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"These are the parameter types a "},{"type":"codeVoice","code":"run"},{"type":"text","text":" method can take:"}]},{"type":"termList","items":[{"term":{"inlineContent":[{"identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/Query","isActive":true,"type":"reference"},{"text":" and ","type":"text"},{"identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/Query\/Where","isActive":true,"type":"reference"}]},"definition":{"content":[{"inlineContent":[{"type":"text","text":"Reads components."}],"type":"paragraph"}]}},{"term":{"inlineContent":[{"isActive":true,"type":"reference","identifier":"doc:\/\/Systems\/documentation\/Systems\/Update"}]},"definition":{"content":[{"type":"paragraph","inlineContent":[{"text":"Writes components, optionally reading others.","type":"text"}]}]}},{"term":{"inlineContent":[{"type":"reference","identifier":"doc:\/\/Systems\/documentation\/Systems\/ResourceReader","isActive":true},{"type":"text","text":" and "},{"type":"reference","identifier":"doc:\/\/Systems\/documentation\/Systems\/ResourceWriter","isActive":true}]},"definition":{"content":[{"type":"paragraph","inlineContent":[{"text":"Read or write a resource.","type":"text"}]}]}},{"term":{"inlineContent":[{"type":"reference","isActive":true,"identifier":"doc:\/\/Systems\/documentation\/Systems\/EventReader"},{"type":"text","text":" and "},{"type":"reference","isActive":true,"identifier":"doc:\/\/Systems\/documentation\/Systems\/EventWriter"}]},"definition":{"content":[{"inlineContent":[{"text":"Read or send events.","type":"text"}],"type":"paragraph"}]}},{"term":{"inlineContent":[{"identifier":"doc:\/\/Systems\/documentation\/Systems\/RemovedComponents","isActive":true,"type":"reference"}]},"definition":{"content":[{"inlineContent":[{"type":"text","text":"Lists the entities that lost a component."}],"type":"paragraph"}]}},{"term":{"inlineContent":[{"type":"codeVoice","code":"inout"},{"type":"text","text":" "},{"isActive":true,"type":"reference","identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/Commands"}]},"definition":{"content":[{"inlineContent":[{"text":"Queues structural changes, which apply at the end of the system’s wave and conflict with nothing.","type":"text"}],"type":"paragraph"}]}}]},{"type":"paragraph","inlineContent":[{"text":"A ","type":"text"},{"code":"run","type":"codeVoice"},{"text":" method that takes the world instead, as ","type":"text"},{"code":"inout World","type":"codeVoice"},{"text":", makes a system with no access,","type":"text"},{"text":" ","type":"text"},{"text":"which can change anything and so runs alone:","type":"text"}]},{"syntax":"swift","type":"codeListing","code":["@System","struct SpawnBall {","    func run(in world: inout World) {","        world.spawn(Position(x: 0, y: 100), Velocity(dx: 0, dy: 0))","    }","}","","var world = World()","Schedule { SpawnBall() }.run(on: &world)","print(world.count)","\/\/ Prints \"1\""]},{"type":"paragraph","inlineContent":[{"text":"Mark the type or its ","type":"text"},{"code":"run","type":"codeVoice"},{"text":" method ","type":"text"},{"code":"@MainActor","type":"codeVoice"},{"text":" to make a ","type":"text"},{"identifier":"doc:\/\/Systems\/documentation\/Systems\/MainActorSystem","isActive":true,"type":"reference"},{"text":" instead.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"The macro reads only the method’s signature. Two parameters whose written types conflict,","type":"text"},{"text":" ","type":"text"},{"text":"such as an ","type":"text"},{"code":"Update<Position>","type":"codeVoice"},{"text":" and a ","type":"text"},{"code":"Query<Position>","type":"codeVoice"},{"text":", are a compile-time error. A conflict the","type":"text"},{"text":" ","type":"text"},{"text":"written types hide, such as one type spelled through a type alias, traps when the system is","type":"text"},{"text":" ","type":"text"},{"text":"scheduled.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"The code the macro generates refers to ","type":"text"},{"code":"World","type":"codeVoice"},{"text":", ","type":"text"},{"code":"Access","type":"codeVoice"},{"text":" and ","type":"text"},{"code":"Commands","type":"codeVoice"},{"text":", so the file must","type":"text"},{"text":" ","type":"text"},{"text":"import ","type":"text"},{"code":"ECS","type":"codeVoice"},{"text":", or both ","type":"text"},{"code":"WorldModule","type":"codeVoice"},{"text":" and ","type":"text"},{"code":"Systems","type":"codeVoice"},{"text":".","type":"text"}]}]}],"kind":"symbol","variants":[{"paths":["\/documentation\/systems\/system()"],"traits":[{"interfaceLanguage":"swift"}]}],"metadata":{"modules":[{"name":"Systems"}],"symbolKind":"macro","fragments":[{"text":"macro","kind":"keyword"},{"text":" ","kind":"text"},{"text":"System","kind":"identifier"},{"text":"()","kind":"text"}],"roleHeading":"Macro","title":"System()","role":"symbol","remoteSource":{"fileName":"SystemMacro.swift","url":"https:\/\/github.com\/Tyler-Keith-Thompson\/ECS\/blob\/main\/Sources\/Systems\/SystemMacro.swift#L81"},"externalID":"s:7Systems6Systemyycfm"},"hierarchy":{"paths":[["doc:\/\/Systems\/documentation\/Systems"]]},"abstract":[{"text":"Makes a type a system whose access comes from the parameters of its ","type":"text"},{"code":"run","type":"codeVoice"},{"text":" method.","type":"text"}],"seeAlsoSections":[{"identifiers":["doc:\/\/Systems\/documentation\/Systems\/DeclaringSystems","doc:\/\/Systems\/documentation\/Systems\/DrivingAWorldFromAnApp","doc:\/\/Systems\/documentation\/Systems\/System"],"generated":true,"anchor":"Essentials","title":"Essentials"}],"sections":[],"references":{"doc://Systems/documentation/Systems/EventReader":{"url":"\/documentation\/systems\/eventreader","title":"EventReader","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"EventReader","kind":"identifier"}],"navigatorTitle":[{"text":"EventReader","kind":"identifier"}],"kind":"symbol","abstract":[{"text":"A system parameter that reads the events of one type sent since the system last read them.","type"