{"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/Systems\/documentation\/Systems\/System()"},"primaryContentSections":[{"declarations":[{"languages":["swift"],"platforms":["Linux"],"tokens":[{"kind":"attribute","text":"@attached"},{"kind":"text","text":"(extension, conformances: "},{"kind":"typeIdentifier","text":"System","identifier":"doc:\/\/Systems\/documentation\/Systems\/System","preciseIdentifier":"s:7Systems6SystemP"},{"kind":"text","text":", "},{"kind":"typeIdentifier","text":"MainActorSystem","identifier":"doc:\/\/Systems\/documentation\/Systems\/MainActorSystem","preciseIdentifier":"s:7Systems15MainActorSystemP"},{"kind":"text","text":", names: named(access), named(run), named(initialize)) "},{"kind":"keyword","text":"macro"},{"kind":"text","text":" "},{"kind":"identifier","text":"System"},{"kind":"text","text":"()"}]}],"kind":"declarations"},{"content":[{"type":"heading","level":2,"text":"Overview","anchor":"overview"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Attach "},{"type":"codeVoice","code":"@System"},{"type":"text","text":" to a structure with a method named "},{"type":"codeVoice","code":"run"},{"type":"text","text":". The method’s parameters are"},{"type":"text","text":" "},{"type":"text","text":"system parameters, values the schedule fetches from the world before each run, and their"},{"type":"text","text":" "},{"type":"text","text":"types state exactly what the system reads and writes. The macro conforms the type to"},{"type":"text","text":" "},{"type":"reference","identifier":"doc:\/\/Systems\/documentation\/Systems\/System","isActive":true},{"type":"text","text":", writing its "},{"type":"reference","identifier":"doc:\/\/Systems\/documentation\/Systems\/System\/access","isActive":true},{"type":"text","text":" from those types and a "},{"type":"reference","identifier":"doc:\/\/Systems\/documentation\/Systems\/System\/run(in:)","isActive":true},{"type":"text","text":" that"},{"type":"text","text":" "},{"type":"text","text":"fetches the parameters and calls your method."}]},{"type":"paragraph","inlineContent":[{"text":"The following system moves each entity by its velocity plus whichever of a wind and a","type":"text"},{"text":" ","type":"text"},{"text":"current act on it, scaled by the time step:","type":"text"}]},{"code":["struct Wind: Component { var speed: Double }","struct Current: Component { var speed: Double }","","@System","struct Drift {","    func run(","        _ drifters: Update<Position>.Over<Velocity, AnyOf<Wind, Current>>,","        _ step: ResourceReader<TimeStep>","    ) {","        drifters { position, row in","            let (velocity, (wind, current)) = row.components","            let push = (wind?.speed ?? 0) + (current?.speed ?? 0)","            position.x += (velocity.dx + push) * step.value.seconds","        }","    }","}","","var world = World()","world.resources.insert(TimeStep(seconds: 0.5))","let boat = world.spawn(Position(x: 0, y: 0), Velocity(dx: 2, dy: 0), Wind(speed: 4))","Schedule { Drift() }.run(on: &world)","print(world[Position.self, of: boat].x)","\/\/ Prints \"3.0\""],"type":"codeListing","syntax":"swift"},{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"Drift"},{"text":" writes ","type":"text"},{"type":"codeVoice","code":"Position"},{"text":", reads ","type":"text"},{"type":"codeVoice","code":"Velocity"},{"text":", ","type":"text"},{"type":"codeVoice","code":"Wind"},{"text":", ","type":"text"},{"type":"codeVoice","code":"Current"},{"text":" and the ","type":"text"},{"type":"codeVoice","code":"TimeStep"},{"text":" resource,","type":"text"},{"text":" ","type":"text"},{"text":"and nothing else, so a schedule runs it at the same time as any system that doesn’t write","type":"text"},{"text":" ","type":"text"},{"text":"those types.","type":"text"}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"These are the parameter types a "},{"type":"codeVoice","code":"run"},{"type":"text","text":" method can take:"}]},{"type":"termList","items":[{"definition":{"content":[{"type":"paragraph","inlineContent":[{"text":"Reads components.","type":"text"}]}]},"term":{"inlineContent":[{"type":"reference","identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/Query","isActive":true},{"type":"text","text":" and "},{"type":"reference","identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/Query\/Where","isActive":true}]}},{"definition":{"content":[{"type":"paragraph","inlineContent":[{"text":"Writes components, optionally reading others.","type":"text"}]}]},"term":{"inlineContent":[{"isActive":true,"type":"reference","identifier":"doc:\/\/Systems\/documentation\/Systems\/Update"}]}},{"definition":{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Read or write a resource."}]}]},"term":{"inlineContent":[{"type":"reference","isActive":true,"identifier":"doc:\/\/Systems\/documentation\/Systems\/ResourceReader"},{"type":"text","text":" and "},{"type":"reference","isActive":true,"identifier":"doc:\/\/Systems\/documentation\/Systems\/ResourceWriter"}]}},{"definition":{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Read or send events."}]}]},"term":{"inlineContent":[{"type":"reference","identifier":"doc:\/\/Systems\/documentation\/Systems\/EventReader","isActive":true},{"text":" and ","type":"text"},{"type":"reference","identifier":"doc:\/\/Systems\/documentation\/Systems\/EventWriter","isActive":true}]}},{"definition":{"content":[{"type":"paragraph","inlineContent":[{"text":"Lists the entities that lost a component.","type":"text"}]}]},"term":{"inlineContent":[{"isActive":true,"type":"reference","identifier":"doc:\/\/Systems\/documentation\/Systems\/RemovedComponents"}]}},{"definition":{"content":[{"inlineContent":[{"type":"text","text":"Queues structural changes, which apply at the end of the system’s wave and conflict with nothing."}],"type":"paragraph"}]},"term":{"inlineContent":[{"type":"codeVoice","code":"inout"},{"type":"text","text":" "},{"type":"reference","identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/Commands","isActive":true}]}}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"A "},{"type":"codeVoice","code":"run"},{"type":"text","text":" method that takes the world instead, as "},{"type":"codeVoice","code":"inout World"},{"type":"text","text":", makes a system with no access,"},{"type":"text","text":" "},{"type":"text","text":"which can change anything and so runs alone:"}]},{"code":["@System","struct SpawnBall {","    func run(in world: inout World) {","        world.spawn(Position(x: 0, y: 100), Velocity(dx: 0, dy: 0))","    }","}","","var world = World()","Schedule { SpawnBall() }.run(on: &world)","print(world.count)","\/\/ Prints \"1\""],"type":"codeListing","syntax":"swift"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Mark the type or its "},{"type":"codeVoice","code":"run"},{"type":"text","text":" method "},{"type":"codeVoice","code":"@MainActor"},{"type":"text","text":" to make a "},{"isActive":true,"type":"reference","identifier":"doc:\/\/Systems\/documentation\/Systems\/MainActorSystem"},{"type":"text","text":" instead."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"The macro reads only the method’s signature. Two parameters whose written types conflict,"},{"type":"text","text":" "},{"type":"text","text":"such as an "},{"type":"codeVoice","code":"Update<Position>"},{"type":"text","text":" and a "},{"type":"codeVoice","code":"Query<Position>"},{"type":"text","text":", are a compile-time error. A conflict the"},{"type":"text","text":" "},{"type":"text","text":"written types hide, such as one type spelled through a type alias, traps when the system is"},{"type":"text","text":" "},{"type":"text","text":"scheduled."}]},{"type":"paragraph","inlineContent":[{"text":"The code the macro generates refers to ","type":"text"},{"type":"codeVoice","code":"World"},{"text":", ","type":"text"},{"type":"codeVoice","code":"Access"},{"text":" and ","type":"text"},{"type":"codeVoice","code":"Commands"},{"text":", so the file must","type":"text"},{"text":" ","type":"text"},{"text":"import ","type":"text"},{"type":"codeVoice","code":"ECS"},{"text":", or both ","type":"text"},{"type":"codeVoice","code":"WorldModule"},{"text":" and ","type":"text"},{"type":"codeVoice","code":"Systems"},{"text":".","type":"text"}]}],"kind":"content"}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/systems\/system()"]}],"sections":[],"hierarchy":{"paths":[["doc:\/\/Systems\/documentation\/Systems"]]},"metadata":{"modules":[{"name":"Systems"}],"symbolKind":"macro","externalID":"s:7Systems6Systemyycfm","title":"System()","roleHeading":"Macro","remoteSource":{"url":"https:\/\/github.com\/Tyler-Keith-Thompson\/ECS\/blob\/main\/Sources\/Systems\/SystemMacro.swift#L81","fileName":"SystemMacro.swift"},"role":"symbol","fragments":[{"text":"macro","kind":"keyword"},{"text":" ","kind":"text"},{"text":"System","kind":"identifier"},{"text":"()","kind":"text"}]},"schemaVersion":{"minor":3,"major":0,"patch":0},"kind":"symbol","abstract":[{"text":"Makes a type a system whose access comes from the parameters of its ","type":"text"},{"code":"run","type":"codeVoice"},{"text":" method.","type":"text"}],"seeAlsoSections":[{"generated":true,"identifiers":["doc:\/\/Systems\/documentation\/Systems\/DeclaringSystems","doc:\/\/Systems\/documentation\/Systems\/System"],"anchor":"Essentials","title":"Essentials"}],"references":{"doc://WorldModule/documentation/WorldModule/Query/Where":{"identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/Query\/Where","navigatorTitle":[{"kind":"identifier","text":"Where"}],"type":"topic","abstract":[{"type":"text","text":"A query whose filter a system spells as types."}],"title":"Query.Where","role":"symbol","url":"\/documentation\/worldmodule\/query\/where","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"Where"}],"kind":