 app or game engine, feed it each frame’s input, and let the objects outside"},{"type":"text","text":" "},{"type":"text","text":"it read results and take part in a step."}],"title":"Driving a World from an App","url":"\/documentation\/systems\/drivingaworldfromanapp","identifier":"doc:\/\/Systems\/documentation\/Systems\/DrivingAWorldFromAnApp","role":"article","kind":"article"},"doc://WorldModule/documentation/WorldModule/Commands":{"type":"topic","abstract":[{"text":"A buffer of changes to a world, recorded now and applied later in the order they were","type":"text"},{"text":" ","type":"text"},{"text":"recorded.","type":"text"}],"title":"Commands","url":"\/documentation\/worldmodule\/commands","identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/Commands","navigatorTitle":[{"kind":"identifier","text":"Commands"}],"role":"symbol","kind":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"Commands"}]},"doc://WorldModule/documentation/WorldModule/Query":{"abstract":[{"type":"text","text":"A description of the entities to visit and the components to read from each."}],"role":"symbol","title":"Query","identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/Query","type":"topic","url":"\/documentation\/worldmodule\/query","kind":"symbol","navigatorTitle":[{"kind":"identifier","text":"Query"}],"fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"Query"}]}}}