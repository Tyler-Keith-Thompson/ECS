{"sections":[],"identifier":{"url":"doc:\/\/Systems\/documentation\/Systems\/System()","interfaceLanguage":"swift"},"hierarchy":{"paths":[["doc:\/\/Systems\/documentation\/Systems"]]},"abstract":[{"text":"Makes a type a system whose access comes from the parameters of its ","type":"text"},{"code":"run","type":"codeVoice"},{"text":" method.","type":"text"}],"seeAlsoSections":[{"title":"Essentials","identifiers":["doc:\/\/Systems\/documentation\/Systems\/DeclaringSystems","doc:\/\/Systems\/documentation\/Systems\/DrivingAWorldFromAnApp","doc:\/\/Systems\/documentation\/Systems\/System"],"generated":true,"anchor":"Essentials"}],"schemaVersion":{"major":0,"minor":3,"patch":0},"metadata":{"role":"symbol","externalID":"s:7Systems6Systemyycfm","title":"System()","fragments":[{"kind":"keyword","text":"macro"},{"kind":"text","text":" "},{"kind":"identifier","text":"System"},{"kind":"text","text":"()"}],"remoteSource":{"url":"https:\/\/github.com\/Tyler-Keith-Thompson\/ECS\/blob\/main\/Sources\/Systems\/SystemMacro.swift#L81","fileName":"SystemMacro.swift"},"symbolKind":"macro","roleHeading":"Macro","modules":[{"name":"Systems"}]},"primaryContentSections":[{"kind":"declarations","declarations":[{"tokens":[{"text":"@attached","kind":"attribute"},{"text":"(extension, conformances: ","kind":"text"},{"text":"System","preciseIdentifier":"s:7Systems6SystemP","identifier":"doc:\/\/Systems\/documentation\/Systems\/System","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"MainActorSystem","preciseIdentifier":"s:7Systems15MainActorSystemP","identifier":"doc:\/\/Systems\/documentation\/Systems\/MainActorSystem","kind":"typeIdentifier"},{"text":", names: named(access), named(run), named(initialize)) ","kind":"text"},{"text":"macro","kind":"keyword"},{"text":" ","kind":"text"},{"text":"System","kind":"identifier"},{"text":"()","kind":"text"}],"platforms":["Linux"],"languages":["swift"]}]},{"content":[{"level":2,"text":"Overview","anchor":"overview","type":"heading"},{"inlineContent":[{"text":"Attach ","type":"text"},{"code":"@System","type":"codeVoice"},{"text":" to a structure with a method named ","type":"text"},{"code":"run","type":"codeVoice"},{"text":". The method’s parameters are","type":"text"},{"text":" ","type":"text"},{"text":"system parameters, values the schedule fetches from the world before each run, and their","type":"text"},{"text":" ","type":"text"},{"text":"types state exactly what the system reads and writes. The macro conforms the type to","type":"text"},{"text":" ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/Systems\/documentation\/Systems\/System"},{"text":", writing its ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/Systems\/documentation\/Systems\/System\/access"},{"text":" from those types and a ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/Systems\/documentation\/Systems\/System\/run(in:)"},{"text":" that","type":"text"},{"text":" ","type":"text"},{"text":"fetches the parameters and calls your method.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"The following system moves each entity by its velocity plus whichever of a wind and a"},{"type":"text","text":" "},{"type":"text","text":"current act on it, scaled by the time step:"}],"type":"paragraph"},{"code":["struct Wind: Component { var speed: Double }","struct Current: Component { var speed: Double }","","@System","struct Drift {","    func run(","        _ drifters: Update<Position>.Over<Velocity, AnyOf<Wind, Current>>,","        _ step: ResourceReader<TimeStep>","    ) {","        drifters { position, row in","            let (velocity, (wind, current)) = row.components","            let push = (wind?.speed ?? 0) + (current?.speed ?? 0)","            position.x += (velocity.dx + push) * step.value.seconds","        }","    }","}","","var world = World()","world.resources.insert(TimeStep(seconds: 0.5))","let boat = world.spawn(Position(x: 0, y: 0), Velocity(dx: 2, dy: 0), Wind(speed: 4))","Schedule { Drift() }.run(on: &world)","print(world[Position.self, of: boat].x)","\/\/ Prints \"3.0\""],"syntax":"swift","type":"codeListing"},{"inlineContent":[{"type":"codeVoice","code":"Drift"},{"type":"text","text":" writes "},{"type":"codeVoice","code":"Position"},{"type":"text","text":", reads "},{"type":"codeVoice","code":"Velocity"},{"type":"text","text":", "},{"type":"codeVoice","code":"Wind"},{"type":"text","text":", "},{"type":"codeVoice","code":"Current"},{"type":"text","text":" and the "},{"type":"codeVoice","code":"TimeStep"},{"type":"text","text":" resource,"},{"type":"text","text":" "},{"type":"text","text":"and nothing else, so a schedule runs it at the same time as any system that doesn’t write"},{"type":"text","text":" "},{"type":"text","text":"those types."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"These are the parameter types a "},{"type":"codeVoice","code":"run"},{"type":"text","text":" method can take:"}],"type":"paragraph"},{"items":[{"definition":{"content":[{"inlineContent":[{"type":"text","text":"Reads components."}],"type":"paragraph"}]},"term":{"inlineContent":[{"isActive":true,"type":"reference","identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/Query"},{"type":"text","text":" and "},{"isActive":true,"type":"reference","identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/Query\/Where"}]}},{"definition":{"content":[{"inlineContent":[{"type":"text","text":"Writes components, optionally reading others."}],"type":"paragraph"}]},"term":{"inlineContent":[{"isActive":true,"type":"reference","identifier":"doc:\/\/Systems\/documentation\/Systems\/Update"}]}},{"definition":{"content":[{"inlineContent":[{"text":"Read or write a resource.","type":"text"}],"type":"paragraph"}]},"term":{"inlineContent":[{"isActive":true,"type":"reference","identifier":"doc:\/\/Systems\/documentation\/Systems\/ResourceReader"},{"text":" and ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/Systems\/documentation\/Systems\/ResourceWriter"}]}},{"definition":{"content":[{"inlineContent":[{"type":"text","text":"Read or send events."}],"type":"paragraph"}]},"term":{"inlineContent":[{"type":"reference","identifier":"doc:\/\/Systems\/documentation\/Systems\/EventReader","isActive":true},{"text":" and ","type":"text"},{"type":"reference","identifier":"doc:\/\/Systems\/documentation\/Systems\/EventWriter","isActive":true}]}},{"definition":{"content":[{"inlineContent":[{"type":"text","text":"Lists the entities that lost a component."}],"type":"paragraph"}]},"term":{"inlineContent":[{"identifier":"doc:\/\/Systems\/documentation\/Systems\/RemovedComponents","isActive":true,"type":"reference"}]}},{"definition":{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Queues structural changes, which apply at the end of the system’s wave and conflict with nothing."}]}]},"term":{"inlineContent":[{"code":"inout","type":"codeVoice"},{"text":" ","type":"text"},{"identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/Commands","isActive":true,"type":"reference"}]}}],"type":"termList"},{"inlineContent":[{"type":"text","text":"A "},{"type":"codeVoice","code":"run"},{"type":"text","text":" method that takes the world instead, as "},{"type":"codeVoice","code":"inout World"},{"type":"text","text":", makes a system with no access,"},{"type":"text","text":" "},{"type":"text","text":"which can change anything and so runs alone:"}],"type":"paragraph"},{"code":["@System","struct SpawnBall {","    func run(in world: inout World) {","        world.spawn(Position(x: 0, y: 100), Velocity(dx: 0, dy: 0))","    }","}","","var world = World()","Schedule { SpawnBall() }.run(on: &world)","print(world.count)","\/\/ Prints \"1\""],"syntax":"swift","type":"codeListing"},{"inlineContent":[{"type":"text","text":"Mark the type or its "},{"type":"codeVoice","code":"run"},{"type":"text","text":" method "},{"type":"codeVoice","code":"@MainActor"},{"type":"text","text":" to make a "},{"type":"reference","identifier":"doc:\/\/Systems\/documentation\/Systems\/MainActorSystem","isActive":true},{"type":"text","text":" instead."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"The macro reads only the method’s signature. Two parameters whose written types conflict,"},{"type":"text","text":" "},{"type":"text","text":"such as an "},{"code":"Update<Position>","type":"codeVoice"},{"type":"text","text":" and a "},{"code":"Query<Position>","type":"codeVoice"},{"type":"text","text":", are a compile-time error. A conflict the"},{"type":"text","text":" "},{"type":"text","text":"written types hide, such as one type spelled through a type alias, traps when the system is"},{"type":"text","text":" "},{"type":"text","text":"scheduled."}],"type":"paragraph"},{"inlineContent":[{"text":"The code the macro generates refers to ","type":"text"},{"code":"World","type":"codeVoice"},{"text":", ","type":"text"},{"code":"Access","type":"codeVoice"},{"text":" and ","type":"text"},{"code":"Commands","type":"codeVoice"},{"text":", so the file must","type":"text"},{"text":" ","type":"text"},{"text":"import ","type":"text"},{"code":"ECS","type":"codeVoice"},{"text":", or both ","type":"text"},{"code":"WorldModule","type":"codeVoice"},{"text":" and ","type":"text"},{"code":"Systems","type":"codeVoice"},{"text":".","type":"text"}],"type":"paragraph"}],"kind":"content"}],"variants":[{"paths":["\/documentation\/systems\/system()"],"traits":[{"interfaceLanguage":"swift"}]}],"kind":"symbol","references":{"doc://Systems/documentation/Systems/System":{"kind":"symbol","title":"System","identifier":"doc:\/\/Systems\/documentation\/Systems\/System","type":"topic","role":"symbol","navigatorTitle":[{"text":"System","kind":"identifier"}],"fragments":[{"text":"protocol","kind":"keyword"},{"text":" ","kind":"text"},{"text":"System","kind":"identifier"}],"abstract":[{"type":"text","text":"A rule that reads and changes a world, run once each t