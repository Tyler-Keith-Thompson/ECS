p.value.seconds","        }","    }","}","","var world = World()","world.resources.insert(TimeStep(seconds: 0.5))","let boat = world.spawn(Position(x: 0, y: 0), Velocity(dx: 2, dy: 0), Wind(speed: 4))","Schedule { Drift() }.run(on: &world)","print(world[Position.self, of: boat].x)","\/\/ Prints \"3.0\""]},{"type":"paragraph","inlineContent":[{"code":"Drift","type":"codeVoice"},{"text":" writes ","type":"text"},{"code":"Position","type":"codeVoice"},{"text":", reads ","type":"text"},{"code":"Velocity","type":"codeVoice"},{"text":", ","type":"text"},{"code":"Wind","type":"codeVoice"},{"text":", ","type":"text"},{"code":"Current","type":"codeVoice"},{"text":" and the ","type":"text"},{"code":"TimeStep","type":"codeVoice"},{"text":" resource,","type":"text"},{"text":" ","type":"text"},{"text":"and nothing else, so a schedule runs it at the same time as any system that doesn’t write","type":"text"},{"text":" ","type":"text"},{"text":"those types.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"These are the parameter types a ","type":"text"},{"type":"codeVoice","code":"run"},{"text":" method can take:","type":"text"}]},{"type":"termList","items":[{"definition":{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Reads components."}]}]},"term":{"inlineContent":[{"type":"reference","isActive":true,"identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/Query"},{"type":"text","text":" and "},{"type":"reference","isActive":true,"identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/Query\/Where"}]}},{"definition":{"content":[{"inlineContent":[{"type":"text","text":"Writes components, optionally reading others."}],"type":"paragraph"}]},"term":{"inlineContent":[{"isActive":true,"type":"reference","identifier":"doc:\/\/Systems\/documentation\/Systems\/Update"}]}},{"definition":{"content":[{"inlineContent":[{"text":"Read or write a resource.","type":"text"}],"type":"paragraph"}]},"term":{"inlineContent":[{"isActive":true,"type":"