{"metadata":{"title":"System()","role":"symbol","symbolKind":"macro","roleHeading":"Macro","remoteSource":{"url":"https:\/\/github.com\/Tyler-Keith-Thompson\/ECS\/blob\/main\/Sources\/Systems\/SystemMacro.swift#L81","fileName":"SystemMacro.swift"},"fragments":[{"text":"macro","kind":"keyword"},{"text":" ","kind":"text"},{"text":"System","kind":"identifier"},{"text":"()","kind":"text"}],"externalID":"s:7Systems6Systemyycfm","modules":[{"name":"Systems"}]},"hierarchy":{"paths":[["doc:\/\/Systems\/documentation\/Systems"]]},"schemaVersion":{"patch":0,"major":0,"minor":3},"kind":"symbol","variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/systems\/system()"]}],"identifier":{"url":"doc:\/\/Systems\/documentation\/Systems\/System()","interfaceLanguage":"swift"},"sections":[],"abstract":[{"text":"Makes a type a system whose access comes from the parameters of its ","type":"text"},{"code":"run","type":"codeVoice"},{"text":" method.","type":"text"}],"seeAlsoSections":[{"identifiers":["doc:\/\/Systems\/documentation\/Systems\/DeclaringSystems","doc:\/\/Systems\/documentation\/Systems\/DrivingAWorldFromAnApp","doc:\/\/Systems\/documentation\/Systems\/System"],"generated":true,"anchor":"Essentials","title":"Essentials"}],"primaryContentSections":[{"kind":"declarations","declarations":[{"platforms":["Linux"],"tokens":[{"text":"@attached","kind":"attribute"},{"text":"(extension, conformances: ","kind":"text"},{"preciseIdentifier":"s:7Systems6SystemP","text":"System","identifier":"doc:\/\/Systems\/documentation\/Systems\/System","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"preciseIdentifier":"s:7Systems15MainActorSystemP","text":"MainActorSystem","identifier":"doc:\/\/Systems\/documentation\/Systems\/MainActorSystem","kind":"typeIdentifier"},{"text":", names: named(access), named(run), named(initialize)) ","kind":"text"},{"text":"macro","kind":"keyword"},{"text":" ","kind":"text"},{"text":"System","kind":"identifier"},{"text":"()","kind":"text"}],"languages":["swift"]}]},{"kind":"content","content":[{"text":"Overview","anchor":"overview","type":"heading","level":2},{"inlineContent":[{"type":"text","text":"Attach "},{"code":"@System","type":"codeVoice"},{"text":" to a structure with a method named ","type":"text"},{"code":"run","type":"codeVoice"},{"text":". The method’s parameters are","type":"text"},{"text":" ","type":"text"},{"text":"system parameters, values the schedule fetches from the world before each run, and their","type":"text"},{"text":" ","type":"text"},{"text":"types state exactly what the system reads and writes. The macro conforms the type to","type":"text"},{"text":" ","type":"text"},{"identifier":"doc:\/\/Systems\/documentation\/Systems\/System","type":"reference","isActive":true},{"text":", writing its ","type":"text"},{"identifier":"doc:\/\/Systems\/documentation\/Systems\/System\/access","type":"reference","isActive":true},{"text":" from those types and a ","type":"text"},{"identifier":"doc:\/\/Systems\/documentation\/Systems\/System\/run(in:)","type":"reference","isActive":true},{"text":" that","type":"text"},{"text":" ","type":"text"},{"text":"fetches the parameters and calls your method.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"The following system moves each entity by its velocity plus whichever of a wind and a"},{"type":"text","text":" "},{"type":"text","text":"current act on it, scaled by the time step:"}],"type":"paragraph"},{"syntax":"swift","code":["struct Wind: Component { var speed: Double }","struct Current: Component { var speed: Double }","","@System","struct Drift {","    func run(","        _ drifters: Update<Position>.Over<Velocity, AnyOf<Wind, Current>>,","        _ step: ResourceReader<TimeStep>","    ) {","        drifters { position, row in","            let (velocity, (wind, current)) = row.components","            let push = (wind?.speed ?? 0) + (current?.speed ?? 0)","            position.x += (velocity.dx + push) * step.value.seconds","        }","    }","}","","var world = World()","world.resources.insert(TimeStep(seconds: 0.5))","let boat = world.spawn(Position(x: 0, y: 0), Velocity(dx: 2, dy: 0), Wind(speed: 4))","Schedule { Drift() }.run(on: &world)","print(world[Position.self, of: boat].x)","\/\/ Prints \"3.0\""],"type":"codeListing"},{"inlineContent":[{"code":"Drift","type":"codeVoice"},{"type":"text","text":" writes "},{"code":"Position","type":"codeVoice"},{"type":"text","text":", reads "},{"code":"Velocity","type":"codeVoice"},{"type":"text","text":", "},{"code":"Wind","type":"codeVoice"},{"type":"text","text":", "},{"code":"Current","type":"codeVoice"},{"type":"text","text":" and the "},{"code":"TimeStep","type":"codeVoice"},{"type":"text","text":" resource,"},{"type":"text","text":" "},{"type":"text","text":"and nothing else, so a schedule runs it at the same time as any system that doesn’t write"},{"type":"text","text":" "},{"type":"text","text":"those types."}],"type":"paragraph"},{"inlineContent":[{"text":"These are the parameter types a ","type":"text"},{"code":"run","type":"codeVoice"},{"text":" method can take:","type":"text"}],"type":"paragraph"},{"items":[{"term":{"inlineContent":[{"type":"reference","identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/Query","isActive":true},{"type":"text","text":" and "},{"type":"reference","identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/Query\/Where","isActive":true}]},"definition":{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Reads components."}]}]}},{"term":{"inlineContent":[{"identifier":"doc:\/\/Systems\/documentation\/Systems\/Update","isActive":true,"type":"reference"}]},"definition":{"content":[{"inlineContent":[{"type":"text","text":"Writes components, optionally reading others."}],"type":"paragraph"}]}},{"term":{"inlineContent":[{"identifier":"doc:\/\/Systems\/documentation\/Systems\/ResourceReader","type":"reference","isActive":true},{"text":" and ","type":"text"},{"id