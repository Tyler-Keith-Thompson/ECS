. Arcs that other arcs imply are left out."}]},{"type":"codeListing","syntax":"swift","code":["let frame = Schedule {","    Gravity()","    Movement().after(Gravity.self)","    Scoring()","}","var dot = \"\"","frame.writeDOT(to: &dot)","","let lines = dot.split(separator: \"\\n\").map { line in line.drop { $0 == \"\\t\" } }","print(lines)","\/\/ Prints \"[\"digraph {\", \"0 [label=Gravity];\", \"1 [label=Movement];\", \"2 [label=Scoring];\", \"0 -> 1;\", \"1 -> 2 [style=dashed];\", \"}\"]\""]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Laid out, the DOT text shows that "},{"code":"Movement","type":"codeVoice"},{"type":"text","text":" is ordered after "},{"code":"Gravity","type":"codeVoice"},{"type":"text","text":", and that"},{"type":"text","text":" "},{"code":"Scoring","type":"codeVoice"},{"type":"text","text":" runs after "},{"code":"Movement","type":"codeVoice"},{"type":"text","text":" only because it reads the "},{"code":"Position","type":"codeVoice"},{"type":"text","text":" that "},{"code":"Movement","type":"codeVoice"},{"type":"text","text":" "},{"type":"text","text":"writes:"}]},{"type":"codeListing","syntax":"dot","code":["digraph {","    0 [label=Gravity];","    1 [label=Movement];","    2 [label=Scoring];","    0 -> 1;","    1 -> 2 [style=dashed];","}"]},{"type":"aside","style":"note","content":[{"type":"paragraph","inlineContent":[{"text":"O(","type":"text"},{"inlineContent":[{"text":"s","type":"text"}],"type":"emphasis"},{"text":"²) for ","type":"text"},{"inlineContent":[{"type":"text","text":"s"}],"type":"emphasis"},{"text":" systems.","type":"text"}]}],"name":"Complexity"}],"kind":"content"}],"hierarchy":{"paths":[["doc:\/\/Systems\/documentation\/Systems","doc:\/\/Systems\/documentation\/Systems\/Schedule"]]},"abstract":[{"text":"Writes the schedule’s dependency graph in the DOT language, for drawing with Graphviz.","type":"text"}],"schemaVersion":{"major":0,"minor":3,"patch":0},"metadata":{"roleHeading":"Instance Method","title":"wri