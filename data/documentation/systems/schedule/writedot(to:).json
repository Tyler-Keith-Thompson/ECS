shed];\", \"}\"]\""]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Laid out, the DOT text shows that "},{"code":"Movement","type":"codeVoice"},{"type":"text","text":" is ordered after "},{"code":"Gravity","type":"codeVoice"},{"type":"text","text":", and that"},{"type":"text","text":" "},{"code":"Scoring","type":"codeVoice"},{"type":"text","text":" runs after "},{"code":"Movement","type":"codeVoice"},{"type":"text","text":" only because it reads the "},{"code":"Position","type":"codeVoice"},{"type":"text","text":" that "},{"code":"Movement","type":"codeVoice"},{"type":"text","text":" "},{"type":"text","text":"writes:"}]},{"syntax":"dot","type":"codeListing","code":["digraph {","    0 [label=Gravity];","    1 [label=Movement];","    2 [label=Scoring];","    0 -> 1;","    1 -> 2 [style=dashed];","}"]},{"name":"Complexity","type":"aside","style":"note","content":[{"inlineContent":[{"type":"text","text":"O("},{"type":"emphasis","inlineContent":[{"text":"s","type":"text"}]},{"type":"text","text":"²) for "},{"type":"emphasis","inlineContent":[{"type":"text","text":"s"}]},{"type":"text","text":" systems."}],"type":"paragraph"}]}]}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/systems\/schedule\/writedot(to:)"]}],"abstract":[{"text":"Writes the schedule’s dependency graph in the DOT language, for drawing with Graphviz.","type":"text"}],"kind":"symbol","identifier":{"url":"doc:\/\/Systems\/documentation\/Systems\/Schedule\/writeDOT(to:)","interfaceLanguage":"swift"},"metadata":{"title":"writeDOT(to:)","symbolKind":"method","role":"symbol","remoteSource":{"fileName":"Profiling.swift","url":"https:\/\/github.com\/Tyler-Keith-Thompson\/ECS\/blob\/main\/Sources\/Systems\/Profiling.swift#L146"},"modules":[{"name":"Systems"}],"externalID":"s:7Systems8ScheduleV8writeDOT2toyxz_ts16TextOutputStreamRzlF","extendedModule":"Systems","roleHeading":"Instance Method","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{