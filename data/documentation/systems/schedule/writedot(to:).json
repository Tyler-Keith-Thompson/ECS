":[{"name":"output","content":[{"type":"paragraph","inlineContent":[{"text":"The stream to write the DOT text to.","type":"text"}]}]}]},{"kind":"content","content":[{"type":"heading","level":2,"text":"Discussion","anchor":"discussion"},{"type":"paragraph","inlineContent":[{"text":"Use this method to see why systems run in the order they do, and which could run at the","type":"text"},{"text":" ","type":"text"},{"text":"same time. Each system is a node labeled with its type’s name, numbered in the order the","type":"text"},{"text":" ","type":"text"},{"text":"schedule runs them. An arc from one system to another means the second runs after the","type":"text"},{"text":" ","type":"text"},{"text":"first: solid when an ordering constraint orders them, dashed when only their accesses","type":"text"},{"text":" ","type":"text"},{"text":"conflict. Arcs that other arcs imply are left out.","type":"text"}]},{"type":"codeListing","code":["let frame = Schedule {","    Gravity()","    Movement().after(Gravity.self)","    Scoring()","}","var dot = \"\"","frame.writeDOT(to: &dot)","","let lines = dot.split(separator: \"\\n\").map { line in line.drop { $0 == \"\\t\" } }","print(lines)","\/\/ Prints \"[\"digraph {\", \"0 [label=Gravity];\", \"1 [label=Movement];\", \"2 [label=Scoring];\", \"0 -> 1;\", \"1 -> 2 [style=dashed];\", \"}\"]\""],"syntax":"swift"},{"type":"paragraph","inlineContent":[{"text":"Laid out, the DOT text shows that ","type":"text"},{"type":"codeVoice","code":"Movement"},{"text":" is ordered after ","type":"text"},{"type":"codeVoice","code":"Gravity"},{"text":", and that","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"Scoring"},{"text":" runs after ","type":"text"},{"type":"codeVoice","code":"Movement"},{"text":" only because it reads the ","type":"text"},{"type":"codeVoice","code":"Position"},{"text":" that ","type":"text"},{"type":"codeVoice","code":"Movement"},{"text":" ","type":"text"},{"text":"writes:","type":"text"}]},{"type":"codeListin