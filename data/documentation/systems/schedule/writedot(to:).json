:"TextOutputStream","preciseIdentifier":"s:s16TextOutputStreamP"},{"kind":"text","text":")"}],"languages":["swift"],"platforms":["Linux"]}]},{"kind":"parameters","parameters":[{"content":[{"inlineContent":[{"text":"The stream to write the DOT text to.","type":"text"}],"type":"paragraph"}],"name":"output"}]},{"kind":"mentions","mentions":["doc:\/\/Systems\/documentation\/Systems\/SchedulingSystems"]},{"kind":"content","content":[{"level":2,"anchor":"discussion","text":"Discussion","type":"heading"},{"inlineContent":[{"text":"Use this method to see why systems run in the order they do, and which could run at the","type":"text"},{"text":" ","type":"text"},{"text":"same time. Each system is a node labeled with its type’s name, numbered in the order the","type":"text"},{"text":" ","type":"text"},{"text":"schedule runs them. An arc from one system to another means the second runs after the","type":"text"},{"text":" ","type":"text"},{"text":"first: solid when an ordering constraint orders them, dashed when only their accesses","type":"text"},{"text":" ","type":"text"},{"text":"conflict. Arcs that other arcs imply are left out.","type":"text"}],"type":"paragraph"},{"syntax":"swift","code":["let frame = Schedule {","    Gravity()","    Movement().after(Gravity.self)","    Scoring()","}","var dot = \"\"","frame.writeDOT(to: &dot)","","let lines = dot.split(separator: \"\\n\").map { line in line.drop { $0 == \"\\t\" } }","print(lines)","\/\/ Prints \"[\"digraph {\", \"0 [label=Gravity];\", \"1 [label=Movement];\", \"2 [label=Scoring];\", \"0 -> 1;\", \"1 -> 2 [style=dashed];\", \"}\"]\""],"type":"codeListing"},{"inlineContent":[{"type":"text","text":"Laid out, the DOT text shows that "},{"code":"Movement","type":"codeVoice"},{"type":"text","text":" is ordered after "},{"code":"Gravity","type":"codeVoice"},{"type":"text","text":", and that"},{"type":"text","text":" "},{"code":"Scoring","type":"codeVoice"},{"type":"text","text":" runs after "},{"code":"Movement","type":"codeVoic