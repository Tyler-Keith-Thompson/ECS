{"abstract":[{"type":"text","text":"Writes the schedule’s dependency graph in the DOT language, for drawing with Graphviz."}],"sections":[],"primaryContentSections":[{"declarations":[{"languages":["swift"],"platforms":["Linux"],"tokens":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"writeDOT","kind":"identifier"},{"text":"(","kind":"text"},{"text":"to","kind":"externalParam"},{"text":" ","kind":"text"},{"text":"output","kind":"internalParam"},{"text":": ","kind":"text"},{"text":"inout","kind":"keyword"},{"text":" ","kind":"text"},{"text":"some","kind":"keyword"},{"text":" ","kind":"text"},{"text":"TextOutputStream","kind":"typeIdentifier","preciseIdentifier":"s:s16TextOutputStreamP"},{"text":")","kind":"text"}]}],"kind":"declarations"},{"parameters":[{"content":[{"type":"paragraph","inlineContent":[{"text":"The stream to write the DOT text to.","type":"text"}]}],"name":"output"}],"kind":"parameters"},{"content":[{"level":2,"anchor":"discussion","type":"heading","text":"Discussion"},{"inlineContent":[{"text":"Use this method to see why systems run in the order they do, and which could run at the","type":"text"},{"text":" ","type":"text"},{"text":"same time. Each system is a node labeled with its type’s name, numbered in the order the","type":"text"},{"text":" ","type":"text"},{"text":"schedule runs them. An arc from one system to another means the second runs after the","type":"text"},{"text":" ","type":"text"},{"text":"first: solid when an ordering constraint orders them, dashed when only their accesses","type":"text"},{"text":" ","type":"text"},{"text":"conflict. Arcs that other arcs imply are left out.","type":"text"}],"type":"paragraph"},{"syntax":"swift","code":["let frame = Schedule {","    Gravity()","    Movement().after(Gravity.self)","    Scoring()","}","var dot = \"\"","frame.writeDOT(to: &dot)","","let lines = dot.split(separator: \"\\n\").map { line in line.drop { $0 == \"\\t\" } }","print(lines)","\/\/ Prints \"[\"digraph {\", \"0 [label=Gravity];\", \"1 [label=Movement];\", \"2 [label=Scoring];\", \"0 -> 1;\", \"1 -> 2 [style=dashed];\", \"}\"]\""],"type":"codeListing"},{"inlineContent":[{"type":"text","text":"Laid out, the DOT text shows that "},{"type":"codeVoice","code":"Movement"},{"type":"text","text":" is ordered after "},{"type":"codeVoice","code":"Gravity"},{"type":"text","text":", and that"},{"type":"text","text":" "},{"type":"codeVoice","code":"Scoring"},{"type":"text","text":" runs after "},{"type":"codeVoice","code":"Movement"},{"type":"text","text":" only because it reads the "},{"type":"codeVoice","code":"Position"},{"type":"text","text":" that "},{"type":"codeVoice","code":"Movement"},{"type":"text","text":" "},{"type":"text","text":"writes:"}],"type":"paragraph"},{"syntax":"dot","code":["digraph {","    0 [label=Gravity];","    1 [label=Movement];","    2 [label=Scoring];","    0 -> 1;","    1 -> 2 [style=dashed];","}"],"type":"codeListing"},{"name":"Complexity","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"O("},{"type":"emphasis","inlineContent":[{"text":"s","type":"text"}]},{"type":"text","text":"²) for "},{"type":"emphasis","inlineContent":[{"text":"s","type":"text"}]},{"type":"text","text":" systems."}]}],"style":"note","type":"aside"}],"kind":"content"}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/systems\/schedule\/writedot(to:)"]}],"kind":"symbol","hierarchy":{"paths":[["doc:\/\/Systems\/documentation\/Systems","doc:\/\/Systems\/documentation\/Systems\/Schedule"]]},"seeAlsoSections":[{"generated":true,"title":"Inspecting a Schedule","anchor":"Inspecting-a-Schedule","identifiers":["doc:\/\/Systems\/documentation\/Systems\/Schedule\/systems","doc:\/\/Systems\/documentation\/Systems\/Schedule\/names","doc:\/\/Systems\/documentation\/Systems\/Schedule\/ambiguities()","doc:\/\/Systems\/documentation\/Systems\/Ambiguity"]}],"identifier":{"url":"doc:\/\/Systems\/documentation\/Systems\/Schedule\/writeDOT(to:)","in