ype":"paragraph"},{"name":"Complexity","type":"aside","content":[{"inlineContent":[{"text":"O(","type":"text"},{"inlineContent":[{"text":"s","type":"text"}],"type":"emphasis"},{"text":"·(","type":"text"},{"inlineContent":[{"text":"s","type":"text"}],"type":"emphasis"},{"text":" + ","type":"text"},{"inlineContent":[{"type":"text","text":"c"}],"type":"emphasis"},{"text":")) for ","type":"text"},{"inlineContent":[{"text":"s","type":"text"}],"type":"emphasis"},{"text":" systems and ","type":"text"},{"inlineContent":[{"text":"c","type":"text"}],"type":"emphasis"},{"text":" ordered pairs.","type":"text"}],"type":"paragraph"}],"style":"note"}]}],"variants":[{"paths":["\/documentation\/systems\/schedule\/ambiguities()"],"traits":[{"interfaceLanguage":"swift"}]}],"references":{"doc://Systems/documentation/Systems/Schedule/systems":{"title":"systems","abstract":[{"text":"The schedule’s systems, in the order they run.","type":"text"}],"url":"\/documentation\/systems\/schedule\/systems","identifier":"doc:\/\/Systems\/documentation\/Systems\/Schedule\/systems","kind":"symbol","type":"topic","role":"symbol","fragments":[{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"systems","kind":"identifier"},{"text":": [","kind":"text"},{"text":"ScheduledSystem","kind":"typeIdentifier","preciseIdentifier":"s:7Systems15ScheduledSystemV"},{"text":"]","kind":"text"}]},"doc://Systems/documentation/Systems/Schedule/writeDOT(to:)":{"url":"\/documentation\/systems\/schedule\/writedot(to:)","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"writeDOT","kind":"identifier"},{"text":"(","kind":"text"},{"text":"to","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"inout","kind":"keyword"},{"text":" ","kind":"text"},{"text":"some","kind":"keyword"},{"text":" ","kind":"text"},{"text":"TextOutputStream","kind":"typeIdentifier","preciseIdentifier":"s:s16TextOutputStreamP"},{"text":")","kind":"text"}],"title":"writeDOT(to:)","type":"topic","abstrac