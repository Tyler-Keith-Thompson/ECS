all this method in a test to","type":"text"},{"text":" ","type":"text"},{"text":"keep a schedule free of ambiguities.","type":"text"}]},{"name":"Complexity","type":"aside","style":"note","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"O("},{"type":"emphasis","inlineContent":[{"type":"text","text":"s"}]},{"type":"text","text":"·("},{"type":"emphasis","inlineContent":[{"type":"text","text":"s"}]},{"type":"text","text":" + "},{"type":"emphasis","inlineContent":[{"type":"text","text":"c"}]},{"type":"text","text":")) for "},{"type":"emphasis","inlineContent":[{"text":"s","type":"text"}]},{"type":"text","text":" systems and "},{"type":"emphasis","inlineContent":[{"type":"text","text":"c"}]},{"type":"text","text":" ordered pairs."}]}]}]}],"references":{"doc://Systems/documentation/Systems/Ambiguity":{"role":"symbol","navigatorTitle":[{"text":"Ambiguity","kind":"identifier"}],"url":"\/documentation\/systems\/ambiguity","type":"topic","title":"Ambiguity","abstract":[{"text":"Two systems of a schedule whose accesses conflict but that no ordering constraint orders, so","type":"text"},{"text":" ","type":"text"},{"text":"the order they run in rests only on the order they were written in.","type":"text"}],"fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Ambiguity","kind":"identifier"}],"identifier":"doc:\/\/Systems\/documentation\/Systems\/Ambiguity","kind":"symbol"},"doc://Systems/documentation/Systems/Schedule/ambiguities()":{"fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"ambiguities"},{"kind":"text","text":"() -> ["},{"text":"Ambiguity","kind":"typeIdentifier","preciseIdentifier":"s:7Systems9AmbiguityV"},{"text":"]","kind":"text"}],"abstract":[{"text":"Returns every pair of systems whose accesses conflict but that no ordering constraint","type":"text"},{"text":" ","type":"text"},{"text":"orders.","type":"text"}],"identifier":"doc:\/\/Systems\/documentation\/Systems\