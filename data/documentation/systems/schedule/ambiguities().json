{"sections":[],"abstract":[{"text":"Returns every pair of systems whose accesses conflict but that no ordering constraint","type":"text"},{"text":" ","type":"text"},{"text":"orders.","type":"text"}],"kind":"symbol","seeAlsoSections":[{"generated":true,"title":"Inspecting a Schedule","identifiers":["doc:\/\/Systems\/documentation\/Systems\/Schedule\/systems","doc:\/\/Systems\/documentation\/Systems\/Schedule\/names","doc:\/\/Systems\/documentation\/Systems\/Ambiguity","doc:\/\/Systems\/documentation\/Systems\/Schedule\/writeDOT(to:)"],"anchor":"Inspecting-a-Schedule"}],"hierarchy":{"paths":[["doc:\/\/Systems\/documentation\/Systems","doc:\/\/Systems\/documentation\/Systems\/Schedule"]]},"metadata":{"remoteSource":{"fileName":"Schedule.swift","url":"https:\/\/github.com\/Tyler-Keith-Thompson\/ECS\/blob\/main\/Sources\/Systems\/Schedule.swift#L525"},"externalID":"s:7Systems8ScheduleV11ambiguitiesSayAA9AmbiguityVGyF","symbolKind":"method","extendedModule":"Systems","roleHeading":"Instance Method","role":"symbol","modules":[{"name":"Systems"}],"title":"ambiguities()","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"ambiguities","kind":"identifier"},{"text":"() -> [","kind":"text"},{"text":"Ambiguity","kind":"typeIdentifier","preciseIdentifier":"s:7Systems9AmbiguityV"},{"text":"]","kind":"text"}]},"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/Systems\/documentation\/Systems\/Schedule\/ambiguities()"},"schemaVersion":{"minor":3,"patch":0,"major":0},"primaryContentSections":[{"kind":"declarations","declarations":[{"tokens":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"ambiguities"},{"kind":"text","text":"() -> ["},{"kind":"typeIdentifier","preciseIdentifier":"s:7Systems9AmbiguityV","identifier":"doc:\/\/Systems\/documentation\/Systems\/Ambiguity","text":"Ambiguity"},{"kind":"text","text":"]"}],"platforms":["Linux"],"languages":["swift"]}]},{"kind":"content","content":[{"type":"heading","