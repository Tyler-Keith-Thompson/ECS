{"identifier":{"url":"doc:\/\/Systems\/documentation\/Systems\/Schedule\/ambiguities()","interfaceLanguage":"swift"},"sections":[],"variants":[{"paths":["\/documentation\/systems\/schedule\/ambiguities()"],"traits":[{"interfaceLanguage":"swift"}]}],"metadata":{"roleHeading":"Instance Method","symbolKind":"method","externalID":"s:7Systems8ScheduleV11ambiguitiesSayAA9AmbiguityVGyF","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"ambiguities","kind":"identifier"},{"text":"() -> [","kind":"text"},{"text":"Ambiguity","kind":"typeIdentifier","preciseIdentifier":"s:7Systems9AmbiguityV"},{"text":"]","kind":"text"}],"role":"symbol","modules":[{"name":"Systems"}],"title":"ambiguities()","remoteSource":{"url":"https:\/\/github.com\/Tyler-Keith-Thompson\/ECS\/blob\/main\/Sources\/Systems\/Schedule.swift#L514","fileName":"Schedule.swift"},"extendedModule":"Systems"},"hierarchy":{"paths":[["doc:\/\/Systems\/documentation\/Systems","doc:\/\/Systems\/documentation\/Systems\/Schedule"]]},"kind":"symbol","schemaVersion":{"minor":3,"patch":0,"major":0},"primaryContentSections":[{"kind":"declarations","declarations":[{"languages":["swift"],"tokens":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"ambiguities"},{"kind":"text","text":"() -> ["},{"kind":"typeIdentifier","text":"Ambiguity","identifier":"doc:\/\/Systems\/documentation\/Systems\/Ambiguity","preciseIdentifier":"s:7Systems9AmbiguityV"},{"kind":"text","text":"]"}],"platforms":["Linux"]}]},{"kind":"content","content":[{"anchor":"return-value","type":"heading","level":2,"text":"Return Value"},{"inlineContent":[{"type":"text","text":"The ambiguous pairs, ordered by the position of their first system and then"},{"type":"text","text":" "},{"type":"text","text":"their second."}],"type":"paragraph"}]},{"kind":"content","content":[{"type":"heading","anchor":"discussion","level":2,"text":"Discussion"},{"type":"paragraph","inlineContent":[{"text":"Such a pair runs in the order it’s written in, which is easy to change by accident. In the","type":"text"},{"text":" ","type":"text"},{"text":"following schedule, ","type":"text"},{"type":"codeVoice","code":"Gravity"},{"text":" writes the ","type":"text"},{"type":"codeVoice","code":"Velocity"},{"text":" that ","type":"text"},{"type":"codeVoice","code":"Movement"},{"text":" reads, but nothing","type":"text"},{"text":" ","type":"text"},{"text":"says which runs first:","type":"text"}]},{"syntax":"swift","type":"codeListing","code":["let frame = Schedule {","    Gravity()","    Movement()","}","for ambiguity in frame.ambiguities() {","    print(frame.names[ambiguity.first], frame.names[ambiguity.second])","    \/\/ Prints \"Gravity Movement\"","}","","let ordered = Schedule {","    Gravity()","    Movement().after(Gravity.self)","}","print(ordered.ambiguities().isEmpty)","\/\/ Prints \"true\""]},{"type":"paragraph","inlineContent":[{"text":"Order each pair with ","type":"text"},{"code":"after(_:)","type":"codeVoice"},{"text":" or ","type":"text"},{"code":"before(_:)","type":"codeVoice"},{"text":", or mark it with","type":"text"},{"text":" ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/Systems\/documentation\/Systems\/ScheduledSystem\/ambiguous(with:)"},{"text":" when either order is right. Systems without an access","type":"text"},{"text":" ","type":"text"},{"text":"always run alone, in the order written, and are left out. Call this method in a test to","type":"text"},{"text":" ","type":"text"},{"text":"keep a schedule free of ambiguities.","type":"text"}]},{"type":"aside","style":"note","name":"Complexity","content":[{"type":"paragraph","inlineContent":[{"text":"O(","type":"text"},{"inlineContent":[{"type":"text","text":"s"}],"type":"emphasis"},{"text":"·(","type":"text"},{"inlineContent":[{"type":"text","text":"s"}],"type":"emphasis"},{"text":" + ","type":"text"},{"inlineContent":[{"type":"text","text":"c"}],"type":"emphasis"},{"text":")) for ","type":"tex