}]}]},{"kind":"content","content":[{"anchor":"discussion","type":"heading","text":"Discussion","level":2},{"inlineContent":[{"text":"Such a pair runs in the order it’s written in, which is easy to change by accident. In the","type":"text"},{"text":" ","type":"text"},{"text":"following schedule, ","type":"text"},{"code":"Gravity","type":"codeVoice"},{"text":" writes the ","type":"text"},{"code":"Velocity","type":"codeVoice"},{"text":" that ","type":"text"},{"code":"Movement","type":"codeVoice"},{"text":" reads, but nothing","type":"text"},{"text":" ","type":"text"},{"text":"says which runs first:","type":"text"}],"type":"paragraph"},{"code":["let frame = Schedule {","    Gravity()","    Movement()","}","for ambiguity in frame.ambiguities() {","    print(frame.names[ambiguity.first], frame.names[ambiguity.second])","    \/\/ Prints \"Gravity Movement\"","}","","let ordered = Schedule {","    Gravity()","    Movement().after(Gravity.self)","}","print(ordered.ambiguities().isEmpty)","\/\/ Prints \"true\""],"type":"codeListing","syntax":"swift"},{"inlineContent":[{"type":"text","text":"Order each pair with "},{"type":"codeVoice","code":"after(_:)"},{"type":"text","text":" or "},{"type":"codeVoice","code":"before(_:)"},{"type":"text","text":", or mark it with"},{"type":"text","text":" "},{"type":"reference","isActive":true,"identifier":"doc:\/\/Systems\/documentation\/Systems\/ScheduledSystem\/ambiguous(with:)"},{"type":"text","text":" when either order is right. Systems without an access"},{"type":"text","text":" "},{"type":"text","text":"always run alone, in the order written, and are left out. Call this method in a test to"},{"type":"text","text":" "},{"type":"text","text":"keep a schedule free of ambiguities."}],"type":"paragraph"},{"style":"note","type":"aside","name":"Complexity","content":[{"inlineContent":[{"type":"text","text":"O("},{"inlineContent":[{"type":"text","text":"s"}],"type":"emphasis"},{"type":"text","text":"·("},{"inlineContent":[{"text":"s","type":"t