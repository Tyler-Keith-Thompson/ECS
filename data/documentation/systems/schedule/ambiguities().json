{"variants":[{"paths":["\/documentation\/systems\/schedule\/ambiguities()"],"traits":[{"interfaceLanguage":"swift"}]}],"identifier":{"url":"doc:\/\/Systems\/documentation\/Systems\/Schedule\/ambiguities()","interfaceLanguage":"swift"},"primaryContentSections":[{"kind":"declarations","declarations":[{"tokens":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"ambiguities","kind":"identifier"},{"text":"() -> [","kind":"text"},{"identifier":"doc:\/\/Systems\/documentation\/Systems\/Ambiguity","text":"Ambiguity","preciseIdentifier":"s:7Systems9AmbiguityV","kind":"typeIdentifier"},{"text":"]","kind":"text"}],"platforms":["Linux"],"languages":["swift"]}]},{"content":[{"level":2,"anchor":"return-value","type":"heading","text":"Return Value"},{"inlineContent":[{"type":"text","text":"The ambiguous pairs, ordered by the position of their first system and then"},{"type":"text","text":" "},{"type":"text","text":"their second."}],"type":"paragraph"}],"kind":"content"},{"content":[{"text":"Discussion","anchor":"discussion","type":"heading","level":2},{"inlineContent":[{"text":"Such a pair runs in the order it’s written in, which is easy to change by accident. In the","type":"text"},{"text":" ","type":"text"},{"text":"following schedule, ","type":"text"},{"code":"Gravity","type":"codeVoice"},{"text":" writes the ","type":"text"},{"code":"Velocity","type":"codeVoice"},{"text":" that ","type":"text"},{"code":"Movement","type":"codeVoice"},{"text":" reads, but nothing","type":"text"},{"text":" ","type":"text"},{"text":"says which runs first:","type":"text"}],"type":"paragraph"},{"code":["let frame = Schedule {","    Gravity()","    Movement()","}","for ambiguity in frame.ambiguities() {","    print(frame.names[ambiguity.first], frame.names[ambiguity.second])","    \/\/ Prints \"Gravity Movement\"","}","","let ordered = Schedule {","    Gravity()","    Movement().after(Gravity.self)","}","print(ordered.ambiguities().isEmpty)","\/\/ Prints \"true\""],"syntax":"swift","type":"codeListing"},{"inlineContent":[{"type":"text","text":"Order each pair with "},{"code":"after(_:)","type":"codeVoice"},{"type":"text","text":" or "},{"code":"before(_:)","type":"codeVoice"},{"type":"text","text":", or mark it with"},{"type":"text","text":" "},{"type":"reference","identifier":"doc:\/\/Systems\/documentation\/Systems\/ScheduledSystem\/ambiguous(with:)","isActive":true},{"type":"text","text":" when either order is right. Systems without an access"},{"type":"text","text":" "},{"type":"text","text":"always run alone, in the order written, and are left out. Call this method in a test to"},{"type":"text","text":" "},{"type":"text","text":"keep a schedule free of ambiguities."}],"type":"paragraph"},{"style":"note","name":"Complexity","type":"aside","content":[{"type":"paragraph","inlineContent":[{"text":"O(","type":"text"},{"inlineContent":[{"text":"s","type":"text"}],"type":"emphasis"},{"text":"·(","type":"text"},{"inlineContent":[{"type":"text","text":"s"}],"type":"emphasis"},{"text":" + ","type":"text"},{"inlineContent":[{"type":"text","text":"c"}],"type":"emphasis"},{"text":")) for ","type":"text"},{"inlineContent":[{"type":"text","text":"s"}],"type":"emphasis"},{"text":" systems and ","type":"text"},{"inlineContent":[{"text":"c","type":"text"}],"type":"emphasis"},{"text":" ordered pairs.","type":"text"}]}]}],"kind":"content"}],"abstract":[{"text":"Returns every pair of systems whose accesses conflict but that no ordering constraint","type":"text"},{"text":" ","type":"text"},{"text":"orders.","type":"text"}],"kind":"symbol","sections":[],"schemaVersion":{"minor":3,"major":0,"patch":0},"metadata":{"externalID":"s:7Systems8ScheduleV11ambiguitiesSayAA9AmbiguityVGyF","symbolKind":"method","role":"symbol","remoteSource":{"url":"https:\/\/github.com\/Tyler-Keith-Thompson\/ECS\/blob\/main\/Sources\/Systems\/Schedule.swift#L525","fileName":"Schedule.swift"},"title":"ambiguities()","modules":[{"name":"Systems"}],"fragments":[{"kind":"keyword","text":"fu