,"text":" "},{"type":"text","text":"keep a schedule free of ambiguities."}]},{"name":"Complexity","type":"aside","content":[{"inlineContent":[{"type":"text","text":"O("},{"type":"emphasis","inlineContent":[{"text":"s","type":"text"}]},{"type":"text","text":"·("},{"type":"emphasis","inlineContent":[{"type":"text","text":"s"}]},{"type":"text","text":" + "},{"type":"emphasis","inlineContent":[{"type":"text","text":"c"}]},{"type":"text","text":")) for "},{"type":"emphasis","inlineContent":[{"text":"s","type":"text"}]},{"type":"text","text":" systems and "},{"type":"emphasis","inlineContent":[{"type":"text","text":"c"}]},{"type":"text","text":" ordered pairs."}],"type":"paragraph"}],"style":"note"}],"kind":"content"}],"kind":"symbol","hierarchy":{"paths":[["doc:\/\/Systems\/documentation\/Systems","doc:\/\/Systems\/documentation\/Systems\/Schedule"]]},"references":{"doc://Systems/documentation/Systems":{"role":"collection","identifier":"doc:\/\/Systems\/documentation\/Systems","kind":"symbol","abstract":[{"type":"text","text":"Declare the rules of a simulation as systems, and run them on a world in a schedule."}],"type":"topic","title":"Systems","url":"\/documentation\/systems"},"doc://Systems/documentation/Systems/Schedule/ambiguities()":{"role":"symbol","identifier":"doc:\/\/Systems\/documentation\/Systems\/Schedule\/ambiguities()","url":"\/documentation\/systems\/schedule\/ambiguities()","kind":"symbol","type":"topic","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"ambiguities","kind":"identifier"},{"text":"() -> [","kind":"text"},{"text":"Ambiguity","preciseIdentifier":"s:7Systems9AmbiguityV","kind":"typeIdentifier"},{"text":"]","kind":"text"}],"title":"ambiguities()","abstract":[{"text":"Returns every pair of systems whose accesses conflict but that no ordering constraint","type":"text"},{"text":" ","type":"text"},{"text":"orders.","type":"text"}]},"doc://Systems/documentation/Systems/Schedule/systems":{"abstract":[{"type":"text","t