{"sections":[],"metadata":{"extendedModule":"Systems","modules":[{"name":"Systems"}],"title":"ambiguities()","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"ambiguities"},{"kind":"text","text":"() -> ["},{"kind":"typeIdentifier","text":"Ambiguity","preciseIdentifier":"s:7Systems9AmbiguityV"},{"kind":"text","text":"]"}],"symbolKind":"method","externalID":"s:7Systems8ScheduleV11ambiguitiesSayAA9AmbiguityVGyF","remoteSource":{"fileName":"Schedule.swift","url":"https:\/\/github.com\/Tyler-Keith-Thompson\/ECS\/blob\/main\/Sources\/Systems\/Schedule.swift#L525"},"role":"symbol","roleHeading":"Instance Method"},"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/Systems\/documentation\/Systems\/Schedule\/ambiguities()"},"primaryContentSections":[{"kind":"declarations","declarations":[{"platforms":["Linux"],"languages":["swift"],"tokens":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"ambiguities","kind":"identifier"},{"text":"() -> [","kind":"text"},{"text":"Ambiguity","kind":"typeIdentifier","identifier":"doc:\/\/Systems\/documentation\/Systems\/Ambiguity","preciseIdentifier":"s:7Systems9AmbiguityV"},{"text":"]","kind":"text"}]}]},{"kind":"content","content":[{"text":"Return Value","anchor":"return-value","type":"heading","level":2},{"inlineContent":[{"text":"The ambiguous pairs, ordered by the position of their first system and then","type":"text"},{"text":" ","type":"text"},{"text":"their second.","type":"text"}],"type":"paragraph"}]},{"kind":"content","content":[{"level":2,"anchor":"discussion","type":"heading","text":"Discussion"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Such a pair runs in the order it’s written in, which is easy to change by accident. In the"},{"type":"text","text":" "},{"type":"text","text":"following schedule, "},{"type":"codeVoice","code":"Gravity"},{"type":"text","text":" writes the "},{"type":"codeVoice","code":"Velocity"},{"type":"text","text":" that "},{"type":"codeVoice","code":"Movement"},{"type":"text","text":" reads, but nothing"},{"type":"text","text":" "},{"type":"text","text":"says which runs first:"}]},{"code":["let frame = Schedule {","    Gravity()","    Movement()","}","for ambiguity in frame.ambiguities() {","    print(frame.names[ambiguity.first], frame.names[ambiguity.second])","    \/\/ Prints \"Gravity Movement\"","}","","let ordered = Schedule {","    Gravity()","    Movement().after(Gravity.self)","}","print(ordered.ambiguities().isEmpty)","\/\/ Prints \"true\""],"type":"codeListing","syntax":"swift"},{"type":"paragraph","inlineContent":[{"text":"Order each pair with ","type":"text"},{"code":"after(_:)","type":"codeVoice"},{"text":" or ","type":"text"},{"code":"before(_:)","type":"codeVoice"},{"text":", or mark it with","type":"text"},{"text":" ","type":"text"},{"isActive":true,"identifier":"doc:\/\/Systems\/documentation\/Systems\/ScheduledSystem\/ambiguous(with:)","type":"reference"},{"text":" when either order is right. Systems without an access","type":"text"},{"text":" ","type":"text"},{"text":"always run alone, in the order written, and are left out. Call this method in a test to","type":"text"},{"text":" ","type":"text"},{"text":"keep a schedule free of ambiguities.","type":"text"}]},{"name":"Complexity","style":"note","content":[{"inlineContent":[{"type":"text","text":"O("},{"type":"emphasis","inlineContent":[{"type":"text","text":"s"}]},{"type":"text","text":"·("},{"type":"emphasis","inlineContent":[{"type":"text","text":"s"}]},{"type":"text","text":" + "},{"type":"emphasis","inlineContent":[{"type":"text","text":"c"}]},{"type":"text","text":")) for "},{"type":"emphasis","inlineContent":[{"type":"text","text":"s"}]},{"type":"text","text":" systems and "},{"type":"emphasis","inlineContent":[{"type":"text","text":"c"}]},{"type":"text","text":" ordered pairs."}],"type":"paragraph"}],"type":"aside"}]}],"abstract":[{"type":"text","text":"Returns every pair of systems whose accesses conflict but that no ordering constraint"},{"type":"text","text":" "},{"type":"text","text":"orders."}],"seeAlsoSections":[{"generated":true,"anchor":"Inspecting-a-Schedule","title":"Inspecting a Schedule","identifiers":["doc:\/\/Systems\/documentation\/Systems\/Schedule\/systems","doc:\/\/Systems\/documentation\/Systems\/Schedule\/names","doc:\/\/Systems\/documentation\/Systems\/Ambiguity","doc:\/\/Systems\/documentation\/Systems\/Schedule\/writeDOT(to:)"]}],"kind":"symbol","variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/systems\/schedule\/ambiguities()"]}],"schemaVersion":{"major":0,"minor":3,"patch":0},"hierarchy":{"paths":[["doc:\/\/Systems\/documentation\/Systems","doc:\/\/Systems\/documentation\/Systems\/Schedule"]]},"references":{"doc://Systems/documentation/Systems/Schedule/writeDOT(to:)":{"fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"writeDOT"},{"kind":"text","text":"("},{"kind":"externalParam","text":"to"},{"kind":"text","text":": "},{"text":"inout","kind":"keyword"},{"text":" ","kind":"text"},{"text":"some","kind":"keyword"},{"text":" ","kind":"text"},{"preciseIdentifier":"s:s16TextOutputStreamP","text":"TextOutputStream","kind":"typeIdentifier"},{"text":")","kind":"text"}],"kind":"symbol","identifier":"doc:\/\/Systems\/documentation\/Systems\/Schedule\/writeDOT(to:)","role":"symbol","type":"topic","title":"writeDOT(to:)","abstract":[{"text":"Writes the schedule’s dependency graph in the DOT language, for drawing with Graphviz.","type":"text"}],"url":"\/documentation\/systems\/schedule\/writedot(to:)"},"doc://Systems/documentation/Systems/ScheduledSystem/ambiguous(with:)":{"title":"ambiguous(with:)","role":"symbol","identifier":"doc:\/\/Systems\/documentation\/Systems\/ScheduledSystem\/ambiguous(with:)","type":"topic","kind":"symbol","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"ambiguous"},{"kind":"text","text":"