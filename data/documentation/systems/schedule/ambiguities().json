{"schemaVersion":{"minor":3,"patch":0,"major":0},"primaryContentSections":[{"kind":"declarations","declarations":[{"languages":["swift"],"tokens":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"ambiguities","kind":"identifier"},{"text":"() -> [","kind":"text"},{"text":"Ambiguity","preciseIdentifier":"s:7Systems9AmbiguityV","kind":"typeIdentifier","identifier":"doc:\/\/Systems\/documentation\/Systems\/Ambiguity"},{"text":"]","kind":"text"}],"platforms":["Linux"]}]},{"kind":"content","content":[{"level":2,"text":"Return Value","anchor":"return-value","type":"heading"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The ambiguous pairs, ordered by the position of their first system and then"},{"type":"text","text":" "},{"type":"text","text":"their second."}]}]},{"kind":"content","content":[{"anchor":"discussion","text":"Discussion","type":"heading","level":2},{"inlineContent":[{"text":"Such a pair runs in the order it’s written in, which is easy to change by accident. In the","type":"text"},{"text":" ","type":"text"},{"text":"following schedule, ","type":"text"},{"code":"Gravity","type":"codeVoice"},{"text":" writes the ","type":"text"},{"code":"Velocity","type":"codeVoice"},{"text":" that ","type":"text"},{"code":"Movement","type":"codeVoice"},{"text":" reads, but nothing","type":"text"},{"text":" ","type":"text"},{"text":"says which runs first:","type":"text"}],"type":"paragraph"},{"type":"codeListing","syntax":"swift","code":["let frame = Schedule {","    Gravity()","    Movement()","}","for ambiguity in frame.ambiguities() {","    print(frame.names[ambiguity.first], frame.names[ambiguity.second])","    \/\/ Prints \"Gravity Movement\"","}","","let ordered = Schedule {","    Gravity()","    Movement().after(Gravity.self)","}","print(ordered.ambiguities().isEmpty)","\/\/ Prints \"true\""]},{"inlineContent":[{"type":"text","text":"Order each pair with "},{"code":"after(_:)","type":"codeVoice"},{"type":"text","text":" or "},{"code":"before(_:)","type":"codeVoice"},{"type":"text","text":", or mark it with"},{"type":"text","text":" "},{"isActive":true,"type":"reference","identifier":"doc:\/\/Systems\/documentation\/Systems\/ScheduledSystem\/ambiguous(with:)"},{"type":"text","text":" when either order is right. Systems without an access"},{"type":"text","text":" "},{"type":"text","text":"always run alone, in the order written, and are left out. Call this method in a test to"},{"type":"text","text":" "},{"type":"text","text":"keep a schedule free of ambiguities."}],"type":"paragraph"},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"O("},{"type":"emphasis","inlineContent":[{"type":"text","text":"s"}]},{"type":"text","text":"·("},{"type":"emphasis","inlineContent":[{"type":"text","text":"s"}]},{"type":"text","text":" + "},{"type":"emphasis","inlineContent":[{"text":"c","type":"text"}]},{"type":"text","text":")) for "},{"type":"emphasis","inlineContent":[{"type":"text","text":"s"}]},{"type":"text","text":" systems and "},{"type":"emphasis","inlineContent":[{"text":"c","type":"text"}]},{"type":"text","text":" ordered pairs."}]}],"name":"Complexity","type":"aside","style":"note"}]}],"hierarchy":{"paths":[["doc:\/\/Systems\/documentation\/Systems","doc:\/\/Systems\/documentation\/Systems\/Schedule"]]},"sections":[],"kind":"symbol","identifier":{"url":"doc:\/\/Systems\/documentation\/Systems\/Schedule\/ambiguities()","interfaceLanguage":"swift"},"abstract":[{"text":"Returns every pair of systems whose accesses conflict but that no ordering constraint","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"orders."}],"seeAlsoSections":[{"generated":true,"identifiers":["doc:\/\/Systems\/documentation\/Systems\/Schedule\/systems","doc:\/\/Systems\/documentation\/Systems\/Schedule\/names","doc:\/\/Systems\/documentation\/Systems\/Ambiguity","doc:\/\/Systems\/documentation\/Systems\/Schedule\/writeDOT(to:)"],"anchor":"Inspecting-a-Schedule","title":"Inspecting a Schedule"}],"var