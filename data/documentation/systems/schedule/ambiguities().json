{"schemaVersion":{"major":0,"minor":3,"patch":0},"kind":"symbol","hierarchy":{"paths":[["doc:\/\/Systems\/documentation\/Systems","doc:\/\/Systems\/documentation\/Systems\/Schedule"]]},"primaryContentSections":[{"declarations":[{"tokens":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"ambiguities","kind":"identifier"},{"text":"() -> [","kind":"text"},{"text":"Ambiguity","kind":"typeIdentifier","identifier":"doc:\/\/Systems\/documentation\/Systems\/Ambiguity","preciseIdentifier":"s:7Systems9AmbiguityV"},{"text":"]","kind":"text"}],"platforms":["Linux"],"languages":["swift"]}],"kind":"declarations"},{"kind":"content","content":[{"anchor":"return-value","level":2,"text":"Return Value","type":"heading"},{"inlineContent":[{"type":"text","text":"The ambiguous pairs, ordered by the position of their first system and then"},{"type":"text","text":" "},{"type":"text","text":"their second."}],"type":"paragraph"}]},{"kind":"content","content":[{"text":"Discussion","type":"heading","level":2,"anchor":"discussion"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Such a pair runs in the order it’s written in, which is easy to change by accident. In the"},{"type":"text","text":" "},{"type":"text","text":"following schedule, "},{"type":"codeVoice","code":"Gravity"},{"type":"text","text":" writes the "},{"type":"codeVoice","code":"Velocity"},{"type":"text","text":" that "},{"type":"codeVoice","code":"Movement"},{"type":"text","text":" reads, but nothing"},{"type":"text","text":" "},{"type":"text","text":"says which runs first:"}]},{"type":"codeListing","code":["let frame = Schedule {","    Gravity()","    Movement()","}","for ambiguity in frame.ambiguities() {","    print(frame.names[ambiguity.first], frame.names[ambiguity.second])","    \/\/ Prints \"Gravity Movement\"","}","","let ordered = Schedule {","    Gravity()","    Movement().after(Gravity.self)","}","print(ordered.ambiguities().isEmpty)","\/\/ Prints \"true\""],"syntax":"swift"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Order each pair with "},{"type":"codeVoice","code":"after(_:)"},{"type":"text","text":" or "},{"type":"codeVoice","code":"before(_:)"},{"type":"text","text":", or mark it with"},{"type":"text","text":" "},{"type":"reference","identifier":"doc:\/\/Systems\/documentation\/Systems\/ScheduledSystem\/ambiguous(with:)","isActive":true},{"type":"text","text":" when either order is right. Systems without an access"},{"type":"text","text":" "},{"type":"text","text":"always run alone, in the order written, and are left out. Call this method in a test to"},{"type":"text","text":" "},{"type":"text","text":"keep a schedule free of ambiguities."}]},{"name":"Complexity","type":"aside","content":[{"inlineContent":[{"type":"text","text":"O("},{"type":"emphasis","inlineContent":[{"text":"s","type":"text"}]},{"type":"text","text":"·("},{"type":"emphasis","inlineContent":[{"text":"s","type":"text"}]},{"type":"text","text":" + "},{"type":"emphasis","inlineContent":[{"type":"text","text":"c"}]},{"type":"text","text":")) for "},{"type":"emphasis","inlineContent":[{"type":"text","text":"s"}]},{"type":"text","text":" systems and "},{"type":"emphasis","inlineContent":[{"type":"text","text":"c"}]},{"type":"text","text":" ordered pairs."}],"type":"paragraph"}],"style":"note"}]}],"identifier":{"url":"doc:\/\/Systems\/documentation\/Systems\/Schedule\/ambiguities()","interfaceLanguage":"swift"},"metadata":{"fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"ambiguities","kind":"identifier"},{"text":"() -> [","kind":"text"},{"text":"Ambiguity","preciseIdentifier":"s:7Systems9AmbiguityV","kind":"typeIdentifier"},{"text":"]","kind":"text"}],"modules":[{"name":"Systems"}],"extendedModule":"Systems","remoteSource":{"url":"https:\/\/github.com\/Tyler-Keith-Thompson\/ECS\/blob\/main\/Sources\/Systems\/Schedule.swift#L525","fileName":"Schedule.swift"},"roleHeading":"Instance Method","symbolKind":"method","title":"ambiguities