{"kind":"symbol","metadata":{"externalID":"s:7Systems8ScheduleV3run2ony11WorldModule0E0Vz_tF","role":"symbol","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"run","kind":"identifier"},{"text":"(","kind":"text"},{"text":"on","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"inout","kind":"keyword"},{"text":" ","kind":"text"},{"preciseIdentifier":"s:11WorldModule0A0V","text":"World","kind":"typeIdentifier"},{"text":")","kind":"text"}],"title":"run(on:)","symbolKind":"method","roleHeading":"Instance Method","modules":[{"name":"Systems"}],"remoteSource":{"url":"https:\/\/github.com\/Tyler-Keith-Thompson\/ECS\/blob\/main\/Sources\/Systems\/Schedule.swift#L132","fileName":"Schedule.swift"}},"abstract":[{"text":"Runs every system once on ","type":"text"},{"type":"codeVoice","code":"world"},{"text":", running systems that do not depend on each other at the","type":"text"},{"text":" ","type":"text"},{"text":"same time.","type":"text"}],"variants":[{"paths":["\/documentation\/systems\/schedule\/run(on:)"],"traits":[{"interfaceLanguage":"swift"}]}],"sections":[],"hierarchy":{"paths":[["doc:\/\/Systems\/documentation\/Systems","doc:\/\/Systems\/documentation\/Systems\/Schedule"]]},"schemaVersion":{"major":0,"patch":0,"minor":3},"identifier":{"url":"doc:\/\/Systems\/documentation\/Systems\/Schedule\/run(on:)","interfaceLanguage":"swift"},"primaryContentSections":[{"declarations":[{"platforms":["Linux"],"tokens":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"run","kind":"identifier"},{"text":"(","kind":"text"},{"text":"on","kind":"externalParam"},{"text":" ","kind":"text"},{"text":"world","kind":"internalParam"},{"text":": ","kind":"text"},{"text":"inout","kind":"keyword"},{"text":" ","kind":"text"},{"preciseIdentifier":"s:11WorldModule0A0V","text":"World","identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/World","kind":"typeIdentifier"},{"text":")","kind":"text"}],"languages":["swift"]}],"kind":"declarations"},{"content":[{"anchor":"discussion","level":2,"type":"heading","text":"Discussion"},{"inlineContent":[{"type":"text","text":"A system depends on the systems before it that it must run after, by an "},{"code":"after","type":"codeVoice"},{"type":"text","text":" or"},{"type":"text","text":" "},{"code":"before","type":"codeVoice"},{"type":"text","text":" constraint, and on those it conflicts with: one writes what the other reads or"},{"type":"text","text":" "},{"type":"text","text":"writes, or either has no "},{"type":"reference","identifier":"doc:\/\/Systems\/documentation\/Systems\/System\/access","isActive":true},{"type":"text","text":". The systems run in waves: each wave holds the"},{"type":"text","text":" "},{"type":"text","text":"systems whose dependencies all ran in earlier waves, and runs them with"},{"type":"text","text":" "},{"code":"WorldModule\/World\/runConcurrently(_:)","type":"codeVoice"},{"type":"text","text":". A system without an access runs alone. The world"},{"type":"text","text":" "},{"type":"text","text":"ends as it would running the systems one after another in order."}],"type":"paragraph"},{"inlineContent":[{"text":"At the start of each wave, every condition of its systems is checked, so a condition reads","type":"text"},{"text":" ","type":"text"},{"text":"only what its system’s access lists, and the world’s change tick advances. Each system’s","type":"text"},{"text":" ","type":"text"},{"code":"WorldModule\/World\/lastRun","type":"codeVoice"},{"text":" is the tick of its previous run, so filters such as","type":"text"},{"text":" ","type":"text"},{"code":".changed(Position.self)","type":"codeVoice"},{"text":" show it what changed since then: changes made by the systems","type":"text"},{"text":" ","type":"text"},{"text":"after it on the previous run and before it on this one, but not its own. A system that has","type":"text"},{"text":" ","type":"text"},{"text":"not run on this world before sees every component as added and changed. A skipped system","type":"text"},{"text":" ","type":"text"},{"text":"has not run: the next time it runs, it sees everything since it last did.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"Command buffers the wave’s systems queue (","type":"text"},{"code":"WorldModule\/World\/queue(_:)","type":"codeVoice"},{"text":") apply at the end","type":"text"},{"text":" ","type":"text"},{"text":"of the wave, in the order the systems run. The tick advances once more after the last wave,","type":"text"},{"text":" ","type":"text"},{"text":"so changes made to the world between runs are newer than every system’s previous run.","type":"text"}],"type":"paragraph"},{"name":"Precondition","style":"note","content":[{"inlineContent":[{"text":"Every system with an access reads and writes only what it lists; see","type":"text"},{"text":" ","type":"text"},{"code":"WorldModule\/World\/runConcurrently(_:)","type":"codeVoice"},{"text":".","type":"text"}],"type":"paragraph"}],"type":"aside"}],"kind":"content"}],"references":{"doc://Systems/documentation/Systems":{"role":"collection","url":"\/documentation\/systems","title":"Systems","abstract":[{"text":"Rules that run on a world, in the order written unless constrained otherwise.","type":"text"}],"kind":"symbol","type":"topic","identifier":"doc:\/\/Systems\/documentation\/Systems"},"doc://Systems/documentation/Systems/System/access":{"role":"symbol","required":true,"defaultImplementations":1,"url":"\/documentation\/systems\/system\/access","title":"access","abstract":[{"text":"What the system reads and writes, so ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/Systems\/documentation\/Systems\/Schedule\/run(on:)"},{"text":" can run it alongside","type":"text"},{"text":" ","type":"text"},{"text":"systems it does not conflict with; nil, the default, when it may change anything and must","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"run alone."}],"kind":"symbol","type":"topic","identifier":"doc:\/\/Systems\/documentation\/Systems\/System\/access","fragments":[{"text":"var","kind":"keyword"},{"text":" ","kind":"text"},{"text":"access","kind":"identifier"},{"text":": ","kind":"text"},{"text":"Access","preciseIdentifier":"s:11WorldModule6AccessV","kind":"typeIdentifier"},{"text":"?","kind":"text"}]},"doc://WorldModule/documentation/WorldModule/World":{"navigatorTitle":[{"text":"World","kind":"identifier"}],"fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"World","kind":"identifier"}],"role":"symbol","url":"\/documentation\/worldmodule\/world","identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/World","kind":"symbol","type":"topic","abstract":[{"type":"text","text":"Entities, the components they hold, and the world’s resources."}],"title":"World"},"doc://Systems/documentation/Systems/Schedule":{"role":"symbol","navigatorTitle":[{"text":"Schedule","kind":"identifier"}],"url":"\/documentation\/systems\/schedule","title":"Schedule","identifier":"doc:\/\/Systems\/documentation\/Systems\/Schedule","kind":"symbol","type":"topic","abstract":[{"text":"Systems that run on a world, as though in the order written, at the same time where they can.","type":"text"}],"fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Schedule","kind":"identifier"}]},"doc://Systems/documentation/Systems/Schedule/run(on:)":{"role":"symbol","url":"\/documentation\/systems\/schedule\/run(on:)","identifier":"doc:\/\/Systems\/documentation\/Systems\/Schedule\/run(on:)","title":"run(on:)","kind":"symbol","type":"topic","abstract":[{"type":"text","text":"Runs every system once on "},{"type":"codeVoice","code":"world"},{"type":"text","text":", running systems that do not depend on each other at the"},{"type":"text","text":" "},{"type":"text","text":"same time."}],"fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"run","kind":"identifier"},{"text":"(","kind":"text"},{"text":"on","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"inout","kind":"keyword"},{"text":" ","kind":"text"},{"text":"World","kind":"typeIdentifier","preciseIdentifier":"s:11WorldModule0A0V"},{"text":")","kind":"text"}]}}}