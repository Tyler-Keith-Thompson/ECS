{"metadata":{"remoteSource":{"fileName":"Schedule.swift","url":"https:\/\/github.com\/Tyler-Keith-Thompson\/ECS\/blob\/main\/Sources\/Systems\/Schedule.swift#L299"},"roleHeading":"Instance Method","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"kind":"identifier","text":"run"},{"kind":"text","text":"("},{"kind":"externalParam","text":"on"},{"kind":"text","text":": "},{"kind":"keyword","text":"inout"},{"kind":"text","text":" "},{"kind":"typeIdentifier","preciseIdentifier":"s:11WorldModule0A0V","text":"World"},{"text":")","kind":"text"}],"role":"symbol","modules":[{"name":"Systems"}],"symbolKind":"method","title":"run(on:)","externalID":"s:7Systems8ScheduleV3run2ony11WorldModule0E0Vz_tF"},"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/Systems\/documentation\/Systems\/Schedule\/run(on:)"},"sections":[],"schemaVersion":{"patch":0,"major":0,"minor":3},"seeAlsoSections":[{"title":"Running Systems","identifiers":["doc:\/\/Systems\/documentation\/Systems\/Schedule\/runSerially(on:)"],"anchor":"Running-Systems","generated":true}],"hierarchy":{"paths":[["doc:\/\/Systems\/documentation\/Systems","doc:\/\/Systems\/documentation\/Systems\/Schedule"]]},"primaryContentSections":[{"declarations":[{"tokens":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"run"},{"kind":"text","text":"("},{"kind":"externalParam","text":"on"},{"kind":"text","text":" "},{"kind":"internalParam","text":"world"},{"kind":"text","text":": "},{"kind":"keyword","text":"inout"},{"kind":"text","text":" "},{"preciseIdentifier":"s:11WorldModule0A0V","identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/World","kind":"typeIdentifier","text":"World"},{"kind":"text","text":")"}],"languages":["swift"],"platforms":["Linux"]}],"kind":"declarations"},{"kind":"parameters","parameters":[{"name":"world","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The world to run the systems on."}]}]}]},{"kind":"mentions","mentions":["doc:\/\/Systems\/documentation\/Systems\/SchedulingSystems"]},{"content":[{"text":"Discussion","type":"heading","anchor":"discussion","level":2},{"inlineContent":[{"text":"The world ends as though the systems had run one after another, in the order of","type":"text"},{"text":" ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/Systems\/documentation\/Systems\/Schedule\/systems"},{"text":", except that the commands systems queue apply when their wave finishes, so a","type":"text"},{"text":" ","type":"text"},{"text":"later system of the same wave doesn’t see them.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"A system depends on the systems before it that a constraint orders it after, and on those"},{"type":"text","text":" "},{"type":"text","text":"it conflicts with: one writes what the other reads or writes, or either has no"},{"type":"text","text":" "},{"isActive":true,"type":"reference","identifier":"doc:\/\/Systems\/documentation\/Systems\/System\/access"},{"type":"text","text":". The systems run in "},{"type":"emphasis","inlineContent":[{"type":"text","text":"waves"}]},{"type":"text","text":". Each wave holds the systems whose"},{"type":"text","text":" "},{"type":"text","text":"dependencies all ran in earlier waves, and runs them at the same time with"},{"type":"text","text":" "},{"isActive":true,"type":"reference","identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/World\/runConcurrently(_:)"},{"type":"text","text":". A system without an access runs alone, and a"},{"type":"text","text":" "},{"isActive":true,"type":"reference","identifier":"doc:\/\/Systems\/documentation\/Systems\/MainActorSystem"},{"type":"text","text":" runs on the calling thread after the other systems of its wave."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"Before the first wave, each system not yet initialized on this world is initialized"},{"type":"text","text":" "},{"type":"text","text":"("},{"type":"reference","identifier":"doc:\/\/Systems\/documentation\/Systems\/System\/initialize(in:)","isActive":true},{"type":"text","text":"), whether or not its conditions hold. At the start of each wave, the conditions of its systems are"},{"type":"text","text":" "},{"type":"text","text":"checked, and systems whose conditions don’t hold are skipped. Commands the wave’s systems"},{"type":"text","text":" "},{"type":"text","text":"queue apply at the end of the wave, in the order the systems run."}],"type":"paragraph"},{"text":"Change Detection","type":"heading","anchor":"Change-Detection","level":3},{"inlineContent":[{"type":"text","text":"The world’s change tick advances at the start of each wave that runs a system. While a system runs, the"},{"type":"text","text":" "},{"type":"text","text":"world’s "},{"identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/World\/lastRun","type":"reference","isActive":true},{"type":"text","text":" is the tick of that system’s previous run, so a"},{"type":"text","text":" "},{"type":"text","text":"filter such as "},{"type":"codeVoice","code":"Changed<Position>"},{"type":"text","text":" shows it what changed since then: the changes the"},{"type":"text","text":" "},{"type":"text","text":"systems after it made on the previous run and the systems before it made on this one, but"},{"type":"text","text":" "},{"type":"text","text":"not its own. The following system counts the positions that changed since it last ran:"}],"type":"paragraph"},{"code":["struct Moves: Resource { var count: Int }","","@System","struct CountMoves {","    func run(_ moved: Query<Position>.Where<Changed<Position>>, _ moves: ResourceWriter<Moves>) {","        for _ in moved { moves.value.count += 1 }","    }","}","","var world = World()","world.resources.insert(Moves(count: 0))","let ball = world.spawn(Position(x: 0, y: 0))","world.spawn(Position(x: 5, y: 0))","","let frame = Schedule { CountMoves() }","frame.run(on: &world)","print(world.resources[Moves.self].count)","\/\/ Prints \"2\"","","world[Position.self, of: ball].x = 1","frame.run(on: &world)","print(world.resources[Moves.self].count)","\/\/ Prints \"3\""],"syntax":"swift","type":"codeListing"},{"inlineContent":[{"text":"A system that hasn’t run on this world before sees every component as added and changed.","type":"text"},{"text":" ","type":"text"},{"text":"A skipped system hasn’t run, so the next time it runs it sees every change since it last","type":"text"},{"text":" ","type":"text"},{"text":"did. The tick advances once more after the last wave, so changes you make to the world","type":"text"},{"text":" ","type":"text"},{"text":"between runs are newer than every system’s previous run.","type":"text"}],"type":"paragraph"},{"type":"aside","style":"note","name":"Precondition","content":[{"inlineContent":[{"text":"Every system with an access reads and writes only what it lists; see","type":"text"},{"text":" ","type":"text"},{"identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/World\/runConcurrently(_:)","isActive":true,"type":"reference"},{"text":". A schedule holding a main-actor system that","type":"text"},{"text":" ","type":"text"},{"text":"runs is run on the main actor.","type":"text"}],"type":"paragraph"}]}],"kind":"content"}],"variants":[{"paths":["\/documentation\/systems\/schedule\/run(on:)"],"traits":[{"interfaceLanguage":"swift"}]}],"abstract":[{"type":"text","text":"Runs each system once on a world, running systems that don’t depend on each other at the"},{"type":"text","text":" "},{"type":"text","text":"same time."}],"kind":"symbol","references":{"doc://WorldModule/documentation/WorldModule/World/lastRun":{"type":"topic","fragments":[{"kind":"keyword","text":"var"},{"kind":"text","text":" "},{"kind":"identifier","text":"lastRun"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"ChangeTick","preciseIdentifier":"s:11WorldModule10ChangeTickV"}],"url":"\/documentation\/worldmodule\/world\/lastrun","title":"lastRun","kind":"symbol","role":"symbol","identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/World\/lastRun","abstract":[{"type":"text","text":"The change tick at which the running system last ran."}]},"doc://Systems/documentation/Systems/System/initialize(in:)":{"identifier":"doc:\/\/Systems\/documentation\/Systems\/System\/initialize(in:)","type":"topic","url":"\/documentation\/systems\/system\/initialize(in:)","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"initialize"},{"kind":"text","text":"("},{"kind":"externalParam","text":"in"},{"kind":"text","text":": "},{"kind":"keyword","text":"inout"},{"kind":"text","text":" "},{"kind":"typeIdentifier","preciseIdentifier":"s:11WorldModule0A0V","text":"World"},{"kind":"text","text":")"}],"defaultImplementations":1,"required":true,"kind":"symbol","abstract":[{"type":"text","text":"Prepares a world for the system before the system first runs on it."}],"title":"initialize(in:)","role":"symbol"},"doc://Systems/documentation/Systems/SchedulingSystems":{"role":"article","identifier":"doc:\/\/Systems\/documentation\/Systems\/SchedulingSystems","type":"topic","abstract":[{"text":"Order the systems of a schedule, run them only when a condition holds, and find out how a","type":"text"},{"text":" ","type":"text"},{"text":"schedule runs them.","type":"text"}],"title":"Scheduling Systems","kind":"article","url":"\/documentation\/systems\/schedulingsystems"},"doc://WorldModule/documentation/WorldModule/World":{"kind":"symbol","url":"\/documentation\/worldmodule\/world","title":"World","role":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"World"}],"navigatorTitle":[{"kind":"identifier","text":"World"}],"abstract":[{"type":"text","text":"A collection of entities, the components they hold, and resources."}],"type":"topic","identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/World"},"doc://Systems/documentation/Systems/Schedule/runSerially(on:)":{"type":"topic","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"runSerially"},{"kind":"text","text":"("},{"kind":"externalParam","text":"on"},{"kind":"text","text":": "},{"text":"inout","kind":"keyword"},{"text":" ","kind":"text"},{"text":"World","preciseIdentifier":"s:11WorldModule0A0V","kind":"typeIdentifier"},{"text":")","kind":"text"}],"url":"\/documentation\/systems\/schedule\/runserially(on:)","title":"runSerially(on:)","kind":"symbol","role":"symbol","identifier":"doc:\/\/Systems\/documentation\/Systems\/Schedule\/runSerially(on:)","abstract":[{"type":"text","text":"Runs each system once on a world, one system at a time."}]},"doc://WorldModule/documentation/WorldModule/World/runConcurrently(_:)":{"identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/World\/runConcurrently(_:)","type":"topic","url":"\/documentation\/worldmodule\/world\/runconcurrently(_:)","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"runConcurrently"},{"kind":"text","text":"(["},{"kind":"typeIdentifier","preciseIdentifier":"s:11WorldModule16ConcurrentChangeV","text":"ConcurrentChange"},{"kind":"text","text":"])"}],"abstract":[{"type":"text","text":"Runs changes at the same time, each on its own copy of the world, and keeps what each one"},{"type":"text","text":" "},{"type":"text","text":"wrote."}],"kind":"symbol","title":"runConcurrently(_:)","role":"symbol"},"doc://Systems/documentation/Systems/Schedule/systems":{"identifier":"doc:\/\/Systems\/documentation\/Systems\/Schedule\/systems","type":"topic","url":"\/documentation\/systems\/schedule\/systems","fragments":[{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"systems","kind":"identifier"},{"text":": [","kind":"text"},{"text":"ScheduledSystem","preciseIdentifier":"s:7Systems15ScheduledSystemV","kind":"typeIdentifier"},{"text":"]","kind":"text"}],"kind":"symbol","abstract":[{"type":"text","text":"The schedule’s systems, in the order they run."}],"title":"systems","role":"symbol"},"doc://Systems/documentation/Systems/Schedule":{"identifier":"doc:\/\/Systems\/documentation\/Systems\/Schedule","url":"\/documentation\/systems\/schedule","type":"topic","navigatorTitle":[{"kind":"identifier","text":"Schedule"}],"fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"Schedule"}],"role":"symbol","title":"Schedule","abstract":[{"type":"text","text":"A list of systems that run on a world, in order, and at the same time where they can."}],"kind":"symbol"},"doc://Systems/documentation/Systems":{"identifier":"doc:\/\/Systems\/documentation\/Systems","url":"\/documentation\/systems","type":"topic","role":"collection","title":"Systems","abstract":[{"type":"text","text":"Declare the rules of a simulation as systems, and run them on a world in a schedule."}],"kind":"symbol"},"doc://Systems/documentation/Systems/Schedule/run(on:)":{"identifier":"doc:\/\/Systems\/documentation\/Systems\/Schedule\/run(on:)","url":"\/documentation\/systems\/schedule\/run(on:)","type":"topic","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"run"},{"kind":"text","text":"("},{"kind":"externalParam","text":"on"},{"kind":"text","text":": "},{"kind":"keyword","text":"inout"},{"kind":"text","text":" "},{"preciseIdentifier":"s:11WorldModule0A0V","kind":"typeIdentifier","text":"World"},{"kind":"text","text":")"}],"role":"symbol","abstract":[{"type":"text","text":"Runs each system once on a world, running systems that don’t depend on each other at the"},{"type":"text","text":" "},{"type":"text","text":"same time."}],"title":"run(on:)","kind":"symbol"},"doc://Systems/documentation/Systems/MainActorSystem":{"type":"topic","identifier":"doc:\/\/Systems\/documentation\/Systems\/MainActorSystem","url":"\/documentation\/systems\/mainactorsystem","navigatorTitle":[{"text":"MainActorSystem","kind":"identifier"}],"fragments":[{"text":"protocol","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MainActorSystem","kind":"identifier"}],"role":"symbol","abstract":[{"type":"text","text":"A system that runs on the main actor, for work that touches main-actor state such as a user"},{"type":"text","text":" "},{"type":"text","text":"interface."}],"title":"MainActorSystem","kind":"symbol"},"doc://Systems/documentation/Systems/System/access":{"role":"symbol","required":true,"identifier":"doc:\/\/Systems\/documentation\/Systems\/System\/access","defaultImplementations":1,"type":"topic","fragments":[{"kind":"keyword","text":"var"},{"kind":"text","text":" "},{"kind":"identifier","text":"access"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:11WorldModule6AccessV","text":"Access"},{"kind":"text","text":"?"}],"abstract":[{"text":"The component, resource and event types the system reads and writes, or ","type":"text"},{"type":"codeVoice","code":"nil"},{"text":" if it may","type":"text"},{"text":" ","type":"text"},{"text":"change anything.","type":"text"}],"title":"access","kind":"symbol","url":"\/documentation\/systems\/system\/access"}}}