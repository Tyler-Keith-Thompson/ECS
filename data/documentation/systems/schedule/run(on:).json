{"hierarchy":{"paths":[["doc:\/\/Systems\/documentation\/Systems","doc:\/\/Systems\/documentation\/Systems\/Schedule"]]},"sections":[],"kind":"symbol","identifier":{"url":"doc:\/\/Systems\/documentation\/Systems\/Schedule\/run(on:)","interfaceLanguage":"swift"},"primaryContentSections":[{"declarations":[{"languages":["swift"],"platforms":["Linux"],"tokens":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"run"},{"kind":"text","text":"("},{"kind":"externalParam","text":"on"},{"kind":"text","text":" "},{"kind":"internalParam","text":"world"},{"kind":"text","text":": "},{"kind":"keyword","text":"inout"},{"kind":"text","text":" "},{"preciseIdentifier":"s:11WorldModule0A0V","kind":"typeIdentifier","text":"World","identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/World"},{"kind":"text","text":")"}]}],"kind":"declarations"},{"content":[{"type":"heading","text":"Discussion","level":2,"anchor":"discussion"},{"type":"paragraph","inlineContent":[{"type":"text","text":"A system depends on the systems before it that it must run after, by an "},{"code":"after","type":"codeVoice"},{"type":"text","text":" or"},{"type":"text","text":" "},{"code":"before","type":"codeVoice"},{"type":"text","text":" constraint, and on those it conflicts with: one writes what the other reads or"},{"type":"text","text":" "},{"type":"text","text":"writes, or either has no "},{"isActive":true,"type":"reference","identifier":"doc:\/\/Systems\/documentation\/Systems\/System\/access"},{"type":"text","text":". The systems run in waves: each wave holds the"},{"type":"text","text":" "},{"type":"text","text":"systems whose dependencies all ran in earlier waves, and runs them with"},{"type":"text","text":" "},{"code":"WorldModule\/World\/runConcurrently(_:)","type":"codeVoice"},{"type":"text","text":". A system without an access runs alone. The world"},{"type":"text","text":" "},{"type":"text","text":"ends as it would running the systems one after another in order."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"At the start of each wave, every condition of its systems is checked, so a condition reads"},{"type":"text","text":" "},{"type":"text","text":"only what its system’s access lists, and the world’s change tick advances. Each system’s"},{"type":"text","text":" "},{"type":"codeVoice","code":"WorldModule\/World\/lastRun"},{"type":"text","text":" is the tick of its previous run, so filters such as"},{"type":"text","text":" "},{"type":"codeVoice","code":".changed(Position.self)"},{"type":"text","text":" show it what changed since then: changes made by the systems"},{"type":"text","text":" "},{"type":"text","text":"after it on the previous run and before it on this one, but not its own. A system that has"},{"type":"text","text":" "},{"type":"text","text":"not run on this world before sees every component as added and changed. A skipped system"},{"type":"text","text":" "},{"type":"text","text":"has not run: the next time it runs, it sees everything since it last did."}]},{"type":"paragraph","inlineContent":[{"text":"Before the first wave, each system that has not run on this world is initialized","type":"text"},{"text":" ","type":"text"},{"text":"(","type":"text"},{"identifier":"doc:\/\/Systems\/documentation\/Systems\/System\/initialize(in:)","isActive":true,"type":"reference"},{"text":").","type":"text"}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Command buffers the wave’s systems queue ("},{"code":"WorldModule\/World\/queue(_:)","type":"codeVoice"},{"type":"text","text":") apply at the end"},{"type":"text","text":" "},{"type":"text","text":"of the wave, in the order the systems run. The tick advances once more after the last wave,"},{"type":"text","text":" "},{"type":"text","text":"so changes made to the world between runs are newer than every system’s previous run."}]},{"type":"aside","name":"Precondition","style":"note","content":[{"inlineContent":[{"text":"Every system with an access reads and writes only what it lists; see","type":"text"},{"text":" ","type":"text"},{"code":"WorldModule\/World\/runConcurrently(_:)","type":"codeVoice"},{"text":".","type":"text"}],"type":"paragraph"}]}],"kind":"content"}],"variants":[{"paths":["\/documentation\/systems\/schedule\/run(on:)"],"traits":[{"interfaceLanguage":"swift"}]}],"schemaVersion":{"major":0,"minor":3,"patch":0},"abstract":[{"text":"Runs every system once on ","type":"text"},{"code":"world","type":"codeVoice"},{"text":", running systems that do not depend on each other at the","type":"text"},{"text":" ","type":"text"},{"text":"same time.","type":"text"}],"metadata":{"title":"run(on:)","modules":[{"name":"Systems"}],"symbolKind":"method","externalID":"s:7Systems8ScheduleV3run2ony11WorldModule0E0Vz_tF","remoteSource":{"fileName":"Schedule.swift","url":"https:\/\/github.com\/Tyler-Keith-Thompson\/ECS\/blob\/main\/Sources\/Systems\/Schedule.swift#L162"},"role":"symbol","roleHeading":"Instance Method","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"run"},{"kind":"text","text":"("},{"kind":"externalParam","text":"on"},{"kind":"text","text":": "},{"kind":"keyword","text":"inout"},{"kind":"text","text":" "},{"kind":"typeIdentifier","preciseIdentifier":"s:11WorldModule0A0V","text":"World"},{"kind":"text","text":")"}]},"references":{"doc://Systems/documentation/Systems":{"title":"Systems","identifier":"doc:\/\/Systems\/documentation\/Systems","abstract":[{"type":"text","text":"Rules that run on a world, in the order written unless constrained otherwise."}],"kind":"symbol","url":"\/documentation\/systems","role":"collection","type":"topic"},"doc://Systems/documentation/Systems/Schedule":{"fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Schedule","kind":"identifier"}],"abstract":[{"text":"Systems that run on a world, as though in the order written, at the same time where they can.","type":"text"}],"type":"topic","navigatorTitle":[{"text":"Schedule","kind":"identifier"}],"title":"Schedule","url":"\/documentation\/systems\/schedule","identifier":"doc:\/\/Systems\/documentation\/Systems\/Schedule","kind":"symbol","role":"symbol"},"doc://WorldModule/documentation/WorldModule/World":{"title":"World","identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/World","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"World"}],"abstract":[{"text":"Entities, the components they hold, and the world’s resources.","type":"text"}],"kind":"symbol","url":"\/documentation\/worldmodule\/world","role":"symbol","navigatorTitle":[{"kind":"identifier","text":"World"}],"type":"topic"},"doc://Systems/documentation/Systems/System/access":{"identifier":"doc:\/\/Systems\/documentation\/Systems\/System\/access","url":"\/documentation\/systems\/system\/access","kind":"symbol","title":"access","required":true,"defaultImplementations":1,"role":"symbol","abstract":[{"type":"text","text":"What the system reads and writes, so "},{"type":"reference","isActive":true,"identifier":"doc:\/\/Systems\/documentation\/Systems\/Schedule\/run(on:)"},{"type":"text","text":" can run it alongside"},{"type":"text","text":" "},{"type":"text","text":"systems it does not conflict with; nil, the default, when it may change anything and must"},{"type":"text","text":" "},{"type":"text","text":"run alone."}],"type":"topic","fragments":[{"kind":"keyword","text":"var"},{"kind":"text","text":" "},{"kind":"identifier","text":"access"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"Access","preciseIdentifier":"s:11WorldModule6AccessV"},{"kind":"text","text":"?"}]},"doc://Systems/documentation/Systems/System/initialize(in:)":{"abstract":[{"text":"Prepares ","type":"text"},{"type":"codeVoice","code":"world"},{"text":" for the system, before its first run on it: a schedule calls this","type":"text"},{"text":" ","type":"text"},{"text":"before the wave the system first runs in, outside any concurrent run. Nothing, by default.","type":"text"}],"kind":"symbol","url":"\/documentation\/systems\/system\/initialize(in:)","role":"symbol","title":"initialize(in:)","defaultImplementations":1,"identifier":"doc:\/\/Systems\/documentation\/Systems\/System\/initialize(in:)","type":"topic","required":true,"fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"initialize","kind":"identifier"},{"text":"(","kind":"text"},{"text":"in","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"inout","kind":"keyword"},{"text":" ","kind":"text"},{"text":"World","preciseIdentifier":"s:11WorldModule0A0V","kind":"typeIdentifier"},{"text":")","kind":"text"}]},"doc://Systems/documentation/Systems/Schedule/run(on:)":{"identifier":"doc:\/\/Systems\/documentation\/Systems\/Schedule\/run(on:)","url":"\/documentation\/systems\/schedule\/run(on:)","kind":"symbol","title":"run(on:)","role":"symbol","abstract":[{"text":"Runs every system once on ","type":"text"},{"code":"world","type":"codeVoice"},{"text":", running systems that do not depend on each other at the","type":"text"},{"text":" ","type":"text"},{"text":"same time.","type":"text"}],"type":"topic","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"run","kind":"identifier"},{"text":"(","kind":"text"},{"text":"on","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"inout","kind":"keyword"},{"text":" ","kind":"text"},{"text":"World","kind":"typeIdentifier","preciseIdentifier":"s:11WorldModule0A0V"},{"text":")","kind":"text"}]}}}