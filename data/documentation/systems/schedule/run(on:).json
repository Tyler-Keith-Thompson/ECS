{"metadata":{"role":"symbol","symbolKind":"method","externalID":"s:7Systems8ScheduleV3run2ony11WorldModule0E0Vz_tF","remoteSource":{"fileName":"Schedule.swift","url":"https:\/\/github.com\/Tyler-Keith-Thompson\/ECS\/blob\/main\/Sources\/Systems\/Schedule.swift#L299"},"roleHeading":"Instance Method","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"run","kind":"identifier"},{"text":"(","kind":"text"},{"text":"on","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"inout","kind":"keyword"},{"text":" ","kind":"text"},{"text":"World","kind":"typeIdentifier","preciseIdentifier":"s:11WorldModule0A0V"},{"text":")","kind":"text"}],"modules":[{"name":"Systems"}],"title":"run(on:)"},"kind":"symbol","identifier":{"url":"doc:\/\/Systems\/documentation\/Systems\/Schedule\/run(on:)","interfaceLanguage":"swift"},"sections":[],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/systems\/schedule\/run(on:)"]}],"hierarchy":{"paths":[["doc:\/\/Systems\/documentation\/Systems","doc:\/\/Systems\/documentation\/Systems\/Schedule"]]},"seeAlsoSections":[{"identifiers":["doc:\/\/Systems\/documentation\/Systems\/Schedule\/runSerially(on:)"],"title":"Running Systems","generated":true,"anchor":"Running-Systems"}],"schemaVersion":{"minor":3,"patch":0,"major":0},"primaryContentSections":[{"kind":"declarations","declarations":[{"platforms":["Linux"],"languages":["swift"],"tokens":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"run","kind":"identifier"},{"text":"(","kind":"text"},{"text":"on","kind":"externalParam"},{"text":" ","kind":"text"},{"text":"world","kind":"internalParam"},{"text":": ","kind":"text"},{"text":"inout","kind":"keyword"},{"text":" ","kind":"text"},{"text":"World","kind":"typeIdentifier","identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/World","preciseIdentifier":"s:11WorldModule0A0V"},{"text":")","kind":"text"}]}]},{"kind":"parameters","parameters":[{"name":"world","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The world to run the systems on."}]}]}]},{"kind":"content","content":[{"anchor":"discussion","text":"Discussion","level":2,"type":"heading"},{"inlineContent":[{"type":"text","text":"The world ends as though the systems had run one after another, in the order of"},{"type":"text","text":" "},{"identifier":"doc:\/\/Systems\/documentation\/Systems\/Schedule\/systems","type":"reference","isActive":true},{"type":"text","text":", except that the commands systems queue apply when their wave finishes, so a"},{"type":"text","text":" "},{"type":"text","text":"later system of the same wave doesn’t see them."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"A system depends on the systems before it that a constraint orders it after, and on those"},{"type":"text","text":" "},{"type":"text","text":"it conflicts with: one writes what the other reads or writes, or either has no"},{"type":"text","text":" "},{"type":"reference","identifier":"doc:\/\/Systems\/documentation\/Systems\/System\/access","isActive":true},{"type":"text","text":". The systems run in "},{"type":"emphasis","inlineContent":[{"type":"text","text":"waves"}]},{"type":"text","text":". Each wave holds the systems whose"},{"type":"text","text":" "},{"type":"text","text":"dependencies all ran in earlier waves, and runs them at the same time with"},{"type":"text","text":" "},{"type":"reference","identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/World\/runConcurrently(_:)","isActive":true},{"type":"text","text":". A system without an access runs alone, and a"},{"type":"text","text":" "},{"type":"reference","identifier":"doc:\/\/Systems\/documentation\/Systems\/MainActorSystem","isActive":true},{"type":"text","text":" runs on the calling thread after the other systems of its wave."}],"type":"paragraph"},{"inlineContent":[{"text":"Before the first wave, each system not yet initialized on this world is initialized","type":"text"},{"text":" ","type":"text"},{"text":"(","type":"text"},{"isActive":true,"identifier":"doc:\/\/Systems\/documentation\/Systems\/System\/initialize(in:)","type":"reference"},{"text":"), whether or not its conditions hold. At the start of each wave, the conditions of its systems are","type":"text"},{"text":" ","type":"text"},{"text":"checked, and systems whose conditions don’t hold are skipped. Commands the wave’s systems","type":"text"},{"text":" ","type":"text"},{"text":"queue apply at the end of the wave, in the order the systems run.","type":"text"}],"type":"paragraph"},{"anchor":"Change-Detection","text":"Change Detection","level":3,"type":"heading"},{"inlineContent":[{"text":"The world’s change tick advances at the start of each wave that runs a system. While a system runs, the","type":"text"},{"text":" ","type":"text"},{"text":"world’s ","type":"text"},{"isActive":true,"identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/World\/lastRun","type":"reference"},{"text":" is the tick of that system’s previous run, so a","type":"text"},{"text":" ","type":"text"},{"text":"filter such as ","type":"text"},{"type":"codeVoice","code":"Changed<Position>"},{"text":" shows it what changed since then: the changes the","type":"text"},{"text":" ","type":"text"},{"text":"systems after it made on the previous run and the systems before it made on this one, but","type":"text"},{"text":" ","type":"text"},{"text":"not its own. The following system counts the positions that changed since it last ran:","type":"text"}],"type":"paragraph"},{"syntax":"swift","code":["struct Moves: Resource { var count: Int }","","@System","struct CountMoves {","    func run(_ moved: Query<Position>.Where<Changed<Position>>, _ moves: ResourceWriter<Moves>) {","        for _ in moved { moves.value.count += 1 }","    }","}","","var world = World()","world.resources.insert(Moves(count: 0))","let ball = world.spawn(Position(x: 0, y: 0))","world.spawn(Position(x: 5, y: 0))","","let frame = Schedule { CountMoves() }","frame.run(on: &world)","print(world.resources[Moves.self].count)","\/\/ Prints \"2\"","","world[Position.self, of: ball].x = 1","frame.run(on: &world)","print(world.resources[Moves.self].count)","\/\/ Prints \"3\""],"type":"codeListing"},{"inlineContent":[{"text":"A system that hasn’t run on this world before sees every component as added and changed.","type":"text"},{"text":" ","type":"text"},{"text":"A skipped system hasn’t run, so the next time it runs it sees every change since it last","type":"text"},{"text":" ","type":"text"},{"text":"did. The tick advances once more after the last wave, so changes you make to the world","type":"text"},{"text":" ","type":"text"},{"text":"between runs are newer than every system’s previous run.","type":"text"}],"type":"paragraph"},{"name":"Precondition","content":[{"inlineContent":[{"text":"Every system with an access reads and writes only what it lists; see","type":"text"},{"text":" ","type":"text"},{"identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/World\/runConcurrently(_:)","type":"reference","isActive":true},{"text":". A schedule holding a main-actor system that","type":"text"},{"text":" ","type":"text"},{"text":"runs is run on the main actor.","type":"text"}],"type":"paragraph"}],"style":"note","type":"aside"}]}],"abstract":[{"text":"Runs each system once on a world, running systems that don’t depend on each other at the","type":"text"},{"text":" ","type":"text"},{"text":"same time.","type":"text"}],"references":{"doc://Systems/documentation/Systems/MainActorSystem":{"role":"symbol","navigatorTitle":[{"text":"MainActorSystem","kind":"identifier"}],"identifier":"doc:\/\/Systems\/documentation\/Systems\/MainActorSystem","kind":"symbol","fragments":[{"text":"protocol","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MainActorSystem","kind":"identifier"}],"title":"MainActorSystem","abstract":[{"type":"text","text":"A system that runs on the main actor, for work that touches main-actor state such as a user"},{"type":"text","text":" "},{"type":"text","text":"interface."}],"type":"topic","url":"\/documentation\/systems\/mainactorsystem"},"doc://Systems/documentation/Systems/Schedule/systems":{"identifier":"doc:\/\/Systems\/documentation\/Systems\/Schedule\/systems","kind":"symbol","fragments":[{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"systems","kind":"identifier"},{"text":": [","kind":"text"},{"text":"ScheduledSystem","preciseIdentifier":"s:7Systems15ScheduledSystemV","kind":"typeIdentifier"},{"text":"]","kind":"text"}],"abstract":[{"text":"The schedule’s systems, in the order they run.","type":"text"}],"role":"symbol","type":"topic","url":"\/documentation\/systems\/schedule\/systems","title":"systems"},"doc://Systems/documentation/Systems/System/access":{"role":"symbol","required":true,"identifier":"doc:\/\/Systems\/documentation\/Systems\/System\/access","kind":"symbol","fragments":[{"kind":"keyword","text":"var"},{"kind":"text","text":" "},{"kind":"identifier","text":"access"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:11WorldModule6AccessV","text":"Access"},{"kind":"text","text":"?"}],"defaultImplementations":1,"title":"access","abstract":[{"text":"The component, resource and event types the system reads and writes, or ","type":"text"},{"code":"nil","type":"codeVoice"},{"text":" if it may","type":"text"},{"text":" ","type":"text"},{"text":"change anything.","type":"text"}],"type":"topic","url":"\/documentation\/systems\/system\/access"},"doc://Systems/documentation/Systems/System/initialize(in:)":{"abstract":[{"type":"text","text":"Prepares a world for the system before the system first runs on it."}],"type":"topic","kind":"symbol","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"initialize","kind":"identifier"},{"text":"(","kind":"text"},{"text":"in","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"inout","kind":"keyword"},{"text":" ","kind":"text"},{"text":"World","preciseIdentifier":"s:11WorldModule0A0V","kind":"typeIdentifier"},{"text":")","kind":"text"}],"identifier":"doc:\/\/Systems\/documentation\/Systems\/System\/initialize(in:)","required":true,"role":"symbol","title":"initialize(in:)","defaultImplementations":1,"url":"\/documentation\/systems\/system\/initialize(in:)"},"doc://WorldModule/documentation/WorldModule/World/lastRun":{"abstract":[{"text":"The change tick at which the running system last ran.","type":"text"}],"type":"topic","kind":"symbol","fragments":[{"kind":"keyword","text":"var"},{"kind":"text","text":" "},{"kind":"identifier","text":"lastRun"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:11WorldModule10ChangeTickV","text":"ChangeTick"}],"identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/World\/lastRun","role":"symbol","title":"lastRun","url":"\/documentation\/worldmodule\/world\/lastrun"},"doc://Systems/documentation/Systems/Schedule/run(on:)":{"role":"symbol","kind":"symbol","identifier":"doc:\/\/Systems\/documentation\/Systems\/Schedule\/run(on:)","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"run"},{"kind":"text","text":"("},{"kind":"externalParam","text":"on"},{"kind":"text","text":": "},{"kind":"keyword","text":"inout"},{"kind":"text","text":" "},{"preciseIdentifier":"s:11WorldModule0A0V","kind":"typeIdentifier","text":"World"},{"kind":"text","text":")"}],"title":"run(on:)","abstract":[{"type":"text","text":"Runs each system once on a world, running systems that don’t depend on each other at the"},{"type":"text","text":" "},{"type":"text","text":"same time."}],"type":"topic","url":"\/documentation\/systems\/schedule\/run(on:)"},"doc://Systems/documentation/Systems/Schedule":{"role":"symbol","navigatorTitle":[{"kind":"identifier","text":"Schedule"}],"kind":"symbol","identifier":"doc:\/\/Systems\/documentation\/Systems\/Schedule","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"Schedule"}],"title":"Schedule","abstract":[{"text":"A list of systems that run on a world, in order, and at the same time where they can.","type":"text"}],"type":"topic","url":"\/documentation\/systems\/schedule"},"doc://WorldModule/documentation/WorldModule/World/runConcurrently(_:)":{"identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/World\/runConcurrently(_:)","kind":"symbol","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"runConcurrently","kind":"identifier"},{"text":"([","kind":"text"},{"preciseIdentifier":"s:11WorldModule16ConcurrentChangeV","text":"ConcurrentChange","kind":"typeIdentifier"},{"text":"])","kind":"text"}],"abstract":[{"type":"text","text":"Runs changes at the same time, each on its own copy of the world, and keeps what each one"},{"type":"text","text":" "},{"type":"text","text":"wrote."}],"role":"symbol","url":"\/documentation\/worldmodule\/world\/runconcurrently(_:)","type":"topic","title":"runConcurrently(_:)"},"doc://Systems/documentation/Systems/Schedule/runSerially(on:)":{"identifier":"doc:\/\/Systems\/documentation\/Systems\/Schedule\/runSerially(on:)","kind":"symbol","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"runSerially","kind":"identifier"},{"text":"(","kind":"text"},{"text":"on","kind":"externalParam"},{"text":": ","kind":"text"},{"kind":"keyword","text":"inout"},{"kind":"text","text":" "},{"kind":"typeIdentifier","preciseIdentifier":"s:11WorldModule0A0V","text":"World"},{"kind":"text","text":")"}],"abstract":[{"text":"Runs each system once on a world, one system at a time.","type":"text"}],"role":"symbol","url":"\/documentation\/systems\/schedule\/runserially(on:)","type":"topic","title":"runSerially(on:)"},"doc://WorldModule/documentation/WorldModule/World":{"navigatorTitle":[{"text":"World","kind":"identifier"}],"abstract":[{"type":"text","text":"A collection of entities, the components they hold, and resources."}],"type":"topic","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"World","kind":"identifier"}],"role":"symbol","url":"\/documentation\/worldmodule\/world","kind":"symbol","identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/World","title":"World"},"doc://Systems/documentation/Systems":{"kind":"symbol","url":"\/documentation\/systems","title":"Systems","role":"collection","type":"topic","identifier":"doc:\/\/Systems\/documentation\/Systems","abstract":[{"type":"text","text":"Declare the rules of a simulation as systems, and run them on a world in a schedule."}]}}}