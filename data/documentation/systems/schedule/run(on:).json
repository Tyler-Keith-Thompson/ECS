{"hierarchy":{"paths":[["doc:\/\/Systems\/documentation\/Systems","doc:\/\/Systems\/documentation\/Systems\/Schedule"]]},"schemaVersion":{"patch":0,"major":0,"minor":3},"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/systems\/schedule\/run(on:)"]}],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/Systems\/documentation\/Systems\/Schedule\/run(on:)"},"metadata":{"remoteSource":{"fileName":"Schedule.swift","url":"https:\/\/github.com\/Tyler-Keith-Thompson\/ECS\/blob\/main\/Sources\/Systems\/Schedule.swift#L166"},"symbolKind":"method","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"kind":"identifier","text":"run"},{"kind":"text","text":"("},{"kind":"externalParam","text":"on"},{"kind":"text","text":": "},{"kind":"keyword","text":"inout"},{"kind":"text","text":" "},{"preciseIdentifier":"s:11WorldModule0A0V","kind":"typeIdentifier","text":"World"},{"text":")","kind":"text"}],"roleHeading":"Instance Method","externalID":"s:7Systems8ScheduleV3run2ony11WorldModule0E0Vz_tF","role":"symbol","title":"run(on:)","modules":[{"name":"Systems"}]},"sections":[],"primaryContentSections":[{"declarations":[{"platforms":["Linux"],"languages":["swift"],"tokens":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"run"},{"kind":"text","text":"("},{"kind":"externalParam","text":"on"},{"kind":"text","text":" "},{"kind":"internalParam","text":"world"},{"kind":"text","text":": "},{"kind":"keyword","text":"inout"},{"kind":"text","text":" "},{"kind":"typeIdentifier","text":"World","identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/World","preciseIdentifier":"s:11WorldModule0A0V"},{"kind":"text","text":")"}]}],"kind":"declarations"},{"content":[{"anchor":"discussion","text":"Discussion","level":2,"type":"heading"},{"inlineContent":[{"text":"A system depends on the systems before it that it must run after, by an ","type":"text"},{"type":"codeVoice","code":"after"},{"text":" or","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"before"},{"text":" constraint, and on those it conflicts with: one writes what the other reads or","type":"text"},{"text":" ","type":"text"},{"text":"writes, or either has no ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/Systems\/documentation\/Systems\/System\/access"},{"text":". The systems run in waves: each wave holds the","type":"text"},{"text":" ","type":"text"},{"text":"systems whose dependencies all ran in earlier waves, and runs them with","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"WorldModule\/World\/runConcurrently(_:)"},{"text":". A system without an access runs alone. The world","type":"text"},{"text":" ","type":"text"},{"text":"ends as it would running the systems one after another in order.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"At the start of each wave, every condition of its systems is checked, so a condition reads","type":"text"},{"text":" ","type":"text"},{"text":"only what its system’s access lists, and the world’s change tick advances. Each system’s","type":"text"},{"text":" ","type":"text"},{"code":"WorldModule\/World\/lastRun","type":"codeVoice"},{"text":" is the tick of its previous run, so filters such as","type":"text"},{"text":" ","type":"text"},{"code":".changed(Position.self)","type":"codeVoice"},{"text":" show it what changed since then: changes made by the systems","type":"text"},{"text":" ","type":"text"},{"text":"after it on the previous run and before it on this one, but not its own. A system that has","type":"text"},{"text":" ","type":"text"},{"text":"not run on this world before sees every component as added and changed. A skipped system","type":"text"},{"text":" ","type":"text"},{"text":"has not run: the next time it runs, it sees everything since it last did.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"Before the first wave, each system that has not run on this world is initialized","type":"text"},{"text":" ","type":"text"},{"text":"(","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/Systems\/documentation\/Systems\/System\/initialize(in:)"},{"text":").","type":"text"}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"Command buffers the wave’s systems queue ("},{"type":"codeVoice","code":"WorldModule\/World\/queue(_:)"},{"type":"text","text":") apply at the end"},{"type":"text","text":" "},{"type":"text","text":"of the wave, in the order the systems run. The tick advances once more after the last wave,"},{"type":"text","text":" "},{"type":"text","text":"so changes made to the world between runs are newer than every system’s previous run."}],"type":"paragraph"},{"inlineContent":[{"text":"A ","type":"text"},{"isActive":true,"identifier":"doc:\/\/Systems\/documentation\/Systems\/MainActorSystem","type":"reference"},{"text":" runs on the calling thread after the other systems of its wave.","type":"text"}],"type":"paragraph"},{"name":"Precondition","style":"note","type":"aside","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Every system with an access reads and writes only what it lists; see"},{"type":"text","text":" "},{"code":"WorldModule\/World\/runConcurrently(_:)","type":"codeVoice"},{"type":"text","text":". A schedule whose main-actor systems run is run"},{"type":"text","text":" "},{"type":"text","text":"on the main actor."}]}]}],"kind":"content"}],"kind":"symbol","abstract":[{"text":"Runs every system once on ","type":"text"},{"code":"world","type":"codeVoice"},{"text":", running systems that do not depend on each other at the","type":"text"},{"text":" ","type":"text"},{"text":"same time.","type":"text"}],"references":{"doc://Systems/documentation/Systems/Schedule":{"kind":"symbol","identifier":"doc:\/\/Systems\/documentation\/Systems\/Schedule","title":"Schedule","url":"\/documentation\/systems\/schedule","type":"topic","abstract":[{"text":"Systems that run on a world, as though in the order written, at the same time where they can.","type":"text"}],"role":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"Schedule"}],"navigatorTitle":[{"kind":"identifier","text":"Schedule"}]},"doc://Systems/documentation/Systems/System/initialize(in:)":{"title":"initialize(in:)","identifier":"doc:\/\/Systems\/documentation\/Systems\/System\/initialize(in:)","type":"topic","required":true,"abstract":[{"type":"text","text":"Prepares "},{"code":"world","type":"codeVoice"},{"type":"text","text":" for the system, before its first run on it: a schedule calls this"},{"type":"text","text":" "},{"type":"text","text":"before the wave the system first runs in, outside any concurrent run. Nothing, by default."}],"kind":"symbol","role":"symbol","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"initialize","kind":"identifier"},{"text":"(","kind":"text"},{"text":"in","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"inout","kind":"keyword"},{"text":" ","kind":"text"},{"preciseIdentifier":"s:11WorldModule0A0V","text":"World","kind":"typeIdentifier"},{"kind":"text","text":")"}],"url":"\/documentation\/systems\/system\/initialize(in:)","defaultImplementations":1},"doc://Systems/documentation/Systems/MainActorSystem":{"kind":"symbol","identifier":"doc:\/\/Systems\/documentation\/Systems\/MainActorSystem","title":"MainActorSystem","url":"\/documentation\/systems\/mainactorsystem","type":"topic","abstract":[{"type":"text","text":"A system whose "},{"type":"codeVoice","code":"run"},{"type":"text","text":" is isolated to the main actor, for work that touches main-actor state"},{"type":"text","text":" "},{"type":"text","text":"such as a user interface."}],"role":"symbol","fragments":[{"kind":"keyword","text":"protocol"},{"kind":"text","text":" "},{"kind":"identifier","text":"MainActorSystem"}],"navigatorTitle":[{"kind":"identifier","text":"MainActorSystem"}]},"doc://WorldModule/documentation/WorldModule/World":{"title":"World","identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/World","navigatorTitle":[{"kind":"identifier","text":"World"}],"url":"\/documentation\/worldmodule\/world","kind":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"World"}],"type":"topic","abstract":[{"type":"text","text":"Entities, the components they hold, and the world’s resources."}],"role":"symbol"},"doc://Systems/documentation/Systems":{"kind":"symbol","identifier":"doc:\/\/Systems\/documentation\/Systems","url":"\/documentation\/systems","title":"Systems","type":"topic","abstract":[{"type":"text","text":"Rules that run on a world, in the order written unless constrained otherwise."}],"role":"collection"},"doc://Systems/documentation/Systems/System/access":{"url":"\/documentation\/systems\/system\/access","identifier":"doc:\/\/Systems\/documentation\/Systems\/System\/access","title":"access","type":"topic","fragments":[{"kind":"keyword","text":"var"},{"kind":"text","text":" "},{"kind":"identifier","text":"access"},{"kind":"text","text":": "},{"preciseIdentifier":"s:11WorldModule6AccessV","kind":"typeIdentifier","text":"Access"},{"kind":"text","text":"?"}],"kind":"symbol","role":"symbol","abstract":[{"type":"text","text":"What the system reads and writes, so "},{"type":"reference","identifier":"doc:\/\/Systems\/documentation\/Systems\/Schedule\/run(on:)","isActive":true},{"type":"text","text":" can run it alongside"},{"type":"text","text":" "},{"type":"text","text":"systems it does not conflict with; nil, the default, when it may change anything and must"},{"type":"text","text":" "},{"type":"text","text":"run alone."}],"required":true,"defaultImplementations":1},"doc://Systems/documentation/Systems/Schedule/run(on:)":{"kind":"symbol","identifier":"doc:\/\/Systems\/documentation\/Systems\/Schedule\/run(on:)","url":"\/documentation\/systems\/schedule\/run(on:)","title":