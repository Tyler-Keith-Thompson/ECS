{"seeAlsoSections":[{"identifiers":["doc:\/\/Systems\/documentation\/Systems\/Schedule\/runSerially(on:)"],"title":"Running Systems","generated":true,"anchor":"Running-Systems"}],"sections":[],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/systems\/schedule\/run(on:)"]}],"metadata":{"roleHeading":"Instance Method","externalID":"s:7Systems8ScheduleV3run2ony11WorldModule0E0Vz_tF","symbolKind":"method","title":"run(on:)","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"run","kind":"identifier"},{"text":"(","kind":"text"},{"text":"on","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"inout","kind":"keyword"},{"text":" ","kind":"text"},{"preciseIdentifier":"s:11WorldModule0A0V","text":"World","kind":"typeIdentifier"},{"text":")","kind":"text"}],"role":"symbol","remoteSource":{"url":"https:\/\/github.com\/Tyler-Keith-Thompson\/ECS\/blob\/main\/Sources\/Systems\/Schedule.swift#L299","fileName":"Schedule.swift"},"modules":[{"name":"Systems"}]},"identifier":{"url":"doc:\/\/Systems\/documentation\/Systems\/Schedule\/run(on:)","interfaceLanguage":"swift"},"schemaVersion":{"minor":3,"patch":0,"major":0},"abstract":[{"text":"Runs each system once on a world, running systems that don’t depend on each other at the","type":"text"},{"text":" ","type":"text"},{"text":"same time.","type":"text"}],"primaryContentSections":[{"declarations":[{"tokens":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"run","kind":"identifier"},{"text":"(","kind":"text"},{"text":"on","kind":"externalParam"},{"text":" ","kind":"text"},{"text":"world","kind":"internalParam"},{"text":": ","kind":"text"},{"text":"inout","kind":"keyword"},{"text":" ","kind":"text"},{"text":"World","kind":"typeIdentifier","preciseIdentifier":"s:11WorldModule0A0V","identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/World"},{"text":")","kind":"text"}],"platforms":["Linux"],"languages":["swift"]}],"kind":"declarations"},{"parameters":[{"content":[{"type":"paragraph","inlineContent":[{"text":"The world to run the systems on.","type":"text"}]}],"name":"world"}],"kind":"parameters"},{"content":[{"type":"heading","text":"Discussion","anchor":"discussion","level":2},{"type":"paragraph","inlineContent":[{"type":"text","text":"The world ends as though the systems had run one after another, in the order of"},{"type":"text","text":" "},{"identifier":"doc:\/\/Systems\/documentation\/Systems\/Schedule\/systems","type":"reference","isActive":true},{"type":"text","text":", except that the commands systems queue apply when their wave finishes, so a"},{"type":"text","text":" "},{"type":"text","text":"later system of the same wave doesn’t see them."}]},{"type":"paragraph","inlineContent":[{"text":"A system depends on the systems before it that a constraint orders it after, and on those","type":"text"},{"text":" ","type":"text"},{"text":"it conflicts with: one writes what the other reads or writes, or either has no","type":"text"},{"text":" ","type":"text"},{"isActive":true,"identifier":"doc:\/\/Systems\/documentation\/Systems\/System\/access","type":"reference"},{"text":". The systems run in ","type":"text"},{"type":"emphasis","inlineContent":[{"text":"waves","type":"text"}]},{"text":". Each wave holds the systems whose","type":"text"},{"text":" ","type":"text"},{"text":"dependencies all ran in earlier waves, and runs them at the same time with","type":"text"},{"text":" ","type":"text"},{"isActive":true,"identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/World\/runConcurrently(_:)","type":"reference"},{"text":". A system without an access runs alone, and a","type":"text"},{"text":" ","type":"text"},{"isActive":true,"identifier":"doc:\/\/Systems\/documentation\/Systems\/MainActorSystem","type":"reference"},{"text":" runs on the calling thread after the other systems of its wave.","type":"text"}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Before the first wave, each system not yet initialized on this world is initialized"},{"type":"text","text":" "},{"type":"text","text":"("},{"type":"reference","identifier":"doc:\/\/Systems\/documentation\/Systems\/System\/initialize(in:)","isActive":true},{"type":"text","text":"), whether or not its conditions hold. At the start of each wave, the conditions of its systems are"},{"type":"text","text":" "},{"type":"text","text":"checked, and systems whose conditions don’t hold are skipped. Commands the wave’s systems"},{"type":"text","text":" "},{"type":"text","text":"queue apply at the end of the wave, in the order the systems run."}]},{"type":"heading","text":"Change Detection","anchor":"Change-Detection","level":3},{"type":"paragraph","inlineContent":[{"text":"The world’s change tick advances at the start of each wave that runs a system. While a system runs, the","type":"text"},{"text":" ","type":"text"},{"text":"world’s ","type":"text"},{"identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/World\/lastRun","isActive":true,"type":"reference"},{"text":" is the tick of that system’s previous run, so a","type":"text"},{"text":" ","type":"text"},{"text":"filter such as ","type":"text"},{"code":"Changed<Position>","type":"codeVoice"},{"text":" shows it what changed since then: the changes the","type":"text"},{"text":" ","type":"text"},{"text":"systems after it made on the previous run and the systems before it made on this one, but","type":"text"},{"text":" ","type":"text"},{"text":"not its own. The following system counts the positions that changed since it last ran:","type":"text"}]},{"type":"codeListing","code":["struct Moves: Resource { var count: Int }","","@System","struct CountMoves {","    func run(_ moved: Query<Position>.Where<Changed<Position>>, _ moves: ResourceWriter<Moves>) {","        for _ in moved { moves.value.count += 1 }","    }","}","","var world = World()","world.resources.insert(Moves(count: 0))","let ball = world.spawn(Position(x: 0, y: 0))","world.spawn(Position(x: 5, y: 0))","","let frame = Schedule { CountMoves() }","frame.run(on: &world)","print(world.resources[Moves.self].count)","\/\/ Prints \"2\"","","world[Position.self, of: ball].x = 1","frame.run(on: &world)","print(world.resources[Moves.self].count)","\/\/ Prints \"3\""],"syntax":"swift"},{"type":"paragraph","inlineContent":[{"type":"text","text":"A system that hasn’t run on this world before sees every component as added and changed."},{"type":"text","text":" "},{"type":"text","text":"A skipped system hasn’t run, so the next time it runs it sees every change since it last"},{"type":"text","text":" "},{"type":"text","text":"did. The tick advances once more after the last wave, so changes you make to the world"},{"type":"text","text":" "},{"type":"text","text":"between runs are newer than every system’s previous run."}]},{"type":"aside","style":"note","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Every system with an access reads and writes only what it lists; see"},{"type":"text","text":" "},{"type":"reference","isActive":true,"identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/World\/runConcurrently(_:)"},{"type":"text","text":". A schedule holding a main-actor system that"},{"type":"text","text":" "},{"type":"text","text":"runs is run on the main actor."}]}],"name":"Precondition"}],"kind":"content"}],"kind":"symbol","hierarchy":{"paths":[["doc:\/\/Systems\/documentation\/Systems","doc:\/\/Systems\/documentation\/Systems\/Schedule"]]},"references":{"doc://Systems/documentation/Systems/System/initialize(in:)":{"title":"initialize(in:)","abstract":[{"text":"Prepares a world for the system before the system first runs on it.","type":"text"}],"identifier":"doc:\/\/Systems\/documentation\/Systems\/System\/initialize(in:)","url":"\/documentation\/systems\/system\/initialize(in:)","defaultImplementations":1,"type":"topic","kind":"symbol","required":true,"role":"symbol","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"initialize"},{"kind":"text","text":"("},{"kind":"externalParam","text":"in"},{"kind":"text","text":": "},{"kind":"keyword","text":"inout"},{"kind":"text","text":" "},{"kind":"typeIdentifier","text":"World","preciseIdentifier":"s:11WorldModule0A0V"},{"kind":"text","text":")"}]},"doc://Systems/documentation/Systems":{"kind":"symbol","title":"Systems","type":"topic","identifier":"doc:\/\/Systems\/documentation\/Systems","role":"collection","abstract":[{"type":"text","text":"Declare the rules of a simulation as systems, and run them on a world in a schedule."}],"url":"\/documentation\/systems"},"doc://Systems/documentation/Systems/Schedule/run(on:)":{"role":"symbol","identifier":"doc:\/\/Systems\/documentation\/Systems\/Schedule\/run(on:)","url":"\/documentation\/systems\/schedule\/run(on:)","title":"run(on:)","kind":"symbol","abstract":[{"type":"text","text":"Runs each system once on a world, running systems that don’t depend on each other at the"},{"type":"text","text":" "},{"type":"text","text":"same time."}],"fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"run","kind":"identifier"},{"text":"(","kind":"text"},{"text":"on","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"inout","kind":"keyword"},{"text":" ","kind":"text"},{"preciseIdentifier":"s:11WorldModule0A0V","text":"World","kind":"typeIdentifier"},{"text":")","kind":"text"}],"type":"topic"},"doc://WorldModule/documentation/WorldModule/World/lastRun":{"url":"\/documentation\/worldmodule\/world\/lastrun","identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/World\/lastRun","fragments":[{"text":"var","kind":"keyword"},{"text":" ","kind":"text"},{"text":"lastRun","kind":"identifier"},{"text":": ","kind":"text"},{"text":"ChangeTick","preciseIdentifier":"s:11WorldModule10ChangeTickV","kind":"typeIdentifier"}],"abstract":[{"text":"The change tick at which the running system last ran.","type":"text"}],"kind":"symbol","type":"topic","title":"lastRun","role":"symbol"},"doc://Systems/documentation/Systems/System/access":{"role":"symbol","fragments":[{"text":"var","kind":"keyword"},{"text":" ","kind":"text"},{"kind":"identifier","text":"access"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:11WorldModule6AccessV","text":"Access"},{"kind":"text","text":"?"}],"identifier":"doc:\/\/Systems\/documentation\/Systems\/System\/access","kind":"symbol","type":"topic","abstract":[{"type":"text","text":"The component, resource and event types the system reads and writes, or "},{"code":"nil","type":"codeVoice"},{"type":"text","text":" if it may"},{"type":"text","text":" "},{"type":"text","text":"change anything."}],"required":true,"title":"access","url":"\/documentation\/systems\/system\/access","defaultImplementations":1},"doc://Systems/documentation/Systems/MainActorSystem":{"navigatorTitle":[{"text":"MainActorSystem","kind":"identifier"}],"title":"MainActorSystem","type":"topic","role":"symbol","url":"\/documentation\/systems\/mainactorsystem","identifier":"doc:\/\/Systems\/documentation\/Systems\/MainActorSystem","fragments":[{"text":"protocol","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MainActorSystem","kind":"identifier"}],"kind":"symbol","abstract":[{"text":"A system that runs on the main actor, for work that touches main-actor state such as a user","type":"text"},{"text":" ","type":"text"},{"text":"interface.","type":"text"}]},"doc://Systems/documentation/Systems/Schedule/systems":{"role":"symbol","identifier":"doc:\/\/Systems\/documentation\/Systems\/Schedule\/systems","url":"\/documentation\/systems\/schedule\/systems","abstract":[{"text":"The schedule’s systems, in the order they run.","type":"text"}],"kind":"symbol","title":"systems","fragments":[{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"systems","kind":"identifier"},{"text":": [","kind":"text"},{"text":"ScheduledSystem","kind":"typeIdentifier","preciseIdentifier":"s:7Systems15ScheduledSystemV"},{"text":"]","kind":"text"}],"type":"topic"},"doc://WorldModule/documentation/WorldModule/World":{"identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/World","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"World","kind":"identifier"}],"role":"symbol","kind":"symbol","abstract":[{"text":"A collection of entities, the components they hold, and resources.","type":"text"}],"type":"topic","url":"\/documentation\/worldmodule\/world","title":"World","navigatorTitle":[{"text":"World","kind":"identifier"}]},"doc://WorldModule/documentation/WorldModule/World/runConcurrently(_:)":{"title":"runConcurrently(_:)","abstract":[{"text":"Runs changes at the same time, each on its own copy of the world, and keeps what each one","type":"text"},{"text":" ","type":"text"},{"text":"wrote.","type":"text"}],"identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/World\/runConcurrently(_:)","url":"\/documentation\/worldmodule\/world\/runconcurrently(_:)","type":"topic","kind":"symbol","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"runConcurrently"},{"kind":"text","text":"(["},{"kind":"typeIdentifier","text":"ConcurrentChange","preciseIdentifier":"s:11WorldModule16ConcurrentChangeV"},{"kind":"text","text":"])"}],"role":"symbol"},"doc://Systems/documentation/Systems/Schedule":{"identifier":"doc:\/\/Systems\/documentation\/Systems\/Schedule","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Schedule","kind":"identifier"}],"role":"symbol","kind":"symbol","type":"topic","abstract":[{"text":"A list of systems that run on a world, in order, and at the same time where they can.","type":"text"}],"url":"\/documentation\/systems\/schedule","title":"Schedule","navigatorTitle":[{"text":"Schedule","kind":"identifier"}]},"doc://Systems/documentation/Systems/Schedule/runSerially(on:)":{"role":"symbol","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"runSerially"},{"kind":"text","text":"("},{"kind":"externalParam","text":"on"},{"kind":"text","text":": "},{"kind":"keyword","text":"inout"},{"kind":"text","text":" "},{"kind":"typeIdentifier","preciseIdentifier":"s:11WorldModule0A0V","text":"World"},{"kind":"text","text":")"}],"identifier":"doc:\/\/Systems\/documentation\/Systems\/Schedule\/runSerially(on:)","title":"runSerially(on:)","kind":"symbol","type":"topic","url":"\/documentation\/systems\/schedule\/runserially(on:)","abstract":[{"type":"text","text":"Runs each system once on a world, one system at a time."}]}}}