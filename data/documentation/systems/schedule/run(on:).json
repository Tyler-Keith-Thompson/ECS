{"text":"Discussion","type":"heading","anchor":"discussion","level":2},{"inlineContent":[{"text":"Before each system, the world’s change tick advances and its ","type":"text"},{"code":"WorldModule\/World\/lastRun","type":"codeVoice"},{"text":" ","type":"text"},{"text":"is set to the tick of that system’s previous run, so filters such as","type":"text"},{"text":" ","type":"text"},{"code":".changed(Position.self)","type":"codeVoice"},{"text":" show the system what changed since then: changes made by the","type":"text"},{"text":" ","type":"text"},{"text":"systems after it on the previous run and before it on this one, but not its own. A system","type":"text"},{"text":" ","type":"text"},{"text":"that has not run on this world before sees every component as added and changed. A","type":"text"},{"text":" ","type":"text"},{"text":"skipped system has not run: the next time it runs, it sees everything since it last did.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"The tick advances once more after the last system, so changes made to the world between"},{"type":"text","text":" "},{"type":"text","text":"runs are newer than every system’s previous run."}],"type":"paragraph"}],"kind":"content"}],"schemaVersion":{"patch":0,"major":0,"minor":3},"references":{"doc://Systems/documentation/Systems":{"role":"collection","kind":"symbol","type":"topic","title":"Systems","identifier":"doc:\/\/Systems\/documentation\/Systems","abstract":[{"text":"Rules that run on a world, in the order written unless constrained otherwise.","type":"text"}],"url":"\/documentation\/systems"},"doc://Systems/documentation/Systems/Schedule":{"abstract":[{"type":"text","text":"Systems in the order they run."}],"type":"topic","url":"\/documentation\/systems\/schedule","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"Schedule"}],"title":"Schedule","kind":"symbol","identifier":"doc:\/\/Systems\/documentation\/Systems\/Schedule"