{"seeAlsoSections":[{"title":"Running Systems","identifiers":["doc:\/\/Systems\/documentation\/Systems\/Schedule\/runSerially(on:)"],"generated":true,"anchor":"Running-Systems"}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/systems\/schedule\/run(on:)"]}],"metadata":{"fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"run"},{"kind":"text","text":"("},{"kind":"externalParam","text":"on"},{"kind":"text","text":": "},{"kind":"keyword","text":"inout"},{"kind":"text","text":" "},{"kind":"typeIdentifier","text":"World","preciseIdentifier":"s:11WorldModule0A0V"},{"kind":"text","text":")"}],"externalID":"s:7Systems8ScheduleV3run2ony11WorldModule0E0Vz_tF","remoteSource":{"url":"https:\/\/github.com\/Tyler-Keith-Thompson\/ECS\/blob\/main\/Sources\/Systems\/Schedule.swift#L299","fileName":"Schedule.swift"},"title":"run(on:)","roleHeading":"Instance Method","symbolKind":"method","modules":[{"name":"Systems"}],"role":"symbol"},"abstract":[{"type":"text","text":"Runs each system once on a world, running systems that don’t depend on each other at the"},{"type":"text","text":" "},{"type":"text","text":"same time."}],"sections":[],"schemaVersion":{"minor":3,"patch":0,"major":0},"hierarchy":{"paths":[["doc:\/\/Systems\/documentation\/Systems","doc:\/\/Systems\/documentation\/Systems\/Schedule"]]},"primaryContentSections":[{"kind":"declarations","declarations":[{"languages":["swift"],"tokens":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"run"},{"kind":"text","text":"("},{"kind":"externalParam","text":"on"},{"kind":"text","text":" "},{"kind":"internalParam","text":"world"},{"kind":"text","text":": "},{"kind":"keyword","text":"inout"},{"kind":"text","text":" "},{"preciseIdentifier":"s:11WorldModule0A0V","kind":"typeIdentifier","text":"World","identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/World"},{"kind":"text","text":")"}],"platforms":["Linux"]}]},{"kind":"parameters","parameters":[{"name":"world","content":[{"type":"paragraph","inlineContent":[{"text":"The world to run the systems on.","type":"text"}]}]}]},{"kind":"content","content":[{"level":2,"text":"Discussion","type":"heading","anchor":"discussion"},{"inlineContent":[{"type":"text","text":"The world ends as though the systems had run one after another, in the order of"},{"type":"text","text":" "},{"identifier":"doc:\/\/Systems\/documentation\/Systems\/Schedule\/systems","isActive":true,"type":"reference"},{"type":"text","text":", except that the commands systems queue apply when their wave finishes, so a"},{"type":"text","text":" "},{"type":"text","text":"later system of the same wave doesn’t see them."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"A system depends on the systems before it that a constraint orders it after, and on those"},{"type":"text","text":" "},{"type":"text","text":"it conflicts with: one writes what the other reads or writes, or either has no"},{"type":"text","text":" "},{"type":"reference","isActive":true,"identifier":"doc:\/\/Systems\/documentation\/Systems\/System\/access"},{"type":"text","text":". The systems run in "},{"inlineContent":[{"text":"waves","type":"text"}],"type":"emphasis"},{"type":"text","text":". Each wave holds the systems whose"},{"type":"text","text":" "},{"type":"text","text":"dependencies all ran in earlier waves, and runs them at the same time with"},{"type":"text","text":" "},{"type":"reference","isActive":true,"identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/World\/runConcurrently(_:)"},{"type":"text","text":". A system without an access runs alone, and a"},{"type":"text","text":" "},{"type":"reference","isActive":true,"identifier":"doc:\/\/Systems\/documentation\/Systems\/MainActorSystem"},{"type":"text","text":" runs on the calling thread after the other systems of its wave."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"Before the first wave, each system not yet initialized on this world is initialized"},{"type":"text","text":" "},{"type":"text","text":"("},{"type":"reference","identifier":"doc:\/\/Systems\/documentation\/Systems\/System\/initialize(in:)","isActive":true},{"type":"text","text":"), whether or not its conditions hold. At the start of each wave, the conditions of its systems are"},{"type":"text","text":" "},{"type":"text","text":"checked, and systems whose conditions don’t hold are skipped. Commands the wave’s systems"},{"type":"text","text":" "},{"type":"text","text":"queue apply at the end of the wave, in the order the systems run."}],"type":"paragraph"},{"level":3,"text":"Change Detection","type":"heading","anchor":"Change-Detection"},{"inlineContent":[{"text":"The world’s change tick advances at the start of each wave that runs a system. While a system runs, the","type":"text"},{"text":" ","type":"text"},{"text":"world’s ","type":"text"},{"isActive":true,"identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/World\/lastRun","type":"reference"},{"text":" is the tick of that system’s previous run, so a","type":"text"},{"text":" ","type":"text"},{"text":"filter such as ","type":"text"},{"code":"Changed<Position>","type":"codeVoice"},{"text":" shows it what changed since then: the changes the","type":"text"},{"text":" ","type":"text"},{"text":"systems after it made on the previous run and the systems before it made on this one, but","type":"text"},{"text":" ","type":"text"},{"text":"not its own. The following system counts the positions that changed since it last ran:","type":"text"}],"type":"paragraph"},{"type":"codeListing","syntax":"swift","code":["struct Moves: Resource { var count: Int }","","@System","struct CountMoves {","    func run(_ moved: Query<Position>.Where<Changed<Position>>, _ moves: ResourceWriter<Moves>) {","        for _ in moved { moves.value.count += 1 }","    }","}","","var world = World()","world.resources.insert(Moves(count: 0))","let ball = world.spawn(Position(x: 0, y: 0))","world.spawn(Position(x: 5, y: 0))","","let frame = Schedule { CountMoves() }","frame.run(on: &world)","print(world.resources[Moves.self].count)","\/\/ Prints \"2\"","","world[Position.self, of: ball].x = 1","frame.run(on: &world)","print(world.resources[Moves.self].count)","\/\/ Prints \"3\""]},{"inlineContent":[{"text":"A system that hasn’t run on this world before sees every component as added and changed.","type":"text"},{"text":" ","type":"text"},{"text":"A skipped system hasn’t run, so the next time it runs it sees every change since it last","type":"text"},{"text":" ","type":"text"},{"text":"did. The tick advances once more after the last wave, so changes you make to the world","type":"text"},{"text":" ","type":"text"},{"text":"between runs are newer than every system’s previous run.","type":"text"}],"type":"paragraph"},{"name":"Precondition","style":"note","type":"aside","content":[{"inlineContent":[{"type":"text","text":"Every system with an access reads and writes only what it lists; see"},{"type":"text","text":" "},{"type":"reference","identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/World\/runConcurrently(_:)","isActive":true},{"type":"text","text":". A schedule holding a main-actor system that"},{"type":"text","text":" "},{"type":"text","text":"runs is run on the main actor."}],"type":"paragraph"}]}]}],"identifier":{"url":"doc:\/\/Systems\/documentation\/Systems\/Schedule\/run(on:)","interfaceLanguage":"swift"},"kind":"symbol","references":{"doc://WorldModule/documentation/WorldModule/World/runConcurrently(_:)":{"title":"runConcurrently(_:)","abstract":[{"type":"text","text":"Runs changes at the same time, each on its own copy of the world, and keeps what each one"},{"type":"text","text":" "},{"type":"text","text":"wrote."}],"type":"topic","kind":"symbol","url":"\/documentation\/worldmodule\/world\/runconcurrently(_:)","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"runConcurrently","kind":"identifier"},{"text":"([","kind":"text"},{"preciseIdentifier":"s:11WorldModule16ConcurrentChangeV","text":"ConcurrentChange","kind":"typeIdentifier"},{"text":"])","kind":"text"}],"role":"symbol","identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/World\/runConcurrently(_:)"},"doc://Systems/documentation/Systems/Schedule/runSerially(on:)":{"kind":"symbol","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"runSerially"},{"kind":"text","text":"("},{"kind":"externalParam","text":"on"},{"kind":"text","text":": "},{"kind":"keyword","text":"inout"},{"kind":"text","text":" "},{"kind":"typeIdentifier","text":"World","preciseIdentifier":"s:11WorldModule0A0V"},{"kind":"text","text":")"}],"url":"\/documentation\/systems\/schedule\/runserially(on:)","role":"symbol","abstract":[{"text":"Runs each system once on a world, one system at a time.","type":"text"}],"identifier":"doc:\/\/Systems\/documentation\/Systems\/Schedule\/runSerially(on:)","type":"topic","title":"runSerially(on:)"},"doc://WorldModule/documentation/WorldModule/World/lastRun":{"title":"lastRun","abstract":[{"text":"The change tick at which the running system last ran.","type":"text"}],"kind":"symbol","type":"topic","url":"\/documentation\/worldmodule\/world\/lastrun","fragments":[{"kind":"keyword","text":"var"},{"kind":"text","text":" "},{"kind":"identifier","text":"lastRun"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"ChangeTick","preciseIdentifier":"s:11WorldModule10ChangeTickV"}],"role":"symbol","identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/World\/lastRun"},"doc://Systems/documentation/Systems/Schedule":{"role":"symbol","type":"topic","title":"Schedule","abstract":[{"type":"text","text":"A list of systems that run on a world, in order, and at the same time where they can."}],"kind":"symbol","navigatorTitle":[{"kind":"identifier","text":"Schedule"}],"url":"\/documentation\/systems\/schedule","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"Schedule"}],"identifier":"doc:\/\/Systems\/documentation\/Systems\/Schedule"},"doc://Systems/documentation/Systems/System/initialize(in:)":{"identifier":"doc:\/\/Systems\/documentation\/Systems\/System\/initialize(in:)","url":"\/documentation\/systems\/system\/initialize(in:)","required":true,"role":"symbol","abstract":[{"text":"Prepares a world for the system before the system first runs on it.","type":"text"}],"kind":"symbol","title":"initialize(in:)","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"initialize"},{"kind":"text","text":"("},{"kind":"externalParam","text":"in"},{"kind":"text","text":": "},{"text":"inout","kind":"keyword"},{"text":" ","kind":"text"},{"preciseIdentifier":"s:11WorldModule0A0V","text":"World","kind":"typeIdentifier"},{"text":")","kind":"text"}],"type":"topic","defaultImplementations":1},"doc://Systems/documentation/Systems/Schedule/systems":{"title":"systems","role":"symbol","identifier":"doc:\/\/Systems\/documentation\/Systems\/Schedule\/systems","fragments":[{"kind":"keyword","text":"let"},{"kind":"text","text":" "},{"kind":"identifier","text":"systems"},{"kind":"text","text":": ["},{"kind":"typeIdentifier","preciseIdentifier":"s:7Systems15ScheduledSystemV","text":"ScheduledSystem"},{"kind":"text","text":"]"}],"type":"topic","kind":"symbol","abstract":[{"type":"text","text":"The schedule’s systems, in the order they run."}],"url":"\/documentation\/systems\/schedule\/systems"},"doc://Systems/documentation/Systems/System/access":{"identifier":"doc:\/\/Systems\/documentation\/Systems\/System\/access","url":"\/documentation\/systems\/system\/access","required":true,"role":"symbol","abstract":[{"type":"text","text":"The component, resource and event types the system reads and writes, or "},{"type":"codeVoice","code":"nil"},{"type":"text","text":" if it may"},{"type":"text","text":" "},{"type":"text","text":"change anything."}],"kind":"symbol","title":"access","fragments":[{"text":"var","kind":"keyword"},{"text":" ","kind":"text"},{"kind":"identifier","text":"access"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"Access","preciseIdentifier":"s:11WorldModule6AccessV"},{"kind":"text","text":"?"}],"type":"topic","defaultImplementations":1},"doc://Systems/documentation/Systems/MainActorSystem":{"type":"topic","fragments":[{"kind":"keyword","text":"protocol"},{"kind":"text","text":" "},{"kind":"identifier","text":"MainActorSystem"}],"kind":"symbol","url":"\/documentation\/systems\/mainactorsystem","navigatorTitle":[{"kind":"identifier","text":"MainActorSystem"}],"identifier":"doc:\/\/Systems\/documentation\/Systems\/MainActorSystem","abstract":[{"text":"A system that runs on the main actor, for work that touches main-actor state such as a user","type":"text"},{"text":" ","type":"text"},{"text":"interface.","type":"text"}],"title":"MainActorSystem","role":"symbol"},"doc://WorldModule/documentation/WorldModule/World":{"role":"symbol","type":"topic","title":"World","abstract":[{"type":"text","text":"A collection of entities, the components they hold, and resources."}],"kind":"symbol","navigatorTitle":[{"kind":"identifier","text":"World"}],"url":"\/documentation\/worldmodule\/world","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"World"}],"identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/World"},"doc://Systems/documentation/Systems":{"type":"topic","role":"collection","identifier":"doc:\/\/Systems\/documentation\/Systems","title":"Systems","url":"\/documentation\/systems","abstract":[{"type":"text","text":"Declare the rules of a simulation as systems, and run them on a world in a schedule."}],"kind":"symbol"},"doc://Systems/documentation/Systems/Schedule/run(on:)":{"kind":"symbol","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"run","kind":"identifier"},{"text":"(","kind":"text"},{"kind":"externalParam","text":"on"},{"kind":"text","text":": "},{"kind":"keyword","text":"inout"},{"kind":"text","text":" "},{"preciseIdentifier":"s:11WorldModule0A0V","kind":"typeIdentifier","text":"World"},{"kind":"text","text":")"}],"abstract":[{"text":"Runs each system once on a world, running systems that don’t depend on each other at the","type":"text"},{"text":" ","type":"text"},{"text":"same time.","type":"text"}],"title":"run(on:)","url":"\/documentation\/systems\/schedule\/run(on:)","role":"symbol","identifier":"doc:\/\/Systems\/documentation\/Systems\/Schedule\/run(on:)","type":"topic"}}}