{"kind":"symbol","schemaVersion":{"minor":3,"patch":0,"major":0},"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/Systems\/documentation\/Systems\/Schedule\/run(on:)"},"metadata":{"symbolKind":"method","role":"symbol","title":"run(on:)","externalID":"s:7Systems8ScheduleV3run2ony11WorldModule0E0Vz_tF","remoteSource":{"fileName":"Schedule.swift","url":"https:\/\/github.com\/Tyler-Keith-Thompson\/ECS\/blob\/main\/Sources\/Systems\/Schedule.swift#L299"},"fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"run","kind":"identifier"},{"text":"(","kind":"text"},{"text":"on","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"inout","kind":"keyword"},{"text":" ","kind":"text"},{"text":"World","kind":"typeIdentifier","preciseIdentifier":"s:11WorldModule0A0V"},{"kind":"text","text":")"}],"modules":[{"name":"Systems"}],"roleHeading":"Instance Method"},"primaryContentSections":[{"kind":"declarations","declarations":[{"platforms":["Linux"],"languages":["swift"],"tokens":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"run","kind":"identifier"},{"text":"(","kind":"text"},{"text":"on","kind":"externalParam"},{"text":" ","kind":"text"},{"text":"world","kind":"internalParam"},{"text":": ","kind":"text"},{"text":"inout","kind":"keyword"},{"text":" ","kind":"text"},{"text":"World","kind":"typeIdentifier","preciseIdentifier":"s:11WorldModule0A0V","identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/World"},{"text":")","kind":"text"}]}]},{"kind":"parameters","parameters":[{"name":"world","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The world to run the systems on."}]}]}]},{"kind":"mentions","mentions":["doc:\/\/Systems\/documentation\/Systems\/SchedulingSystems"]},{"kind":"content","content":[{"anchor":"discussion","type":"heading","level":2,"text":"Discussion"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The world ends as though the systems had run one after another, in the order of"},{"type":"text","text":" "},{"type":"reference","isActive":true,"identifier":"doc:\/\/Systems\/documentation\/Systems\/Schedule\/systems"},{"type":"text","text":", except that the commands systems queue apply when their wave finishes, so a"},{"type":"text","text":" "},{"type":"text","text":"later system of the same wave doesn’t see them."}]},{"type":"paragraph","inlineContent":[{"text":"A system depends on the systems before it that a constraint orders it after, and on those","type":"text"},{"text":" ","type":"text"},{"text":"it conflicts with: one writes what the other reads or writes, or either has no","type":"text"},{"text":" ","type":"text"},{"identifier":"doc:\/\/Systems\/documentation\/Systems\/System\/access","isActive":true,"type":"reference"},{"text":". The systems run in ","type":"text"},{"inlineContent":[{"type":"text","text":"waves"}],"type":"emphasis"},{"text":". Each wave holds the systems whose","type":"text"},{"text":" ","type":"text"},{"text":"dependencies all ran in earlier waves, and runs them at the same time with","type":"text"},{"text":" ","type":"text"},{"identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/World\/runConcurrently(_:)","isActive":true,"type":"reference"},{"text":". A system without an access runs alone, and a","type":"text"},{"text":" ","type":"text"},{"identifier":"doc:\/\/Systems\/documentation\/Systems\/MainActorSystem","isActive":true,"type":"reference"},{"text":" runs on the calling thread after the other systems of its wave.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"Before the first wave, each system not yet initialized on this world is initialized","type":"text"},{"text":" ","type":"text"},{"text":"(","type":"text"},{"isActive":true,"identifier":"doc:\/\/Systems\/documentation\/Systems\/System\/initialize(in:)","type":"reference"},{"text":"), whether or not its conditions hold. At the start of each wave, the conditions of its systems are","type":"text"},{"text":" ","type":"text"},{"text":"checked, and systems whose conditions don’t hold are skipped. Commands the wave’s systems","type":"text"},{"text":" ","type":"text"},{"text":"queue apply at the end of the wave, in the order the systems run.","type":"text"}]},{"anchor":"Change-Detection","type":"heading","level":3,"text":"Change Detection"},{"type":"paragraph","inlineContent":[{"text":"The world’s change tick advances at the start of each wave that runs a system. While a system runs, the","type":"text"},{"text":" ","type":"text"},{"text":"world’s ","type":"text"},{"identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/World\/lastRun","isActive":true,"type":"reference"},{"text":" is the tick of that system’s previous run, so a","type":"text"},{"text":" ","type":"text"},{"text":"filter such as ","type":"text"},{"type":"codeVoice","code":"Changed<Position>"},{"text":" shows it what changed since then: the changes the","type":"text"},{"text":" ","type":"text"},{"text":"systems after it made on the previous run and the systems before it made on this one, but","type":"text"},{"text":" ","type":"text"},{"text":"not its own. The following system counts the positions that changed since it last ran:","type":"text"}]},{"code":["struct Moves: Resource { var count: Int }","","@System","struct CountMoves {","    func run(_ moved: Query<Position>.Where<Changed<Position>>, _ moves: ResourceWriter<Moves>) {","        for _ in moved { moves.value.count += 1 }","    }","}","","var world = World()","world.resources.insert(Moves(count: 0))","let ball = world.spawn(Position(x: 0, y: 0))","world.spawn(Position(x: 5, y: 0))","","let frame = Schedule { CountMoves() }","frame.run(on: &world)","print(world.resources[Moves.self].count)","\/\/ Prints \"2\"","","world[Position.self, of: ball].x = 1","frame.run(on: &world)","print(world.resources[Moves.self].count)","\/\/ Prints \"3\""],"type":"codeListing","syntax":"swift"},{"type":"paragraph","inlineContent":[{"text":"A system that hasn’t run on this world before sees every component as added and changed.","type":"text"},{"text":" ","type":"text"},{"text":"A skipped system hasn’t run, so the next time it runs it sees every change since it last","type":"text"},{"text":" ","type":"text"},{"text":"did. The tick advances once more after the last wave, so changes you make to the world","type":"text"},{"text":" ","type":"text"},{"text":"between runs are newer than every system’s previous run.","type":"text"}]},{"type":"aside","style":"note","name":"Precondition","content":[{"type":"paragraph","inlineContent":[{"text":"Every system with an access reads and writes only what it lists; see","type":"text"},{"text":" ","type":"text"},{"type":"reference","identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/World\/runConcurrently(_:)","isActive":true},{"text":". A schedule holding a main-actor system that","type":"text"},{"text":" ","type":"text"},{"text":"runs is run on the main actor.","type":"text"}]}]}]}],"hierarchy":{"paths":[["doc:\/\/Systems\/documentation\/Systems","doc:\/\/Systems\/documentation\/Systems\/Schedule"]]},"sections":[],"seeAlsoSections":[{"generated":true,"title":"Running Systems","identifiers":["doc:\/\/Systems\/documentation\/Systems\/Schedule\/runSerially(on:)"],"anchor":"Running-Systems"}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/systems\/schedule\/run(on:)"]}],"abstract":[{"type":"text","text":"Runs each system once on a world, running systems that don’t depend on each other at the"},{"type":"text","text":" "},{"type":"text","text":"same time."}],"references":{"doc://Systems/documentation/Systems":{"kind":"symbol","role":"collection","title":"Systems","identifier":"doc:\/\/Systems\/documentation\/Systems","url":"\/documentation\/systems","abstract":[{"text":"Declare the rules of a simulation as systems, and run them on a world in a schedule.","type":"text"}],"type":"topic"},"doc://Systems/documentation/Systems/Schedule/run(on:)":{"role":"symbol","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"run","kind":"identifier"},{"text":"(","kind":"text"},{"kind":"externalParam","text":"on"},{"kind":"text","text":": "},{"kind":"keyword","text":"inout"},{"kind":"text","text":" "},{"kind":"typeIdentifier","text":"World","preciseIdentifier":"s:11WorldModule0A0V"},{"kind":"text","text":")"}],"url":"\/documentation\/systems\/schedule\/run(on:)","identifier":"doc:\/\/Systems\/documentation\/Systems\/Schedule\/run(on:)","abstract":[{"text":"Runs each system once on a world, running systems that don’t depend on each other at the","type":"text"},{"text":" ","type":"text"},{"text":"same time.","type":"text"}],"kind":"symbol","type":"topic","title":"run(on:)"},"doc://Systems/documentation/Systems/SchedulingSystems":{"role":"article","url":"\/documentation\/systems\/schedulingsystems","abstract":[{"type":"text","text":"Order the systems of a schedule, run them only when a condition holds, and find out how a"},{"type":"text","text":" "},{"type":"text","text":"schedule runs them."}],"identifier":"doc:\/\/Systems\/documentation\/Systems\/SchedulingSystems","kind":"article","type":"topic","title":"Scheduling Systems"},"doc://WorldModule/documentation/WorldModule/World/lastRun":{"title":"lastRun","identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/World\/lastRun","url":"\/documentation\/worldmodule\/world\/lastrun","abstract":[{"type":"text","text":"The change tick at which the running system last ran."}],"fragments":[{"text":"var","kind":"keyword"},{"text":" ","kind":"text"},{"text":"lastRun","kind":"identifier"},{"text":": ","kind":"text"},{"text":"ChangeTick","kind":"typeIdentifier","preciseIdentifier":"s:11WorldModule10ChangeTickV"}],"kind":"symbol","type":"topic","role":"symbol"},"doc://WorldModule/documentation/WorldModule/World/runConcurrently(_:)":{"role":"symbol","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"runConcurrently"},{"kind":"text","text":"(["},{"text":"ConcurrentChange","kind":"typeIdentifier","preciseIdentifier":"s:11WorldModule16ConcurrentChangeV"},{"text":"])","kind":"text"}],"url":"\/documentation\/worldmodule\/world\/runconcurrently(_:)","identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/World\/runConcurrently(_:)","abstract":[{"text":"Runs changes at the same time, each on its own copy of the world, and keeps what each one","type":"text"},{"text":" ","type":"text"},{"text":"wrote.","type":"text"}],"kind":"symbol","type":"topic","title":"runConcurrently(_:)"},"doc://Systems/documentation/Systems/System/initialize(in:)":{"role":"symbol","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"initialize"},{"kind":"text","text":"("},{"kind":"externalParam","text":"in"},{"kind":"text","text":": "},{"text":"inout","kind":"keyword"},{"text":" ","kind":"text"},{"text":"World","kind":"typeIdentifier","preciseIdentifier":"s:11WorldModule0A0V"},{"text":")","kind":"text"}],"url":"\/documentation\/systems\/system\/initialize(in:)","abstract":[{"type":"text","text":"Prepares a world for the system before the system first runs on it."}],"identifier":"doc:\/\/Systems\/documentation\/Systems\/System\/initialize(in:)","kind":"symbol","required":true,"defaultImplementations":1,"type":"topic","title":"initialize(in:)"},"doc://Systems/documentation/Systems/Schedule/systems":{"role":"symbol","fragments":[{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"systems","kind":"identifier"},{"text":": [","kind":"text"},{"text":"ScheduledSystem","preciseIdentifier":"s:7Systems15ScheduledSystemV","kind":"typeIdentifier"},{"text":"]","kind":"text"}],"url":"\/documentation\/systems\/schedule\/systems","abstract":[{"text":"The schedule’s systems, in the order they run.","type":"text"}],"identifier":"doc:\/\/Systems\/documentation\/Systems\/Schedule\/systems","kind":"symbol","type":"topic","title":"systems"},"doc://Systems/documentation/Systems/Schedule/runSerially(on:)":{"kind":"symbol","identifier":"doc:\/\/Systems\/documentation\/Systems\/Schedule\/runSerially(on:)","url":"\/documentation\/systems\/schedule\/runserially(on:)","role":"symbol","title":"runSerially(on:)","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"runSerially","kind":"identifier"},{"text":"(","kind":"text"},{"text":"on","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"inout","kind":"keyword"},{"text":" ","kind":"text"},{"preciseIdentifier":"s:11WorldModule0A0V","text":"World","kind":"typeIdentifier"},{"text":")","kind":"text"}],"type":"topic","abstract":[{"text":"Runs each system once on a world, one system at a time.","type":"text"}]},"doc://Systems/documentation/Systems/System/access":{"title":"access","identifier":"doc:\/\/Systems\/documentation\/Systems\/System\/access","defaultImplementations":1,"url":"\/documentation\/systems\/system\/access","abstract":[{"type":"text","text":"The component, resource and event types the system reads and writes, or "},{"code":"nil","type":"codeVoice"},{"type":"text","text":" if it may"},{"type":"text","text":" "},{"type":"text","text":"change anything."}],"fragments":[{"text":"var","kind":"keyword"},{"text":" ","kind":"text"},{"kind":"identifier","text":"access"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"Access","preciseIdentifier":"s:11WorldModule6AccessV"},{"kind":"text","text":"?"}],"kind":"symbol","type":"topic","required":true,"role":"symbol"},"doc://Systems/documentation/Systems/MainActorSystem":{"kind":"symbol","navigatorTitle":[{"kind":"identifier","text":"MainActorSystem"}],"url":"\/documentation\/systems\/mainactorsystem","title":"MainActorSystem","role":"symbol","identifier":"doc:\/\/Systems\/documentation\/Systems\/MainActorSystem","abstract":[{"type":"text","text":"A system that runs on the main actor, for work that touches main-actor state such as a user"},{"type":"text","text":" "},{"type":"text","text":"interface."}],"type":"topic","fragments":[{"kind":"keyword","text":"protocol"},{"kind":"text","text":" "},{"kind":"identifier","text":"MainActorSystem"}]},"doc://WorldModule/documentation/WorldModule/World":{"role":"symbol","navigatorTitle":[{"text":"World","kind":"identifier"}],"fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"World","kind":"identifier"}],"url":"\/documentation\/worldmodule\/world","abstract":[{"type":"text","text":"A collection of entities, the components they hold, and resources."}],"identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/World","kind":"symbol","type":"topic","title":"World"},"doc://Systems/documentation/Systems/Schedule":{"kind":"symbol","navigatorTitle":[{"text":"Schedule","kind":"identifier"}],"url":"\/documentation\/systems\/schedule","title":"Schedule","role":"symbol","identifier":"doc:\/\/Systems\/documentation\/Systems\/Schedule","abstract":[{"text":"A list of systems that run on a world, in order, and at the same time where they can.","type":"text"}],"type":"topic","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Schedule","kind":"identifier"}]}}}