":"text"},{"text":"skipped system has not run: the next time it runs, it sees everything since it last did.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"The tick advances once more after the last system, so changes made to the world between","type":"text"},{"text":" ","type":"text"},{"text":"runs are newer than every system’s previous run.","type":"text"}],"type":"paragraph"}],"kind":"content"}],"kind":"symbol","sections":[],"metadata":{"symbolKind":"method","title":"run(on:)","remoteSource":{"url":"https:\/\/github.com\/Tyler-Keith-Thompson\/ECS\/blob\/main\/Sources\/Systems\/Schedule.swift#L114","fileName":"Schedule.swift"},"roleHeading":"Instance Method","externalID":"s:7Systems8ScheduleV3run2ony11WorldModule0E0Vz_tF","role":"symbol","modules":[{"name":"Systems"}],"fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"run"},{"kind":"text","text":"("},{"kind":"externalParam","text":"on"},{"kind":"text","text":": "},{"kind":"keyword","text":"inout"},{"kind":"text","text":" "},{"kind":"typeIdentifier","preciseIdentifier":"s:11WorldModule0A0V","text":"World"},{"kind":"text","text":")"}]},"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/systems\/schedule\/run(on:)"]}],"references":{"doc://Systems/documentation/Systems/Schedule":{"role":"symbol","abstract":[{"type":"text","text":"Systems in the order they run."}],"url":"\/documentation\/systems\/schedule","kind":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Schedule","kind":"identifier"}],"title":"Schedule","identifier":"doc:\/\/Systems\/documentation\/Systems\/Schedule","navigatorTitle":[{"text":"Schedule","kind":"identifier"}],"type":"topic"},"doc://Systems/documentation/Systems":{"identifier":"doc:\/\/Systems\/documentation\/Systems","title":"Systems","abstract":[{"type":"text","text":"Rules that run on a world, in the order written unless constrained otherwise."}],"type":"