{"metadata":{"role":"symbol","title":"run(on:)","roleHeading":"Instance Method","externalID":"s:7Systems8ScheduleV3run2ony11WorldModule0E0Vz_tF","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"run"},{"kind":"text","text":"("},{"kind":"externalParam","text":"on"},{"kind":"text","text":": "},{"kind":"keyword","text":"inout"},{"kind":"text","text":" "},{"kind":"typeIdentifier","text":"World","preciseIdentifier":"s:11WorldModule0A0V"},{"kind":"text","text":")"}],"remoteSource":{"url":"https:\/\/github.com\/Tyler-Keith-Thompson\/ECS\/blob\/main\/Sources\/Systems\/Schedule.swift#L166","fileName":"Schedule.swift"},"modules":[{"name":"Systems"}],"symbolKind":"method"},"primaryContentSections":[{"kind":"declarations","declarations":[{"languages":["swift"],"tokens":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"run"},{"kind":"text","text":"("},{"kind":"externalParam","text":"on"},{"kind":"text","text":" "},{"kind":"internalParam","text":"world"},{"kind":"text","text":": "},{"kind":"keyword","text":"inout"},{"kind":"text","text":" "},{"kind":"typeIdentifier","text":"World","identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/World","preciseIdentifier":"s:11WorldModule0A0V"},{"kind":"text","text":")"}],"platforms":["Linux"]}]},{"kind":"content","content":[{"level":2,"text":"Discussion","type":"heading","anchor":"discussion"},{"type":"paragraph","inlineContent":[{"text":"A system depends on the systems before it that it must run after, by an ","type":"text"},{"code":"after","type":"codeVoice"},{"text":" or","type":"text"},{"text":" ","type":"text"},{"code":"before","type":"codeVoice"},{"text":" constraint, and on those it conflicts with: one writes what the other reads or","type":"text"},{"text":" ","type":"text"},{"text":"writes, or either has no ","type":"text"},{"isActive":true,"identifier":"doc:\/\/Systems\/documentation\/Systems\/System\/access","type":"reference"},{"text":". The systems run in waves: each wave holds the","type":"text"},{"text":" ","type":"text"},{"text":"systems whose dependencies all ran in earlier waves, and runs them with","type":"text"},{"text":" ","type":"text"},{"code":"WorldModule\/World\/runConcurrently(_:)","type":"codeVoice"},{"text":". A system without an access runs alone. The world","type":"text"},{"text":" ","type":"text"},{"text":"ends as it would running the systems one after another in order.","type":"text"}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"At the start of each wave, every condition of its systems is checked, so a condition reads"},{"type":"text","text":" "},{"type":"text","text":"only what its system’s access lists, and the world’s change tick advances. Each system’s"},{"type":"text","text":" "},{"type":"codeVoice","code":"WorldModule\/World\/lastRun"},{"type":"text","text":" is the tick of its previous run, so filters such as"},{"type":"text","text":" "},{"type":"codeVoice","code":".changed(Position.self)"},{"type":"text","text":" show it what changed since then: changes made by the systems"},{"type":"text","text":" "},{"type":"text","text":"after it on the previous run and before it on this one, but not its own. A system that has"},{"type":"text","text":" "},{"type":"text","text":"not run on this world before sees every component as added and changed. A skipped system"},{"type":"text","text":" "},{"type":"text","text":"has not run: the next time it runs, it sees everything since it last did."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Before the first wave, each system that has not run on this world is initialized"},{"type":"text","text":" "},{"type":"text","text":"("},{"type":"reference","identifier":"doc:\/\/Systems\/documentation\/Systems\/System\/initialize(in:)","isActive":true},{"type":"text","text":")."}]},{"type":"paragraph","inlineContent":[{"text":"Command buffers the wave’s systems queue (","type":"text"},{"code":"WorldModule\/World\/queue(_:)","type":"codeVoice"},{"text":") apply at the end","type":"text"},{"text":" ","type":"text"},{"text":"of the wave, in the order the systems run. The tick advances once more after the last wave,","type":"text"},{"text":" ","type":"text"},{"text":"so changes made to the world between runs are newer than every system’s previous run.","type":"text"}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"A "},{"type":"reference","identifier":"doc:\/\/Systems\/documentation\/Systems\/MainActorSystem","isActive":true},{"type":"text","text":" runs on the calling thread after the other systems of its wave."}]},{"content":[{"inlineContent":[{"text":"Every system with an access reads and writes only what it lists; see","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"WorldModule\/World\/runConcurrently(_:)"},{"text":". A schedule whose main-actor systems run is run","type":"text"},{"text":" ","type":"text"},{"text":"on the main actor.","type":"text"}],"type":"paragraph"}],"type":"aside","style":"note","name":"Precondition"}]}],"variants":[{"paths":["\/documentation\/systems\/schedule\/run(on:)"],"traits":[{"interfaceLanguage":"swift"}]}],"kind":"symbol","hierarchy":{"paths":[["doc:\/\/Systems\/documentation\/Systems","doc:\/\/Systems\/documentation\/Systems\/Schedule"]]},"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/Systems\/documentation\/Systems\/Schedule\/run(on:)"},"sections":[],"schemaVersion":{"minor":3,"patch":0,"major":0},"abstract":[{"text":"Runs every system once on ","type":"text"},{"code":"world","type":"codeVoice"},{"text":", running systems that do not depend on each other at the","type":"text"},{"text":" ","type":"text"},{"text":"same time.","type":"text"}],"references":{"doc://Systems/documentation/Systems/Schedule":{"url":"\/documentation\/systems\/schedule","kind":"symbol","abstract":[{"text":"Systems that run on a world, as though in the order written, at the same time where they can.","type":"text"}],"title":"Schedule","type":"topic","identifier":"doc:\/\/Systems\/documentation\/Systems\/Schedule","role":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"Schedule"}],"navigatorTitle":[{"kind":"identifier","text":"Schedule"}]},"doc://Systems/documentation/Systems/System/initialize(in:)":{"title":"initialize(in:)","required":true,"kind":"symbol","url":"\/documentation\/systems\/system\/initialize(in:)","type":"topic","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"kind":"identifier","text":"initialize"},{"kind":"text","text":"("},{"kind":"externalParam","text":"in"},{"kind":"text","text":": "},{"kind":"keyword","text":"inout"},{"kind":"text","text":" "},{"kind":"typeIdentifier","text":"World","preciseIdentifier":"s:11WorldModule0A0V"},{"kind":"text","text":")"}],"identifier":"doc:\/\/Systems\/documentation\/Systems\/System\/initialize(in:)","defaultImplementations":1,"abstract":[{"text":"Prepares ","type":"text"},{"type":"codeVoice","code":"world"},{"text":" for the system, before its first run on it: a schedule calls this","type":"text"},{"text":" ","type":"text"},{"text":"before the wave the system first runs in, outside any concurrent run. Nothing, by default.","type":"text"}],"role":"symbol"},"doc://WorldModule/documentation/WorldModule/World":{"title":"World","navigatorTitle":[{"text":"World","kind":"identifier"}],"type":"topic","identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/World","url":"\/documentation\/worldmodule\/world","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"World","kind":"identifier"}],"role":"symbol","abstract":[{"type":"text","text":"Entities, the components they hold, and the world’s resources."}],"kind":"symbol"},"doc://Systems/documentation/Systems":{"url":"\/documentation\/systems","kind":"symbol","abstract":[{"type":"text","text":"Rules that run on a world, in the order written unless constrained otherwise."}],"title":"Systems","type":"topic","identifier":"doc:\/\/Systems\/documentation\/Systems","role":"collection"},"doc://Systems/documentation/Systems/Schedule/run(on:)":{"title":"run(on:)","type":"topic","identifier":"doc:\/\/Systems\/documentation\/Systems\/Schedule\/run(on:)","url":"\/documentation\/systems\/schedule\/run(on:)","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"run","kind":"identifier"},{"text":"(","kind":"text"},{"text":"on","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"inout","kind":"keyword"},{"text":" ","kind":"text"},{"text":"World","preciseIdentifier":"s:11WorldModule0A0V","kind":"typeIdentifier"},{"text":")","kind":"text"}],"role":"symbol","abstract":[{"text":"Runs every system once on ","type":"text"},{"code":"world","type":"codeVoice"},{"text":", running systems that do not depend on each other at the","type":"text"},{"text":" ","type":"text"},{"text":"same time.","type":"text"}],"kind":"symbol"},"doc://Systems/documentation/Systems/System/access":{"title":"access","type":"topic","identifier":"doc:\/\/Systems\/documentation\/Systems\/System\/access","url":"\/documentation\/systems\/system\/access","required":true,"fragments":[{"kind":"keyword","text":"var"},{"kind":"text","text":" "},{"kind":"identifier","text":"access"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"Access","preciseIdentifier":"s:11WorldModule6AccessV"},{"kind":"text","text":"?"}],"role":"symbol","kind":"symbol","abstract":[{"text":"What the system reads and writes, so ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/Systems\/documentation\/Systems\/Schedule\/run(on:)"},{"text":" can run it alongside","type":"text"},{"text":" ","type":"text"},{"text":"systems it does not conflict with; nil, the default, when it may change anything and must","type":"text"},{"text":" ","type":"text"},{"text":"run alone.","type":"text"}],"defaultImplementations":1},"doc://Systems/documentation/Systems/MainA