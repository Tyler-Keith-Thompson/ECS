{"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/systems\/schedule\/run(on:)"]}],"kind":"symbol","hierarchy":{"paths":[["doc:\/\/Systems\/documentation\/Systems","doc:\/\/Systems\/documentation\/Systems\/Schedule"]]},"sections":[],"identifier":{"url":"doc:\/\/Systems\/documentation\/Systems\/Schedule\/run(on:)","interfaceLanguage":"swift"},"abstract":[{"text":"Runs every system once on ","type":"text"},{"code":"world","type":"codeVoice"},{"text":", running systems that do not depend on each other at the","type":"text"},{"text":" ","type":"text"},{"text":"same time.","type":"text"}],"schemaVersion":{"major":0,"minor":3,"patch":0},"primaryContentSections":[{"declarations":[{"languages":["swift"],"tokens":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"run"},{"kind":"text","text":"("},{"kind":"externalParam","text":"on"},{"kind":"text","text":" "},{"kind":"internalParam","text":"world"},{"kind":"text","text":": "},{"kind":"keyword","text":"inout"},{"kind":"text","text":" "},{"identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/World","kind":"typeIdentifier","text":"World","preciseIdentifier":"s:11WorldModule0A0V"},{"kind":"text","text":")"}],"platforms":["Linux"]}],"kind":"declarations"},{"content":[{"type":"heading","level":2,"text":"Discussion","anchor":"discussion"},{"type":"paragraph","inlineContent":[{"text":"A system depends on the systems before it that it must run after, by an ","type":"text"},{"code":"after","type":"codeVoice"},{"text":" or","type":"text"},{"text":" ","type":"text"},{"code":"before","type":"codeVoice"},{"text":" constraint, and on those it conflicts with: one writes what the other reads or","type":"text"},{"text":" ","type":"text"},{"text":"writes, or either has no ","type":"text"},{"isActive":true,"identifier":"doc:\/\/Systems\/documentation\/Systems\/System\/access","type":"reference"},{"text":". The systems run in waves: each wave holds the","type":"text"},{"text":" ","type":"text"},{"text":"systems whose dependencies all ran in earlier waves, and runs them with","type":"text"},{"text":" ","type":"text"},{"code":"WorldModule\/World\/runConcurrently(_:)","type":"codeVoice"},{"text":". A system without an access runs alone. The world","type":"text"},{"text":" ","type":"text"},{"text":"ends as it would running the systems one after another in order.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"At the start of each wave, every condition of its systems is checked, so a condition reads","type":"text"},{"text":" ","type":"text"},{"text":"only what its system’s access lists, and the world’s change tick advances. Each system’s","type":"text"},{"text":" ","type":"text"},{"code":"WorldModule\/World\/lastRun","type":"codeVoice"},{"text":" is the tick of its previous run, so filters such as","type":"text"},{"text":" ","type":"text"},{"code":".changed(Position.self)","type":"codeVoice"},{"text":" show it what changed since then: changes made by the systems","type":"text"},{"text":" ","type":"text"},{"text":"after it on the previous run and before it on this one, but not its own. A system that has","type":"text"},{"text":" ","type":"text"},{"text":"not run on this world before sees every component as added and changed. A skipped system","type":"text"},{"text":" ","type":"text"},{"text":"has not run: the next time it runs, it sees everything since it last did.","type":"text"}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Before the first wave, each system that has not run on this world is initialized"},{"type":"text","text":" "},{"type":"text","text":"("},{"type":"reference","identifier":"doc:\/\/Systems\/documentation\/Systems\/System\/initialize(in:)","isActive":true},{"type":"text","text":")."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Command buffers the wave’s systems queue ("},{"code":"WorldModule\/World\/queue(_:)","type":"codeVoice"},{"type":"text","text":") apply at the end"},{"type":"text","text":" "},{"type":"text","text":"of the wave, in the order the systems run. The tick advances once more after the last wave,"},{"type":"text","text":" "},{"type":"text","text":"so changes made to the world between runs are newer than every system’s previous run."}]},{"name":"Precondition","type":"aside","style":"note","content":[{"inlineContent":[{"type":"text","text":"Every system with an access reads and writes only what it lists; see"},{"type":"text","text":" "},{"type":"codeVoice","code":"WorldModule\/World\/runConcurrently(_:)"},{"type":"text","text":"."}],"type":"paragraph"}]}],"kind":"content"}],"metadata":{"roleHeading":"Instance Method","role":"symbol","title":"run(on:)","externalID":"s:7Systems8ScheduleV3run2ony11WorldModule0E0Vz_tF","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"run","kind":"identifier"},{"text":"(","kind":"text"},{"text":"on","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"inout","kind":"keyword"},{"text":" ","kind":"text"},{"text":"World","kind":"typeIdentifier","preciseIdentifier":"s:11WorldModule0A0V"},{"text":")","kind":"text"}],"remoteSource":{"url":"https:\/\/github.com\/Tyler-Keith-Thompson\/ECS\/blob\/main\/Sources\/Systems\/Schedule.swift#L162","fileName":"Schedule.swift"},"symbolKind":"method","modules":[{"name":"Systems"}]},"references":{"doc://Systems/documentation/Systems/Schedule/run(on:)":{"type":"topic","identifier":"doc:\/\/Systems\/documentation\/Systems\/Schedule\/run(on:)","kind":"symbol","title":"run(on:)","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"run"},{"kind":"text","text":"("},{"kind":"externalParam","text":"on"},{"kind":"text","text":": "},{"kind":"keyword","text":"inout"},{"kind":"text","text":" "},{"kind":"typeIdentifier","text":"World","preciseIdentifier":"s:11WorldModule0A0V"},{"kind":"text","text":")"}],"abstract":[{"text":"Runs every system once on ","type":"text"},{"code":"world","type":"codeVoice"},{"text":", running systems that do not depend on each other at the","type":"text"},{"text":" ","type":"text"},{"text":"same time.","type":"text"}],"url":"\/documentation\/systems\/schedule\/run(on:)","role":"symbol"},"doc://Systems/documentation/Systems/System/access":{"required":true,"role":"symbol","type":"topic","identifier":"doc:\/\/Systems\/documentation\/Systems\/System\/access","defaultImplementations":1,"fragments":[{"text":"var","kind":"keyword"},{"text":" ","kind":"text"},{"text":"access","kind":"identifier"},{"text":": ","kind":"text"},{"text":"Access","kind":"typeIdentifier","preciseIdentifier":"s:11WorldModule6AccessV"},{"text":"?","kind":"text"}],"abstract":[{"type":"text","text":"What the system reads and writes, so "},{"type":"reference","identifier":"doc:\/\/Systems\/documentation\/Systems\/Schedule\/run(on:)","isActive":true},{"type":"text","text":" can run it alongside"},{"type":"text","text":" "},{"type":"text","text":"systems it does not conflict with; nil, the default, when it may change anything and must"},{"type":"text","text":" "},{"type":"text","text":"run alone."}],"url":"\/documentation\/systems\/system\/access","title":"access","kind":"symbol"},"doc://Systems/documentation/Systems/Schedule":{"type":"topic","navigatorTitle":[{"kind":"identifier","text":"Schedule"}],"identifier":"doc:\/\/Systems\/documentation\/Systems\/Schedule","kind":"symbol","title":"Schedule","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"Schedule"}],"abstract":[{"text":"Systems that run on a world, as though in the order written, at the same time where they can.","type":"text"}],"url":"\/documentation\/systems\/schedule","role":"symbol"},"doc://WorldModule/documentation/WorldModule/World":{"role":"symbol","url":"\/documentation\/worldmodule\/world","kind":"symbol","type":"topic","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"World","kind":"identifier"}],"navigatorTitle":[{"text":"World","kind":"identifier"}],"identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/World","abstract":[{"type":"text","text":"Entities, the components they hold, and the world’s resources."}],"title":"World"},"doc://Systems/documentation/Systems":{"role":"collection","type":"topic","identifier":"doc:\/\/Systems\/documentation\/Systems","url":"\/documentation\/systems","abstract":[{"text":"Rules that run on a world, in the order written unless constrained otherwise.","type":"text"}],"title":"Systems","kind":"symbol"},"doc://Systems/documentation/Systems/System/initialize(in:)":{"required":true,"role":"symbol","type":"topic","identifier":"doc:\/\/Systems\/documentation\/Systems\/System\/initialize(in:)","defaultImplementations":1,"fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"initialize","kind":"identifier"},{"text":"(","kind":"text"},{"text":"in","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"inout","kind":"keyword"},{"text":" ","kind":"text"},{"text":"World","kind":"typeIdentifier","preciseIdentifier":"s:11WorldModule0A0V"},{"text":")","kind":"text"}],"abstract":[{"type":"text","text":"Prepares "},{"type":"codeVoice","code":"world"},{"type":"text","text":" for the system, before its first run on it: a schedule calls this"},{"type":"text","text":" "},{"type":"text","text":"before the wave the system first runs in, outside any concurrent run. Nothing, by default."}],"title":"initialize(in:)","url":"\/documentation\/systems\/system\/initialize(in:)","kind":"symbol"}}}