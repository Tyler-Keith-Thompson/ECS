{"kind":"symbol","metadata":{"symbolKind":"method","remoteSource":{"fileName":"Schedule.swift","url":"https:\/\/github.com\/Tyler-Keith-Thompson\/ECS\/blob\/main\/Sources\/Systems\/Schedule.swift#L294"},"roleHeading":"Instance Method","externalID":"s:7Systems8ScheduleV3run2ony11WorldModule0E0Vz_tF","role":"symbol","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"run","kind":"identifier"},{"text":"(","kind":"text"},{"text":"on","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"inout","kind":"keyword"},{"text":" ","kind":"text"},{"text":"World","preciseIdentifier":"s:11WorldModule0A0V","kind":"typeIdentifier"},{"text":")","kind":"text"}],"title":"run(on:)","modules":[{"name":"Systems"}]},"sections":[],"schemaVersion":{"patch":0,"major":0,"minor":3},"seeAlsoSections":[{"generated":true,"title":"Running Systems","identifiers":["doc:\/\/Systems\/documentation\/Systems\/Schedule\/runSerially(on:)"],"anchor":"Running-Systems"}],"hierarchy":{"paths":[["doc:\/\/Systems\/documentation\/Systems","doc:\/\/Systems\/documentation\/Systems\/Schedule"]]},"primaryContentSections":[{"declarations":[{"languages":["swift"],"tokens":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"run"},{"kind":"text","text":"("},{"kind":"externalParam","text":"on"},{"kind":"text","text":" "},{"kind":"internalParam","text":"world"},{"kind":"text","text":": "},{"kind":"keyword","text":"inout"},{"kind":"text","text":" "},{"kind":"typeIdentifier","text":"World","identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/World","preciseIdentifier":"s:11WorldModule0A0V"},{"kind":"text","text":")"}],"platforms":["Linux"]}],"kind":"declarations"},{"kind":"parameters","parameters":[{"name":"world","content":[{"inlineContent":[{"text":"The world to run the systems on.","type":"text"}],"type":"paragraph"}]}]},{"kind":"content","content":[{"anchor":"discussion","type":"heading","level":2,"text":"Discussion"},{"inlineContent":[{"text":"The world ends as though the systems had run one after another, in the order of","type":"text"},{"text":" ","type":"text"},{"type":"reference","identifier":"doc:\/\/Systems\/documentation\/Systems\/Schedule\/systems","isActive":true},{"text":".","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"A system depends on the systems before it that a constraint orders it after, and on those","type":"text"},{"text":" ","type":"text"},{"text":"it conflicts with: one writes what the other reads or writes, or either has no","type":"text"},{"text":" ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/Systems\/documentation\/Systems\/System\/access"},{"text":". The systems run in ","type":"text"},{"type":"emphasis","inlineContent":[{"text":"waves","type":"text"}]},{"text":". Each wave holds the systems whose","type":"text"},{"text":" ","type":"text"},{"text":"dependencies all ran in earlier waves, and runs them at the same time with","type":"text"},{"text":" ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/World\/runConcurrently(_:)"},{"text":". A system without an access runs alone, and a","type":"text"},{"text":" ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/Systems\/documentation\/Systems\/MainActorSystem"},{"text":" runs on the calling thread after the other systems of its wave.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"Before the first wave, each system that hasn’t run on this world before is initialized"},{"type":"text","text":" "},{"type":"text","text":"("},{"isActive":true,"type":"reference","identifier":"doc:\/\/Systems\/documentation\/Systems\/System\/initialize(in:)"},{"type":"text","text":"). At the start of each wave, the conditions of its systems are"},{"type":"text","text":" "},{"type":"text","text":"checked, and systems whose conditions don’t hold are skipped. Commands the wave’s systems"},{"type":"text","text":" "},{"type":"text","text":"queue apply at the end of the wave, in the order the systems run."}],"type":"paragraph"},{"anchor":"Change-Detection","type":"heading","level":3,"text":"Change Detection"},{"inlineContent":[{"type":"text","text":"The world’s change tick advances at the start of each wave. While a system runs, the"},{"type":"text","text":" "},{"type":"text","text":"world’s "},{"identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/World\/lastRun","type":"reference","isActive":true},{"type":"text","text":" is the tick of that system’s previous run, so a"},{"type":"text","text":" "},{"type":"text","text":"filter such as "},{"type":"codeVoice","code":"Changed<Position>"},{"type":"text","text":" shows it what changed since then: the changes the"},{"type":"text","text":" "},{"type":"text","text":"systems after it made on the previous run and the systems before it made on this one, but"},{"type":"text","text":" "},{"type":"text","text":"not its own. The following system counts the positions that changed since it last ran:"}],"type":"paragraph"},{"type":"codeListing","code":["struct Moves: Resource { var count: Int }","","@System","struct CountMoves {","    func run(_ moved: Query<Position>.Where<Changed<Position>>, _ moves: ResourceWriter<Moves>) {","        for _ in moved { moves.value.count += 1 }","    }","}","","var world = World()","world.resources.insert(Moves(count: 0))","let ball = world.spawn(Position(x: 0, y: 0))","world.spawn(Position(x: 5, y: 0))","","let frame = Schedule { CountMoves() }","frame.run(on: &world)","print(world.resources[Moves.self].count)","\/\/ Prints \"2\"","","world[Position.self, of: ball].x = 1","frame.run(on: &world)","print(world.resources[Moves.self].count)","\/\/ Prints \"3\""],"syntax":"swift"},{"inlineContent":[{"type":"text","text":"A system that hasn’t run on this world before sees every component as added and changed."},{"type":"text","text":" "},{"type":"text","text":"A skipped system hasn’t run, so the next time it runs it sees every change since it last"},{"type":"text","text":" "},{"type":"text","text":"did. The tick advances once more after the last wave, so changes you make to the world"},{"type":"text","text":" "},{"type":"text","text":"between runs are newer than every system’s previous run."}],"type":"paragraph"},{"name":"Precondition","style":"note","type":"aside","content":[{"inlineContent":[{"type":"text","text":"Every system with an access reads and writes only what it lists; see"},{"type":"text","text":" "},{"isActive":true,"type":"reference","identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/World\/runConcurrently(_:)"},{"type":"text","text":". A schedule holding a main-actor system that"},{"type":"text","text":" "},{"type":"text","text":"runs is run on the main actor."}],"type":"paragraph"}]}]}],"abstract":[{"text":"Runs each system once on a world, running systems that don’t depend on each other at the","type":"text"},{"text":" ","type":"text"},{"text":"same time.","type":"text"}],"identifier":{"url":"doc:\/\/Systems\/documentation\/Systems\/Schedule\/run(on:)","interfaceLanguage":"swift"},"variants":[{"paths":["\/documentation\/systems\/schedule\/run(on:)"],"traits":[{"interfaceLanguage":"swift"}]}],"references":{"doc://Systems/documentation/Systems/Schedule/systems":{"abstract":[{"text":"The schedule’s systems, in the order they run.","type":"text"}],"identifier":"doc:\/\/Systems\/documentation\/Systems\/Schedule\/systems","title":"systems","url":"\/documentation\/systems\/schedule\/systems","role":"symbol","fragments":[{"kind":"keyword","text":"let"},{"kind":"text","text":" "},{"kind":"identifier","text":"systems"},{"kind":"text","text":": ["},{"preciseIdentifier":"s:7Systems15ScheduledSystemV","kind":"typeIdentifier","text":"ScheduledSystem"},{"kind":"text","text":"]"}],"kind":"symbol","type":"topic"},"doc://WorldModule/documentation/WorldModule/World/runConcurrently(_:)":{"type":"topic","role":"symbol","title":"runConcurrently(_:)","url":"\/documentation\/worldmodule\/world\/runconcurrently(_:)","identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/World\/runConcurrently(_:)","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"runConcurrently","kind":"identifier"},{"text":"([","kind":"text"},{"preciseIdentifier":"s:11WorldModule16ConcurrentChangeV","text":"ConcurrentChange","kind":"typeIdentifier"},{"text":"])","kind":"text"}],"kind":"symbol","abstract":[{"type":"text","text":"Runs changes at the same time, each on its own copy of the world, and keeps what each one"},{"type":"text","text":" "},{"type":"text","text":"wrote."}]},"doc://Systems/documentation/Systems/System/access":{"identifier":"doc:\/\/Systems\/documentation\/Systems\/System\/access","required":true,"type":"topic","abstract":[{"type":"text","text":"The component, resource and event types the system reads and writes, or "},{"type":"codeVoice","code":"nil"},{"type":"text","text":" if it may"},{"type":"text","text":" "},{"type":"text","text":"change anything."}],"title":"access","role":"symbol","url":"\/documentation\/systems\/system\/access","defaultImplementations":1,"fragments":[{"kind":"keyword","text":"var"},{"kind":"text","text":" "},{"kind":"identifier","text":"access"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"Access","preciseIdentifier":"s:11WorldModule6AccessV"},{"kind":"text","text":"?"}],"kind":"symbol"},"doc://Systems/documentation/Systems/System/initialize(in:)":{"defaultImplementations":1,"abstract":[{"type":"text","text":"Prepares a world for the system before the system first runs on it."}],"identifier":"doc:\/\/Systems\/documentation\/Systems\/System\/initialize(in:)","url":"\/documentation\/systems\/system\/initialize(in:)","title":"initialize(in:)","required":true,"role":"symbol","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"initialize"},{"kind":"text","text":"("},{"kind":"externalParam","text":"in"},{"kind":"text","text":": "},{"text":"inout","kind":"keyword"},{"text":" ","kind":"text"},{"text":"World","kind":"typeIdentifier","preciseIdentifier":"s:11WorldModule0A0V"},{"text":")","kind":"text"}],"kind":"symbol","type":"topic"},"doc://Systems/documentation/Systems/MainActorSystem":{"identifier":"doc:\/\/Systems\/documentation\/Systems\/MainActorSystem","navigatorTitle":[{"text":"MainActorSystem","kind":"identifier"}],"type":"topic","title":"MainActorSystem","abstract":[{"type":"text","text":"A system that runs on the main actor, for work that touches main-actor state such as a user"},{"type":"text","text":" "},{"type":"text","text":"interface."}],"role":"symbol","url":"\/documentation\/systems\/mainactorsystem","fragments":[{"text":"protocol","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MainActorSystem","kind":"identifier"}],"kind":"symbol"},"doc://Systems/documentation/Systems":{"identifier":"doc:\/\/Systems\/documentation\/Systems","kind":"symbol","url":"\/documentation\/systems","title":"Systems","abstract":[{"type":"text","text":"Declare the rules of a simulation as systems, and run them on a world in a schedule."}],"type":"topic","role":"collection"},"doc://Systems/documentation/Systems/Schedule":{"role":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Schedule","kind":"identifier"}],"navigatorTitle":[{"text":"Schedule","kind":"identifier"}],"type":"topic","url":"\/documentation\/systems\/schedule","identifier":"doc:\/\/Systems\/documentation\/Systems\/Schedule","kind":"symbol","abstract":[{"text":"A list of systems that run on a world, in order, and at the same time where they can.","type":"text"}],"title":"Schedule"},"doc://WorldModule/documentation/WorldModule/World/lastRun":{"type":"topic","role":"symbol","title":"lastRun","url":"\/documentation\/worldmodule\/world\/lastrun","identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/World\/lastRun","fragments":[{"kind":"keyword","text":"var"},{"kind":"text","text":" "},{"kind":"identifier","text":"lastRun"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"ChangeTick","preciseIdentifier":"s:11WorldModule10ChangeTickV"}],"kind":"symbol","abstract":[{"text":"The change tick at which the running system last ran.","type":"text"}]},"doc://Systems/documentation/Systems/Schedule/run(on:)":{"identifier":"doc:\/\/Systems\/documentation\/Systems\/Schedule\/run(on:)","title":"run(on:)","url":"\/documentation\/systems\/schedule\/run(on:)","kind":"symbol","role":"symbol","type":"topic","abstract":[{"type":"text","text":"Runs each system once on a world, running systems that don’t depend on each other at the"},{"type":"text","text":" "},{"type":"text","text":"same time."}],"fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"run","kind":"identifier"},{"text":"(","kind":"text"},{"text":"on","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"inout","kind":"keyword"},{"text":" ","kind":"text"},{"text":"World","kind":"typeIdentifier","preciseIdentifier":"s:11WorldModule0A0V"},{"text":")","kind":"text"}]},"doc://WorldModule/documentation/WorldModule/World":{"role":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"World"}],"navigatorTitle":[{"kind":"identifier","text":"World"}],"type":"topic","url":"\/documentation\/worldmodule\/world","identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/World","kind":"symbol","abstract":[{"type":"text","text":"A collection of entities, the components they hold, and resources."}],"title":"World"},"doc://Systems/documentation/Systems/Schedule/runSerially(on:)":{"abstract":[{"text":"Runs each system once on a world, one system at a time.","type":"text"}],"identifier":"doc:\/\/Systems\/documentation\/Systems\/Schedule\/runSerially(on:)","title":"runSerially(on:)","url":"\/documentation\/systems\/schedule\/runserially(on:)","role":"symbol","fragments":[{"kind":"ke