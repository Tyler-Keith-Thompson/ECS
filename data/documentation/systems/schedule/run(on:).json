{"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/Systems\/documentation\/Systems\/Schedule\/run(on:)"},"variants":[{"paths":["\/documentation\/systems\/schedule\/run(on:)"],"traits":[{"interfaceLanguage":"swift"}]}],"hierarchy":{"paths":[["doc:\/\/Systems\/documentation\/Systems","doc:\/\/Systems\/documentation\/Systems\/Schedule"]]},"seeAlsoSections":[{"anchor":"Running-Systems","identifiers":["doc:\/\/Systems\/documentation\/Systems\/Schedule\/runSerially(on:)"],"generated":true,"title":"Running Systems"}],"sections":[],"kind":"symbol","schemaVersion":{"major":0,"minor":3,"patch":0},"metadata":{"role":"symbol","remoteSource":{"fileName":"Schedule.swift","url":"https:\/\/github.com\/Tyler-Keith-Thompson\/ECS\/blob\/main\/Sources\/Systems\/Schedule.swift#L294"},"title":"run(on:)","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"run"},{"kind":"text","text":"("},{"kind":"externalParam","text":"on"},{"kind":"text","text":": "},{"kind":"keyword","text":"inout"},{"kind":"text","text":" "},{"kind":"typeIdentifier","preciseIdentifier":"s:11WorldModule0A0V","text":"World"},{"kind":"text","text":")"}],"roleHeading":"Instance Method","symbolKind":"method","modules":[{"name":"Systems"}],"externalID":"s:7Systems8ScheduleV3run2ony11WorldModule0E0Vz_tF"},"abstract":[{"type":"text","text":"Runs each system once on a world, running systems that don’t depend on each other at the"},{"type":"text","text":" "},{"type":"text","text":"same time."}],"primaryContentSections":[{"kind":"declarations","declarations":[{"tokens":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"run","kind":"identifier"},{"text":"(","kind":"text"},{"text":"on","kind":"externalParam"},{"text":" ","kind":"text"},{"text":"world","kind":"internalParam"},{"text":": ","kind":"text"},{"text":"inout","kind":"keyword"},{"text":" ","kind":"text"},{"text":"World","kind":"typeIdentifier","preciseIdentifier":"s:11WorldModule0A0V","identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/World"},{"text":")","kind":"text"}],"languages":["swift"],"platforms":["Linux"]}]},{"kind":"parameters","parameters":[{"content":[{"inlineContent":[{"text":"The world to run the systems on.","type":"text"}],"type":"paragraph"}],"name":"world"}]},{"kind":"content","content":[{"type":"heading","text":"Discussion","anchor":"discussion","level":2},{"type":"paragraph","inlineContent":[{"type":"text","text":"The world ends as though the systems had run one after another, in the order of"},{"type":"text","text":" "},{"type":"reference","identifier":"doc:\/\/Systems\/documentation\/Systems\/Schedule\/systems","isActive":true},{"type":"text","text":"."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"A system depends on the systems before it that a constraint orders it after, and on those"},{"type":"text","text":" "},{"type":"text","text":"it conflicts with: one writes what the other reads or writes, or either has no"},{"type":"text","text":" "},{"type":"reference","identifier":"doc:\/\/Systems\/documentation\/Systems\/System\/access","isActive":true},{"type":"text","text":". The systems run in "},{"inlineContent":[{"text":"waves","type":"text"}],"type":"emphasis"},{"type":"text","text":". Each wave holds the systems whose"},{"type":"text","text":" "},{"type":"text","text":"dependencies all ran in earlier waves, and runs them at the same time with"},{"type":"text","text":" "},{"type":"reference","identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/World\/runConcurrently(_:)","isActive":true},{"type":"text","text":". A system without an access runs alone, and a"},{"type":"text","text":" "},{"type":"reference","identifier":"doc:\/\/Systems\/documentation\/Systems\/MainActorSystem","isActive":true},{"type":"text","text":" runs on the calling thread after the other systems of its wave."}]},{"type":"paragraph","inlineContent":[{"text":"Before the first wave, each system that hasn’t run on this world before is initialized","type":"text"},{"text":" ","type":"text"},{"text":"(","type":"text"},{"isActive":true,"identifier":"doc:\/\/Systems\/documentation\/Systems\/System\/initialize(in:)","type":"reference"},{"text":"). At the start of each wave, the conditions of its systems are","type":"text"},{"text":" ","type":"text"},{"text":"checked, and systems whose conditions don’t hold are skipped. Commands the wave’s systems","type":"text"},{"text":" ","type":"text"},{"text":"queue apply at the end of the wave, in the order the systems run.","type":"text"}]},{"type":"heading","text":"Change Detection","anchor":"Change-Detection","level":3},{"type":"paragraph","inlineContent":[{"text":"The world’s change tick advances at the start of each wave. While a system runs, the","type":"text"},{"text":" ","type":"text"},{"text":"world’s ","type":"text"},{"identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/World\/lastRun","isActive":true,"type":"reference"},{"text":" is the tick of that system’s previous run, so a","type":"text"},{"text":" ","type":"text"},{"text":"filter such as ","type":"text"},{"code":"Changed<Position>","type":"codeVoice"},{"text":" shows it what changed since then: the changes the","type":"text"},{"text":" ","type":"text"},{"text":"systems after it made on the previous run and the systems before it made on this one, but","type":"text"},{"text":" ","type":"text"},{"text":"not its own. The following system counts the positions that changed since it last ran:","type":"text"}]},{"syntax":"swift","code":["struct Moves: Resource { var count: Int }","","@System","struct CountMoves {","    func run(_ moved: Query<Position>.Where<Changed<Position>>, _ moves: ResourceWriter<Moves>) {","        for _ in moved { moves.value.count += 1 }","    }","}","","var world = World()","world.resources.insert(Moves(count: 0))","let ball = world.spawn(Position(x: 0, y: 0))","world.spawn(Position(x: 5, y: 0))","","let frame = Schedule { CountMoves() }","frame.run(on: &world)","print(world.resources[Moves.self].count)","\/\/ Prints \"2\"","","world[Position.self, of: ball].x = 1","frame.run(on: &world)","print(world.resources[Moves.self].count)","\/\/ Prints \"3\""],"type":"codeListing"},{"type":"paragraph","inlineContent":[{"text":"A system that hasn’t run on this world before sees every component as added and changed.","type":"text"},{"text":" ","type":"text"},{"text":"A skipped system hasn’t run, so the next time it runs it sees every change since it last","type":"text"},{"text":" ","type":"text"},{"text":"did. The tick advances once more after the last wave, so changes you make to the world","type":"text"},{"text":" ","type":"text"},{"text":"between runs are newer than every system’s previous run.","type":"text"}]},{"type":"aside","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Every system with an access reads and writes only what it lists; see"},{"type":"text","text":" "},{"identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/World\/runConcurrently(_:)","type":"reference","isActive":true},{"type":"text","text":". A schedule holding a main-actor system that"},{"type":"text","text":" "},{"type":"text","text":"runs is run on the main actor."}]}],"style":"note","name":"Precondition"}]}],"references":{"doc://Systems/documentation/Systems/Schedule":{"navigatorTitle":[{"text":"Schedule","kind":"identifier"}],"type":"topic","url":"\/documentation\/systems\/schedule","kind":"symbol","identifier":"doc:\/\/Systems\/documentation\/Systems\/Schedule","abstract":[{"text":"A list of systems that run on a world, in order, and at the same time where they can.","type":"text"}],"fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Schedule","kind":"identifier"}],"role":"symbol","title":"Schedule"},"doc://WorldModule/documentation/WorldModule/World/lastRun":{"identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/World\/lastRun","kind":"symbol","role":"symbol","title":"lastRun","abstract":[{"type":"text","text":"The change tick at which the running system last ran."}],"fragments":[{"text":"var","kind":"keyword"},{"text":" ","kind":"text"},{"text":"lastRun","kind":"identifier"},{"text":": ","kind":"text"},{"text":"ChangeTick","preciseIdentifier":"s:11WorldModule10ChangeTickV","kind":"typeIdentifier"}],"type":"topic","url":"\/documentation\/worldmodule\/world\/lastrun"},"doc://WorldModule/documentation/WorldModule/World/runConcurrently(_:)":{"abstract":[{"text":"Runs changes at the same time, each on its own copy of the world, and keeps what each one","type":"text"},{"text":" ","type":"text"},{"text":"wrote.","type":"text"}],"kind":"symbol","identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/World\/runConcurrently(_:)","url":"\/documentation\/worldmodule\/world\/runconcurrently(_:)","type":"topic","role":"symbol","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"runConcurrently"},{"kind":"text","text":"(["},{"kind":"typeIdentifier","text":"ConcurrentChange","preciseIdentifier":"s:11WorldModule16ConcurrentChangeV"},{"kind":"text","text":"])"}],"title":"runConcurrently(_:)"},"doc://Systems/documentation/Systems/Schedule/runSerially(on:)":{"identifier":"doc:\/\/Systems\/documentation\/Systems\/Schedule\/runSerially(on:)","kind":"symbol","url":"\/documentation\/systems\/schedule\/runserially(on:)","type":"topic","abstract":[{"text":"Runs each system once on a world, one system at a time.","type":"text"}],"title":"runSerially(on:)","role":"symbol","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"runSerially"},{"kind":"text","text":"("},{"kind":"externalParam","text":"on"},{"kind":"text","text":": "},{"kind":"keyword","text":"inout"},{"kind":"text","text":" "},{"kind":"typeIdentifier","text":"World","preciseIdentifier":"s:11WorldModule0A0V"},{"kind":"text","text":")"}]},"doc://Systems/documentation/Systems":{"abstract":[{"type":"text","text":"Declare the rules of a simulation as systems, and run them on a world in a schedule."}],"type":"topic","title":"Systems","identifier":"doc:\/\/Systems\/documentation\/Systems","url":"\/documentation\/systems","role":"collection","kind":"symbol"},"doc://Systems/documentation/Systems/System/access":{"abstract":[{"text":"The component, resource and event types the system reads and writes, or ","type":"text"},{"code":"nil","type":"codeVoice"},{"text":" if it may","type":"text"},{"text":" ","type":"text"},{"text":"change anything.","type":"text"}],"url":"\/documentation\/systems\/system\/access","title":"access","type":"topic","identifier":"doc:\/\/Systems\/documentation\/Systems\/System\/access","role":"symbol","fragments":[{"text":"var","kind":"keyword"},{"text":" ","kind":"text"},{"text":"access","kind":"identifier"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:11WorldModule6AccessV","text":"Access","kind":"typeIdentifier"},{"text":"?","kind":"text"}],"required":true,"defaultImplementations":1,"kind":"symbol"},"doc://Systems/documentation/Systems/Schedule/systems":{"url":"\/documentation\/systems\/schedule\/systems","type":"topic","kind":"symbol","fragments":[{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"systems","kind":"identifier"},{"text":": [","kind":"text"},{"text":"ScheduledSystem","preciseIdentifier":"s:7Systems15ScheduledSystemV","kind":"typeIdentifier"},{"text":"]","kind":"text"}],"identifier":"doc:\/\/Systems\/documentation\/Systems\/Schedule\/systems","title":"systems","abstract":[{"type":"text","text":"The schedule’s systems, in the order they run."}],"role":"symbol"},"doc://Systems/documentation/Systems/MainActorSystem":{"abstract":[{"type":"text","text":"A system that runs on the main actor, for work that touches main-actor state such as a user"},{"type":"text","text":" "},{"type":"text","text":"interface."}],"type":"topic","title":"MainActorSystem","identifier":"doc:\/\/Systems\/documentation\/Systems\/MainActorSystem","url":"\/documentation\/systems\/mainactorsystem","role":"symbol","fragments":[{"text":"protocol","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MainActorSystem","kind":"identifier"}],"kind":"symbol","navigatorTitle":[{"text":"MainActorSystem","kind":"identifier"}]},"doc://Systems/documentation/Systems/Schedule/run(on:)":{"abstract":[{"type":"text","text":"Runs each system once on a world, running systems that don’t depend on each other at the"},{"type":"text","text":" "},{"type":"text","text":"same time."}],"url":"\/documentation\/systems\/schedule\/run(on:)","kind":"symbol","type":"topic","identifier":"doc:\/\/Systems\/documentation\/Systems\/Schedule\/run(on:)","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"run"},{"kind":"text","text":"("},{"kind":"externalParam","text":"on"},{"kind":"text","text":": "},{"kind":"keyword","text":"inout"},{"kind":"text","text":" "},{"kind":"typeIdentifier","text":"World","preciseIdentifier":"s:11WorldModule0A0V"},{"kind":"text","text":")"}],"role":"symbol","title":"run(on:)"},"doc://Systems/documentation/Systems/System/initialize(in:)":{"required":true,"abstract":[{"text":"Prepares a world for the system before the system first runs on it.","type":"text"}],"kind":"symbol","type":"topic","identifier":"doc:\/\/Systems\/documentation\/Systems\/System\/initialize(in:)","url":"\/documentation\/systems\/system\/initialize(in:)","defaultImplementations":1,"fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"initialize"},{"kind":"text","text":"("},{"kind":"externalParam","text":"in"},{"kind":"text","text":": "},{"kind":"keyword","text":"inout"},{"kind":"text","text":" "},{"kind":"typeIdentifier","preciseIdentifier":"s:11WorldModule0A0V","text":"World"},{"kind":"text","text":")"}],"role":"symbol","title":"initialize(in:)"},"doc://WorldModule/documentation/WorldModule/World":{"type":"topic","url":"\/documentation\/worldmodule\/world","navigatorTitle":[{"kind":"identifier","text":"World"}],"fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"World"}],"identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/World","title":"World","kind":"symbol","abstract":[{"type":"text","text":"A collection of entities, the components they hold, and resources."}],"role":"symbol"}}}