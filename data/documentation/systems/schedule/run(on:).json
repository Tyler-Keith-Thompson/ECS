{"hierarchy":{"paths":[["doc:\/\/Systems\/documentation\/Systems","doc:\/\/Systems\/documentation\/Systems\/Schedule"]]},"schemaVersion":{"minor":3,"patch":0,"major":0},"kind":"symbol","sections":[],"primaryContentSections":[{"declarations":[{"languages":["swift"],"platforms":["Linux"],"tokens":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"run"},{"kind":"text","text":"("},{"kind":"externalParam","text":"on"},{"kind":"text","text":" "},{"kind":"internalParam","text":"world"},{"kind":"text","text":": "},{"kind":"keyword","text":"inout"},{"kind":"text","text":" "},{"preciseIdentifier":"s:11WorldModule0A0V","kind":"typeIdentifier","identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/World","text":"World"},{"kind":"text","text":")"}]}],"kind":"declarations"},{"content":[{"anchor":"discussion","level":2,"text":"Discussion","type":"heading"},{"inlineContent":[{"type":"text","text":"Before each system, the world’s change tick advances and its "},{"code":"WorldModule\/World\/lastRun","type":"codeVoice"},{"type":"text","text":" "},{"type":"text","text":"is set to the tick of that system’s previous run, so filters such as"},{"type":"text","text":" "},{"code":".changed(Position.self)","type":"codeVoice"},{"type":"text","text":" show the system what changed since then: changes made by the"},{"type":"text","text":" "},{"type":"text","text":"systems after it on the previous run and before it on this one, but not its own. A system"},{"type":"text","text":" "},{"type":"text","text":"that has not run on this world before sees every component as added and changed. A"},{"type":"text","text":" "},{"type":"text","text":"skipped system has not run: the next time it runs, it sees everything since it last did."}],"type":"paragraph"},{"inlineContent":[{"text":"The tick advances once more after the last system, so changes made to the world between","type":"text"},{"text":" ","type":"text"},{"text":"runs are newer than every system’s previo