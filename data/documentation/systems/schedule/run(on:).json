:["Linux"]}],"kind":"declarations"},{"content":[{"text":"Discussion","anchor":"discussion","type":"heading","level":2},{"type":"paragraph","inlineContent":[{"type":"text","text":"Before each system, the world’s change tick advances and its "},{"code":"WorldModule\/World\/lastRun","type":"codeVoice"},{"type":"text","text":" "},{"type":"text","text":"is set to the tick of that system’s previous run, so filters such as"},{"type":"text","text":" "},{"code":".changed(Position.self)","type":"codeVoice"},{"type":"text","text":" show the system what changed since then: changes made by the"},{"type":"text","text":" "},{"type":"text","text":"systems after it on the previous run and before it on this one, but not its own. A system"},{"type":"text","text":" "},{"type":"text","text":"that has not run on this world before sees every component as added and changed. A"},{"type":"text","text":" "},{"type":"text","text":"skipped system has not run: the next time it runs, it sees everything since it last did."}]},{"type":"paragraph","inlineContent":[{"text":"The tick advances once more after the last system, so changes made to the world between","type":"text"},{"text":" ","type":"text"},{"text":"runs are newer than every system’s previous run.","type":"text"}]}],"kind":"content"}],"references":{"doc://Systems/documentation/Systems/Schedule/run(on:)":{"fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"run","kind":"identifier"},{"text":"(","kind":"text"},{"text":"on","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"inout","kind":"keyword"},{"text":" ","kind":"text"},{"text":"World","kind":"typeIdentifier","preciseIdentifier":"s:11WorldModule0A0V"},{"text":")","kind":"text"}],"abstract":[{"type":"text","text":"Runs every system once on "},{"type":"codeVoice","code":"world"},{"type":"text","text":", in order, skipping those whose conditions do not hold"},{"type":"text","text":" "},{"type":"text","text":"for the world just before their turn."}],"r