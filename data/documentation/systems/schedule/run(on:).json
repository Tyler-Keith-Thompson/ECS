{"metadata":{"symbolKind":"method","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"run"},{"kind":"text","text":"("},{"kind":"externalParam","text":"on"},{"kind":"text","text":": "},{"kind":"keyword","text":"inout"},{"kind":"text","text":" "},{"kind":"typeIdentifier","preciseIdentifier":"s:11WorldModule0A0V","text":"World"},{"kind":"text","text":")"}],"remoteSource":{"url":"https:\/\/github.com\/Tyler-Keith-Thompson\/ECS\/blob\/main\/Sources\/Systems\/Schedule.swift#L162","fileName":"Schedule.swift"},"title":"run(on:)","roleHeading":"Instance Method","role":"symbol","externalID":"s:7Systems8ScheduleV3run2ony11WorldModule0E0Vz_tF","modules":[{"name":"Systems"}]},"kind":"symbol","hierarchy":{"paths":[["doc:\/\/Systems\/documentation\/Systems","doc:\/\/Systems\/documentation\/Systems\/Schedule"]]},"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/Systems\/documentation\/Systems\/Schedule\/run(on:)"},"sections":[],"primaryContentSections":[{"declarations":[{"tokens":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"run","kind":"identifier"},{"text":"(","kind":"text"},{"text":"on","kind":"externalParam"},{"text":" ","kind":"text"},{"text":"world","kind":"internalParam"},{"text":": ","kind":"text"},{"text":"inout","kind":"keyword"},{"text":" ","kind":"text"},{"text":"World","kind":"typeIdentifier","identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/World","preciseIdentifier":"s:11WorldModule0A0V"},{"text":")","kind":"text"}],"languages":["swift"],"platforms":["Linux"]}],"kind":"declarations"},{"content":[{"type":"heading","anchor":"discussion","level":2,"text":"Discussion"},{"inlineContent":[{"text":"A system depends on the systems before it that it must run after, by an ","type":"text"},{"type":"codeVoice","code":"after"},{"text":" or","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"before"},{"text":" constraint, and on those it conflicts with: one writes what the other reads or","type":"text"},{"text":" ","type":"text"},{"text":"writes, or either has no ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/Systems\/documentation\/Systems\/System\/access"},{"text":". The systems run in waves: each wave holds the","type":"text"},{"text":" ","type":"text"},{"text":"systems whose dependencies all ran in earlier waves, and runs them with","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"WorldModule\/World\/runConcurrently(_:)"},{"text":". A system without an access runs alone. The world","type":"text"},{"text":" ","type":"text"},{"text":"ends as it would running the systems one after another in order.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"At the start of each wave, every condition of its systems is checked, so a condition reads"},{"type":"text","text":" "},{"type":"text","text":"only what its system’s access lists, and the world’s change tick advances. Each system’s"},{"type":"text","text":" "},{"code":"WorldModule\/World\/lastRun","type":"codeVoice"},{"type":"text","text":" is the tick of its previous run, so filters such as"},{"type":"text","text":" "},{"code":".changed(Position.self)","type":"codeVoice"},{"type":"text","text":" show it what changed since then: changes made by the systems"},{"type":"text","text":" "},{"type":"text","text":"after it on the previous run and before it on this one, but not its own. A system that has"},{"type":"text","text":" "},{"type":"text","text":"not run on this world before sees every component as added and changed. A skipped system"},{"type":"text","text":" "},{"type":"text","text":"has not run: the next time it runs, it sees everything since it last did."}],"type":"paragraph"},{"inlineContent":[{"text":"Before the first wave, each system that has not run on this world is initialized","type":"text"},{"text":" ","type":"text"},{"text":"(","type":"text"},{"type":"reference","identifier":"doc:\/\/Systems\/documentation\/Systems\/System\/initialize(in:)","isActive":true},{"text":").","type":"text"}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"Command buffers the wave’s systems queue ("},{"type":"codeVoice","code":"WorldModule\/World\/queue(_:)"},{"type":"text","text":") apply at the end"},{"type":"text","text":" "},{"type":"text","text":"of the wave, in the order the systems run. The tick advances once more after the last wave,"},{"type":"text","text":" "},{"type":"text","text":"so changes made to the world between runs are newer than every system’s previous run."}],"type":"paragraph"},{"type":"aside","style":"note","name":"Precondition","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Every system with an access reads and writes only what it lists; see"},{"type":"text","text":" "},{"code":"WorldModule\/World\/runConcurrently(_:)","type":"codeVoice"},{"type":"text","text":"."}]}]}],"kind":"content"}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/systems\/schedule\/run(on:)"]}],"schemaVersion":{"major":0,"minor":3,"patch":0},"abstract":[{"type":"text","text":"Runs every system once on "},{"code":"world","type":"codeVoice"},{"type":"text","text":", running systems that do not depend on each other at the"},{"type":"text","text":" "},{"type":"text","text":"same time."}],"references":{"doc://WorldModule/documentation/WorldModule/World":{"navigatorTitle":[{"text":"World","kind":"identifier"}],"fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"World","kind":"identifier"}],"kind":"symbol","role":"symbol","abstract":[{"type":"text","text":"Entities, the components they hold, and the world’s resources."}],"url":"\/documentation\/worldmodule\/world","title":"World","type":"topic","identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/World"},"doc://Systems/documentation/Systems":{"url":"\/documentation\/systems","identifier":"doc:\/\/Systems\/documentation\/Systems","type":"topic","kind":"symbol","title":"Systems","role":"collection","abstract":[{"type":"text","text":"Rules that run on a world, in the order written unless constrained otherwise."}]},"doc://Systems/documentation/Systems/System/initialize(in:)":{"kind":"symbol","required":true,"identifier":"doc:\/\/Systems\/documentation\/Systems\/System\/initialize(in:)","title":"initialize(in:)","abstract":[{"text":"Prepares ","type":"text"},{"type":"codeVoice","code":"world"},{"text":" for the system, before its first run on it: a schedule calls this","type":"text"},{"text":" ","type":"text"},{"text":"before the wave the system first runs in, outside any concurrent run. Nothing, by default.","type":"text"}],"defaultImplementations":1,"url":"\/documentation\/systems\/system\/initialize(in:)","type":"topic","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"initialize"},{"kind":"text","text":"("},{"kind":"externalParam","text":"in"},{"kind":"text","text":": "},{"kind":"keyword","text":"inout"},{"kind":"text","text":" "},{"preciseIdentifier":"s:11WorldModule0A0V","kind":"typeIdentifier","text":"World"},{"kind":"text","text":")"}],"role":"symbol"},"doc://Systems/documentation/Systems/Schedule":{"navigatorTitle":[{"text":"Schedule","kind":"identifier"}],"fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Schedule","kind":"identifier"}],"kind":"symbol","role":"symbol","abstract":[{"text":"Systems that run on a world, as though in the order written, at the same time where they can.","type":"text"}],"url":"\/documentation\/systems\/schedule","title":"Schedule","identifier":"doc:\/\/Systems\/documentation\/Systems\/Schedule","type":"topic"},"doc://Systems/documentation/Systems/Schedule/run(on:)":{"kind":"symbol","title":"run(on:)","identifier":"doc:\/\/Systems\/documentation\/Systems\/Schedule\/run(on:)","abstract":[{"text":"Runs every system once on ","type":"text"},{"type":"codeVoice","code":"world"},{"text":", running systems that do not depend on each other at the","type":"text"},{"text":" ","type":"text"},{"text":"same time.","type":"text"}],"url":"\/documentation\/systems\/schedule\/run(on:)","type":"topic","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"text":"run","kind":"identifier"},{"text":"(","kind":"text"},{"text":"on","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"inout","kind":"keyword"},{"text":" ","kind":"text"},{"preciseIdentifier":"s:11WorldModule0A0V","text":"World","kind":"typeIdentifier"},{"kind":"text","text":")"}],"role":"symbol"},"doc://Systems/documentation/Systems/System/access":{"identifier":"doc:\/\/Systems\/documentation\/Systems\/System\/access","fragments":[{"text":"var","kind":"keyword"},{"text":" ","kind":"text"},{"text":"access","kind":"identifier"},{"text":": ","kind":"text"},{"text":"Access","preciseIdentifier":"s:11WorldModule6AccessV","kind":"typeIdentifier"},{"text":"?","kind":"text"}],"defaultImplementations":1,"abstract":[{"text":"What the system reads and writes, so ","type":"text"},{"isActive":true,"identifier":"doc:\/\/Systems\/documentation\/Systems\/Schedule\/run(on:)","type":"reference"},{"text":" can run it alongside","type":"text"},{"text":" ","type":"text"},{"text":"systems it does not conflict with; nil, the default, when it may change anything and must","type":"text"},{"text":" ","type":"text"},{"text":"run alone.","type":"text"}],"kind":"symbol","url":"\/documentation\/systems\/system\/access","role":"symbol","required":true,"type":"topic","title":"access"}}}