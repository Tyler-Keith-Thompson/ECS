{"primaryContentSections":[{"kind":"declarations","declarations":[{"tokens":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"SystemProfile"}],"platforms":["Linux"],"languages":["swift"]}]},{"kind":"content","content":[{"type":"heading","text":"Overview","anchor":"overview","level":2},{"type":"paragraph","inlineContent":[{"type":"text","text":"Insert a profile into a world to find out where a schedule spends its time. Every schedule"},{"type":"text","text":" "},{"type":"text","text":"that runs on the world then records each system’s runs in it:"}]},{"type":"codeListing","code":["var world = World()","world.resources.insert(SystemProfile())","world.spawn(Position(x: 0, y: 100), Velocity(dx: 0, dy: 0))","","let frame = Schedule {","    Gravity()","    Movement().after(Gravity.self)","}","frame.run(on: &world)","frame.run(on: &world)","","let timings = world.resources[SystemProfile.self].timings","print(timings.map(\\.name))","\/\/ Prints \"[\"Gravity\", \"Movement\"]\"","print(timings.map(\\.runs))","\/\/ Prints \"[2, 2]\""],"syntax":"swift"},{"type":"paragraph","inlineContent":[{"text":"Each ","type":"text"},{"isActive":true,"identifier":"doc:\/\/Systems\/documentation\/Systems\/SystemTiming","type":"reference"},{"text":" also holds the total, average, longest and latest time of the system’s","type":"text"},{"text":" ","type":"text"},{"text":"runs.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"A run’s time covers the system’s own work, measured on a continuous clock: not its","type":"text"},{"text":" ","type":"text"},{"text":"conditions, nor the commands it queued, which apply after its wave. A system its conditions","type":"text"},{"text":" ","type":"text"},{"text":"skip doesn’t run, so nothing is recorded for it. Systems in the same wave run at the same","type":"text"},{"text":" ","type":"text"},{"text":"time, so their times can add up to more than the wave took. Insert a new profile to start","type":"text"},{"text":" ","type":"text"},{"text":"over.","type":"text"}]}]}],"relationshipsSections":[{"identifiers":["doc:\/\/WorldModule\/documentation\/WorldModule\/Resource","doc:\/\/Systems\/s8SendableP","doc:\/\/Systems\/s16SendableMetatypeP"],"kind":"relationships","type":"conformsTo","title":"Conforms To"}],"schemaVersion":{"patch":0,"minor":3,"major":0},"metadata":{"remoteSource":{"fileName":"Profiling.swift","url":"https:\/\/github.com\/Tyler-Keith-Thompson\/ECS\/blob\/main\/Sources\/Systems\/Profiling.swift#L77"},"modules":[{"name":"Systems"}],"role":"symbol","navigatorTitle":[{"text":"SystemProfile","kind":"identifier"}],"fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"SystemProfile","kind":"identifier"}],"title":"SystemProfile","roleHeading":"Structure","externalID":"s:7Systems13SystemProfileV","symbolKind":"struct"},"kind":"symbol","seeAlsoSections":[{"identifiers":["doc:\/\/Systems\/documentation\/Systems\/SystemTiming"],"generated":true,"anchor":"Profiling","title":"Profiling"}],"hierarchy":{"paths":[["doc:\/\/Systems\/documentation\/Systems"]]},"sections":[],"abstract":[{"type":"text","text":"A resource that records how long each system takes to run."}],"topicSections":[{"identifiers":["doc:\/\/Systems\/documentation\/Systems\/SystemProfile\/init()"],"generated":true,"anchor":"Initializers","title":"Initializers"},{"identifiers":["doc:\/\/Systems\/documentation\/Systems\/SystemProfile\/timings"],"generated":true,"anchor":"Instance-Properties","title":"Instance Properties"}],"identifier":{"url":"doc:\/\/Systems\/documentation\/Systems\/SystemProfile","interfaceLanguage":"swift"},"variants":[{"paths":["\/documentation\/systems\/systemprofile"],"traits":[{"interfaceLanguage":"swift"}]}],"references":{"doc://Systems/documentation/Systems/SystemProfile":{"url":"\/documentation\/systems\/systemprofile","kind":"symbol","role":"symbol","navigatorTitle":[{"text":"SystemProfile","kind":"identifier"}],"fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"SystemProfile","kind":"identifier"}],"type":"topic","abstract":[{"text":"A resource that records how long each system takes to run.","type":"text"}],"title":"SystemProfile","identifier":"doc:\/\/Systems\/documentation\/Systems\/SystemProfile"},"doc://Systems/documentation/Systems/SystemTiming":{"url":"\/documentation\/systems\/systemtiming","identifier":"doc:\/\/Systems\/documentation\/Systems\/SystemTiming","title":"SystemTiming","kind":"symbol","abstract":[{"type":"text","text":"The times one system of a schedule has taken to run."}],"fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"SystemTiming","kind":"identifier"}],"navigatorTitle":[{"text":"SystemTiming","kind":"identifier"}],"role":"symbol","type":"topic"},"doc://Systems/documentation/Systems/SystemProfile/init()":{"abstract":[{"type":"text","text":"Creates an empty profile."}],"url":"\/documentation\/systems\/systemprofile\/init()","identifier":"doc:\/\/Systems\/documentation\/Systems\/SystemProfile\/init()","type":"topic","role":"symbol","kind":"symbol","title":"init()","fragments":[{"kind":"identifier","text":"init"},{"kind":"text","text":"()"}]},"doc://WorldModule/documentation/WorldModule/Resource":{"navigatorTitle":[{"text":"Resource","kind":"identifier"}],"role":"symbol","type":"topic","url":"\/documentation\/worldmodule\/resource","title":"Resource","kind":"symbol","abstract":[{"type":"text","text":"A type that a world can hold a single value of, outside any entity."}],"identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/Resource","fragments":[{"text":"protocol","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Resource","kind":"identifier"}]},"doc://Systems/documentation/Systems":{"identifier":"doc:\/\/Systems\/documentation\/Systems","type":"topic","role":"collection","abstract":[{"text":"Declare the rules of a simulation as systems, and run them on a world in a schedule.","type":"text"}],"url":"\/documentation\/systems","kind":"symbol","title":"Systems"},"doc://Systems/s8SendableP":{"type":"unresolvable","identifier":"doc:\/\/Systems\/s8SendableP","title":"Swift.Sendable"},"doc://Systems/documentation/Systems/SystemProfile/timings":{"abstract":[{"text":"The timing of each system that has run, in the order the systems first ran.","type":"text"}],"identifier":"doc:\/\/Systems\/documentation\/Systems\/SystemProfile\/timings","title":"timings","role":"symbol","url":"\/documentation\/systems\/systemprofile\/timings","fragments":[{"kind":"keyword","text":"var"},{"kind":"text","text":" "},{"kind":"identifier","text":"timings"},{"kind":"text","text":": ["},{"kind":"typeIdentifier","preciseIdentifier":"s:7Systems12SystemTimingV","text":"SystemTiming"},{"kind":"text","text":"]"}],"type":"topic","kind":"symbol"},"doc://Systems/s16SendableMetatypeP":{"type":"unresolvable","identifier":"doc:\/\/Systems\/s16SendableMetatypeP","title":"Swift.SendableMetatype"}}}