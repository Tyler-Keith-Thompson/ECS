{"metadata":{"title":"SystemProfile","role":"symbol","navigatorTitle":[{"kind":"identifier","text":"SystemProfile"}],"roleHeading":"Structure","remoteSource":{"url":"https:\/\/github.com\/Tyler-Keith-Thompson\/ECS\/blob\/main\/Sources\/Systems\/Profiling.swift#L77","fileName":"Profiling.swift"},"fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"SystemProfile","kind":"identifier"}],"symbolKind":"struct","modules":[{"name":"Systems"}],"externalID":"s:7Systems13SystemProfileV"},"hierarchy":{"paths":[["doc:\/\/Systems\/documentation\/Systems"]]},"abstract":[{"type":"text","text":"A resource that records how long each system takes to run."}],"topicSections":[{"anchor":"Initializers","generated":true,"identifiers":["doc:\/\/Systems\/documentation\/Systems\/SystemProfile\/init()"],"title":"Initializers"},{"anchor":"Instance-Properties","generated":true,"identifiers":["doc:\/\/Systems\/documentation\/Systems\/SystemProfile\/timings"],"title":"Instance Properties"}],"primaryContentSections":[{"kind":"declarations","declarations":[{"platforms":["Linux"],"languages":["swift"],"tokens":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"SystemProfile"}]}]},{"kind":"content","content":[{"text":"Overview","level":2,"anchor":"overview","type":"heading"},{"inlineContent":[{"type":"text","text":"Insert a profile into a world to find out where a schedule spends its time. Every schedule"},{"type":"text","text":" "},{"type":"text","text":"that runs on the world then records each system’s runs in it:"}],"type":"paragraph"},{"syntax":"swift","type":"codeListing","code":["var world = World()","world.resources.insert(SystemProfile())","world.spawn(Position(x: 0, y: 100), Velocity(dx: 0, dy: 0))","","let frame = Schedule {","    Gravity()","    Movement().after(Gravity.self)","}","frame.run(on: &world)","frame.run(on: &world)","","let timings = world.resources[SystemProfile.self].timings","print(timings.map(\\.name))","\/\/ Prints \"[\"Gravity\", \"Movement\"]\"","print(timings.map(\\.runs))","\/\/ Prints \"[2, 2]\""]},{"inlineContent":[{"type":"text","text":"Each "},{"type":"reference","isActive":true,"identifier":"doc:\/\/Systems\/documentation\/Systems\/SystemTiming"},{"type":"text","text":" also holds the total, average, longest and latest time of the system’s"},{"type":"text","text":" "},{"type":"text","text":"runs."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"A run’s time covers the system’s own work, measured on a continuous clock: not its"},{"type":"text","text":" "},{"type":"text","text":"conditions, nor the commands it queued, which apply after its wave. A system its conditions"},{"type":"text","text":" "},{"type":"text","text":"skip doesn’t run, so nothing is recorded for it. Systems in the same wave run at the same"},{"type":"text","text":" "},{"type":"text","text":"time, so their times can add up to more than the wave took. Insert a new profile to start"},{"type":"text","text":" "},{"type":"text","text":"over."}],"type":"paragraph"}]}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/systems\/systemprofile"]}],"kind":"symbol","identifier":{"url":"doc:\/\/Systems\/documentation\/Systems\/SystemProfile","interfaceLanguage":"swift"},"relationshipsSections":[{"kind":"relationships","type":"conformsTo","identifiers":["doc:\/\/WorldModule\/documentation\/WorldModule\/Resource","doc:\/\/Systems\/s8SendableP","doc:\/\/Systems\/s16SendableMetatypeP"],"title":"Conforms To"}],"schemaVersion":{"patch":0,"minor":3,"major":0},"seeAlsoSections":[{"anchor":"Profiling","generated":true,"identifiers":["doc:\/\/Systems\/documentation\/Systems\/SystemTiming"],"title":"Profiling"}],"sections":[],"references":{"doc://Systems/documentation/Systems":{"identifier":"doc:\/\/Systems\/documentation\/Systems","type":"topic","url":"\/documentation\/systems","abstract":[{"type":"text","text":"Declare the rules of a simulation as systems, and run t