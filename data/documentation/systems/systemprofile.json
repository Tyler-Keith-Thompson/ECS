{"metadata":{"fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"SystemProfile","kind":"identifier"}],"remoteSource":{"url":"https:\/\/github.com\/Tyler-Keith-Thompson\/ECS\/blob\/main\/Sources\/Systems\/Profiling.swift#L77","fileName":"Profiling.swift"},"externalID":"s:7Systems13SystemProfileV","navigatorTitle":[{"kind":"identifier","text":"SystemProfile"}],"roleHeading":"Structure","symbolKind":"struct","role":"symbol","modules":[{"name":"Systems"}],"title":"SystemProfile"},"hierarchy":{"paths":[["doc:\/\/Systems\/documentation\/Systems"]]},"abstract":[{"type":"text","text":"A resource that records how long each system takes to run."}],"kind":"symbol","variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/systems\/systemprofile"]}],"relationshipsSections":[{"title":"Conforms To","kind":"relationships","type":"conformsTo","identifiers":["doc:\/\/WorldModule\/documentation\/WorldModule\/Resource","doc:\/\/Systems\/s8SendableP","doc:\/\/Systems\/s16SendableMetatypeP"]}],"seeAlsoSections":[{"title":"Profiling","generated":true,"anchor":"Profiling","identifiers":["doc:\/\/Systems\/documentation\/Systems\/SystemTiming"]}],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/Systems\/documentation\/Systems\/SystemProfile"},"schemaVersion":{"major":0,"minor":3,"patch":0},"primaryContentSections":[{"kind":"declarations","declarations":[{"platforms":["Linux"],"languages":["swift"],"tokens":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"SystemProfile","kind":"identifier"}]}]},{"content":[{"type":"heading","level":2,"anchor":"overview","text":"Overview"},{"type":"paragraph","inlineContent":[{"text":"Insert a profile into a world to find out where a schedule spends its time. Every schedule","type":"text"},{"text":" ","type":"text"},{"text":"that runs on the world then records each system’s runs in it:","type":"text"}]},{"type":"codeListing","syntax":"swift","code":["var world = World()","world.resources.insert(SystemProfile())","world.spawn(Position(x: 0, y: 100), Velocity(dx: 0, dy: 0))","","let frame = Schedule {","    Gravity()","    Movement().after(Gravity.self)","}","frame.run(on: &world)","frame.run(on: &world)","","let timings = world.resources[SystemProfile.self].timings","print(timings.map(\\.name))","\/\/ Prints \"[\"Gravity\", \"Movement\"]\"","print(timings.map(\\.runs))","\/\/ Prints \"[2, 2]\""]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Each "},{"identifier":"doc:\/\/Systems\/documentation\/Systems\/SystemTiming","isActive":true,"type":"reference"},{"type":"text","text":" also holds the total, average, longest and latest time of the system’s"},{"type":"text","text":" "},{"type":"text","text":"runs."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"A run’s time covers the system’s own work, measured on a continuous clock: not its"},{"type":"text","text":" "},{"type":"text","text":"conditions, nor the commands it queued, which apply after its wave. A system its conditions"},{"type":"text","text":" "},{"type":"text","text":"skip doesn’t run, so nothing is recorded for it. Systems in the same wave run at the same"},{"type":"text","text":" "},{"type":"text","text":"time, so their times can add up to more than the wave took. Insert a new profile to start"},{"type":"text","text":" "},{"type":"text","text":"over."}]}],"kind":"content"}],"sections":[],"topicSections":[{"title":"Initializers","generated":true,"anchor":"Initializers","identifiers":["doc:\/\/Systems\/documentation\/Systems\/SystemProfile\/init()"]},{"title":"Instance Properties","generated":true,"anchor":"Instance-Properties","identifiers":["doc:\/\/Systems\/documentation\/Systems\/SystemProfile\/timings"]}],"references":{"doc://Systems/s16SendableMetatypeP":{"title":"Swift.SendableMetatype","type":"unresolvable","identifier":"doc:\/\/Systems\/s16SendableMetatypeP"},"doc://Systems/documentation/Systems":{"abstract":[{"type":"text","text":"Declare the rules of a simulation as systems, and run them on a world in a schedule."}],"type":"topic","title":"Systems","identifier":"doc:\/\/Systems\/documentation\/Systems","url":"\/documentation\/systems","role":"collection","kind":"symbol"},"doc://Systems/s8SendableP":{"title":"Swift.Sendable","identifier":"doc:\/\/Systems\/s8SendableP","type":"unresolvable"},"doc://WorldModule/documentation/WorldModule/Resource":{"identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/Resource","kind":"symbol","url":"\/documentation\/worldmodule\/resource","type":"topic","title":"Resource","abstract":[{"text":"A type that a world can hold a single value of, outside any entity.","type":"text"}],"navigatorTitle":[{"text":"Resource","kind":"identifier"}],"role":"symbol","fragments":[{"text":"protocol","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Resource","kind":"identifier"}]},"doc://Systems/documentation/Systems/SystemProfile/init()":{"identifier":"doc:\/\/Systems\/documentation\/Systems\/SystemProfile\/init()","kind":"symbol","url":"\/documentation\/systems\/systemprofile\/init()","type":"topic","abstract":[{"text":"Creates an empty profile.","type":"text"}],"title":"init()","role":"symbol","fragments":[{"kind":"identifier","text":"init"},{"kind":"text","text":"()"}]},"doc://Systems/documentation/Systems/SystemTiming":{"navigatorTitle":[{"kind":"identifier","text":"SystemTiming"}],"abstract":[{"text":"The times one system of a schedule has taken to run.","type":"text"}],"url":"\/documentation\/systems\/systemtiming","kind":"symbol","identifier":"doc:\/\/Systems\/documentation\/Systems\/SystemTiming","type":"topic","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"SystemTiming"}],"role":"symbol","title":"SystemTiming"},"doc://Systems/documentation/Systems/SystemProfile/timings":{"identifier":"doc:\/\/Systems\/documentation\/Systems\/SystemProfile\/timings","kind":"symbol","role":"symbol","title":"timings","abstract":[{"type":"text","text":"The timing of each system that has run, in the order the systems first ran."}],"fragments":[{"text":"var","kind":"keyword"},{"text":" ","kind":"text"},{"text":"timings","kind":"identifier"},{"text":": [","kind":"text"},{"text":"SystemTiming","kind":"typeIdentifier","preciseIdentifier":"s:7Systems12SystemTimingV"},{"text":"]","kind":"text"}],"type":"topic","url":"\/documentation\/systems\/systemprofile\/timings"},"doc://Systems/documentation/Systems/SystemProfile":{"title":"SystemProfile","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"SystemProfile","kind":"identifier"}],"type":"topic","role":"symbol","navigatorTitle":[{"text":"SystemProfile","kind":"identifier"}],"identifier":"doc:\/\/Systems\/documentation\/Systems\/SystemProfile","url":"\/documentation\/systems\/systemprofile","kind":"symbol","abstract":[{"type":"text","text":"A resource that records how long each system takes to run."}]}}}