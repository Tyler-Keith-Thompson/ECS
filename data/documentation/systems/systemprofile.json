{"identifier":{"url":"doc:\/\/Systems\/documentation\/Systems\/SystemProfile","interfaceLanguage":"swift"},"sections":[],"primaryContentSections":[{"declarations":[{"tokens":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"SystemProfile","kind":"identifier"}],"platforms":["Linux"],"languages":["swift"]}],"kind":"declarations"},{"content":[{"text":"Overview","anchor":"overview","level":2,"type":"heading"},{"inlineContent":[{"text":"Insert a profile into a world to find out where a schedule spends its time. Every schedule","type":"text"},{"text":" ","type":"text"},{"text":"that runs on the world then records each system’s runs in it:","type":"text"}],"type":"paragraph"},{"code":["var world = World()","world.resources.insert(SystemProfile())","world.spawn(Position(x: 0, y: 100), Velocity(dx: 0, dy: 0))","","let frame = Schedule {","    Gravity()","    Movement().after(Gravity.self)","}","frame.run(on: &world)","frame.run(on: &world)","","let timings = world.resources[SystemProfile.self].timings","print(timings.map(\\.name))","\/\/ Prints \"[\"Gravity\", \"Movement\"]\"","print(timings.map(\\.runs))","\/\/ Prints \"[2, 2]\""],"syntax":"swift","type":"codeListing"},{"inlineContent":[{"text":"Each ","type":"text"},{"isActive":true,"identifier":"doc:\/\/Systems\/documentation\/Systems\/SystemTiming","type":"reference"},{"text":" also holds the total, average, longest and latest time of the system’s","type":"text"},{"text":" ","type":"text"},{"text":"runs.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"A run’s time covers the system’s own work, measured on a continuous clock: not its"},{"type":"text","text":" "},{"type":"text","text":"conditions, nor the commands it queued, which apply after its wave. A system its conditions"},{"type":"text","text":" "},{"type":"text","text":"skip doesn’t run, so nothing is recorded for it. Systems in the same wave run at the same"},{"type":"text","text":" "},{"type":"text","text":"time, so their times can add up to more than the wave took. Insert a new profile to start"},{"type":"text","text":" "},{"type":"text","text":"over."}],"type":"paragraph"}],"kind":"content"}],"abstract":[{"text":"A resource that records how long each system takes to run.","type":"text"}],"topicSections":[{"title":"Initializers","anchor":"Initializers","identifiers":["doc:\/\/Systems\/documentation\/Systems\/SystemProfile\/init()"],"generated":true},{"title":"Instance Properties","anchor":"Instance-Properties","identifiers":["doc:\/\/Systems\/documentation\/Systems\/SystemProfile\/timings"],"generated":true}],"schemaVersion":{"major":0,"minor":3,"patch":0},"metadata":{"externalID":"s:7Systems13SystemProfileV","title":"SystemProfile","roleHeading":"Structure","role":"symbol","symbolKind":"struct","modules":[{"name":"Systems"}],"navigatorTitle":[{"text":"SystemProfile","kind":"identifier"}],"remoteSource":{"fileName":"Profiling.swift","url":"https:\/\/github.com\/Tyler-Keith-Thompson\/ECS\/blob\/main\/Sources\/Systems\/Profiling.swift#L77"},"fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"SystemProfile","kind":"identifier"}]},"relationshipsSections":[{"type":"conformsTo","title":"Conforms To","identifiers":["doc:\/\/WorldModule\/documentation\/WorldModule\/Resource","doc:\/\/Systems\/s8SendableP","doc:\/\/Systems\/s16SendableMetatypeP"],"kind":"relationships"}],"kind":"symbol","seeAlsoSections":[{"title":"Profiling","anchor":"Profiling","identifiers":["doc:\/\/Systems\/documentation\/Systems\/SystemTiming"],"generated":true}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/systems\/systemprofile"]}],"hierarchy":{"paths":[["doc:\/\/Systems\/documentation\/Systems"]]},"references":{"doc://Systems/documentation/Systems/SystemProfile/timings":{"title":"timings","type":"topic","fragments":[{"text":"var","kind":"keyword"},{"text":" ","kind":"text"},{"text":"timings","kind":"identifier"},{"text":": [","kind":"text"