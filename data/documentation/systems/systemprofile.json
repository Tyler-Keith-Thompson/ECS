{"hierarchy":{"paths":[["doc:\/\/Systems\/documentation\/Systems"]]},"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/systems\/systemprofile"]}],"kind":"symbol","seeAlsoSections":[{"title":"Profiling","identifiers":["doc:\/\/Systems\/documentation\/Systems\/SystemTiming"],"generated":true,"anchor":"Profiling"}],"sections":[],"schemaVersion":{"major":0,"patch":0,"minor":3},"abstract":[{"text":"A resource that records how long each system takes to run.","type":"text"}],"topicSections":[{"title":"Initializers","identifiers":["doc:\/\/Systems\/documentation\/Systems\/SystemProfile\/init()"],"generated":true,"anchor":"Initializers"},{"title":"Instance Properties","identifiers":["doc:\/\/Systems\/documentation\/Systems\/SystemProfile\/timings"],"generated":true,"anchor":"Instance-Properties"}],"identifier":{"url":"doc:\/\/Systems\/documentation\/Systems\/SystemProfile","interfaceLanguage":"swift"},"metadata":{"symbolKind":"struct","title":"SystemProfile","navigatorTitle":[{"text":"SystemProfile","kind":"identifier"}],"externalID":"s:7Systems13SystemProfileV","remoteSource":{"url":"https:\/\/github.com\/Tyler-Keith-Thompson\/ECS\/blob\/main\/Sources\/Systems\/Profiling.swift#L77","fileName":"Profiling.swift"},"fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"SystemProfile"}],"role":"symbol","modules":[{"name":"Systems"}],"roleHeading":"Structure"},"relationshipsSections":[{"title":"Conforms To","identifiers":["doc:\/\/WorldModule\/documentation\/WorldModule\/Resource","doc:\/\/Systems\/s8SendableP","doc:\/\/Systems\/s16SendableMetatypeP"],"type":"conformsTo","kind":"relationships"}],"primaryContentSections":[{"kind":"declarations","declarations":[{"tokens":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"SystemProfile"}],"languages":["swift"],"platforms":["Linux"]}]},{"content":[{"text":"Overview","level":2,"anchor":"overview","type":"heading"},{"type":"paragraph","inlineContent":[{"text":"Insert a profile into a world to find out where a schedule spends its time. Every schedule","type":"text"},{"text":" ","type":"text"},{"text":"that runs on the world then records each system’s runs in it:","type":"text"}]},{"syntax":"swift","type":"codeListing","code":["var world = World()","world.resources.insert(SystemProfile())","world.spawn(Position(x: 0, y: 100), Velocity(dx: 0, dy: 0))","","let frame = Schedule {","    Gravity()","    Movement().after(Gravity.self)","}","frame.run(on: &world)","frame.run(on: &world)","","let timings = world.resources[SystemProfile.self].timings","print(timings.map(\\.name))","\/\/ Prints \"[\"Gravity\", \"Movement\"]\"","print(timings.map(\\.runs))","\/\/ Prints \"[2, 2]\""]},{"type":"paragraph","inlineContent":[{"text":"Each ","type":"text"},{"isActive":true,"identifier":"doc:\/\/Systems\/documentation\/Systems\/SystemTiming","type":"reference"},{"text":" also holds the total, average, longest and latest time of the system’s","type":"text"},{"text":" ","type":"text"},{"text":"runs.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"A run’s time covers the system’s own work, measured on a continuous clock: not its","type":"text"},{"text":" ","type":"text"},{"text":"conditions, nor the commands it queued, which apply after its wave. A system its conditions","type":"text"},{"text":" ","type":"text"},{"text":"skip doesn’t run, so nothing is recorded for it. Systems in the same wave run at the same","type":"text"},{"text":" ","type":"text"},{"text":"time, so their times can add up to more than the wave took. Insert a new profile to start","type":"text"},{"text":" ","type":"text"},{"text":"over.","type":"text"}]}],"kind":"content"}],"references":{"doc://Systems/documentation/Systems":{"url":"\/documentation\/systems","title":"Systems","type":"topic","identifier":"doc:\/\/Systems\/documentation\/Systems","role":"collection","abstract":[{"text":"Declare the rules of a simulation as systems, and run them on a world in a schedule.","type":"text"}],"kind":"symbol"},"doc://Systems/documentation/Systems/SystemTiming":{"navigatorTitle":[{"kind":"identifier","text":"SystemTiming"}],"identifier":"doc:\/\/Systems\/documentation\/Systems\/SystemTiming","kind":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"SystemTiming"}],"url":"\/documentation\/systems\/systemtiming","abstract":[{"type":"text","text":"The times one system of a schedule has taken to run."}],"title":"SystemTiming","role":"symbol","type":"topic"},"doc://Systems/documentation/Systems/SystemProfile/timings":{"fragments":[{"kind":"keyword","text":"var"},{"kind":"text","text":" "},{"kind":"identifier","text":"timings"},{"kind":"text","text":": ["},{"kind":"typeIdentifier","preciseIdentifier":"s:7Systems12SystemTimingV","text":"SystemTiming"},{"kind":"text","text":"]"}],"kind":"symbol","role":"symbol","title":"timings","identifier":"doc:\/\/Systems\/documentation\/Systems\/SystemProfile\/timings","url":"\/documentation\/systems\/systemprofile\/timings","abstract":[{"text":"The timing of each system that has run, in the order the systems first ran.","type":"text"}],"type":"topic"},"doc://WorldModule/documentation/WorldModule/Resource":{"navigatorTitle":[{"text":"Resource","kind":"identifier"}],"identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/Resource","kind":"symbol","fragments":[{"text":"protocol","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Resource","kind":"identifier"}],"url":"\/documentation\/worldmodule\/resource","abstract":[{"type":"text","text":"A type that a world can hold a single value of, outside any entity."}],"title":"Resource","role":"symbol","type":"topic"},"doc://Systems/documentation/Systems/SystemProfile":{"navigatorTitle":[{"text":"SystemProfile","kind":"identifier"}],"identifier":"doc:\/\/Systems\/documentation\/Systems\/SystemProfile","kind":"symbol","fragments":[{"text":"struct"