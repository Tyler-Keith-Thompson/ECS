{"identifier":{"url":"doc:\/\/Systems\/documentation\/Systems\/SystemProfile","interfaceLanguage":"swift"},"kind":"symbol","abstract":[{"type":"text","text":"A resource that records how long each system takes to run."}],"metadata":{"roleHeading":"Structure","title":"SystemProfile","symbolKind":"struct","externalID":"s:7Systems13SystemProfileV","role":"symbol","modules":[{"name":"Systems"}],"fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"SystemProfile"}],"navigatorTitle":[{"text":"SystemProfile","kind":"identifier"}],"remoteSource":{"fileName":"Profiling.swift","url":"https:\/\/github.com\/Tyler-Keith-Thompson\/ECS\/blob\/main\/Sources\/Systems\/Profiling.swift#L77"}},"variants":[{"paths":["\/documentation\/systems\/systemprofile"],"traits":[{"interfaceLanguage":"swift"}]}],"schemaVersion":{"minor":3,"patch":0,"major":0},"topicSections":[{"generated":true,"anchor":"Initializers","title":"Initializers","identifiers":["doc:\/\/Systems\/documentation\/Systems\/SystemProfile\/init()"]},{"generated":true,"anchor":"Instance-Properties","title":"Instance Properties","identifiers":["doc:\/\/Systems\/documentation\/Systems\/SystemProfile\/timings"]}],"seeAlsoSections":[{"generated":true,"anchor":"Profiling","title":"Profiling","identifiers":["doc:\/\/Systems\/documentation\/Systems\/SystemTiming"]}],"hierarchy":{"paths":[["doc:\/\/Systems\/documentation\/Systems"]]},"relationshipsSections":[{"kind":"relationships","title":"Conforms To","type":"conformsTo","identifiers":["doc:\/\/WorldModule\/documentation\/WorldModule\/Resource","doc:\/\/Systems\/s8SendableP","doc:\/\/Systems\/s16SendableMetatypeP"]}],"primaryContentSections":[{"kind":"declarations","declarations":[{"languages":["swift"],"tokens":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"SystemProfile","kind":"identifier"}],"platforms":["Linux"]}]},{"kind":"content","content":[{"text":"Overview","type":"heading","level":2,"anchor":"overview"},{"inlineContent":[{"text":"Insert a profile into a world to find out where a schedule spends its time. Every schedule","type":"text"},{"text":" ","type":"text"},{"text":"that runs on the world then records each system’s runs in it:","type":"text"}],"type":"paragraph"},{"code":["var world = World()","world.resources.insert(SystemProfile())","world.spawn(Position(x: 0, y: 100), Velocity(dx: 0, dy: 0))","","let frame = Schedule {","    Gravity()","    Movement().after(Gravity.self)","}","frame.run(on: &world)","frame.run(on: &world)","","let timings = world.resources[SystemProfile.self].timings","print(timings.map(\\.name))","\/\/ Prints \"[\"Gravity\", \"Movement\"]\"","print(timings.map(\\.runs))","\/\/ Prints \"[2, 2]\""],"type":"codeListing","syntax":"swift"},{"inlineContent":[{"type":"text","text":"Each "},{"identifier":"doc:\/\/Systems\/documentation\/Systems\/SystemTiming","type":"reference","isActive":true},{"type":"text","text":" also holds the total, average, longest and latest time of the system’s"},{"type":"text","text":" "},{"type":"text","text":"runs."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"A run’s time covers the system’s own work, measured on a continuous clock: not its"},{"type":"text","text":" "},{"type":"text","text":"conditions, nor the commands it queued, which apply after its wave. A system its conditions"},{"type":"text","text":" "},{"type":"text","text":"skip doesn’t run, so nothing is recorded for it. Systems in the same wave run at the same"},{"type":"text","text":" "},{"type":"text","text":"time, so their times can add up to more than the wave took. Insert a new profile to start"},{"type":"text","text":" "},{"type":"text","text":"over."}],"type":"paragraph"}]}],"sections":[],"references":{"doc://Systems/documentation/Systems/SystemTiming":{"kind":"symbol","abstract":[{"text":"The times one system of a schedule has taken to run.","type":"text"}],"role":"symbol","type":"topic","identifier":"doc:\/\/Systems\/documentati