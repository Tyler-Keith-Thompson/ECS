{"sections":[],"hierarchy":{"paths":[["doc:\/\/Systems\/documentation\/Systems"]]},"seeAlsoSections":[{"identifiers":["doc:\/\/Systems\/documentation\/Systems\/SystemTiming"],"anchor":"Profiling","title":"Profiling","generated":true}],"metadata":{"fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"SystemProfile"}],"modules":[{"name":"Systems"}],"role":"symbol","roleHeading":"Structure","navigatorTitle":[{"kind":"identifier","text":"SystemProfile"}],"title":"SystemProfile","remoteSource":{"fileName":"Profiling.swift","url":"https:\/\/github.com\/Tyler-Keith-Thompson\/ECS\/blob\/main\/Sources\/Systems\/Profiling.swift#L77"},"symbolKind":"struct","externalID":"s:7Systems13SystemProfileV"},"schemaVersion":{"patch":0,"minor":3,"major":0},"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/Systems\/documentation\/Systems\/SystemProfile"},"topicSections":[{"identifiers":["doc:\/\/Systems\/documentation\/Systems\/SystemProfile\/init()"],"anchor":"Initializers","title":"Initializers","generated":true},{"identifiers":["doc:\/\/Systems\/documentation\/Systems\/SystemProfile\/timings"],"anchor":"Instance-Properties","title":"Instance Properties","generated":true}],"primaryContentSections":[{"declarations":[{"languages":["swift"],"tokens":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"SystemProfile"}],"platforms":["Linux"]}],"kind":"declarations"},{"content":[{"level":2,"type":"heading","text":"Overview","anchor":"overview"},{"inlineContent":[{"type":"text","text":"Insert a profile into a world to find out where a schedule spends its time. Every schedule"},{"type":"text","text":" "},{"type":"text","text":"that runs on the world then records each system’s runs in it:"}],"type":"paragraph"},{"syntax":"swift","code":["var world = World()","world.resources.insert(SystemProfile())","world.spawn(Position(x: 0, y: 100), Velocity(dx: 0, dy: 0))","","let frame = Schedule {","    Gravity()","    Movement().after(Gravity.self)","}","frame.run(on: &world)","frame.run(on: &world)","","let timings = world.resources[SystemProfile.self].timings","print(timings.map(\\.name))","\/\/ Prints \"[\"Gravity\", \"Movement\"]\"","print(timings.map(\\.runs))","\/\/ Prints \"[2, 2]\""],"type":"codeListing"},{"inlineContent":[{"text":"Each ","type":"text"},{"isActive":true,"identifier":"doc:\/\/Systems\/documentation\/Systems\/SystemTiming","type":"reference"},{"text":" also holds the total, average, longest and latest time of the system’s","type":"text"},{"text":" ","type":"text"},{"text":"runs.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"A run’s time covers the system’s own work, measured on a continuous clock: not its"},{"type":"text","text":" "},{"type":"text","text":"conditions, nor the commands it queued, which apply after its wave. A system its conditions"},{"type":"text","text":" "},{"type":"text","text":"skip doesn’t run, so nothing is recorded for it. Systems in the same wave run at the same"},{"type":"text","text":" "},{"type":"text","text":"time, so their times can add up to more than the wave took. Insert a new profile to start"},{"type":"text","text":" "},{"type":"text","text":"over."}],"type":"paragraph"}],"kind":"content"}],"abstract":[{"text":"A resource that records how long each system takes to run.","type":"text"}],"relationshipsSections":[{"type":"conformsTo","kind":"relationships","identifiers":["doc:\/\/WorldModule\/documentation\/WorldModule\/Resource","doc:\/\/Systems\/s8SendableP","doc:\/\/Systems\/s16SendableMetatypeP"],"title":"Conforms To"}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/systems\/systemprofile"]}],"kind":"symbol","references":{"doc://Systems/s8SendableP":{"type":"unresolvable","identifier":"doc:\/\/Systems\/s8SendableP","title":"Swift.Sendable"},"doc://Systems/documentation/Systems/SystemProfile":{"identifier":"doc:\/\/Systems\/documentation\/Systems\/Sys