{"schemaVersion":{"major":0,"minor":3,"patch":0},"metadata":{"fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"SystemProfile"}],"symbolKind":"struct","navigatorTitle":[{"kind":"identifier","text":"SystemProfile"}],"remoteSource":{"url":"https:\/\/github.com\/Tyler-Keith-Thompson\/ECS\/blob\/main\/Sources\/Systems\/Profiling.swift#L77","fileName":"Profiling.swift"},"externalID":"s:7Systems13SystemProfileV","title":"SystemProfile","role":"symbol","modules":[{"name":"Systems"}],"roleHeading":"Structure"},"sections":[],"seeAlsoSections":[{"generated":true,"title":"Profiling","anchor":"Profiling","identifiers":["doc:\/\/Systems\/documentation\/Systems\/SystemTiming"]}],"primaryContentSections":[{"kind":"declarations","declarations":[{"tokens":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"SystemProfile","kind":"identifier"}],"platforms":["Linux"],"languages":["swift"]}]},{"mentions":["doc:\/\/Systems\/documentation\/Systems\/SchedulingSystems"],"kind":"mentions"},{"content":[{"level":2,"type":"heading","anchor":"overview","text":"Overview"},{"inlineContent":[{"type":"text","text":"Insert a profile into a world to find out where a schedule spends its time. Every schedule"},{"type":"text","text":" "},{"type":"text","text":"that runs on the world then records each system’s runs in it:"}],"type":"paragraph"},{"code":["var world = World()","world.resources.insert(SystemProfile())","world.spawn(Position(x: 0, y: 100), Velocity(dx: 0, dy: 0))","","let frame = Schedule {","    Gravity()","    Movement().after(Gravity.self)","}","frame.run(on: &world)","frame.run(on: &world)","","let timings = world.resources[SystemProfile.self].timings","print(timings.map(\\.name))","\/\/ Prints \"[\"Gravity\", \"Movement\"]\"","print(timings.map(\\.runs))","\/\/ Prints \"[2, 2]\""],"type":"codeListing","syntax":"swift"},{"inlineContent":[{"text":"Each ","type":"text"},{"isActive":true,"identifier":"doc:\/\/Systems\/documentation\/Systems\/SystemTiming","type":"reference"},{"text":" also holds the total, average, longest and latest time of the system’s","type":"text"},{"text":" ","type":"text"},{"text":"runs.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"A run’s time covers the system’s own work, measured on a continuous clock: not its"},{"type":"text","text":" "},{"type":"text","text":"conditions, nor the commands it queued, which apply after its wave. A system its conditions"},{"type":"text","text":" "},{"type":"text","text":"skip doesn’t run, so nothing is recorded for it. Systems in the same wave run at the same"},{"type":"text","text":" "},{"type":"text","text":"time, so their times can add up to more than the wave took. Insert a new profile to start"},{"type":"text","text":" "},{"type":"text","text":"over."}],"type":"paragraph"}],"kind":"content"}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/systems\/systemprofile"]}],"topicSections":[{"generated":true,"title":"Initializers","anchor":"Initializers","identifiers":["doc:\/\/Systems\/documentation\/Systems\/SystemProfile\/init()"]},{"generated":true,"title":"Instance Properties","anchor":"Instance-Properties","identifiers":["doc:\/\/Systems\/documentation\/Systems\/SystemProfile\/timings"]}],"relationshipsSections":[{"title":"Conforms To","kind":"relationships","type":"conformsTo","identifiers":["doc:\/\/WorldModule\/documentation\/WorldModule\/Resource","doc:\/\/Systems\/s8SendableP","doc:\/\/Systems\/s16SendableMetatypeP"]}],"kind":"symbol","hierarchy":{"paths":[["doc:\/\/Systems\/documentation\/Systems"]]},"abstract":[{"type":"text","text":"A resource that records how long each system takes to run."}],"identifier":{"url":"doc:\/\/Systems\/documentation\/Systems\/SystemProfile","interfaceLanguage":"swift"},"references":{"doc://Systems/documentation/Systems":{"role":"collection","type":"topic","abstract":[{"type":"text","text":"Declare the rules of a simulation as systems, and run them on a world in a schedule."}],"title":"Systems","kind":"symbol","identifier":"doc:\/\/Systems\/documentation\/Systems","url":"\/documentation\/systems"},"doc://Systems/documentation/Systems/SystemProfile/init()":{"url":"\/documentation\/systems\/systemprofile\/init()","kind":"symbol","fragments":[{"text":"init","kind":"identifier"},{"text":"()","kind":"text"}],"role":"symbol","title":"init()","abstract":[{"type":"text","text":"Creates an empty profile."}],"type":"topic","identifier":"doc:\/\/Systems\/documentation\/Systems\/SystemProfile\/init()"},"doc://Systems/documentation/Systems/SchedulingSystems":{"type":"topic","kind":"article","identifier":"doc:\/\/Systems\/documentation\/Systems\/SchedulingSystems","url":"\/documentation\/systems\/schedulingsystems","role":"article","abstract":[{"text":"Order the systems of a schedule, run them only when a condition holds, and find out how a","type":"text"},{"text":" ","type":"text"},{"text":"schedule runs them.","type":"text"}],"title":"Scheduling Systems"},"doc://Systems/s8SendableP":{"title":"Swift.Sendable","type":"unresolvable","identifier":"doc:\/\/Systems\/s8SendableP"},"doc://WorldModule/documentation/WorldModule/Resource":{"title":"Resource","role":"symbol","identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/Resource","type":"topic","kind":"symbol","url":"\/documentation\/worldmodule\/resource","fragments":[{"kind":"keyword","text":"protocol"},{"kind":"text","text":" "},{"kind":"identifier","text":"Resource"}],"navigatorTitle":[{"kind":"identifier","text":"Resource"}],"abstract":[{"text":"A type that a world can hold a single value of, outside any entity.","type":"text"}]},"doc://Systems/documentation/Systems/SystemProfile":{"url":"\/documentation\/systems\/systemprofile","kind":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"SystemProfile"}],"role":"symbol","title":"SystemProfile","navigatorTitle":[{"kind":"identifier","text":"SystemProfile"}],"abstract":[{"text":"A resource that records how long each system takes to run.","type":"text"}],"type":"topic","identifier":"doc:\/\/Systems\/documentation\/Systems\/SystemProfile"},"doc://Systems/documentation/Systems/SystemTiming":{"type":"topic","abstract":[{"type":"text","text":"The times one system of a schedule has taken to run."}],"kind":"symbol","identifier":"doc:\/\/Systems\/documentation\/Systems\/SystemTiming","role":"symbol","url":"\/documentation\/systems\/systemtiming","navigatorTitle":[{"text":"SystemTiming","kind":"identifier"}],"title":"SystemTiming","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"SystemTiming","kind":"identifier"}]},"doc://Systems/documentation/Systems/SystemProfile/timings":{"title":"timings","role":"symbol","identifier":"doc:\/\/Systems\/documentation\/Systems\/SystemProfile\/timings","type":"topic","kind":"symbol","url":"\/documentation\/systems\/systemprofile\/timings","fragments":[{"kind":"keyword","text":"var"},{"kind":"text","text":" "},{"kind":"identifier","text":"timings"},{"kind":"text","text":": ["},{"kind":"typeIdentifier","text":"SystemTiming","preciseIdentifier":"s:7Systems12SystemTimingV"},{"kind":"text","text":"]"}],"abstract":[{"text":"The timing of each system that has run, in the order the systems first ran.","type":"text"}]},"doc://Systems/s16SendableMetatypeP":{"identifier":"doc:\/\/Systems\/s16SendableMetatypeP","title":"Swift.SendableMetatype","type":"unresolvable"}}}