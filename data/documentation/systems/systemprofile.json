n/Systems/SystemProfile/init()":{"identifier":"doc:\/\/Systems\/documentation\/Systems\/SystemProfile\/init()","title":"init()","role":"symbol","url":"\/documentation\/systems\/systemprofile\/init()","fragments":[{"text":"init","kind":"identifier"},{"text":"()","kind":"text"}],"abstract":[{"text":"Creates an empty profile.","type":"text"}],"type":"topic","kind":"symbol"},"doc://Systems/s16SendableMetatypeP":{"type":"unresolvable","identifier":"doc:\/\/Systems\/s16SendableMetatypeP","title":"Swift.SendableMetatype"},"doc://Systems/documentation/Systems":{"kind":"symbol","url":"\/documentation\/systems","title":"Systems","role":"collection","type":"topic","identifier":"doc:\/\/Systems\/documentation\/Systems","abstract":[{"text":"Declare the rules of a simulation as systems, and run them on a world in a schedule.","type":"text"}]},"doc://Systems/s8SendableP":{"type":"unresolvable","identifier":"doc:\/\/Systems\/s8SendableP","title":"Swift.Sendable"}}}