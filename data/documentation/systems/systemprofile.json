{"metadata":{"role":"symbol","title":"SystemProfile","symbolKind":"struct","roleHeading":"Structure","remoteSource":{"url":"https:\/\/github.com\/Tyler-Keith-Thompson\/ECS\/blob\/main\/Sources\/Systems\/Profiling.swift#L77","fileName":"Profiling.swift"},"fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"SystemProfile","kind":"identifier"}],"navigatorTitle":[{"text":"SystemProfile","kind":"identifier"}],"externalID":"s:7Systems13SystemProfileV","modules":[{"name":"Systems"}]},"hierarchy":{"paths":[["doc:\/\/Systems\/documentation\/Systems"]]},"topicSections":[{"identifiers":["doc:\/\/Systems\/documentation\/Systems\/SystemProfile\/init()"],"generated":true,"anchor":"Initializers","title":"Initializers"},{"identifiers":["doc:\/\/Systems\/documentation\/Systems\/SystemProfile\/timings"],"generated":true,"anchor":"Instance-Properties","title":"Instance Properties"}],"schemaVersion":{"patch":0,"major":0,"minor":3},"kind":"symbol","variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/systems\/systemprofile"]}],"identifier":{"url":"doc:\/\/Systems\/documentation\/Systems\/SystemProfile","interfaceLanguage":"swift"},"sections":[],"abstract":[{"type":"text","text":"A resource that records how long each system takes to run."}],"seeAlsoSections":[{"identifiers":["doc:\/\/Systems\/documentation\/Systems\/SystemTiming"],"generated":true,"anchor":"Profiling","title":"Profiling"}],"relationshipsSections":[{"kind":"relationships","identifiers":["doc:\/\/WorldModule\/documentation\/WorldModule\/Resource","doc:\/\/Systems\/s8SendableP","doc:\/\/Systems\/s16SendableMetatypeP"],"type":"conformsTo","title":"Conforms To"}],"primaryContentSections":[{"kind":"declarations","declarations":[{"platforms":["Linux"],"languages":["swift"],"tokens":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"SystemProfile","kind":"identifier"}]}]},{"kind":"content","content":[{"level":2,"text":"Overview","type":"heading","anchor":"overview"},{"type":"paragraph","inlineContent":[{"text":"Insert a profile into a world to find out where a schedule spends its time. Every schedule","type":"text"},{"text":" ","type":"text"},{"text":"that runs on the world then records each system’s runs in it:","type":"text"}]},{"code":["var world = World()","world.resources.insert(SystemProfile())","world.spawn(Position(x: 0, y: 100), Velocity(dx: 0, dy: 0))","","let frame = Schedule {","    Gravity()","    Movement().after(Gravity.self)","}","frame.run(on: &world)","frame.run(on: &world)","","let timings = world.resources[SystemProfile.self].timings","print(timings.map(\\.name))","\/\/ Prints \"[\"Gravity\", \"Movement\"]\"","print(timings.map(\\.runs))","\/\/ Prints \"[2, 2]\""],"type":"codeListing","syntax":"swift"},{"type":"paragraph","inlineContent":[{"text":"Each ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/Systems\/documentation\/Systems\/SystemTiming"},{"text":" also holds the total, average, longest and latest time of the system’s","type":"text"},{"text":" ","type":"text"},{"text":"runs.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"A run’s time covers the system’s own work, measured on a continuous clock: not its","type":"text"},{"text":" ","type":"text"},{"text":"conditions, nor the commands it queued, which apply after its wave. A system its conditions","type":"text"},{"text":" ","type":"text"},{"text":"skip doesn’t run, so nothing is recorded for it. Systems in the same wave run at the same","type":"text"},{"text":" ","type":"text"},{"text":"time, so their times can add up to more than the wave took. Insert a new profile to start","type":"text"},{"text":" ","type":"text"},{"text":"over.","type":"text"}]}]}],"references":{"doc://Systems/documentation/Systems/SystemProfile/timings":{"title":"timings","role":"symbol","identifier":"doc:\/\/Systems\/documentation\/Systems\/SystemProfile\/timings","type":"topic","fragments":[{"text":"var","kind":"keyword"