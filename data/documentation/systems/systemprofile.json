{"kind":"symbol","metadata":{"modules":[{"name":"Systems"}],"fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"SystemProfile"}],"symbolKind":"struct","title":"SystemProfile","navigatorTitle":[{"text":"SystemProfile","kind":"identifier"}],"roleHeading":"Structure","externalID":"s:7Systems13SystemProfileV","role":"symbol","remoteSource":{"fileName":"Profiling.swift","url":"https:\/\/github.com\/Tyler-Keith-Thompson\/ECS\/blob\/main\/Sources\/Systems\/Profiling.swift#L77"}},"schemaVersion":{"patch":0,"minor":3,"major":0},"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/Systems\/documentation\/Systems\/SystemProfile"},"primaryContentSections":[{"declarations":[{"platforms":["Linux"],"tokens":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"SystemProfile"}],"languages":["swift"]}],"kind":"declarations"},{"content":[{"anchor":"overview","level":2,"text":"Overview","type":"heading"},{"type":"paragraph","inlineContent":[{"text":"Insert a profile into a world to find out where a schedule spends its time. Every schedule","type":"text"},{"text":" ","type":"text"},{"text":"that runs on the world then records each system’s runs in it:","type":"text"}]},{"code":["var world = World()","world.resources.insert(SystemProfile())","world.spawn(Position(x: 0, y: 100), Velocity(dx: 0, dy: 0))","","let frame = Schedule {","    Gravity()","    Movement().after(Gravity.self)","}","frame.run(on: &world)","frame.run(on: &world)","","let timings = world.resources[SystemProfile.self].timings","print(timings.map(\\.name))","\/\/ Prints \"[\"Gravity\", \"Movement\"]\"","print(timings.map(\\.runs))","\/\/ Prints \"[2, 2]\""],"type":"codeListing","syntax":"swift"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Each "},{"isActive":true,"type":"reference","identifier":"doc:\/\/Systems\/documentation\/Systems\/SystemTiming"},{"type":"text","text":" also holds the total, average, longest and latest time of the system’s"},{"type":"text","text":" "},{"type":"text","text":"runs."}]},{"type":"paragraph","inlineContent":[{"text":"A run’s time covers the system’s own work, measured on a continuous clock: not its","type":"text"},{"text":" ","type":"text"},{"text":"conditions, nor the commands it queued, which apply after its wave. A system its conditions","type":"text"},{"text":" ","type":"text"},{"text":"skip doesn’t run, so nothing is recorded for it. Systems in the same wave run at the same","type":"text"},{"text":" ","type":"text"},{"text":"time, so their times can add up to more than the wave took. Insert a new profile to start","type":"text"},{"text":" ","type":"text"},{"text":"over.","type":"text"}]}],"kind":"content"}],"sections":[],"hierarchy":{"paths":[["doc:\/\/Systems\/documentation\/Systems"]]},"relationshipsSections":[{"title":"Conforms To","kind":"relationships","identifiers":["doc:\/\/WorldModule\/documentation\/WorldModule\/Resource","doc:\/\/Systems\/s8SendableP","doc:\/\/Systems\/s16SendableMetatypeP"],"type":"conformsTo"}],"abstract":[{"type":"text","text":"A resource that records how long each system takes to run."}],"seeAlsoSections":[{"title":"Profiling","generated":true,"anchor":"Profiling","identifiers":["doc:\/\/Systems\/documentation\/Systems\/SystemTiming"]}],"variants":[{"paths":["\/documentation\/systems\/systemprofile"],"traits":[{"interfaceLanguage":"swift"}]}],"topicSections":[{"title":"Initializers","generated":true,"anchor":"Initializers","identifiers":["doc:\/\/Systems\/documentation\/Systems\/SystemProfile\/init()"]},{"title":"Instance Properties","generated":true,"anchor":"Instance-Properties","identifiers":["doc:\/\/Systems\/documentation\/Systems\/SystemProfile\/timings"]}],"references":{"doc://Systems/documentation/Systems/SystemProfile/init()":{"title":"init()","fragments":[{"text":"init","kind":"identifier"},{"text":"()","kind":"text"}],"type":"topic","identifier":"doc:\/\/Systems\/documentation\/Systems\/SystemProfile\/init()","abstract":[{"type":"text","text":"Creates an empty profile."}],"role":"symbol","kind":"symbol","url":"\/documentation\/systems\/systemprofile\/init()"},"doc://Systems/documentation/Systems":{"abstract":[{"text":"Declare the rules of a simulation as systems, and run them on a world in a schedule.","type":"text"}],"role":"collection","type":"topic","identifier":"doc:\/\/Systems\/documentation\/Systems","kind":"symbol","title":"Systems","url":"\/documentation\/systems"},"doc://Systems/s16SendableMetatypeP":{"title":"Swift.SendableMetatype","type":"unresolvable","identifier":"doc:\/\/Systems\/s16SendableMetatypeP"},"doc://Systems/documentation/Systems/SystemTiming":{"title":"SystemTiming","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"SystemTiming"}],"url":"\/documentation\/systems\/systemtiming","identifier":"doc:\/\/Systems\/documentation\/Systems\/SystemTiming","type":"topic","navigatorTitle":[{"kind":"identifier","text":"SystemTiming"}],"role":"symbol","kind":"symbol","abstract":[{"type":"text","text":"The times one system of a schedule has taken to run."}]},"doc://Systems/documentation/Systems/SystemProfile/timings":{"title":"timings","fragments":[{"kind":"keyword","text":"var"},{"kind":"text","text":" "},{"kind":"identifier","text":"timings"},{"kind":"text","text":": ["},{"kind":"typeIdentifier","preciseIdentifier":"s:7Systems12SystemTimingV","text":"SystemTiming"},{"kind":"text","text":"]"}],"url":"\/documentation\/systems\/systemprofile\/timings","identifier":"doc:\/\/Systems\/documentation\/Systems\/SystemProfile\/timings","type":"topic","role":"symbol","kind":"symbol","abstract":[{"type":"text","text":"The timing of each system that has run, in the order the systems first ran."}]},"doc://Systems/s8SendableP":{"title":"Swift.Sendable","identifier":"doc:\/\/Systems\/s8SendableP","type":"unresolvable"},"doc://Systems/documentation/Systems/SystemProfile":{"title":"SystemProfile","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"SystemProfile"}],"url":"\/documentation\/systems\/systemprofile","identifier":"doc:\/\/Systems\/documentation\/Systems\/SystemProfile","type":"topic","navigatorTitle":[{"kind":"identifier","text":"SystemProfile"}],"role":"symbol","kind":"symbol","abstract":[{"type":"text","text":"A resource that records how long each system takes to run."}]},"doc://WorldModule/documentation/WorldModule/Resource":{"title":"Resource","type":"topic","fragments":[{"kind":"keyword","text":"protocol"},{"kind":"text","text":" "},{"kind":"identifier","text":"Resource"}],"role":"symbol","kind":"symbol","identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/Resource","url":"\/documentation\/worldmodule\/resource","navigatorTitle":[{"kind":"identifier","text":"Resource"}],"abstract":[{"text":"A type that a world can hold a single value of, outside any entity.","type":"text"}]}}}