{"primaryContentSections":[{"declarations":[{"platforms":["Linux"],"tokens":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"SystemProfile","kind":"identifier"}],"languages":["swift"]}],"kind":"declarations"},{"content":[{"text":"Overview","type":"heading","anchor":"overview","level":2},{"type":"paragraph","inlineContent":[{"text":"Insert a profile into a world to find out where a schedule spends its time. Every schedule","type":"text"},{"text":" ","type":"text"},{"text":"that runs on the world then records each system’s runs in it:","type":"text"}]},{"type":"codeListing","syntax":"swift","code":["var world = World()","world.resources.insert(SystemProfile())","world.spawn(Position(x: 0, y: 100), Velocity(dx: 0, dy: 0))","","let frame = Schedule {","    Gravity()","    Movement().after(Gravity.self)","}","frame.run(on: &world)","frame.run(on: &world)","","let timings = world.resources[SystemProfile.self].timings","print(timings.map(\\.name))","\/\/ Prints \"[\"Gravity\", \"Movement\"]\"","print(timings.map(\\.runs))","\/\/ Prints \"[2, 2]\""]},{"type":"paragraph","inlineContent":[{"text":"Each ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/Systems\/documentation\/Systems\/SystemTiming"},{"text":" also holds the total, average, longest and latest time of the system’s","type":"text"},{"text":" ","type":"text"},{"text":"runs.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"A run’s time covers the system’s own work, measured on a continuous clock: not its","type":"text"},{"text":" ","type":"text"},{"text":"conditions, nor the commands it queued, which apply after its wave. A system its conditions","type":"text"},{"text":" ","type":"text"},{"text":"skip doesn’t run, so nothing is recorded for it. Systems in the same wave run at the same","type":"text"},{"text":" ","type":"text"},{"text":"time, so their times can add up to more than the wave took. Insert a new profile to start","type":"text"},{"text":" ","type":"text"},{"text":"over.","type":"text"}]}],"kind":"content"}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/systems\/systemprofile"]}],"topicSections":[{"title":"Initializers","identifiers":["doc:\/\/Systems\/documentation\/Systems\/SystemProfile\/init()"],"anchor":"Initializers","generated":true},{"title":"Instance Properties","identifiers":["doc:\/\/Systems\/documentation\/Systems\/SystemProfile\/timings"],"anchor":"Instance-Properties","generated":true}],"relationshipsSections":[{"title":"Conforms To","identifiers":["doc:\/\/WorldModule\/documentation\/WorldModule\/Resource","doc:\/\/Systems\/s8SendableP","doc:\/\/Systems\/s16SendableMetatypeP"],"kind":"relationships","type":"conformsTo"}],"sections":[],"metadata":{"modules":[{"name":"Systems"}],"navigatorTitle":[{"kind":"identifier","text":"SystemProfile"}],"fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"SystemProfile"}],"symbolKind":"struct","roleHeading":"Structure","title":"SystemProfile","role":"symbol","remoteSource":{"fileName":"Profiling.swift","url":"https:\/\/github.com\/Tyler-Keith-Thompson\/ECS\/blob\/main\/Sources\/Systems\/Profiling.swift#L77"},"externalID":"s:7Systems13SystemProfileV"},"kind":"symbol","seeAlsoSections":[{"title":"Profiling","identifiers":["doc:\/\/Systems\/documentation\/Systems\/SystemTiming"],"anchor":"Profiling","generated":true}],"schemaVersion":{"patch":0,"major":0,"minor":3},"hierarchy":{"paths":[["doc:\/\/Systems\/documentation\/Systems"]]},"identifier":{"url":"doc:\/\/Systems\/documentation\/Systems\/SystemProfile","interfaceLanguage":"swift"},"abstract":[{"type":"text","text":"A resource that records how long each system takes to run."}],"references":{"doc://Systems/s16SendableMetatypeP":{"identifier":"doc:\/\/Systems\/s16SendableMetatypeP","type":"unresolvable","title":"Swift.SendableMetatype"},"doc://Systems/documentation/Systems/SystemProfile/timings":{"fragments":[{"kind":"ke