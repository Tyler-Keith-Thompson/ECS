{"primaryContentSections":[{"kind":"declarations","declarations":[{"tokens":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"SystemProfile","kind":"identifier"}],"platforms":["Linux"],"languages":["swift"]}]},{"content":[{"anchor":"overview","text":"Overview","level":2,"type":"heading"},{"inlineContent":[{"type":"text","text":"Insert a profile into a world to find out where a schedule spends its time. Every schedule"},{"type":"text","text":" "},{"type":"text","text":"that runs on the world then records each system’s runs in it:"}],"type":"paragraph"},{"code":["var world = World()","world.resources.insert(SystemProfile())","world.spawn(Position(x: 0, y: 100), Velocity(dx: 0, dy: 0))","","let frame = Schedule {","    Gravity()","    Movement().after(Gravity.self)","}","frame.run(on: &world)","frame.run(on: &world)","","let timings = world.resources[SystemProfile.self].timings","print(timings.map(\\.name))","\/\/ Prints \"[\"Gravity\", \"Movement\"]\"","print(timings.map(\\.runs))","\/\/ Prints \"[2, 2]\""],"syntax":"swift","type":"codeListing"},{"inlineContent":[{"text":"Each ","type":"text"},{"isActive":true,"identifier":"doc:\/\/Systems\/documentation\/Systems\/SystemTiming","type":"reference"},{"text":" also holds the total, average, longest and latest time of the system’s","type":"text"},{"text":" ","type":"text"},{"text":"runs.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"A run’s time covers the system’s own work, measured on a continuous clock: not its"},{"type":"text","text":" "},{"type":"text","text":"conditions, nor the commands it queued, which apply after its wave. A system its conditions"},{"type":"text","text":" "},{"type":"text","text":"skip doesn’t run, so nothing is recorded for it. Systems in the same wave run at the same"},{"type":"text","text":" "},{"type":"text","text":"time, so their times can add up to more than the wave took. Insert a new profile to start"},{"type":"text","text":" "},{"type":"text","text":"over."}],"type":"paragraph"}],"kind":"content"}],"abstract":[{"type":"text","text":"A resource that records how long each system takes to run."}],"kind":"symbol","relationshipsSections":[{"title":"Conforms To","kind":"relationships","type":"conformsTo","identifiers":["doc:\/\/WorldModule\/documentation\/WorldModule\/Resource","doc:\/\/Systems\/s8SendableP","doc:\/\/Systems\/s16SendableMetatypeP"]}],"sections":[],"variants":[{"paths":["\/documentation\/systems\/systemprofile"],"traits":[{"interfaceLanguage":"swift"}]}],"seeAlsoSections":[{"anchor":"Profiling","title":"Profiling","generated":true,"identifiers":["doc:\/\/Systems\/documentation\/Systems\/SystemTiming"]}],"metadata":{"navigatorTitle":[{"text":"SystemProfile","kind":"identifier"}],"symbolKind":"struct","role":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"SystemProfile","kind":"identifier"}],"roleHeading":"Structure","externalID":"s:7Systems13SystemProfileV","modules":[{"name":"Systems"}],"title":"SystemProfile","remoteSource":{"fileName":"Profiling.swift","url":"https:\/\/github.com\/Tyler-Keith-Thompson\/ECS\/blob\/main\/Sources\/Systems\/Profiling.swift#L77"}},"schemaVersion":{"major":0,"patch":0,"minor":3},"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/Systems\/documentation\/Systems\/SystemProfile"},"hierarchy":{"paths":[["doc:\/\/Systems\/documentation\/Systems"]]},"topicSections":[{"anchor":"Initializers","title":"Initializers","generated":true,"identifiers":["doc:\/\/Systems\/documentation\/Systems\/SystemProfile\/init()"]},{"anchor":"Instance-Properties","title":"Instance Properties","generated":true,"identifiers":["doc:\/\/Systems\/documentation\/Systems\/SystemProfile\/timings"]}],"references":{"doc://Systems/s8SendableP":{"title":"Swift.Sendable","identifier":"doc:\/\/Systems\/s8SendableP","type":"unresolvable"},"doc://Systems/documentation/Systems/SystemProfile/init()":{"url":"\/documentation\/systems\/systemprofile\/init()","kind":"symbol","identifier":"doc:\/\/Systems\/documentation\/Systems\/SystemProfile\/init()","fragments":[{"text":"init","kind":"identifier"},{"text":"()","kind":"text"}],"title":"init()","role":"symbol","abstract":[{"text":"Creates an empty profile.","type":"text"}],"type":"topic"},"doc://Systems/documentation/Systems/SystemProfile":{"title":"SystemProfile","abstract":[{"type":"text","text":"A resource that records how long each system takes to run."}],"url":"\/documentation\/systems\/systemprofile","identifier":"doc:\/\/Systems\/documentation\/Systems\/SystemProfile","type":"topic","kind":"symbol","role":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"SystemProfile","kind":"identifier"}],"navigatorTitle":[{"text":"SystemProfile","kind":"identifier"}]},"doc://Systems/documentation/Systems/SystemProfile/timings":{"url":"\/documentation\/systems\/systemprofile\/timings","kind":"symbol","identifier":"doc:\/\/Systems\/documentation\/Systems\/SystemProfile\/timings","fragments":[{"text":"var","kind":"keyword"},{"text":" ","kind":"text"},{"text":"timings","kind":"identifier"},{"text":": [","kind":"text"},{"text":"SystemTiming","preciseIdentifier":"s:7Systems12SystemTimingV","kind":"typeIdentifier"},{"text":"]","kind":"text"}],"title":"timings","role":"symbol","abstract":[{"type":"text","text":"The timing of each system that has run, in the order the systems first ran."}],"type":"topic"},"doc://Systems/documentation/Systems/SystemTiming":{"url":"\/documentation\/systems\/systemtiming","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"SystemTiming","kind":"identifier"}],"type":"topic","title":"SystemTiming","abstract":[{"text":"The times one system of a schedule has taken to run.","type":"text"}],"kind":"symbol","role":"symbol","identifier":"doc:\/\/Systems\/documentation\/Systems\/SystemTiming","navigatorTitle":[{"text":"SystemTiming","kind":"identifier"}]},"doc://Systems/documentation/Systems":{"identifier":"doc:\/\/Systems\/documentation\/Systems","kind":"symbol","url":"\/documentation\/systems","title":"Systems","abstract":[{"type":"text","text":"Declare the rules of a simulation as systems, and run them on a world in a schedule."}],"role":"collection","type":"topic"},"doc://WorldModule/documentation/WorldModule/Resource":{"navigatorTitle":[{"text":"Resource","kind":"identifier"}],"abstract":[{"text":"A type that a world can hold a single value of, outside any entity.","type":"text"}],"kind":"symbol","role":"symbol","fragments":[{"text":"protocol","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Resource","kind":"identifier"}],"url":"\/documentation\/worldmodule\/resource","title":"Resource","identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/Resource","type":"topic"},"doc://Systems/s16SendableMetatypeP":{"title":"Swift.SendableMetatype","type":"unresolvable","identifier":"doc:\/\/Systems\/s16SendableMetatypeP"}}}