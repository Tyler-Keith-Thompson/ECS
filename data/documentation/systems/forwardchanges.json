{"schemaVersion":{"minor":3,"patch":0,"major":0},"abstract":[{"type":"text","text":"A system that yields each component of one type added or changed since it last ran to an"},{"type":"text","text":" "},{"type":"text","text":"asynchronous stream, with its entity."}],"kind":"symbol","topicSections":[{"title":"Initializers","identifiers":["doc:\/\/Systems\/documentation\/Systems\/ForwardChanges\/init(to:)"],"generated":true,"anchor":"Initializers"},{"title":"Instance Properties","identifiers":["doc:\/\/Systems\/documentation\/Systems\/ForwardChanges\/access"],"generated":true,"anchor":"Instance-Properties"},{"identifiers":["doc:\/\/Systems\/documentation\/Systems\/ForwardChanges\/run(in:)"],"generated":true,"anchor":"Instance-Methods","title":"Instance Methods"},{"identifiers":["doc:\/\/Systems\/documentation\/Systems\/ForwardChanges\/System-Implementations"],"generated":true,"anchor":"Default-Implementations","title":"Default Implementations"}],"identifier":{"url":"doc:\/\/Systems\/documentation\/Systems\/ForwardChanges","interfaceLanguage":"swift"},"primaryContentSections":[{"declarations":[{"tokens":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"ForwardChanges","kind":"identifier"},{"text":"<","kind":"text"},{"text":"C","kind":"genericParameter"},{"text":"> ","kind":"text"},{"text":"where","kind":"keyword"},{"text":" ","kind":"text"},{"kind":"typeIdentifier","text":"C"},{"kind":"text","text":" : "},{"kind":"typeIdentifier","preciseIdentifier":"s:11WorldModule9ComponentP","text":"Component","identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/Component"}],"languages":["swift"],"platforms":["Linux"]}],"kind":"declarations"},{"content":[{"level":2,"anchor":"overview","text":"Overview","type":"heading"},{"inlineContent":[{"type":"text","text":"Use this system to let code outside the schedule follow a component, such as a view that"},{"type":"text","text":" "},{"type":"text","text":"redraws a health bar when the health changes. Each element of the stream is a"},{"type":"text","text":" "},{"type":"reference","identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/QueryRow","isActive":true},{"type":"text","text":" of the entity and its component:"}],"type":"paragraph"},{"syntax":"swift","type":"codeListing","code":["let (changes, continuation) = AsyncStream.makeStream(of: QueryRow<Health>.self)","var world = World()","let knight = world.spawn(Health(current: 30))","world.spawn(Health(current: 50))","","let frame = Schedule { ForwardChanges(to: continuation) }","frame.run(on: &world)","world[Health.self, of: knight].current = 25","frame.run(on: &world)","continuation.finish()","","var healths: [Int] = []","for await row in changes {","    healths.append(row.components.current)","}","print(healths)","\/\/ Prints \"[30, 50, 25]\""]},{"inlineContent":[{"type":"text","text":"The first run yields every "},{"code":"C","type":"codeVoice"},{"type":"text","text":"; each later run yields those added or changed since the run"},{"type":"text","text":" "},{"type":"text","text":"before. The stream ends when you finish the continuation."}],"type":"paragraph"}],"kind":"content"}],"hierarchy":{"paths":[["doc:\/\/Systems\/documentation\/Systems"]]},"sections":[],"relationshipsSections":[{"title":"Conforms To","identifiers":["doc:\/\/Systems\/s8SendableP","doc:\/\/Systems\/s16SendableMetatypeP","doc:\/\/Systems\/documentation\/Systems\/System","doc:\/\/Systems\/documentation\/Systems\/SystemSet"],"type":"conformsTo","kind":"relationships"}],"seeAlsoSections":[{"identifiers":["doc:\/\/Systems\/documentation\/Systems\/UpdateEvents","doc:\/\/Systems\/documentation\/Systems\/ForwardEvents"],"generated":true,"anchor":"Built-In-Systems","title":"Built-In Systems"}],"metadata":{"title":"ForwardChanges","navigatorTitle":[{"kind":"identifier","text":"ForwardChanges"}],"roleHeading":"Structure","symbolKind":"struct","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"text":"ForwardChanges","kind":