{"metadata":{"externalID":"s:7Systems14ForwardChangesV","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"ForwardChanges"}],"navigatorTitle":[{"text":"ForwardChanges","kind":"identifier"}],"title":"ForwardChanges","modules":[{"name":"Systems"}],"remoteSource":{"fileName":"Streams.swift","url":"https:\/\/github.com\/Tyler-Keith-Thompson\/ECS\/blob\/main\/Sources\/Systems\/Streams.swift#L91"},"role":"symbol","roleHeading":"Structure","symbolKind":"struct"},"variants":[{"paths":["\/documentation\/systems\/forwardchanges"],"traits":[{"interfaceLanguage":"swift"}]}],"topicSections":[{"generated":true,"title":"Initializers","identifiers":["doc:\/\/Systems\/documentation\/Systems\/ForwardChanges\/init(to:)"],"anchor":"Initializers"},{"generated":true,"title":"Instance Properties","identifiers":["doc:\/\/Systems\/documentation\/Systems\/ForwardChanges\/access"],"anchor":"Instance-Properties"},{"generated":true,"title":"Instance Methods","identifiers":["doc:\/\/Systems\/documentation\/Systems\/ForwardChanges\/run(in:)"],"anchor":"Instance-Methods"},{"generated":true,"title":"Default Implementations","identifiers":["doc:\/\/Systems\/documentation\/Systems\/ForwardChanges\/System-Implementations"],"anchor":"Default-Implementations"}],"primaryContentSections":[{"declarations":[{"tokens":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"ForwardChanges"},{"kind":"text","text":"<"},{"kind":"genericParameter","text":"C"},{"kind":"text","text":"> "},{"kind":"keyword","text":"where"},{"kind":"text","text":" "},{"kind":"typeIdentifier","text":"C"},{"kind":"text","text":" : "},{"kind":"typeIdentifier","preciseIdentifier":"s:11WorldModule9ComponentP","identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/Component","text":"Component"}],"platforms":["Linux"],"languages":["swift"]}],"kind":"declarations"},{"mentions":["doc:\/\/Systems\/documentation\/Systems\/DrivingAWorldFromAnApp"],"kind":"mentions"},{"content":[{"text":"Overview","anchor":"overview","type":"heading","level":2},{"type":"paragraph","inlineContent":[{"text":"Use this system to let code outside the schedule follow a component, such as a view that","type":"text"},{"text":" ","type":"text"},{"text":"redraws a health bar when the health changes. Each element of the stream is a","type":"text"},{"text":" ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/QueryRow"},{"text":" of the entity and its component:","type":"text"}]},{"code":["let (changes, continuation) = AsyncStream.makeStream(of: QueryRow<Health>.self)","var world = World()","let knight = world.spawn(Health(current: 30))","world.spawn(Health(current: 50))","","let frame = Schedule { ForwardChanges(to: continuation) }","frame.run(on: &world)","world[Health.self, of: knight].current = 25","frame.run(on: &world)","continuation.finish()","","var healths: [Int] = []","for await row in changes {","    healths.append(row.components.current)","}","print(healths)","\/\/ Prints \"[30, 50, 25]\""],"type":"codeListing","syntax":"swift"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The first run yields every "},{"type":"codeVoice","code":"C"},{"type":"text","text":"; each later run yields those added or changed since the run"},{"type":"text","text":" "},{"type":"text","text":"before. The stream ends when you finish the continuation."}]}],"kind":"content"}],"sections":[],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/Systems\/documentation\/Systems\/ForwardChanges"},"schemaVersion":{"major":0,"minor":3,"patch":0},"seeAlsoSections":[{"generated":true,"title":"Built-In Systems","identifiers":["doc:\/\/Systems\/documentation\/Systems\/UpdateEvents","doc:\/\/Systems\/documentation\/Systems\/ForwardEvents"],"anchor":"Built-In-Systems"}],"kind":"symbol","abstract":[{"text":"A system that yields each component of one type added or changed since it last ran t