C","type":"codeVoice"},{"text":"; each later run yields those added or changed since the run","type":"text"},{"text":" ","type":"text"},{"text":"before. The stream ends when you finish the continuation.","type":"text"}]}],"kind":"content"}],"identifier":{"url":"doc:\/\/Systems\/documentation\/Systems\/ForwardChanges","interfaceLanguage":"swift"},"kind":"symbol","references":{"doc://Systems/documentation/Systems":{"type":"topic","role":"collection","identifier":"doc:\/\/Systems\/documentation\/Systems","title":"Systems","url":"\/documentation\/systems","abstract":[{"type":"text","text":"Declare the rules of a simulation as systems, and run them on a world in a schedule."}],"kind":"symbol"},"doc://Systems/documentation/Systems/System":{"role":"symbol","type":"topic","title":"System","abstract":[{"type":"text","text":"A rule that reads and changes a world, run once each time its schedule runs."}],"kind":"symbol","navigatorTitle":[{"text":"System","kind":"identifier"}],"url":"\/documentation\/systems\/system","fragments":[{"text":"protocol","kind":"keyword"},{"text":" ","kind":"text"},{"text":"System","kind":"identifier"}],"identifier":"doc:\/\/Systems\/documentation\/Systems\/System"},"doc://Systems/documentation/Systems/SystemSet":{"identifier":"doc:\/\/Systems\/documentation\/Systems\/SystemSet","kind":"symbol","type":"topic","title":"SystemSet","fragments":[{"text":"protocol","kind":"keyword"},{"text":" ","kind":"text"},{"text":"SystemSet","kind":"identifier"}],"navigatorTitle":[{"text":"SystemSet","kind":"identifier"}],"role":"symbol","abstract":[{"type":"text","text":"A type that names a group of systems, so ordering constraints can refer to all of them at"},{"type":"text","text":" "},{"type":"text","text":"once."}],"url":"\/documentation\/systems\/systemset"},"doc://Systems/documentation/Systems/ForwardChanges":{"identifier":"doc:\/\/Systems\/documentation\/Systems\/ForwardChanges","kind":"symbol","type":"topic","title":"ForwardChanges","fragments":[{"kind":"keyw