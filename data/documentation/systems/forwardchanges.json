{"primaryContentSections":[{"kind":"declarations","declarations":[{"languages":["swift"],"tokens":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"ForwardChanges"},{"kind":"text","text":"<"},{"kind":"genericParameter","text":"C"},{"kind":"text","text":"> "},{"kind":"keyword","text":"where"},{"kind":"text","text":" "},{"kind":"typeIdentifier","text":"C"},{"kind":"text","text":" : "},{"kind":"typeIdentifier","identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/Component","preciseIdentifier":"s:11WorldModule9ComponentP","text":"Component"}],"platforms":["Linux"]}]},{"kind":"content","content":[{"anchor":"overview","text":"Overview","type":"heading","level":2},{"inlineContent":[{"type":"text","text":"Use this system to let code outside the schedule follow a component, such as a view that"},{"type":"text","text":" "},{"type":"text","text":"redraws a health bar when the health changes. Each element of the stream is a"},{"type":"text","text":" "},{"type":"reference","isActive":true,"identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/QueryRow"},{"type":"text","text":" of the entity and its component:"}],"type":"paragraph"},{"type":"codeListing","syntax":"swift","code":["let (changes, continuation) = AsyncStream.makeStream(of: QueryRow<Health>.self)","var world = World()","let knight = world.spawn(Health(current: 30))","world.spawn(Health(current: 50))","","let frame = Schedule { ForwardChanges(to: continuation) }","frame.run(on: &world)","world[Health.self, of: knight].current = 25","frame.run(on: &world)","continuation.finish()","","var healths: [Int] = []","for await row in changes {","    healths.append(row.components.current)","}","print(healths)","\/\/ Prints \"[30, 50, 25]\""]},{"inlineContent":[{"type":"text","text":"The first run yields every "},{"type":"codeVoice","code":"C"},{"type":"text","text":"; each later run yields those added or changed since the run"},{"type":"text","text":" "},{"type":"text",