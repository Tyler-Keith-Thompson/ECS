{"metadata":{"fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"ForwardChanges"}],"role":"symbol","remoteSource":{"fileName":"Streams.swift","url":"https:\/\/github.com\/Tyler-Keith-Thompson\/ECS\/blob\/main\/Sources\/Systems\/Streams.swift#L91"},"title":"ForwardChanges","symbolKind":"struct","modules":[{"name":"Systems"}],"externalID":"s:7Systems14ForwardChangesV","roleHeading":"Structure","navigatorTitle":[{"text":"ForwardChanges","kind":"identifier"}]},"kind":"symbol","relationshipsSections":[{"identifiers":["doc:\/\/Systems\/s8SendableP","doc:\/\/Systems\/s16SendableMetatypeP","doc:\/\/Systems\/documentation\/Systems\/System","doc:\/\/Systems\/documentation\/Systems\/SystemSet"],"type":"conformsTo","title":"Conforms To","kind":"relationships"}],"sections":[],"topicSections":[{"anchor":"Initializers","title":"Initializers","generated":true,"identifiers":["doc:\/\/Systems\/documentation\/Systems\/ForwardChanges\/init(to:)"]},{"anchor":"Instance-Properties","title":"Instance Properties","generated":true,"identifiers":["doc:\/\/Systems\/documentation\/Systems\/ForwardChanges\/access"]},{"anchor":"Instance-Methods","title":"Instance Methods","generated":true,"identifiers":["doc:\/\/Systems\/documentation\/Systems\/ForwardChanges\/run(in:)"]},{"anchor":"Default-Implementations","title":"Default Implementations","generated":true,"identifiers":["doc:\/\/Systems\/documentation\/Systems\/ForwardChanges\/System-Implementations"]}],"schemaVersion":{"major":0,"patch":0,"minor":3},"primaryContentSections":[{"declarations":[{"tokens":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"ForwardChanges"},{"kind":"text","text":"<"},{"kind":"genericParameter","text":"C"},{"kind":"text","text":"> "},{"kind":"keyword","text":"where"},{"kind":"text","text":" "},{"kind":"typeIdentifier","text":"C"},{"kind":"text","text":" : "},{"identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/Component","kind":"typeIdentifier","preciseIdentifier":"s:11WorldModule9ComponentP","text":"Component"}],"platforms":["Linux"],"languages":["swift"]}],"kind":"declarations"},{"content":[{"type":"heading","level":2,"text":"Overview","anchor":"overview"},{"type":"paragraph","inlineContent":[{"text":"Use this system to let code outside the schedule follow a component, such as a view that","type":"text"},{"text":" ","type":"text"},{"text":"redraws a health bar when the health changes. Each element of the stream is a","type":"text"},{"text":" ","type":"text"},{"identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/QueryRow","type":"reference","isActive":true},{"text":" of the entity and its component:","type":"text"}]},{"type":"codeListing","syntax":"swift","code":["let (changes, continuation) = AsyncStream.makeStream(of: QueryRow<Health>.self)","var world = World()","let knight = world.spawn(Health(current: 30))","world.spawn(Health(current: 50))","","let frame = Schedule { ForwardChanges(to: continuation) }","frame.run(on: &world)","world[Health.self, of: knight].current = 25","frame.run(on: &world)","continuation.finish()","","var healths: [Int] = []","for await row in changes {","    healths.append(row.components.current)","}","print(healths)","\/\/ Prints \"[30, 50, 25]\""]},{"type":"paragraph","inlineContent":[{"text":"The first run yields every ","type":"text"},{"code":"C","type":"codeVoice"},{"text":"; each later run yields those added or changed since the run","type":"text"},{"text":" ","type":"text"},{"text":"before. The stream ends when you finish the continuation.","type":"text"}]}],"kind":"content"}],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/Systems\/documentation\/Systems\/ForwardChanges"},"abstract":[{"text":"A system that yields each component of one type added or changed since it last ran to an","type":"text"},{"text":" ","type":"text"},{"text":"asynchronous stream, with its entity.","type":"text"}],"seeAlsoSections":[{"anchor":"Built-