{"schemaVersion":{"patch":0,"major":0,"minor":3},"kind":"symbol","hierarchy":{"paths":[["doc:\/\/Systems\/documentation\/Systems"]]},"primaryContentSections":[{"kind":"declarations","declarations":[{"tokens":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"ForwardChanges","kind":"identifier"},{"text":"<","kind":"text"},{"text":"C","kind":"genericParameter"},{"text":"> ","kind":"text"},{"text":"where","kind":"keyword"},{"text":" ","kind":"text"},{"text":"C","kind":"typeIdentifier"},{"text":" : ","kind":"text"},{"text":"Component","identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/Component","kind":"typeIdentifier","preciseIdentifier":"s:11WorldModule9ComponentP"}],"platforms":["Linux"],"languages":["swift"]}]},{"kind":"content","content":[{"level":2,"anchor":"overview","text":"Overview","type":"heading"},{"inlineContent":[{"text":"Use this system to let code outside the schedule follow a component, such as a view that","type":"text"},{"text":" ","type":"text"},{"text":"redraws a health bar when the health changes. Each element of the stream is a","type":"text"},{"text":" ","type":"text"},{"identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/QueryRow","isActive":true,"type":"reference"},{"text":" of the entity and its component:","type":"text"}],"type":"paragraph"},{"syntax":"swift","code":["let (changes, continuation) = AsyncStream.makeStream(of: QueryRow<Health>.self)","var world = World()","let knight = world.spawn(Health(current: 30))","world.spawn(Health(current: 50))","","let frame = Schedule { ForwardChanges(to: continuation) }","frame.run(on: &world)","world[Health.self, of: knight].current = 25","frame.run(on: &world)","continuation.finish()","","var healths: [Int] = []","for await row in changes {","    healths.append(row.components.current)","}","print(healths)","\/\/ Prints \"[30, 50, 25]\""],"type":"codeListing"},{"inlineContent":[{"type":"text","text":"The first run yields every "},{"type":"codeVoice","code":"C"},{"type":"text","text":"; each later run yields those added or changed since the run"},{"type":"text","text":" "},{"type":"text","text":"before. The stream ends when you finish the continuation."}],"type":"paragraph"}]}],"topicSections":[{"identifiers":["doc:\/\/Systems\/documentation\/Systems\/ForwardChanges\/init(to:)"],"generated":true,"anchor":"Initializers","title":"Initializers"},{"identifiers":["doc:\/\/Systems\/documentation\/Systems\/ForwardChanges\/access"],"generated":true,"anchor":"Instance-Properties","title":"Instance Properties"},{"identifiers":["doc:\/\/Systems\/documentation\/Systems\/ForwardChanges\/run(in:)"],"generated":true,"anchor":"Instance-Methods","title":"Instance Methods"},{"identifiers":["doc:\/\/Systems\/documentation\/Systems\/ForwardChanges\/System-Implementations"],"generated":true,"anchor":"Default-Implementations","title":"Default Implementations"}],"identifier":{"url":"doc:\/\/Systems\/documentation\/Systems\/ForwardChanges","interfaceLanguage":"swift"},"metadata":{"fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"ForwardChanges"}],"modules":[{"name":"Systems"}],"navigatorTitle":[{"text":"ForwardChanges","kind":"identifier"}],"remoteSource":{"url":"https:\/\/github.com\/Tyler-Keith-Thompson\/ECS\/blob\/main\/Sources\/Systems\/Streams.swift#L91","fileName":"Streams.swift"},"symbolKind":"struct","roleHeading":"Structure","title":"ForwardChanges","role":"symbol","externalID":"s:7Systems14ForwardChangesV"},"sections":[],"relationshipsSections":[{"kind":"relationships","type":"conformsTo","identifiers":["doc:\/\/Systems\/s8SendableP","doc:\/\/Systems\/s16SendableMetatypeP","doc:\/\/Systems\/documentation\/Systems\/System","doc:\/\/Systems\/documentation\/Systems\/SystemSet"],"title":"Conforms To"}],"seeAlsoSections":[{"identifiers":["doc:\/\/Systems\/documentation\/Systems\/UpdateEvents","doc:\/\/Systems\/documentation\/Systems\/ForwardEvents"],"generated":true,"anchor":"Built-In-