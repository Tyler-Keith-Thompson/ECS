ce","isActive":true,"identifier":"doc:\/\/Systems\/documentation\/Systems\/System()"},{"type":"text","text":" macro also makes a main-actor system of a type marked "},{"type":"codeVoice","code":"@MainActor"},{"type":"text","text":", or of"},{"type":"text","text":" "},{"type":"text","text":"one whose "},{"type":"codeVoice","code":"run"},{"type":"text","text":" method is."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"A schedule runs a main-actor system on the thread that runs the schedule, after the other"},{"type":"text","text":" "},{"type":"text","text":"systems of its wave and never at the same time as them."}],"type":"paragraph"},{"style":"important","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"A schedule that holds a main-actor system must run on the main actor; running"},{"type":"text","text":" "},{"type":"text","text":"it elsewhere traps."}]}],"type":"aside","name":"Important"}]}],"hierarchy":{"paths":[["doc:\/\/Systems\/documentation\/Systems"]]},"references":{"doc://Systems/documentation/Systems/MainActorSystem/after(_:)":{"role":"symbol","identifier":"doc:\/\/Systems\/documentation\/Systems\/MainActorSystem\/after(_:)","url":"\/documentation\/systems\/mainactorsystem\/after(_:)","kind":"symbol","type":"topic","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"after"},{"kind":"text","text":"<each "},{"kind":"genericParameter","text":"S"},{"kind":"text","text":">(repeat (each "},{"kind":"typeIdentifier","text":"S"},{"kind":"text","text":").Type) -> "},{"kind":"typeIdentifier","text":"ScheduledSystem","preciseIdentifier":"s:7Systems15ScheduledSystemV"}],"title":"after(_:)","abstract":[{"type":"text","text":"Returns this system, ordered to run after every system in each of the given sets."}]},"doc://Systems/documentation/Systems/MainActorSystem/before(_:)":{"abstract":[{"text":"Returns this system, ordered to run before every system in each of the given sets.","type":"