{"schemaVersion":{"major":0,"patch":0,"minor":3},"primaryContentSections":[{"declarations":[{"tokens":[{"text":"protocol","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MainActorSystem","kind":"identifier"},{"text":" : ","kind":"text"},{"text":"Sendable","preciseIdentifier":"s:s8SendableP","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"identifier":"doc:\/\/Systems\/documentation\/Systems\/SystemSet","text":"SystemSet","preciseIdentifier":"s:7Systems9SystemSetP","kind":"typeIdentifier"}],"languages":["swift"],"platforms":["Linux"]}],"kind":"declarations"},{"kind":"mentions","mentions":["doc:\/\/Systems\/documentation\/Systems\/DrivingAWorldFromAnApp"]},{"kind":"content","content":[{"level":2,"text":"Overview","anchor":"overview","type":"heading"},{"inlineContent":[{"type":"text","text":"Use a main-actor system to carry results out of the world into objects isolated to the main"},{"type":"text","text":" "},{"type":"text","text":"actor: a label showing the score, a view tracking an entity. Conform to the protocol and mark"},{"type":"text","text":" "},{"type":"reference","identifier":"doc:\/\/Systems\/documentation\/Systems\/MainActorSystem\/run(in:)","isActive":true},{"type":"text","text":" "},{"type":"codeVoice","code":"@MainActor"},{"type":"text","text":":"}],"type":"paragraph"},{"syntax":"swift","code":["@MainActor","final class ScoreLabel { var text = \"\" }","","struct ShowScore: MainActorSystem {","    let label: ScoreLabel","    var access: Access? { .reads(resources: Score.self) }","","    @MainActor func run(in world: inout World) {","        label.text = \"Score: \\(world.resources[Score.self].points)\"","    }","}","","let label = ScoreLabel()","var world = World()","world.resources.insert(Score(points: 3))","Schedule { ShowScore(label: label) }.run(on: &world)","print(label.text)","\/\/ Prints \"Score: 3\""],"type":"codeListing"},{"inlineContent":[{"type":"text","text":"The "},{"isActive":true,"type":"reference","identifier":"doc:\/\/Systems\/documentation\/Systems\/System()"},{"type":"text","text":" macro also makes a main-actor system of a type marked "},{"code":"@MainActor","type":"codeVoice"},{"type":"text","text":", or of"},{"type":"text","text":" "},{"type":"text","text":"one whose "},{"code":"run","type":"codeVoice"},{"type":"text","text":" method is."}],"type":"paragraph"},{"inlineContent":[{"text":"A schedule runs a main-actor system on the thread that runs the schedule, after the other","type":"text"},{"text":" ","type":"text"},{"text":"systems of its wave and never at the same time as them.","type":"text"}],"type":"paragraph"},{"style":"important","name":"Important","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"A schedule that holds a main-actor system must run on the main actor; running"},{"type":"text","text":" "},{"type":"text","text":"it elsewhere traps."}]}],"type":"aside"}]}],"hierarchy":{"paths":[["doc:\/\/Systems\/documentation\/Systems"]]},"sections":[],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/Systems\/documentation\/Systems\/MainActorSystem"},"kind":"symbol","abstract":[{"text":"A system that runs on the main actor, for work that touches main-actor state such as a user","type":"text"},{"text":" ","type":"text"},{"text":"interface.","type":"text"}],"topicSections":[{"title":"Running a System","identifiers":["doc:\/\/Systems\/documentation\/Systems\/MainActorSystem\/run(in:)","doc:\/\/Systems\/documentation\/Systems\/MainActorSystem\/access","doc:\/\/Systems\/documentation\/Systems\/MainActorSystem\/initialize(in:)"],"anchor":"Running-a-System"},{"title":"Ordering a System","identifiers":["doc:\/\/Systems\/documentation\/Systems\/MainActorSystem\/after(_:)","doc:\/\/Systems\/documentation\/Systems\/MainActorSystem\/before(_:)","doc:\/\/Systems\/documentation\/Systems\/MainActorSystem\/inSet(_:)","doc:\/\/Systems\/documentation\/Systems\/MainActorSystem\/ambiguous(with:)"],"anchor":"Ordering-a-System"},{"anchor":"Running-a-System-Conditionally",