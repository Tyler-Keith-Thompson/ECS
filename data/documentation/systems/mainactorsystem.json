{"schemaVersion":{"major":0,"minor":3,"patch":0},"kind":"symbol","hierarchy":{"paths":[["doc:\/\/Systems\/documentation\/Systems"]]},"primaryContentSections":[{"kind":"declarations","declarations":[{"languages":["swift"],"tokens":[{"text":"protocol","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MainActorSystem","kind":"identifier"},{"text":" : ","kind":"text"},{"text":"Sendable","kind":"typeIdentifier","preciseIdentifier":"s:s8SendableP"},{"text":", ","kind":"text"},{"identifier":"doc:\/\/Systems\/documentation\/Systems\/SystemSet","text":"SystemSet","kind":"typeIdentifier","preciseIdentifier":"s:7Systems9SystemSetP"}],"platforms":["Linux"]}]},{"kind":"content","content":[{"anchor":"overview","type":"heading","level":2,"text":"Overview"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Use a main-actor system to carry results out of the world into objects isolated to the main"},{"type":"text","text":" "},{"type":"text","text":"actor: a label showing the score, a view tracking an entity. Conform to the protocol and mark"},{"type":"text","text":" "},{"identifier":"doc:\/\/Systems\/documentation\/Systems\/MainActorSystem\/run(in:)","type":"reference","isActive":true},{"type":"text","text":" "},{"type":"codeVoice","code":"@MainActor"},{"type":"text","text":":"}]},{"syntax":"swift","type":"codeListing","code":["@MainActor","final class ScoreLabel { var text = \"\" }","","struct ShowScore: MainActorSystem {","    let label: ScoreLabel","    var access: Access? { .reads(resources: Score.self) }","","    @MainActor func run(in world: inout World) {","        label.text = \"Score: \\(world.resources[Score.self].points)\"","    }","}","","let label = ScoreLabel()","var world = World()","world.resources.insert(Score(points: 3))","Schedule { ShowScore(label: label) }.run(on: &world)","print(label.text)","\/\/ Prints \"Score: 3\""]},{"type":"paragraph","inlineContent":[{"type":"text","text":"The "},{"isActive":true,"identifier":"doc:\/\/Systems\/documentation\