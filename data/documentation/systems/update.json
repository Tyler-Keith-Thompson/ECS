ryRow"},{"text":", as ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/World\/update(_:over:body:)"},{"text":" does.","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"code":".Where<F...>","type":"codeVoice"},{"text":" visits only the entities that pass the filter types ","type":"text"},{"code":"F","type":"codeVoice"},{"text":", such as","type":"text"},{"text":" ","type":"text"},{"isActive":true,"identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/Without","type":"reference"},{"text":" and ","type":"text"},{"isActive":true,"identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/Changed","type":"reference"},{"text":".","type":"text"}],"type":"paragraph"}]}],"type":"unorderedList"},{"inlineContent":[{"type":"text","text":"The following system bounces everything that has fallen below the ground, changing both its"},{"type":"text","text":" "},{"type":"text","text":"position and its velocity:"}],"type":"paragraph"},{"code":["@System","struct Bounce {","    func run(_ bouncers: Update<Position>.And<Velocity>) {","        bouncers { position, velocity, _ in","            if position.y < 0 {","                position.y = -position.y","                velocity.dy = -velocity.dy","            }","        }","    }","}","","var world = World()","let ball = world.spawn(Position(x: 0, y: -2), Velocity(dx: 0, dy: -5))","Schedule { Bounce() }.run(on: &world)","print(world[Position.self, of: ball])","\/\/ Prints \"Position(x: 0.0, y: 2.0)\"","print(world[Velocity.self, of: ball])","\/\/ Prints \"Velocity(dx: 0.0, dy: 5.0)\""],"syntax":"swift","type":"codeListing"},{"inlineContent":[{"text":"Every written component an update visits is marked changed, whether or not the closure","type":"text"},{"text":" ","type":"text"},{"text":"changes it.","type":"text"}],"type":"paragraph"}],"kind":"content"}],"metadata":{"symbolKind":"class","title":"Update","modules":[{"name":"Systems"}],"nav