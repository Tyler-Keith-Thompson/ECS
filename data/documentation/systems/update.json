rint(world[Position.self, of: ball])","\/\/ Prints \"Position(x: 0.0, y: 2.0)\"","print(world[Velocity.self, of: ball])","\/\/ Prints \"Velocity(dx: 0.0, dy: 5.0)\""]},{"inlineContent":[{"text":"Every written component an update visits is marked changed, whether or not the closure","type":"text"},{"text":" ","type":"text"},{"text":"changes it.","type":"text"}],"type":"paragraph"}]}],"references":{"doc://Systems/documentation/Systems/ResourceReader":{"navigatorTitle":[{"kind":"identifier","text":"ResourceReader"}],"identifier":"doc:\/\/Systems\/documentation\/Systems\/ResourceReader","kind":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"ResourceReader"}],"url":"\/documentation\/systems\/resourcereader","abstract":[{"type":"text","text":"A system parameter that reads a resource."}],"title":"ResourceReader","role":"symbol","type":"topic"},"doc://Systems/documentation/Systems/SystemParameter":{"navigatorTitle":[{"kind":"identifier","text":"SystemParameter"}],"identifier":"doc:\/\/Systems\/documentation\/Systems\/SystemParameter","kind":"symbol","fragments":[{"kind":"keyword","text":"protocol"},{"kind":"text","text":" "},{"kind":"identifier","text":"SystemParameter"}],"abstract":[{"type":"text","text":"A type a system’s "},{"type":"codeVoice","code":"run"},{"type":"text","text":" method can take in place of the whole world, whose type states what"},{"type":"text","text":" "},{"type":"text","text":"the system reads and writes."}],"url":"\/documentation\/systems\/systemparameter","title":"SystemParameter","role":"symbol","type":"topic"},"doc://WorldModule/documentation/WorldModule/World/update(_:over:body:)":{"kind":"symbol","role":"symbol","url":"\/documentation\/worldmodule\/world\/update(_:over:body:)","type":"topic","identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/World\/update(_:over:body:)","abstract":[{"type":"text","text":"Changes a component of every entity that matches a query, in pla