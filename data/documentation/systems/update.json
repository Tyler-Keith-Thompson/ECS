{"kind":"symbol","schemaVersion":{"major":0,"patch":0,"minor":3},"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/Systems\/documentation\/Systems\/Update"},"metadata":{"symbolKind":"class","role":"symbol","navigatorTitle":[{"kind":"identifier","text":"Update"}],"externalID":"s:7Systems6UpdateC","title":"Update","remoteSource":{"fileName":"Update.swift","url":"https:\/\/github.com\/Tyler-Keith-Thompson\/ECS\/blob\/main\/Sources\/Systems\/Update.swift#L56"},"fragments":[{"text":"class","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Update","kind":"identifier"}],"modules":[{"name":"Systems"}],"roleHeading":"Class"},"relationshipsSections":[{"title":"Conforms To","kind":"relationships","identifiers":["doc:\/\/Systems\/s8SendableP","doc:\/\/Systems\/s16SendableMetatypeP","doc:\/\/Systems\/documentation\/Systems\/SystemParameter"],"type":"conformsTo"}],"primaryContentSections":[{"kind":"declarations","declarations":[{"platforms":["Linux"],"languages":["swift"],"tokens":[{"kind":"keyword","text":"final"},{"kind":"text","text":" "},{"kind":"keyword","text":"class"},{"kind":"text","text":" "},{"kind":"identifier","text":"Update"},{"kind":"text","text":"<"},{"kind":"genericParameter","text":"A"},{"kind":"text","text":"> "},{"kind":"keyword","text":"where"},{"kind":"text","text":" "},{"kind":"typeIdentifier","text":"A"},{"kind":"text","text":" : "},{"preciseIdentifier":"s:11WorldModule9ComponentP","kind":"typeIdentifier","identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/Component","text":"Component"}]}]},{"content":[{"text":"Overview","level":2,"type":"heading","anchor":"overview"},{"inlineContent":[{"text":"Call an update like a function, passing a closure that receives each entity’s component to","type":"text"},{"text":" ","type":"text"},{"text":"change in place, and the entity. The update’s type says which entities it visits and what","type":"text"},{"text":" ","type":"text"},{"text":"else it reads, by nesting:","type":"text"}],"type":"paragraph"},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"code":"Update<A>","type":"codeVoice"},{"text":" changes the ","type":"text"},{"code":"A","type":"codeVoice"},{"text":" of every entity holding one.","type":"text"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"Update<A>.And<B>"},{"type":"text","text":" and "},{"type":"codeVoice","code":"Update<A>.And<B>.And<C>"},{"type":"text","text":" change two or three components of every"},{"type":"text","text":" "},{"type":"text","text":"entity holding all of them."}]}]},{"content":[{"inlineContent":[{"code":".Over<T...>","type":"codeVoice"},{"type":"text","text":" also reads the query terms "},{"code":"T","type":"codeVoice"},{"type":"text","text":", components or "},{"isActive":true,"identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/AnyOf","type":"reference"},{"type":"text","text":" groups,"},{"type":"text","text":" "},{"type":"text","text":"and visits only the entities that match them. The closure receives them as a"},{"type":"text","text":" "},{"isActive":true,"identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/QueryRow","type":"reference"},{"type":"text","text":", as "},{"isActive":true,"identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/World\/update(_:over:body:)","type":"reference"},{"type":"text","text":" does."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"code":".Where<F...>","type":"codeVoice"},{"text":" visits only the entities that pass the filter types ","type":"text"},{"code":"F","type":"codeVoice"},{"text":", such as","type":"text"},{"text":" ","type":"text"},{"identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/Without","type":"reference","isActive":true},{"text":" and ","type":"text"},{"identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/Changed","type":"reference","isActive":true},{"text":".","type":"text"}],"type":"paragraph"}]}]},{"inlineContent":[{"text":"The following system bounces everything that has fallen below the ground, changing both its","type":"text"},{"text":" ","type":"text"},{"text":"position and its velocity:","type":"text"}],"type":"paragraph"},{"syntax":"swift","type":"codeListing","code":["@System","struct Bounce {","    func run(_ bouncers: Update<Position>.And<Velocity>) {","        bouncers { position, velocity, _ in","            if position.y < 0 {","                position.y = -position.y","                velocity.dy = -velocity.dy","            }","        }","    }","}","","var world = World()","let ball = world.spawn(Position(x: 0, y: -2), Velocity(dx: 0, dy: -5))","Schedule { Bounce() }.run(on: &world)","print(world[Position.self, of: ball])","\/\/ Prints \"Position(x: 0.0, y: 2.0)\"","print(world[Velocity.self, of: ball])","\/\/ Prints \"Velocity(dx: 0.0, dy: 5.0)\""]},{"inlineContent":[{"type":"text","text":"Every written component an update visits is marked changed, whether or not the closure"},{"type":"text","text":" "},{"type":"text","text":"changes it."}],"type":"paragraph"}],"kind":"content"}],"hierarchy":{"paths":[["doc:\/\/Systems\/documentation\/Systems"]]},"sections":[],"seeAlsoSections":[{"anchor":"System-Parameters","title":"System Parameters","generated":true,"identifiers":["doc:\/\/Systems\/documentation\/Systems\/SystemParameter","doc:\/\/Systems\/documentation\/Systems\/ResourceReader","doc:\/\/Systems\/documentation\/Systems\/ResourceWriter","doc:\/\/Systems\/documentation\/Systems\/EventReader","doc:\/\/Systems\/documentation\/Systems\/EventWriter","doc:\/\/Systems\/documentation\/Systems\/RemovedComponents"]}],"topicSections":[{"anchor":"Classes","title":"Classes","generated":true,"identifiers":["doc:\/\/Systems\/documentation\/Systems\/Update\/And","doc:\/\/Systems\/documentation\/Systems\/Update\/Over","doc:\/\/Systems\/documentation\/Systems\/Update\/Where"]},{"anchor":"Instance-Methods","title":"Instance Methods","generated":true,"identifiers":["doc:\/\/Systems\/documentation\/System