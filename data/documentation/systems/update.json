{"primaryContentSections":[{"declarations":[{"tokens":[{"text":"final","kind":"keyword"},{"text":" ","kind":"text"},{"text":"class","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Update","kind":"identifier"},{"text":"<","kind":"text"},{"text":"A","kind":"genericParameter"},{"text":"> ","kind":"text"},{"text":"where","kind":"keyword"},{"text":" ","kind":"text"},{"text":"A","kind":"typeIdentifier"},{"text":" : ","kind":"text"},{"preciseIdentifier":"s:11WorldModule9ComponentP","text":"Component","kind":"typeIdentifier","identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/Component"}],"platforms":["Linux"],"languages":["swift"]}],"kind":"declarations"},{"kind":"content","content":[{"text":"Overview","level":2,"anchor":"overview","type":"heading"},{"inlineContent":[{"type":"text","text":"Call an update like a function, passing a closure that receives each entity’s component to"},{"type":"text","text":" "},{"type":"text","text":"change in place, and the entity. The update’s type says which entities it visits and what"},{"type":"text","text":" "},{"type":"text","text":"else it reads, by nesting:"}],"type":"paragraph"},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"Update<A>"},{"type":"text","text":" changes the "},{"type":"codeVoice","code":"A"},{"type":"text","text":" of every entity holding one."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"code":"Update<A>.And<B>","type":"codeVoice"},{"text":" and ","type":"text"},{"code":"Update<A>.And<B>.And<C>","type":"codeVoice"},{"text":" change two or three components of every","type":"text"},{"text":" ","type":"text"},{"text":"entity holding all of them.","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":".Over<T...>"},{"type":"text","text":" also reads the query terms "},{"type":"codeVoice","code":"T"},{"type":"text","text":", components or "},{"identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/AnyOf","type":"reference","isActive":true},{"type":"text","text":" groups,"},{"type":"text","text":" "},{"type":"text","text":"and visits only the entities that match them. The closure receives them as a"},{"type":"text","text":" "},{"identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/QueryRow","type":"reference","isActive":true},{"type":"text","text":", as "},{"identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/World\/update(_:over:body:)","type":"reference","isActive":true},{"type":"text","text":" does."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":".Where<F...>"},{"type":"text","text":" visits only the entities that pass the filter types "},{"type":"codeVoice","code":"F"},{"type":"text","text":", such as"},{"type":"text","text":" "},{"type":"reference","identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/Without","isActive":true},{"type":"text","text":" and "},{"type":"reference","identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/Changed","isActive":true},{"type":"text","text":"."}]}]}],"type":"unorderedList"},{"inlineContent":[{"text":"The following system bounces everything that has fallen below the ground, changing both its","type":"text"},{"text":" ","type":"text"},{"text":"position and its velocity:","type":"text"}],"type":"paragraph"},{"syntax":"swift","code":["@System","struct Bounce {","    func run(_ bouncers: Update<Position>.And<Velocity>) {","        bouncers { position, velocity, _ in","            if position.y < 0 {","                position.y = -position.y","                velocity.dy = -velocity.dy","            }","        }","    }","}","","var world = World()","let ball = world.spawn(Position(x: 0, y: -2), Velocity(dx: 0, dy: -5))","Schedule { Bounce() }.run(on: &world)","print(world[Position.self, of: ball])","\/\/ Prints \"Position(x: 0.0, y: 2.0)\"","print(world[Velocity.self, of: ball])","\/\/ Prints \"Velocity(dx: 0.0, dy: 5.0)\""],"type":"codeListing"},{"inlineContent