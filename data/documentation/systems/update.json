{"kind":"symbol","abstract":[{"text":"A system parameter that changes a component of every entity that holds it.","type":"text"}],"relationshipsSections":[{"kind":"relationships","title":"Conforms To","identifiers":["doc:\/\/Systems\/s8SendableP","doc:\/\/Systems\/s16SendableMetatypeP","doc:\/\/Systems\/documentation\/Systems\/SystemParameter"],"type":"conformsTo"}],"hierarchy":{"paths":[["doc:\/\/Systems\/documentation\/Systems"]]},"variants":[{"paths":["\/documentation\/systems\/update"],"traits":[{"interfaceLanguage":"swift"}]}],"identifier":{"url":"doc:\/\/Systems\/documentation\/Systems\/Update","interfaceLanguage":"swift"},"topicSections":[{"generated":true,"title":"Classes","identifiers":["doc:\/\/Systems\/documentation\/Systems\/Update\/And","doc:\/\/Systems\/documentation\/Systems\/Update\/Over","doc:\/\/Systems\/documentation\/Systems\/Update\/Where"],"anchor":"Classes"},{"generated":true,"title":"Instance Methods","identifiers":["doc:\/\/Systems\/documentation\/Systems\/Update\/callAsFunction(_:)"],"anchor":"Instance-Methods"},{"generated":true,"title":"Type Aliases","identifiers":["doc:\/\/Systems\/documentation\/Systems\/Update\/Body"],"anchor":"Type-Aliases"}],"sections":[],"seeAlsoSections":[{"generated":true,"title":"System Parameters","identifiers":["doc:\/\/Systems\/documentation\/Systems\/SystemParameter","doc:\/\/Systems\/documentation\/Systems\/ResourceReader","doc:\/\/Systems\/documentation\/Systems\/ResourceWriter","doc:\/\/Systems\/documentation\/Systems\/EventReader","doc:\/\/Systems\/documentation\/Systems\/EventWriter","doc:\/\/Systems\/documentation\/Systems\/RemovedComponents"],"anchor":"System-Parameters"}],"schemaVersion":{"major":0,"minor":3,"patch":0},"primaryContentSections":[{"kind":"declarations","declarations":[{"platforms":["Linux"],"tokens":[{"kind":"keyword","text":"final"},{"kind":"text","text":" "},{"kind":"keyword","text":"class"},{"kind":"text","text":" "},{"kind":"identifier","text":"Update"},{"kind":"text","text":"<"},{"