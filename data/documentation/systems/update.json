{"schemaVersion":{"major":0,"minor":3,"patch":0},"abstract":[{"type":"text","text":"A system parameter that changes a component of every entity that holds it."}],"kind":"symbol","topicSections":[{"identifiers":["doc:\/\/Systems\/documentation\/Systems\/Update\/And","doc:\/\/Systems\/documentation\/Systems\/Update\/Over","doc:\/\/Systems\/documentation\/Systems\/Update\/Where"],"generated":true,"anchor":"Classes","title":"Classes"},{"identifiers":["doc:\/\/Systems\/documentation\/Systems\/Update\/callAsFunction(_:)"],"generated":true,"anchor":"Instance-Methods","title":"Instance Methods"},{"identifiers":["doc:\/\/Systems\/documentation\/Systems\/Update\/Body"],"generated":true,"anchor":"Type-Aliases","title":"Type Aliases"}],"identifier":{"url":"doc:\/\/Systems\/documentation\/Systems\/Update","interfaceLanguage":"swift"},"primaryContentSections":[{"kind":"declarations","declarations":[{"platforms":["Linux"],"languages":["swift"],"tokens":[{"kind":"keyword","text":"final"},{"kind":"text","text":" "},{"kind":"keyword","text":"class"},{"kind":"text","text":" "},{"kind":"identifier","text":"Update"},{"kind":"text","text":"<"},{"kind":"genericParameter","text":"A"},{"kind":"text","text":"> "},{"kind":"keyword","text":"where"},{"kind":"text","text":" "},{"kind":"typeIdentifier","text":"A"},{"kind":"text","text":" : "},{"kind":"typeIdentifier","identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/Component","text":"Component","preciseIdentifier":"s:11WorldModule9ComponentP"}]}]},{"kind":"content","content":[{"type":"heading","level":2,"text":"Overview","anchor":"overview"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Call an update like a function, passing a closure that receives each entity’s component to"},{"type":"text","text":" "},{"type":"text","text":"change in place, and the entity. The update’s type says which entities it visits and what"},{"type":"text","text":" "},{"type":"text","text":"else it reads, by nesting:"}]},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"Update<A>"},{"type":"text","text":" changes the "},{"type":"codeVoice","code":"A"},{"type":"text","text":" of every entity holding one."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"code":"Update<A>.And<B>","type":"codeVoice"},{"type":"text","text":" and "},{"code":"Update<A>.And<B>.And<C>","type":"codeVoice"},{"type":"text","text":" change two or three components of every"},{"type":"text","text":" "},{"type":"text","text":"entity holding all of them."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":".Over<T...>"},{"type":"text","text":" also reads the query terms "},{"type":"codeVoice","code":"T"},{"type":"text","text":", components or "},{"type":"reference","isActive":true,"identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/AnyOf"},{"type":"text","text":" groups,"},{"type":"text","text":" "},{"type":"text","text":"and visits only the entities that match them. The closure receives them as a"},{"type":"text","text":" "},{"type":"reference","isActive":true,"identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/QueryRow"},{"type":"text","text":", as "},{"type":"reference","isActive":true,"identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/World\/update(_:over:body:)"},{"type":"text","text":" does."}]}]},{"content":[{"inlineContent":[{"code":".Where<F...>","type":"codeVoice"},{"type":"text","text":" visits only the entities that pass the filter types "},{"code":"F","type":"codeVoice"},{"type":"text","text":", such as"},{"type":"text","text":" "},{"isActive":true,"type":"reference","identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/Without"},{"type":"text","text":" and "},{"isActive":true,"type":"reference","identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/Changed"},{"type":"text","text":"."}],"type":"paragraph"}]}]},{"type":"paragraph","inlineContent":[{"text":"The following system bounces everything that has fallen below the ground, changing both its","type":"text"},{"text":" ","type":"text"},{"text":"position and its velocity:","type":"text"}]},{"type":"codeListing","code":["@System","struct Bounce {","    func run(_ bouncers: Update<Position>.And<Velocity>) {","        bouncers { position, velocity, _ in","            if position.y < 0 {","                position.y = -position.y","                velocity.dy = -velocity.dy","            }","        }","    }","}","","var world = World()","let ball = world.spawn(Position(x: 0, y: -2), Velocity(dx: 0, dy: -5))","Schedule { Bounce() }.run(on: &world)","print(world[Position.self, of: ball])","\/\/ Prints \"Position(x: 0.0, y: 2.0)\"","print(world[Velocity.self, of: ball])","\/\/ Prints \"Velocity(dx: 0.0, dy: 5.0)\""],"syntax":"swift"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Every written component an update visits is marked changed, whether or not the closure"},{"type":"text","text":" "},{"type":"text","text":"changes it."}]}]}],"hierarchy":{"paths":[["doc:\/\/Systems\/documentation\/Systems"]]},"sections":[],"relationshipsSections":[{"kind":"relationships","identifiers":["doc:\/\/Systems\/s8SendableP","doc:\/\/Systems\/s16SendableMetatypeP","doc:\/\/Systems\/documentation\/Systems\/SystemParameter"],"type":"conformsTo","title":"Conforms To"}],"seeAlsoSections":[{"identifiers":["doc:\/\/Systems\/documentation\/Systems\/SystemParameter","doc:\/\/Systems\/documentation\/Systems\/ResourceReader","doc:\/\/Systems\/documentation\/Systems\/ResourceWriter","doc:\/\/Systems\/documentation\/Systems\/EventReader","doc:\/\/Systems\/documentation\/Systems\/EventWriter","doc:\/\/Systems\/documentation\/Systems\/RemovedComponents"],"generated":true,"anchor":"System-Parameters","title":"System Parameters"}],"metadata":{"modules":[{"name":"Systems"}],"navigatorTitle":[{"kind":"identifier","text":"Update"}],"roleHeading":"Class","symbolKind":"class","fragments":[{"text":"class","kind":"keywor