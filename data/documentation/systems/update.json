ms\/Update\/Body"],"title":"Type Aliases","generated":true,"anchor":"Type-Aliases"}],"identifier":{"url":"doc:\/\/Systems\/documentation\/Systems\/Update","interfaceLanguage":"swift"},"primaryContentSections":[{"declarations":[{"platforms":["Linux"],"tokens":[{"text":"final","kind":"keyword"},{"text":" ","kind":"text"},{"text":"class","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Update","kind":"identifier"},{"text":"<","kind":"text"},{"text":"A","kind":"genericParameter"},{"text":"> ","kind":"text"},{"text":"where","kind":"keyword"},{"text":" ","kind":"text"},{"text":"A","kind":"typeIdentifier"},{"text":" : ","kind":"text"},{"text":"Component","kind":"typeIdentifier","identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/Component","preciseIdentifier":"s:11WorldModule9ComponentP"}],"languages":["swift"]}],"kind":"declarations"},{"kind":"content","content":[{"text":"Overview","type":"heading","level":2,"anchor":"overview"},{"inlineContent":[{"type":"text","text":"Call an update like a function, passing a closure that receives each entity’s component to"},{"type":"text","text":" "},{"type":"text","text":"change in place, and the entity. The update’s type says which entities it visits and what"},{"type":"text","text":" "},{"type":"text","text":"else it reads, by nesting:"}],"type":"paragraph"},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"Update<A>"},{"type":"text","text":" changes the "},{"type":"codeVoice","code":"A"},{"type":"text","text":" of every entity holding one."}]}]},{"content":[{"inlineContent":[{"code":"Update<A>.And<B>","type":"codeVoice"},{"text":" and ","type":"text"},{"code":"Update<A>.And<B>.And<C>","type":"codeVoice"},{"text":" change two or three components of every","type":"text"},{"text":" ","type":"text"},{"text":"entity holding all of them.","type":"text"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"code":".Over<T...>","type":"codeVoice"},{"type":"text","text