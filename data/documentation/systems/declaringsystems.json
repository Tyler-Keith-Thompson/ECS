n App","abstract":[{"text":"Hold a world in your app or game engine, feed it each frame’s input, and let the objects outside","type":"text"},{"text":" ","type":"text"},{"text":"it read results and take part in a step.","type":"text"}],"kind":"article","type":"topic","url":"\/documentation\/systems\/drivingaworldfromanapp"},"doc://Systems/documentation/Systems/System":{"navigatorTitle":[{"kind":"identifier","text":"System"}],"abstract":[{"text":"A rule that reads and changes a world, run once each time its schedule runs.","type":"text"}],"type":"topic","kind":"symbol","role":"symbol","identifier":"doc:\/\/Systems\/documentation\/Systems\/System","fragments":[{"kind":"keyword","text":"protocol"},{"kind":"text","text":" "},{"kind":"identifier","text":"System"}],"title":"System","url":"\/documentation\/systems\/system"},"doc://Systems/documentation/Systems/System/access":{"defaultImplementations":1,"kind":"symbol","url":"\/documentation\/systems\/system\/access","required":true,"title":"access","identifier":"doc:\/\/Systems\/documentation\/Systems\/System\/access","type":"topic","abstract":[{"text":"The component, resource and event types the system reads and writes, or ","type":"text"},{"code":"nil","type":"codeVoice"},{"text":" if it may","type":"text"},{"text":" ","type":"text"},{"text":"change anything.","type":"text"}],"fragments":[{"text":"var","kind":"keyword"},{"text":" ","kind":"text"},{"kind":"identifier","text":"access"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"Access","preciseIdentifier":"s:11WorldModule6AccessV"},{"kind":"text","text":"?"}],"role":"symbol"},"doc://Systems/documentation/Systems/System()":{"type":"topic","abstract":[{"type":"text","text":"Makes a type a system whose access comes from the parameters of its "},{"code":"run","type":"codeVoice"},{"type":"text","text":" method."}],"kind":"symbol","role":"symbol","identifier":"doc:\/\/Systems\/documentation\/Systems\/System()","fragments":[{"text":"macro","kind":"keyword"},{"text":" ","kind":"text"},{"text":"System","kind":"identifier"},{"text":"()","kind":"text"}],"title":"System()","url":"\/documentation\/systems\/system()"},"doc://Systems/documentation/Systems/ResourceWriter":{"url":"\/documentation\/systems\/resourcewriter","kind":"symbol","title":"ResourceWriter","identifier":"doc:\/\/Systems\/documentation\/Systems\/ResourceWriter","type":"topic","abstract":[{"text":"A system parameter that reads and writes a resource.","type":"text"}],"fragments":[{"kind":"keyword","text":"class"},{"kind":"text","text":" "},{"kind":"identifier","text":"ResourceWriter"}],"navigatorTitle":[{"kind":"identifier","text":"ResourceWriter"}],"role":"symbol"},"doc://WorldModule/documentation/WorldModule/Query":{"role":"symbol","identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/Query","title":"Query","navigatorTitle":[{"kind":"identifier","text":"Query"}],"abstract":[{"type":"text","text":"A description of the entities to visit and the components to read from each."}],"kind":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"Query"}],"type":"topic","url":"\/documentation\/worldmodule\/query"},"doc://Systems/documentation/Systems/MainActorSystem":{"navigatorTitle":[{"kind":"identifier","text":"MainActorSystem"}],"abstract":[{"text":"A system that runs on the main actor, for work that touches main-actor state such as a user","type":"text"},{"text":" ","type":"text"},{"text":"interface.","type":"text"}],"type":"topic","kind":"symbol","role":"symbol","identifier":"doc:\/\/Systems\/documentation\/Systems\/MainActorSystem","fragments":[{"kind":"keyword","text":"protocol"},{"kind":"text","text":" "},{"kind":"identifier","text":"MainActorSystem"}],"title":"MainActorSystem","url":"\/documentation\/systems\/mainactorsystem"},"doc://Systems/documentation/Systems/EventReader":{"navigatorTitle":[{"kind":"identifier","text":"EventReader"}],"type":"topic","abstract":[{"type":"text","text":"A system parameter that reads the events of one type sent since the system last read them."}],"kind":"symbol","role":"symbol","identifier":"doc:\/\/Systems\/documentation\/Systems\/EventReader","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"EventReader"}],"title":"EventReader","url":"\/documentation\/systems\/eventreader"},"doc://Systems/documentation/Systems/System/run(in:)":{"url":"\/documentation\/systems\/system\/run(in:)","type":"topic","identifier":"doc:\/\/Systems\/documentation\/Systems\/System\/run(in:)","kind":"symbol","required":true,"fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"run"},{"kind":"text","text":"("},{"kind":"externalParam","text":"in"},{"kind":"text","text":": "},{"kind":"keyword","text":"inout"},{"kind":"text","text":" "},{"kind":"typeIdentifier","preciseIdentifier":"s:11WorldModule0A0V","text":"World"},{"kind":"text","text":")"}],"title":"run(in:)","role":"symbol","abstract":[{"text":"Runs the system’s rule once on a world.","type":"text"}]},"doc://Systems/documentation/Systems/Update":{"url":"\/documentation\/systems\/update","kind":"symbol","title":"Update","identifier":"doc:\/\/Systems\/documentation\/Systems\/Update","type":"topic","abstract":[{"type":"text","text":"A system parameter that changes a component of every entity that holds it."}],"fragments":[{"kind":"keyword","text":"class"},{"kind":"text","text":" "},{"kind":"identifier","text":"Update"}],"navigatorTitle":[{"kind":"identifier","text":"Update"}],"role":"symbol"},"doc://Systems/documentation/Systems":{"abstract":[{"type":"text","text":"Declare the rules of a simulation as systems, and run them on a world in a schedule."}],"type":"topic","kind":"symbol","role":"collection","identifier":"doc:\/\/Systems\/documentation\/Systems","title":"Systems","url":"\/documentation\/systems"},"doc://Systems/documentation/Systems/ResourceReader":{"kind":"symbol","url":"\/documentation\/systems\/resourcereader","title":"ResourceReader","identifier":"doc:\/\/Systems\/documentation\/Systems\/ResourceReader","type":"topic","abstract":[{"text":"A system parameter that reads a resource.","type":"text"}],"fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"ResourceReader","kind":"identifier"}],"navigatorTitle":[{"text":"ResourceReader","kind":"identifier"}],"role":"symbol"},"doc://Systems/documentation/Systems/EventWriter":{"navigatorTitle":[{"kind":"identifier","text":"EventWriter"}],"type":"topic","abstract":[{"text":"A system parameter that sends events of one type.","type":"text"}],"kind":"symbol","role":"symbol","identifier":"doc:\/\/Systems\/documentation\/Systems\/EventWriter","fragments":[{"kind":"keyword","text":"class"},{"kind":"text","text":" "},{"kind":"identifier","text":"EventWriter"}],"title":"EventWriter","url":"\/documentation\/systems\/eventwriter"}}}