{"schemaVersion":{"patch":0,"minor":3,"major":0},"kind":"article","metadata":{"title":"Declaring Systems","role":"collectionGroup","modules":[{"name":"Systems"}],"roleHeading":"API Collection"},"identifier":{"url":"doc:\/\/Systems\/documentation\/Systems\/DeclaringSystems","interfaceLanguage":"swift"},"abstract":[{"type":"text","text":"Write the rules of a simulation as systems, and let their parameters state what they read and"},{"type":"text","text":" "},{"type":"text","text":"write."}],"topicSections":[{"title":"Declaring Systems","anchor":"Declaring-Systems","identifiers":["doc:\/\/Systems\/documentation\/Systems\/System()","doc:\/\/Systems\/documentation\/Systems\/System","doc:\/\/Systems\/documentation\/Systems\/MainActorSystem"]},{"title":"System Parameters","anchor":"System-Parameters","identifiers":["doc:\/\/Systems\/documentation\/Systems\/Update","doc:\/\/Systems\/documentation\/Systems\/ResourceReader","doc:\/\/Systems\/documentation\/Systems\/ResourceWriter","doc:\/\/Systems\/documentation\/Systems\/EventReader","doc:\/\/Systems\/documentation\/Systems\/EventWriter","doc:\/\/Systems\/documentation\/Systems\/RemovedComponents"]}],"primaryContentSections":[{"kind":"content","content":[{"text":"Overview","level":2,"type":"heading","anchor":"Overview"},{"inlineContent":[{"text":"A system is a type with a ","type":"text"},{"code":"run","type":"codeVoice"},{"text":" method that a schedule calls once per run. The ","type":"text"},{"identifier":"doc:\/\/Systems\/documentation\/Systems\/System()","type":"reference","isActive":true},{"text":" ","type":"text"},{"text":"macro turns a structure into a system from the parameters of its ","type":"text"},{"code":"run","type":"codeVoice"},{"text":" method. Each parameter’s","type":"text"},{"text":" ","type":"text"},{"text":"type says what part of the world the system works on and whether it reads or writes it, so the","type":"text"},{"text":" ","type":"text"},{"text":"system’s ","type":"text"},{"identifier":"doc:\/\/Systems\/documentation\/Systems\/System\/access","type":"reference","isActive":true},{"text":" is always exact, and a schedule can run systems that don’t conflict at","type":"text"},{"text":" ","type":"text"},{"text":"the same time.","type":"text"}],"type":"paragraph"},{"text":"Read and Write Components","level":3,"type":"heading","anchor":"Read-and-Write-Components"},{"inlineContent":[{"text":"Take a ","type":"text"},{"identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/Query","isActive":true,"type":"reference"},{"text":" to read components, and iterate it as you would a world’s query","type":"text"},{"text":" ","type":"text"},{"text":"results. Take an ","type":"text"},{"identifier":"doc:\/\/Systems\/documentation\/Systems\/Update","isActive":true,"type":"reference"},{"text":" to change them in place. An","type":"text"},{"text":" ","type":"text"},{"text":"update can also read other components with ","type":"text"},{"code":"Over","type":"codeVoice"},{"text":", and narrow the entities it visits with","type":"text"},{"text":" ","type":"text"},{"code":"Where","type":"codeVoice"},{"text":":","type":"text"}],"type":"paragraph"},{"code":["@System","struct Climb {","    func run(_ climbers: Update<Position>.Over<Velocity>.Where<Without<Frozen>>) {","        climbers { position, row in","            position.y += abs(row.components.dy)","        }","    }","}","","var world = World()","let climber = world.spawn(Position(x: 0, y: 0), Velocity(dx: 0, dy: -3))","let statue = world.spawn(Position(x: 0, y: 0), Velocity(dx: 0, dy: -3), Frozen())","Schedule { Climb() }.run(on: &world)","","print(world[Position.self, of: climber].y)","\/\/ Prints \"3.0\"","print(world[Position.self, of: statue].y)","\/\/ Prints \"0.0\""],"type":"codeListing","syntax":"swift"},{"inlineContent":[{"code":"Climb","type":"codeVoice"},{"text":" writes ","type":"text"},{"code":"Position","type":"codeVoice"},{"text":" and reads ","type":"text"},{"code":"Velocity","type":"codeVoice"},{"text":" and ","type":"text"},{"code":"Frozen","type":"codeVoice"},{"text":". It conflicts with any system that","type":"text"},{"text":" ","type":"text"},{"text":"writes ","type":"text"},{"code":"Velocity","type":"codeVoice"},{"text":" or ","type":"text"},{"code":"Frozen","type":"codeVoice"},{"text":", or reads or writes ","type":"text"},{"code":"Position","type":"codeVoice"},{"text":", and runs at the same time as any","type":"text"},{"text":" ","type":"text"},{"text":"other.","type":"text"}],"type":"paragraph"},{"text":"Read and Write Resources and Events","level":3,"type":"heading","anchor":"Read-and-Write-Resources-and-Events"},{"inlineContent":[{"text":"A ","type":"text"},{"identifier":"doc:\/\/Systems\/documentation\/Systems\/ResourceReader","isActive":true,"type":"reference"},{"text":" reads a resource and a ","type":"text"},{"identifier":"doc:\/\/Systems\/documentation\/Systems\/ResourceWriter","isActive":true,"type":"reference"},{"text":" changes one. An ","type":"text"},{"identifier":"doc:\/\/Systems\/documentation\/Systems\/EventWriter","isActive":true,"type":"reference"},{"text":" ","type":"text"},{"text":"sends events, and an ","type":"text"},{"identifier":"doc:\/\/Systems\/documentation\/Systems\/EventReader","isActive":true,"type":"reference"},{"text":" reads the events sent since the system last read them. The","type":"text"},{"text":" ","type":"text"},{"text":"following schedule sends a ","type":"text"},{"code":"Damage","type":"codeVoice"},{"text":" event for each entity below the ground, then applies the","type":"text"},{"text":" ","type":"text"},{"text":"damage to its target’s health:","type":"text"}],"type":"paragraph"},{"code":["var world = World()","let knight = world.spawn(Position(x: 0, y: -1), Health(current: 30))","","let frame = Schedule {","    UpdateEvents()","    Combat()","    ApplyDamage().after(Combat.self)","}","frame.run(on: &world)","print(world[Health.self, of: knight].current)","\/\/ Prints \"20\""],"type":"codeListing","syntax":"swift"},{"inlineContent":[{"identifier":"doc:\/\/Systems\/documentation\/Systems\/EventWriter","isActive":true,"type":"reference"},{"text":" declares ","type":"text"},{"code":"Combat","type":"codeVoice"},{"text":", and ","type":"text"},{"identifier":"doc:\/\/Systems\/documentation\/Systems\/EventReader","isActive":true,"type":"reference"},{"text":" declares ","type":"text"},{"code":"ApplyDamage","type":"codeVoice"},{"text":".","type":"text"}],"type":"paragraph"},{"text":"Spawn and Despawn Entities","level":3,"type":"heading","anchor":"Spawn-and-Despawn-Entities"},{"inlineContent":[{"text":"A system that runs alongside others can’t spawn or despawn entities directly, because that","type":"text"},{"text":" ","type":"text"},{"text":"changes every component type at once. Take an ","type":"text"},{"type":"codeVoice","code":"inout"},{"text":" ","type":"text"},{"type":"reference","identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/Commands","isActive":true},{"text":" instead, and queue","type":"text"},{"text":" ","type":"text"},{"text":"the changes. Commands apply at the end of the wave the system runs in, so systems ordered after","type":"text"},{"text":" ","type":"text"},{"text":"it see them:","type":"text"}],"type":"paragraph"},{"code":["@System","struct RemoveDefeated {","    func run(_ fighters: Query<Health>, _ commands: inout Commands) {","        for (entity, health) in fighters where health.current <= 0 {","            commands.despawn(entity)","        }","    }","}","","var world = World()","let knight = world.spawn(Health(current: 0))","world.spawn(Health(current: 12))","Schedule { RemoveDefeated() }.run(on: &world)","","print(world.contains(knight))","\/\/ Prints \"false\"","print(world.count)","\/\/ Prints \"1\""],"type":"codeListing","syntax":"swift"},{"inlineContent":[{"text":"A commands parameter conflicts with nothing, so it doesn’t stop a system from running at the","type":"text"},{"text":" ","type":"text"},{"text":"same time as others.","type":"text"}],"type":"paragraph"},{"text":"Take the Whole World","level":3,"type":"heading","anchor":"Take-the-Whole-World"},{"inlineContent":[{"type":"text","text":"A "},{"type":"codeVoice","code":"run"},{"type":"text","text":" method that takes "},{"type":"codeVoice","code":"inout World"},{"type":"text","text":" makes a system that can change anything. Its access is"},{"type":"text","text":" "},{"type":"codeVoice","code":"nil"},{"type":"text","text":", so a schedule runs it alone, after the systems written before it and before those written"},{"type":"text","text":" "},{"type":"text","text":"after it. Use one for work that touches many types at once, such as loading a level."}],"type":"paragraph"},{"inlineContent":[{"text":"To write a system by hand instead of with the macro, conform a type to ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/Systems\/documentation\/Systems\/System"},{"text":", implement","type":"text"},{"text":" ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/Systems\/documentation\/Systems\/System\/run(in:)"},{"text":", and declare an ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/Systems\/documentation\/Systems\/System\/access"},{"text":" listing every type the system reads and","type":"text"},{"text":" ","type":"text"},{"text":"writes.","type":"text"}],"type":"paragraph"},{"text":"Run on the Main Actor","level":3,"type":"heading","anchor":"Run-on-the-Main-Actor"},{"inlineContent":[{"type":"text","text":"Mark a system type, or its "},{"code":"run","type":"codeVoice"},{"type":"text","text":" method, "},{"code":"@MainActor","type":"codeVoice"},{"type":"text","text":" to make a "},{"isActive":true,"type":"reference","identifier":"doc:\/\/Systems\/documentation\/Systems\/MainActorSystem"},{"type":"text","text":", which a"},{"type":"text","text":" "},{"type":"text","text":"schedule runs on the main actor after the other systems of its wave. Use one to carry results"},{"type":"text","text":" "},{"type":"text","text":"from the world to a user interface."}],"type":"paragraph"}]}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/systems\/declaringsystems"]}],"sections":[],"seeAlsoSections":[{"generated":true,"title":"Essentials","anchor":"Essentials","identifiers":["doc:\/\/Systems\/documentation\/Systems\/DrivingAWorldFromAnApp","doc:\/\/Systems\/documentation\/Systems\/System()","doc:\/\/Systems\/documentation\/Systems\/System"]}],"hierarchy":{"paths":[["doc:\/\/Systems\/documentation\/Systems"]]},"references":{"doc://Systems/documentation/Systems/Update":{"title":"Update","role":"symbol","navigatorTitle":[{"kind":"identifier","text":"Update"}],"type":"topic","url":"\/documentation\/systems\/update","kind":"symbol","identifier":"doc:\/\/Systems\/documentation\/Systems\/Update","abstract":[{"type":"text","text":"A system parameter that changes a component of every entity that holds it."}],"fragments":[{"kind":"keyword","text":"class"},{"kind":"text","text":" "},{"kind":"identifier","text":"Update"}]},"doc://Systems/documentation/Systems/EventReader":{"navigatorTitle":[{"text":"EventReader","kind":"identifier"}],"title":"EventReader","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"EventReader","kind":"identifier"}],"type":"topic","url":"\/documentation\/systems\/eventreader","abstract":[{"type":"text","text":"A system parameter that reads the events of one type sent since the system last read them."}],"kind":"symbol","role":"symbol","identifier":"doc:\/\/Systems\/documentation\/Systems\/EventReader"},"doc://Systems/documentation/Systems/System/run(in:)":{"title":"run(in:)","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"run"},{"kind":"text","text":"("},{"kind":"externalParam","text":"in"},{"kind":"text","text":": "},{"kind":"keyword","text":"inout"},{"kind":"text","text":" "},{"kind":"typeIdentifier","preciseIdentifier":"s:11WorldModule0A0V","text":"World"},{"kind":"text","text":")"}],"type":"topic","abstract":[{"text":"Runs the system’s rule once on a world.","type":"text"}],"url":"\/documentation\/systems\/system\/run(in:)","kind":"symbol","required":true,"role":"symbol","identifier":"doc:\/\/Systems\/documentation\/Systems\/System\/run(in:)"},"doc://WorldModule/documentation/WorldModule/Commands":{"identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/Commands","title":"Commands","role":"symbol","url":"\/documentation\/worldmodule\/commands","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"Commands"}],"abstract":[{"type":"text","text":"A buffer of changes to a world, recorded now and applied later in the order they were"},{"type":"text","text":" "},{"type":"text","text":"recorded."}],"navigatorTitle":[{"kind":"identifier","text":"Commands"}],"type":"topic","kind":"symbol"},"doc://Systems/documentation/Systems/ResourceWriter":{"title":"ResourceWriter","identifier":"doc:\/\/Systems\/documentation\/Systems\/ResourceWriter","role":"symbol","url":"\/documentation\/systems\/resourcewriter","fragments":[{"text":"class","kind":"keyword"},{"text":" ","kind":"text"},{"text":"ResourceWriter","kind":"identifier"}],"abstract":[{"type":"text","text":"A system parameter that reads and writes a resource."}],"navigatorTitle":[{"text":"ResourceWriter","kind":"identifier"}],"type":"topic","kind":"symbol"},"doc://Systems/documentation/Systems/ResourceReader":{"title":"ResourceReader","kind":"symbol","role":"symbol","url":"\/documentation\/systems\/resourcereader","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"ResourceReader","kind":"identifier"}],"abstract":[{"type":"text","text":"A system parameter that reads a resource."}],"navigatorTitle":[{"text":"ResourceReader","kind":"identifier"}],"type":"topic","identifier":"doc:\/\/Systems\/documentation\/Systems\/ResourceReader"},"doc://Systems/documentation/Systems/MainActorSystem":{"title":"MainActorSystem","role":"symbol","navigatorTitle":[{"kind":"identifier","text":"MainActorSystem"}],"type":"topic","url":"\/documentation\/systems\/mainactorsystem","kind":"symbol","identifier":"doc:\/\/Systems\/documentation\/Systems\/MainActorSystem","abstract":[{"type":"text","text":"A system that runs on the main actor, for work that touches main-actor state such as a user"},{"type":"text","text":" "},{"type":"text","text":"interface."}],"fragments":[{"kind":"keyword","text":"protocol"},{"kind":"text","text":" "},{"kind":"identifier","text":"MainActorSystem"}]},"doc://Systems/documentation/Systems/System/access":{"abstract":[{"type":"text","text":"The component, resource and event types the system reads and writes, or "},{"type":"codeVoice","code":"nil"},{"type":"text","text":" if it may"},{"type":"text","text":" "},{"type":"text","text":"change anything."}],"role":"symbol","fragments":[{"kind":"keyword","text":"var"},{"kind":"text","text":" "},{"text":"access","kind":"identifier"},{"text":": ","kind":"text"},{"text":"Access","kind":"typeIdentifier","preciseIdentifier":"s:11WorldModule6AccessV"},{"text":"?","kind":"text"}],"defaultImplementations":1,"url":"\/documentation\/systems\/system\/access","required":true,"kind":"symbol","type":"topic","identifier":"doc:\/\/Systems\/documentation\/Systems\/System\/access","title":"access"},"doc://Systems/documentation/Systems/RemovedComponents":{"title":"RemovedComponents","role":"symbol","navigatorTitle":[{"kind":"identifier","text":"RemovedComponents"}],"type":"topic","url":"\/documentation\/systems\/removedcomponents","kind":"symbol","abstract":[{"type":"text","text":"A system parameter that lists the entities that lost a component since the system last read"},{"type":"text","text":" "},{"type":"text","text":"them."}],"identifier":"doc:\/\/Systems\/documentation\/Systems\/RemovedComponents","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"RemovedComponents"}]},"doc://Systems/documentation/Systems/DrivingAWorldFromAnApp":{"title":"Driving a World from an App","type":"topic","url":"\/documentation\/systems\/drivingaworldfromanapp","abstract":[{"type":"text","text":"Hold a world in your app or game engine, feed it each frame’s input, and let the objects outside"},{"type":"text","text":" "},{"type":"text","text":"it read results and take part in a step."}],"kind":"article","role":"article","identifier":"doc:\/\/Systems\/documentation\/Systems\/DrivingAWorldFromAnApp"},"doc://WorldModule/documentation/WorldModule/Query":{"navigatorTitle":[{"kind":"identifier","text":"Query"}],"kind":"symbol","identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/Query","abstract":[{"type":"text","text":"A description of the entities to visit and the components to read from each."}],"url":"\/documentation\/worldmodule\/query","title":"Query","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"Query"}],"type":"topic","role":"symbol"},"doc://Systems/documentation/Systems":{"kind":"symbol","url":"\/documentation\/systems","title":"Systems","role":"collection","type":"topic","identifier":"doc:\/\/Systems\/documentation\/Systems","abstract":[{"text":"Declare the rules of a simulation as systems, and run them on a world in a schedule.","type":"text"}]},"doc://Systems/documentation/Systems/System":{"kind":"symbol","url":"\/documentation\/systems\/system","fragments":[{"kind":"keyword","text":"protocol"},{"kind":"text","text":" "},{"kind":"identifier","text":"System"}],"title":"System","role":"symbol","type":"topic","identifier":"doc:\/\/Systems\/documentation\/Systems\/System","navigatorTitle":[{"kind":"identifier","text":"System"}],"abstract":[{"type":"text","text":"A rule that reads and changes a world, run once each time its schedule runs."}]},"doc://Systems/documentation/Systems/System()":{"kind":"symbol","abstract":[{"type":"text","text":"Makes a type a system whose access comes from the parameters of its "},{"type":"codeVoice","code":"run"},{"type":"text","text":" method."}],"role":"symbol","type":"topic","identifier":"doc:\/\/Systems\/documentation\/Systems\/System()","fragments":[{"kind":"keyword","text":"macro"},{"kind":"text","text":" "},{"kind":"identifier","text":"System"},{"kind":"text","text":"()"}],"url":"\/documentation\/systems\/system()","title":"System()"},"doc://Systems/documentation/Systems/EventWriter":{"kind":"symbol","title":"EventWriter","role":"symbol","url":"\/documentation\/systems\/eventwriter","fragments":[{"text":"class","kind":"keyword"},{"text":" ","kind":"text"},{"text":"EventWriter","kind":"identifier"}],"abstract":[{"type":"text","text":"A system parameter that sends events of one type."}],"navigatorTitle":[{"text":"EventWriter","kind":"identifier"}],"type":"topic","identifier":"doc:\/\/Systems\/documentation\/Systems\/EventWriter"}}}