{"kind":"article","identifier":{"url":"doc:\/\/Systems\/documentation\/Systems\/DeclaringSystems","interfaceLanguage":"swift"},"abstract":[{"type":"text","text":"Write the rules of a simulation as systems, and let their parameters state what they read and"},{"type":"text","text":" "},{"type":"text","text":"write."}],"seeAlsoSections":[{"identifiers":["doc:\/\/Systems\/documentation\/Systems\/DrivingAWorldFromAnApp","doc:\/\/Systems\/documentation\/Systems\/System()","doc:\/\/Systems\/documentation\/Systems\/System"],"generated":true,"anchor":"Essentials","title":"Essentials"}],"topicSections":[{"identifiers":["doc:\/\/Systems\/documentation\/Systems\/System()","doc:\/\/Systems\/documentation\/Systems\/System","doc:\/\/Systems\/documentation\/Systems\/MainActorSystem"],"anchor":"Declaring-Systems","title":"Declaring Systems"},{"identifiers":["doc:\/\/Systems\/documentation\/Systems\/Update","doc:\/\/Systems\/documentation\/Systems\/ResourceReader","doc:\/\/Systems\/documentation\/Systems\/ResourceWriter","doc:\/\/Systems\/documentation\/Systems\/EventReader","doc:\/\/Systems\/documentation\/Systems\/EventWriter","doc:\/\/Systems\/documentation\/Systems\/RemovedComponents"],"anchor":"System-Parameters","title":"System Parameters"}],"schemaVersion":{"patch":0,"major":0,"minor":3},"hierarchy":{"paths":[["doc:\/\/Systems\/documentation\/Systems"]]},"primaryContentSections":[{"kind":"content","content":[{"type":"heading","level":2,"anchor":"Overview","text":"Overview"},{"type":"paragraph","inlineContent":[{"type":"text","text":"A system is a type with a "},{"code":"run","type":"codeVoice"},{"type":"text","text":" method that a schedule calls once per run. The "},{"isActive":true,"type":"reference","identifier":"doc:\/\/Systems\/documentation\/Systems\/System()"},{"type":"text","text":" "},{"type":"text","text":"macro turns a structure into a system from the parameters of its "},{"code":"run","type":"codeVoice"},{"type":"text","text":" method. Each parameter’s"},{"type":"text","text":" "},{"type":"text","text":"type says what part of the world the system works on and whether it reads or writes it, so the"},{"type":"text","text":" "},{"type":"text","text":"system’s "},{"isActive":true,"type":"reference","identifier":"doc:\/\/Systems\/documentation\/Systems\/System\/access"},{"type":"text","text":" is always exact, and a schedule can run systems that don’t conflict at"},{"type":"text","text":" "},{"type":"text","text":"the same time."}]},{"type":"heading","level":3,"anchor":"Read-and-Write-Components","text":"Read and Write Components"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Take a "},{"identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/Query","type":"reference","isActive":true},{"type":"text","text":" to read components, and iterate it as you would a world’s query"},{"type":"text","text":" "},{"type":"text","text":"results. Take an "},{"identifier":"doc:\/\/Systems\/documentation\/Systems\/Update","type":"reference","isActive":true},{"type":"text","text":" to change them in place. An"},{"type":"text","text":" "},{"type":"text","text":"update can also read other components with "},{"code":"Over","type":"codeVoice"},{"type":"text","text":", and narrow the entities it visits with"},{"type":"text","text":" "},{"code":"Where","type":"codeVoice"},{"type":"text","text":":"}]},{"type":"codeListing","syntax":"swift","code":["@System","struct Climb {","    func run(_ climbers: Update<Position>.Over<Velocity>.Where<Without<Frozen>>) {","        climbers { position, row in","            position.y += abs(row.components.dy)","        }","    }","}","","var world = World()","let climber = world.spawn(Position(x: 0, y: 0), Velocity(dx: 0, dy: -3))","let statue = world.spawn(Position(x: 0, y: 0), Velocity(dx: 0, dy: -3), Frozen())","Schedule { Climb() }.run(on: &world)","","print(world[Position.self, of: climber].y)","\/\/ Prints \"3.0\"","print(world[Position.self, of: statue].y)","\/\/ Prints \"0.0\""]},{"type":"paragraph","inlineContent":[{"code":"Climb","type":"codeVoice"},{"type":"text","text":" writes "},{"code":"Position","type":"codeVoice"},{"type":"text","text":" and reads "},{"code":"Velocity","type":"codeVoice"},{"type":"text","text":" and "},{"code":"Frozen","type":"codeVoice"},{"type":"text","text":". It conflicts with any system that"},{"type":"text","text":" "},{"type":"text","text":"writes "},{"code":"Velocity","type":"codeVoice"},{"type":"text","text":" or "},{"code":"Frozen","type":"codeVoice"},{"type":"text","text":", or reads or writes "},{"code":"Position","type":"codeVoice"},{"type":"text","text":", and runs at the same time as any"},{"type":"text","text":" "},{"type":"text","text":"other."}]},{"type":"heading","level":3,"anchor":"Read-and-Write-Resources-and-Events","text":"Read and Write Resources and Events"},{"type":"paragraph","inlineContent":[{"type":"text","text":"A "},{"type":"reference","isActive":true,"identifier":"doc:\/\/Systems\/documentation\/Systems\/ResourceReader"},{"type":"text","text":" reads a resource and a "},{"type":"reference","isActive":true,"identifier":"doc:\/\/Systems\/documentation\/Systems\/ResourceWriter"},{"type":"text","text":" changes one. An "},{"type":"reference","isActive":true,"identifier":"doc:\/\/Systems\/documentation\/Systems\/EventWriter"},{"type":"text","text":" "},{"type":"text","text":"sends events, and an "},{"type":"reference","isActive":true,"identifier":"doc:\/\/Systems\/documentation\/Systems\/EventReader"},{"type":"text","text":" reads the events sent since the system last read them. The"},{"type":"text","text":" "},{"type":"text","text":"following schedule sends a "},{"type":"codeVoice","code":"Damage"},{"type":"text","text":" event for each entity below the ground, then applies the"},{"type":"text","text":" "},{"type":"text","text":"damage to its target’s health:"}]},{"type":"codeListing","syntax":"swift","code":["var world = World()","let knight = world.spawn(Position(x: 0, y: -1), Health(current: 30))","","let frame = Schedule {","    UpdateEvents()","    Combat()","    ApplyDamage().after(Combat.self)","}","frame.run(on: &world)","print(world[Health.self, of: knight].current)","\/\/ Prints \"20\""]},{"type":"paragraph","inlineContent":[{"type":"reference","isActive":true,"identifier":"doc:\/\/Systems\/documentation\/Systems\/EventWriter"},{"type":"text","text":" declares "},{"type":"codeVoice","code":"Combat"},{"type":"text","text":", and "},{"type":"reference","isActive":true,"identifier":"doc:\/\/Systems\/documentation\/Systems\/EventReader"},{"type":"text","text":" declares "},{"type":"codeVoice","code":"ApplyDamage"},{"type":"text","text":"."}]},{"type":"heading","level":3,"anchor":"Spawn-and-Despawn-Entities","text":"Spawn and Despawn Entities"},{"type":"paragraph","inlineContent":[{"text":"A system that runs alongside others can’t spawn or despawn entities directly, because that","type":"text"},{"text":" ","type":"text"},{"text":"changes every component type at once. Take an ","type":"text"},{"code":"inout","type":"codeVoice"},{"text":" ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/Commands"},{"text":" instead, and queue","type":"text"},{"text":" ","type":"text"},{"text":"the changes. Commands apply at the end of the wave the system runs in, so systems ordered after","type":"text"},{"text":" ","type":"text"},{"text":"it see them:","type":"text"}]},{"type":"codeListing","syntax":"swift","code":["@System","struct RemoveDefeated {","    func run(_ fighters: Query<Health>, _ commands: inout Commands) {","        for (entity, health) in fighters where health.current <= 0 {","            commands.despawn(entity)","        }","    }","}","","var world = World()","let knight = world.spawn(Health(current: 0))","world.spawn(Health(current: 12))","Schedule { RemoveDefeated() }.run(on: &world)","","print(world.contains(knight))","\/\/ Prints \"false\"","print(world.count)","\/\/ Prints \"1\""]},{"type":"paragraph","inlineContent":[{"text":"A commands parameter conflicts with nothing, so it doesn’t stop a system from running at the","type":"text"},{"text":" ","type":"text"},{"text":"same time as others.","type":"text"}]},{"type":"heading","level":3,"anchor":"Take-the-Whole-World","text":"Take the Whole World"},{"type":"paragraph","inlineContent":[{"text":"A ","type":"text"},{"type":"codeVoice","code":"run"},{"text":" method that takes ","type":"text"},{"type":"codeVoice","code":"inout World"},{"text":" makes a system that can change anything. Its access is","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"nil"},{"text":", so a schedule runs it alone, after the systems written before it and before those written","type":"text"},{"text":" ","type":"text"},{"text":"after it. Use one for work that touches many types at once, such as loading a level.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"To write a system by hand instead of with the macro, conform a type to ","type":"text"},{"type":"reference","isActive":true,"identifier":"doc:\/\/Systems\/documentation\/Systems\/System"},{"text":", implement","type":"text"},{"text":" ","type":"text"},{"type":"reference","isActive":true,"identifier":"doc:\/\/Systems\/documentation\/Systems\/System\/run(in:)"},{"text":", and declare an ","type":"text"},{"type":"reference","isActive":true,"identifier":"doc:\/\/Systems\/documentation\/Systems\/System\/access"},{"text":" listing every type the system reads and","type":"text"},{"text":" ","type":"text"},{"text":"writes.","type":"text"}]},{"type":"heading","level":3,"anchor":"Run-on-the-Main-Actor","text":"Run on the Main Actor"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Mark a system type, or its "},{"type":"codeVoice","code":"run"},{"type":"text","text":" method, "},{"type":"codeVoice","code":"@MainActor"},{"type":"text","text":" to make a "},{"identifier":"doc:\/\/Systems\/documentation\/Systems\/MainActorSystem","type":"reference","isActive":true},{"type":"text","text":", which a"},{"type":"text","text":" "},{"type":"text","text":"schedule runs on the main actor after the other systems of its wave. Use one to carry results"},{"type":"text","text":" "},{"type":"text","text":"from the world to a user interface."}]}]}],"metadata":{"modules":[{"name":"Systems"}],"role":"collectionGroup","roleHeading":"API Collection","title":"Declaring Systems"},"variants":[{"paths":["\/documentation\/systems\/declaringsystems"],"traits":[{"interfaceLanguage":"swift"}]}],"sections":[],"references":{"doc://Systems/documentation/Systems/EventReader":{"identifier":"doc:\/\/Systems\/documentation\/Systems\/EventReader","abstract":[{"text":"A system parameter that reads the events of one type sent since the system last read them.","type":"text"}],"type":"topic","role":"symbol","title":"EventReader","url":"\/documentation\/systems\/eventreader","kind":"symbol","navigatorTitle":[{"text":"EventReader","kind":"identifier"}],"fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"EventReader","kind":"identifier"}]},"doc://WorldModule/documentation/WorldModule/Commands":{"abstract":[{"type":"text","text":"A buffer of changes to a world, recorded now and applied later in the order they were"},{"type":"text","text":" "},{"type":"text","text":"recorded."}],"title":"Commands","type":"topic","url":"\/documentation\/worldmodule\/commands","kind":"symbol","identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/Commands","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"Commands"}],"role":"symbol","navigatorTitle":[{"kind":"identifier","text":"Commands"}]},"doc://Systems/documentation/Systems/System":{"abstract":[{"text":"A rule that reads and changes a world, run once each time its schedule runs.","type":"text"}],"kind":"symbol","type":"topic","fragments":[{"text":"protocol","kind":"keyword"},{"text":" ","kind":"text"},{"text":"System","kind":"identifier"}],"identifier":"doc:\/\/Systems\/documentation\/Systems\/System","navigatorTitle":[{"text":"System","kind":"identifier"}],"title":"System","url":"\/documentation\/systems\/system","role":"symbol"},"doc://Systems/documentation/Systems/ResourceReader":{"identifier":"doc:\/\/Systems\/documentation\/Systems\/ResourceReader","kind":"symbol","type":"topic","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"ResourceReader","kind":"identifier"}],"abstract":[{"text":"A system parameter that reads a resource.","type":"text"}],"role":"symbol","navigatorTitle":[{"text":"ResourceReader","kind":"identifier"}],"title":"ResourceReader","url":"\/documentation\/systems\/resourcereader"},"doc://Systems/documentation/Systems/EventWriter":{"title":"EventWriter","identifier":"doc:\/\/Systems\/documentation\/Systems\/EventWriter","type":"topic","fragments":[{"kind":"keyword","text":"class"},{"kind":"text","text":" "},{"kind":"identifier","text":"EventWriter"}],"abstract":[{"type":"text","text":"A system parameter that sends events of one type."}],"role":"symbol","navigatorTitle":[{"kind":"identifier","text":"EventWriter"}],"kind":"symbol","url":"\/documentation\/systems\/eventwriter"},"doc://Systems/documentation/Systems/MainActorSystem":{"abstract":[{"text":"A system that runs on the main actor, for work that touches main-actor state such as a user","type":"text"},{"text":" ","type":"text"},{"text":"interface.","type":"text"}],"kind":"symbol","url":"\/documentation\/systems\/mainactorsystem","role":"symbol","navigatorTitle":[{"text":"MainActorSystem","kind":"identifier"}],"fragments":[{"text":"protocol","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MainActorSystem","kind":"identifier"}],"identifier":"doc:\/\/Systems\/documentation\/Systems\/MainActorSystem","type":"topic","title":"MainActorSystem"},"doc://Systems/documentation/Systems/System/run(in:)":{"url":"\/documentation\/systems\/system\/run(in:)","identifier":"doc:\/\/S