{"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/Systems\/documentation\/Systems\/DeclaringSystems"},"metadata":{"roleHeading":"API Collection","role":"collectionGroup","title":"Declaring Systems","modules":[{"name":"Systems"}]},"topicSections":[{"title":"Declaring Systems","identifiers":["doc:\/\/Systems\/documentation\/Systems\/System()","doc:\/\/Systems\/documentation\/Systems\/System","doc:\/\/Systems\/documentation\/Systems\/MainActorSystem"],"anchor":"Declaring-Systems"},{"title":"System Parameters","identifiers":["doc:\/\/Systems\/documentation\/Systems\/Update","doc:\/\/Systems\/documentation\/Systems\/ResourceReader","doc:\/\/Systems\/documentation\/Systems\/ResourceWriter","doc:\/\/Systems\/documentation\/Systems\/EventReader","doc:\/\/Systems\/documentation\/Systems\/EventWriter","doc:\/\/Systems\/documentation\/Systems\/RemovedComponents"],"anchor":"System-Parameters"}],"seeAlsoSections":[{"title":"Essentials","identifiers":["doc:\/\/Systems\/documentation\/Systems\/DrivingAWorldFromAnApp","doc:\/\/Systems\/documentation\/Systems\/System()","doc:\/\/Systems\/documentation\/Systems\/System"],"generated":true,"anchor":"Essentials"}],"schemaVersion":{"major":0,"minor":3,"patch":0},"hierarchy":{"paths":[["doc:\/\/Systems\/documentation\/Systems"]]},"primaryContentSections":[{"kind":"content","content":[{"text":"Overview","anchor":"Overview","type":"heading","level":2},{"inlineContent":[{"type":"text","text":"A system is a type with a "},{"type":"codeVoice","code":"run"},{"type":"text","text":" method that a schedule calls once per run. The "},{"identifier":"doc:\/\/Systems\/documentation\/Systems\/System()","type":"reference","isActive":true},{"type":"text","text":" "},{"type":"text","text":"macro turns a structure into a system from the parameters of its "},{"type":"codeVoice","code":"run"},{"type":"text","text":" method. Each parameter’s"},{"type":"text","text":" "},{"type":"text","text":"type says what part of the world the system works on and whether it reads or writes it, so the"},{"type":"text","text":" "},{"type":"text","text":"system’s "},{"identifier":"doc:\/\/Systems\/documentation\/Systems\/System\/access","type":"reference","isActive":true},{"type":"text","text":" is always exact, and a schedule can run systems that don’t conflict at"},{"type":"text","text":" "},{"type":"text","text":"the same time."}],"type":"paragraph"},{"text":"Read and Write Components","anchor":"Read-and-Write-Components","type":"heading","level":3},{"inlineContent":[{"type":"text","text":"Take a "},{"isActive":true,"type":"reference","identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/Query"},{"type":"text","text":" to read components, and iterate it as you would a world’s query"},{"type":"text","text":" "},{"type":"text","text":"results. Take an "},{"isActive":true,"type":"reference","identifier":"doc:\/\/Systems\/documentation\/Systems\/Update"},{"type":"text","text":" to change them in place. An"},{"type":"text","text":" "},{"type":"text","text":"update can also read other components with "},{"code":"Over","type":"codeVoice"},{"type":"text","text":", and narrow the entities it visits with"},{"type":"text","text":" "},{"code":"Where","type":"codeVoice"},{"type":"text","text":":"}],"type":"paragraph"},{"syntax":"swift","code":["@System","struct Climb {","    func run(_ climbers: Update<Position>.Over<Velocity>.Where<Without<Frozen>>) {","        climbers { position, row in","            position.y += abs(row.components.dy)","        }","    }","}","","var world = World()","let climber = world.spawn(Position(x: 0, y: 0), Velocity(dx: 0, dy: -3))","let statue = world.spawn(Position(x: 0, y: 0), Velocity(dx: 0, dy: -3), Frozen())","Schedule { Climb() }.run(on: &world)","","print(world[Position.self, of: climber].y)","\/\/ Prints \"3.0\"","print(world[Position.self, of: statue].y)","\/\/ Prints \"0.0\""],"type":"codeListing"},{"inlineContent":[{"type":"codeVoice","code":"Climb"},{"type":"text","text":" writes "},{"type":"codeVoice","code":"Position"},{"type":"text","text":" and reads "},{"type":"codeVoice","code":"Velocity"},{"type":"text","text":" and "},{"type":"codeVoice","code":"Frozen"},{"type":"text","text":". It conflicts with any system that"},{"type":"text","text":" "},{"type":"text","text":"writes "},{"type":"codeVoice","code":"Velocity"},{"type":"text","text":" or "},{"type":"codeVoice","code":"Frozen"},{"type":"text","text":", or reads or writes "},{"type":"codeVoice","code":"Position"},{"type":"text","text":", and runs at the same time as any"},{"type":"text","text":" "},{"type":"text","text":"other."}],"type":"paragraph"},{"text":"Read and Write Resources and Events","anchor":"Read-and-Write-Resources-and-Events","type":"heading","level":3},{"inlineContent":[{"type":"text","text":"A "},{"type":"reference","isActive":true,"identifier":"doc:\/\/Systems\/documentation\/Systems\/ResourceReader"},{"type":"text","text":" reads a resource and a "},{"type":"reference","isActive":true,"identifier":"doc:\/\/Systems\/documentation\/Systems\/ResourceWriter"},{"type":"text","text":" changes one. An "},{"type":"reference","isActive":true,"identifier":"doc:\/\/Systems\/documentation\/Systems\/EventWriter"},{"type":"text","text":" "},{"type":"text","text":"sends events, and an "},{"type":"reference","isActive":true,"identifier":"doc:\/\/Systems\/documentation\/Systems\/EventReader"},{"type":"text","text":" reads the events sent since the system last read them. The"},{"type":"text","text":" "},{"type":"text","text":"following schedule sends a "},{"type":"codeVoice","code":"Damage"},{"type":"text","text":" event for each entity below the ground, then applies the"},{"type":"text","text":" "},{"type":"text","text":"damage to its target’s health:"}],"type":"paragraph"},{"syntax":"swift","code":["var world = World()","let knight = world.spawn(Position(x: 0, y: -1), Health(current: 30))","","let frame = Schedule {","    UpdateEvents()","    Combat()","    ApplyDamage().after(Combat.self)","}","frame.run(on: &world)","print(world[Health.self, of: knight].current)","\/\/ Prints \"20\""],"type":"codeListing"},{"inlineContent":[{"isActive":true,"type":"reference","identifier":"doc:\/\/Systems\/documentation\/Systems\/EventWriter"},{"type":"text","text":" declares "},{"type":"codeVoice","code":"Combat"},{"type":"text","text":", and "},{"isActive":true,"type":"reference","identifier":"doc:\/\/Systems\/documentation\/Systems\/EventReader"},{"type":"text","text":" declares "},{"type":"codeVoice","code":"ApplyDamage"},{"type":"text","text":"."}],"type":"paragraph"},{"text":"Spawn and Despawn Entities","anchor":"Spawn-and-Despawn-Entities","type":"heading","level":3},{"inlineContent":[{"text":"A system that runs alongside others can’t spawn or despawn entities directly, because that","type":"text"},{"text":" ","type":"text"},{"text":"changes every component type at once. Take an ","type":"text"},{"code":"inout","type":"codeVoice"},{"text":" ","type":"text"},{"identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/Commands","isActive":true,"type":"reference"},{"text":" instead, and queue","type":"text"},{"text":" ","type":"text"},{"text":"the changes. Commands apply at the end of the wave the system runs in, so systems ordered after","type":"text"},{"text":" ","type":"text"},{"text":"it see them:","type":"text"}],"type":"paragraph"},{"syntax":"swift","code":["@System","struct RemoveDefeated {","    func run(_ fighters: Query<Health>, _ commands: inout Commands) {","        for (entity, health) in fighters where health.current <= 0 {","            commands.despawn(entity)","        }","    }","}","","var world = World()","let knight = world.spawn(Health(current: 0))","world.spawn(Health(current: 12))","Schedule { RemoveDefeated() }.run(on: &world)","","print(world.contains(knight))","\/\/ Prints \"false\"","print(world.count)","\/\/ Prints \"1\""],"type":"codeListing"},{"inlineContent":[{"text":"A commands parameter conflicts with nothing, so it doesn’t stop a system from running at the","type":"text"},{"text":" ","type":"text"},{"text":"same time as others.","type":"text"}],"type":"paragraph"},{"text":"Take the Whole World","anchor":"Take-the-Whole-World","type":"heading","level":3},{"inlineContent":[{"type":"text","text":"A "},{"code":"run","type":"codeVoice"},{"type":"text","text":" method that takes "},{"code":"inout World","type":"codeVoice"},{"type":"text","text":" makes a system that can change anything. Its access is"},{"type":"text","text":" "},{"code":"nil","type":"codeVoice"},{"type":"text","text":", so a schedule runs it alone, after the systems written before it and before those written"},{"type":"text","text":" "},{"type":"text","text":"after it. Use one for work that touches many types at once, such as loading a level."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"To write a system by hand instead of with the macro, conform a type to "},{"type":"reference","identifier":"doc:\/\/Systems\/documentation\/Systems\/System","isActive":true},{"type":"text","text":", implement"},{"type":"text","text":" "},{"type":"reference","identifier":"doc:\/\/Systems\/documentation\/Systems\/System\/run(in:)","isActive":true},{"type":"text","text":", and declare an "},{"type":"reference","identifier":"doc:\/\/Systems\/documentation\/Systems\/System\/access","isActive":true},{"type":"text","text":" listing every type the system reads and"},{"type":"text","text":" "},{"type":"text","text":"writes."}],"type":"paragraph"},{"text":"Run on the Main Actor","anchor":"Run-on-the-Main-Actor","type":"heading","level":3},{"inlineContent":[{"type":"text","text":"Mark a system type, or its "},{"type":"codeVoice","code":"run"},{"type":"text","text":" method, "},{"type":"codeVoice","code":"@MainActor"},{"type":"text","text":" to make a "},{"type":"reference","identifier":"doc:\/\/Systems\/documentation\/Systems\/MainActorSystem","isActive":true},{"type":"text","text":", which a"},{"type":"text","text":" "},{"type":"text","text":"schedule runs on the main actor after the other systems of its wave. Use one to carry results"},{"type":"text","text":" "},{"type":"text","text":"from the world to a user interface."}],"type":"paragraph"}]}],"kind":"article","sections":[],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/systems\/declaringsystems"]}],"abstract":[{"text":"Write the rules of a simulation as systems, and let their parameters state what they read and","type":"text"},{"text":" ","type":"text"},{"text":"write.","type":"text"}],"references":{"doc://Systems/documentation/Systems/System":{"role":"symbol","type":"topic","title":"System","abstract":[{"type":"text","text":"A rule that reads and changes a world, run once each time its schedule runs."}],"kind":"symbol","navigatorTitle":[{"text":"System","kind":"identifier"}],"url":"\/documentation\/systems\/system","fragments":[{"text":"protocol","kind":"keyword"},{"text":" ","kind":"text"},{"text":"System","kind":"identifier"}],"identifier":"doc:\/\/Systems\/documentation\/Systems\/System"},"doc://WorldModule/documentation/WorldModule/Query":{"title":"Query","navigatorTitle":[{"text":"Query","kind":"identifier"}],"role":"symbol","identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/Query","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Query","kind":"identifier"}],"type":"topic","kind":"symbol","abstract":[{"text":"A description of the entities to visit and the components to read from each.","type":"text"}],"url":"\/documentation\/worldmodule\/query"},"doc://Systems/documentation/Systems/EventWriter":{"identifier":"doc:\/\/Systems\/documentation\/Systems\/EventWriter","kind":"symbol","type":"topic","title":"EventWriter","fragments":[{"text":"class","kind":"keyword"},{"text":" ","kind":"text"},{"text":"EventWriter","kind":"identifier"}],"navigatorTitle":[{"text":"EventWriter","kind":"identifier"}],"role":"symbol","abstract":[{"type":"text","text":"A system parameter that sends events of one type."}],"url":"\/documentation\/systems\/eventwriter"},"doc://Systems/documentation/Systems/ResourceReader":{"fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"ResourceReader"}],"type":"topic","role":"symbol","identifier":"doc:\/\/Systems\/documentation\/Systems\/ResourceReader","navigatorTitle":[{"kind":"identifier","text":"ResourceReader"}],"title":"ResourceReader","url":"\/documentation\/systems\/resourcereader","abstract":[{"type":"text","text":"A system parameter that reads a resource."}],"kind":"symbol"},"doc://Systems/documentation/Systems/MainActorSystem":{"type":"topic","fragments":[{"kind":"keyword","text":"protocol"},{"kind":"text","text":" "},{"kind":"identifier","text":"MainActorSystem"}],"kind":"symbol","url":"\/documentation\/systems\/mainactorsystem","navigatorTitle":[{"kind":"identifier","text":"MainActorSystem"}],"identifier":"doc:\/\/Systems\/documentation\/Systems\/MainActorSystem","abstract":[{"text":"A system that runs on the main actor, for work that touches main-actor state such as a user","type":"text"},{"text":" ","type":"text"},{"text":"interface.","type":"text"}],"title":"MainActorSystem","role":"symbol"},"doc://Systems/documentation/Systems":{"type":"topic","role":"collection","identifier":"doc:\/\/Systems\/documentation\/Systems","title":"Systems","url":"\/documentation\/systems","abstract":[{"type":"text","text":"Declare the rules of a simulation as systems, and run them on a world in a schedule."}],"kind":"symbol"},"doc://WorldModule/documentation/WorldModule/Commands":{"identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/Commands","url":"\/documentation\/worldmodule\/commands","role":"symbol","navigatorTitle":[{"kind":"identifier","text":"Commands"}],"abstract":[{"text":"A buffer of changes to a world, recorded now and applied later in the order they were","type":"text"},{"text":" ","type":"text"},{"text":"recorded.","type":"text"}],"kind":"symbol","title":"Commands","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"Commands"}],"type":"topic"},"doc://Systems/documentation/Systems/EventReader":{"identifier":"doc:\/\/Systems\/documentation\/Systems\/EventReader","type":"topic","kind":"symbol","title":"EventReader","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"EventReader","kind":"identifier"}],"navigatorTitle":[{"text":"EventReader","kind":"identifier"}],"role":"symbol","abstract":[{"type":"text","text":"A system parameter that reads the events of one type sent since the system last read them."}],"url":"\/documentation\/systems\/eventreader"},"doc://Systems/documentation/Systems/System/run(in:)":{"required":true,"kind":"symbol","url":"\/documentation\/systems\/system\/run(in:)","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"run"},{"kind":"text","text":"("},{"kind":"externalParam","text":"in"},{"kind":"text","text":": "},{"text":"inout","kind":"keyword"},{"text":" ","kind":"text"},{"preciseIdentifier":"s:11WorldModule0A0V","text":"World","kind":"typeIdentifier"},{"text":")","kind":"text"}],"role":"symbol","type":"topic","title":"run(in:)","abstract":[{"text":"Runs the system’s rule once on a world.","type":"text"}],"identifier":"doc:\/\/Systems\/documentation\/Systems\/System\/run(in:)"},"doc://Systems/documentation/Systems/Update":{"role":"symbol","type":"topic","title":"Update","abstract":[{"type":"text","text":"A system parameter that changes a component of every entity that holds it."}],"kind":"symbol","navigatorTitle":[{"kind":"identifier","text":"Update"}],"url":"\/documentation\/systems\/update","fragments":[{"kind":"keyword","text":"class"},{"kind":"text","text":" "},{"kind":"identifier","text":"Update"}],"identifier":"doc:\/\/Systems\/documentation\/Systems\/Update"},"doc://Systems/documentation/Systems/RemovedComponents":{"identifier":"doc:\/\/Systems\/documentation\/Systems\/RemovedComponents","kind":"symbol","type":"topic","title":"RemovedComponents","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"RemovedComponents","kind":"identifier"}],"navigatorTitle":[{"text":"RemovedComponents","kind":"identifier"}],"role":"symbol","abstract":[{"type":"text","text":"A system parameter that lists the entities that lost a component since the system last read"},{"type":"text","text":" "},{"type":"text","text":"them."}],"url":"\/documentation\/systems\/removedcomponents"},"doc://Systems/documentation/Systems/ResourceWriter":{"fragments":[{"kind":"keyword","text":"class"},{"kind":"text","text":" "},{"kind":"identifier","text":"ResourceWriter"}],"type":"topic","role":"symbol","identifier":"doc:\/\/Systems\/documentation\/Systems\/ResourceWriter","navigatorTitle":[{"kind":"identifier","text":"ResourceWriter"}],"title":"ResourceWriter","abstract":[{"text":"A system parameter that reads and writes a resource.","type":"text"}],"url":"\/documentation\/systems\/resourcewriter","kind":"symbol"},"doc://Systems/documentation/Systems/System/access":{"identifier":"doc:\/\/Systems\/documentation\/Systems\/System\/access","url":"\/documentation\/systems\/system\/access","required":true,"role":"symbol","abstract":[{"type":"text","text":"The component, resource and event types the system reads and writes, or "},{"type":"codeVoice","code":"nil"},{"type":"text","text":" if it may"},{"type":"text","text":" "},{"type":"text","text":"change anything."}],"kind":"symbol","title":"access","fragments":[{"text":"var","kind":"keyword"},{"text":" ","kind":"text"},{"kind":"identifier","text":"access"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"Access","preciseIdentifier":"s:11WorldModule6AccessV"},{"kind":"text","text":"?"}],"type":"topic","defaultImplementations":1},"doc://Systems/documentation/Systems/System()":{"identifier":"doc:\/\/Systems\/documentation\/Systems\/System()","abstract":[{"text":"Makes a type a system whose access comes from the parameters of its ","type":"text"},{"code":"run","type":"codeVoice"},{"text":" method.","type":"text"}],"kind":"symbol","title":"System()","fragments":[{"text":"macro","kind":"keyword"},{"text":" ","kind":"text"},{"text":"System","kind":"identifier"},{"text":"()","kind":"text"}],"type":"topic","role":"symbol","url":"\/documentation\/systems\/system()"},"doc://Systems/documentation/Systems/DrivingAWorldFromAnApp":{"kind":"article","url":"\/documentation\/systems\/drivingaworldfromanapp","role":"article","type":"topic","title":"Driving a World from an App","abstract":[{"text":"Hold a world in your app or game engine, feed it each frame’s input, and let the objects outside","type":"text"},{"text":" ","type":"text"},{"text":"it read results and take part in a step.","type":"text"}],"identifier":"doc:\/\/Systems\/documentation\/Systems\/DrivingAWorldFromAnApp"}}}