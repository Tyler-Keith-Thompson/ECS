{"identifier":{"url":"doc:\/\/Systems\/documentation\/Systems\/DeclaringSystems","interfaceLanguage":"swift"},"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/systems\/declaringsystems"]}],"schemaVersion":{"patch":0,"major":0,"minor":3},"seeAlsoSections":[{"identifiers":["doc:\/\/Systems\/documentation\/Systems\/DrivingAWorldFromAnApp","doc:\/\/Systems\/documentation\/Systems\/System()","doc:\/\/Systems\/documentation\/Systems\/System"],"title":"Essentials","generated":true,"anchor":"Essentials"}],"sections":[],"primaryContentSections":[{"content":[{"level":2,"anchor":"Overview","text":"Overview","type":"heading"},{"inlineContent":[{"type":"text","text":"A system is a type with a "},{"code":"run","type":"codeVoice"},{"type":"text","text":" method that a schedule calls once per run. The "},{"identifier":"doc:\/\/Systems\/documentation\/Systems\/System()","type":"reference","isActive":true},{"type":"text","text":" "},{"type":"text","text":"macro turns a structure into a system from the parameters of its "},{"code":"run","type":"codeVoice"},{"type":"text","text":" method. Each parameter’s"},{"type":"text","text":" "},{"type":"text","text":"type says what part of the world the system works on and whether it reads or writes it, so the"},{"type":"text","text":" "},{"type":"text","text":"system’s "},{"identifier":"doc:\/\/Systems\/documentation\/Systems\/System\/access","type":"reference","isActive":true},{"type":"text","text":" is always exact, and a schedule can run systems that don’t conflict at"},{"type":"text","text":" "},{"type":"text","text":"the same time."}],"type":"paragraph"},{"level":3,"anchor":"Read-and-Write-Components","text":"Read and Write Components","type":"heading"},{"inlineContent":[{"type":"text","text":"Take a "},{"type":"reference","isActive":true,"identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/Query"},{"type":"text","text":" to read components, and iterate it as you would a world’s query"},{"type":"text","text":" "},{"type":"text","text":"results. Take an "},{"type":"reference","isActive":true,"identifier":"doc:\/\/Systems\/documentation\/Systems\/Update"},{"type":"text","text":" to change them in place. An"},{"type":"text","text":" "},{"type":"text","text":"update can also read other components with "},{"type":"codeVoice","code":"Over"},{"type":"text","text":", and narrow the entities it visits with"},{"type":"text","text":" "},{"type":"codeVoice","code":"Where"},{"type":"text","text":":"}],"type":"paragraph"},{"syntax":"swift","type":"codeListing","code":["@System","struct Climb {","    func run(_ climbers: Update<Position>.Over<Velocity>.Where<Without<Frozen>>) {","        climbers { position, row in","            position.y += abs(row.components.dy)","        }","    }","}","","var world = World()","let climber = world.spawn(Position(x: 0, y: 0), Velocity(dx: 0, dy: -3))","let statue = world.spawn(Position(x: 0, y: 0), Velocity(dx: 0, dy: -3), Frozen())","Schedule { Climb() }.run(on: &world)","","print(world[Position.self, of: climber].y)","\/\/ Prints \"3.0\"","print(world[Position.self, of: statue].y)","\/\/ Prints \"0.0\""]},{"inlineContent":[{"type":"codeVoice","code":"Climb"},{"type":"text","text":" writes "},{"type":"codeVoice","code":"Position"},{"type":"text","text":" and reads "},{"type":"codeVoice","code":"Velocity"},{"type":"text","text":" and "},{"type":"codeVoice","code":"Frozen"},{"type":"text","text":". It conflicts with any system that"},{"type":"text","text":" "},{"type":"text","text":"writes "},{"type":"codeVoice","code":"Velocity"},{"type":"text","text":" or "},{"type":"codeVoice","code":"Frozen"},{"type":"text","text":", or reads or writes "},{"type":"codeVoice","code":"Position"},{"type":"text","text":", and runs at the same time as any"},{"type":"text","text":" "},{"type":"text","text":"other."}],"type":"paragraph"},{"level":3,"anchor":"Read-and-Write-Resources-and-Events","text":"Read and Write Resources and Events","type":"heading"},{"inlineContent":[{"type":"text","text":"A "},{"type":"reference","identifier":"doc:\/\/Systems\/documentation\/Systems\/ResourceReader","isActive":true},{"type":"text","text":" reads a resource and a "},{"type":"reference","identifier":"doc:\/\/Systems\/documentation\/Systems\/ResourceWriter","isActive":true},{"type":"text","text":" changes one. An "},{"type":"reference","identifier":"doc:\/\/Systems\/documentation\/Systems\/EventWriter","isActive":true},{"type":"text","text":" "},{"type":"text","text":"sends events, and an "},{"type":"reference","identifier":"doc:\/\/Systems\/documentation\/Systems\/EventReader","isActive":true},{"type":"text","text":" reads the events sent since the system last read them. The"},{"type":"text","text":" "},{"type":"text","text":"following schedule sends a "},{"type":"codeVoice","code":"Damage"},{"type":"text","text":" event for each entity below the ground, then applies the"},{"type":"text","text":" "},{"type":"text","text":"damage to its target’s health:"}],"type":"paragraph"},{"syntax":"swift","type":"codeListing","code":["var world = World()","let knight = world.spawn(Position(x: 0, y: -1), Health(current: 30))","","let frame = Schedule {","    UpdateEvents()","    Combat()","    ApplyDamage().after(Combat.self)","}","frame.run(on: &world)","print(world[Health.self, of: knight].current)","\/\/ Prints \"20\""]},{"inlineContent":[{"isActive":true,"identifier":"doc:\/\/Systems\/documentation\/Systems\/EventWriter","type":"reference"},{"text":" declares ","type":"text"},{"code":"Combat","type":"codeVoice"},{"text":", and ","type":"text"},{"isActive":true,"identifier":"doc:\/\/Systems\/documentation\/Systems\/EventReader","type":"reference"},{"text":" declares ","type":"text"},{"code":"ApplyDamage","type":"codeVoice"},{"text":".","type":"text"}],"type":"paragraph"},{"level":3,"anchor":"Spawn-and-Despawn-Entities","text":"Spawn and Despawn Entities","type":"heading"},{"inlineContent":[{"text":"A system that runs alongside others can’t spawn or despawn entities directly, because that","type":"text"},{"text":" ","type":"text"},{"text":"changes every component type at once. Take an ","type":"text"},{"code":"inout","type":"codeVoice"},{"text":" ","type":"text"},{"identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/Commands","type":"reference","isActive":true},{"text":" instead, and queue","type":"text"},{"text":" ","type":"text"},{"text":"the changes. Commands apply at the end of the wave the system runs in, so systems ordered after","type":"text"},{"text":" ","type":"text"},{"text":"it see them:","type":"text"}],"type":"paragraph"},{"syntax":"swift","type":"codeListing","code":["@System","struct RemoveDefeated {","    func run(_ fighters: Query<Health>, _ commands: inout Commands) {","        for (entity, health) in fighters where health.current <= 0 {","            commands.despawn(entity)","        }","    }","}","","var world = World()","let knight = world.spawn(Health(current: 0))","world.spawn(Health(current: 12))","Schedule { RemoveDefeated() }.run(on: &world)","","print(world.contains(knight))","\/\/ Prints \"false\"","print(world.count)","\/\/ Prints \"1\""]},{"inlineContent":[{"text":"A commands parameter conflicts with nothing, so it doesn’t stop a system from running at the","type":"text"},{"text":" ","type":"text"},{"text":"same time as others.","type":"text"}],"type":"paragraph"},{"level":3,"anchor":"Take-the-Whole-World","text":"Take the Whole World","type":"heading"},{"inlineContent":[{"text":"A ","type":"text"},{"code":"run","type":"codeVoice"},{"text":" method that takes ","type":"text"},{"code":"inout World","type":"codeVoice"},{"text":" makes a system that can change anything. Its access is","type":"text"},{"text":" ","type":"text"},{"code":"nil","type":"codeVoice"},{"text":", so a schedule runs it alone, after the systems written before it and before those written","type":"text"},{"text":" ","type":"text"},{"text":"after it. Use one for work that touches many types at once, such as loading a level.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"To write a system by hand instead of with the macro, conform a type to "},{"type":"reference","identifier":"doc:\/\/Systems\/documentation\/Systems\/System","isActive":true},{"type":"text","text":", implement"},{"type":"text","text":" "},{"type":"reference","identifier":"doc:\/\/Systems\/documentation\/Systems\/System\/run(in:)","isActive":true},{"type":"text","text":", and declare an "},{"type":"reference","identifier":"doc:\/\/Systems\/documentation\/Systems\/System\/access","isActive":true},{"type":"text","text":" listing every type the system reads and"},{"type":"text","text":" "},{"type":"text","text":"writes."}],"type":"paragraph"},{"level":3,"anchor":"Run-on-the-Main-Actor","text":"Run on the Main Actor","type":"heading"},{"inlineContent":[{"text":"Mark a system type, or its ","type":"text"},{"code":"run","type":"codeVoice"},{"text":" method, ","type":"text"},{"code":"@MainActor","type":"codeVoice"},{"text":" to make a ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/Systems\/documentation\/Systems\/MainActorSystem"},{"text":", which a","type":"text"},{"text":" ","type":"text"},{"text":"schedule runs on the main actor after the other systems of its wave. Use one to carry results","type":"text"},{"text":" ","type":"text"},{"text":"from the world to a user interface.","type":"text"}],"type":"paragraph"}],"kind":"content"}],"topicSections":[{"identifiers":["doc:\/\/Systems\/documentation\/Systems\/System()","doc:\/\/Systems\/documentation\/Systems\/System","doc:\/\/Systems\/documentation\/Systems\/MainActorSystem"],"title":"Declaring Systems","anchor":"Declaring-Systems"},{"identifiers":["doc:\/\/Systems\/documentation\/Systems\/Update","doc:\/\/Systems\/documentation\/Systems\/ResourceReader","doc:\/\/Systems\/documentation\/Systems\/ResourceWriter","doc:\/\/Systems\/documentation\/Systems\/EventReader","doc:\/\/Systems\/documentation\/Systems\/EventWriter","doc:\/\/Systems\/documentation\/Systems\/RemovedComponents"],"title":"System Parameters","anchor":"System-Parameters"}],"metadata":{"role":"collectionGroup","modules":[{"name":"Systems"}],"title":"Declaring Systems","roleHeading":"API Collection"},"kind":"article","abstract":[{"type":"text","text":"Write the rules of a simulation as systems, and let their parameters state what they read and"},{"type":"text","text":" "},{"type":"text","text":"write."}],"hierarchy":{"paths":[["doc:\/\/Systems\/documentation\/Systems"]]},"references":{"doc://Systems/documentation/Systems/DrivingAWorldFromAnApp":{"title":"Driving a World from an App","kind":"article","type":"topic","role":"article","url":"\/documentation\/systems\/drivingaworldfromanapp","identifier":"doc:\/\/Systems\/documentation\/Systems\/DrivingAWorldFromAnApp","abstract":[{"type":"text","text":"Hold a world in your app or game engine, feed it each frame’s input, and let the objects outside"},{"type":"text","text":" "},{"type":"text","text":"it read results and take part in a step."}]},"doc://Systems/documentation/Systems/EventWriter":{"title":"EventWriter","kind":"symbol","type":"topic","role":"symbol","navigatorTitle":[{"text":"EventWriter","kind":"identifier"}],"url":"\/documentation\/systems\/eventwriter","identifier":"doc:\/\/Systems\/documentation\/Systems\/EventWriter","fragments":[{"text":"class","kind":"keyword"},{"text":" ","kind":"text"},{"text":"EventWriter","kind":"identifier"}],"abstract":[{"text":"A system parameter that sends events of one type.","type":"text"}]},"doc://Systems/documentation/Systems/ResourceReader":{"abstract":[{"text":"A system parameter that reads a resource.","type":"text"}],"identifier":"doc:\/\/Systems\/documentation\/Systems\/ResourceReader","kind":"symbol","url":"\/documentation\/systems\/resourcereader","navigatorTitle":[{"text":"ResourceReader","kind":"identifier"}],"role":"symbol","title":"ResourceReader","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"ResourceReader","kind":"identifier"}],"type":"topic"},"doc://Systems/documentation/Systems/Update":{"abstract":[{"type":"text","text":"A system parameter that changes a component of every entity that holds it."}],"identifier":"doc:\/\/Systems\/documentation\/Systems\/Update","kind":"symbol","url":"\/documentation\/systems\/update","navigatorTitle":[{"text":"Update","kind":"identifier"}],"role":"symbol","title":"Update","fragments":[{"text":"class","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Update","kind":"identifier"}],"type":"topic"},"doc://Systems/documentation/Systems/ResourceWriter":{"title":"ResourceWriter","kind":"symbol","type":"topic","role":"symbol","navigatorTitle":[{"text":"ResourceWriter","kind":"identifier"}],"url":"\/documentation\/systems\/resourcewriter","identifier":"doc:\/\/Systems\/documentation\/Systems\/ResourceWriter","fragments":[{"text":"class","kind":"keyword"},{"text":" ","kind":"text"},{"text":"ResourceWriter","kind":"identifier"}],"abstract":[{"text":"A system parameter that reads and writes a resource.","type":"text"}]},"doc://Systems/documentation/Systems/System":{"title":"System","kind":"symbol","type":"topic","role":"symbol","navigatorTitle":[{"kind":"identifier","text":"System"}],"url":"\/documentation\/systems\/system","identifier":"doc:\/\/Systems\/documentation\/Systems\/System","fragments":[{"kind":"keyword","text":"protocol"},{"kind":"text","text":" "},{"kind":"identifier","text":"System"}],"abstract":[{"text":"A rule that reads and changes a world, run once each time its schedule runs.","type":"text"}]},"doc://Systems/documentation/Systems/System()":{"abstract":[{"text":"Makes a type a system whose access comes from the parameters of its ","type":"text"},{"code":"run","type":"codeVoice"},{"text":" method.","type":"text"}],"identifier":"doc:\/\/Systems\/documentation\/Systems\/System()","url":"\/documentation\/systems\/system()","kind":"symbol","role":"symbol","title":"System()","fragments":[{"text":"macro","kind":"keyword"},{"text":" ","kind":"text"},{"text":"System","kind":"identifier"},{"text":"()","kind":"text"}],"type":"topic"},"doc://Systems/documentation/Systems/System/access":{"title":"access","kind":"symbol","type":"topic","role":"symbol","url":"\/documentation\/systems\/system\/access","required":true,"defaultImplementations":1,"identifier":"doc:\/\/Systems\/documentation\/Systems\/System\/access","fragments":[{"text":"var","kind":"keyword"},{"text":" ","kind":"text"},{"text":"access","kind":"identifier"},{"text":": ","kind":"text"},{"text":"Access","preciseIdentifier":"s:11WorldModule6AccessV","kind":"typeIdentifier"},{"text":"?","kind":"text"}],"abstract":[{"type":"text","text":"The component, resource and event types the system reads and writes, or "},{"type":"codeVoice","code":"nil"},{"type":"text","text":" if it may"},{"type":"text","text":" "},{"type":"text","text":"change anything."}]},"doc://Systems/documentation/Systems":{"title":"Systems","kind":"symbol","type":"topic","role":"collection","url":"\/documentation\/systems","identifier":"doc:\/\/Systems\/documentation\/Systems","abstract":[{"text":"Declare the rules of a simulation as systems, and run them on a world in a schedule.","type":"text"}]},"doc://WorldModule/documentation/WorldModule/Commands":{"identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/Commands","title":"Commands","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"Commands"}],"abstract":[{"text":"A buffer of changes to a world, recorded now and applied later in the order they were","type":"text"},{"text":" ","type":"text"},{"text":"recorded.","type":"text"}],"navigatorTitle":[{"kind":"identifier","text":"Commands"}],"role":"symbol","kind":"symbol","url":"\/documentation\/worldmodule\/commands","type":"topic"},"doc://Systems/documentation/Systems/MainActorSystem":{"title":"MainActorSystem","kind":"symbol","type":"topic","role":"symbol","navigatorTitle":[{"kind":"identifier","text":"MainActorSystem"}],"url":"\/documentation\/systems\/mainactorsystem","identifier":"doc:\/\/Systems\/documentation\/Systems\/MainActorSystem","fragments":[{"kind":"keyword","text":"protocol"},{"kind":"text","text":" "},{"kind":"identifier","text":"MainActorSystem"}],"abstract":[{"text":"A system that runs on the main actor, for work that touches main-actor state such as a user","type":"text"},{"text":" ","type":"text"},{"text":"interface.","type":"text"}]},"doc://WorldModule/documentation/WorldModule/Query":{"abstract":[{"text":"A description of the entities to visit and the components to read from each.","type":"text"}],"url":"\/documentation\/worldmodule\/query","identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/Query","kind":"symbol","navigatorTitle":[{"text":"Query","kind":"identifier"}],"role":"symbol","title":"Query","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Query","kind":"identifier"}],"type":"topic"},"doc://Systems/documentation/Systems/System/run(in:)":{"abstract":[{"text":"Runs the system’s rule once on a world.","type":"text"}],"kind":"symbol","identifier":"doc:\/\/Systems\/documentation\/Systems\/System\/run(in:)","url":"\/documentation\/systems\/system\/run(in:)","role":"symbol","title":"run(in:)","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"run","kind":"identifier"},{"text":"(","kind":"text"},{"text":"in","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"inout","kind":"keyword"},{"text":" ","kind":"text"},{"text":"World","kind":"typeIdentifier","preciseIdentifier":"s:11WorldModule0A0V"},{"text":")","kind":"text"}],"type":"topic","required":true},"doc://Systems/documentation/Systems/RemovedComponents":{"identifier":"doc:\/\/Systems\/documentation\/Systems\/RemovedComponents","title":"RemovedComponents","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"RemovedComponents","kind":"identifier"}],"abstract":[{"text":"A system parameter that lists the entities that lost a component since the system last read","type":"text"},{"text":" ","type":"text"},{"text":"them.","type":"text"}],"navigatorTitle":[{"text":"RemovedComponents","kind":"identifier"}],"role":"symbol","kind":"symbol","url":"\/documentation\/systems\/removedcomponents","type":"topic"},"doc://Systems/documentation/Systems/EventReader":{"identifier":"doc:\/\/Systems\/documentation\/Systems\/EventReader","title":"EventReader","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"EventReader"}],"abstract":[{"text":"A system parameter that reads the events of one type sent since the system last read them.","type":"text"}],"navigatorTitle":[{"kind":"identifier","text":"EventReader"}],"role":"symbol","kind":"symbol","url":"\/documentation\/systems\/eventreader","type":"topic"}}}