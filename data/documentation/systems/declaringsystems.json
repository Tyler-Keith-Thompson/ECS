he component, resource and event types the system reads and writes, or "},{"code":"nil","type":"codeVoice"},{"type":"text","text":" if it may"},{"type":"text","text":" "},{"type":"text","text":"change anything."}],"required":true,"title":"access","url":"\/documentation\/systems\/system\/access","defaultImplementations":1},"doc://Systems/documentation/Systems/System":{"kind":"symbol","title":"System","identifier":"doc:\/\/Systems\/documentation\/Systems\/System","type":"topic","role":"symbol","navigatorTitle":[{"text":"System","kind":"identifier"}],"fragments":[{"text":"protocol","kind":"keyword"},{"text":" ","kind":"text"},{"text":"System","kind":"identifier"}],"abstract":[{"type":"text","text":"A rule that reads and changes a world, run once each time its schedule runs."}],"url":"\/documentation\/systems\/system"},"doc://Systems/documentation/Systems/System/run(in:)":{"title":"run(in:)","abstract":[{"text":"Runs the system’s rule once on a world.","type":"text"}],"identifier":"doc:\/\/Systems\/documentation\/Systems\/System\/run(in:)","url":"\/documentation\/systems\/system\/run(in:)","type":"topic","kind":"symbol","required":true,"role":"symbol","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"run"},{"kind":"text","text":"("},{"kind":"externalParam","text":"in"},{"kind":"text","text":": "},{"kind":"keyword","text":"inout"},{"kind":"text","text":" "},{"preciseIdentifier":"s:11WorldModule0A0V","kind":"typeIdentifier","text":"World"},{"kind":"text","text":")"}]},"doc://Systems/documentation/Systems":{"kind":"symbol","title":"Systems","type":"topic","identifier":"doc:\/\/Systems\/documentation\/Systems","role":"collection","abstract":[{"type":"text","text":"Declare the rules of a simulation as systems, and run them on a world in a schedule."}],"url":"\/documentation\/systems"},"doc://Systems/documentation/Systems/ResourceReader":{"role":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"tex