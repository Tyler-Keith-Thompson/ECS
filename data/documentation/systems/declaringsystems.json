"}],"role":"symbol","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"run"},{"kind":"text","text":"("},{"kind":"externalParam","text":"in"},{"kind":"text","text":": "},{"kind":"keyword","text":"inout"},{"kind":"text","text":" "},{"preciseIdentifier":"s:11WorldModule0A0V","kind":"typeIdentifier","text":"World"},{"kind":"text","text":")"}],"type":"topic","identifier":"doc:\/\/Systems\/documentation\/Systems\/System\/run(in:)","kind":"symbol","url":"\/documentation\/systems\/system\/run(in:)","title":"run(in:)"},"doc://Systems/documentation/Systems/ResourceReader":{"navigatorTitle":[{"kind":"identifier","text":"ResourceReader"}],"abstract":[{"type":"text","text":"A system parameter that reads a resource."}],"role":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"ResourceReader"}],"kind":"symbol","type":"topic","identifier":"doc:\/\/Systems\/documentation\/Systems\/ResourceReader","url":"\/documentation\/systems\/resourcereader","title":"ResourceReader"},"doc://Systems/documentation/Systems/MainActorSystem":{"title":"MainActorSystem","fragments":[{"text":"protocol","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MainActorSystem","kind":"identifier"}],"url":"\/documentation\/systems\/mainactorsystem","identifier":"doc:\/\/Systems\/documentation\/Systems\/MainActorSystem","type":"topic","navigatorTitle":[{"text":"MainActorSystem","kind":"identifier"}],"role":"symbol","kind":"symbol","abstract":[{"text":"A system that runs on the main actor, for work that touches main-actor state such as a user","type":"text"},{"text":" ","type":"text"},{"text":"interface.","type":"text"}]},"doc://WorldModule/documentation/WorldModule/Query":{"type":"topic","title":"Query","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Query","kind":"identifier"}],"role":"symbol","kind":"symbol","url":"\/documentation\/worldmodule\/query","identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/Query","navigatorTitle":[{"text":"Query","kind":"identifier"}],"abstract":[{"text":"A description of the entities to visit and the components to read from each.","type":"text"}]},"doc://Systems/documentation/Systems/DrivingAWorldFromAnApp":{"abstract":[{"type":"text","text":"Hold a world in your app or game engine, feed it each frame’s input, and let the objects outside"},{"type":"text","text":" "},{"type":"text","text":"it read results and take part in a step."}],"role":"article","type":"topic","identifier":"doc:\/\/Systems\/documentation\/Systems\/DrivingAWorldFromAnApp","kind":"article","url":"\/documentation\/systems\/drivingaworldfromanapp","title":"Driving a World from an App"},"doc://Systems/documentation/Systems/System()":{"url":"\/documentation\/systems\/system()","identifier":"doc:\/\/Systems\/documentation\/Systems\/System()","fragments":[{"kind":"keyword","text":"macro"},{"kind":"text","text":" "},{"kind":"identifier","text":"System"},{"kind":"text","text":"()"}],"role":"symbol","kind":"symbol","title":"System()","abstract":[{"type":"text","text":"Makes a type a system whose access comes from the parameters of its "},{"type":"codeVoice","code":"run"},{"type":"text","text":" method."}],"type":"topic"},"doc://Systems/documentation/Systems/RemovedComponents":{"kind":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"RemovedComponents","kind":"identifier"}],"navigatorTitle":[{"text":"RemovedComponents","kind":"identifier"}],"identifier":"doc:\/\/Systems\/documentation\/Systems\/RemovedComponents","title":"RemovedComponents","abstract":[{"type":"text","text":"A system parameter that lists the entities that lost a component since the system last read"},{"type":"text","text":" "},{"type":"text","text":"them."}],"url":"\/documentation\/systems\/removedcomponents","type":"topic","role":"symbol"},"doc://Systems/documentation/Systems/ResourceWriter":{"navigatorTitle":[{"text":"ResourceWriter","kind":"identifier"}],"abstract":[{"type":"text","text":"A system parameter that reads and writes a resource."}],"role":"symbol","fragments":[{"text":"class","kind":"keyword"},{"text":" ","kind":"text"},{"text":"ResourceWriter","kind":"identifier"}],"type":"topic","identifier":"doc:\/\/Systems\/documentation\/Systems\/ResourceWriter","kind":"symbol","title":"ResourceWriter","url":"\/documentation\/systems\/resourcewriter"},"doc://Systems/documentation/Systems/System":{"navigatorTitle":[{"text":"System","kind":"identifier"}],"abstract":[{"type":"text","text":"A rule that reads and changes a world, run once each time its schedule runs."}],"role":"symbol","fragments":[{"text":"protocol","kind":"keyword"},{"text":" ","kind":"text"},{"text":"System","kind":"identifier"}],"type":"topic","kind":"symbol","identifier":"doc:\/\/Systems\/documentation\/Systems\/System","title":"System","url":"\/documentation\/systems\/system"},"doc://Systems/documentation/Systems/Update":{"kind":"symbol","fragments":[{"kind":"keyword","text":"class"},{"kind":"text","text":" "},{"kind":"identifier","text":"Update"}],"navigatorTitle":[{"kind":"identifier","text":"Update"}],"identifier":"doc:\/\/Systems\/documentation\/Systems\/Update","title":"Update","abstract":[{"type":"text","text":"A system parameter that changes a component of every entity that holds it."}],"url":"\/documentation\/systems\/update","type":"topic","role":"symbol"},"doc://Systems/documentation/Systems/EventReader":{"kind":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"EventReader"}],"navigatorTitle":[{"kind":"identifier","text":"EventReader"}],"identifier":"doc:\/\/Systems\/documentation\/Systems\/EventReader","title":"EventReader","abstract":[{"type":"text","text":"A system parameter that reads the events of one type sent since the system last read them."}],"url":"\/documentation\/systems\/eventreader","type":"topic","role":"symbol"},"doc:/