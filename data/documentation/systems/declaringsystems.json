nce the system last read","type":"text"},{"text":" ","type":"text"},{"text":"them.","type":"text"}],"fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"RemovedComponents"}],"navigatorTitle":[{"kind":"identifier","text":"RemovedComponents"}],"type":"topic"},"doc://Systems/documentation/Systems/ResourceWriter":{"role":"symbol","fragments":[{"kind":"keyword","text":"class"},{"kind":"text","text":" "},{"kind":"identifier","text":"ResourceWriter"}],"identifier":"doc:\/\/Systems\/documentation\/Systems\/ResourceWriter","kind":"symbol","type":"topic","navigatorTitle":[{"kind":"identifier","text":"ResourceWriter"}],"abstract":[{"type":"text","text":"A system parameter that reads and writes a resource."}],"title":"ResourceWriter","url":"\/documentation\/systems\/resourcewriter"},"doc://Systems/documentation/Systems/MainActorSystem":{"navigatorTitle":[{"text":"MainActorSystem","kind":"identifier"}],"title":"MainActorSystem","type":"topic","role":"symbol","url":"\/documentation\/systems\/mainactorsystem","identifier":"doc:\/\/Systems\/documentation\/Systems\/MainActorSystem","fragments":[{"text":"protocol","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MainActorSystem","kind":"identifier"}],"kind":"symbol","abstract":[{"text":"A system that runs on the main actor, for work that touches main-actor state such as a user","type":"text"},{"text":" ","type":"text"},{"text":"interface.","type":"text"}]},"doc://Systems/documentation/Systems/EventWriter":{"role":"symbol","fragments":[{"text":"class","kind":"keyword"},{"text":" ","kind":"text"},{"text":"EventWriter","kind":"identifier"}],"navigatorTitle":[{"text":"EventWriter","kind":"identifier"}],"identifier":"doc:\/\/Systems\/documentation\/Systems\/EventWriter","type":"topic","kind":"symbol","title":"EventWriter","url":"\/documentation\/systems\/eventwriter","abstract":[{"text":"A system parameter that sends events of one type.","type":"text"}]},"doc://WorldModule/documentat