/query"},"doc://Systems/documentation/Systems/MainActorSystem":{"navigatorTitle":[{"kind":"identifier","text":"MainActorSystem"}],"title":"MainActorSystem","role":"symbol","identifier":"doc:\/\/Systems\/documentation\/Systems\/MainActorSystem","type":"topic","kind":"symbol","fragments":[{"kind":"keyword","text":"protocol"},{"kind":"text","text":" "},{"kind":"identifier","text":"MainActorSystem"}],"abstract":[{"type":"text","text":"A system that runs on the main actor, for work that touches main-actor state such as a user"},{"type":"text","text":" "},{"type":"text","text":"interface."}],"url":"\/documentation\/systems\/mainactorsystem"},"doc://Systems/documentation/Systems/DrivingAWorldFromAnApp":{"type":"topic","url":"\/documentation\/systems\/drivingaworldfromanapp","title":"Driving a World from an App","kind":"article","abstract":[{"type":"text","text":"Hold a world in your app or game engine, feed it each frame’s input, and let the objects outside"},{"type":"text","text":" "},{"type":"text","text":"it read results and take part in a step."}],"role":"article","identifier":"doc:\/\/Systems\/documentation\/Systems\/DrivingAWorldFromAnApp"},"doc://Systems/documentation/Systems/System/run(in:)":{"required":true,"title":"run(in:)","role":"symbol","identifier":"doc:\/\/Systems\/documentation\/Systems\/System\/run(in:)","kind":"symbol","type":"topic","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"run","kind":"identifier"},{"text":"(","kind":"text"},{"text":"in","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"inout","kind":"keyword"},{"text":" ","kind":"text"},{"preciseIdentifier":"s:11WorldModule0A0V","text":"World","kind":"typeIdentifier"},{"text":")","kind":"text"}],"url":"\/documentation\/systems\/system\/run(in:)","abstract":[{"type":"text","text":"Runs the system’s rule once on a world."}]},"doc://Systems/documentation/Systems/EventWriter":{"url":"\/documentation\/systems\/eventwriter","type":"topic","title":"EventWriter","kind":"symbol","abstract":[{"type":"text","text":"A system parameter that sends events of one type."}],"fragments":[{"text":"class","kind":"keyword"},{"text":" ","kind":"text"},{"text":"EventWriter","kind":"identifier"}],"navigatorTitle":[{"text":"EventWriter","kind":"identifier"}],"role":"symbol","identifier":"doc:\/\/Systems\/documentation\/Systems\/EventWriter"},"doc://Systems/documentation/Systems/EventReader":{"role":"symbol","navigatorTitle":[{"text":"EventReader","kind":"identifier"}],"url":"\/documentation\/systems\/eventreader","title":"EventReader","abstract":[{"type":"text","text":"A system parameter that reads the events of one type sent since the system last read them."}],"type":"topic","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"EventReader","kind":"identifier"}],"identifier":"doc:\/\/Systems\/documentation\/Systems\/EventReader","kind":"symbol"}}}