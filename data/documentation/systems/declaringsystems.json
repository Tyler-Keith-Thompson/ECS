{"kind":"article","hierarchy":{"paths":[["doc:\/\/Systems\/documentation\/Systems"]]},"metadata":{"role":"collectionGroup","title":"Declaring Systems","modules":[{"name":"Systems"}],"roleHeading":"API Collection"},"sections":[],"schemaVersion":{"patch":0,"minor":3,"major":0},"topicSections":[{"identifiers":["doc:\/\/Systems\/documentation\/Systems\/System()","doc:\/\/Systems\/documentation\/Systems\/System","doc:\/\/Systems\/documentation\/Systems\/MainActorSystem"],"title":"Declaring Systems","anchor":"Declaring-Systems"},{"identifiers":["doc:\/\/Systems\/documentation\/Systems\/Update","doc:\/\/Systems\/documentation\/Systems\/ResourceReader","doc:\/\/Systems\/documentation\/Systems\/ResourceWriter","doc:\/\/Systems\/documentation\/Systems\/EventReader","doc:\/\/Systems\/documentation\/Systems\/EventWriter","doc:\/\/Systems\/documentation\/Systems\/RemovedComponents"],"title":"System Parameters","anchor":"System-Parameters"}],"seeAlsoSections":[{"anchor":"Essentials","identifiers":["doc:\/\/Systems\/documentation\/Systems\/SchedulingSystems","doc:\/\/Systems\/documentation\/Systems\/DrivingAWorldFromAnApp","doc:\/\/Systems\/documentation\/Systems\/System()","doc:\/\/Systems\/documentation\/Systems\/System"],"title":"Essentials","generated":true}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/systems\/declaringsystems"]}],"primaryContentSections":[{"content":[{"anchor":"Overview","level":2,"type":"heading","text":"Overview"},{"inlineContent":[{"type":"text","text":"A system is a type with a "},{"code":"run","type":"codeVoice"},{"type":"text","text":" method that a schedule calls once per run. The "},{"identifier":"doc:\/\/Systems\/documentation\/Systems\/System()","type":"reference","isActive":true},{"type":"text","text":" "},{"type":"text","text":"macro turns a structure into a system from the parameters of its "},{"code":"run","type":"codeVoice"},{"type":"text","text":" method. Each parameter’s"},{"type":"text","text":" "},{"type":"text","text":"type says what part of the world the system works on and whether it reads or writes it, so the"},{"type":"text","text":" "},{"type":"text","text":"system’s "},{"identifier":"doc:\/\/Systems\/documentation\/Systems\/System\/access","type":"reference","isActive":true},{"type":"text","text":" is always exact, and a schedule can run systems that don’t conflict at"},{"type":"text","text":" "},{"type":"text","text":"the same time."}],"type":"paragraph"},{"anchor":"Read-and-Write-Components","level":3,"type":"heading","text":"Read and Write Components"},{"inlineContent":[{"text":"Take a ","type":"text"},{"type":"reference","identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/Query","isActive":true},{"text":" to read components, and iterate it as you would a world’s query","type":"text"},{"text":" ","type":"text"},{"text":"results. Take an ","type":"text"},{"type":"reference","identifier":"doc:\/\/Systems\/documentation\/Systems\/Update","isActive":true},{"text":" to change them in place. An","type":"text"},{"text":" ","type":"text"},{"text":"update can also read other components with ","type":"text"},{"type":"codeVoice","code":"Over"},{"text":", and narrow the entities it visits with","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"Where"},{"text":":","type":"text"}],"type":"paragraph"},{"syntax":"swift","type":"codeListing","code":["@System","struct Climb {","    func run(_ climbers: Update<Position>.Over<Velocity>.Where<Without<Frozen>>) {","        climbers { position, row in","            position.y += abs(row.components.dy)","        }","    }","}","","var world = World()","let climber = world.spawn(Position(x: 0, y: 0), Velocity(dx: 0, dy: -3))","let statue = world.spawn(Position(x: 0, y: 0), Velocity(dx: 0, dy: -3), Frozen())","Schedule { Climb() }.run(on: &world)","","print(world[Position.self, of: climber].y)","\/\/ Prints \"3.0\"","print(world[Position.self, of: statue].y)","\/\/ Prints \"0.0\""]},{"inlineContent":[{"code":"Climb","type":"codeVoice"},{"text":" writes ","type":"text"},{"code":"Position","type":"codeVoice"},{"text":" and reads ","type":"text"},{"code":"Velocity","type":"codeVoice"},{"text":" and ","type":"text"},{"code":"Frozen","type":"codeVoice"},{"text":". It conflicts with any system that","type":"text"},{"text":" ","type":"text"},{"text":"writes ","type":"text"},{"code":"Velocity","type":"codeVoice"},{"text":" or ","type":"text"},{"code":"Frozen","type":"codeVoice"},{"text":", or reads or writes ","type":"text"},{"code":"Position","type":"codeVoice"},{"text":", and runs at the same time as any","type":"text"},{"text":" ","type":"text"},{"text":"other.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"A parameter’s filter is a list of filter types in "},{"type":"codeVoice","code":"Where"},{"type":"text","text":": "},{"isActive":true,"type":"reference","identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/With"},{"type":"text","text":","},{"type":"text","text":" "},{"isActive":true,"type":"reference","identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/Without"},{"type":"text","text":", "},{"isActive":true,"type":"reference","identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/Added"},{"type":"text","text":", "},{"isActive":true,"type":"reference","identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/Changed"},{"type":"text","text":","},{"type":"text","text":" "},{"isActive":true,"type":"reference","identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/Allows"},{"type":"text","text":" and "},{"isActive":true,"type":"reference","identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/AnyOf"},{"type":"text","text":" of filter types. Each mirrors the query filter"},{"type":"text","text":" "},{"type":"text","text":"of the same name."}],"type":"paragraph"},{"inlineContent":[{"text":"Two parameters that name the same component, one of them writing it, are a compile-time error.","type":"text"},{"text":" ","type":"text"},{"text":"A conflict the macro can’t see by name, such as one through a type alias, traps when a schedule","type":"text"},{"text":" ","type":"text"},{"text":"takes the system.","type":"text"}],"type":"paragraph"},{"anchor":"Read-and-Write-Resources-and-Events","level":3,"type":"heading","text":"Read and Write Resources and Events"},{"inlineContent":[{"type":"text","text":"A "},{"isActive":true,"type":"reference","identifier":"doc:\/\/Systems\/documentation\/Systems\/ResourceReader"},{"type":"text","text":" reads a resource and a "},{"isActive":true,"type":"reference","identifier":"doc:\/\/Systems\/documentation\/Systems\/ResourceWriter"},{"type":"text","text":" changes one. An "},{"isActive":true,"type":"reference","identifier":"doc:\/\/Systems\/documentation\/Systems\/EventWriter"},{"type":"text","text":" "},{"type":"text","text":"sends events, and an "},{"isActive":true,"type":"reference","identifier":"doc:\/\/Systems\/documentation\/Systems\/EventReader"},{"type":"text","text":" reads the events sent since the system last read them. The"},{"type":"text","text":" "},{"type":"text","text":"following schedule sends a "},{"type":"codeVoice","code":"Damage"},{"type":"text","text":" event for each entity below the ground, then applies the"},{"type":"text","text":" "},{"type":"text","text":"damage to its target’s health:"}],"type":"paragraph"},{"syntax":"swift","type":"codeListing","code":["var world = World()","let knight = world.spawn(Position(x: 0, y: -1), Health(current: 30))","","let frame = Schedule {","    UpdateEvents()","    Combat()","    ApplyDamage().after(Combat.self)","}","frame.run(on: &world)","print(world[Health.self, of: knight].current)","\/\/ Prints \"20\""]},{"inlineContent":[{"type":"reference","isActive":true,"identifier":"doc:\/\/Systems\/documentation\/Systems\/EventWriter"},{"type":"text","text":" declares "},{"type":"codeVoice","code":"Combat"},{"type":"text","text":", and "},{"type":"reference","isActive":true,"identifier":"doc:\/\/Systems\/documentation\/Systems\/EventReader"},{"type":"text","text":" declares "},{"type":"codeVoice","code":"ApplyDamage"},{"type":"text","text":"."}],"type":"paragraph"},{"anchor":"Spawn-and-Despawn-Entities","level":3,"type":"heading","text":"Spawn and Despawn Entities"},{"inlineContent":[{"text":"A system that runs alongside others can’t spawn or despawn entities directly, because that","type":"text"},{"text":" ","type":"text"},{"text":"changes every component type at once. Take an ","type":"text"},{"type":"codeVoice","code":"inout"},{"text":" ","type":"text"},{"type":"reference","isActive":true,"identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/Commands"},{"text":" instead, and queue","type":"text"},{"text":" ","type":"text"},{"text":"the changes. Commands apply at the end of the wave the system runs in, so systems ordered after","type":"text"},{"text":" ","type":"text"},{"text":"it see them:","type":"text"}],"type":"paragraph"},{"syntax":"swift","type":"codeListing","code":["@System","struct RemoveDefeated {","    func run(_ fighters: Query<Health>, _ commands: inout Commands) {","        for (entity, health) in fighters where health.current <= 0 {","            commands.despawn(entity)","        }","    }","}","","var world = World()","let knight = world.spawn(Health(current: 0))","world.spawn(Health(current: 12))","Schedule { RemoveDefeated() }.run(on: &world)","","print(world.contains(knight))","\/\/ Prints \"false\"","print(world.count)","\/\/ Prints \"1\""]},{"inlineContent":[{"type":"text","text":"A commands parameter conflicts with nothing, so it doesn’t stop a system from running at the"},{"type":"text","text":" "},{"type":"text","text":"same time as others."}],"type":"paragraph"},{"anchor":"Take-the-Whole-World","level":3,"type":"heading","text":"Take the Whole World"},{"inlineContent":[{"text":"A ","type":"text"},{"code":"run","type":"codeVoice"},{"text":" method that takes ","type":"text"},{"code":"inout World","type":"codeVoice"},{"text":" makes a system that can change anything. Its access is","type":"text"},{"text":" ","type":"text"},{"code":"nil","type":"codeVoice"},{"text":", so a schedule runs it alone, after the systems written before it and before those written","type":"text"},{"text":" ","type":"text"},{"text":"after it. Use one for work that touches many types at once, such as loading a level.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"To write a system by hand instead of with the macro, conform a type to ","type":"text"},{"identifier":"doc:\/\/Systems\/documentation\/Systems\/System","type":"reference","isActive":true},{"text":", implement","type":"text"},{"text":" ","type":"text"},{"identifier":"doc:\/\/Systems\/documentation\/Systems\/System\/run(in:)","type":"reference","isActive":true},{"text":", and declare an ","type":"text"},{"identifier":"doc:\/\/Systems\/documentation\/Systems\/System\/access","type":"reference","isActive":true},{"text":" listing every type the system reads and","type":"text"},{"text":" ","type":"text"},{"text":"writes.","type":"text"}],"type":"paragraph"},{"anchor":"Run-on-the-Main-Actor","level":3,"type":"heading","text":"Run on the Main Actor"},{"inlineContent":[{"type":"text","text":"Mark a system type, or its "},{"type":"codeVoice","code":"run"},{"type":"text","text":" method, "},{"type":"codeVoice","code":"@MainActor"},{"type":"text","text":" to make a "},{"type":"reference","isActive":true,"identifier":"doc:\/\/Systems\/documentation\/Systems\/MainActorSystem"},{"type":"text","text":", which a"},{"type":"text","text":" "},{"type":"text","text":"schedule runs on the main actor after the other systems of its wave. Use one to carry results"},{"type":"text","text":" "},{"type":"text","text":"from the world to a user interface."}],"type":"paragraph"},{"inlineContent":[{"text":"Once you’ve declared systems, see ","type":"text"},{"identifier":"doc:\/\/Systems\/documentation\/Systems\/SchedulingSystems","isActive":true,"type":"reference"},{"text":" to order them and run them only when","type":"text"},{"text":" ","type":"text"},{"text":"a condition holds.","type":"text"}],"type":"paragraph"}],"kind":"content"}],"abstract":[{"text":"Write the rules of a simulation as systems, and let their parameters state what they read and","type":"text"},{"text":" ","type":"text"},{"text":"write.","type":"text"}],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/Systems\/documentation\/Systems\/DeclaringSystems"},"references":{"doc://Systems/documentation/Systems/SchedulingSystems":{"type":"topic","kind":"article","identifier":"doc:\/\/Systems\/documentation\/Systems\/SchedulingSystems","url":"\/documentation\/systems\/schedulingsystems","role":"article","abstract":[{"text":"Order the systems of a schedule, run them only when a condition holds, and find out how a","type":"text"},{"text":" ","type":"text"},{"text":"schedule runs them.","type":"text"}],"title":"Scheduling Systems"},"doc://WorldModule/documentation/WorldModule/AnyOf":{"navigatorTitle":[{"text":"AnyOf","kind":"identifier"}],"title":"AnyOf","identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/AnyOf","url":"\/documentation\/worldmodule\/anyof","role":"symbol","type":"topic","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"AnyOf","kind":"identifier"}],"kind":"symbol","abstract":[{"text":"A group of types an entity matches by matching at least one of them.","type":"text"}]},"doc://Systems/documentation/Systems/System/access":{"defaultImplementations":1,"required":true,"kind":"symbol","title":"access","role":"symbol","identifier":"doc:\/\/Systems\/documentation\/Systems\/System\/access","abstract":[{"type":"text","text":"The component, resource and event types the system reads and writes, or "},{"code":"nil","type":"codeVoice"},{"type":"text","text":" if it may"},{"type":"text","text":" "},{"type":"text","text":"change anything."}],"url":"\/documentation\/systems\/system\/access","type":"topic","fragments":[{"kind":"keyword","text":"var"},{"kind":"text","text":" "},{"text":"access","kind":"identifier"},{"text":": ","kind":"text"},{"text":"Access","kind":"typeIdentifier","preciseIdentifier":"s:11WorldModule6AccessV"},{"text":"?","kind":"text"}]},"doc://Systems/documentation/Systems/System":{"navigatorTitle":[{"kind":"identifier","text":"System"}],"title":"System","fragments":[{"kind":"keyword","text":"protocol"},{"kind":"text","text":" "},{"kind":"identifier","text":"System"}],"type":"topic","identifier":"doc:\/\/Systems\/documentation\/Systems\/System","abstract":[{"type":"text","text":"A rule that reads and changes a world, run once each time its schedule runs."}],"url":"\/documentation\/systems\/system","role":"symbol","kind":"symbol"},"doc://WorldModule/documentation/WorldModule/Allows":{"identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/Allows","kind":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"Allows"}],"role":"symbol","title":"Allows","navigatorTitle":[{"kind":"identifier","text":"Allows"}],"abstract":[{"text":"A filter type that also passes the entities holding a disabling component of type ","type":"text"},{"code":"C","type":"codeVoice"},{"text":".","type":"text"}],"type":"topic","url":"\/documentation\/worldmodule\/allows"},"doc://Systems/documentation/Systems/Update":{"type":"topic","kind":"symbol","identifier":"doc:\/\/Systems\/documentation\/Systems\/Update","url":"\/documentation\/systems\/update","navigatorTitle":[{"kind":"identifier","text":"Update"}],"role":"symbol","abstract":[{"type":"text","text":"A system parameter that changes a component of every entity that holds it."}],"title":"Update","fragments":[{"kind":"keyword","text":"class"},{"kind":"text","text":" "},{"kind":"identifier","text":"Update"}]},"doc://Systems/documentation/Systems/System/run(in:)":{"type":"topic","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"run","kind":"identifier"},{"text":"(","kind":"text"},{"text":"in","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"inout","kind":"keyword"},{"text":" ","kind":"text"},{"text":"World","kind":"typeIdentifier","preciseIdentifier":"s:11WorldModule0A0V"},{"text":")","kind":"text"}],"required":true,"title":"run(in:)","role":"symbol","url":"\/documentation\/systems\/system\/run(in:)","abstract":[{"text":"Runs the system’s rule once on a world.","type":"text"}],"kind":"symbol","identifier":"doc:\/\/Systems\/documentation\/Systems\/System\/run(in:)"},"doc://Systems/documentation/Systems/EventReader":{"type":"topic","abstract":[{"type":"text","text":"A system parameter that reads the events of one type sent since the system last read them."}],"identifier":"doc:\/\/Systems\/documentation\/Systems\/EventReader","kind":"symbol","role":"symbol","url":"\/documentation\/systems\/eventreader","navigatorTitle":[{"text":"EventReader","kind":"identifier"}],"title":"EventReader","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"EventReader","kind":"identifier"}]},"doc://WorldModule/documentation/WorldModule/Added":{"navigatorTitle":[{"kind":"identifier","text":"Added"}],"title":"Added","url":"\/documentation\/worldmodule\/added","identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/Added","role":"symbol","type":"topic","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"Added"}],"kind":"symbol","abstract":[{"text":"A filter type that passes the entities whose component of type ","type":"text"},{"type":"codeVoice","code":"C"},{"text":" was added since the","type":"text"},{"text":" ","type":"text"},{"text":"world’s last run.","type":"text"}]},"doc://Systems/documentation/Systems/RemovedComponents":{"type":"topic","kind":"symbol","identifier":"doc:\/\/Systems\/documentation\/Systems\/RemovedComponents","url":"\/documentation\/systems\/removedcomponents","navigatorTitle":[{"text":