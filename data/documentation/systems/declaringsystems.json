{"kind":"article","hierarchy":{"paths":[["doc:\/\/Systems\/documentation\/Systems"]]},"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/Systems\/documentation\/Systems\/DeclaringSystems"},"primaryContentSections":[{"content":[{"type":"heading","anchor":"Overview","level":2,"text":"Overview"},{"type":"paragraph","inlineContent":[{"type":"text","text":"A system is a type with a "},{"type":"codeVoice","code":"run"},{"type":"text","text":" method that a schedule calls once per run. The "},{"type":"reference","identifier":"doc:\/\/Systems\/documentation\/Systems\/System()","isActive":true},{"type":"text","text":" "},{"type":"text","text":"macro turns a structure into a system from the parameters of its "},{"type":"codeVoice","code":"run"},{"type":"text","text":" method. Each parameter’s"},{"type":"text","text":" "},{"type":"text","text":"type says what part of the world the system works on and whether it reads or writes it, so the"},{"type":"text","text":" "},{"type":"text","text":"system’s "},{"type":"reference","identifier":"doc:\/\/Systems\/documentation\/Systems\/System\/access","isActive":true},{"type":"text","text":" is always exact, and a schedule can run systems that don’t conflict at"},{"type":"text","text":" "},{"type":"text","text":"the same time."}]},{"type":"heading","anchor":"Read-and-Write-Components","level":3,"text":"Read and Write Components"},{"type":"paragraph","inlineContent":[{"text":"Take a ","type":"text"},{"isActive":true,"identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/Query","type":"reference"},{"text":" to read components, and iterate it as you would a world’s query","type":"text"},{"text":" ","type":"text"},{"text":"results. Take an ","type":"text"},{"isActive":true,"identifier":"doc:\/\/Systems\/documentation\/Systems\/Update","type":"reference"},{"text":" to change them in place. An","type":"text"},{"text":" ","type":"text"},{"text":"update can also read other components with ","type":"text"},{"type":"codeVoice","code":"Over"},{"text":", and narrow the entities it visits with","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"Where"},{"text":":","type":"text"}]},{"type":"codeListing","code":["@System","struct Climb {","    func run(_ climbers: Update<Position>.Over<Velocity>.Where<Without<Frozen>>) {","        climbers { position, row in","            position.y += abs(row.components.dy)","        }","    }","}","","var world = World()","let climber = world.spawn(Position(x: 0, y: 0), Velocity(dx: 0, dy: -3))","let statue = world.spawn(Position(x: 0, y: 0), Velocity(dx: 0, dy: -3), Frozen())","Schedule { Climb() }.run(on: &world)","","print(world[Position.self, of: climber].y)","\/\/ Prints \"3.0\"","print(world[Position.self, of: statue].y)","\/\/ Prints \"0.0\""],"syntax":"swift"},{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"Climb"},{"type":"text","text":" writes "},{"type":"codeVoice","code":"Position"},{"type":"text","text":" and reads "},{"type":"codeVoice","code":"Velocity"},{"type":"text","text":" and "},{"type":"codeVoice","code":"Frozen"},{"type":"text","text":". It conflicts with any system that"},{"type":"text","text":" "},{"type":"text","text":"writes "},{"type":"codeVoice","code":"Velocity"},{"type":"text","text":" or "},{"type":"codeVoice","code":"Frozen"},{"type":"text","text":", or reads or writes "},{"type":"codeVoice","code":"Position"},{"type":"text","text":", and runs at the same time as any"},{"type":"text","text":" "},{"type":"text","text":"other."}]},{"type":"heading","anchor":"Read-and-Write-Resources-and-Events","level":3,"text":"Read and Write Resources and Events"},{"type":"paragraph","inlineContent":[{"type":"text","text":"A "},{"type":"reference","identifier":"doc:\/\/Systems\/documentation\/Systems\/ResourceReader","isActive":true},{"type":"text","text":" reads a resource and a "},{"type":"reference","identifier":"doc:\/\/Systems\/documentation\/Systems\/ResourceWriter","isActive":true},{"type":"text","text":" changes one. An "},{"type":"reference","identifier":"doc:\/\/Systems\/documentation\/Systems\/EventWriter","isActive":true},{"type":"text","text":" "},{"type":"text","text":"sends events, and an "},{"type":"reference","identifier":"doc:\/\/Systems\/documentation\/Systems\/EventReader","isActive":true},{"type":"text","text":" reads the events sent since the system last read them. The"},{"type":"text","text":" "},{"type":"text","text":"following schedule sends a "},{"type":"codeVoice","code":"Damage"},{"type":"text","text":" event for each entity below the ground, then applies the"},{"type":"text","text":" "},{"type":"text","text":"damage to its target’s health:"}]},{"type":"codeListing","code":["var world = World()","let knight = world.spawn(Position(x: 0, y: -1), Health(current: 30))","","let frame = Schedule {","    UpdateEvents()","    Combat()","    ApplyDamage().after(Combat.self)","}","frame.run(on: &world)","print(world[Health.self, of: knight].current)","\/\/ Prints \"20\""],"syntax":"swift"},{"type":"paragraph","inlineContent":[{"type":"reference","isActive":true,"identifier":"doc:\/\/Systems\/documentation\/Systems\/EventWriter"},{"type":"text","text":" declares "},{"type":"codeVoice","code":"Combat"},{"type":"text","text":", and "},{"type":"reference","isActive":true,"identifier":"doc:\/\/Systems\/documentation\/Systems\/EventReader"},{"type":"text","text":" declares "},{"type":"codeVoice","code":"ApplyDamage"},{"type":"text","text":"."}]},{"type":"heading","anchor":"Spawn-and-Despawn-Entities","level":3,"text":"Spawn and Despawn Entities"},{"type":"paragraph","inlineContent":[{"text":"A system that runs alongside others can’t spawn or despawn entities directly, because that","type":"text"},{"text":" ","type":"text"},{"text":"changes every component type at once. Take an ","type":"text"},{"type":"codeVoice","code":"inout"},{"text":" ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/Commands"},{"text":" instead, and queue","type":"text"},{"text":" ","type":"text"},{"text":"the changes. Commands apply at the end of the wave the system runs in, so systems ordered after","type":"text"},{"text":" ","type":"text"},{"text":"it see them:","type":"text"}]},{"type":"codeListing","code":["@System","struct RemoveDefeated {","    func run(_ fighters: Query<Health>, _ commands: inout Commands) {","        for (entity, health) in fighters where health.current <= 0 {","            commands.despawn(entity)","        }","    }","}","","var world = World()","let knight = world.spawn(Health(current: 0))","world.spawn(Health(current: 12))","Schedule { RemoveDefeated() }.run(on: &world)","","print(world.contains(knight))","\/\/ Prints \"false\"","print(world.count)","\/\/ Prints \"1\""],"syntax":"swift"},{"type":"paragraph","inlineContent":[{"text":"A commands parameter conflicts with nothing, so it doesn’t stop a system from running at the","type":"text"},{"text":" ","type":"text"},{"text":"same time as others.","type":"text"}]},{"type":"heading","anchor":"Take-the-Whole-World","level":3,"text":"Take the Whole World"},{"type":"paragraph","inlineContent":[{"type":"text","text":"A "},{"type":"codeVoice","code":"run"},{"type":"text","text":" method that takes "},{"type":"codeVoice","code":"inout World"},{"type":"text","text":" makes a system that can change anything. Its access is"},{"type":"text","text":" "},{"type":"codeVoice","code":"nil"},{"type":"text","text":", so a schedule runs it alone, after the systems written before it and before those written"},{"type":"text","text":" "},{"type":"text","text":"after it. Use one for work that touches many types at once, such as loading a level."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"To write a system by hand instead of with the macro, conform a type to "},{"type":"reference","isActive":true,"identifier":"doc:\/\/Systems\/documentation\/Systems\/System"},{"type":"text","text":", implement"},{"type":"text","text":" "},{"type":"reference","isActive":true,"identifier":"doc:\/\/Systems\/documentation\/Systems\/System\/run(in:)"},{"type":"text","text":", and declare an "},{"type":"reference","isActive":true,"identifier":"doc:\/\/Systems\/documentation\/Systems\/System\/access"},{"type":"text","text":" listing every type the system reads and"},{"type":"text","text":" "},{"type":"text","text":"writes."}]},{"type":"heading","anchor":"Run-on-the-Main-Actor","level":3,"text":"Run on the Main Actor"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Mark a system type, or its "},{"type":"codeVoice","code":"run"},{"type":"text","text":" method, "},{"type":"codeVoice","code":"@MainActor"},{"type":"text","text":" to make a "},{"type":"reference","identifier":"doc:\/\/Systems\/documentation\/Systems\/MainActorSystem","isActive":true},{"type":"text","text":", which a"},{"type":"text","text":" "},{"type":"text","text":"schedule runs on the main actor after the other systems of its wave. Use one to carry results"},{"type":"text","text":" "},{"type":"text","text":"from the world to a user interface."}]}],"kind":"content"}],"abstract":[{"text":"Write the rules of a simulation as systems, and let their parameters state what they read and","type":"text"},{"text":" ","type":"text"},{"text":"write.","type":"text"}],"metadata":{"title":"Declaring Systems","modules":[{"name":"Systems"}],"roleHeading":"API Collection","role":"collectionGroup"},"variants":[{"paths":["\/documentation\/systems\/declaringsystems"],"traits":[{"interfaceLanguage":"swift"}]}],"schemaVersion":{"patch":0,"major":0,"minor":3},"seeAlsoSections":[{"title":"Essentials","anchor":"Essentials","identifiers":["doc:\/\/Systems\/documentation\/Systems\/DrivingAWorldFromAnApp","doc:\/\/Systems\/documentation\/Systems\/System()","doc:\/\/Systems\/documentation\/Systems\/System"],"generated":true}],"topicSections":[{"title":"Declaring Systems","anchor":"Declaring-Systems","identifiers":["doc:\/\/Systems\/documentation\/Systems\/System()","doc:\/\/Systems\/documentation\/Systems\/System","doc:\/\/Systems\/documentation\/Systems\/MainActorSystem"]},{"title":"System Parameters","anchor":"System-Parameters","identifiers":["doc:\/\/Systems\/documentation\/Systems\/Update","doc:\/\/Systems\/documentation\/Systems\/ResourceReader","doc:\/\/Systems\/documentation\/Systems\/ResourceWriter","doc:\/\/Systems\/documentation\/Systems\/EventReader","doc:\/\/Systems\/documentation\/Systems\/EventWriter","doc:\/\/Systems\/documentation\/Systems\/RemovedComponents"]}],"sections":[],"references":{"doc://WorldModule/documentation/WorldModule/Query":{"url":"\/documentation\/worldmodule\/query","identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/Query","navigatorTitle":[{"kind":"identifier","text":"Query"}],"type":"topic","abstract":[{"text":"A description of the entities to visit and the components to read from each.","type":"text"}],"kind":"symbol","title":"Query","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"Query"}],"role":"symbol"},"doc://Systems/documentation/Systems/RemovedComponents":{"role":"symbol","kind":"symbol","type":"topic","identifier":"doc:\/\/Systems\/documentation\/Systems\/RemovedComponents","abstract":[{"type":"text","text":"A system parameter that lists the entities that lost a component since the system last read"},{"type":"text","text":" "},{"type":"text","text":"them."}],"fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"RemovedComponents","kind":"identifier"}],"navigatorTitle":[{"text":"RemovedComponents","kind":"identifier"}],"title":"RemovedComponents","url":"\/documentation\/systems\/removedcomponents"},"doc://Systems/documentation/Systems/ResourceReader":{"title":"ResourceReader","role":"symbol","identifier":"doc:\/\/Systems\/documentation\/Systems\/ResourceReader","type":"topic","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"ResourceReader","kind":"identifier"}],"url":"\/documentation\/systems\/resourcereader","kind":"symbol","navigatorTitle":[{"text":"ResourceReader","kind":"identifier"}],"abstract":[{"type":"text","text":"A system parameter that reads a resource."}]},"doc://Systems/documentation/Systems":{"role":"collection","kind":"symbol","type":"topic","identifier":"doc:\/\/Systems\/documentation\/Systems","abstract":[{"text":"Declare the rules of a simulation as systems, and run them on a world in a schedule.","type":"text"}],"title":"Systems","url":"\/documentation\/systems"},"doc://Systems/documentation/Systems/EventReader":{"navigatorTitle":[{"text":"EventReader","kind":"identifier"}],"title":"EventReader","abstract":[{"type":"text","text":"A system parameter that reads the events of one type sent since the system last read them."}],"kind":"symbol","identifier":"doc:\/\/Systems\/documentation\/Systems\/EventReader","role":"symbol","type":"topic","url":"\/documentation\/systems\/eventreader","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"EventReader","kind":"identifier"}]},"doc://Systems/documentation/Systems/System":{"url":"\/documentation\/systems\/system","identifier":"doc:\/\/Systems\/documentation\/Systems\/System","navigatorTitle":[{"kind":"identifier","text":"System"}],"type":"topic","abstract":[{"type":"text","text":"A rule that reads and changes a world, run once each time its schedule runs."}],"kind":"symbol","title":"System","fragments":[{"kind":"keyword","text":"protocol"},{"kind":"text","text":" "},{"kind":"identifier","text":"System"}],"role":"symbol"},"doc://Systems/documentation/Systems/System/access":{"role":"symbol","title":"access","fragments":[{"text":"var","kind":"keyword"},{"text":" ","kind":"text"},{"text":"access","kind":"identifier"},{"text":": ","kind":"text"},{"text":"Access","kind":"typeIdentifier","preciseIdentifier":"s:11WorldModule6AccessV"},{"text":"?","kind":"text"}],"required":true,"defaultImplementations":1,"identifier":"doc:\/\/Systems\/documentation\/Systems\/System\/access","kind":"symbol","abstract":[{"type":"text","text":"The component, resource and event types the system reads and writes, or "},{"type":"codeVoice","code":"nil"},{"type":"text","text":" if it may"},{"type":"text","text":" "},{"type":"text","text":"change anything."}],"type":"topic","url":"\/documentation\/systems\/system\/access"},"doc://Systems/documentation/Systems/EventWriter":{"type":"topic","identifier":"doc:\/\/Systems\/documentation\/Systems\/EventWriter","role":"symbol","url":"\/documentation\/systems\/eventwriter","kind":"symbol","title":"EventWriter","abstract":[{"type":"text","text":"A system parameter that sends events of one type."}],"fragments":[{"text":"class","kind":"keyword"},{"text":" ","kind":"text"},{"text":"EventWriter","kind":"identifier"}],"navigatorTitle":[{"text":"EventWriter","kind":"identifier"}]},"doc://Systems/documentation/Systems/System/run(in:)":{"title":"run(in:)","role":"symbol","identifier":"doc:\/\/Systems\/documentation\/Systems\/System\/run(in:)","type":"topic","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"run"},{"kind":"text","text":"("},{"kind":"externalParam","text":"in"},{"kind":"text","text":": "},{"text":"inout","kind":"keyword"},{"text":" ","kind":"text"},{"text":"World","kind":"typeIdentifier","preciseIdentifier":"s:11WorldModule0A0V"},{"text":")","kind":"text"}],"url":"\/documentation\/systems\/system\/run(in:)","kind":"symbol","abstract":[{"type":"text","text":"Runs the system’s rule once on a world."}],"required":true},"doc://Systems/documentation/Systems/ResourceWriter":{"url":"\/documentation\/systems\/resourcewriter","identifier":"doc:\/\/Systems\/documentation\/Systems\/ResourceWriter","navigatorTitle":[{"text":"ResourceWriter","kind":"identifier"}],"type":"topic","abstract":[{"type":"text","text":"A system parameter that reads and writes a resource."}],"kind":"symbol","title":"ResourceWriter","fragments":[{"text":"class","kind":"keyword"},{"text":" ","kind":"text"},{"text":"ResourceWriter","kind":"identifier"}],"role":"symbol"},"doc://WorldModule/documentation/WorldModule/Commands":{"url":"\/documentation\/worldmodule\/commands","identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/Commands","navigatorTitle":[{"text":"Commands","kind":"identifier"}],"type":"topic","abstract":[{"type":"text","text":"A buffer of changes to a world, recorded now and applied later in the order they were"},{"type":"text","text":" "},{"type":"text","text":"recorded."}],"kind":"symbol","title":"Commands","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Commands","kind":"identifier"}],"role":"symbol"},"doc://Systems/documentation/Systems/MainActorSystem":{"role":"symbol","kind":"symbol","type":"topic","identifier":"doc:\/\/Systems\/documentation\/Systems\/MainActorSystem","abstract":[{"type":"text","text":"A system that runs on the main actor, for work that touches main-actor state such as a user"},{"type":"text","text":" "},{"type":"text","text":"interface."}],"fragments":[{"kind":"keyword","text":"protocol"},{"kind":"text","text":" "},{"kind":"identifier","text":"MainActorSystem"}],"navigatorTitle":[{"kind":"identifier","text":"MainActorSystem"}],"title":"MainActorSystem","url":"\/documentation\/systems\/mainactorsystem"},"doc://Systems/documentation/Systems/System()":{"role":"symbol","kind":"symbol","type":"topic","identifier":"doc:\/\/Systems\/documentation\/Systems\/System()","abstract":[{"type":"text","text":"Makes a type a system whose access comes from the parameters of its "},{"code":"run","type":"codeVoice"},{"type":"text","text":" method."}],"fragments":[{"text":"macro","kind":"keyword"},{"text":" ","kind":"text"},{"text":"System","kind":"identifier"},{"text":"()","kind":"text"}],"title":"System()","url":"\/documentation\/systems\/system()"},"doc://Systems/documentation/Systems/Update":{"navigatorTitle":[{"text":"Update","kind":"identifier"}],"abstract":[{"text":"A system parameter that changes a component of every entity that holds it.","type":"text"}],"title":"Update","kind":"symbol","identifier":"doc:\/\/Systems\/documentation\/Systems\/Update","role":"symbol","type":"topic","url":"\/documentation\/systems\/update","fragments":[{"text":"class","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Update","kind":"identifier"}]},"doc://Systems/documentation/Systems/DrivingAWorldFromAnApp":{"role":"article","kind":"article","type":"topic","identifier":"doc:\/\/Systems\/documentation\/Systems\/DrivingAWorldFromAnApp","abstract":[{"text":"Hold a world in your app or game engine, feed it each frame’s input, and let the objects outside","type":"text"},{"text":" ","type":"text"},{"text":"it read results and take part in a step.","type":"text"}],"title":"Driving a World from an App","url":"\/documentation\/systems\/drivingaworldfromanapp"}}}