{"kind":"article","topicSections":[{"identifiers":["doc:\/\/Systems\/documentation\/Systems\/System()","doc:\/\/Systems\/documentation\/Systems\/System","doc:\/\/Systems\/documentation\/Systems\/MainActorSystem"],"anchor":"Declaring-Systems","title":"Declaring Systems"},{"identifiers":["doc:\/\/Systems\/documentation\/Systems\/Update","doc:\/\/Systems\/documentation\/Systems\/ResourceReader","doc:\/\/Systems\/documentation\/Systems\/ResourceWriter","doc:\/\/Systems\/documentation\/Systems\/EventReader","doc:\/\/Systems\/documentation\/Systems\/EventWriter","doc:\/\/Systems\/documentation\/Systems\/RemovedComponents"],"anchor":"System-Parameters","title":"System Parameters"}],"seeAlsoSections":[{"identifiers":["doc:\/\/Systems\/documentation\/Systems\/DrivingAWorldFromAnApp","doc:\/\/Systems\/documentation\/Systems\/System()","doc:\/\/Systems\/documentation\/Systems\/System"],"anchor":"Essentials","generated":true,"title":"Essentials"}],"abstract":[{"text":"Write the rules of a simulation as systems, and let their parameters state what they read and","type":"text"},{"text":" ","type":"text"},{"text":"write.","type":"text"}],"hierarchy":{"paths":[["doc:\/\/Systems\/documentation\/Systems"]]},"primaryContentSections":[{"content":[{"anchor":"Overview","level":2,"type":"heading","text":"Overview"},{"inlineContent":[{"type":"text","text":"A system is a type with a "},{"code":"run","type":"codeVoice"},{"type":"text","text":" method that a schedule calls once per run. The "},{"identifier":"doc:\/\/Systems\/documentation\/Systems\/System()","type":"reference","isActive":true},{"type":"text","text":" "},{"type":"text","text":"macro turns a structure into a system from the parameters of its "},{"code":"run","type":"codeVoice"},{"type":"text","text":" method. Each parameter’s"},{"type":"text","text":" "},{"type":"text","text":"type says what part of the world the system works on and whether it reads or writes it, so the"},{"type":"text","text":" "},{"type":"text","text":"system’s "},{"identifier":"doc:\/\/Systems\/documentation\/Systems\/System\/access","type":"reference","isActive":true},{"type":"text","text":" is always exact, and a schedule can run systems that don’t conflict at"},{"type":"text","text":" "},{"type":"text","text":"the same time."}],"type":"paragraph"},{"anchor":"Read-and-Write-Components","level":3,"type":"heading","text":"Read and Write Components"},{"inlineContent":[{"type":"text","text":"Take a "},{"type":"reference","identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/Query","isActive":true},{"type":"text","text":" to read components, and iterate it as you would a world’s query"},{"type":"text","text":" "},{"type":"text","text":"results. Take an "},{"type":"reference","identifier":"doc:\/\/Systems\/documentation\/Systems\/Update","isActive":true},{"type":"text","text":" to change them in place. An"},{"type":"text","text":" "},{"type":"text","text":"update can also read other components with "},{"type":"codeVoice","code":"Over"},{"type":"text","text":", and narrow the entities it visits with"},{"type":"text","text":" "},{"type":"codeVoice","code":"Where"},{"type":"text","text":":"}],"type":"paragraph"},{"code":["@System","struct Climb {","    func run(_ climbers: Update<Position>.Over<Velocity>.Where<Without<Frozen>>) {","        climbers { position, row in","            position.y += abs(row.components.dy)","        }","    }","}","","var world = World()","let climber = world.spawn(Position(x: 0, y: 0), Velocity(dx: 0, dy: -3))","let statue = world.spawn(Position(x: 0, y: 0), Velocity(dx: 0, dy: -3), Frozen())","Schedule { Climb() }.run(on: &world)","","print(world[Position.self, of: climber].y)","\/\/ Prints \"3.0\"","print(world[Position.self, of: statue].y)","\/\/ Prints \"0.0\""],"syntax":"swift","type":"codeListing"},{"inlineContent":[{"code":"Climb","type":"codeVoice"},{"type":"text","text":" writes "},{"code":"Position","type":"codeVoice"},{"type":"text","text":" and reads "},{"code":"Velocity","type":"codeVoice"},{"type":"text","text":" and "},{"code":"Frozen","type":"codeVoice"},{"type":"text","text":". It conflicts with any system that"},{"type":"text","text":" "},{"type":"text","text":"writes "},{"code":"Velocity","type":"codeVoice"},{"type":"text","text":" or "},{"code":"Frozen","type":"codeVoice"},{"type":"text","text":", or reads or writes "},{"code":"Position","type":"codeVoice"},{"type":"text","text":", and runs at the same time as any"},{"type":"text","text":" "},{"type":"text","text":"other."}],"type":"paragraph"},{"anchor":"Read-and-Write-Resources-and-Events","level":3,"type":"heading","text":"Read and Write Resources and Events"},{"inlineContent":[{"type":"text","text":"A "},{"isActive":true,"identifier":"doc:\/\/Systems\/documentation\/Systems\/ResourceReader","type":"reference"},{"type":"text","text":" reads a resource and a "},{"isActive":true,"identifier":"doc:\/\/Systems\/documentation\/Systems\/ResourceWriter","type":"reference"},{"type":"text","text":" changes one. An "},{"isActive":true,"identifier":"doc:\/\/Systems\/documentation\/Systems\/EventWriter","type":"reference"},{"type":"text","text":" "},{"type":"text","text":"sends events, and an "},{"isActive":true,"identifier":"doc:\/\/Systems\/documentation\/Systems\/EventReader","type":"reference"},{"type":"text","text":" reads the events sent since the system last read them. The"},{"type":"text","text":" "},{"type":"text","text":"following schedule sends a "},{"type":"codeVoice","code":"Damage"},{"type":"text","text":" event for each entity below the ground, then applies the"},{"type":"text","text":" "},{"type":"text","text":"damage to its target’s health:"}],"type":"paragraph"},{"code":["var world = World()","let knight = world.spawn(Position(x: 0, y: -1), Health(current: 30))","","let frame = Schedule {","    UpdateEvents()","    Combat()","    ApplyDamage().after(Combat.self)","}","frame.run(on: &world)","print(world[Health.self, of: knight].current)","\/\/ Prints \"20\""],"syntax":"swift","type":"codeListing"},{"inlineContent":[{"identifier":"doc:\/\/Systems\/documentation\/Systems\/EventWriter","type":"reference","isActive":true},{"type":"text","text":" declares "},{"type":"codeVoice","code":"Combat"},{"type":"text","text":", and "},{"identifier":"doc:\/\/Systems\/documentation\/Systems\/EventReader","type":"reference","isActive":true},{"type":"text","text":" declares "},{"type":"codeVoice","code":"ApplyDamage"},{"type":"text","text":"."}],"type":"paragraph"},{"anchor":"Spawn-and-Despawn-Entities","level":3,"type":"heading","text":"Spawn and Despawn Entities"},{"inlineContent":[{"type":"text","text":"A system that runs alongside others can’t spawn or despawn entities directly, because that"},{"type":"text","text":" "},{"type":"text","text":"changes every component type at once. Take an "},{"type":"codeVoice","code":"inout"},{"type":"text","text":" "},{"type":"reference","isActive":true,"identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/Commands"},{"type":"text","text":" instead, and queue"},{"type":"text","text":" "},{"type":"text","text":"the changes. Commands apply at the end of the wave the system runs in, so systems ordered after"},{"type":"text","text":" "},{"type":"text","text":"it see them:"}],"type":"paragraph"},{"code":["@System","struct RemoveDefeated {","    func run(_ fighters: Query<Health>, _ commands: inout Commands) {","        for (entity, health) in fighters where health.current <= 0 {","            commands.despawn(entity)","        }","    }","}","","var world = World()","let knight = world.spawn(Health(current: 0))","world.spawn(Health(current: 12))","Schedule { RemoveDefeated() }.run(on: &world)","","print(world.contains(knight))","\/\/ Prints \"false\"","print(world.count)","\/\/ Prints \"1\""],"syntax":"swift","type":"codeListing"},{"inlineContent":[{"type":"text","text":"A commands parameter conflicts with nothing, so it doesn’t stop a system from running at the"},{"type":"text","text":" "},{"type":"text","text":"same time as others."}],"type":"paragraph"},{"anchor":"Take-the-Whole-World","level":3,"type":"heading","text":"Take the Whole World"},{"inlineContent":[{"text":"A ","type":"text"},{"code":"run","type":"codeVoice"},{"text":" method that takes ","type":"text"},{"code":"inout World","type":"codeVoice"},{"text":" makes a system that can change anything. Its access is","type":"text"},{"text":" ","type":"text"},{"code":"nil","type":"codeVoice"},{"text":", so a schedule runs it alone, after the systems written before it and before those written","type":"text"},{"text":" ","type":"text"},{"text":"after it. Use one for work that touches many types at once, such as loading a level.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"To write a system by hand instead of with the macro, conform a type to ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/Systems\/documentation\/Systems\/System"},{"text":", implement","type":"text"},{"text":" ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/Systems\/documentation\/Systems\/System\/run(in:)"},{"text":", and declare an ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/Systems\/documentation\/Systems\/System\/access"},{"text":" listing every type the system reads and","type":"text"},{"text":" ","type":"text"},{"text":"writes.","type":"text"}],"type":"paragraph"},{"anchor":"Run-on-the-Main-Actor","level":3,"type":"heading","text":"Run on the Main Actor"},{"inlineContent":[{"text":"Mark a system type, or its ","type":"text"},{"code":"run","type":"codeVoice"},{"text":" method, ","type":"text"},{"code":"@MainActor","type":"codeVoice"},{"text":" to make a ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/Systems\/documentation\/Systems\/MainActorSystem"},{"text":", which a","type":"text"},{"text":" ","type":"text"},{"text":"schedule runs on the main actor after the other systems of its wave. Use one to carry results","type":"text"},{"text":" ","type":"text"},{"text":"from the world to a user interface.","type":"text"}],"type":"paragraph"}],"kind":"content"}],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/Systems\/documentation\/Systems\/DeclaringSystems"},"schemaVersion":{"major":0,"minor":3,"patch":0},"sections":[],"variants":[{"paths":["\/documentation\/systems\/declaringsystems"],"traits":[{"interfaceLanguage":"swift"}]}],"metadata":{"role":"collectionGroup","roleHeading":"API Collection","modules":[{"name":"Systems"}],"title":"Declaring Systems"},"references":{"doc://Systems/documentation/Systems/System/run(in:)":{"fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"run","kind":"identifier"},{"text":"(","kind":"text"},{"text":"in","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"inout","kind":"keyword"},{"text":" ","kind":"text"},{"text":"World","kind":"typeIdentifier","preciseIdentifier":"s:11WorldModule0A0V"},{"text":")","kind":"text"}],"required":true,"url":"\/documentation\/systems\/system\/run(in:)","title":"run(in:)","type":"topic","identifier":"doc:\/\/Systems\/documentation\/Systems\/System\/run(in:)","role":"symbol","abstract":[{"type":"text","text":"Runs the system’s rule once on a world."}],"kind":"symbol"},"doc://Systems/documentation/Systems/System()":{"identifier":"doc:\/\/Systems\/documentation\/Systems\/System()","kind":"symbol","fragments":[{"text":"macro","kind":"keyword"},{"text":" ","kind":"text"},{"text":"System","kind":"identifier"},{"text":"()","kind":"text"}],"url":"\/documentation\/systems\/system()","abstract":[{"type":"text","text":"Makes a type a system whose access comes from the parameters of its "},{"type":"codeVoice","code":"run"},{"type":"text","text":" method."}],"title":"System()","role":"symbol","type":"topic"},"doc://WorldModule/documentation/WorldModule/Commands":{"navigatorTitle":[{"text":"Commands","kind":"identifier"}],"identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/Commands","kind":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Commands","kind":"identifier"}],"abstract":[{"type":"text","text":"A buffer of changes to a world, recorded now and applied later in the order they were"},{"type":"text","text":" "},{"type":"text","text":"recorded."}],"url":"\/documentation\/worldmodule\/commands","title":"Commands","role":"symbol","type":"topic"},"doc://Systems/documentation/Systems":{"url":"\/documentation\/systems","title":"Systems","type":"topic","identifier":"doc:\/\/Systems\/documentation\/Systems","role":"collection","abstract":[{"text":"Declare the rules of a simulation as systems, and run them on a world in a schedule.","type":"text"}],"kind":"symbol"},"doc://Systems/documentation/Systems/EventWriter":{"title":"EventWriter","navigatorTitle":[{"kind":"identifier","text":"EventWriter"}],"fragments":[{"kind":"keyword","text":"class"},{"kind":"text","text":" "},{"kind":"identifier","text":"EventWriter"}],"abstract":[{"type":"text","text":"A system parameter that sends events of one type."}],"role":"symbol","url":"\/documentation\/systems\/eventwriter","type":"topic","kind":"symbol","identifier":"doc:\/\/Systems\/documentation\/Systems\/EventWriter"},"doc://WorldModule/documentation/WorldModule/Query":{"kind":"symbol","role":"symbol","url":"\/documentation\/worldmodule\/query","identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/Query","abstract":[{"type":"text","text":"A description of the entities to visit and the components to read from each."}],"type":"topic","navigatorTitle":[{"kind":"identifier","text":"Query"}],"title":"Query","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"Query"}]},"doc://Systems/documentation/Systems/RemovedComponents":{"title":"RemovedComponents","navigatorTitle":[{"kind":"identifier","text":"RemovedComponents"}],"fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"ide