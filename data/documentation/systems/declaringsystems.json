{"seeAlsoSections":[{"identifiers":["doc:\/\/Systems\/documentation\/Systems\/SchedulingSystems","doc:\/\/Systems\/documentation\/Systems\/DrivingAWorldFromAnApp","doc:\/\/Systems\/documentation\/Systems\/System()","doc:\/\/Systems\/documentation\/Systems\/System"],"title":"Essentials","generated":true,"anchor":"Essentials"}],"metadata":{"modules":[{"name":"Systems"}],"role":"collectionGroup","roleHeading":"API Collection","title":"Declaring Systems"},"abstract":[{"type":"text","text":"Write the rules of a simulation as systems, and let their parameters state what they read and"},{"type":"text","text":" "},{"type":"text","text":"write."}],"schemaVersion":{"major":0,"patch":0,"minor":3},"kind":"article","topicSections":[{"identifiers":["doc:\/\/Systems\/documentation\/Systems\/System()","doc:\/\/Systems\/documentation\/Systems\/System","doc:\/\/Systems\/documentation\/Systems\/MainActorSystem"],"title":"Declaring Systems","anchor":"Declaring-Systems"},{"identifiers":["doc:\/\/Systems\/documentation\/Systems\/Update","doc:\/\/Systems\/documentation\/Systems\/ResourceReader","doc:\/\/Systems\/documentation\/Systems\/ResourceWriter","doc:\/\/Systems\/documentation\/Systems\/EventReader","doc:\/\/Systems\/documentation\/Systems\/EventWriter","doc:\/\/Systems\/documentation\/Systems\/RemovedComponents"],"title":"System Parameters","anchor":"System-Parameters"}],"primaryContentSections":[{"content":[{"anchor":"Overview","level":2,"type":"heading","text":"Overview"},{"inlineContent":[{"text":"A system is a type with a ","type":"text"},{"code":"run","type":"codeVoice"},{"text":" method that a schedule calls once per run. The ","type":"text"},{"identifier":"doc:\/\/Systems\/documentation\/Systems\/System()","isActive":true,"type":"reference"},{"text":" ","type":"text"},{"text":"macro turns a structure into a system from the parameters of its ","type":"text"},{"code":"run","type":"codeVoice"},{"text":" method. Each parameter’s","type":"text"},{"text":" ","type":"text"},{"text":"type says what part of the world the system works on and whether it reads or writes it, so the","type":"text"},{"text":" ","type":"text"},{"text":"system’s ","type":"text"},{"identifier":"doc:\/\/Systems\/documentation\/Systems\/System\/access","isActive":true,"type":"reference"},{"text":" is always exact, and a schedule can run systems that don’t conflict at","type":"text"},{"text":" ","type":"text"},{"text":"the same time.","type":"text"}],"type":"paragraph"},{"anchor":"Read-and-Write-Components","level":3,"type":"heading","text":"Read and Write Components"},{"inlineContent":[{"text":"Take a ","type":"text"},{"identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/Query","type":"reference","isActive":true},{"text":" to read components, and iterate it as you would a world’s query","type":"text"},{"text":" ","type":"text"},{"text":"results. Take an ","type":"text"},{"identifier":"doc:\/\/Systems\/documentation\/Systems\/Update","type":"reference","isActive":true},{"text":" to change them in place. An","type":"text"},{"text":" ","type":"text"},{"text":"update can also read other components with ","type":"text"},{"code":"Over","type":"codeVoice"},{"text":", and narrow the entities it visits with","type":"text"},{"text":" ","type":"text"},{"code":"Where","type":"codeVoice"},{"text":":","type":"text"}],"type":"paragraph"},{"syntax":"swift","type":"codeListing","code":["@System","struct Climb {","    func run(_ climbers: Update<Position>.Over<Velocity>.Where<Without<Frozen>>) {","        climbers { position, row in","            position.y += abs(row.components.dy)","        }","    }","}","","var world = World()","let climber = world.spawn(Position(x: 0, y: 0), Velocity(dx: 0, dy: -3))","let statue = world.spawn(Position(x: 0, y: 0), Velocity(dx: 0, dy: -3), Frozen())","Schedule { Climb() }.run(on: &world)","","print(world[Position.self, of: climber].y)","\/\/ Prints \"3.0\"","print(world[Position.self, of: statue].y)","\/\/ Prints \"0.0\""]},{"inlineContent":[{"code":"Climb","type":"codeVoice"},{"text":" writes ","type":"text"},{"code":"Position","type":"codeVoice"},{"text":" and reads ","type":"text"},{"code":"Velocity","type":"codeVoice"},{"text":" and ","type":"text"},{"code":"Frozen","type":"codeVoice"},{"text":". It conflicts with any system that","type":"text"},{"text":" ","type":"text"},{"text":"writes ","type":"text"},{"code":"Velocity","type":"codeVoice"},{"text":" or ","type":"text"},{"code":"Frozen","type":"codeVoice"},{"text":", or reads or writes ","type":"text"},{"code":"Position","type":"codeVoice"},{"text":", and runs at the same time as any","type":"text"},{"text":" ","type":"text"},{"text":"other.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"A parameter’s filter is a list of filter types in ","type":"text"},{"code":"Where","type":"codeVoice"},{"text":": ","type":"text"},{"type":"reference","isActive":true,"identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/With"},{"text":",","type":"text"},{"text":" ","type":"text"},{"type":"reference","isActive":true,"identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/Without"},{"text":", ","type":"text"},{"type":"reference","isActive":true,"identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/Added"},{"text":", ","type":"text"},{"type":"reference","isActive":true,"identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/Changed"},{"text":",","type":"text"},{"text":" ","type":"text"},{"type":"reference","isActive":true,"identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/Allows"},{"text":" and ","type":"text"},{"type":"reference","isActive":true,"identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/AnyOf"},{"text":" of filter types. Each mirrors the query filter","type":"text"},{"text":" ","type":"text"},{"text":"of the same name.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"Two parameters that name the same component, one of them writing it, are a compile-time error."},{"type":"text","text":" "},{"type":"text","text":"A conflict the macro can’t see by name, such as one through a type alias, traps when a schedule"},{"type":"text","text":" "},{"type":"text","text":"takes the system."}],"type":"paragraph"},{"anchor":"Read-and-Write-Resources-and-Events","level":3,"type":"heading","text":"Read and Write Resources and Events"},{"inlineContent":[{"text":"A ","type":"text"},{"identifier":"doc:\/\/Systems\/documentation\/Systems\/ResourceReader","isActive":true,"type":"reference"},{"text":" reads a resource and a ","type":"text"},{"identifier":"doc:\/\/Systems\/documentation\/Systems\/ResourceWriter","isActive":true,"type":"reference"},{"text":" changes one. An ","type":"text"},{"identifier":"doc:\/\/Systems\/documentation\/Systems\/EventWriter","isActive":true,"type":"reference"},{"text":" ","type":"text"},{"text":"sends events, and an ","type":"text"},{"identifier":"doc:\/\/Systems\/documentation\/Systems\/EventReader","isActive":true,"type":"reference"},{"text":" reads the events sent since the system last read them. The","type":"text"},{"text":" ","type":"text"},{"text":"following schedule sends a ","type":"text"},{"code":"Damage","type":"codeVoice"},{"text":" event for each entity below the ground, then applies the","type":"text"},{"text":" ","type":"text"},{"text":"damage to its target’s health:","type":"text"}],"type":"paragraph"},{"syntax":"swift","type":"codeListing","code":["var world = World()","let knight = world.spawn(Position(x: 0, y: -1), Health(current: 30))","","let frame = Schedule {","    UpdateEvents()","    Combat()","    ApplyDamage().after(Combat.self)","}","frame.run(on: &world)","print(world[Health.self, of: knight].current)","\/\/ Prints \"20\""]},{"inlineContent":[{"identifier":"doc:\/\/Systems\/documentation\/Systems\/EventWriter","isActive":true,"type":"reference"},{"text":" declares ","type":"text"},{"code":"Combat","type":"codeVoice"},{"text":", and ","type":"text"},{"identifier":"doc:\/\/Systems\/documentation\/Systems\/EventReader","isActive":true,"type":"reference"},{"text":" declares ","type":"text"},{"code":"ApplyDamage","type":"codeVoice"},{"text":".","type":"text"}],"type":"paragraph"},{"anchor":"Spawn-and-Despawn-Entities","level":3,"type":"heading","text":"Spawn and Despawn Entities"},{"inlineContent":[{"type":"text","text":"A system that runs alongside others can’t spawn or despawn entities directly, because that"},{"type":"text","text":" "},{"type":"text","text":"changes every component type at once. Take an "},{"code":"inout","type":"codeVoice"},{"type":"text","text":" "},{"isActive":true,"identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/Commands","type":"reference"},{"type":"text","text":" instead, and queue"},{"type":"text","text":" "},{"type":"text","text":"the changes. Commands apply at the end of the wave the system runs in, so systems ordered after"},{"type":"text","text":" "},{"type":"text","text":"it see them:"}],"type":"paragraph"},{"syntax":"swift","type":"codeListing","code":["@System","struct RemoveDefeated {","    func run(_ fighters: Query<Health>, _ commands: inout Commands) {","        for (entity, health) in fighters where health.current <= 0 {","            commands.despawn(entity)","        }","    }","}","","var world = World()","let knight = world.spawn(Health(current: 0))","world.spawn(Health(current: 12))","Schedule { RemoveDefeated() }.run(on: &world)","","print(world.contains(knight))","\/\/ Prints \"false\"","print(world.count)","\/\/ Prints \"1\""]},{"inlineContent":[{"text":"A commands parameter conflicts with nothing, so it doesn’t stop a system from running at the","type":"text"},{"text":" ","type":"text"},{"text":"same time as others.","type":"text"}],"type":"paragraph"},{"anchor":"Take-the-Whole-World","level":3,"type":"heading","text":"Take the Whole World"},{"inlineContent":[{"text":"A ","type":"text"},{"type":"codeVoice","code":"run"},{"text":" method that takes ","type":"text"},{"type":"codeVoice","code":"inout World"},{"text":" makes a system that can change anything. Its access is","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"nil"},{"text":", so a schedule runs it alone, after the systems written before it and before those written","type":"text"},{"text":" ","type":"text"},{"text":"after it. Use one for work that touches many types at once, such as loading a level.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"To write a system by hand instead of with the macro, conform a type to "},{"identifier":"doc:\/\/Systems\/documentation\/Systems\/System","type":"reference","isActive":true},{"type":"text","text":", implement"},{"type":"text","text":" "},{"identifier":"doc:\/\/Systems\/documentation\/Systems\/System\/run(in:)","type":"reference","isActive":true},{"type":"text","text":", and declare an "},{"identifier":"doc:\/\/Systems\/documentation\/Systems\/System\/access","type":"reference","isActive":true},{"type":"text","text":" listing every type the system reads and"},{"type":"text","text":" "},{"type":"text","text":"writes."}],"type":"paragraph"},{"anchor":"Run-on-the-Main-Actor","level":3,"type":"heading","text":"Run on the Main Actor"},{"inlineContent":[{"type":"text","text":"Mark a system type, or its "},{"code":"run","type":"codeVoice"},{"type":"text","text":" method, "},{"code":"@MainActor","type":"codeVoice"},{"type":"text","text":" to make a "},{"identifier":"doc:\/\/Systems\/documentation\/Systems\/MainActorSystem","isActive":true,"type":"reference"},{"type":"text","text":", which a"},{"type":"text","text":" "},{"type":"text","text":"schedule runs on the main actor after the other systems of its wave. Use one to carry results"},{"type":"text","text":" "},{"type":"text","text":"from the world to a user interface."}],"type":"paragraph"},{"inlineContent":[{"text":"Once you’ve declared systems, see ","type":"text"},{"identifier":"doc:\/\/Systems\/documentation\/Systems\/SchedulingSystems","isActive":true,"type":"reference"},{"text":" to order them and run them only when","type":"text"},{"text":" ","type":"text"},{"text":"a condition holds.","type":"text"}],"type":"paragraph"}],"kind":"content"}],"hierarchy":{"paths":[["doc:\/\/Systems\/documentation\/Systems"]]},"variants":[{"paths":["\/documentation\/systems\/declaringsystems"],"traits":[{"interfaceLanguage":"swift"}]}],"identifier":{"url":"doc:\/\/Systems\/documentation\/Systems\/DeclaringSystems","interfaceLanguage":"swift"},"sections":[],"references":{"doc://Systems/documentation/Systems/System()":{"role":"symbol","identifier":"doc:\/\/Systems\/documentation\/Systems\/System()","fragments":[{"kind":"keyword","text":"macro"},{"kind":"text","text":" "},{"kind":"identifier","text":"System"},{"kind":"text","text":"()"}],"kind":"symbol","title":"System()","type":"topic","abstract":[{"type":"text","text":"Makes a type a system whose access comes from the parameters of its "},{"type":"codeVoice","code":"run"},{"type":"text","text":" method."}],"url":"\/documentation\/systems\/system()"},"doc://Systems/documentation/Systems/ResourceReader":{"abstract":[{"text":"A system parameter that reads a resource.","type":"text"}],"title":"ResourceReader","kind":"symbol","url":"\/documentation\/systems\/resourcereader","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"ResourceReader","kind":"identifier"}],"role":"symbol","type":"topic","navigatorTitle":[{"text":"ResourceReader","kind":"identifier"}],"identifier":"doc:\/\/Systems\/documentation\/Systems\/ResourceReader"},"doc://Systems/documentation/Systems/DrivingAWorldFromAnApp":{"url":"\/documentation\/systems\/drivingaworldfromanapp","title":"Driving a World from an App","type":"topic","kind":"article","identifier":"doc:\/\/Systems\/documentation\/Systems\/DrivingAWorldFromAnApp","abstract":[{"text":"Hold a world in your app or game engine, feed it each frame’s input, and let the objects outside","type":"text"},{"text":" ","type":"text"},{"text