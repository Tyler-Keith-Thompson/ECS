{"sections":[],"identifier":{"url":"doc:\/\/Systems\/documentation\/Systems\/DeclaringSystems","interfaceLanguage":"swift"},"kind":"article","schemaVersion":{"major":0,"minor":3,"patch":0},"metadata":{"roleHeading":"API Collection","modules":[{"name":"Systems"}],"role":"collectionGroup","title":"Declaring Systems"},"hierarchy":{"paths":[["doc:\/\/Systems\/documentation\/Systems"]]},"topicSections":[{"anchor":"Declaring-Systems","title":"Declaring Systems","identifiers":["doc:\/\/Systems\/documentation\/Systems\/System()","doc:\/\/Systems\/documentation\/Systems\/System","doc:\/\/Systems\/documentation\/Systems\/MainActorSystem"]},{"anchor":"System-Parameters","title":"System Parameters","identifiers":["doc:\/\/Systems\/documentation\/Systems\/Update","doc:\/\/Systems\/documentation\/Systems\/ResourceReader","doc:\/\/Systems\/documentation\/Systems\/ResourceWriter","doc:\/\/Systems\/documentation\/Systems\/EventReader","doc:\/\/Systems\/documentation\/Systems\/EventWriter","doc:\/\/Systems\/documentation\/Systems\/RemovedComponents"]}],"seeAlsoSections":[{"generated":true,"anchor":"Essentials","title":"Essentials","identifiers":["doc:\/\/Systems\/documentation\/Systems\/DrivingAWorldFromAnApp","doc:\/\/Systems\/documentation\/Systems\/System()","doc:\/\/Systems\/documentation\/Systems\/System"]}],"primaryContentSections":[{"kind":"content","content":[{"type":"heading","level":2,"text":"Overview","anchor":"Overview"},{"inlineContent":[{"type":"text","text":"A system is a type with a "},{"type":"codeVoice","code":"run"},{"type":"text","text":" method that a schedule calls once per run. The "},{"type":"reference","identifier":"doc:\/\/Systems\/documentation\/Systems\/System()","isActive":true},{"type":"text","text":" "},{"type":"text","text":"macro turns a structure into a system from the parameters of its "},{"type":"codeVoice","code":"run"},{"type":"text","text":" method. Each parameter’s"},{"type":"text","text":" "},{"type":"text","text":"type says what part of the world the system works on and whether it reads or writes it, so the"},{"type":"text","text":" "},{"type":"text","text":"system’s "},{"type":"reference","identifier":"doc:\/\/Systems\/documentation\/Systems\/System\/access","isActive":true},{"type":"text","text":" is always exact, and a schedule can run systems that don’t conflict at"},{"type":"text","text":" "},{"type":"text","text":"the same time."}],"type":"paragraph"},{"type":"heading","level":3,"text":"Read and Write Components","anchor":"Read-and-Write-Components"},{"inlineContent":[{"text":"Take a ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/Query"},{"text":" to read components, and iterate it as you would a world’s query","type":"text"},{"text":" ","type":"text"},{"text":"results. Take an ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/Systems\/documentation\/Systems\/Update"},{"text":" to change them in place. An","type":"text"},{"text":" ","type":"text"},{"text":"update can also read other components with ","type":"text"},{"type":"codeVoice","code":"Over"},{"text":", and narrow the entities it visits with","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"Where"},{"text":":","type":"text"}],"type":"paragraph"},{"code":["@System","struct Climb {","    func run(_ climbers: Update<Position>.Over<Velocity>.Where<Without<Frozen>>) {","        climbers { position, row in","            position.y += abs(row.components.dy)","        }","    }","}","","var world = World()","let climber = world.spawn(Position(x: 0, y: 0), Velocity(dx: 0, dy: -3))","let statue = world.spawn(Position(x: 0, y: 0), Velocity(dx: 0, dy: -3), Frozen())","Schedule { Climb() }.run(on: &world)","","print(world[Position.self, of: climber].y)","\/\/ Prints \"3.0\"","print(world[Position.self, of: statue].y)","\/\/ Prints \"0.0\""],"type":"codeListing","syntax":"swift"},{"inlineContent":[{"code":"Climb","type":"codeVoice"},{"text":" writes ","type":"text"},{"code":"Position","type":"codeVoice"},{"text":" and reads ","type":"text"},{"code":"Velocity","type":"codeVoice"},{"text":" and ","type":"text"},{"code":"Frozen","type":"codeVoice"},{"text":". It conflicts with any system that","type":"text"},{"text":" ","type":"text"},{"text":"writes ","type":"text"},{"code":"Velocity","type":"codeVoice"},{"text":" or ","type":"text"},{"code":"Frozen","type":"codeVoice"},{"text":", or reads or writes ","type":"text"},{"code":"Position","type":"codeVoice"},{"text":", and runs at the same time as any","type":"text"},{"text":" ","type":"text"},{"text":"other.","type":"text"}],"type":"paragraph"},{"type":"heading","level":3,"text":"Read and Write Resources and Events","anchor":"Read-and-Write-Resources-and-Events"},{"inlineContent":[{"text":"A ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/Systems\/documentation\/Systems\/ResourceReader"},{"text":" reads a resource and a ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/Systems\/documentation\/Systems\/ResourceWriter"},{"text":" changes one. An ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/Systems\/documentation\/Systems\/EventWriter"},{"text":" ","type":"text"},{"text":"sends events, and an ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/Systems\/documentation\/Systems\/EventReader"},{"text":" reads the events sent since the system last read them. The","type":"text"},{"text":" ","type":"text"},{"text":"following schedule sends a ","type":"text"},{"code":"Damage","type":"codeVoice"},{"text":" event for each entity below the ground, then applies the","type":"text"},{"text":" ","type":"text"},{"text":"damage to its target’s health:","type":"text"}],"type":"paragraph"},{"code":["var world = World()","let knight = world.spawn(Position(x: 0, y: -1), Health(current: 30))","","let frame = Schedule {","    UpdateEvents()","    Combat()","    ApplyDamage().after(Combat.self)","}","frame.run(on: &world)","print(world[Health.self, of: knight].current)","\/\/ Prints \"20\""],"type":"codeListing","syntax":"swift"},{"inlineContent":[{"identifier":"doc:\/\/Systems\/documentation\/Systems\/EventWriter","type":"reference","isActive":true},{"text":" declares ","type":"text"},{"code":"Combat","type":"codeVoice"},{"text":", and ","type":"text"},{"identifier":"doc:\/\/Systems\/documentation\/Systems\/EventReader","type":"reference","isActive":true},{"text":" declares ","type":"text"},{"code":"ApplyDamage","type":"codeVoice"},{"text":".","type":"text"}],"type":"paragraph"},{"type":"heading","level":3,"text":"Spawn and Despawn Entities","anchor":"Spawn-and-Despawn-Entities"},{"inlineContent":[{"text":"A system that runs alongside others can’t spawn or despawn entities directly, because that","type":"text"},{"text":" ","type":"text"},{"text":"changes every component type at once. Take an ","type":"text"},{"code":"inout","type":"codeVoice"},{"text":" ","type":"text"},{"identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/Commands","isActive":true,"type":"reference"},{"text":" instead, and queue","type":"text"},{"text":" ","type":"text"},{"text":"the changes. Commands apply at the end of the wave the system runs in, so systems ordered after","type":"text"},{"text":" ","type":"text"},{"text":"it see them:","type":"text"}],"type":"paragraph"},{"code":["@System","struct RemoveDefeated {","    func run(_ fighters: Query<Health>, _ commands: inout Commands) {","        for (entity, health) in fighters where health.current <= 0 {","            commands.despawn(entity)","        }","    }","}","","var world = World()","let knight = world.spawn(Health(current: 0))","world.spawn(Health(current: 12))","Schedule { RemoveDefeated() }.run(on: &world)","","print(world.contains(knight))","\/\/ Prints \"false\"","print(world.count)","\/\/ Prints \"1\""],"type":"codeListing","syntax":"swift"},{"inlineContent":[{"type":"text","text":"A commands parameter conflicts with nothing, so it doesn’t stop a system from running at the"},{"type":"text","text":" "},{"type":"text","text":"same time as others."}],"type":"paragraph"},{"type":"heading","level":3,"text":"Take the Whole World","anchor":"Take-the-Whole-World"},{"inlineContent":[{"type":"text","text":"A "},{"code":"run","type":"codeVoice"},{"type":"text","text":" method that takes "},{"code":"inout World","type":"codeVoice"},{"type":"text","text":" makes a system that can change anything. Its access is"},{"type":"text","text":" "},{"code":"nil","type":"codeVoice"},{"type":"text","text":", so a schedule runs it alone, after the systems written before it and before those written"},{"type":"text","text":" "},{"type":"text","text":"after it. Use one for work that touches many types at once, such as loading a level."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"To write a system by hand instead of with the macro, conform a type to "},{"type":"reference","identifier":"doc:\/\/Systems\/documentation\/Systems\/System","isActive":true},{"type":"text","text":", implement"},{"type":"text","text":" "},{"type":"reference","identifier":"doc:\/\/Systems\/documentation\/Systems\/System\/run(in:)","isActive":true},{"type":"text","text":", and declare an "},{"type":"reference","identifier":"doc:\/\/Systems\/documentation\/Systems\/System\/access","isActive":true},{"type":"text","text":" listing every type the system reads and"},{"type":"text","text":" "},{"type":"text","text":"writes."}],"type":"paragraph"},{"type":"heading","level":3,"text":"Run on the Main Actor","anchor":"Run-on-the-Main-Actor"},{"inlineContent":[{"type":"text","text":"Mark a system type, or its "},{"code":"run","type":"codeVoice"},{"type":"text","text":" method, "},{"code":"@MainActor","type":"codeVoice"},{"type":"text","text":" to make a "},{"isActive":true,"type":"reference","identifier":"doc:\/\/Systems\/documentation\/Systems\/MainActorSystem"},{"type":"text","text":", which a"},{"type":"text","text":" "},{"type":"text","text":"schedule runs on the main actor after the other systems of its wave. Use one to carry results"},{"type":"text","text":" "},{"type":"text","text":"from the world to a user interface."}],"type":"paragraph"}]}],"abstract":[{"text":"Write the rules of a simulation as systems, and let their parameters state what they read and","type":"text"},{"text":" ","type":"text"},{"text":"write.","type":"text"}],"variants":[{"paths":["\/documentation\/systems\/declaringsystems"],"traits":[{"interfaceLanguage":"swift"}]}],"references":{"doc://Systems/documentation/Systems/System/access":{"url":"\/documentation\/systems\/system\/access","required":true,"fragments":[{"text":"var","kind":"keyword"},{"text":" ","kind":"text"},{"text":"access","kind":"identifier"},{"text":": ","kind":"text"},{"text":"Access","kind":"typeIdentifier","preciseIdentifier":"s:11WorldModule6AccessV"},{"text":"?","kind":"text"}],"type":"topic","title":"access","abstract":[{"type":"text","text":"The component, resource and event types the system reads and writes, or "},{"type":"codeVoice","code":"nil"},{"type":"text","text":" if it may"},{"type":"text","text":" "},{"type":"text","text":"change anything."}],"kind":"symbol","role":"symbol","identifier":"doc:\/\/Systems\/documentation\/Systems\/System\/access","defaultImplementations":1},"doc://Systems/documentation/Systems/Update":{"identifier":"doc:\/\/Systems\/documentation\/Systems\/Update","navigatorTitle":[{"text":"Update","kind":"identifier"}],"url":"\/documentation\/systems\/update","title":"Update","kind":"symbol","role":"symbol","type":"topic","fragments":[{"text":"class","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Update","kind":"identifier"}],"abstract":[{"text":"A system parameter that changes a component of every entity that holds it.","type":"text"}]},"doc://Systems/documentation/Systems/System()":{"title":"System()","abstract":[{"text":"Makes a type a system whose access comes from the parameters of its ","type":"text"},{"code":"run","type":"codeVoice"},{"text":" method.","type":"text"}],"kind":"symbol","type":"topic","role":"symbol","fragments":[{"kind":"keyword","text":"macro"},{"kind":"text","text":" "},{"kind":"identifier","text":"System"},{"kind":"text","text":"()"}],"url":"\/documentation\/systems\/system()","identifier":"doc:\/\/Systems\/documentation\/Systems\/System()"},"doc://Systems/documentation/Systems/RemovedComponents":{"identifier":"doc:\/\/Systems\/documentation\/Systems\/RemovedComponents","kind":"symbol","url":"\/documentation\/systems\/removedcomponents","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"RemovedComponents"}],"navigatorTitle":[{"kind":"identifier","text":"RemovedComponents"}],"abstract":[{"text":"A system parameter that lists the entities that lost a component since the system last read","type":"text"},{"text":" ","type":"text"},{"text":"them.","type":"text"}],"title":"RemovedComponents","role":"symbol","type":"topic"},"doc://Systems/documentation/Systems/System/run(in:)":{"identifier":"doc:\/\/Systems\/documentation\/Systems\/System\/run(in:)","required":true,"title":"run(in:)","url":"\/documentation\/systems\/system\/run(in:)","kind":"symbol","role":"symbol","type":"topic","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"run"},{"kind":"text","text":"("},{"kind":"externalParam","text":"in"},{"kind":"text","text":": "},{"text":"inout","kind":"keyword"},{"text":" ","kind":"text"},{"preciseIdentifier":"s:11WorldModule0A0V","text":"World","kind":"typeIdentifier"},{"text":")","kind":"text"}],"abstract":[{"text":"Runs the system’s rule once on a world.","type":"text"}]},"doc://WorldModule/documentation/WorldModule/Query":{"url":"\/documentation\/worldmodule\/query","abstract":[{"text":"A description of the entities to visit and the components to read from each.","type":"text"}],"kind":"symbol","navigatorTitle":[{"kind":"identifier","text":"Query"}],"identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/Query","type":"topic","role":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"Query"}],"title":"Query"},"doc://Systems/documentation/Systems/DrivingAWorldFromAnApp":{"identifier":"doc:\/\/Systems\/documentation\/Systems\/DrivingAWorldFromAnApp","title":"Driving a World from an App","url":"\/documentation\/systems\/drivingaworldfromanapp","kind":"article","role":"article","type":"topic","abstract":[{"text":"Hold a world in your app or game engine, feed it each frame’s input, and let the objects outside","type":"text"},{"text":" ","type":"text"},{"text":"it read results and take part in a step.","type":"text"}]},"doc://Systems/documentation/Systems/EventReader":{"kind":"symbol","type":"topic","navigatorTitle":[{"kind":"identifier","text":"EventReader"}],"fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"EventReader"}],"title":"EventReader","identifier":"doc:\/\/Systems\/documentation\/Systems\/EventReader","url":"\/documentation\/systems\/eventreader","role":"symbol","abstract":[{"type":"text","text":"A system parameter that reads the events of one type sent since the system last read them."}]},"doc://Systems/documentation/Systems/EventWriter":{"title":"EventWriter","abstract":[{"text":"A system parameter that sends events of one type.","type":"text"}],"kind":"symbol","type":"topic","role":"symbol","fragments":[{"text":"class","kind":"keyword"},{"text":" ","kind":"text"},{"text":"EventWriter","kind":"identifier"}],"url":"\/documentation\/systems\/eventwriter","identifier":"doc:\/\/Systems\/documentation\/Systems\/EventWriter","navigatorTitle":[{"text":"EventWriter","kind":"identifier"}]},"doc://Systems/documentation/Systems/ResourceReader":{"title":"ResourceReader","abstract":[{"type":"text","text":"A system parameter that reads a resource."}],"kind":"symbol","type":"topic","role":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"ResourceReader"}],"url":"\/documentation\/systems\/resourcereader","identifier":"doc:\/\/Systems\/documentation\/Systems\/ResourceReader","navigatorTitle":[{"kind":"identifier","text":"ResourceReader"}]},"doc://Systems/documentation/Systems":{"identifier":"doc:\/\/Systems\/documentation\/Systems","kind":"symbol","url":"\/documentation\/systems","title":"Systems","abstract":[{"type":"text","text":"Declare the rules of a simulation as systems, and run them on a world in a schedule."}],"role":"collection","type":"topic"},"doc://WorldModule/documentation/WorldModule/Commands":{"title":"Commands","abstract":[{"type":"text","text":"A buffer of changes to a world, recorded now and applied later in the order they were"},{"type":"text","text":" "},{"type":"text","text":"recorded."}],"kind":"symbol","type":"topic","role":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"Commands"}],"url":"\/documentation\/worldmodule\/commands","identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/Commands","navigatorTitle":[{"kind":"identifier","text":"Commands"}]},"doc://Systems/documentation/Systems/MainActorSystem":{"identifier":"doc:\/\/Systems\/documentation\/Systems\/MainActorSystem","navigatorTitle":[{"text":"MainActorSystem","kind":"identifier"}],"title":"MainActorSystem","url":"\/documentation\/systems\/mainactorsystem","kind":"symbol","role":"symbol","type":"topic","fragments":[{"text":"protocol","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MainActorSystem","kind":"identifier"}],"abstract":[{"text":"A system that runs on the main actor, for work that touches main-actor state such as a user","type":"text"},{"text":" ","type":"text"},{"text":"interface.","type":"text"}]},"doc://Systems/documentation/Systems/ResourceWriter":{"title":"ResourceWriter","abstract":[{"text":"A system parameter that reads and writes a resource.","type":"text"}],"kind":"symbol","type":"topic","role":"symbol","fragments":[{"kind":"keyword","text":"class"},{"kind":"text","text":" "},{"kind":"identifier","text":"ResourceWriter"}],"url":"\/documentation\/systems\/resourcewriter","identifier":"doc:\/\/Systems\/documentation\/Systems\/ResourceWriter","navigatorTitle":[{"kind":"identifier","text":"ResourceWriter"}]},"doc://Systems/documentation/Systems/System":{"url":"\/documentation\/systems\/system","fragments":[{"text":"protocol","kind":"keyword"},{"text":" ","kind":"text"},{"text":"System","kind":"identifier"}],"type":"topic","title":"System","abstract":[{"type":"text","text":"A rule that reads and changes a world, run once each time its schedule runs."}],"kind":"symbol","role":"symbol","identifier":"doc:\/\/Systems\/documentation\/Systems\/System","navigatorTitle":[{"text":"System","kind":"identifier"}]}}}