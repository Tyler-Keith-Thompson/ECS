codeVoice","code":"C"},{"text":".","type":"text"}]},"doc://WorldModule/documentation/WorldModule/Commands":{"navigatorTitle":[{"text":"Commands","kind":"identifier"}],"role":"symbol","title":"Commands","kind":"symbol","identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/Commands","abstract":[{"type":"text","text":"A buffer of changes to a world, recorded now and applied later in the order they were"},{"type":"text","text":" "},{"type":"text","text":"recorded."}],"url":"\/documentation\/worldmodule\/commands","type":"topic","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Commands","kind":"identifier"}]},"doc://Systems/documentation/Systems/System()":{"role":"symbol","kind":"symbol","title":"System()","identifier":"doc:\/\/Systems\/documentation\/Systems\/System()","abstract":[{"type":"text","text":"Makes a type a system whose access comes from the parameters of its "},{"type":"codeVoice","code":"run"},{"type":"text","text":" method."}],"url":"\/documentation\/systems\/system()","type":"topic","fragments":[{"kind":"keyword","text":"macro"},{"kind":"text","text":" "},{"kind":"identifier","text":"System"},{"kind":"text","text":"()"}]},"doc://Systems/documentation/Systems/ResourceReader":{"navigatorTitle":[{"kind":"identifier","text":"ResourceReader"}],"title":"ResourceReader","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"ResourceReader"}],"type":"topic","identifier":"doc:\/\/Systems\/documentation\/Systems\/ResourceReader","abstract":[{"text":"A system parameter that reads a resource.","type":"text"}],"url":"\/documentation\/systems\/resourcereader","role":"symbol","kind":"symbol"},"doc://Systems/documentation/Systems/DrivingAWorldFromAnApp":{"title":"Driving a World from an App","role":"article","identifier":"doc:\/\/Systems\/documentation\/Systems\/DrivingAWorldFromAnApp","type":"topic","kind":"article","url":"\/documentation\/systems\/drivingaworldfromanapp","abstract":[{"text":"Hold a world in your app or game engine, feed it each frame’s input, and let the objects outside","type":"text"},{"text":" ","type":"text"},{"text":"it read results and take part in a step.","type":"text"}]},"doc://Systems/documentation/Systems":{"role":"collection","type":"topic","abstract":[{"type":"text","text":"Declare the rules of a simulation as systems, and run them on a world in a schedule."}],"title":"Systems","kind":"symbol","identifier":"doc:\/\/Systems\/documentation\/Systems","url":"\/documentation\/systems"},"doc://Systems/documentation/Systems/MainActorSystem":{"navigatorTitle":[{"kind":"identifier","text":"MainActorSystem"}],"title":"MainActorSystem","fragments":[{"kind":"keyword","text":"protocol"},{"kind":"text","text":" "},{"kind":"identifier","text":"MainActorSystem"}],"type":"topic","identifier":"doc:\/\/Systems\/documentation\/Systems\/MainActorSystem","abstract":[{"type":"text","text":"A system that runs on the main actor, for work that touches main-actor state such as a user"},{"type":"text","text":" "},{"type":"text","text":"interface."}],"url":"\/documentation\/systems\/mainactorsystem","role":"symbol","kind":"symbol"},"doc://Systems/documentation/Systems/ResourceWriter":{"navigatorTitle":[{"kind":"identifier","text":"ResourceWriter"}],"title":"ResourceWriter","fragments":[{"kind":"keyword","text":"class"},{"kind":"text","text":" "},{"kind":"identifier","text":"ResourceWriter"}],"type":"topic","identifier":"doc:\/\/Systems\/documentation\/Systems\/ResourceWriter","abstract":[{"text":"A system parameter that reads and writes a resource.","type":"text"}],"url":"\/documentation\/systems\/resourcewriter","role":"symbol","kind":"symbol"},"doc://WorldModule/documentation/WorldModule/Changed":{"identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/Changed","kind":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"Changed"}],"role":"symbol","title":"Changed","navigatorTitle":[{"kind":"identifier","text":"Changed"}],"abstract":[{"text":"A filter type that passes the entities whose component of type ","type":"text"},{"code":"C","type":"codeVoice"},{"text":" was added or changed since","type":"text"},{"text":" ","type":"text"},{"text":"the world’s last run.","type":"text"}],"type":"topic","url":"\/documentation\/worldmodule\/changed"},"doc://Systems/documentation/Systems/EventWriter":{"type":"topic","abstract":[{"type":"text","text":"A system parameter that sends events of one type."}],"kind":"symbol","identifier":"doc:\/\/Systems\/documentation\/Systems\/EventWriter","role":"symbol","url":"\/documentation\/systems\/eventwriter","navigatorTitle":[{"kind":"identifier","text":"EventWriter"}],"title":"EventWriter","fragments":[{"kind":"keyword","text":"class"},{"kind":"text","text":" "},{"kind":"identifier","text":"EventWriter"}]}}}