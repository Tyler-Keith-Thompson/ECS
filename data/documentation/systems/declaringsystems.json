{"metadata":{"roleHeading":"API Collection","modules":[{"name":"Systems"}],"role":"collectionGroup","title":"Declaring Systems"},"kind":"article","schemaVersion":{"patch":0,"minor":3,"major":0},"identifier":{"url":"doc:\/\/Systems\/documentation\/Systems\/DeclaringSystems","interfaceLanguage":"swift"},"primaryContentSections":[{"kind":"content","content":[{"anchor":"Overview","level":2,"text":"Overview","type":"heading"},{"type":"paragraph","inlineContent":[{"type":"text","text":"A system is a type with a "},{"type":"codeVoice","code":"run"},{"type":"text","text":" method that a schedule calls once per run. The "},{"type":"reference","identifier":"doc:\/\/Systems\/documentation\/Systems\/System()","isActive":true},{"type":"text","text":" "},{"type":"text","text":"macro turns a structure into a system from the parameters of its "},{"type":"codeVoice","code":"run"},{"type":"text","text":" method. Each parameter’s"},{"type":"text","text":" "},{"type":"text","text":"type says what part of the world the system works on and whether it reads or writes it, so the"},{"type":"text","text":" "},{"type":"text","text":"system’s "},{"type":"reference","identifier":"doc:\/\/Systems\/documentation\/Systems\/System\/access","isActive":true},{"type":"text","text":" is always exact, and a schedule can run systems that don’t conflict at"},{"type":"text","text":" "},{"type":"text","text":"the same time."}]},{"anchor":"Read-and-Write-Components","level":3,"text":"Read and Write Components","type":"heading"},{"type":"paragraph","inlineContent":[{"text":"Take a ","type":"text"},{"type":"reference","identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/Query","isActive":true},{"text":" to read components, and iterate it as you would a world’s query","type":"text"},{"text":" ","type":"text"},{"text":"results. Take an ","type":"text"},{"type":"reference","identifier":"doc:\/\/Systems\/documentation\/Systems\/Update","isActive":true},{"text":" to change them in place. An","type":"text"},{"text":" ","type":"text"},{"text":"update can also read other components with ","type":"text"},{"code":"Over","type":"codeVoice"},{"text":", and narrow the entities it visits with","type":"text"},{"text":" ","type":"text"},{"code":"Where","type":"codeVoice"},{"text":":","type":"text"}]},{"code":["@System","struct Climb {","    func run(_ climbers: Update<Position>.Over<Velocity>.Where<Without<Frozen>>) {","        climbers { position, row in","            position.y += abs(row.components.dy)","        }","    }","}","","var world = World()","let climber = world.spawn(Position(x: 0, y: 0), Velocity(dx: 0, dy: -3))","let statue = world.spawn(Position(x: 0, y: 0), Velocity(dx: 0, dy: -3), Frozen())","Schedule { Climb() }.run(on: &world)","","print(world[Position.self, of: climber].y)","\/\/ Prints \"3.0\"","print(world[Position.self, of: statue].y)","\/\/ Prints \"0.0\""],"type":"codeListing","syntax":"swift"},{"type":"paragraph","inlineContent":[{"code":"Climb","type":"codeVoice"},{"text":" writes ","type":"text"},{"code":"Position","type":"codeVoice"},{"text":" and reads ","type":"text"},{"code":"Velocity","type":"codeVoice"},{"text":" and ","type":"text"},{"code":"Frozen","type":"codeVoice"},{"text":". It conflicts with any system that","type":"text"},{"text":" ","type":"text"},{"text":"writes ","type":"text"},{"code":"Velocity","type":"codeVoice"},{"text":" or ","type":"text"},{"code":"Frozen","type":"codeVoice"},{"text":", or reads or writes ","type":"text"},{"code":"Position","type":"codeVoice"},{"text":", and runs at the same time as any","type":"text"},{"text":" ","type":"text"},{"text":"other.","type":"text"}]},{"anchor":"Read-and-Write-Resources-and-Events","level":3,"text":"Read and Write Resources and Events","type":"heading"},{"type":"paragraph","inlineContent":[{"type":"text","text":"A "},{"identifier":"doc:\/\/Systems\/documentation\/Systems\/ResourceReader","type":"reference","isActive":true},{"type":"text","text":" reads a resource and a "},{"identifier":"doc:\/\/Systems\/documentation\/Systems\/ResourceWriter","type":"reference","isActive":true},{"type":"text","text":" changes one. An "},{"identifier":"doc:\/\/Systems\/documentation\/Systems\/EventWriter","type":"reference","isActive":true},{"type":"text","text":" "},{"type":"text","text":"sends events, and an "},{"identifier":"doc:\/\/Systems\/documentation\/Systems\/EventReader","type":"reference","isActive":true},{"type":"text","text":" reads the events sent since the system last read them. The"},{"type":"text","text":" "},{"type":"text","text":"following schedule sends a "},{"type":"codeVoice","code":"Damage"},{"type":"text","text":" event for each entity below the ground, then applies the"},{"type":"text","text":" "},{"type":"text","text":"damage to its target’s health:"}]},{"code":["var world = World()","let knight = world.spawn(Position(x: 0, y: -1), Health(current: 30))","","let frame = Schedule {","    UpdateEvents()","    Combat()","    ApplyDamage().after(Combat.self)","}","frame.run(on: &world)","print(world[Health.self, of: knight].current)","\/\/ Prints \"20\""],"type":"codeListing","syntax":"swift"},{"type":"paragraph","inlineContent":[{"type":"reference","isActive":true,"identifier":"doc:\/\/Systems\/documentation\/Systems\/EventWriter"},{"type":"text","text":" declares "},{"type":"codeVoice","code":"Combat"},{"type":"text","text":", and "},{"type":"reference","isActive":true,"identifier":"doc:\/\/Systems\/documentation\/Systems\/EventReader"},{"type":"text","text":" declares "},{"type":"codeVoice","code":"ApplyDamage"},{"type":"text","text":"."}]},{"anchor":"Spawn-and-Despawn-Entities","level":3,"text":"Spawn and Despawn Entities","type":"heading"},{"type":"paragraph","inlineContent":[{"text":"A system that runs alongside others can’t spawn or despawn entities directly, because that","type":"text"},{"text":" ","type":"text"},{"text":"changes every component type at once. Take an ","type":"text"},{"type":"codeVoice","code":"inout"},{"text":" ","type":"text"},{"isActive":true,"identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/Commands","type":"reference"},{"text":" instead, and queue","type":"text"},{"text":" ","type":"text"},{"text":"the changes. Commands apply at the end of the wave the system runs in, so systems ordered after","type":"text"},{"text":" ","type":"text"},{"text":"it see them:","type":"text"}]},{"code":["@System","struct RemoveDefeated {","    func run(_ fighters: Query<Health>, _ commands: inout Commands) {","        for (entity, health) in fighters where health.current <= 0 {","            commands.despawn(entity)","        }","    }","}","","var world = World()","let knight = world.spawn(Health(current: 0))","world.spawn(Health(current: 12))","Schedule { RemoveDefeated() }.run(on: &world)","","print(world.contains(knight))","\/\/ Prints \"false\"","print(world.count)","\/\/ Prints \"1\""],"type":"codeListing","syntax":"swift"},{"type":"paragraph","inlineContent":[{"type":"text","text":"A commands parameter conflicts with nothing, so it doesn’t stop a system from running at the"},{"type":"text","text":" "},{"type":"text","text":"same time as others."}]},{"anchor":"Take-the-Whole-World","level":3,"text":"Take the Whole World","type":"heading"},{"type":"paragraph","inlineContent":[{"type":"text","text":"A "},{"type":"codeVoice","code":"run"},{"type":"text","text":" method that takes "},{"type":"codeVoice","code":"inout World"},{"type":"text","text":" makes a system that can change anything. Its access is"},{"type":"text","text":" "},{"type":"codeVoice","code":"nil"},{"type":"text","text":", so a schedule runs it alone, after the systems written before it and before those written"},{"type":"text","text":" "},{"type":"text","text":"after it. Use one for work that touches many types at once, such as loading a level."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"To write a system by hand instead of with the macro, conform a type to "},{"type":"reference","isActive":true,"identifier":"doc:\/\/Systems\/documentation\/Systems\/System"},{"type":"text","text":", implement"},{"type":"text","text":" "},{"type":"reference","isActive":true,"identifier":"doc:\/\/Systems\/documentation\/Systems\/System\/run(in:)"},{"type":"text","text":", and declare an "},{"type":"reference","isActive":true,"identifier":"doc:\/\/Systems\/documentation\/Systems\/System\/access"},{"type":"text","text":" listing every type the system reads and"},{"type":"text","text":" "},{"type":"text","text":"writes."}]},{"anchor":"Run-on-the-Main-Actor","level":3,"text":"Run on the Main Actor","type":"heading"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Mark a system type, or its "},{"type":"codeVoice","code":"run"},{"type":"text","text":" method, "},{"type":"codeVoice","code":"@MainActor"},{"type":"text","text":" to make a "},{"identifier":"doc:\/\/Systems\/documentation\/Systems\/MainActorSystem","type":"reference","isActive":true},{"type":"text","text":", which a"},{"type":"text","text":" "},{"type":"text","text":"schedule runs on the main actor after the other systems of its wave. Use one to carry results"},{"type":"text","text":" "},{"type":"text","text":"from the world to a user interface."}]}]}],"sections":[],"hierarchy":{"paths":[["doc:\/\/Systems\/documentation\/Systems"]]},"abstract":[{"type":"text","text":"Write the rules of a simulation as systems, and let their parameters state what they read and"},{"type":"text","text":" "},{"type":"text","text":"write."}],"seeAlsoSections":[{"anchor":"Essentials","identifiers":["doc:\/\/Systems\/documentation\/Systems\/DrivingAWorldFromAnApp","doc:\/\/Systems\/documentation\/Systems\/System()","doc:\/\/Systems\/documentation\/Systems\/System"],"title":"Essentials","generated":true}],"variants":[{"paths":["\/documentation\/systems\/declaringsystems"],"traits":[{"interfaceLanguage":"swift"}]}],"topicSections":[{"identifiers":["doc:\/\/Systems\/documentation\/Systems\/System()","doc:\/\/Systems\/documentat