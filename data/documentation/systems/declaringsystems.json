stems/documentation/Systems/System":{"fragments":[{"text":"protocol","kind":"keyword"},{"text":" ","kind":"text"},{"text":"System","kind":"identifier"}],"abstract":[{"text":"A rule that reads and changes a world, run once each time its schedule runs.","type":"text"}],"identifier":"doc:\/\/Systems\/documentation\/Systems\/System","type":"topic","title":"System","role":"symbol","url":"\/documentation\/systems\/system","navigatorTitle":[{"text":"System","kind":"identifier"}],"kind":"symbol"},"doc://Systems/documentation/Systems/ResourceWriter":{"fragments":[{"kind":"keyword","text":"class"},{"kind":"text","text":" "},{"kind":"identifier","text":"ResourceWriter"}],"abstract":[{"type":"text","text":"A system parameter that reads and writes a resource."}],"type":"topic","identifier":"doc:\/\/Systems\/documentation\/Systems\/ResourceWriter","title":"ResourceWriter","role":"symbol","url":"\/documentation\/systems\/resourcewriter","navigatorTitle":[{"kind":"identifier","text":"ResourceWriter"}],"kind":"symbol"},"doc://Systems/documentation/Systems/Update":{"fragments":[{"text":"class","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Update","kind":"identifier"}],"abstract":[{"type":"text","text":"A system parameter that changes a component of every entity that holds it."}],"type":"topic","identifier":"doc:\/\/Systems\/documentation\/Systems\/Update","title":"Update","role":"symbol","url":"\/documentation\/systems\/update","navigatorTitle":[{"text":"Update","kind":"identifier"}],"kind":"symbol"},"doc://Systems/documentation/Systems/System/access":{"fragments":[{"kind":"keyword","text":"var"},{"kind":"text","text":" "},{"text":"access","kind":"identifier"},{"text":": ","kind":"text"},{"text":"Access","preciseIdentifier":"s:11WorldModule6AccessV","kind":"typeIdentifier"},{"text":"?","kind":"text"}],"kind":"symbol","identifier":"doc:\/\/Systems\/documentation\/Systems\/System\/access","title":"access","url":"\/documentation\/systems\/system\/access","type":"topic","role":"symbol","abstract":[{"type":"text","text":"The component, resource and event types the system reads and writes, or "},{"type":"codeVoice","code":"nil"},{"type":"text","text":" if it may"},{"type":"text","text":" "},{"type":"text","text":"change anything."}],"defaultImplementations":1,"required":true},"doc://Systems/documentation/Systems/DrivingAWorldFromAnApp":{"abstract":[{"text":"Hold a world in your app or game engine, feed it each frame’s input, and let the objects outside","type":"text"},{"text":" ","type":"text"},{"text":"it read results and take part in a step.","type":"text"}],"type":"topic","identifier":"doc:\/\/Systems\/documentation\/Systems\/DrivingAWorldFromAnApp","title":"Driving a World from an App","role":"article","url":"\/documentation\/systems\/drivingaworldfromanapp","kind":"article"},"doc://Systems/documentation/Systems":{"type":"topic","kind":"symbol","identifier":"doc:\/\/Systems\/documentation\/Systems","title":"Systems","url":"\/documentation\/systems","abstract":[{"type":"text","text":"Declare the rules of a simulation as systems, and run them on a world in a schedule."}],"role":"collection"},"doc://Systems/documentation/Systems/RemovedComponents":{"fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"RemovedComponents","kind":"identifier"}],"identifier":"doc:\/\/Systems\/documentation\/Systems\/RemovedComponents","kind":"symbol","title":"RemovedComponents","navigatorTitle":[{"text":"RemovedComponents","kind":"identifier"}],"type":"topic","url":"\/documentation\/systems\/removedcomponents","role":"symbol","abstract":[{"type":"text","text":"A system parameter that lists the entities that lost a component since the system last read"},{"type":"text","text":" "},{"type":"text","text":"them."}]},"doc://WorldModule/documentation/WorldModule/Commands":{"fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Commands","kind":"identifier"}],"kind":"symbol","identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/Commands","title":"Commands","navigatorTitle":[{"text":"Commands","kind":"identifier"}],"type":"topic","url":"\/documentation\/worldmodule\/commands","role":"symbol","abstract":[{"type":"text","text":"A buffer of changes to a world, recorded now and applied later in the order they were"},{"type":"text","text":" "},{"type":"text","text":"recorded."}]},"doc://Systems/documentation/Systems/System()":{"fragments":[{"text":"macro","kind":"keyword"},{"text":" ","kind":"text"},{"text":"System","kind":"identifier"},{"text":"()","kind":"text"}],"abstract":[{"text":"Makes a type a system whose access comes from the parameters of its ","type":"text"},{"code":"run","type":"codeVoice"},{"text":" method.","type":"text"}],"type":"topic","identifier":"doc:\/\/Systems\/documentation\/Systems\/System()","title":"System()","role":"symbol","url":"\/documentation\/systems\/system()","kind":"symbol"}}}