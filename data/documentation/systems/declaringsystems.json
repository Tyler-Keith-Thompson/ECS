:\/\/WorldModule\/documentation\/WorldModule\/Query","type":"topic","navigatorTitle":[{"text":"Query","kind":"identifier"}],"fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Query","kind":"identifier"}],"title":"Query","abstract":[{"type":"text","text":"A description of the entities to visit and the components to read from each."}],"kind":"symbol","url":"\/documentation\/worldmodule\/query"},"doc://Systems/documentation/Systems/ResourceWriter":{"type":"topic","identifier":"doc:\/\/Systems\/documentation\/Systems\/ResourceWriter","url":"\/documentation\/systems\/resourcewriter","navigatorTitle":[{"text":"ResourceWriter","kind":"identifier"}],"fragments":[{"text":"class","kind":"keyword"},{"text":" ","kind":"text"},{"text":"ResourceWriter","kind":"identifier"}],"role":"symbol","abstract":[{"text":"A system parameter that reads and writes a resource.","type":"text"}],"title":"ResourceWriter","kind":"symbol"},"doc://Systems/documentation/Systems/RemovedComponents":{"role":"symbol","identifier":"doc:\/\/Systems\/documentation\/Systems\/RemovedComponents","type":"topic","navigatorTitle":[{"kind":"identifier","text":"RemovedComponents"}],"fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"RemovedComponents"}],"title":"RemovedComponents","abstract":[{"type":"text","text":"A system parameter that lists the entities that lost a component since the system last read"},{"type":"text","text":" "},{"type":"text","text":"them."}],"kind":"symbol","url":"\/documentation\/systems\/removedcomponents"},"doc://Systems/documentation/Systems":{"identifier":"doc:\/\/Systems\/documentation\/Systems","url":"\/documentation\/systems","type":"topic","role":"collection","title":"Systems","abstract":[{"type":"text","text":"Declare the rules of a simulation as systems, and run them on a world in a schedule."}],"kind":"symbol"},"doc://Systems/documentation/Systems/SchedulingSystems":{"role":"article","identifier":