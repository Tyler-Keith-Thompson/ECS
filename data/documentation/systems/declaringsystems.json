{"topicSections":[{"identifiers":["doc:\/\/Systems\/documentation\/Systems\/System()","doc:\/\/Systems\/documentation\/Systems\/System","doc:\/\/Systems\/documentation\/Systems\/MainActorSystem"],"anchor":"Declaring-Systems","title":"Declaring Systems"},{"identifiers":["doc:\/\/Systems\/documentation\/Systems\/Update","doc:\/\/Systems\/documentation\/Systems\/ResourceReader","doc:\/\/Systems\/documentation\/Systems\/ResourceWriter","doc:\/\/Systems\/documentation\/Systems\/EventReader","doc:\/\/Systems\/documentation\/Systems\/EventWriter","doc:\/\/Systems\/documentation\/Systems\/RemovedComponents"],"anchor":"System-Parameters","title":"System Parameters"}],"primaryContentSections":[{"kind":"content","content":[{"anchor":"Overview","type":"heading","level":2,"text":"Overview"},{"type":"paragraph","inlineContent":[{"text":"A system is a type with a ","type":"text"},{"code":"run","type":"codeVoice"},{"text":" method that a schedule calls once per run. The ","type":"text"},{"isActive":true,"identifier":"doc:\/\/Systems\/documentation\/Systems\/System()","type":"reference"},{"text":" ","type":"text"},{"text":"macro turns a structure into a system from the parameters of its ","type":"text"},{"code":"run","type":"codeVoice"},{"text":" method. Each parameter’s","type":"text"},{"text":" ","type":"text"},{"text":"type says what part of the world the system works on and whether it reads or writes it, so the","type":"text"},{"text":" ","type":"text"},{"text":"system’s ","type":"text"},{"isActive":true,"identifier":"doc:\/\/Systems\/documentation\/Systems\/System\/access","type":"reference"},{"text":" is always exact, and a schedule can run systems that don’t conflict at","type":"text"},{"text":" ","type":"text"},{"text":"the same time.","type":"text"}]},{"anchor":"Read-and-Write-Components","type":"heading","level":3,"text":"Read and Write Components"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Take a "},{"type":"reference","isActive":true,"identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/Query"},{"type":"text","text":" to read components, and iterate it as you would a world’s query"},{"type":"text","text":" "},{"type":"text","text":"results. Take an "},{"type":"reference","isActive":true,"identifier":"doc:\/\/Systems\/documentation\/Systems\/Update"},{"type":"text","text":" to change them in place. An"},{"type":"text","text":" "},{"type":"text","text":"update can also read other components with "},{"type":"codeVoice","code":"Over"},{"type":"text","text":", and narrow the entities it visits with"},{"type":"text","text":" "},{"type":"codeVoice","code":"Where"},{"type":"text","text":":"}]},{"syntax":"swift","code":["@System","struct Climb {","    func run(_ climbers: Update<Position>.Over<Velocity>.Where<Without<Frozen>>) {","        climbers { position, row in","            position.y += abs(row.components.dy)","        }","    }","}","","var world = World()","let climber = world.spawn(Position(x: 0, y: 0), Velocity(dx: 0, dy: -3))","let statue = world.spawn(Position(x: 0, y: 0), Velocity(dx: 0, dy: -3), Frozen())","Schedule { Climb() }.run(on: &world)","","print(world[Position.self, of: climber].y)","\/\/ Prints \"3.0\"","print(world[Position.self, of: statue].y)","\/\/ Prints \"0.0\""],"type":"codeListing"},{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"Climb"},{"type":"text","text":" writes "},{"type":"codeVoice","code":"Position"},{"type":"text","text":" and reads "},{"type":"codeVoice","code":"Velocity"},{"type":"text","text":" and "},{"type":"codeVoice","code":"Frozen"},{"type":"text","text":". It conflicts with any system that"},{"type":"text","text":" "},{"type":"text","text":"writes "},{"type":"codeVoice","code":"Velocity"},{"type":"text","text":" or "},{"type":"codeVoice","code":"Frozen"},{"type":"text","text":", or reads or writes "},{"type":"codeVoice","code":"Position"},{"type":"text","text":", and runs at the same time as any"},{"type":"text","text":" "},{"type":"text","text":"other."}]},{"anchor":"Read-and-Write-Resources-and-Events","type":"heading","level":3,"text":"Read and Write Resources and Events"},{"type":"paragraph","inlineContent":[{"type":"text","text":"A "},{"type":"reference","isActive":true,"identifier":"doc:\/\/Systems\/documentation\/Systems\/ResourceReader"},{"type":"text","text":" reads a resource and a "},{"type":"reference","isActive":true,"identifier":"doc:\/\/Systems\/documentation\/Systems\/ResourceWriter"},{"type":"text","text":" changes one. An "},{"type":"reference","isActive":true,"identifier":"doc:\/\/Systems\/documentation\/Systems\/EventWriter"},{"type":"text","text":" "},{"type":"text","text":"sends events, and an "},{"type":"reference","isActive":true,"identifier":"doc:\/\/Systems\/documentation\/Systems\/EventReader"},{"type":"text","text":" reads the events sent since the system last read them. The"},{"type":"text","text":" "},{"type":"text","text":"following schedule sends a "},{"type":"codeVoice","code":"Damage"},{"type":"text","text":" event for each entity below the ground, then applies the"},{"type":"text","text":" "},{"type":"text","text":"damage to its target’s health:"}]},{"syntax":"swift","code":["var world = World()","let knight = world.spawn(Position(x: 0, y: -1), Health(current: 30))","","let frame = Schedule {","    UpdateEvents()","    Combat()","    ApplyDamage().after(Combat.self)","}","frame.run(on: &world)","print(world[Health.self, of: knight].current)","\/\/ Prints \"20\""],"type":"codeListing"},{"type":"paragraph","inlineContent":[{"identifier":"doc:\/\/Systems\/documentation\/Systems\/EventWriter","type":"reference","isActive":true},{"type":"text","text":" declares "},{"code":"Combat","type":"codeVoice"},{"type":"text","text":", and "},{"identifier":"doc:\/\/Systems\/documentation\/Systems\/EventReader","type":"reference","isActive":true},{"type":"text","text":" declares "},{"code":"ApplyDamage","type":"codeVoice"},{"type":"text","text":"."}]},{"anchor":"Spawn-and-Despawn-Entities","type":"heading","level":3,"text":"Spawn and Despawn Entities"},{"type":"paragraph","inlineContent":[{"type":"text","text":"A system that runs alongside others can’t spawn or despawn entities directly, because that"},{"type":"text","text":" "},{"type":"text","text":"changes every component type at once. Take an "},{"type":"codeVoice","code":"inout"},{"type":"text","text":" "},{"isActive":true,"type":"reference","identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/Commands"},{"type":"text","text":" instead, and queue"},{"type":"text","text":" "},{"type":"text","text":"the changes. Commands apply at the end of the wave the system runs in, so systems ordered after"},{"type":"text","text":" "},{"type":"text","text":"it see them:"}]},{"syntax":"swift","code":["@System","struct RemoveDefeated {","    func run(_ fighters: Query<Health>, _ commands: inout Commands) {","        for (entity, health) in fighters where health.current <= 0 {","            commands.despawn(entity)","        }","    }","}","","var world = World()","let knight = world.spawn(Health(current: 0))","world.spawn(Health(current: 12))","Schedule { RemoveDefeated() }.run(on: &world)","","print(world.contains(knight))","\/\/ Prints \"false\"","print(world.count)","\/\/ Prints \"1\""],"type":"codeListing"},{"type":"paragraph","inlineContent":[{"type":"text","text":"A commands parameter conflicts with nothing, so it doesn’t stop a system from running at the"},{"type":"text","text":" "},{"type":"text","text":"same time as others."}]},{"anchor":"Take-the-Whole-World","type":"heading","level":3,"text":"Take the Whole World"},{"type":"paragraph","inlineContent":[{"text":"A ","type":"text"},{"code":"run","type":"codeVoice"},{"text":" method that takes ","type":"text"},{"code":"inout World","type":"codeVoice"},{"text":" makes a system that can change anything. Its access is","type":"text"},{"text":" ","type":"text"},{"code":"nil","type":"codeVoice"},{"text":", so a schedule runs it alone, after the systems written before it and before those written","type":"text"},{"text":" ","type":"text"},{"text":"after it. Use one for work that touches many types at once, such as loading a level.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"To write a system by hand instead of with the macro, conform a type to ","type":"text"},{"identifier":"doc:\/\/Systems\/documentation\/Systems\/System","isActive":true,"type":"reference"},{"text":", implement","type":"text"},{"text":" ","type":"text"},{"identifier":"doc:\/\/Systems\/documentation\/Systems\/System\/run(in:)","isActive":true,"type":"reference"},{"text":", and declare an ","type":"text"},{"identifier":"doc:\/\/Systems\/documentation\/Systems\/System\/access","isActive":true,"type":"reference"},{"text":" listing every type the system reads and","type":"text"},{"text":" ","type":"text"},{"text":"writes.","type":"text"}]},{"anchor":"Run-on-the-Main-Actor","type":"heading","level":3,"text":"Run on the Main Actor"},{"type":"paragraph","inlineContent":[{"text":"Mark a system type, or its ","type":"text"},{"code":"run","type":"codeVoice"},{"text":" method, ","type":"text"},{"code":"@MainActor","type":"codeVoice"},{"text":" to make a ","type":"text"},{"identifier":"doc:\/\/Systems\/documentation\/Systems\/MainActorSystem","isActive":true,"type":"reference"},{"text":", which a","type":"text"},{"text":" ","type":"text"},{"text":"schedule runs on the main actor after the other systems of its wave. Use one to carry results","type":"text"},{"text":" ","type":"text"},{"text":"from the world to a user interface.","type":"text"}]}]}],"schemaVersion":{"major":0,"minor":3,"patch":0},"identifier":{"url":"doc:\/\/Systems\/documentation\/Systems\/DeclaringSystems","interfaceLanguage":"swift"},"kind":"article","metadata":{"modules":[{"name":"Systems"}],"roleHeading":"API Collection","role":"collectionGroup","title":"Declaring Systems"},"sections":[],"hierarchy":{"paths":[["doc:\/\/Systems\/documentation\/Systems"]]},"abstract":[{"type":"text","text":"Write the rules of a simulation as systems, and let their parameters state what they read and"},{"type":"text","text":" "},{"type":"text","text":"write."}],"seeAlsoSections":[{"identifiers":["doc:\/\/Systems\/documentation\/Systems\/DrivingAWorldFromAnApp","doc:\/\/Systems\/documentation\/Systems\/System()","doc:\/\/Systems\/documentation\/Systems\/System"],"anchor":"Essentials","title":"Essentials","generated":true}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/systems\/declaringsystems"]}],"references":{"doc://Systems/documentation/Systems/MainActorSystem":{"fragments":[{"kind":"keyword","text":"protocol"},{"kind":"text","text":" "},{"kind":"identifier","text":"MainActorSystem"}],"title":"MainActorSystem","identifier":"doc:\/\/Systems\/documentation\/Systems\/MainActorSystem","kind":"symbol","type":"topic","navigatorTitle":[{"kind":"identifier","text":"MainActorSystem"}],"abstract":[{"type":"text","text":"A system that runs on the main actor, for work that touches main-actor state such as a user"},{"type":"text","text":" "},{"type":"text","text":"interface."}],"role":"symbol","url":"\/documentation\/systems\/mainactorsystem"},"doc://Systems/documentation/Systems":{"title":"Systems","url":"\/documentation\/systems","kind":"symbol","abstract":[{"text":"Declare the rules of a simulation as systems, and run them on a world in a schedule.","type":"text"}],"type":"topic","identifier":"doc:\/\/Systems\/documentation\/Systems","role":"collection"},"doc://Systems/documentation/Systems/RemovedComponents":{"title":"RemovedComponents","kind":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"RemovedComponents","kind":"identifier"}],"identifier":"doc:\/\/Systems\/documentation\/Systems\/RemovedComponents","type":"topic","role":"symbol","abstract":[{"type":"text","text":"A system parameter that lists the entities that lost a component since the system last read"},{"type":"text","text":" "},{"type":"text","text":"them."}],"url":"\/documentation\/systems\/removedcomponents","navigatorTitle":[{"text":"RemovedComponents","kind":"identifier"}]},"doc://Systems/documentation/Systems/ResourceWriter":{"type":"topic","fragments":[{"kind":"keyword","text":"class"},{"kind":"text","text":" "},{"kind":"identifier","text":"ResourceWriter"}],"url":"\/documentation\/systems\/resourcewriter","identifier":"doc:\/\/Systems\/documentation\/Systems\/ResourceWriter","kind":"symbol","abstract":[{"type":"text","text":"A system parameter that reads and writes a resource."}],"role":"symbol","navigatorTitle":[{"kind":"identifier","text":"ResourceWriter"}],"title":"ResourceWriter"},"doc://Systems/documentation/Systems/System/access":{"url":"\/documentation\/systems\/system\/access","title":"access","required":true,"role":"symbol","defaultImplementations":1,"abstract":[{"text":"The component, resource and event types the system reads and writes, or ","type":"text"},{"code":"nil","type":"codeVoice"},{"text":" if it may","type":"text"},{"text":" ","type":"text"},{"text":"change anything.","type":"text"}],"fragments":[{"text":"var","kind":"keyword"},{"text":" ","kind":"text"},{"kind":"identifier","text":"access"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"Access","preciseIdentifier":"s:11WorldModule6AccessV"},{"kind":"text","text":"?"}],"kind":"symbol","identifier":"doc:\/\/Systems\/documentation\/Systems\/System\/access","type":"topic"},"doc://Systems/documentation/Systems/DrivingAWorldFromAnApp":{"url":"\/documentation\/systems\/drivingaworldfromanapp","title":"Driving a World from an App","role":"article","abstract":[{"text":"Hold a world in your app or game engine, feed it each frame’s input, and let the objects outside","type":"text"},{"text":" ","type":"text"},{"text":"it read results and take part in a step.","type":"text"}],"kind":"article","identifier":"doc:\/\/Systems\/documentation\/Systems\/DrivingAWorldFromAnApp","type":"topic"},"doc://Systems/documentation/Systems/System()":{"url":"\/documentation\/systems\/system()","title":"System()","role":"symbol","abstract":[{"text":"Makes a type a system whose access comes from the parameters of its ","type":"text"},{"type":"codeVoice","code":"run"},{"text":" method.","type":"text"}],"fragments":[{"kind":"keyword","text":"macro"},{"kind":"text","text":" "},{"kind":"identifier","text":"System"},{"kind":"text","text":"()"}],"kind":"symbol","identifier":"doc:\/\/Systems\/documentation\/Systems\/System()","type":"topic"},"doc://Systems/documentation/Systems/ResourceReader":{"url":"\/documentation\/systems\/resourcereader","title":"ResourceReader","navigatorTitle":[{"kind":"identifier","text":"ResourceReader"}],"role":"symbol","abstract":[{"type":"text","text":"A system parameter that reads a resource."}],"fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"ResourceReader"}],"kind":"symbol","identifier":"doc:\/\/Systems\/documentation\/Systems\/ResourceReader","type":"topic"},"doc://Systems/documentation/Systems/System/run(in:)":{"identifier":"doc:\/\/Systems\/documentation\/Systems\/System\/run(in:)","role":"symbol","type":"topic","url":"\/documentation\/systems\/system\/run(in:)","required":true,"kind":"symbol","abstract":[{"type":"text","text":"Runs the system’s rule once on a world."}],"fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"run"},{"kind":"text","text":"("},{"kind":"externalParam","text":"in"},{"kind":"text","text":": "},{"kind":"keyword","text":"inout"},{"kind":"text","text":" "},{"kind":"typeIdentifier","preciseIdentifier":"s:11WorldModule0A0V","text":"World"},{"kind":"text","text":")"}],"title":"run(in:)"},"doc://Systems/documentation/Systems/System":{"title":"System","url":"\/documentation\/systems\/system","navigatorTitle":[{"kind":"identifier","text":"System"}],"role":"symbol","abstract":[{"type":"text","text":"A rule that reads and changes a world, run once each time its schedule runs."}],"fragments":[{"kind":"keyword","text":"protocol"},{"kind":"text","text":" "},{"kind":"identifier","text":"System"}],"kind":"symbol","identifier":"doc:\/\/Systems\/documentation\/Systems\/System","type":"topic"},"doc://Systems/documentation/Systems/Update":{"navigatorTitle":[{"kind":"identifier","text":"Update"}],"title":"Update","identifier":"doc:\/\/Systems\/documentation\/Systems\/Update","role":"symbol","kind":"symbol","url":"\/documentation\/systems\/update","abstract":[{"text":"A system parameter that changes a component of every entity that holds it.","type":"text"}],"fragments":[{"kind":"keyword","text":"class"},{"kind":"text","text":" "},{"kind":"identifier","text":"Update"}],"type":"topic"},"doc://Systems/documentation/Systems/EventWriter":{"kind":"symbol","title":"EventWriter","fragments":[{"text":"class","kind":"keyword"},{"text":" ","kind":"text"},{"text":"EventWriter","kind":"identifier"}],"identifier":"doc:\/\/Systems\/documentation\/Systems\/EventWriter","type":"topic","role":"symbol","abstract":[{"type":"text","text":"A system parameter that sends events of one type."}],"url":"\/documentation\/systems\/eventwriter","navigatorTitle":[{"text":"EventWriter","kind":"identifier"}]},"doc://WorldModule/documentation/WorldModule/Query":{"type":"topic","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Query","kind":"identifier"}],"url":"\/documentation\/worldmodule\/query","identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/Query","kind":"symbol","abstract":[{"type":"text","text":"A description of the entities to visit and the components to read from each."}],"role":"symbol","navigatorTitle":[{"text":"Query","kind":"identifier"}],"title":"Query"},"doc://Systems/documentation/Systems/EventReader":{"url":"\/documentation\/systems\/eventreader","title":"EventReader","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"EventReader","kind":"identifier"}],"navigatorTitle":[{"text":"EventReader","kind":"identifier"}],"kind":"symbol","abstract":[{"text":"A system parameter that reads the events of one type sent since the system last read them.","type":"text"}],"type":"topic","identifier":"doc:\/\/Systems\/documentation\/Systems\/EventReader","role":"symbol"},"doc://WorldModule/documentation/WorldModule/Commands":{"title":"Commands","url":"\/documentation\/worldmodule\/commands","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"Commands"}],"navigatorTitle":[{"kind":"identifier","text":"Commands"}],"identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/Commands","abstract":[{"text":"A buffer of changes to a world, recorded now and applied later in the order they were","type":"text"},{"text":" ","type":"text"},{"text":"recorded.","type":"text"}],"kind":"symbol","type":"topic","role":"symbol"}}}