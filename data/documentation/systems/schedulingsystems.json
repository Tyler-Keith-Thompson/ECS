{"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/Systems\/documentation\/Systems\/SchedulingSystems"},"seeAlsoSections":[{"title":"Essentials","identifiers":["doc:\/\/Systems\/documentation\/Systems\/DeclaringSystems","doc:\/\/Systems\/documentation\/Systems\/DrivingAWorldFromAnApp","doc:\/\/Systems\/documentation\/Systems\/System()","doc:\/\/Systems\/documentation\/Systems\/System"],"generated":true,"anchor":"Essentials"}],"schemaVersion":{"major":0,"minor":3,"patch":0},"primaryContentSections":[{"kind":"content","content":[{"type":"heading","level":2,"text":"Overview","anchor":"Overview"},{"type":"paragraph","inlineContent":[{"type":"text","text":"A "},{"identifier":"doc:\/\/Systems\/documentation\/Systems\/Schedule","isActive":true,"type":"reference"},{"type":"text","text":" lists the systems of one frame or step. When it runs, it decides the order from"},{"type":"text","text":" "},{"type":"text","text":"what you wrote and the constraints you added, and it runs the systems that can’t affect one"},{"type":"text","text":" "},{"type":"text","text":"another at the same time."}]},{"type":"heading","level":3,"text":"Order Systems","anchor":"Order-Systems"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Systems run in the order you write them, adjusted by ordering constraints. "},{"type":"codeVoice","code":"after(_:)"},{"type":"text","text":" moves a"},{"type":"text","text":" "},{"type":"text","text":"system after another, and "},{"type":"codeVoice","code":"before(_:)"},{"type":"text","text":" moves it before one; every other system keeps its written"},{"type":"text","text":" "},{"type":"text","text":"place. A constraint that names a type with no system in the schedule is ignored. Constraints that"},{"type":"text","text":" "},{"type":"text","text":"form a cycle trap, and "},{"type":"reference","identifier":"doc:\/\/Systems\/documentation\/Systems\/Schedule\/init(checked:)","isActive":true},{"type":"text","text":" throws "},{"type":"reference","identifier":"doc:\/\/Systems\/documentation\/Systems\/CyclicOrdering","isActive":true},{"type":"text","text":" instead, for systems"},{"type":"text","text":" "},{"type":"text","text":"or constraints that come from configuration."}]},{"type":"heading","level":3,"text":"Run Systems Conditionally","anchor":"Run-Systems-Conditionally"},{"type":"paragraph","inlineContent":[{"code":"runIf(_:)","type":"codeVoice"},{"type":"text","text":" skips a system unless a condition on the world holds, such as the world holding no"},{"type":"text","text":" "},{"code":"Paused","type":"codeVoice"},{"type":"text","text":" resource. On a nested schedule, it applies to each of the nested schedule’s systems. Each"},{"type":"text","text":" "},{"type":"text","text":"system checks its conditions at the start of the wave it runs in, so a system that changes what"},{"type":"text","text":" "},{"type":"text","text":"a condition reads affects the systems in later waves. A condition must read only what each"},{"type":"text","text":" "},{"type":"text","text":"system’s access lists."}]},{"type":"heading","level":3,"text":"Understand Waves","anchor":"Understand-Waves"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Two systems "},{"type":"emphasis","inlineContent":[{"text":"conflict","type":"text"}]},{"type":"text","text":" when one writes a type the other reads or writes, or when either has no"},{"type":"text","text":" "},{"type":"reference","isActive":true,"identifier":"doc:\/\/Systems\/documentation\/Systems\/System\/access"},{"type":"text","text":". "},{"type":"reference","isActive":true,"identifier":"doc:\/\/Systems\/documentation\/Systems\/Schedule\/run(on:)"},{"type":"text","text":" runs the systems in "},{"type":"emphasis","inlineContent":[{"text":"waves","type":"text"}]},{"type":"text","text":": each wave holds the systems"},{"type":"text","text":" "},{"type":"text","text":"whose earlier conflicting and ordered systems have run, and its systems run at the same time. The"},{"type":"text","text":" "},{"type":"text","text":"commands systems queue apply when their wave finishes, so a system in the same wave doesn’t see"},{"type":"text","text":" "},{"type":"text","text":"another’s spawns, despawns or inserts. To see them, order it after the system that queued them."}]},{"type":"paragraph","inlineContent":[{"text":"The world ends as though the systems had run one after another, in order. ","type":"text"},{"isActive":true,"identifier":"doc:\/\/Systems\/documentation\/Systems\/Schedule\/runSerially(on:)","type":"reference"},{"text":" ","type":"text"},{"text":"runs the same waves one system at a time, with the same result. Use it to step through a system in","type":"text"},{"text":" ","type":"text"},{"text":"a debugger, or to rule out running at the same time as the cause of a problem.","type":"text"}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"A system’s access comes from its parameters, with the "},{"isActive":true,"type":"reference","identifier":"doc:\/\/Systems\/documentation\/Systems\/System()"},{"type":"text","text":" macro, or from an "},{"type":"codeVoice","code":"access"},{"type":"text","text":" "},{"type":"text","text":"you declare by hand. A system without one may change anything, so it runs alone. In debug"},{"type":"text","text":" "},{"type":"text","text":"builds, a system that reaches a type its access doesn’t list traps, so run a schedule’s tests in"},{"type":"text","text":" "},{"type":"text","text":"debug."}]},{"type":"heading","level":3,"text":"Find Unordered Conflicts","anchor":"Find-Unordered-Conflicts"},{"type":"paragraph","inlineContent":[{"type":"text","text":"When two conflicting systems aren’t ordered by any constraint, the order they run in rests only"},{"type":"text","text":" "},{"type":"text","text":"on how they happen to be written, which a later edit can change by accident."},{"type":"text","text":" "},{"type":"reference","identifier":"doc:\/\/Systems\/documentation\/Systems\/Schedule\/ambiguities()","isActive":true},{"type":"text","text":" lists those pairs. Order each pair, or mark it with"},{"type":"text","text":" "},{"type":"reference","identifier":"doc:\/\/Systems\/documentation\/Systems\/ScheduledSystem\/ambiguous(with:)","isActive":true},{"type":"text","text":" when either order is right, and check in a test that the"},{"type":"text","text":" "},{"type":"text","text":"list stays empty."}]},{"type":"heading","level":3,"text":"Group Systems into Sets","anchor":"Group-Systems-into-Sets"},{"type":"paragraph","inlineContent":[{"type":"text","text":"A "},{"type":"reference","isActive":true,"identifier":"doc:\/\/Systems\/documentation\/Systems\/SystemSet"},{"type":"text","text":" names a group of systems, so a constraint can refer to all of them at once."},{"type":"text","text":" "},{"type":"text","text":"Declare one as an empty enumeration. A system joins it with "},{"type":"codeVoice","code":"inSet(_:)"},{"type":"text","text":", and a nested schedule"},{"type":"text","text":" "},{"type":"text","text":"takes "},{"type":"codeVoice","code":"inSet(_:)"},{"type":"text","text":", "},{"type":"codeVoice","code":"after(_:)"},{"type":"text","text":", "},{"type":"codeVoice","code":"before(_:)"},{"type":"text","text":" and "},{"type":"codeVoice","code":"runIf(_:)"},{"type":"text","text":" for all of its systems. Every system"},{"type":"text","text":" "},{"type":"text","text":"type is a set too, holding each system of that type."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"The following schedule groups gravity and movement into a physics set that doesn’t run while"},{"type":"text","text":" "},{"type":"text","text":"the game is paused, and scores after every physics system:"}]},{"type":"codeListing","code":["let frame = Schedule {","    Schedule {","        Gravity()","        Movement().after(Gravity.self)","    }","    .inSet(Physics.self)","    .runIf { world in !world.resources.contains(Paused.self) }","    Scoring().after(Physics.self)","}","print(frame.names)","\/\/ Prints \"[\"Gravity\", \"Movement\", \"Scoring\"]\"","print(frame.ambiguities().isEmpty)","\/\/ Prints \"true\""],"syntax":"swift"},{"type":"heading","level":3,"text":"Profile a Schedule","anchor":"Profile-a-Schedule"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Insert a "},{"isActive":true,"type":"reference","identifier":"doc:\/\/Systems\/documentation\/Systems\/SystemProfile"},{"type":"text","text":" resource into a world, and every schedule that runs on it records each"},{"type":"text","text":" "},{"type":"text","text":"system’s runs and times. "},{"isActive":true,"type":"reference","identifier":"doc:\/\/Systems\/documentation\/Systems\/Schedule\/writeDOT(to:)"},{"type":"text","text":" writes a schedule’s dependency graph in the"},{"type":"text","text":" "},{"type":"text","text":"DOT language, so Graphviz can draw why systems run in the order they do and which can run at the"},{"type":"text","text":" "},{"type":"text","text":"same time."}]}]}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/systems\/schedulingsystems"]}],"hierarchy":{"paths":[["doc:\/\/Systems\/documentation\/Systems"]]},"abstract":[{"text":"Order the systems of a schedule, run them only when a condition holds, and find out how a","type":"text"},{"text":" ","type":"text"},{"text":"schedule runs them.","type":"text"}],"metadata":{"role":"article","roleHeading":"Article","modules":[{"name":"Systems"}],"title":"Scheduling Systems"},"sections":[],"kind":"article","references":{"doc://Systems/documentation/Systems/DeclaringSystems":{"url":"\/documentation\/systems\/declaringsystems","kind":"article","title":"Declaring Systems","type":"topic","identifier":"doc:\/\/Systems\/documentation\/Systems\/DeclaringSystems","abstract":[{"text":"Write the rules of a simulation as systems, and let their parameters state what they read and","type":"text"},{"text":" ","type":"text"},{"text":"write.","type":"text"}],"role":"collectionGroup"},"doc://Systems/documentation/Systems/Schedule":{"kind":"symbol","navigatorTitle":[{"text":"Schedule","kind":"identifier"}],"url":"\/documentation\/systems\/schedule","title":"Schedule","role":"symbol","identifier":"doc:\/\/Systems\/documentation\/Systems\/Schedule","abstract":[{"text":"A list of systems that run on a world, in order, and at the same time where they can.","type":"text"}],"type":"topic","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Schedule","kind":"identifier"}]},"doc://Systems/documentation/Systems/CyclicOrdering":{"role":"symbol","navigatorTitle":[{"kind":"identifier","text":"CyclicOrdering"}],"fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"CyclicOrdering"}],"url":"\/documentation\/systems\/cyclicordering","abstract":[{"type":"text","text":"An error indicating that the ordering constraints of a schedule’s systems form a cycle, so no"},{"type":"text","text":" "},{"type":"text","text":"order satisfies them all."}],"identifier":"doc:\/\/Systems\/documentation\/Systems\/CyclicOrdering","kind":"symbol","type":"topic","title":"CyclicOrdering"},"doc://Systems/documentation/Systems/System":{"kind":"symbol","navigatorTitle":[{"kind":"identifier","text":"System"}],"url":"\/documentation\/systems\/system","title":"System","role":"symbol","identifier":"doc:\/\/Systems\/documentation\/Systems\/System","abstract":[{"type":"text","text":"A rule that reads and changes a world, run once each time its schedule runs."}],"type":"topic","fragments":[{"kind":"keyword","text":"protocol"},{"kind":"text","text":" "},{"kind":"identifier","text":"System"}]},"doc://Systems/documentation/Systems/ScheduledSystem/ambiguous(with:)":{"identifier":"doc:\/\/Systems\/documentation\/Systems\/ScheduledSystem\/ambiguous(with:)","role":"symbol","abstract":[{"text":"Returns this system, also free to run in either order with every system in each of the","type":"text"},{"text":" ","type":"text"},{"text":"given sets.","type":"text"}],"title":"ambiguous(with:)","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"ambiguous","kind":"identifier"},{"text":"<each ","kind":"text"},{"kind":"genericParameter","text":"S"},{"kind":"text","text":">("},{"kind":"externalParam","text":"with"},{"kind":"text","text":": repeat (each "},{"kind":"typeIdentifier","text":"S"},{"kind":"text","text":").Type) -> "},{"kind":"typeIdentifier","preciseIdentifier":"s:7Systems15ScheduledSystemV","text":"ScheduledSystem"}],"url":"\/documentation\/systems\/scheduledsystem\/ambiguous(with:)","kind":"symbol","type":"topic"},"doc://Systems/documentation/Systems/Schedule/runSerially(on:)":{"kind":"symbol","identifier":"doc:\/\/Systems\/documentation\/Systems\/Schedule\/runSerially(on:)","url":"\/documentation\/systems\/schedule\/runserially(on:)","role":"symbol","title":"runSerially(on:)","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"runSerially","kind":"identifier"},{"text":"(","kind":"text"},{"text":"on","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"inout","kind":"keyword"},{"text":" ","kind":"text"},{"preciseIdentifier":"s:11WorldModule0A0V","text":"World","kind":"typeIdentifier"},{"text":")","kind":"text"}],"type":"topic","abstract":[{"text":"Runs each system once on a world, one system at a time.","type":"text"}]},"doc://Systems/documentation/Systems/SystemProfile":{"role":"symbol","navigatorTitle":[{"kind":"identifier","text":"SystemProfile"}],"fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"SystemProfile"}],"url":"\/documentation\/systems\/systemprofile","identifier":"doc:\/\/Systems\/documentation\/Systems\/SystemProfile","abstract":[{"text":"A resource that records how long each system takes to run.","type":"text"}],"kind":"symbol","type":"topic","title":"SystemProfile"},"doc://Systems/documentation/Systems/Schedule/ambiguities()":{"kind":"symbol","identifier":"doc:\/\/Systems\/documentation\/Systems\/Schedule\/ambiguities()","url":"\/documentation\/systems\/schedule\/ambiguities()","role":"symbol","title":"ambiguities()","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"ambiguities","kind":"identifier"},{"text":"() -> [","kind":"text"},{"preciseIdentifier":"s:7Systems9AmbiguityV","kind":"typeIdentifier","text":"Ambiguity"},{"kind":"text","text":"]"}],"type":"topic","abstract":[{"type":"text","text":"Returns every pair of systems whose accesses conflict but that no ordering constraint"},{"type":"text","text":" "},{"type":"text","text":"orders."}]},"doc://Systems/documentation/Systems/System/access":{"title":"access","identifier":"doc:\/\/Systems\/documentation\/Systems\/System\/access","defaultImplementations":1,"url":"\/documentation\/systems\/system\/access","abstract":[{"type":"text","text":"The component, resource and event types the system reads and writes, or "},{"code":"nil","type":"codeVoice"},{"type":"text","text":" if it may"},{"type":"text","text":" "},{"type":"text","text":"change anything."}],"fragments":[{"text":"var","kind":"keyword"},{"text":" ","kind":"text"},{"kind":"identifier","text":"access"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"Access","preciseIdentifier":"s:11WorldModule6AccessV"},{"kind":"text","text":"?"}],"kind":"symbol","type":"topic","required":true,"role":"symbol"},"doc://Systems/documentation/Systems/System()":{"kind":"symbol","identifier":"doc:\/\/Systems\/documentation\/Systems\/System()","url":"\/documentation\/systems\/system()","role":"symbol","title":"System()","fragments":[{"kind":"keyword","text":"macro"},{"kind":"text","text":" "},{"kind":"identifier","text":"System"},{"kind":"text","text":"()"}],"type":"topic","abstract":[{"type":"text","text":"Makes a type a system whose access comes from the parameters of its "},{"type":"codeVoice","code":"run"},{"type":"text","text":" method."}]},"doc://Systems/documentation/Systems/DrivingAWorldFromAnApp":{"title":"Driving a World from an App","identifier":"doc:\/\/Systems\/documentation\/Systems\/DrivingAWorldFromAnApp","url":"\/documentation\/systems\/drivingaworldfromanapp","abstract":[{"type":"text","text":"Hold a world in your app or game engine, feed it each frame’s input, and let the objects outside"},{"type":"text","text":" "},{"type":"text","text":"it read results and take part in a step."}],"kind":"article","type":"topic","role":"article"},"doc://Systems/documentation/Systems":{"kind":"symbol","role":"collection","title":"Systems","identifier":"doc:\/\/Systems\/documentation\/Systems","url":"\/documentation\/systems","abstract":[{"text":"Declare the rules of a simulation as systems, and run them on a world in a schedule.","type":"text"}],"type":"topic"},"doc://Systems/documentation/Systems/Schedule/writeDOT(to:)":{"identifier":"doc:\/\/Systems\/documentation\/Systems\/Schedule\/writeDOT(to:)","kind":"symbol","url":"\/documentation\/systems\/schedule\/writedot(to:)","role":"symbol","title":"writeDOT(to:)","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"writeDOT","kind":"identifier"},{"text":"(","kind":"text"},{"text":"to","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"inout","kind":"keyword"},{"text":" ","kind":"text"},{"text":"some","kind":"keyword"},{"text":" ","kind":"text"},{"text":"TextOutputStream","kind":"typeIdentifier","preciseIdentifier":"s:s16TextOutputStreamP"},{"text":")","kind":"text"}],"type":"topic","abstract":[{"text":"Writes the schedule’s dependency graph in the DOT language, for drawing with Graphviz.","type":"text"}]},"doc://Systems/documentation/Systems/Schedule/init(checked:)":{"identifier":"doc:\/\/Systems\/documentation\/Systems\/Schedule\/init(checked:)","kind":"symbol","url":"\/documentation\/systems\/schedule\/init(checked:)","role":"symbol","title":"init(checked:)","fragments":[{"kind":"identifier","text":"init"},{"kind":"text","text":"("},{"kind":"externalParam","text":"checked"},{"kind":"text","text":": ["},{"preciseIdentifier":"s:7Systems15ScheduledSystemV","text":"ScheduledSystem","kind":"typeIdentifier"},{"text":"]) ","kind":"text"},{"text":"throws","kind":"keyword"},{"text":"(","kind":"text"},{"preciseIdentifier":"s:7Systems14CyclicOrderingV","text":"CyclicOrdering","kind":"typeIdentifier"},{"text":")","kind":"text"}],"type":"topic","abstract":[{"text":"Creates a schedule of the given systems, throwing an error if their ordering constraints","type":"text"},{"text":" ","type":"text"},{"text":"form a cycle.","type":"text"}]},"doc://Systems/documentation/Systems/Schedule/run(on:)":{"role":"symbol","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"run","kind":"identifier"},{"text":"(","kind":"text"},{"kind":"externalParam","text":"on"},{"kind":"text","text":": "},{"kind":"keyword","text":"inout"},{"kind":"text","text":" "},{"kind":"typeIdentifier","text":"World","preciseIdentifier":"s:11WorldModule0A0V"},{"kind":"text","text":")"}],"url":"\/documentation\/systems\/schedule\/run(on:)","identifier":"doc:\/\/Systems\/documentation\/Systems\/Schedule\/run(on:)","abstract":[{"text":"Runs each system once on a world, running systems that don’t depend on each other at the","type":"text"},{"text":" ","type":"text"},{"text":"same time.","type":"text"}],"kind":"symbol","type":"topic","title":"run(on:)"},"doc://Systems/documentation/Systems/SystemSet":{"role":"symbol","navigatorTitle":[{"text":"SystemSet","kind":"identifier"}],"fragments":[{"text":"protocol","kind":"keyword"},{"text":" ","kind":"text"},{"text":"SystemSet","kind":"identifier"}],"url":"\/documentation\/systems\/systemset","identifier":"doc:\/\/Systems\/documentation\/Systems\/SystemSet","abstract":[{"text":"A type that names a group of systems, so ordering constraints can refer to all of them at","type":"text"},{"text":" ","type":"text"},{"text":"once.","type":"text"}],"kind":"symbol","type":"topic","title":"SystemSet"}}}