{"primaryContentSections":[{"kind":"declarations","declarations":[{"tokens":[{"kind":"keyword","text":"protocol"},{"kind":"text","text":" "},{"kind":"identifier","text":"SystemSet"}],"platforms":["Linux"],"languages":["swift"]}]},{"mentions":["doc:\/\/Systems\/documentation\/Systems\/SchedulingSystems"],"kind":"mentions"},{"content":[{"anchor":"overview","text":"Overview","type":"heading","level":2},{"type":"paragraph","inlineContent":[{"text":"Declare a set as an empty enumeration conforming to ","type":"text"},{"type":"codeVoice","code":"SystemSet"},{"text":". A system joins it with","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"inSet(_:)"},{"text":", and ","type":"text"},{"type":"codeVoice","code":"after(_:)"},{"text":", ","type":"text"},{"type":"codeVoice","code":"before(_:)"},{"text":" and ","type":"text"},{"type":"codeVoice","code":"ambiguous(with:)"},{"text":" accept the set wherever they","type":"text"},{"text":" ","type":"text"},{"text":"accept a system type. The following example orders scoring after every physics system:","type":"text"}]},{"syntax":"swift","type":"codeListing","code":["enum Physics: SystemSet {}","","let frame = Schedule {","    Scoring().after(Physics.self)","    Schedule {","        Gravity()","        Movement().after(Gravity.self)","    }","    .inSet(Physics.self)","}","print(frame.names)","\/\/ Prints \"[\"Gravity\", \"Movement\", \"Scoring\"]\""]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Every system type is itself a set, holding each system of that type, so "},{"type":"codeVoice","code":"after(Gravity.self)"},{"type":"text","text":" "},{"type":"text","text":"orders a system after every "},{"type":"codeVoice","code":"Gravity"},{"type":"text","text":" in the schedule."}]}],"kind":"content"}],"schemaVersion":{"major":0,"minor":3,"patch":0},"kind":"symbol","identifier":{"url":"doc:\/\/Systems\/documentation\/Systems\/SystemSet","interfaceLanguage":"swift"},"metadata":{"modules":[{"name":"Syst