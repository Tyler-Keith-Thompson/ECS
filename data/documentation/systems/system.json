{"identifier":{"url":"doc:\/\/Systems\/documentation\/Systems\/System","interfaceLanguage":"swift"},"abstract":[{"type":"text","text":"A rule that reads and changes a world, run once each time its schedule runs."}],"hierarchy":{"paths":[["doc:\/\/Systems\/documentation\/Systems"]]},"metadata":{"symbolKind":"protocol","remoteSource":{"url":"https:\/\/github.com\/Tyler-Keith-Thompson\/ECS\/blob\/main\/Sources\/Systems\/System.swift#L40","fileName":"System.swift"},"modules":[{"name":"Systems"}],"roleHeading":"Protocol","role":"symbol","externalID":"s:7Systems6SystemP","title":"System","navigatorTitle":[{"kind":"identifier","text":"System"}],"fragments":[{"text":"protocol","kind":"keyword"},{"text":" ","kind":"text"},{"text":"System","kind":"identifier"}]},"sections":[],"topicSections":[{"anchor":"Running-a-System","identifiers":["doc:\/\/Systems\/documentation\/Systems\/System\/run(in:)","doc:\/\/Systems\/documentation\/Systems\/System\/access","doc:\/\/Systems\/documentation\/Systems\/System\/initialize(in:)"],"title":"Running a System"},{"anchor":"Ordering-a-System","identifiers":["doc:\/\/Systems\/documentation\/Systems\/System\/after(_:)","doc:\/\/Systems\/documentation\/Systems\/System\/before(_:)","doc:\/\/Systems\/documentation\/Systems\/System\/inSet(_:)","doc:\/\/Systems\/documentation\/Systems\/System\/ambiguous(with:)"],"title":"Ordering a System"},{"anchor":"Running-a-System-Conditionally","identifiers":["doc:\/\/Systems\/documentation\/Systems\/System\/runIf(_:)"],"title":"Running a System Conditionally"}],"relationshipsSections":[{"identifiers":["doc:\/\/Systems\/s8SendableP","doc:\/\/Systems\/s16SendableMetatypeP","doc:\/\/Systems\/documentation\/Systems\/SystemSet"],"kind":"relationships","type":"inheritsFrom","title":"Inherits From"},{"title":"Conforming Types","type":"conformingTypes","kind":"relationships","identifiers":["doc:\/\/Systems\/documentation\/Systems\/ForwardChanges","doc:\/\/Systems\/documentation\/Systems\/ForwardEvents","doc:\/\/Systems\/documentation\/Systems\/UpdateEvents"]}],"seeAlsoSections":[{"title":"Essentials","generated":true,"identifiers":["doc:\/\/Systems\/documentation\/Systems\/DeclaringSystems","doc:\/\/Systems\/documentation\/Systems\/DrivingAWorldFromAnApp","doc:\/\/Systems\/documentation\/Systems\/System()"],"anchor":"Essentials"}],"variants":[{"paths":["\/documentation\/systems\/system"],"traits":[{"interfaceLanguage":"swift"}]}],"kind":"symbol","schemaVersion":{"patch":0,"major":0,"minor":3},"primaryContentSections":[{"kind":"declarations","declarations":[{"languages":["swift"],"platforms":["Linux"],"tokens":[{"kind":"keyword","text":"protocol"},{"kind":"text","text":" "},{"kind":"identifier","text":"System"},{"kind":"text","text":" : "},{"kind":"typeIdentifier","text":"Sendable","preciseIdentifier":"s:s8SendableP"},{"kind":"text","text":", "},{"kind":"typeIdentifier","text":"SystemSet","preciseIdentifier":"s:7Systems9SystemSetP","identifier":"doc:\/\/Systems\/documentation\/Systems\/SystemSet"}]}]},{"kind":"content","content":[{"type":"heading","level":2,"text":"Overview","anchor":"overview"},{"type":"paragraph","inlineContent":[{"type":"text","text":"A system is one step of a frame or tick: moving everything with a velocity, applying damage,"},{"type":"text","text":" "},{"type":"text","text":"counting the score. You put systems in a "},{"type":"reference","identifier":"doc:\/\/Systems\/documentation\/Systems\/Schedule","isActive":true},{"type":"text","text":", which runs each of them once per run,"},{"type":"text","text":" "},{"type":"text","text":"and at the same time as one another where it can."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Most systems are declared with the "},{"isActive":true,"identifier":"doc:\/\/Systems\/documentation\/Systems\/System()","type":"reference"},{"type":"text","text":" macro, which writes the conformance from a"},{"type":"text","text":" "},{"code":"run","type":"codeVoice"},{"type":"text","text":" method’s parameters. Conform to "},{"code":"System","type":"codeVoice"},{"type":"text","text":" yourself when a system needs the whole world,"},{"type":"text","text":" "},{"type":"text","text":"for example to spawn and despawn entities directly or to reach types chosen at run time. A"},{"type":"text","text":" "},{"type":"text","text":"conforming type implements "},{"isActive":true,"identifier":"doc:\/\/Systems\/documentation\/Systems\/System\/run(in:)","type":"reference"},{"type":"text","text":" and, so that it can run alongside other systems,"},{"type":"text","text":" "},{"type":"text","text":"declares an "},{"isActive":true,"identifier":"doc:\/\/Systems\/documentation\/Systems\/System\/access","type":"reference"},{"type":"text","text":" listing what it reads and writes:"}]},{"type":"codeListing","syntax":"swift","code":["struct Friction: System {","    var access: Access? { .writes(Velocity.self) }","","    func run(in world: inout World) {","        world.update(Velocity.self) { velocity, _ in","            velocity.dx *= 0.5","        }","    }","}","","var world = World()","let puck = world.spawn(Velocity(dx: 8, dy: 0))","Schedule { Friction() }.run(on: &world)","print(world[Velocity.self, of: puck].dx)","\/\/ Prints \"4.0\""]},{"type":"paragraph","inlineContent":[{"type":"text","text":"A system keeps no state of its own between runs. Anything it needs to remember belongs in the"},{"type":"text","text":" "},{"type":"text","text":"world, as components or resources, so it is copied, compared and restored along with"},{"type":"text","text":" "},{"type":"text","text":"everything else."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Every system type is also a "},{"type":"reference","isActive":true,"identifier":"doc:\/\/Systems\/documentation\/Systems\/SystemSet"},{"type":"text","text":" containing each of its systems, so ordering"},{"type":"text","text":" "},{"type":"text","text":"constraints such as "},{"type":"reference","isActive":true,"identifier":"doc:\/\/Systems\/documentation\/Systems\/System\/after(_:)"},{"type":"text","text":" can name it."}]}]}],"references":{"doc://Systems/documentation/Systems/DeclaringSystems":{"type":"topic","identifier":"doc:\/\/Systems\/documentation\/Systems\/DeclaringSystems","abstract":[{"text":"Write the rules of a simulation as systems, and let their parameters state what they read and","type":"text"},{"text":" ","type":"text"},{"text":"write.","type":"text"}],"role":"collectionGroup","title":"Declaring Systems","kind":"article","url":"\/documentation\/systems\/declaringsystems"},"doc://Systems/documentation/Systems/System/runIf(_:)":{"url":"\/documentation\/systems\/system\/runif(_:)","identifier":"doc:\/\/Systems\/documentation\/Systems\/System\/runIf(_:)","type":"topic","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"runIf","kind":"identifier"},{"text":"((","kind":"text"},{"text":"World","kind":"typeIdentifier","preciseIdentifier":"s:11WorldModule0A0V"},{"text":") -> ","kind":"text"},{"text":"Bool","preciseIdentifier":"s:Sb","kind":"typeIdentifier"},{"text":") -> ","kind":"text"},{"text":"ScheduledSystem","preciseIdentifier":"s:7Systems15ScheduledSystemV","kind":"typeIdentifier"}],"abstract":[{"text":"Returns this system, run only when a condition holds.","type":"text"}],"role":"symbol","kind":"symbol","title":"runIf(_:)"},"doc://Systems/documentation/Systems/ForwardEvents":{"type":"topic","identifier":"doc:\/\/Systems\/documentation\/Systems\/ForwardEvents","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"ForwardEvents","kind":"identifier"}],"abstract":[{"text":"A system that yields each event of one type to an asynchronous stream, so code outside the","type":"text"},{"text":" ","type":"text"},{"text":"schedule can await the events.","type":"text"}],"role":"symbol","navigatorTitle":[{"text":"ForwardEvents","kind":"identifier"}],"title":"ForwardEvents","kind":"symbol","url":"\/documentation\/systems\/forwardevents"},"doc://System