{"kind":"symbol","topicSections":[{"identifiers":["doc:\/\/Systems\/documentation\/Systems\/System\/run(in:)","doc:\/\/Systems\/documentation\/Systems\/System\/access","doc:\/\/Systems\/documentation\/Systems\/System\/initialize(in:)"],"title":"Running a System","anchor":"Running-a-System"},{"identifiers":["doc:\/\/Systems\/documentation\/Systems\/System\/after(_:)","doc:\/\/Systems\/documentation\/Systems\/System\/before(_:)","doc:\/\/Systems\/documentation\/Systems\/System\/inSet(_:)","doc:\/\/Systems\/documentation\/Systems\/System\/ambiguous(with:)"],"title":"Ordering a System","anchor":"Ordering-a-System"},{"identifiers":["doc:\/\/Systems\/documentation\/Systems\/System\/runIf(_:)"],"title":"Running a System Conditionally","anchor":"Running-a-System-Conditionally"}],"seeAlsoSections":[{"identifiers":["doc:\/\/Systems\/documentation\/Systems\/DeclaringSystems","doc:\/\/Systems\/documentation\/Systems\/DrivingAWorldFromAnApp","doc:\/\/Systems\/documentation\/Systems\/System()"],"title":"Essentials","generated":true,"anchor":"Essentials"}],"relationshipsSections":[{"type":"inheritsFrom","identifiers":["doc:\/\/Systems\/s8SendableP","doc:\/\/Systems\/s16SendableMetatypeP","doc:\/\/Systems\/documentation\/Systems\/SystemSet"],"title":"Inherits From","kind":"relationships"},{"type":"conformingTypes","identifiers":["doc:\/\/Systems\/documentation\/Systems\/ForwardChanges","doc:\/\/Systems\/documentation\/Systems\/ForwardEvents","doc:\/\/Systems\/documentation\/Systems\/UpdateEvents"],"title":"Conforming Types","kind":"relationships"}],"metadata":{"role":"symbol","title":"System","remoteSource":{"url":"https:\/\/github.com\/Tyler-Keith-Thompson\/ECS\/blob\/main\/Sources\/Systems\/System.swift#L40","fileName":"System.swift"},"symbolKind":"protocol","roleHeading":"Protocol","fragments":[{"kind":"keyword","text":"protocol"},{"kind":"text","text":" "},{"kind":"identifier","text":"System"}],"navigatorTitle":[{"kind":"identifier","text":"System"}],"modules":[{"name":"Systems"}],"externalID":"s:7Systems6SystemP"},"hierarchy":{"paths":[["doc:\/\/Systems\/documentation\/Systems"]]},"identifier":{"url":"doc:\/\/Systems\/documentation\/Systems\/System","interfaceLanguage":"swift"},"primaryContentSections":[{"kind":"declarations","declarations":[{"platforms":["Linux"],"languages":["swift"],"tokens":[{"text":"protocol","kind":"keyword"},{"text":" ","kind":"text"},{"text":"System","kind":"identifier"},{"text":" : ","kind":"text"},{"preciseIdentifier":"s:s8SendableP","text":"Sendable","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"preciseIdentifier":"s:7Systems9SystemSetP","identifier":"doc:\/\/Systems\/documentation\/Systems\/SystemSet","text":"SystemSet","kind":"typeIdentifier"}]}]},{"content":[{"text":"Overview","type":"heading","anchor":"overview","level":2},{"type":"paragraph","inlineContent":[{"text":"A system is one step of a frame or tick: moving everything with a velocity, applying damage,","type":"text"},{"text":" ","type":"text"},{"text":"counting the score. You put systems in a ","type":"text"},{"isActive":true,"identifier":"doc:\/\/Systems\/documentation\/Systems\/Schedule","type":"reference"},{"text":", which runs each of them once per run,","type":"text"},{"text":" ","type":"text"},{"text":"and at the same time as one another where it can.","type":"text"}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Most systems are declared with the "},{"type":"reference","isActive":true,"identifier":"doc:\/\/Systems\/documentation\/Systems\/System()"},{"type":"text","text":" macro, which writes the conformance from a"},{"type":"text","text":" "},{"type":"codeVoice","code":"run"},{"type":"text","text":" method’s parameters. Conform to "},{"type":"codeVoice","code":"System"},{"type":"text","text":" yourself when a system needs the whole world,"},{"type":"text","text":" "},{"type":"text","text":"for example to spawn and despawn entities directly or to reach types chosen at run time. A"},{"type":"text","text":" "},{"type":"text","text":"conforming type implements "},{"type":"reference","isActive":true,"identifier":"doc:\/\/Systems\/documentation\/Systems\/System\/run(in:)"},{"type":"text","text":" and, so that it can run alongside other systems,"},{"type":"text","text":" "},{"type":"text","text":"declares an "},{"type":"reference","isActive":true,"identifier":"doc:\/\/Systems\/documentation\/Systems\/System\/access"},{"type":"text","text":" listing what it reads and writes:"}]},{"type":"codeListing","syntax":"swift","code":["struct Friction: System {","    var access: Access? { .writes(Velocity.self) }","","    func run(in world: inout World) {","        world.update(Velocity.self) { velocity, _ in","            velocity.dx *= 0.5","        }","    }","}","","var world = World()","let puck = world.spawn(Velocity(dx: 8, dy: 0))","Schedule { Friction() }.run(on: &world)","print(world[Velocity.self, of: puck].dx)","\/\/ Prints \"4.0\""]},{"type":"paragraph","inlineContent":[{"text":"A system keeps no state of its own between runs. Anything it needs to remember belongs in the","type":"text"},{"text":" ","type":"text"},{"text":"world, as components or resources, so it is copied, compared and restored along with","type":"text"},{"text":" ","type":"text"},{"text":"everything else.","type":"text"}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Every system type is also a "},{"type":"reference","isActive":true,"identifier":"doc:\/\/Systems\/documentation\/Systems\/SystemSet"},{"type":"text","text":" containing each of its systems, so ordering"},{"type":"text","text":" "},{"type":"text","text":"constraints such as "},{"type":"reference","isActive":true,"identifier":"doc:\/\/Systems\/documentation\/Systems\/System\/after(_:)"},{"type":"text","text":" can name it."}]}],"kind":"content"}],"sections":[],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/systems\/system"]}],"abstract":[{"type":"text","text":"A rule that reads and changes a world, run once each time its schedule runs."}],"schemaVersion":{"major":0,"patch":0,"minor":3},"references":{"doc://Systems/documentation/Systems/System/before(_:)":{"fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"before"},{"kind":"text","text":"<each "},{"kind":"genericParameter","text":"S"},{"kind":"text","text":">(repeat (each "},{"text":"S","kind":"typeIdentifier"},{"text":").Type) -> ","kind":"text"},{"text":"ScheduledSystem","preciseIdentifier":"s:7Systems15ScheduledSystemV","kind":"typeIdentifier"}],"abstract":[{"type":"text","text":"Returns this system, ordered to run before every system in each of the given sets."}],"type":"topic","identifier":"doc:\/\/Systems\/documentation\/Systems\/System\/before(_:)","title":"before(_:)","role":"symbol","url":"\/documentation\/systems\/system\/before(_:)","kind":"symbol"},"doc://Systems/documentation/Systems/ForwardEvents":{"role":"symbol","navigatorTitle":[{"text":"ForwardEvents","kind":"identifier"}],"url":"\/documentation\/systems\/forwardevents","type":"topic","title":"ForwardEvents","abstract":[{"text":"A system that yields each event of one type to an asynchronous stream, so code outside the","type":"text"},{"text":" ","type":"text"},{"text":"schedule can await the events.","type":"text"}],"fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"ForwardEvents","kind":"identifier"}],"identifier":"doc:\/\/Systems\/documentation\/Systems\/ForwardEvents","kind":"symbol"},"doc://Systems/documentation/Systems/DrivingAWorldFromAnApp":{"abstract":[{"text":"Hold a world in your app or game engine, feed it each frame’s input, and let the objects outside","type":"text"},{"text":" ","type":"text"},{"text":"it read results and take part in a step.","type":"text"}],"type":"topic","identifier":"doc:\/\/Systems\/documentation\/Systems\/DrivingAWorldFromAnApp","title":"Driving a World from an App","role":"article","url":"\/documentation\/systems\/drivingaworldfroma