{"schemaVersion":{"major":0,"minor":3,"patch":0},"metadata":{"roleHeading":"Protocol","remoteSource":{"fileName":"System.swift","url":"https:\/\/github.com\/Tyler-Keith-Thompson\/ECS\/blob\/main\/Sources\/Systems\/System.swift#L40"},"symbolKind":"protocol","fragments":[{"kind":"keyword","text":"protocol"},{"kind":"text","text":" "},{"kind":"identifier","text":"System"}],"role":"symbol","navigatorTitle":[{"kind":"identifier","text":"System"}],"modules":[{"name":"Systems"}],"externalID":"s:7Systems6SystemP","title":"System"},"hierarchy":{"paths":[["doc:\/\/Systems\/documentation\/Systems"]]},"kind":"symbol","sections":[],"topicSections":[{"anchor":"Running-a-System","title":"Running a System","identifiers":["doc:\/\/Systems\/documentation\/Systems\/System\/run(in:)","doc:\/\/Systems\/documentation\/Systems\/System\/access","doc:\/\/Systems\/documentation\/Systems\/System\/initialize(in:)"]},{"anchor":"Ordering-a-System","title":"Ordering a System","identifiers":["doc:\/\/Systems\/documentation\/Systems\/System\/after(_:)","doc:\/\/Systems\/documentation\/Systems\/System\/before(_:)","doc:\/\/Systems\/documentation\/Systems\/System\/inSet(_:)","doc:\/\/Systems\/documentation\/Systems\/System\/ambiguous(with:)"]},{"anchor":"Running-a-System-Conditionally","title":"Running a System Conditionally","identifiers":["doc:\/\/Systems\/documentation\/Systems\/System\/runIf(_:)"]}],"relationshipsSections":[{"type":"inheritsFrom","kind":"relationships","title":"Inherits From","identifiers":["doc:\/\/Systems\/s8SendableP","doc:\/\/Systems\/s16SendableMetatypeP","doc:\/\/Systems\/documentation\/Systems\/SystemSet"]},{"type":"conformingTypes","kind":"relationships","identifiers":["doc:\/\/Systems\/documentation\/Systems\/ForwardChanges","doc:\/\/Systems\/documentation\/Systems\/ForwardEvents","doc:\/\/Systems\/documentation\/Systems\/UpdateEvents"],"title":"Conforming Types"}],"primaryContentSections":[{"kind":"declarations","declarations":[{"languages":["swift"],"platforms":["Linux"],"tokens":[{"text":"protocol","kind":"keyword"},{"text":" ","kind":"text"},{"text":"System","kind":"identifier"},{"text":" : ","kind":"text"},{"text":"Sendable","preciseIdentifier":"s:s8SendableP","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"SystemSet","preciseIdentifier":"s:7Systems9SystemSetP","kind":"typeIdentifier","identifier":"doc:\/\/Systems\/documentation\/Systems\/SystemSet"}]}]},{"content":[{"level":2,"type":"heading","anchor":"overview","text":"Overview"},{"type":"paragraph","inlineContent":[{"type":"text","text":"A system is one step of a frame or tick: moving everything with a velocity, applying damage,"},{"type":"text","text":" "},{"type":"text","text":"counting the score. You put systems in a "},{"identifier":"doc:\/\/Systems\/documentation\/Systems\/Schedule","type":"reference","isActive":true},{"type":"text","text":", which runs each of them once per run,"},{"type":"text","text":" "},{"type":"text","text":"and at the same time as one another where it can."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Most systems are declared with the "},{"identifier":"doc:\/\/Systems\/documentation\/Systems\/System()","type":"reference","isActive":true},{"type":"text","text":" macro, which writes the conformance from a"},{"type":"text","text":" "},{"type":"codeVoice","code":"run"},{"type":"text","text":" method’s parameters. Conform to "},{"type":"codeVoice","code":"System"},{"type":"text","text":" yourself when a system needs the whole world,"},{"type":"text","text":" "},{"type":"text","text":"for example to spawn and despawn entities directly or to reach types chosen at run time. A"},{"type":"text","text":" "},{"type":"text","text":"conforming type implements "},{"identifier":"doc:\/\/Systems\/documentation\/Systems\/System\/run(in:)","type":"reference","isActive":true},{"type":"text","text":" and, so that it can run alongside other systems,"},{"type":"text","text":" "},{"type":"text","text":"declares an "},{"identifier":"doc:\/\/Systems\/documentation\/Systems\/System\/access","type":"reference","isActive":true},{"type":"text","text":" listing what it reads and writes:"}]},{"syntax":"swift","type":"codeListing","code":["struct Friction: System {","    var access: Access? { .writes(Velocity.self) }","","    func run(in world: inout World) {","        world.update(Velocity.self) { velocity, _ in","            velocity.dx *= 0.5","        }","    }","}","","var world = World()","let puck = world.spawn(Velocity(dx: 8, dy: 0))","Schedule { Friction() }.run(on: &world)","print(world[Velocity.self, of: puck].dx)","\/\/ Prints \"4.0\""]},{"type":"paragraph","inlineContent":[{"type":"text","text":"A system keeps no state of its own between runs. Anything it needs to remember belongs in the"},{"type":"text","text":" "},{"type":"text","text":"world, as components or resources, so it is copied, compared and restored along with"},{"type":"text","text":" "},{"type":"text","text":"everything else."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Every system type is also a "},{"type":"reference","identifier":"doc:\/\/Systems\/documentation\/Systems\/SystemSet","isActive":true},{"type":"text","text":" containing each of its systems, so ordering"},{"type":"text","text":" "},{"type":"text","text":"constraints such as "},{"type":"reference","identifier":"doc:\/\/Systems\/documentation\/Systems\/System\/after(_:)","isActive":true},{"type":"text","text":" can name it."}]}],"kind":"content"}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/systems\/system"]}],"identifier":{"url":"doc:\/\/Systems\/documentation\/Systems\/System","interfaceLanguage":"swift"},"seeAlsoSections":[{"generated":true,"identifiers":["doc:\/\/Systems\/documentation\/Systems\/DeclaringSystems","doc:\/\/Systems\/documentation\/Systems\/DrivingAWorldFromAnApp","doc:\/\/Systems\/documentation\/Systems\/System()"],"title":"Essentials","anchor":"Essentials"}],"abstract":[{"type":"text","text":"A rule that reads and changes a world, run once each time its schedule runs."}],"references":{"doc://Systems/s16SendableMetatypeP":{"identifier":"doc:\/\/Systems\/s16SendableMetatypeP","title":"Swift.SendableMetatype","type":"unresolvable"},"doc://Systems/documentation/Systems/System()":{"fragments":[{"kind":"keyword","text":"macro"},{"kind":"text","text":" "},{"kind":"identifier","text":"System"},{"kind":"text","text":"()"}],"type":"topic","identifier":"doc:\/\/Systems\/documentation\/Systems\/System()","abstract":[{"type":"text","text":"Makes a type a system whose access comes from the parameters of its "},{"type":"codeVoice","code":"run"},{"type":"text","text":" method."}],"kind":"symbol","title":"System()","url":"\/documentation\/systems\/system()","role":"symbol"},"doc://Systems/documentation/Systems/System/runIf(_:)":{"fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"runIf"},{"kind":"text","text":"(("},{"kind":"typeIdentifier","preciseIdentifier":"s:11WorldModule0A0V","text":"World"},{"kind":"text","text":") -> "},{"kind":"typeIdentifier","preciseIdentifier":"s:Sb","text":"Bool"},{"kind":"text","text":") -> "},{"kind":"typeIdentifier","preciseIdentifier":"s:7Systems15ScheduledSystemV","text":"ScheduledSystem"}],"type":"topic","identifier":"doc:\/\/Systems\/documentation\/Systems\/System\/runIf(_:)","abstract":[{"type":"text","text":"Returns this system, run only when a condition holds."}],"kind":"symbol","title":"runIf(_:)","url":"\/documentation\/systems\/system\/runif(_:)","role":"symbol"},"doc://Systems/documentation/Systems/SystemSet":{"kind":"symbol","fragments":[{"kind":"keyword","text":"protocol"},{"kind":"text","text":" "},{"kind":"identifier","text":"SystemSet"}],"role":"symbol","navigatorTitle":[{"kind":"identifier","text":"SystemSet"}],"url":"\/documentation\/systems\/systemset","identifier":"doc:\/\/Systems\/documentation\/Systems\/SystemSet","type":"topic","abstract":[{"type":"text","text":"A type that names a group of systems, so ordering constraints can refer to all of them at"},{"type":"text","text":" "},{"type":"text","text":"once."}],"title":"SystemSet"},"doc://Systems/documentation/Systems/System/initialize(in:)":{"fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"initialize","kind":"identifier"},{"text":"(","kind":"text"},{"text":"in","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"inout","kind":"keyword"},{"text":" ","kind":"text"},{"text":"World","preciseIdentifier":"s:11WorldModule0A0V","kind":"typeIdentifier"},{"text":")","kind":"text"}],"type":"topic","abstract":[{"type":"text","text":"Prepares a world for the system before the system first runs on it."}],"identifier":"doc:\/\/Systems\/documentation\/Systems\/System\/initialize(in:)","kind":"symbol","title":"initialize(in:)","required":true,"url":"\/documentation\/systems\/system\/initialize(in:)","defaultImplementations":1,"role":"symbol"},"doc://Systems/s8SendableP":{"identifier":"doc:\/\/Systems\/s8SendableP","title":"Swift.Sendable","type":"unresolvable"},"doc://Systems/documentation/Systems/DeclaringSystems":{"type":"topic","abstract":[{"type":"text","text":"Write the rules of a simulation as systems, and let their parameters state what they read and"},{"type":"text","text":" "},{"type":"text","text":"write."}],"identifier":"doc:\/\/Systems\/documentation\/Systems\/DeclaringSystems","kind":"article","title":"Declaring Systems","url":"\/documentation\/systems\/declaringsystems","role":"collectionGroup"},"doc://Systems/documentation/Systems/System/run(in:)":{"role":"symbol","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"run"},{"kind":"text","text":"("},{"kind":"externalParam","text":"in"},{"kind":"text","text":": "},{"text":"inout","kind":"keyword"},{"text":" ","kind":"text"},{"text":"World","kind":"typeIdentifier","preciseIdentifier":"s:11WorldModule0A0V"},{"text":")","kind":"text"}],"identifi