{"variants":[{"paths":["\/documentation\/systems\/system"],"traits":[{"interfaceLanguage":"swift"}]}],"schemaVersion":{"patch":0,"minor":3,"major":0},"sections":[],"kind":"symbol","relationshipsSections":[{"title":"Inherits From","identifiers":["doc:\/\/Systems\/s8SendableP","doc:\/\/Systems\/s16SendableMetatypeP","doc:\/\/Systems\/documentation\/Systems\/SystemSet"],"kind":"relationships","type":"inheritsFrom"},{"title":"Conforming Types","identifiers":["doc:\/\/Systems\/documentation\/Systems\/ForwardChanges","doc:\/\/Systems\/documentation\/Systems\/ForwardEvents","doc:\/\/Systems\/documentation\/Systems\/UpdateEvents"],"kind":"relationships","type":"conformingTypes"}],"topicSections":[{"title":"Running a System","identifiers":["doc:\/\/Systems\/documentation\/Systems\/System\/run(in:)","doc:\/\/Systems\/documentation\/Systems\/System\/access","doc:\/\/Systems\/documentation\/Systems\/System\/initialize(in:)"],"anchor":"Running-a-System"},{"title":"Ordering a System","identifiers":["doc:\/\/Systems\/documentation\/Systems\/System\/after(_:)","doc:\/\/Systems\/documentation\/Systems\/System\/before(_:)","doc:\/\/Systems\/documentation\/Systems\/System\/inSet(_:)","doc:\/\/Systems\/documentation\/Systems\/System\/ambiguous(with:)"],"anchor":"Ordering-a-System"},{"title":"Running a System Conditionally","identifiers":["doc:\/\/Systems\/documentation\/Systems\/System\/runIf(_:)"],"anchor":"Running-a-System-Conditionally"}],"abstract":[{"text":"A rule that reads and changes a world, run once each time its schedule runs.","type":"text"}],"seeAlsoSections":[{"title":"Essentials","identifiers":["doc:\/\/Systems\/documentation\/Systems\/DeclaringSystems","doc:\/\/Systems\/documentation\/Systems\/DrivingAWorldFromAnApp","doc:\/\/Systems\/documentation\/Systems\/System()"],"anchor":"Essentials","generated":true}],"primaryContentSections":[{"declarations":[{"tokens":[{"text":"protocol","kind":"keyword"},{"text":" ","kind":"text"},{"text":"System","kind":"identifier"},{"text":" : ","kind":"text"},{"text":"Sendable","kind":"typeIdentifier","preciseIdentifier":"s:s8SendableP"},{"text":", ","kind":"text"},{"text":"SystemSet","kind":"typeIdentifier","identifier":"doc:\/\/Systems\/documentation\/Systems\/SystemSet","preciseIdentifier":"s:7Systems9SystemSetP"}],"platforms":["Linux"],"languages":["swift"]}],"kind":"declarations"},{"kind":"content","content":[{"text":"Overview","type":"heading","level":2,"anchor":"overview"},{"type":"paragraph","inlineContent":[{"text":"A system is one step of a frame or tick: moving everything with a velocity, applying damage,","type":"text"},{"text":" ","type":"text"},{"text":"counting the score. You put systems in a ","type":"text"},{"identifier":"doc:\/\/Systems\/documentation\/Systems\/Schedule","isActive":true,"type":"reference"},{"text":", which runs each of them once per run,","type":"text"},{"text":" ","type":"text"},{"text":"and at the same time as one another where it can.","type":"text"}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Most systems are declared with the "},{"isActive":true,"type":"reference","identifier":"doc:\/\/Systems\/documentation\/Systems\/System()"},{"type":"text","text":" macro, which writes the conformance from a"},{"type":"text","text":" "},{"type":"codeVoice","code":"run"},{"type":"text","text":" method’s parameters. Conform to "},{"type":"codeVoice","code":"System"},{"type":"text","text":" yourself when a system needs the whole world,"},{"type":"text","text":" "},{"type":"text","text":"for example to spawn and despawn entities directly or to reach types chosen at run time. A"},{"type":"text","text":" "},{"type":"text","text":"conforming type implements "},{"isActive":true,"type":"reference","identifier":"doc:\/\/Systems\/documentation\/Systems\/System\/run(in:)"},{"type":"text","text":" and, so that it can run alongside other systems,"},{"type":"text","text":" "},{"type":"text","text":"declares an "},{"isActive":true,"type":"reference","identifier":"doc:\/\/Systems\/documentation\/Systems\/System\/access"},{"type":"text","text":" listing what it reads and writes:"}]},{"code":["struct Friction: System {","    var access: Access? { .writes(Velocity.self) }","","    func run(in world: inout World) {","        world.update(Velocity.self) { velocity, _ in","            velocity.dx *= 0.5","        }","    }","}","","var world = World()","let puck = world.spawn(Velocity(dx: 8, dy: 0))","Schedule { Friction() }.run(on: &world)","print(world[Velocity.self, of: puck].dx)","\/\/ Prints \"4.0\""],"syntax":"swift","type":"codeListing"},{"type":"paragraph","inlineContent":[{"type":"text","text":"A system keeps no state of its own between runs. Anything it needs to remember belongs in the"},{"type":"text","text":" "},{"type":"text","text":"world, as components or resources, so it is copied, compared and restored along with"},{"type":"text","text":" "},{"type":"text","text":"everything else."}]},{"type":"paragraph","inlineContent":[{"text":"Every system type is also a ","type":"text"},{"type":"reference","identifier":"doc:\/\/Systems\/documentation\/Systems\/SystemSet","isActive":true},{"text":" containing each of its systems, so ordering","type":"text"},{"text":" ","type":"text"},{"text":"constraints such as ","type":"text"},{"type":"reference","identifier":"doc:\/\/Systems\/documentation\/Systems\/System\/after(_:)","isActive":true},{"text":" can name it.","type":"text"}]}]}],"identifier":{"url":"doc:\/\/Systems\/documentation\/Systems\/System","interfaceLanguage":"swift"},"hierarchy":{"paths":[["doc:\/\/Systems\/documentation\/Systems"]]},"metadata":{"modules":[{"name":"Systems"}],"title":"System","externalID":"s:7Systems6SystemP","remoteSource":{"url":"https:\/\/github.com\/Tyler-Keith-Thompson\/ECS\/blob\/main\/Sources\/Systems\/System.swift#L40","fileName":"System.swift"},"roleHeading":"Protocol","role":"symbol","symbolKind":"protocol","fragments":[{"kind":"keyword","text":"protocol"},{"kind":"text","text":" "},{"kind":"identif