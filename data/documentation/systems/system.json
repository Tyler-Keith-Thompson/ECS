{"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/systems\/system"]}],"kind":"symbol","seeAlsoSections":[{"generated":true,"anchor":"Essentials","identifiers":["doc:\/\/Systems\/documentation\/Systems\/DeclaringSystems","doc:\/\/Systems\/documentation\/Systems\/SchedulingSystems","doc:\/\/Systems\/documentation\/Systems\/DrivingAWorldFromAnApp","doc:\/\/Systems\/documentation\/Systems\/System()"],"title":"Essentials"}],"relationshipsSections":[{"type":"inheritsFrom","identifiers":["doc:\/\/Systems\/s8SendableP","doc:\/\/Systems\/s16SendableMetatypeP","doc:\/\/Systems\/documentation\/Systems\/SystemSet"],"kind":"relationships","title":"Inherits From"},{"type":"conformingTypes","identifiers":["doc:\/\/Systems\/documentation\/Systems\/ForwardChanges","doc:\/\/Systems\/documentation\/Systems\/ForwardEvents","doc:\/\/Systems\/documentation\/Systems\/UpdateEvents"],"kind":"relationships","title":"Conforming Types"}],"sections":[],"hierarchy":{"paths":[["doc:\/\/Systems\/documentation\/Systems"]]},"metadata":{"title":"System","symbolKind":"protocol","roleHeading":"Protocol","navigatorTitle":[{"text":"System","kind":"identifier"}],"remoteSource":{"url":"https:\/\/github.com\/Tyler-Keith-Thompson\/ECS\/blob\/main\/Sources\/Systems\/System.swift#L40","fileName":"System.swift"},"role":"symbol","fragments":[{"text":"protocol","kind":"keyword"},{"text":" ","kind":"text"},{"text":"System","kind":"identifier"}],"modules":[{"name":"Systems"}],"externalID":"s:7Systems6SystemP"},"abstract":[{"type":"text","text":"A rule that reads and changes a world, run once each time its schedule runs."}],"topicSections":[{"anchor":"Running-a-System","identifiers":["doc:\/\/Systems\/documentation\/Systems\/System\/run(in:)","doc:\/\/Systems\/documentation\/Systems\/System\/access","doc:\/\/Systems\/documentation\/Systems\/System\/initialize(in:)"],"title":"Running a System"},{"anchor":"Ordering-a-System","identifiers":["doc:\/\/Systems\/documentation\/Systems\/System\/after(_:)","doc:\/\/Systems\/documentation\/Systems\/System\/before(_:)","doc:\/\/Systems\/documentation\/Systems\/System\/inSet(_:)","doc:\/\/Systems\/documentation\/Systems\/System\/ambiguous(with:)"],"title":"Ordering a System"},{"anchor":"Running-a-System-Conditionally","identifiers":["doc:\/\/Systems\/documentation\/Systems\/System\/runIf(_:)"],"title":"Running a System Conditionally"}],"primaryContentSections":[{"declarations":[{"languages":["swift"],"tokens":[{"text":"protocol","kind":"keyword"},{"text":" ","kind":"text"},{"text":"System","kind":"identifier"},{"text":" : ","kind":"text"},{"text":"Sendable","preciseIdentifier":"s:s8SendableP","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"SystemSet","identifier":"doc:\/\/Systems\/documentation\/Systems\/SystemSet","preciseIdentifier":"s:7Systems9SystemSetP","kind":"typeIdentifier"}],"platforms":["Linux"]}],"kind":"declarations"},{"content":[{"level":2,"text":"Overview","type":"heading","anchor":"overview"},{"inlineContent":[{"text":"A system is one step of a frame or tick: moving everything with a velocity, applying damage,","type":"text"},{"text":" ","type":"text"},{"text":"counting the score. You put systems in a ","type":"text"},{"identifier":"doc:\/\/Systems\/documentation\/Systems\/Schedule","isActive":true,"type":"reference"},{"text":", which runs each of them once per run,","type":"text"},{"text":" ","type":"text"},{"text":"and at the same time as one another where it can.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"Most systems are declared with the ","type":"text"},{"type":"reference","identifier":"doc:\/\/Systems\/documentation\/Systems\/System()","isActive":true},{"text":" macro, which writes the conformance from a","type":"text"},{"text":" ","type":"text"},{"code":"run","type":"codeVoice"},{"text":" method’s parameters. Conform to ","type":"text"},{"code":"System","type":"codeVoice"},{"text":" yourself when a system needs the whole world,","type":"text"},{"text":" ","type":"text"},{"text":"for example to spawn and despawn entities directly or to reach types chosen at run time. A","type":"text"},{"text":" ","type":"text"},{"text":"conforming type implements ","type":"text"},{"type":"reference","identifier":"doc:\/\/Systems\/documentation\/Systems\/System\/run(in:)","isActive":true},{"text":" and, so that it can run alongside other systems,","type":"text"},{"text":" ","type":"text"},{"text":"declares an ","type":"text"},{"type":"reference","identifier":"doc:\/\/Systems\/documentation\/Systems\/System\/access","isActive":true},{"text":" listing what it reads and writes:","type":"text"}],"type":"paragraph"},{"syntax":"swift","code":["struct Friction: System {","    var access: Access? { .writes(Velocity.self) }","","    func run(in world: inout World) {","        world.update(Velocity.self) { velocity, _ in","            velocity.dx *= 0.5","        }","    }","}","","var world = World()","let puck = world.spawn(Velocity(dx: 8, dy: 0))","Schedule { Friction() }.run(on: &world)","print(world[Velocity.self, of: puck].dx)","\/\/ Prints \"4.0\""],"type":"codeListing"},{"inlineContent":[{"text":"A system keeps no state of its own between runs. Anything it needs to remember belongs in the","type":"text"},{"text":" ","type":"text"},{"text":"world, as components or resources, so it is copied, compared and restored along with","type":"text"},{"text":" ","type":"text"},{"text":"everything else.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"Every system type is also a "},{"identifier":"doc:\/\/Systems\/documentation\/Systems\/SystemSet","type":"reference","isActive":true},{"type":"text","text":" containing each of its systems, so ordering"},{"type":"text","text":" "},{"type":"text","text":"constraints such as "},{"identifier":"doc:\/\/Systems\/documentation\/Systems\/System\/after(_:)","type":"reference","isActive":true},{"type":"text","text":" can name it."}],"type":"paragraph"}],"kind":"content"}],"iden