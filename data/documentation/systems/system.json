{"sections":[],"hierarchy":{"paths":[["doc:\/\/Systems\/documentation\/Systems"]]},"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/Systems\/documentation\/Systems\/System"},"relationshipsSections":[{"title":"Inherits From","type":"inheritsFrom","kind":"relationships","identifiers":["doc:\/\/Systems\/s8SendableP","doc:\/\/Systems\/s16SendableMetatypeP","doc:\/\/Systems\/documentation\/Systems\/SystemSet"]},{"kind":"relationships","type":"conformingTypes","title":"Conforming Types","identifiers":["doc:\/\/Systems\/documentation\/Systems\/ForwardChanges","doc:\/\/Systems\/documentation\/Systems\/ForwardEvents","doc:\/\/Systems\/documentation\/Systems\/UpdateEvents"]}],"primaryContentSections":[{"kind":"declarations","declarations":[{"tokens":[{"text":"protocol","kind":"keyword"},{"text":" ","kind":"text"},{"text":"System","kind":"identifier"},{"kind":"text","text":" : "},{"kind":"typeIdentifier","text":"Sendable","preciseIdentifier":"s:s8SendableP"},{"kind":"text","text":", "},{"kind":"typeIdentifier","text":"SystemSet","identifier":"doc:\/\/Systems\/documentation\/Systems\/SystemSet","preciseIdentifier":"s:7Systems9SystemSetP"}],"languages":["swift"],"platforms":["Linux"]}]},{"content":[{"type":"heading","anchor":"overview","level":2,"text":"Overview"},{"type":"paragraph","inlineContent":[{"text":"A system is one step of a frame or tick: moving everything with a velocity, applying damage,","type":"text"},{"text":" ","type":"text"},{"text":"counting the score. You put systems in a ","type":"text"},{"identifier":"doc:\/\/Systems\/documentation\/Systems\/Schedule","type":"reference","isActive":true},{"text":", which runs each of them once per run,","type":"text"},{"text":" ","type":"text"},{"text":"and at the same time as one another where it can.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"Most systems are declared with the ","type":"text"},{"identifier":"doc:\/\/Systems\/documentation\/Systems\/System()","isActive":true,"type":"reference"},