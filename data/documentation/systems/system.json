dentifier":"doc:\/\/Systems\/documentation\/Systems\/SystemSet","preciseIdentifier":"s:7Systems9SystemSetP"}],"languages":["swift"],"platforms":["Linux"]}]},{"kind":"content","content":[{"text":"Overview","anchor":"overview","type":"heading","level":2},{"inlineContent":[{"type":"text","text":"A system is one step of a frame or tick: moving everything with a velocity, applying damage,"},{"type":"text","text":" "},{"type":"text","text":"counting the score. You put systems in a "},{"identifier":"doc:\/\/Systems\/documentation\/Systems\/Schedule","isActive":true,"type":"reference"},{"type":"text","text":", which runs each of them once per run,"},{"type":"text","text":" "},{"type":"text","text":"and at the same time as one another where it can."}],"type":"paragraph"},{"inlineContent":[{"text":"Most systems are declared with the ","type":"text"},{"identifier":"doc:\/\/Systems\/documentation\/Systems\/System()","type":"reference","isActive":true},{"text":" macro, which writes the conformance from a","type":"text"},{"text":" ","type":"text"},{"code":"run","type":"codeVoice"},{"text":" method’s parameters. Conform to ","type":"text"},{"code":"System","type":"codeVoice"},{"text":" yourself when a system needs the whole world,","type":"text"},{"text":" ","type":"text"},{"text":"for example to spawn and despawn entities directly or to reach types chosen at run time. A","type":"text"},{"text":" ","type":"text"},{"text":"conforming type implements ","type":"text"},{"identifier":"doc:\/\/Systems\/documentation\/Systems\/System\/run(in:)","type":"reference","isActive":true},{"text":" and, so that it can run alongside other systems,","type":"text"},{"text":" ","type":"text"},{"text":"declares an ","type":"text"},{"identifier":"doc:\/\/Systems\/documentation\/Systems\/System\/access","type":"reference","isActive":true},{"text":" listing what it reads and writes:","type":"text"}],"type":"paragraph"},{"code":["struct Friction: System {","    var access: Access? { .writes(Velocity.self) }","","    func run(in world: inout World) {","        world.update(Velocity.self) { velocity, _ in","            velocity.dx *= 0.5","        }","    }","}","","var world = World()","let puck = world.spawn(Velocity(dx: 8, dy: 0))","Schedule { Friction() }.run(on: &world)","print(world[Velocity.self, of: puck].dx)","\/\/ Prints \"4.0\""],"syntax":"swift","type":"codeListing"},{"inlineContent":[{"type":"text","text":"A system keeps no state of its own between runs. Anything it needs to remember belongs in the"},{"type":"text","text":" "},{"type":"text","text":"world, as components or resources, so it is copied, compared and restored along with"},{"type":"text","text":" "},{"type":"text","text":"everything else."}],"type":"paragraph"},{"inlineContent":[{"text":"Every system type is also a ","type":"text"},{"identifier":"doc:\/\/Systems\/documentation\/Systems\/SystemSet","isActive":true,"type":"reference"},{"text":" containing each of its systems, so ordering","type":"text"},{"text":" ","type":"text"},{"text":"constraints such as ","type":"text"},{"identifier":"doc:\/\/Systems\/documentation\/Systems\/System\/after(_:)","isActive":true,"type":"reference"},{"text":" can name it.","type":"text"}],"type":"paragraph"}]}],"sections":[],"topicSections":[{"identifiers":["doc:\/\/Systems\/documentation\/Systems\/System\/run(in:)","doc:\/\/Systems\/documentation\/Systems\/System\/access","doc:\/\/Systems\/documentation\/Systems\/System\/initialize(in:)"],"title":"Running a System","anchor":"Running-a-System"},{"identifiers":["doc:\/\/Systems\/documentation\/Systems\/System\/after(_:)","doc:\/\/Systems\/documentation\/Systems\/System\/before(_:)","doc:\/\/Systems\/documentation\/Systems\/System\/inSet(_:)","doc:\/\/Systems\/documentation\/Systems\/System\/ambiguous(with:)"],"title":"Ordering a System","anchor":"Ordering-a-System"},{"identifiers":["doc:\/\/Systems\/documentation\/Systems\/System\/runIf(_:)"],"title":"Running a System Conditionally","anchor":"Running-a-System-Co