{"abstract":[{"text":"A rule that reads and changes a world, run once each time its schedule runs.","type":"text"}],"hierarchy":{"paths":[["doc:\/\/Systems\/documentation\/Systems"]]},"seeAlsoSections":[{"title":"Essentials","generated":true,"identifiers":["doc:\/\/Systems\/documentation\/Systems\/DeclaringSystems","doc:\/\/Systems\/documentation\/Systems\/SchedulingSystems","doc:\/\/Systems\/documentation\/Systems\/DrivingAWorldFromAnApp","doc:\/\/Systems\/documentation\/Systems\/System()"],"anchor":"Essentials"}],"metadata":{"remoteSource":{"url":"https:\/\/github.com\/Tyler-Keith-Thompson\/ECS\/blob\/main\/Sources\/Systems\/System.swift#L40","fileName":"System.swift"},"navigatorTitle":[{"text":"System","kind":"identifier"}],"roleHeading":"Protocol","title":"System","modules":[{"name":"Systems"}],"role":"symbol","externalID":"s:7Systems6SystemP","fragments":[{"text":"protocol","kind":"keyword"},{"text":" ","kind":"text"},{"text":"System","kind":"identifier"}],"symbolKind":"protocol"},"identifier":{"url":"doc:\/\/Systems\/documentation\/Systems\/System","interfaceLanguage":"swift"},"sections":[],"topicSections":[{"title":"Running a System","identifiers":["doc:\/\/Systems\/documentation\/Systems\/System\/run(in:)","doc:\/\/Systems\/documentation\/Systems\/System\/access","doc:\/\/Systems\/documentation\/Systems\/System\/initialize(in:)"],"anchor":"Running-a-System"},{"title":"Ordering a System","identifiers":["doc:\/\/Systems\/documentation\/Systems\/System\/after(_:)","doc:\/\/Systems\/documentation\/Systems\/System\/before(_:)","doc:\/\/Systems\/documentation\/Systems\/System\/inSet(_:)","doc:\/\/Systems\/documentation\/Systems\/System\/ambiguous(with:)"],"anchor":"Ordering-a-System"},{"title":"Running a System Conditionally","identifiers":["doc:\/\/Systems\/documentation\/Systems\/System\/runIf(_:)"],"anchor":"Running-a-System-Conditionally"}],"relationshipsSections":[{"title":"Inherits From","identifiers":["doc:\/\/Systems\/s8SendableP","doc:\/\/Systems\/s16SendableMetatypeP","doc:\/\/Systems\/documentation\/Systems\/SystemSet"],"type":"inheritsFrom","kind":"relationships"},{"title":"Conforming Types","identifiers":["doc:\/\/Systems\/documentation\/Systems\/ForwardChanges","doc:\/\/Systems\/documentation\/Systems\/ForwardEvents","doc:\/\/Systems\/documentation\/Systems\/UpdateEvents"],"type":"conformingTypes","kind":"relationships"}],"variants":[{"paths":["\/documentation\/systems\/system"],"traits":[{"interfaceLanguage":"swift"}]}],"primaryContentSections":[{"declarations":[{"tokens":[{"kind":"keyword","text":"protocol"},{"kind":"text","text":" "},{"kind":"identifier","text":"System"},{"kind":"text","text":" : "},{"kind":"typeIdentifier","preciseIdentifier":"s:s8SendableP","text":"Sendable"},{"kind":"text","text":", "},{"kind":"typeIdentifier","identifier":"doc:\/\/Systems\/documentation\/Systems\/SystemSet","preciseIdentifier":"s:7Systems9SystemSetP","text":"SystemSet"}],"languages":["swift"],"platforms":["Linux"]}],"kind":"declarations"},{"kind":"content","content":[{"level":2,"text":"Overview","type":"heading","anchor":"overview"},{"inlineContent":[{"type":"text","text":"A system is one step of a frame or tick: moving everything with a velocity, applying damage,"},{"type":"text","text":" "},{"type":"text","text":"counting the score. You put systems in a "},{"type":"reference","isActive":true,"identifier":"doc:\/\/Systems\/documentation\/Systems\/Schedule"},{"type":"text","text":", which runs each of them once per run,"},{"type":"text","text":" "},{"type":"text","text":"and at the same time as one another where it can."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"Most systems are declared with the "},{"isActive":true,"identifier":"doc:\/\/Systems\/documentation\/Systems\/System()","type":"reference"},{"type":"text","text":" macro, which writes the conformance from a"},{"type":"text","text":" "},{"code":"run","type":"codeVoice"},{"type":"text","text":" method’s parameters. Conform to "},{"code":"System","type":"codeVoice"},{"type":"text","text":" yourself when a system needs the whole world,"},{"type":"text","text":" "},{"type":"text","text":"for example to spawn and despawn entities directly or to reach types chosen at run time. A"},{"type":"text","text":" "},{"type":"text","text":"conforming type implements "},{"isActive":true,"identifier":"doc:\/\/Systems\/documentation\/Systems\/System\/run(in:)","type":"reference"},{"type":"text","text":" and, so that it can run alongside other systems,"},{"type":"text","text":" "},{"type":"text","text":"declares an "},{"isActive":true,"identifier":"doc:\/\/Systems\/documentation\/Systems\/System\/access","type":"reference"},{"type":"text","text":" listing what it reads and writes:"}],"type":"paragraph"},{"code":["struct Friction: System {","    var access: Access? { .writes(Velocity.self) }","","    func run(in world: inout World) {","        world.update(Velocity.self) { velocity, _ in","            velocity.dx *= 0.5","        }","    }","}","","var world = World()","let puck = world.spawn(Velocity(dx: 8, dy: 0))","Schedule { Friction() }.run(on: &world)","print(world[Velocity.self, of: puck].dx)","\/\/ Prints \"4.0\""],"type":"codeListing","syntax":"swift"},{"inlineContent":[{"text":"A system keeps no state of its own between runs. Anything it needs to remember belongs in the","type":"text"},{"text":" ","type":"text"},{"text":"world, as components or resources, so it is copied, compared and restored along with","type":"text"},{"text":" ","type":"text"},{"text":"everything else.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"Every system type is also a "},{"identifier":"doc:\/\/Systems\/documentation\/Systems\/SystemSet","isActive":true,"type":"reference"},{"type":"text","text":" containing each of its systems, so ordering"},{"type":"text","text":" "},{"type":"text","text":"constraints such as "},{"identifier":"doc:\/\/Systems\/documentation\/Systems\/System\/after(_:)","isActive":true,"type":"reference"},{"type":"text","text":" can name it."}],"type":"paragraph"}]}],"kind":"symbol","schemaVersion":{"major":0,"patch":0,"minor":3},"references":{"doc://Systems/documentation/Systems/ForwardChanges":{"type":"topic","kind":"symbol","identifier":"doc:\/\/Systems\/documentation\/Systems\/ForwardChanges","url":"\/documentation\/systems\/forwardchanges","navigatorTitle":[{"kind":"identifier","text":"ForwardChanges"}],"role":"symbol","abstract":[{"type":"text","text":"A system that yields each component of one type added or changed since it last ran to an"},{"type":"text","text":" "},{"type":"text","text":"asynchronous stream, with its entity."}],"title":"ForwardChanges","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"ForwardChanges"}]},"doc://Systems/documentation/Systems/System/runIf(_:)":{"fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"runIf"},{"kind":"text","text":"(("},{"kind":"typeIdentifier","preciseIdentifier":"s:11WorldModule0A0V","text":"World"},{"kind":"text","text":") -> "},{"kind":"typeIdentifier","preciseIdentifier":"s:Sb","text":"Bool"},{"kind":"text","text":") -> "},{"kind":"typeIdentifier","preciseIdentifier":"s:7Systems15ScheduledSystemV","text":"ScheduledSystem"}],"kind":"symbol","title":"runIf(_:)","identifier":"doc:\/\/Systems\/documentation\/Systems\/System\/runIf(_:)","type":"topic","url":"\/documentation\/systems\/system\/runif(_:)","role":"symbol","abstract":[{"text":"Returns this system, run only when a condition holds.","type":"text"}]},"doc://Systems/documentation/Systems/Schedule":{"type":"topic","kind":"symbol","identifier":"doc:\/\/Systems\/documentation\/Systems\/Schedule","url":"\/documentation\/systems\/schedule","navigatorTitle":[{"text":"Schedule","kind":"identifier"}],"role":"symbol","abstract":[{"type":"text","text":"A list of systems that run on a world, in order, and at the same time where they can."}],"title":"Sch