{"primaryContentSections":[{"declarations":[{"languages":["swift"],"tokens":[{"kind":"keyword","text":"protocol"},{"kind":"text","text":" "},{"kind":"identifier","text":"System"},{"kind":"text","text":" : "},{"preciseIdentifier":"s:s8SendableP","kind":"typeIdentifier","text":"Sendable"},{"kind":"text","text":", "},{"preciseIdentifier":"s:7Systems9SystemSetP","identifier":"doc:\/\/Systems\/documentation\/Systems\/SystemSet","kind":"typeIdentifier","text":"SystemSet"}],"platforms":["Linux"]}],"kind":"declarations"},{"content":[{"level":2,"text":"Overview","type":"heading","anchor":"overview"},{"inlineContent":[{"type":"text","text":"A system is one step of a frame or tick: moving everything with a velocity, applying damage,"},{"type":"text","text":" "},{"type":"text","text":"counting the score. You put systems in a "},{"identifier":"doc:\/\/Systems\/documentation\/Systems\/Schedule","isActive":true,"type":"reference"},{"type":"text","text":", which runs each of them once per run,"},{"type":"text","text":" "},{"type":"text","text":"and at the same time as one another where it can."}],"type":"paragraph"},{"inlineContent":[{"text":"Most systems are declared with the ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/Systems\/documentation\/Systems\/System()"},{"text":" macro, which writes the conformance from a","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"run"},{"text":" method’s parameters. Conform to ","type":"text"},{"type":"codeVoice","code":"System"},{"text":" yourself when a system needs the whole world,","type":"text"},{"text":" ","type":"text"},{"text":"for example to spawn and despawn entities directly or to reach types chosen at run time. A","type":"text"},{"text":" ","type":"text"},{"text":"conforming type implements ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/Systems\/documentation\/Systems\/System\/run(in:)"},{"text":" and, so that it can run alongside other systems,","type":"text"},{"text":" ","type":"text"},{"text":"declares an ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/Systems\/documentation\/Systems\/System\/access"},{"text":" listing what it reads and writes:","type":"text"}],"type":"paragraph"},{"syntax":"swift","type":"codeListing","code":["struct Friction: System {","    var access: Access? { .writes(Velocity.self) }","","    func run(in world: inout World) {","        world.update(Velocity.self) { velocity, _ in","            velocity.dx *= 0.5","        }","    }","}","","var world = World()","let puck = world.spawn(Velocity(dx: 8, dy: 0))","Schedule { Friction() }.run(on: &world)","print(world[Velocity.self, of: puck].dx)","\/\/ Prints \"4.0\""]},{"inlineContent":[{"type":"text","text":"A system keeps no state of its own between runs. Anything it needs to remember belongs in the"},{"type":"text","text":" "},{"type":"text","text":"world, as components or resources, so it is copied, compared and restored along with"},{"type":"text","text":" "},{"type":"text","text":"everything else."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"Every system type is also a "},{"isActive":true,"identifier":"doc:\/\/Systems\/documentation\/Systems\/SystemSet","type":"reference"},{"type":"text","text":" containing each of its systems, so ordering"},{"type":"text","text":" "},{"type":"text","text":"constraints such as "},{"isActive":true,"identifier":"doc:\/\/Systems\/documentation\/Systems\/System\/after(_:)","type":"reference"},{"type":"text","text":" can name it."}],"type":"paragraph"}],"kind":"content"}],"topicSections":[{"identifiers":["doc:\/\/Systems\/documentation\/Systems\/System\/run(in:)","doc:\/\/Systems\/documentation\/Systems\/System\/access","doc:\/\/Systems\/documentation\/Systems\/System\/initialize(in:)"],"title":"Running a System","anchor":"Running-a-System"},{"identifiers":["doc:\/\/Systems\/documentation\/Systems\/System\/after(_:)","doc:\/\/Systems\/documentation\/Systems\/System\/