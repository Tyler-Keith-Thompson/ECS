stems, so ordering","type":"text"},{"text":" ","type":"text"},{"text":"constraints such as ","type":"text"},{"type":"reference","isActive":true,"identifier":"doc:\/\/Systems\/documentation\/Systems\/System\/after(_:)"},{"text":" can name it.","type":"text"}]}],"kind":"content"}],"kind":"symbol","schemaVersion":{"major":0,"minor":3,"patch":0},"metadata":{"title":"System","modules":[{"name":"Systems"}],"symbolKind":"protocol","roleHeading":"Protocol","externalID":"s:7Systems6SystemP","navigatorTitle":[{"text":"System","kind":"identifier"}],"role":"symbol","fragments":[{"text":"protocol","kind":"keyword"},{"text":" ","kind":"text"},{"kind":"identifier","text":"System"}],"remoteSource":{"fileName":"System.swift","url":"https:\/\/github.com\/Tyler-Keith-Thompson\/ECS\/blob\/main\/Sources\/Systems\/System.swift#L40"}},"topicSections":[{"title":"Running a System","identifiers":["doc:\/\/Systems\/documentation\/Systems\/System\/run(in:)","doc:\/\/Systems\/documentation\/Systems\/System\/access","doc:\/\/Systems\/documentation\/Systems\/System\/initialize(in:)"],"anchor":"Running-a-System"},{"title":"Ordering a System","identifiers":["doc:\/\/Systems\/documentation\/Systems\/System\/after(_:)","doc:\/\/Systems\/documentation\/Systems\/System\/before(_:)","doc:\/\/Systems\/documentation\/Systems\/System\/inSet(_:)","doc:\/\/Systems\/documentation\/Systems\/System\/ambiguous(with:)"],"anchor":"Ordering-a-System"},{"title":"Running a System Conditionally","identifiers":["doc:\/\/Systems\/documentation\/Systems\/System\/runIf(_:)"],"anchor":"Running-a-System-Conditionally"}],"seeAlsoSections":[{"title":"Essentials","anchor":"Essentials","identifiers":["doc:\/\/Systems\/documentation\/Systems\/DeclaringSystems","doc:\/\/Systems\/documentation\/Systems\/DrivingAWorldFromAnApp","doc:\/\/Systems\/documentation\/Systems\/System()"],"generated":true}],"variants":[{"paths":["\/documentation\/systems\/system"],"traits":[{"interfaceLanguage":"swift"}]}],"abstract":[{"type":"text","text":