{"abstract":[{"type":"text","text":"A rule that reads and changes a world, run once each time its schedule runs."}],"topicSections":[{"title":"Running a System","anchor":"Running-a-System","identifiers":["doc:\/\/Systems\/documentation\/Systems\/System\/run(in:)","doc:\/\/Systems\/documentation\/Systems\/System\/access","doc:\/\/Systems\/documentation\/Systems\/System\/initialize(in:)"]},{"title":"Ordering a System","anchor":"Ordering-a-System","identifiers":["doc:\/\/Systems\/documentation\/Systems\/System\/after(_:)","doc:\/\/Systems\/documentation\/Systems\/System\/before(_:)","doc:\/\/Systems\/documentation\/Systems\/System\/inSet(_:)","doc:\/\/Systems\/documentation\/Systems\/System\/ambiguous(with:)"]},{"title":"Running a System Conditionally","anchor":"Running-a-System-Conditionally","identifiers":["doc:\/\/Systems\/documentation\/Systems\/System\/runIf(_:)"]}],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/Systems\/documentation\/Systems\/System"},"schemaVersion":{"patch":0,"major":0,"minor":3},"hierarchy":{"paths":[["doc:\/\/Systems\/documentation\/Systems"]]},"metadata":{"roleHeading":"Protocol","externalID":"s:7Systems6SystemP","navigatorTitle":[{"text":"System","kind":"identifier"}],"symbolKind":"protocol","role":"symbol","modules":[{"name":"Systems"}],"title":"System","fragments":[{"kind":"keyword","text":"protocol"},{"kind":"text","text":" "},{"kind":"identifier","text":"System"}],"remoteSource":{"fileName":"System.swift","url":"https:\/\/github.com\/Tyler-Keith-Thompson\/ECS\/blob\/main\/Sources\/Systems\/System.swift#L40"}},"sections":[],"kind":"symbol","primaryContentSections":[{"declarations":[{"tokens":[{"text":"protocol","kind":"keyword"},{"text":" ","kind":"text"},{"text":"System","kind":"identifier"},{"text":" : ","kind":"text"},{"text":"Sendable","preciseIdentifier":"s:s8SendableP","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"SystemSet","preciseIdentifier":"s:7Systems9SystemSetP","kind":"typeIdentifier","identifier":"doc:\/\/Systems\/documentation\/Systems\/SystemSet"}],"platforms":["Linux"],"languages":["swift"]}],"kind":"declarations"},{"content":[{"type":"heading","text":"Overview","level":2,"anchor":"overview"},{"type":"paragraph","inlineContent":[{"type":"text","text":"A system is one step of a frame or tick: moving everything with a velocity, applying damage,"},{"type":"text","text":" "},{"type":"text","text":"counting the score. You put systems in a "},{"type":"reference","isActive":true,"identifier":"doc:\/\/Systems\/documentation\/Systems\/Schedule"},{"type":"text","text":", which runs each of them once per run,"},{"type":"text","text":" "},{"type":"text","text":"and at the same time as one another where it can."}]},{"type":"paragraph","inlineContent":[{"text":"Most systems are declared with the ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/Systems\/documentation\/Systems\/System()"},{"text":" macro, which writes the conformance from a","type":"text"},{"text":" ","type":"text"},{"code":"run","type":"codeVoice"},{"text":" method’s parameters. Conform to ","type":"text"},{"code":"System","type":"codeVoice"},{"text":" yourself when a system needs the whole world,","type":"text"},{"text":" ","type":"text"},{"text":"for example to spawn and despawn entities directly or to reach types chosen at run time. A","type":"text"},{"text":" ","type":"text"},{"text":"conforming type implements ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/Systems\/documentation\/Systems\/System\/run(in:)"},{"text":" and, so that it can run alongside other systems,","type":"text"},{"text":" ","type":"text"},{"text":"declares an ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/Systems\/documentation\/Systems\/System\/access"},{"text":" listing what it reads and writes:","type":"text"}]},{"type":"codeListing","syntax":"swift","code":["struct Friction: System {","    var access: Access? { .writes(Velocity.self) }","","    func run(in world: inout World) {","        world.update(Velocity.self) { velocity, _ in","            velocity.dx *= 0.5","        }","    }","}","","var world = World()","let puck = world.spawn(Velocity(dx: 8, dy: 0))","Schedule { Friction() }.run(on: &world)","print(world[Velocity.self, of: puck].dx)","\/\/ Prints \"4.0\""]},{"type":"paragraph","inlineContent":[{"type":"text","text":"A system keeps no state of its own between runs. Anything it needs to remember belongs in the"},{"type":"text","text":" "},{"type":"text","text":"world, as components or resources, so it is copied, compared and restored along with"},{"type":"text","text":" "},{"type":"text","text":"everything else."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Every system type is also a "},{"type":"reference","identifier":"doc:\/\/Systems\/documentation\/Systems\/SystemSet","isActive":true},{"type":"text","text":" containing each of its systems, so ordering"},{"type":"text","text":" "},{"type":"text","text":"constraints such as "},{"type":"reference","identifier":"doc:\/\/Systems\/documentation\/Systems\/System\/after(_:)","isActive":true},{"type":"text","text":" can name it."}]}],"kind":"content"}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/systems\/system"]}],"seeAlsoSections":[{"generated":true,"title":"Essentials","anchor":"Essentials","identifiers":["doc:\/\/Systems\/documentation\/Systems\/DeclaringSystems","doc:\/\/Systems\/documentation\/Systems\/DrivingAWorldFromAnApp","doc:\/\/Systems\/documentation\/Systems\/System()"]}],"relationshipsSections":[{"title":"Inherits From","type":"inheritsFrom","identifiers":["doc:\/\/Systems\/s8SendableP","doc:\/\/Systems\/s16SendableMetatypeP","doc:\/\/Systems\/documentation\/Systems\/SystemSet"],"kind":"relationships"},{"title":"Conforming Types","type":"conformingTypes","identifiers":["doc:\/\/Systems\/documentation\/Systems\/ForwardChanges","doc:\/\/Systems\/documentation\/Systems\/ForwardEvents","