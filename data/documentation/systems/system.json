{"relationshipsSections":[{"kind":"relationships","title":"Inherits From","identifiers":["doc:\/\/Systems\/s8SendableP","doc:\/\/Systems\/s16SendableMetatypeP","doc:\/\/Systems\/documentation\/Systems\/SystemSet"],"type":"inheritsFrom"},{"kind":"relationships","type":"conformingTypes","title":"Conforming Types","identifiers":["doc:\/\/Systems\/documentation\/Systems\/ForwardChanges","doc:\/\/Systems\/documentation\/Systems\/ForwardEvents","doc:\/\/Systems\/documentation\/Systems\/UpdateEvents"]}],"seeAlsoSections":[{"generated":true,"anchor":"Essentials","title":"Essentials","identifiers":["doc:\/\/Systems\/documentation\/Systems\/DeclaringSystems","doc:\/\/Systems\/documentation\/Systems\/SchedulingSystems","doc:\/\/Systems\/documentation\/Systems\/DrivingAWorldFromAnApp","doc:\/\/Systems\/documentation\/Systems\/System()"]}],"identifier":{"url":"doc:\/\/Systems\/documentation\/Systems\/System","interfaceLanguage":"swift"},"abstract":[{"text":"A rule that reads and changes a world, run once each time its schedule runs.","type":"text"}],"topicSections":[{"anchor":"Running-a-System","title":"Running a System","identifiers":["doc:\/\/Systems\/documentation\/Systems\/System\/run(in:)","doc:\/\/Systems\/documentation\/Systems\/System\/access","doc:\/\/Systems\/documentation\/Systems\/System\/initialize(in:)"]},{"anchor":"Ordering-a-System","title":"Ordering a System","identifiers":["doc:\/\/Systems\/documentation\/Systems\/System\/after(_:)","doc:\/\/Systems\/documentation\/Systems\/System\/before(_:)","doc:\/\/Systems\/documentation\/Systems\/System\/inSet(_:)","doc:\/\/Systems\/documentation\/Systems\/System\/ambiguous(with:)"]},{"anchor":"Running-a-System-Conditionally","title":"Running a System Conditionally","identifiers":["doc:\/\/Systems\/documentation\/Systems\/System\/runIf(_:)"]}],"metadata":{"remoteSource":{"url":"https:\/\/github.com\/Tyler-Keith-Thompson\/ECS\/blob\/main\/Sources\/Systems\/System.swift#L40","fileName":"System.swift"},"fragments":[{"text":"protocol","kind":"keyword"},{"text":" ","kind":"text"},{"text":"System","kind":"identifier"}],"title":"System","symbolKind":"protocol","modules":[{"name":"Systems"}],"navigatorTitle":[{"text":"System","kind":"identifier"}],"role":"symbol","roleHeading":"Protocol","externalID":"s:7Systems6SystemP"},"schemaVersion":{"minor":3,"major":0,"patch":0},"kind":"symbol","primaryContentSections":[{"kind":"declarations","declarations":[{"languages":["swift"],"platforms":["Linux"],"tokens":[{"text":"protocol","kind":"keyword"},{"text":" ","kind":"text"},{"text":"System","kind":"identifier"},{"text":" : ","kind":"text"},{"text":"Sendable","kind":"typeIdentifier","preciseIdentifier":"s:s8SendableP"},{"text":", ","kind":"text"},{"text":"SystemSet","kind":"typeIdentifier","preciseIdentifier":"s:7Systems9SystemSetP","identifier":"doc:\/\/Systems\/documentation\/Systems\/SystemSet"}]}]},{"kind":"content","content":[{"type":"heading","text":"Overview","anchor":"overview","level":2},{"type":"paragraph","inlineContent":[{"text":"A system is one step of a frame or tick: moving everything with a velocity, applying damage,","type":"text"},{"text":" ","type":"text"},{"text":"counting the score. You put systems in a ","type":"text"},{"type":"reference","identifier":"doc:\/\/Systems\/documentation\/Systems\/Schedule","isActive":true},{"text":", which runs each of them once per run,","type":"text"},{"text":" ","type":"text"},{"text":"and at the same time as one another where it can.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"Most systems are declared with the ","type":"text"},{"type":"reference","identifier":"doc:\/\/Systems\/documentation\/Systems\/System()","isActive":true},{"text":" macro, which writes the conformance from a","type":"text"},{"text":" ","type":"text"},{"code":"run","type":"codeVoice"},{"text":" method’s parameters. Conform to ","type":"text"},{"code":"System","type":"codeVoice"},{"text":" yourself when a system needs the whole world,","type":"text"},{"text":" ","type":"text"},{"text":"for example to spawn and despawn entities directly or to reach types chosen at run time. A","type":"text"},{"text":" ","type":"text"},{"text":"conforming type implements ","type":"text"},{"type":"reference","identifier":"doc:\/\/Systems\/documentation\/Systems\/System\/run(in:)","isActive":true},{"text":" and, so that it can run alongside other systems,","type":"text"},{"text":" ","type":"text"},{"text":"declares an ","type":"text"},{"type":"reference","identifier":"doc:\/\/Systems\/documentation\/Systems\/System\/access","isActive":true},{"text":" listing what it reads and writes:","type":"text"}]},{"type":"codeListing","syntax":"swift","code":["struct Friction: System {","    var access: Access? { .writes(Velocity.self) }","","    func run(in world: inout World) {","        world.update(Velocity.self) { velocity, _ in","            velocity.dx *= 0.5","        }","    }","}","","var world = World()","let puck = world.spawn(Velocity(dx: 8, dy: 0))","Schedule { Friction() }.run(on: &world)","print(world[Velocity.self, of: puck].dx)","\/\/ Prints \"4.0\""]},{"type":"paragraph","inlineContent":[{"type":"text","text":"A system keeps no state of its own between runs. Anything it needs to remember belongs in the"},{"type":"text","text":" "},{"type":"text","text":"world, as components or resources, so it is copied, compared and restored along with"},{"type":"text","text":" "},{"type":"text","text":"everything else."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Every system type is also a "},{"type":"reference","identifier":"doc:\/\/Systems\/documentation\/Systems\/SystemSet","isActive":true},{"type":"text","text":" containing each of its systems, so ordering"},{"type":"text","text":" "},{"type":"text","text":"constraints such as "},{"type":"reference","identifier":"doc:\/\/Systems\/documentation\/Systems\/System\/after(_:)","isActive":true},{"type":"text","text":" can name it."}]}]}],"variants":[{"paths":["\/documentation\/s