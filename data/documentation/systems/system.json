{"kind":"symbol","topicSections":[{"identifiers":["doc:\/\/Systems\/documentation\/Systems\/System\/run(in:)","doc:\/\/Systems\/documentation\/Systems\/System\/access","doc:\/\/Systems\/documentation\/Systems\/System\/initialize(in:)"],"title":"Running a System","anchor":"Running-a-System"},{"identifiers":["doc:\/\/Systems\/documentation\/Systems\/System\/after(_:)","doc:\/\/Systems\/documentation\/Systems\/System\/before(_:)","doc:\/\/Systems\/documentation\/Systems\/System\/inSet(_:)","doc:\/\/Systems\/documentation\/Systems\/System\/ambiguous(with:)"],"title":"Ordering a System","anchor":"Ordering-a-System"},{"identifiers":["doc:\/\/Systems\/documentation\/Systems\/System\/runIf(_:)"],"title":"Running a System Conditionally","anchor":"Running-a-System-Conditionally"}],"relationshipsSections":[{"identifiers":["doc:\/\/Systems\/s8SendableP","doc:\/\/Systems\/s16SendableMetatypeP","doc:\/\/Systems\/documentation\/Systems\/SystemSet"],"type":"inheritsFrom","title":"Inherits From","kind":"relationships"},{"identifiers":["doc:\/\/Systems\/documentation\/Systems\/ForwardChanges","doc:\/\/Systems\/documentation\/Systems\/ForwardEvents","doc:\/\/Systems\/documentation\/Systems\/UpdateEvents"],"type":"conformingTypes","title":"Conforming Types","kind":"relationships"}],"seeAlsoSections":[{"identifiers":["doc:\/\/Systems\/documentation\/Systems\/DeclaringSystems","doc:\/\/Systems\/documentation\/Systems\/DrivingAWorldFromAnApp","doc:\/\/Systems\/documentation\/Systems\/System()"],"generated":true,"title":"Essentials","anchor":"Essentials"}],"schemaVersion":{"major":0,"minor":3,"patch":0},"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/systems\/system"]}],"metadata":{"roleHeading":"Protocol","fragments":[{"text":"protocol","kind":"keyword"},{"text":" ","kind":"text"},{"text":"System","kind":"identifier"}],"symbolKind":"protocol","role":"symbol","modules":[{"name":"Systems"}],"remoteSource":{"url":"https:\/\/github.com\/Tyler-Keith-Thompson\/ECS\/blob\/main\/Sources\/Systems\/System.swift#L40","fileName":"System.swift"},"navigatorTitle":[{"text":"System","kind":"identifier"}],"externalID":"s:7Systems6SystemP","title":"System"},"sections":[],"identifier":{"url":"doc:\/\/Systems\/documentation\/Systems\/System","interfaceLanguage":"swift"},"hierarchy":{"paths":[["doc:\/\/Systems\/documentation\/Systems"]]},"abstract":[{"type":"text","text":"A rule that reads and changes a world, run once each time its schedule runs."}],"primaryContentSections":[{"declarations":[{"tokens":[{"text":"protocol","kind":"keyword"},{"text":" ","kind":"text"},{"text":"System","kind":"identifier"},{"text":" : ","kind":"text"},{"preciseIdentifier":"s:s8SendableP","text":"Sendable","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"preciseIdentifier":"s:7Systems9SystemSetP","identifier":"doc:\/\/Systems\/documentation\/Systems\/SystemSet","text":"SystemSet","kind":"typeIdentifier"}],"platforms":["Linux"],"languages":["swift"]}],"kind":"declarations"},{"content":[{"type":"heading","level":2,"text":"Overview","anchor":"overview"},{"type":"paragraph","inlineContent":[{"text":"A system is one step of a frame or tick: moving everything with a velocity, applying damage,","type":"text"},{"text":" ","type":"text"},{"text":"counting the score. You put systems in a ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/Systems\/documentation\/Systems\/Schedule"},{"text":", which runs each of them once per run,","type":"text"},{"text":" ","type":"text"},{"text":"and at the same time as one another where it can.","type":"text"}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Most systems are declared with the "},{"type":"reference","identifier":"doc:\/\/Systems\/documentation\/Systems\/System()","isActive":true},{"type":"text","text":" macro, which writes the conformance from a"},{"type":"text","text":" "},{"code":"run","type":"codeVoice"},{"type":"text","text":" method’s parameters. Conform to "},{"code":"System","type":"codeVoice"},{"type":"text","text":" yourself when a system needs the whole world,"},{"type":"text","text":" "},{"type":"text","text":"for example to spawn and despawn entities directly or to reach types chosen at run time. A"},{"type":"text","text":" "},{"type":"text","text":"conforming type implements "},{"type":"reference","identifier":"doc:\/\/Systems\/documentation\/Systems\/System\/run(in:)","isActive":true},{"type":"text","text":" and, so that it can run alongside other systems,"},{"type":"text","text":" "},{"type":"text","text":"declares an "},{"type":"reference","identifier":"doc:\/\/Systems\/documentation\/Systems\/System\/access","isActive":true},{"type":"text","text":" listing what it reads and writes:"}]},{"syntax":"swift","type":"codeListing","code":["struct Friction: System {","    var access: Access? { .writes(Velocity.self) }","","    func run(in world: inout World) {","        world.update(Velocity.self) { velocity, _ in","            velocity.dx *= 0.5","        }","    }","}","","var world = World()","let puck = world.spawn(Velocity(dx: 8, dy: 0))","Schedule { Friction() }.run(on: &world)","print(world[Velocity.self, of: puck].dx)","\/\/ Prints \"4.0\""]},{"type":"paragraph","inlineContent":[{"type":"text","text":"A system keeps no state of its own between runs. Anything it needs to remember belongs in the"},{"type":"text","text":" "},{"type":"text","text":"world, as components or resources, so it is copied, compared and restored along with"},{"type":"text","text":" "},{"type":"text","text":"everything else."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Every system type is also a "},{"isActive":true,"type":"reference","identifier":"doc:\/\/Systems\/documentation\/Systems\/SystemSet"},{"type":"text","text":" containing each of its systems, so ordering"},{"type":"text","text":" "},{"type":"text","text":"constraints such as "},{"isActive":true,"type":"reference","identifier":"doc:\/\/Systems\/documentation\/Systems\/System\/after(_:)"},{"type":"text","text":" can name it."}]}],"kind":"content"}],"references":{"doc://Systems/documentation/Systems/DeclaringSystems":{"identifier":"doc:\/\/Systems\/documentation\/Systems\/DeclaringSystems","kind":"article","type":"topic","title":"Declaring Systems","role":"collectionGroup","abstract":[{"text":"Write the rules of a simulation as systems, and let their parameters state what they read and","type":"text"},{"text":" ","type":"text"},{"text":"write.","type":"text"}],"url":"\/documentation\/systems\/declaringsystems"},"doc://Systems/documentation/Systems/System/ambiguous(with:)":{"kind":"symbol","url":"\/documentation\/systems\/system\/ambiguous(with:)","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"ambiguous","kind":"identifier"},{"text":"<each ","kind":"text"},{"kind":"genericParameter","text":"S"},{"kind":"text","text":">("},{"kind":"externalParam","text":"with"},{"kind":"text","text":": repeat (each "},{"kind":"typeIdentifier","text":"S"},{"kind":"text","text":").Type) -> "},{"kind":"typeIdentifier","text":"ScheduledSystem","preciseIdentifier":"s:7Systems15ScheduledSystemV"}],"role":"symbol","type":"topic","title":"ambiguous(with:)","abstract":[{"text":"Returns this system, free to run in either order with every system in each of the given","type":"text"},{"text":" ","type":"text"},{"text":"sets.","type":"text"}],"identifier":"doc:\/\/Systems\/documentation\/Systems\/System\/ambiguous(with:)"},"doc://Systems/documentation/Systems/System/run(in:)":{"required":true,"kind":"symbol","url":"\/documentation\/systems\/system\/run(in:)","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"run"},{"kind":"text","text":"("},{"kind":"externalParam","text":"in"},{"kind":"text","text":": "},{"text":"inout","kind":"keyword"},{"text":" ","kind":"text"},{"preciseIdentifier":"s:11WorldModule0A0V","text":"World","kind":"typeIdentifier"},{"text":")","kind":"text"}],"role"