ss comes from the parameters of its ","type":"text"},{"code":"run","type":"codeVoice"},{"text":" method.","type":"text"}],"type":"topic","identifier":"doc:\/\/Systems\/documentation\/Systems\/System()","title":"System()","role":"symbol","url":"\/documentation\/systems\/system()","kind":"symbol"},"doc://Systems/documentation/Systems/Schedule":{"role":"symbol","navigatorTitle":[{"text":"Schedule","kind":"identifier"}],"url":"\/documentation\/systems\/schedule","type":"topic","title":"Schedule","abstract":[{"type":"text","text":"A list of systems that run on a world, in order, and at the same time where they can."}],"fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Schedule","kind":"identifier"}],"identifier":"doc:\/\/Systems\/documentation\/Systems\/Schedule","kind":"symbol"},"doc://Systems/documentation/Systems/System/access":{"fragments":[{"kind":"keyword","text":"var"},{"kind":"text","text":" "},{"text":"access","kind":"identifier"},{"text":": ","kind":"text"},{"text":"Access","preciseIdentifier":"s:11WorldModule6AccessV","kind":"typeIdentifier"},{"text":"?","kind":"text"}],"kind":"symbol","identifier":"doc:\/\/Systems\/documentation\/Systems\/System\/access","title":"access","url":"\/documentation\/systems\/system\/access","type":"topic","role":"symbol","abstract":[{"type":"text","text":"The component, resource and event types the system reads and writes, or "},{"type":"codeVoice","code":"nil"},{"type":"text","text":" if it may"},{"type":"text","text":" "},{"type":"text","text":"change anything."}],"defaultImplementations":1,"required":true},"doc://Systems/documentation/Systems/System/run(in:)":{"fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"run"},{"kind":"text","text":"("},{"kind":"externalParam","text":"in"},{"kind":"text","text":": "},{"kind":"keyword","text":"inout"},{"kind":"text","text":" "},{"preciseIdentifier":"s:11WorldModule0A0V","kind":"typeIdentifier","text":"World