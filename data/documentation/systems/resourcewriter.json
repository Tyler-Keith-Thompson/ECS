{"schemaVersion":{"minor":3,"major":0,"patch":0},"sections":[],"primaryContentSections":[{"kind":"declarations","declarations":[{"tokens":[{"kind":"keyword","text":"final"},{"kind":"text","text":" "},{"kind":"keyword","text":"class"},{"kind":"text","text":" "},{"kind":"identifier","text":"ResourceWriter"},{"kind":"text","text":"<"},{"kind":"genericParameter","text":"R"},{"kind":"text","text":"> "},{"kind":"keyword","text":"where"},{"kind":"text","text":" "},{"kind":"typeIdentifier","text":"R"},{"kind":"text","text":" : "},{"kind":"typeIdentifier","text":"Resource","identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/Resource","preciseIdentifier":"s:11WorldModule8ResourceP"}],"platforms":["Linux"],"languages":["swift"]}]},{"kind":"content","content":[{"type":"heading","level":2,"anchor":"overview","text":"Overview"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Change the resource through "},{"isActive":true,"type":"reference","identifier":"doc:\/\/Systems\/documentation\/Systems\/ResourceWriter\/value"},{"type":"text","text":"; the changes are kept in the world when the system"},{"type":"text","text":" "},{"type":"text","text":"finishes. The following system scores a point for each entity at or below the ground:"}]},{"type":"codeListing","code":["@System","struct Scoring {","    func run(_ positions: Query<Position>, _ score: ResourceWriter<Score>) {","        for (_, position) in positions where position.y <= 0 {","            score.value.points += 1","        }","    }","}","","var world = World()","world.resources.insert(Score(points: 0))","world.spawn(Position(x: 0, y: 0))","world.spawn(Position(x: 5, y: -2))","world.spawn(Position(x: 9, y: 40))","Schedule { Scoring() }.run(on: &world)","print(world.resources[Score.self].points)","\/\/ Prints \"2\""],"syntax":"swift"},{"type":"aside","style":"important","content":[{"type":"paragraph","inlineContent":[{"text":"The world must hold the resource when the system runs.","type":"text"}]}],"name":"Important"}]}],"topicSections":[{"title":"Instance Properties","generated":true,"identifiers":["doc:\/\/Systems\/documentation\/Systems\/ResourceWriter\/value"],"anchor":"Instance-Properties"}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/systems\/resourcewriter"]}],"identifier":{"url":"doc:\/\/Systems\/documentation\/Systems\/ResourceWriter","interfaceLanguage":"swift"},"metadata":{"roleHeading":"Class","fragments":[{"kind":"keyword","text":"class"},{"kind":"text","text":" "},{"kind":"identifier","text":"ResourceWriter"}],"remoteSource":{"url":"https:\/\/github.com\/Tyler-Keith-Thompson\/ECS\/blob\/main\/Sources\/Systems\/SystemParameters.swift#L168","fileName":"SystemParameters.swift"},"symbolKind":"class","title":"ResourceWriter","role":"symbol","navigatorTitle":[{"text":"ResourceWriter","kind":"identifier"}],"modules":[{"name":"Systems"}],"externalID":"s:7Systems14ResourceWriterC"},"relationshipsSections":[{"kind":"relationships","type":"conformsTo","title":"Conforms To","identifiers":["doc:\/\/Systems\/s8SendableP","doc:\/\/Systems\/s16SendableMetatypeP","doc:\/\/Systems\/documentation\/Systems\/SystemParameter"]}],"hierarchy":{"paths":[["doc:\/\/Systems\/documentation\/Systems"]]},"seeAlsoSections":[{"title":"System Parameters","generated":true,"identifiers":["doc:\/\/Systems\/documentation\/Systems\/SystemParameter","doc:\/\/Systems\/documentation\/Systems\/Update","doc:\/\/Systems\/documentation\/Systems\/ResourceReader","doc:\/\/Systems\/documentation\/Systems\/EventReader","doc:\/\/Systems\/documentation\/Systems\/EventWriter","doc:\/\/Systems\/documentation\/Systems\/RemovedComponents"],"anchor":"System-Parameters"}],"kind":"symbol","abstract":[{"text":"A system parameter that reads and writes a resource.","type":"text"}],"references":{"doc://Systems/s16SendableMetatypeP":{"type":"unresolvable","title":"Swift.SendableMetatype","identifier":"doc:\/\/Systems\/s16SendableMetatypeP"},"doc://Systems/documentation/Systems":