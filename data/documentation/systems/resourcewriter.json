{"primaryContentSections":[{"kind":"declarations","declarations":[{"tokens":[{"kind":"keyword","text":"final"},{"kind":"text","text":" "},{"kind":"keyword","text":"class"},{"kind":"text","text":" "},{"kind":"identifier","text":"ResourceWriter"},{"kind":"text","text":"<"},{"kind":"genericParameter","text":"R"},{"kind":"text","text":"> "},{"kind":"keyword","text":"where"},{"kind":"text","text":" "},{"kind":"typeIdentifier","text":"R"},{"kind":"text","text":" : "},{"identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/Resource","kind":"typeIdentifier","text":"Resource","preciseIdentifier":"s:11WorldModule8ResourceP"}],"platforms":["Linux"],"languages":["swift"]}]},{"content":[{"level":2,"type":"heading","text":"Overview","anchor":"overview"},{"inlineContent":[{"type":"text","text":"Change the resource through "},{"isActive":true,"identifier":"doc:\/\/Systems\/documentation\/Systems\/ResourceWriter\/value","type":"reference"},{"type":"text","text":"; the changes are kept in the world when the system"},{"type":"text","text":" "},{"type":"text","text":"finishes. The following system scores a point for each entity at or below the ground:"}],"type":"paragraph"},{"syntax":"swift","code":["@System","struct Scoring {","    func run(_ positions: Query<Position>, _ score: ResourceWriter<Score>) {","        for (_, position) in positions where position.y <= 0 {","            score.value.points += 1","        }","    }","}","","var world = World()","world.resources.insert(Score(points: 0))","world.spawn(Position(x: 0, y: 0))","world.spawn(Position(x: 5, y: -2))","world.spawn(Position(x: 9, y: 40))","Schedule { Scoring() }.run(on: &world)","print(world.resources[Score.self].points)","\/\/ Prints \"2\""],"type":"codeListing"},{"content":[{"inlineContent":[{"type":"text","text":"The world must hold the resource when the system runs."}],"type":"paragraph"}],"type":"aside","name":"Important","style":"important"}],"kind":"content"}],"hierarchy":{"paths":[["doc:\/\/Systems\/docu