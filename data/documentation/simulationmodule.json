{"topicSections":[{"title":"Simulations","identifiers":["doc:\/\/SimulationModule\/documentation\/SimulationModule\/Simulation","doc:\/\/SimulationModule\/documentation\/SimulationModule\/ScheduleLabel","doc:\/\/SimulationModule\/documentation\/SimulationModule\/NonPositiveDuration"],"anchor":"Simulations"},{"title":"Time","identifiers":["doc:\/\/SimulationModule\/documentation\/SimulationModule\/Time","doc:\/\/SimulationModule\/documentation\/SimulationModule\/FixedTime"],"anchor":"Time"},{"title":"States","identifiers":["doc:\/\/SimulationModule\/documentation\/SimulationModule\/States","doc:\/\/SimulationModule\/documentation\/SimulationModule\/CurrentState","doc:\/\/SimulationModule\/documentation\/SimulationModule\/NextState","doc:\/\/SimulationModule\/documentation\/SimulationModule\/inState(_:)"],"anchor":"States"}],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/SimulationModule\/documentation\/SimulationModule"},"hierarchy":{"paths":[[]]},"primaryContentSections":[{"kind":"content","content":[{"text":"Overview","anchor":"Overview","type":"heading","level":2},{"inlineContent":[{"text":"A ","type":"text"},{"identifier":"doc:\/\/SimulationModule\/documentation\/SimulationModule\/Simulation","type":"reference","isActive":true},{"text":" owns a world and a set of schedules, each named by a ","type":"text"},{"identifier":"doc:\/\/SimulationModule\/documentation\/SimulationModule\/ScheduleLabel","type":"reference","isActive":true},{"text":". You add","type":"text"},{"text":" ","type":"text"},{"text":"systems to the schedules by label, then call ","type":"text"},{"identifier":"doc:\/\/SimulationModule\/documentation\/SimulationModule\/Simulation\/update(elapsed:)","type":"reference","isActive":true},{"text":" once a frame with the","type":"text"},{"text":" ","type":"text"},{"text":"time that passed. The simulation decides which schedules run:","type":"text"}],"type":"paragraph"},{"items":[{"content":[{"inlineContent":[{"type":"reference","identifier":"doc:\/\/SimulationModule\/documentation\/SimulationModule\/ScheduleLabel\/startup","isActive":true},{"type":"text","text":" runs once, before the first frame."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"reference","identifier":"doc:\/\/SimulationModule\/documentation\/SimulationModule\/ScheduleLabel\/fixedUpdate","isActive":true},{"type":"text","text":" runs once for every fixed timestep of time that has passed, so"},{"type":"text","text":" "},{"type":"text","text":"physics and other rate-sensitive rules advance by the same amount each run, however uneven the"},{"type":"text","text":" "},{"type":"text","text":"frames are."}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"identifier":"doc:\/\/SimulationModule\/documentation\/SimulationModule\/ScheduleLabel\/update","isActive":true,"type":"reference"},{"text":" runs once a frame.","type":"text"}]}]}],"type":"unorderedList"},{"inlineContent":[{"type":"text","text":"The examples throughout this module use these components, resources and systems:"}],"type":"paragraph"},{"code":["struct Position: Component { var x: Double }","struct Velocity: Component { var dx: Double }","struct FixedSteps: Resource { var count = 0 }","enum GameState: States { case menu, playing, paused }","","\/\/\/ Moves each entity by its velocity over one fixed timestep.","@System","struct Physics {","    func run(_ movers: Update<Position>.Over<Velocity>, _ fixedTime: ResourceReader<FixedTime>) {","        let seconds = fixedTime.value.timestep \/ .seconds(1)","        movers { position, row in","            position.x += row.components.dx * seconds","        }","    }","}","","\/\/\/ Counts the runs of the schedule it is in.","@System","struct CountSteps {","    func run(_ steps: ResourceWriter<FixedSteps>) {","        steps.value.count += 1","    }","}","","\/\/\/ Spawns a ball at the origin.","@System","struct SpawnBall {","    func run(commands: inout Commands) {","        commands.spawn(Position(x: 0), Velocity(dx: 64))","    }","}"],"syntax":"swift","type":"codeListing"},{"inlineContent":[{"type":"text","text":"The following example runs "},{"code":"Physics","type":"codeVoice"},{"type":"text","text":" on a fixed timestep of 1\/64 second, the default. A frame"},{"type":"text","text":" "},{"type":"text","text":"of 50 milliseconds covers three whole timesteps, so the ball moves three times:"}],"type":"paragraph"},{"code":["var world = World()","let ball = world.spawn(Position(x: 0), Velocity(dx: 64))","","var simulation = Simulation(world)","simulation.add(to: .fixedUpdate) { Physics() }","simulation.update(elapsed: .milliseconds(50))","","print(simulation.world[Position.self, of: ball])","\/\/ Prints \"Position(x: 3.0)\""],"syntax":"swift","type":"codeListing"},{"text":"States","anchor":"States","type":"heading","level":3},{"inlineContent":[{"text":"A state type is a type, usually an enumeration, that conforms to ","type":"text"},{"isActive":true,"identifier":"doc:\/\/SimulationModule\/documentation\/SimulationModule\/States","type":"reference"},{"text":": the screens of a","type":"text"},{"text":" ","type":"text"},{"text":"game, or the phases of a simulation. Add one to a simulation with","type":"text"},{"text":" ","type":"text"},{"isActive":true,"identifier":"doc:\/\/SimulationModule\/documentation\/SimulationModule\/Simulation\/add(state:)","type":"reference"},{"text":". The simulation keeps the current state in the ","type":"text"},{"isActive":true,"identifier":"doc:\/\/SimulationModule\/documentation\/SimulationModule\/CurrentState","type":"reference"},{"text":" ","type":"text"},{"text":"resource; to change it, a system sets ","type":"text"},{"isActive":true,"identifier":"doc:\/\/SimulationModule\/documentation\/SimulationModule\/NextState","type":"reference"},{"text":", and the change applies at the start of the","type":"text"},{"text":" ","type":"text"},{"text":"next frame. Entering, leaving and moving between states run schedules of their own,","type":"text"},{"text":" ","type":"text"},{"isActive":true,"identifier":"doc:\/\/SimulationModule\/documentation\/SimulationModule\/ScheduleLabel\/onEnter(_:)","type":"reference"},{"text":", ","type":"text"},{"isActive":true,"identifier":"doc:\/\/SimulationModule\/documentation\/SimulationModule\/ScheduleLabel\/onExit(_:)","type":"reference"},{"text":" and","type":"text"},{"text":" ","type":"text"},{"isActive":true,"identifier":"doc:\/\/SimulationModule\/documentation\/SimulationModule\/ScheduleLabel\/onTransition(from:to:)","type":"reference"},{"text":", and ","type":"text"},{"isActive":true,"identifier":"doc:\/\/SimulationModule\/documentation\/SimulationModule\/inState(_:)","type":"reference"},{"text":" makes a run condition that holds","type":"text"},{"text":" ","type":"text"},{"text":"only in one state.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"The following example spawns a ball on entering the "},{"type":"codeVoice","code":"playing"},{"type":"text","text":" state and moves it only while the"},{"type":"text","text":" "},{"type":"text","text":"game is in that state:"}],"type":"paragraph"},{"code":["var simulation = Simulation()","simulation.add(state: GameState.menu)","simulation.add(to: .onEnter(GameState.playing)) { SpawnBall() }","simulation.add(to: .fixedUpdate) { Physics().runIf(inState(GameState.playing)) }","","simulation.update(elapsed: .milliseconds(50))","print(simulation.world.count)","\/\/ Prints \"0\"","","simulation.world.resources[NextState<GameState>.self].set(.playing)","simulation.update(elapsed: .milliseconds(50))","print(simulation.world.resources[CurrentState<GameState>.self].state)","\/\/ Prints \"playing\"","for (_, position) in simulation.world.query(Position.self) {","    print(position)  \/\/ Prints \"Position(x: 3.0)\"","}"],"syntax":"swift","type":"codeListing"}]}],"schemaVersion":{"major":0,"patch":0,"minor":3},"metadata":{"modules":[{"name":"SimulationModule"}],"role":"collection","title":"SimulationModule","externalID":"SimulationModule","roleHeading":"Framework","symbolKind":"module"},"kind":"symbol","sections":[],"abstract":[{"type":"text","text":"Run a world frame by frame, with schedules for startup, a fixed timestep and each frame, and"},{"type":"text","text":" "},{"type":"text","text":"with states that switch systems on and off."}],"variants":[{"paths":["\/documentation\/simulationmodule"],"traits":[{"interfaceLanguage":"swift"}]}],"references":{"doc://SimulationModule/documentation/SimulationModule/ScheduleLabel/startup":{"title":"startup","kind":"symbol","url":"\/documentation\/simulationmodule\/schedulelabel\/startup","fragments":[{"kind":"keyword","text":"static"},{"kind":"text","text":" "},{"kind":"keyword","text":"let"},{"kind":"text","text":" "},{"kind":"identifier","text":"startup"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:16SimulationModule13ScheduleLabelV","text":"ScheduleLabel"}],"identifier":"doc:\/\/SimulationModule\/documentation\/SimulationModule\/ScheduleLabel\/startup","role":"symbol","type":"topic","abstract":[{"type":"text","text":"The label of the schedule that runs once, before the first frame."}]},"doc://SimulationModule/documentation/SimulationModule":{"title":"SimulationModule","kind":"symbol","url":"\/documentation\/simulationmodule","identifier":"doc:\/\/SimulationModule\/documentation\/SimulationModule","role":"collection","type":"topic","abstract":[{"text":"Run a world frame by frame, with schedules for startup, a fixed timestep and each frame, and","type":"text"},{"text":" ","type":"text"},{"text":"with states that switch systems on and off.","type":"text"}]},"doc://SimulationModule/documentation/SimulationModule/NonPositiveDuration":{"fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"NonPositiveDuration"}],"type":"topic","title":"NonPositiveDuration","url":"\/documentation\/simulationmodule\/nonpositiveduration","identifier":"doc:\/\/SimulationModule\/documentation\/SimulationModule\/NonPositiveDuration","abstract":[{"text":"An error that indicates a simulation’s fixed timestep or maximum frame time is zero or","type":"text"},{"text":" ","type":"text"},{"text":"negative.","type":"text"}],"kind":"symbol","role":"symbol","navigatorTitle":[{"kind":"identifier","text":"NonPositiveDuration"}]},"doc://SimulationModule/documentation/SimulationModule/Simulation":{"navigatorTitle":[{"kind":"identifier","text":"Simulation"}],"title":"Simulation","kind":"symbol","url":"\/documentation\/simulationmodule\/simulation","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"Simulation"}],"identifier":"doc:\/\/SimulationModule\/documentation\/SimulationModule\/Simulation","role":"symbol","type":"topic","abstract":[{"text":"A world and its schedules by label, advanced one frame at a time.","type":"text"}]},"doc://SimulationModule/documentation/SimulationModule/ScheduleLabel/onEnter(_:)":{"fragments":[{"kind":"keyword","text":"static"},{"kind":"text","text":" "},{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"onEnter"},{"kind":"text","text":"<"},{"kind":"genericParameter","text":"S"},{"kind":"text","text":">("},{"kind":"typeIdentifier","text":"S"},{"kind":"text","text":") -> "},{"preciseIdentifier":"s:16SimulationModule13ScheduleLabelV","kind":"typeIdentifier","text":"ScheduleLabel"}],"type":"topic","url":"\/documentation\/simulationmodule\/schedulelabel\/onenter(_:)","title":"onEnter(_:)","identifier":"doc:\/\/SimulationModule\/documentation\/SimulationModule\/ScheduleLabel\/onEnter(_:)","abstract":[{"type":"text","text":"Returns the label of the schedule that runs when a simulation enters the given state."}],"kind":"symbol","role":"symbol"},"doc://SimulationModule/documentation/SimulationModule/NextState":{"identifier":"doc:\/\/SimulationModule\/documentation\/SimulationModule\/NextState","type":"topic","title":"NextState","url":"\/doc