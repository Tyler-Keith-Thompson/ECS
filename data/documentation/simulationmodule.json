ext":"S","kind":"typeIdentifier"},{"text":") -> ","kind":"text"},{"text":"ScheduleLabel","kind":"typeIdentifier","preciseIdentifier":"s:16SimulationModule13ScheduleLabelV"}],"kind":"symbol","url":"\/documentation\/simulationmodule\/schedulelabel\/onexit(_:)","type":"topic"},"doc://SimulationModule/documentation/SimulationModule/inState(_:)":{"identifier":"doc:\/\/SimulationModule\/documentation\/SimulationModule\/inState(_:)","type":"topic","role":"symbol","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"inState","kind":"identifier"},{"text":"<","kind":"text"},{"text":"S","kind":"genericParameter"},{"text":">(","kind":"text"},{"text":"S","kind":"typeIdentifier"},{"text":") -> (","kind":"text"},{"text":"World","kind":"typeIdentifier","preciseIdentifier":"s:11WorldModule0A0V"},{"text":") -> ","kind":"text"},{"text":"Bool","kind":"typeIdentifier","preciseIdentifier":"s:Sb"}],"abstract":[{"type":"text","text":"Returns a run condition that holds when a world’s current state is the given state."}],"title":"inState(_:)","url":"\/documentation\/simulationmodule\/instate(_:)","kind":"symbol"},"doc://SimulationModule/documentation/SimulationModule/NextState":{"navigatorTitle":[{"text":"NextState","kind":"identifier"}],"abstract":[{"text":"A resource holding the state a simulation enters at the start of its next frame.","type":"text"}],"fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"NextState","kind":"identifier"}],"title":"NextState","identifier":"doc:\/\/SimulationModule\/documentation\/SimulationModule\/NextState","role":"symbol","kind":"symbol","type":"topic","url":"\/documentation\/simulationmodule\/nextstate"},"doc://SimulationModule/documentation/SimulationModule/ScheduleLabel/fixedUpdate":{"identifier":"doc:\/\/SimulationModule\/documentation\/SimulationModule\/ScheduleLabel\/fixedUpdate","type":"topic","role":"symbol","fragments":[{"text":"static","kind":"keyword"},{"text":" ","kind":"text"},{"text":