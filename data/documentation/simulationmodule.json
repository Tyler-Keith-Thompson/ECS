":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"add","kind":"identifier"},{"text":"<","kind":"text"},{"text":"S","kind":"genericParameter"},{"text":">(","kind":"text"},{"text":"state","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"S","kind":"typeIdentifier"},{"text":")","kind":"text"}],"type":"topic","url":"\/documentation\/simulationmodule\/simulation\/add(state:)","title":"add(state:)","identifier":"doc:\/\/SimulationModule\/documentation\/SimulationModule\/Simulation\/add(state:)","abstract":[{"text":"Adds a state type to the simulation, starting in the given state.","type":"text"}],"kind":"symbol","role":"symbol"},"doc://SimulationModule/documentation/SimulationModule/ScheduleLabel/fixedUpdate":{"fragments":[{"kind":"keyword","text":"static"},{"kind":"text","text":" "},{"kind":"keyword","text":"let"},{"kind":"text","text":" "},{"kind":"identifier","text":"fixedUpdate"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:16SimulationModule13ScheduleLabelV","text":"ScheduleLabel"}],"type":"topic","title":"fixedUpdate","url":"\/documentation\/simulationmodule\/schedulelabel\/fixedupdate","identifier":"doc:\/\/SimulationModule\/documentation\/SimulationModule\/ScheduleLabel\/fixedUpdate","abstract":[{"type":"text","text":"The label of the schedule that runs once for each fixed timestep of elapsed time."}],"kind":"symbol","role":"symbol"},"doc://SimulationModule/documentation/SimulationModule/ScheduleLabel/update":{"title":"update","kind":"symbol","url":"\/documentation\/simulationmodule\/schedulelabel\/update","fragments":[{"kind":"keyword","text":"static"},{"kind":"text","text":" "},{"kind":"keyword","text":"let"},{"kind":"text","text":" "},{"kind":"identifier","text":"update"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:16SimulationModule13ScheduleLabelV","text":"ScheduleLabel"}],"identifier":"doc:\/\/SimulationModule\/documentation\/SimulationModule\/ScheduleLabel\/update","role":"symbol","type":"topic","abstract":[{"type":"text","text":"The label of the schedule that runs once a frame."}]},"doc://SimulationModule/documentation/SimulationModule/States":{"fragments":[{"text":"protocol","kind":"keyword"},{"text":" ","kind":"text"},{"text":"States","kind":"identifier"}],"type":"topic","url":"\/documentation\/simulationmodule\/states","title":"States","identifier":"doc:\/\/SimulationModule\/documentation\/SimulationModule\/States","abstract":[{"text":"A type whose values are the states a simulation can be in.","type":"text"}],"kind":"symbol","role":"symbol","navigatorTitle":[{"text":"States","kind":"identifier"}]},"doc://SimulationModule/documentation/SimulationModule/CurrentState":{"navigatorTitle":[{"kind":"identifier","text":"CurrentState"}],"title":"CurrentState","kind":"symbol","url":"\/documentation\/simulationmodule\/currentstate","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"CurrentState"}],"identifier":"doc:\/\/SimulationModule\/documentation\/SimulationModule\/CurrentState","role":"symbol","type":"topic","abstract":[{"text":"A resource holding the state a simulation is in.","type":"text"}]},"doc://SimulationModule/documentation/SimulationModule/ScheduleLabel/onExit(_:)":{"title":"onExit(_:)","kind":"symbol","url":"\/documentation\/simulationmodule\/schedulelabel\/onexit(_:)","fragments":[{"kind":"keyword","text":"static"},{"kind":"text","text":" "},{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"onExit"},{"kind":"text","text":"<"},{"kind":"genericParameter","text":"S"},{"kind":"text","text":">("},{"kind":"typeIdentifier","text":"S"},{"kind":"text","text":") -> "},{"kind":"typeIdentifier","preciseIdentifier":"s:16SimulationModule13ScheduleLabelV","text":"ScheduleLabel"}],"identifier":"doc:\/\/SimulationModule\/documentation\/SimulationModule\/ScheduleLabel\/onExit(_:)","role":"symbol","type":"topic","abstract":[{"type":"text","text":"Returns the label of the schedule that runs when a simulation leaves the given state."}]},"doc://SimulationModule/documentation/SimulationModule/inState(_:)":{"title":"inState(_:)","kind":"symbol","url":"\/documentation\/simulationmodule\/instate(_:)","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"inState"},{"kind":"text","text":"<"},{"kind":"genericParameter","text":"S"},{"kind":"text","text":">("},{"kind":"typeIdentifier","text":"S"},{"kind":"text","text":") -> ("},{"kind":"typeIdentifier","preciseIdentifier":"s:11WorldModule0A0V","text":"World"},{"kind":"text","text":") -> "},{"kind":"typeIdentifier","preciseIdentifier":"s:Sb","text":"Bool"}],"identifier":"doc:\/\/SimulationModule\/documentation\/SimulationModule\/inState(_:)","role":"symbol","type":"topic","abstract":[{"type":"text","text":"Returns a run condition that holds when a world’s current state is the given state."}]}}}