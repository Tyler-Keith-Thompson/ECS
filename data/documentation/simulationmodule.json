ifier":"s:16SimulationModule13ScheduleLabelV","text":"ScheduleLabel"}],"abstract":[{"type":"text","text":"Returns the label of the schedule that runs when a simulation changes from one given state"},{"type":"text","text":" "},{"type":"text","text":"to another."}],"title":"onTransition(from:to:)","url":"\/documentation\/simulationmodule\/schedulelabel\/ontransition(from:to:)","kind":"symbol"},"doc://SimulationModule/documentation/SimulationModule/Simulation":{"navigatorTitle":[{"text":"Simulation","kind":"identifier"}],"abstract":[{"type":"text","text":"A world and its schedules by label, advanced one frame at a time."}],"fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Simulation","kind":"identifier"}],"title":"Simulation","identifier":"doc:\/\/SimulationModule\/documentation\/SimulationModule\/Simulation","role":"symbol","kind":"symbol","type":"topic","url":"\/documentation\/simulationmodule\/simulation"}}}