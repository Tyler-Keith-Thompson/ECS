e type to the simulation, starting in the given state.","type":"text"}],"role":"symbol","url":"\/documentation\/simulationmodule\/simulation\/add(state:)"},"doc://SimulationModule/documentation/SimulationModule/Simulation":{"navigatorTitle":[{"text":"Simulation","kind":"identifier"}],"url":"\/documentation\/simulationmodule\/simulation","role":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Simulation","kind":"identifier"}],"type":"topic","kind":"symbol","identifier":"doc:\/\/SimulationModule\/documentation\/SimulationModule\/Simulation","title":"Simulation","abstract":[{"type":"text","text":"A world and its schedules by label, advanced one frame at a time."}]},"doc://SimulationModule/documentation/SimulationModule/ScheduleLabel/fixedUpdate":{"abstract":[{"type":"text","text":"The label of the schedule that runs once for each fixed timestep of elapsed time."}],"kind":"symbol","role":"symbol","identifier":"doc:\/\/SimulationModule\/documentation\/SimulationModule\/ScheduleLabel\/fixedUpdate","type":"topic","title":"fixedUpdate","url":"\/documentation\/simulationmodule\/schedulelabel\/fixedupdate","fragments":[{"text":"static","kind":"keyword"},{"text":" ","kind":"text"},{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"fixedUpdate","kind":"identifier"},{"text":": ","kind":"text"},{"text":"ScheduleLabel","preciseIdentifier":"s:16SimulationModule13ScheduleLabelV","kind":"typeIdentifier"}]},"doc://SimulationModule/documentation/SimulationModule/Simulation/update(elapsed:)":{"url":"\/documentation\/simulationmodule\/simulation\/update(elapsed:)","role":"symbol","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"update","kind":"identifier"},{"text":"(","kind":"text"},{"text":"elapsed","kind":"externalParam"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:s8DurationV","kind":"typeIdentifier","text":"Duration"},{"kind":"text","text":")"}],"type":"topic","kind":"symbol","identifier":"doc:\/\/SimulationModule\/documentation\/SimulationModule\/Simulation\/update(elapsed:)","title":"update(elapsed:)","abstract":[{"type":"text","text":"Advances the simulation by one frame."}]},"doc://SimulationModule/documentation/SimulationModule/ScheduleLabel/update":{"url":"\/documentation\/simulationmodule\/schedulelabel\/update","role":"symbol","fragments":[{"kind":"keyword","text":"static"},{"kind":"text","text":" "},{"kind":"keyword","text":"let"},{"kind":"text","text":" "},{"kind":"identifier","text":"update"},{"kind":"text","text":": "},{"preciseIdentifier":"s:16SimulationModule13ScheduleLabelV","text":"ScheduleLabel","kind":"typeIdentifier"}],"type":"topic","kind":"symbol","identifier":"doc:\/\/SimulationModule\/documentation\/SimulationModule\/ScheduleLabel\/update","title":"update","abstract":[{"type":"text","text":"The label of the schedule that runs once a frame."}]},"doc://SimulationModule/documentation/SimulationModule/Time":{"identifier":"doc:\/\/SimulationModule\/documentation\/SimulationModule\/Time","type":"topic","navigatorTitle":[{"text":"Time","kind":"identifier"}],"kind":"symbol","title":"Time","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Time","kind":"identifier"}],"abstract":[{"text":"A resource holding the time a simulation has advanced.","type":"text"}],"role":"symbol","url":"\/documentation\/simulationmodule\/time"},"doc://SimulationModule/documentation/SimulationModule/NextState":{"navigatorTitle":[{"kind":"identifier","text":"NextState"}],"url":"\/documentation\/simulationmodule\/nextstate","role":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"NextState"}],"type":"topic","kind":"symbol","identifier":"doc:\/\/SimulationModule\/documentation\/SimulationModule\/NextState","title":"NextState","abstract":[{"text":"A resource holding the state a simulation enters at the start of its next frame.","type":"text"}]},"doc://SimulationModule/documentation/SimulationModule/NonPositiveDuration":{"navigatorTitle":[{"text":"NonPositiveDuration","kind":"identifier"}],"url":"\/documentation\/simulationmodule\/nonpositiveduration","role":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"NonPositiveDuration","kind":"identifier"}],"type":"topic","kind":"symbol","identifier":"doc:\/\/SimulationModule\/documentation\/SimulationModule\/NonPositiveDuration","title":"NonPositiveDuration","abstract":[{"text":"An error that indicates a simulation’s fixed timestep or maximum frame time is zero or","type":"text"},{"text":" ","type":"text"},{"text":"negative.","type":"text"}]},"doc://SimulationModule/documentation/SimulationModule/ScheduleLabel/onExit(_:)":{"url":"\/documentation\/simulationmodule\/schedulelabel\/onexit(_:)","role":"symbol","fragments":[{"kind":"keyword","text":"static"},{"kind":"text","text":" "},{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"onExit"},{"kind":"text","text":"<"},{"kind":"genericParameter","text":"S"},{"kind":"text","text":">("},{"kind":"typeIdentifier","text":"S"},{"kind":"text","text":") -> "},{"kind":"typeIdentifier","preciseIdentifier":"s:16SimulationModule13ScheduleLabelV","text":"ScheduleLabel"}],"type":"topic","kind":"symbol","identifier":"doc:\/\/SimulationModule\/documentation\/SimulationModule\/ScheduleLabel\/onExit(_:)","title":"onExit(_:)","abstract":[{"text":"Returns the label of the schedule that runs when a simulation leaves the given state.","type":"text"}]},"doc://SimulationModule/documentation/SimulationModule/inState(_:)":{"url":"\/documentation\/simulationmodule\/instate(_:)","role":"symbol","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"inState","kind":"identifier"},{"text":"<","kind":"text"},{"text":"S","kind":"genericParameter"},{"text":">(","kind":"text"},{"kind":"typeIdentifier","text":"S"},{"kind":"text","text":") -> ("},{"kind":"typeIdentifier","preciseIdentifier":"s:11WorldModule0A0V","text":"World"},{"kind":"text","text":") -> "},{"kind":"typeIdentifier","preciseIdentifier":"s:Sb","text":"Bool"}],"type":"topic","kind":"symbol","identifier":"doc:\/\/SimulationModule\/documentation\/SimulationModule\/inState(_:)","title":"inState(_:)","abstract":[{"type":"text","text":"Returns a run condition that holds when a world’s current state is the given state."}]},"doc://SimulationModule/documentation/SimulationModule/States":{"navigatorTitle":[{"text":"States","kind":"identifier"}],"url":"\/documentation\/simulationmodule\/states","role":"symbol","fragments":[{"text":"protocol","kind":"keyword"},{"text":" ","kind":"text"},{"text":"States","kind":"identifier"}],"type":"topic","kind":"symbol","identifier":"doc:\/\/SimulationModule\/documentation\/SimulationModule\/States","title":"States","abstract":[{"type":"text","text":"A type whose values are the states a simulation can be in."}]}}}