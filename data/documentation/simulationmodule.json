ationmodule\/schedulelabel\/fixedupdate","title":"fixedUpdate","type":"topic","role":"symbol"},"doc://SimulationModule/documentation/SimulationModule/inState(_:)":{"identifier":"doc:\/\/SimulationModule\/documentation\/SimulationModule\/inState(_:)","abstract":[{"text":"Returns a run condition that holds when a world’s current state is the given state.","type":"text"}],"kind":"symbol","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"inState","kind":"identifier"},{"text":"<","kind":"text"},{"text":"S","kind":"genericParameter"},{"text":">(","kind":"text"},{"text":"S","kind":"typeIdentifier"},{"text":") -> (","kind":"text"},{"preciseIdentifier":"s:11WorldModule0A0V","text":"World","kind":"typeIdentifier"},{"text":") -> ","kind":"text"},{"preciseIdentifier":"s:Sb","text":"Bool","kind":"typeIdentifier"}],"url":"\/documentation\/simulationmodule\/instate(_:)","title":"inState(_:)","type":"topic","role":"symbol"}}}