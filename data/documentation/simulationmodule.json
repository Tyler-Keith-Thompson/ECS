ts":[{"kind":"keyword","text":"static"},{"kind":"text","text":" "},{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"onExit"},{"kind":"text","text":"<"},{"text":"S","kind":"genericParameter"},{"text":">(","kind":"text"},{"text":"S","kind":"typeIdentifier"},{"text":") -> ","kind":"text"},{"preciseIdentifier":"s:16SimulationModule13ScheduleLabelV","text":"ScheduleLabel","kind":"typeIdentifier"}]},"doc://SimulationModule/documentation/SimulationModule/ScheduleLabel/onTransition(from:to:)":{"abstract":[{"type":"text","text":"Returns the label of the schedule that runs when a simulation changes from one given state"},{"type":"text","text":" "},{"type":"text","text":"to another."}],"type":"topic","role":"symbol","identifier":"doc:\/\/SimulationModule\/documentation\/SimulationModule\/ScheduleLabel\/onTransition(from:to:)","kind":"symbol","title":"onTransition(from:to:)","fragments":[{"text":"static","kind":"keyword"},{"text":" ","kind":"text"},{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"onTransition","kind":"identifier"},{"text":"<","kind":"text"},{"text":"S","kind":"genericParameter"},{"text":">(","kind":"text"},{"text":"from","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"S","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"to","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"S","kind":"typeIdentifier"},{"text":") -> ","kind":"text"},{"text":"ScheduleLabel","preciseIdentifier":"s:16SimulationModule13ScheduleLabelV","kind":"typeIdentifier"}],"url":"\/documentation\/simulationmodule\/schedulelabel\/ontransition(from:to:)"},"doc://SimulationModule/documentation/SimulationModule/ScheduleLabel/fixedUpdate":{"abstract":[{"text":"The label of the schedule that runs once for each fixed timestep of elapsed time.","type":"text"}],"type":"topic","role":"symbol","identifier":"doc:\/\/SimulationModule\/documentation\/SimulationModule\/ScheduleLabel\/fixedUpdate","kind":"symbol","title":"fixedUpdate","fragments":[{"kind":"keyword","text":"static"},{"kind":"text","text":" "},{"kind":"keyword","text":"let"},{"kind":"text","text":" "},{"kind":"identifier","text":"fixedUpdate"},{"kind":"text","text":": "},{"text":"ScheduleLabel","preciseIdentifier":"s:16SimulationModule13ScheduleLabelV","kind":"typeIdentifier"}],"url":"\/documentation\/simulationmodule\/schedulelabel\/fixedupdate"},"doc://SimulationModule/documentation/SimulationModule/ScheduleLabel":{"type":"topic","title":"ScheduleLabel","abstract":[{"text":"The name of a schedule in a simulation.","type":"text"}],"role":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"ScheduleLabel","kind":"identifier"}],"identifier":"doc:\/\/SimulationModule\/documentation\/SimulationModule\/ScheduleLabel","url":"\/documentation\/simulationmodule\/schedulelabel","navigatorTitle":[{"text":"ScheduleLabel","kind":"identifier"}],"kind":"symbol"}}}