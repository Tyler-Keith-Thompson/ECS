"kind":"keyword"},{"text":" ","kind":"text"},{"text":"NonPositiveDuration","kind":"identifier"}],"abstract":[{"type":"text","text":"An error that indicates a simulation’s fixed timestep or maximum frame time is zero or"},{"type":"text","text":" "},{"type":"text","text":"negative."}],"url":"\/documentation\/simulationmodule\/nonpositiveduration","title":"NonPositiveDuration","kind":"symbol"},"doc://SimulationModule/documentation/SimulationModule/inState(_:)":{"identifier":"doc:\/\/SimulationModule\/documentation\/SimulationModule\/inState(_:)","type":"topic","role":"symbol","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"inState"},{"kind":"text","text":"<"},{"kind":"genericParameter","text":"S"},{"kind":"text","text":">("},{"kind":"typeIdentifier","text":"S"},{"kind":"text","text":") -> ("},{"preciseIdentifier":"s:11WorldModule0A0V","kind":"typeIdentifier","text":"World"},{"kind":"text","text":") -> "},{"preciseIdentifier":"s:Sb","kind":"typeIdentifier","text":"Bool"}],"url":"\/documentation\/simulationmodule\/instate(_:)","abstract":[{"type":"text","text":"Returns a run condition that holds when a world’s current state is the given state."}],"kind":"symbol","title":"inState(_:)"},"doc://SimulationModule/documentation/SimulationModule/Time":{"navigatorTitle":[{"kind":"identifier","text":"Time"}],"url":"\/documentation\/simulationmodule\/time","role":"symbol","kind":"symbol","title":"Time","type":"topic","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"Time"}],"abstract":[{"text":"A resource holding the time a simulation has advanced.","type":"text"}],"identifier":"doc:\/\/SimulationModule\/documentation\/SimulationModule\/Time"},"doc://SimulationModule/documentation/SimulationModule":{"identifier":"doc:\/\/SimulationModule\/documentation\/SimulationModule","type":"topic","role":"collection","url":"\/documentation\/simulationmodule","abstract":[{"text":"Run a world frame by frame, with schedules for startup, a fixed timestep and each frame, and","type":"text"},{"text":" ","type":"text"},{"text":"with states that switch systems on and off.","type":"text"}],"kind":"symbol","title":"SimulationModule"},"doc://SimulationModule/documentation/SimulationModule/ScheduleLabel/onExit(_:)":{"role":"symbol","type":"topic","kind":"symbol","abstract":[{"type":"text","text":"Returns the label of the schedule that runs when a simulation leaves the given state."}],"url":"\/documentation\/simulationmodule\/schedulelabel\/onexit(_:)","identifier":"doc:\/\/SimulationModule\/documentation\/SimulationModule\/ScheduleLabel\/onExit(_:)","title":"onExit(_:)","fragments":[{"kind":"keyword","text":"static"},{"kind":"text","text":" "},{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"onExit"},{"kind":"text","text":"<"},{"kind":"genericParameter","text":"S"},{"kind":"text","text":">("},{"kind":"typeIdentifier","text":"S"},{"kind":"text","text":") -> "},{"kind":"typeIdentifier","text":"ScheduleLabel","preciseIdentifier":"s:16SimulationModule13ScheduleLabelV"}]},"doc://SimulationModule/documentation/SimulationModule/Simulation/add(state:)":{"role":"symbol","url":"\/documentation\/simulationmodule\/simulation\/add(state:)","abstract":[{"type":"text","text":"Adds a state type to the simulation, starting in the given state."}],"kind":"symbol","type":"topic","title":"add(state:)","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"add","kind":"identifier"},{"text":"<","kind":"text"},{"text":"S","kind":"genericParameter"},{"text":">(","kind":"text"},{"text":"state","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"S","kind":"typeIdentifier"},{"text":")","kind":"text"}],"identifier":"doc:\/\/SimulationModule\/documentation\/SimulationModule\/Simulation\/add(state:)"},"doc://SimulationModule/documentation/SimulationModule/Simulation":{"identifier":"doc:\/\/SimulationModule\/documentation\/SimulationModule\/Simulation","type":"topic","role":"symbol","navigatorTitle":[{"text":"Simulation","kind":"identifier"}],"fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Simulation","kind":"identifier"}],"abstract":[{"type":"text","text":"A world and its schedules by label, advanced one frame at a time."}],"url":"\/documentation\/simulationmodule\/simulation","title":"Simulation","kind":"symbol"},"doc://SimulationModule/documentation/SimulationModule/ScheduleLabel/startup":{"identifier":"doc:\/\/SimulationModule\/documentation\/SimulationModule\/ScheduleLabel\/startup","type":"topic","role":"symbol","fragments":[{"kind":"keyword","text":"static"},{"kind":"text","text":" "},{"kind":"keyword","text":"let"},{"kind":"text","text":" "},{"kind":"identifier","text":"startup"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:16SimulationModule13ScheduleLabelV","text":"ScheduleLabel"}],"url":"\/documentation\/simulationmodule\/schedulelabel\/startup","abstract":[{"text":"The label of the schedule that runs once, before the first frame.","type":"text"}],"kind":"symbol","title":"startup"},"doc://SimulationModule/documentation/SimulationModule/ScheduleLabel/update":{"identifier":"doc:\/\/SimulationModule\/documentation\/SimulationModule\/ScheduleLabel\/update","type":"topic","role":"symbol","fragments":[{"kind":"keyword","text":"static"},{"kind":"text","text":" "},{"kind":"keyword","text":"let"},{"kind":"text","text":" "},{"kind":"identifier","text":"update"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"ScheduleLabel","preciseIdentifier":"s:16SimulationModule13ScheduleLabelV"}],"url":"\/documentation\/simulationmodule\/schedulelabel\/update","abstract":[{"type":"text","text":"The label of the schedule that runs once a frame."}],"kind":"symbol","title":"update"},"doc://SimulationModule/documentation/SimulationModule/NextState":{"identifier":"doc:\/\/SimulationModule\/documentation\/SimulationM