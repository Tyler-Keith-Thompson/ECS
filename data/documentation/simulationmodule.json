nModule\/Time","abstract":[{"type":"text","text":"A resource holding the time a simulation has advanced."}],"role":"symbol","kind":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"Time"}],"navigatorTitle":[{"kind":"identifier","text":"Time"}],"title":"Time","url":"\/documentation\/simulationmodule\/time","type":"topic"},"doc://SimulationModule/documentation/SimulationModule/NextState":{"abstract":[{"type":"text","text":"A resource holding the state a simulation enters at the start of its next frame."}],"type":"topic","title":"NextState","url":"\/documentation\/simulationmodule\/nextstate","kind":"symbol","identifier":"doc:\/\/SimulationModule\/documentation\/SimulationModule\/NextState","role":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"NextState"}],"navigatorTitle":[{"kind":"identifier","text":"NextState"}]}}}