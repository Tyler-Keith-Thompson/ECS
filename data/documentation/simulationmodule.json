{"metadata":{"role":"collection","externalID":"SimulationModule","modules":[{"name":"SimulationModule"}],"roleHeading":"Framework","symbolKind":"module","title":"SimulationModule"},"sections":[],"hierarchy":{"paths":[[]]},"schemaVersion":{"major":0,"minor":3,"patch":0},"primaryContentSections":[{"kind":"content","content":[{"type":"heading","level":2,"anchor":"Overview","text":"Overview"},{"type":"paragraph","inlineContent":[{"type":"text","text":"A "},{"identifier":"doc:\/\/SimulationModule\/documentation\/SimulationModule\/Simulation","type":"reference","isActive":true},{"type":"text","text":" owns a world and a set of schedules, each named by a "},{"identifier":"doc:\/\/SimulationModule\/documentation\/SimulationModule\/ScheduleLabel","type":"reference","isActive":true},{"type":"text","text":". You add"},{"type":"text","text":" "},{"type":"text","text":"systems to the schedules by label, then call "},{"identifier":"doc:\/\/SimulationModule\/documentation\/SimulationModule\/Simulation\/update(elapsed:)","type":"reference","isActive":true},{"type":"text","text":" once a frame with the"},{"type":"text","text":" "},{"type":"text","text":"time that passed. The simulation decides which schedules run:"}]},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"type":"reference","isActive":true,"identifier":"doc:\/\/SimulationModule\/documentation\/SimulationModule\/ScheduleLabel\/startup"},{"type":"text","text":" runs once, before the first frame."}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"reference","identifier":"doc:\/\/SimulationModule\/documentation\/SimulationModule\/ScheduleLabel\/fixedUpdate","isActive":true},{"type":"text","text":" runs once for every fixed timestep of time that has passed, so"},{"type":"text","text":" "},{"type":"text","text":"physics and other rate-sensitive rules advance by the same amount each run, however uneven the"},{"type":"text","text":" "},{"type":"text","text":"frames are."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"isActive":true,"type":"reference","identifier":"doc:\/\/SimulationModule\/documentation\/SimulationModule\/ScheduleLabel\/update"},{"type":"text","text":" runs once a frame."}]}]}]},{"type":"paragraph","inlineContent":[{"text":"The examples throughout this module use these components, resources and systems:","type":"text"}]},{"type":"codeListing","syntax":"swift","code":["struct Position: Component { var x: Double }","struct Velocity: Component { var dx: Double }","struct FixedSteps: Resource { var count = 0 }","enum GameState: States { case menu, playing, paused }","","\/\/\/ Moves each entity by its velocity over one fixed timestep.","@System","struct Physics {","    func run(_ movers: Update<Position>.Over<Velocity>, _ fixedTime: ResourceReader<FixedTime>) {","        let seconds = fixedTime.value.timestep \/ .seconds(1)","        movers { position, row in","            position.x += row.components.dx * seconds","        }","    }","}","","\/\/\/ Counts the runs of the schedule it is in.","@System","struct CountSteps {","    func run(_ steps: ResourceWriter<FixedSteps>) {","        steps.value.count += 1","    }","}","","\/\/\/ Spawns a ball at the origin.","@System","struct SpawnBall {","    func run(commands: inout Commands) {","        commands.spawn(Position(x: 0), Velocity(dx: 64))","    }","}"]},{"type":"paragraph","inlineContent":[{"type":"text","text":"The following example runs "},{"code":"Physics","type":"codeVoice"},{"type":"text","text":" on a fixed timestep of 1\/64 second, the default. A frame"},{"type":"text","text":" "},{"type":"text","text":"of 50 milliseconds covers three whole timesteps, so the ball moves three times:"}]},{"type":"codeListing","syntax":"swift","code":["var world = World()","let ball = world.spawn(Position(x: 0), Velocity(dx: 64))","","var simulation = Simulation(world)","simulation.add(to: .fixedUpdate) { Physics() }","simulation.update(elapsed: .milliseconds(50))","","print(simulation.world[Position.self, of: ball])","\/\/ Prints \"Position(x: 3.0)\""]},{"type":"heading","level":3,"anchor":"States","text":"States"},{"type":"paragraph","inlineContent":[{"text":"A state type is a type, usually an enumeration, that conforms to ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/SimulationModule\/documentation\/SimulationModule\/States"},{"text":": the screens of a","type":"text"},{"text":" ","type":"text"},{"text":"game, or the phases of a simulation. Add one to a simulation with","type":"text"},{"text":" ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/SimulationModule\/documentation\/SimulationModule\/Simulation\/add(state:)"},{"text":". The simulation keeps the current state in the ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/SimulationModule\/documentation\/SimulationModule\/CurrentState"},{"text":" ","type":"text"},{"text":"resource; to change it, a system sets ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/SimulationModule\/documentation\/SimulationModule\/NextState"},{"text":", and the change applies at the start of the","type":"text"},{"text":" ","type":"text"},{"text":"next frame. Entering, leaving and moving between states run schedules of their own,","type":"text"},{"text":" ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/SimulationModule\/documentation\/SimulationModule\/ScheduleLabel\/onEnter(_:)"},{"text":", ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/SimulationModule\/documentation\/SimulationModule\/ScheduleLabel\/onExit(_:)"},{"text":" and","type":"text"},{"text":" ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/SimulationModule\/documentation\/SimulationModule\/ScheduleLabel\/onTransition(from:to:)"},{"text":", and ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/SimulationModule\/documentation\/SimulationModule\/inState(_:)"},{"text":" makes a run condition that holds","type":"text"},{"text":" ","type":"text"},{"text":"only in one state.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"The following example spawns a ball on entering the ","type":"text"},{"code":"playing","type":"codeVoice"},{"text":" state and moves it only while the","type":"text"},{"text":" ","type":"text"},{"text":"game is in that state:","type":"text"}]},{"type":"codeListing","syntax":"swift","code":["var simulation = Simulation()","simulation.add(state: GameState.menu)","simulation.add(to: .onEnter(GameState.playing)) { SpawnBall() }","simulation.add(to: .fixedUpdate) { Physics().runIf(inState(GameState.playing)) }","","simulation.update(elapsed: .milliseconds(50))","print(simulation.world.count)","\/\/ Prints \"0\"","","simulation.world.resources[NextState<GameState>.self].set(.playing)","simulation.update(elapsed: .milliseconds(50))","print(simulation.world.resources[CurrentState<GameState>.self].state)","\/\/ Prints \"playing\"","for (_, position) in simulation.world.query(Position.self) {","    print(position)  \/\/ Prints \"Position(x: 3.0)\"","}"]}]}],"kind":"symbol","variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/simulationmodule"]}],"abstract":[{"text":"Run a world frame by frame, with schedules for startup, a fixed timestep and each frame, and","type":"text"},{"text":" ","type":"text"},{"text":"with states that switch systems on and off.","type":"text"}],"topicSections":[{"anchor":"Simulations","title":"Simulations","identifiers":["doc:\/\/SimulationModule\/documentation\/SimulationModule\/Simulation","doc:\/\/SimulationModule\/documentation\/SimulationModule\/ScheduleLabel","doc:\/\/SimulationModule\/documentation\/SimulationModule\/NonPositiveDuration"]},{"anchor":"Time","title":"Time","identifiers":["doc:\/\/SimulationModule\/documentation\/SimulationModule\/Time","doc:\/\/SimulationModule\/documentation\/SimulationModule\/FixedTime"]},{"anchor"