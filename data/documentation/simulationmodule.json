{"kind":"symbol","identifier":{"url":"doc:\/\/SimulationModule\/documentation\/SimulationModule","interfaceLanguage":"swift"},"sections":[],"metadata":{"role":"collection","modules":[{"name":"SimulationModule"}],"roleHeading":"Framework","title":"SimulationModule","externalID":"SimulationModule","symbolKind":"module"},"topicSections":[{"title":"Simulations","anchor":"Simulations","identifiers":["doc:\/\/SimulationModule\/documentation\/SimulationModule\/Simulation","doc:\/\/SimulationModule\/documentation\/SimulationModule\/ScheduleLabel","doc:\/\/SimulationModule\/documentation\/SimulationModule\/NonPositiveDuration"]},{"title":"Time","anchor":"Time","identifiers":["doc:\/\/SimulationModule\/documentation\/SimulationModule\/Time","doc:\/\/SimulationModule\/documentation\/SimulationModule\/FixedTime"]},{"title":"States","anchor":"States","identifiers":["doc:\/\/SimulationModule\/documentation\/SimulationModule\/States","doc:\/\/SimulationModule\/documentation\/SimulationModule\/CurrentState","doc:\/\/SimulationModule\/documentation\/SimulationModule\/NextState","doc:\/\/SimulationModule\/documentation\/SimulationModule\/inState(_:)"]}],"abstract":[{"type":"text","text":"Run a world frame by frame, with schedules for startup, a fixed timestep and each frame, and"},{"type":"text","text":" "},{"type":"text","text":"with states that switch systems on and off."}],"schemaVersion":{"major":0,"patch":0,"minor":3},"primaryContentSections":[{"content":[{"type":"heading","anchor":"Overview","level":2,"text":"Overview"},{"type":"paragraph","inlineContent":[{"text":"A ","type":"text"},{"type":"reference","isActive":true,"identifier":"doc:\/\/SimulationModule\/documentation\/SimulationModule\/Simulation"},{"text":" owns a world and a set of schedules, each named by a ","type":"text"},{"type":"reference","isActive":true,"identifier":"doc:\/\/SimulationModule\/documentation\/SimulationModule\/ScheduleLabel"},{"text":". You add","type":"text"},{"text":" ","type":"text"},{"text":"systems to the schedules by label, then call ","type":"text"},{"type":"reference","isActive":true,"identifier":"doc:\/\/SimulationModule\/documentation\/SimulationModule\/Simulation\/update(elapsed:)"},{"text":" once a frame with the","type":"text"},{"text":" ","type":"text"},{"text":"time that passed. The simulation decides which schedules run:","type":"text"}]},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"reference","identifier":"doc:\/\/SimulationModule\/documentation\/SimulationModule\/ScheduleLabel\/startup","isActive":true},{"type":"text","text":" runs once, before the first frame."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"isActive":true,"type":"reference","identifier":"doc:\/\/SimulationModule\/documentation\/SimulationModule\/ScheduleLabel\/fixedUpdate"},{"text":" runs once for every fixed timestep of time that has passed, so","type":"text"},{"text":" ","type":"text"},{"text":"physics and other rate-sensitive rules advance by the same amount each run, however uneven the","type":"text"},{"text":" ","type":"text"},{"text":"frames are.","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"identifier":"doc:\/\/SimulationModule\/documentation\/SimulationModule\/ScheduleLabel\/update","type":"reference","isActive":true},{"text":" runs once a frame.","type":"text"}]}]}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"The examples throughout this module use these components, resources and systems:"}]},{"type":"codeListing","code":["struct Position: Component { var x: Double }","struct Velocity: Component { var dx: Double }","struct FixedSteps: Resource { var count = 0 }","enum GameState: States { case menu, playing, paused }","","\/\/\/ Moves each entity by its velocity over one fixed timestep.","@System","struct Physics {","    func run(_ movers: Update<Position>.Over<Velocity>, _ fixedTime: ResourceReader<FixedTime>) {","        let seconds = fixedTime.value.timestep \/ .seconds(1)","        movers { position, row in","            position.x += row.components.dx * seconds","        }","    }","}","","\/\/\/ Counts the runs of the schedule it is in.","@System","struct CountSteps {","    func run(_ steps: ResourceWriter<FixedSteps>) {","        steps.value.count += 1","    }","}","","\/\/\/ Spawns a ball at the origin.","@System","struct SpawnBall {","    func run(commands: inout Commands) {","        commands.spawn(Position(x: 0), Velocity(dx: 64))","    }","}"],"syntax":"swift"},{"type":"paragraph","inlineContent":[{"text":"The following example runs ","type":"text"},{"type":"codeVoice","code":"Physics"},{"text":" on a fixed timestep of 1\/64 second, the default. A frame","type":"text"},{"text":" ","type":"text"},{"text":"of 50 milliseconds covers three whole timesteps, so the ball moves three times:","type":"text"}]},{"type":"codeListing","code":["var world = World()","let ball = world.spawn(Position(x: 0), Velocity(dx: 64))","","var simulation = Simulation(world)","simulation.add(to: .fixedUpdate) { Physics() }","simulation.update(elapsed: .milliseconds(50))","","print(simulation.world[Position.self, of: ball])","\/\/ Prints \"Position(x: 3.0)\""],"syntax":"swift"},{"type":"heading","anchor":"States","level":3,"text":"States"},{"type":"paragraph","inlineContent":[{"text":"A state type is a type, usually an enumeration, that conforms to ","type":"text"},{"isActive":true,"identifier":"doc:\/\/SimulationModule\/documentation\/SimulationModule\/States","type":"reference"},{"text":": the screens of a","type":"text"},{"text":" ","type":"text"},{"text":"game, or the phases of a simulation. Add one to a simulation with","type":"text"},{"text":" ","type":"text"},{"isActive":true,"identifier":"doc:\/\/SimulationModule\/documentation\/SimulationModule\/Simulation\/add(state:)","type":"reference"},{"text":". The simulation keeps the current state in the ","type":"text"},{"isActive":true,"identifier":"doc:\/\/SimulationModule\/documentation\/SimulationModule\/CurrentState","type":"reference"},{"text":" ","type":"text"},{"text":"resource; to change it, a system sets ","type":"text"},{"isActive":true,"identifier":"doc:\/\/SimulationModule\/documentation\/SimulationModule\/NextState","type":"reference"},{"text":", and the change applies at the start of the","type":"text"},{"text":" ","type":"text"},{"text":"next frame. Entering, leaving and moving between states run schedules of their own,","type":"text"},{"text":" ","type":"text"},{"isActive":true,"identifier":"doc:\/\/SimulationModule\/documentation\/SimulationModule\/ScheduleLabel\/onEnter(_:)","type":"reference"},{"text":", ","type":"text"},{"isActive":true,"identifier":"doc:\/\/SimulationModule\/documentation\/SimulationModule\/ScheduleLabel\/onExit(_:)","type":"reference"},{"text":" and","type":"text"},{"text":" ","type":"text"},{"isActive":true,"identifier":"doc:\/\/SimulationModule\/documentation\/SimulationModule\/ScheduleLabel\/onTransition(from:to:)","type":"reference"},{"text":", and ","type":"text"},{"isActive":true,"identifier":"doc:\/\/SimulationModule\/documentation\/SimulationModule\/inState(_:)","type":"reference"},{"text":" makes a run condition that holds","type":"text"},{"text":" ","type":"text"},{"text":"only in one state.","type":"text"}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"The following example spawns a ball on entering the "},{"type":"codeVoice","code":"playing"},{"type":"text","text":" state and moves it only while the"},{"type":"text","text":" "},{"type":"text","text":"game is in that state:"}]},{"type":"codeListing","code":["var simulation = Simulation()","simulation.add(state: GameState.menu)","simulation.add(to: .onEnter(GameState.playing)) { SpawnBall() }","simulation.add(to: .fixedUpdate) { Physics().runIf(inState(GameState.playing)) }","","simulation.update(elapsed: .milliseconds(50))","print(simulation.world.count)","\/\/ Prints \"0\"","","simulation.world.resources[NextState<GameState>.self].set(.playing)","simulation.update(elapsed: .milliseconds(50))","print(simulation.world.resources[CurrentState<GameState>.self].state)","\/\/ Prints \"playing\"","for (_, position) in simulation.world.query(Position.self) {","    print(position)  \/\/ Prints \"Position(x: 3.0)\"","}"],"syntax":"swift"}],"kind":"content"}],"variants":[{"paths":["\/documentation\/simulationmodule"],"traits":[{"interfaceLanguage":"swift"}]}],"hierarchy":{"paths":[[]]},"references":{"doc://SimulationModule/documentation/SimulationModule":{"kind":"symbol","title":"SimulationModule","identifier":"doc:\/\/SimulationModule\/documentation\/SimulationModule","type":"topic","abstract":[{"text":"Run a world frame by frame, with schedules for startup, a fixed timestep and each frame, and","type":"text"},{"text":" ","type":"text"},{"text":"with states that switch systems on and off.","type":"text"}],"role":"collection","url":"\/documentation\/simulationmodule"},"doc://SimulationModule/documentation/SimulationModule/Simulation":{"kind":"symbol","title":"Simulation","identifier":"doc:\/\/SimulationModule\/documentation\/SimulationModule\/Simulation","navigatorTitle":[{"kind":"identifier","text":"Simulation"}],"fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"Simulation"}],"abstract":[{"type":"text","text":"A world and its schedules by label, advanced one frame at a time."}],"type":"topic","role":"symbol","url":"\/documentation\/simulationmodule\/simulation"},"doc://SimulationModule/documentation/SimulationModule/FixedTime":{"kind":"symbol","identifier":"doc:\/\/SimulationModule\/documentation\/SimulationModule\/FixedTime","title":"FixedTime","url":"\/documentation\/simulationmodule\/fixedtime","abstract":[{"type":"text","text":"A resource holding the fixed timestep of a simulation."}],"role":"symbol","type":"topic","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"FixedTime"}],"navigatorTitle":[{"kind":"identifier","text":"FixedTime"}]},"doc://SimulationModule/documentation/SimulationModule/ScheduleLabel/update":{"identifier":"doc:\/\/SimulationModule\/documentation\/SimulationModule\/ScheduleLabel\/update","fragments":[{"kind":"keyword","text":"static"},{"kind":"text","text":" "},{"kind":"keyword","text":"let"},{"kind":"text","text":" "},{"kind":"identifier","text":"update"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"ScheduleLabel","preciseIdentifier":"s:16SimulationModule13ScheduleLabelV"}],"url":"\/documentation\/simulationmodule\/schedulelabel\/update","abstract":[{"type":"text","text":"The label of the schedule that runs once a frame."}],"kind":"symbol","role":"symbol","type":"topic","title":"update"},"doc://SimulationModule/documentation/SimulationModule/ScheduleLabel/fixedUpdate":{"kind":"symbol","title":"fixedUpdate","identifier":"doc:\/\/SimulationModule\/documentation\/SimulationModule\/ScheduleLabel\/fixedUpdate","fragments":[{"text":"static","kind":"keyword"},{"text":" ","kind":"text"},{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"fixedUpdate","kind":"identifier"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:16SimulationModule13ScheduleLabelV","text":"ScheduleLabel","kind":"typeIdentifier"}],"abstract":[{"text":"The label of the schedule that runs once for each fixed timestep of elapsed time.","type":"text"}],"type":"topic","role":"symbol","url":"\/documentation\/simulationmodule\/schedulelabel\/fixedupdate"},"doc://SimulationModule/documentation/SimulationModule/Simulation/update(elapsed:)":{"identifier":"doc:\/\/SimulationModule\/documentation\/SimulationModule\/Simulation\/update(elapsed:)","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"update"},{"kind":"text","text":"("},{"kind":"externalParam","text":"elapsed"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"Duration","preciseIdentifier":"s:s8DurationV"},{"kind":"text","text":")"}],"url":"\/documentation\/simulationmodule\/simulation\/update(elapsed:)","kind":"symbol","abstract":[{"type":"text","text":"Advances the simulation by one frame."}],"role":"symbol","type":"topic","title":"update(elapsed:)"},"doc://SimulationModule/documentation/SimulationModule/States":{"title":"States","url":"\/documentation\/simulationmodule\/states","navigatorTitle":[{"kind":"identifier","text":"States"}],"kind":"symbol","role":"symbol","type":"topic","abstract":[{"type":"text","text":"A type whose values are the states a simulation can be in."}],"identifier":"doc:\/\/SimulationModule\/documentation\/SimulationModule\/States","fragments":[{"kind":"keyword","text":"protocol"},{"kind":"text","text":" "},{"kind":"identifier","text":"States"}]},"doc://SimulationModule/documentation/SimulationModule/ScheduleLabel/onEnter(_:)":{"title":"onEnter(_:)","url":"\/documentation\/simulationmodule\/schedulelabel\/onenter(_:)","kind":"symbol","role":"symbol","type":"topic","identifier":"doc:\/\/SimulationModule\/documentation\/SimulationModule\/ScheduleLabel\/onEnter(_:)","abstract":[{"type":"text","text":"Returns the label of the schedule that runs when a simulation enters the given state."}],"fragments":[{"text":"static","kind":"keyword"},{"text":" ","kind":"text"},{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"onEnter","kind":"identifier"},{"text":"<","kind":"text"},{"text":"S","kind":"genericParameter"},{"text":">(","kind":"text"},{"text":"S","kind":"typeIdentifier"},{"text":") -> ","kind":"text"},{"preciseIdentifier":"s:16SimulationModule13ScheduleLabelV","text":"ScheduleLabel","kind":"typeIdentifier"}]},"doc://SimulationModule/documentation/SimulationModule/inState(_:)":{"identifier":"doc:\/\/SimulationModule\/documentation\/SimulationModule\/inState(_:)","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"inState","kind":"identifier"},{"text":"<","kind":"text"},{"text":"S","kind":"genericParameter"},{"text":">(","kind":"text