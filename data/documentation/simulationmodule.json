"text":"protocol"},{"kind":"text","text":" "},{"kind":"identifier","text":"States"}],"type":"topic","url":"\/documentation\/simulationmodule\/states","identifier":"doc:\/\/SimulationModule\/documentation\/SimulationModule\/States","role":"symbol","abstract":[{"type":"text","text":"A type whose values are the states a simulation can be in."}]},"doc://SimulationModule/documentation/SimulationModule/ScheduleLabel/fixedUpdate":{"title":"fixedUpdate","kind":"symbol","fragments":[{"kind":"keyword","text":"static"},{"kind":"text","text":" "},{"kind":"keyword","text":"let"},{"kind":"text","text":" "},{"kind":"identifier","text":"fixedUpdate"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:16SimulationModule13ScheduleLabelV","text":"ScheduleLabel"}],"type":"topic","url":"\/documentation\/simulationmodule\/schedulelabel\/fixedupdate","identifier":"doc:\/\/SimulationModule\/documentation\/SimulationModule\/ScheduleLabel\/fixedUpdate","role":"symbol","abstract":[{"type":"text","text":"The label of the schedule that runs once for each fixed timestep of elapsed time."}]},"doc://SimulationModule/documentation/SimulationModule/inState(_:)":{"url":"\/documentation\/simulationmodule\/instate(_:)","abstract":[{"type":"text","text":"Returns a run condition that holds when a world’s current state is the given state."}],"title":"inState(_:)","kind":"symbol","type":"topic","role":"symbol","identifier":"doc:\/\/SimulationModule\/documentation\/SimulationModule\/inState(_:)","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"inState","kind":"identifier"},{"text":"<","kind":"text"},{"text":"S","kind":"genericParameter"},{"text":">(","kind":"text"},{"text":"S","kind":"typeIdentifier"},{"text":") -> (","kind":"text"},{"text":"World","preciseIdentifier":"s:11WorldModule0A0V","kind":"typeIdentifier"},{"text":") -> ","kind":"text"},{"text":"Bool","preciseIdentifier":"s:Sb","kind":"typeIdentifier"}]},"doc://SimulationModule/documentation/SimulationModule/ScheduleLabel/onTransition(from:to:)":{"title":"onTransition(from:to:)","kind":"symbol","fragments":[{"text":"static","kind":"keyword"},{"text":" ","kind":"text"},{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"onTransition","kind":"identifier"},{"text":"<","kind":"text"},{"text":"S","kind":"genericParameter"},{"text":">(","kind":"text"},{"text":"from","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"S","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"to","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"S","kind":"typeIdentifier"},{"text":") -> ","kind":"text"},{"text":"ScheduleLabel","kind":"typeIdentifier","preciseIdentifier":"s:16SimulationModule13ScheduleLabelV"}],"type":"topic","url":"\/documentation\/simulationmodule\/schedulelabel\/ontransition(from:to:)","identifier":"doc:\/\/SimulationModule\/documentation\/SimulationModule\/ScheduleLabel\/onTransition(from:to:)","role":"symbol","abstract":[{"type":"text","text":"Returns the label of the schedule that runs when a simulation changes from one given state"},{"type":"text","text":" "},{"type":"text","text":"to another."}]},"doc://SimulationModule/documentation/SimulationModule/ScheduleLabel":{"title":"ScheduleLabel","navigatorTitle":[{"text":"ScheduleLabel","kind":"identifier"}],"kind":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"ScheduleLabel","kind":"identifier"}],"type":"topic","url":"\/documentation\/simulationmodule\/schedulelabel","identifier":"doc:\/\/SimulationModule\/documentation\/SimulationModule\/ScheduleLabel","role":"symbol","abstract":[{"type":"text","text":"The name of a schedule in a simulation."}]},"doc://SimulationModule/documentation/SimulationModule/Simulation/update(elapsed:)":{"type":"topic","title":"update(elapsed:)","url":"\/documentation\/simulationmodule\/simulation\/update(elapsed:)","identifier":"doc:\/\/SimulationModule\/documentation\/SimulationModule\/Simulat