edulelabel\/update","title":"update","role":"symbol","type":"topic","abstract":[{"type":"text","text":"The label of the schedule that runs once a frame."}]},"doc://SimulationModule/documentation/SimulationModule/FixedTime":{"kind":"symbol","identifier":"doc:\/\/SimulationModule\/documentation\/SimulationModule\/FixedTime","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"FixedTime"}],"url":"\/documentation\/simulationmodule\/fixedtime","title":"FixedTime","navigatorTitle":[{"kind":"identifier","text":"FixedTime"}],"role":"symbol","type":"topic","abstract":[{"type":"text","text":"A resource holding the fixed timestep of a simulation."}]},"doc://SimulationModule/documentation/SimulationModule/CurrentState":{"kind":"symbol","identifier":"doc:\/\/SimulationModule\/documentation\/SimulationModule\/CurrentState","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"CurrentState","kind":"identifier"}],"url":"\/documentation\/simulationmodule\/currentstate","title":"CurrentState","navigatorTitle":[{"text":"CurrentState","kind":"identifier"}],"role":"symbol","type":"topic","abstract":[{"text":"A resource holding the state a simulation is in.","type":"text"}]},"doc://SimulationModule/documentation/SimulationModule/Time":{"kind":"symbol","identifier":"doc:\/\/SimulationModule\/documentation\/SimulationModule\/Time","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Time","kind":"identifier"}],"url":"\/documentation\/simulationmodule\/time","title":"Time","navigatorTitle":[{"text":"Time","kind":"identifier"}],"role":"symbol","type":"topic","abstract":[{"type":"text","text":"A resource holding the time a simulation has advanced."}]},"doc://SimulationModule/documentation/SimulationModule/ScheduleLabel/fixedUpdate":{"identifier":"doc:\/\/SimulationModule\/documentation\/SimulationModule\/ScheduleLabel\/fixedUpdate","url":"\/documentation\/simulationmodule\/schedulelabel\/fixedupdate","kind":"symbol","role":"symbol","fragments":[{"text":"static","kind":"keyword"},{"text":" ","kind":"text"},{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"fixedUpdate","kind":"identifier"},{"text":": ","kind":"text"},{"text":"ScheduleLabel","preciseIdentifier":"s:16SimulationModule13ScheduleLabelV","kind":"typeIdentifier"}],"type":"topic","abstract":[{"text":"The label of the schedule that runs once for each fixed timestep of elapsed time.","type":"text"}],"title":"fixedUpdate"},"doc://SimulationModule/documentation/SimulationModule/NonPositiveDuration":{"title":"NonPositiveDuration","url":"\/documentation\/simulationmodule\/nonpositiveduration","type":"topic","role":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"NonPositiveDuration"}],"abstract":[{"text":"An error that indicates a simulation’s fixed timestep or maximum frame time is zero or","type":"text"},{"text":" ","type":"text"},{"text":"negative.","type":"text"}],"kind":"symbol","navigatorTitle":[{"kind":"identifier","text":"NonPositiveDuration"}],"identifier":"doc:\/\/SimulationModule\/documentation\/SimulationModule\/NonPositiveDuration"},"doc://SimulationModule/documentation/SimulationModule/Simulation/update(elapsed:)":{"identifier":"doc:\/\/SimulationModule\/documentation\/SimulationModule\/Simulation\/update(elapsed:)","url":"\/documentation\/simulationmodule\/simulation\/update(elapsed:)","kind":"symbol","role":"symbol","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"update","kind":"identifier"},{"text":"(","kind":"text"},{"text":"elapsed","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"Duration","preciseIdentifier":"s:s8DurationV","kind":"typeIdentifier"},{"text":")","kind":"text"}],"type":"topic","abstract":[{"type":"text","text":"Advances the simulation by one frame."}],"title":"update(elapsed:)"},"doc://SimulationModule/documentation/SimulationModule":{"identifier":"doc:\/\/SimulationModule\/documentation\/SimulationModule","kind":"symbol","url":"\/documentation\/simulationmodule","title":"SimulationModule","role":"collection","type":"topic","abstract":[{"type":"text","text":"Run a world frame by frame, with schedules for startup, a fixed timestep and each frame, and"},{"type":"text","text":" "},{"type":"text","text":"with states that switch systems on and off."}]},"doc://SimulationModule/documentation/SimulationModule/States":{"navigatorTitle":[{"text":"States","kind":"identifier"}],"fragments":[{"text":"protocol","kind":"keyword"},{"text":" ","kind":"text"},{"text":"States","kind":"identifier"}],"title":"States","identifier":"doc:\/\/SimulationModule\/documentation\/SimulationModule\/States","kind":"symbol","url":"\/documentation\/simulationmodule\/states","role":"symbol","type":"topic","abstract":[{"type":"text","text":"A type whose values are the states a simulation can be in."}]}}}