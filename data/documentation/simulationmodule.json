{"hierarchy":{"paths":[[]]},"sections":[],"schemaVersion":{"minor":3,"patch":0,"major":0},"topicSections":[{"title":"Simulations","identifiers":["doc:\/\/SimulationModule\/documentation\/SimulationModule\/Simulation","doc:\/\/SimulationModule\/documentation\/SimulationModule\/ScheduleLabel","doc:\/\/SimulationModule\/documentation\/SimulationModule\/NonPositiveDuration"],"anchor":"Simulations"},{"title":"Time","identifiers":["doc:\/\/SimulationModule\/documentation\/SimulationModule\/Time","doc:\/\/SimulationModule\/documentation\/SimulationModule\/FixedTime"],"anchor":"Time"},{"title":"States","identifiers":["doc:\/\/SimulationModule\/documentation\/SimulationModule\/States","doc:\/\/SimulationModule\/documentation\/SimulationModule\/CurrentState","doc:\/\/SimulationModule\/documentation\/SimulationModule\/NextState","doc:\/\/SimulationModule\/documentation\/SimulationModule\/inState(_:)"],"anchor":"States"}],"primaryContentSections":[{"content":[{"anchor":"Overview","type":"heading","text":"Overview","level":2},{"inlineContent":[{"type":"text","text":"A "},{"type":"reference","isActive":true,"identifier":"doc:\/\/SimulationModule\/documentation\/SimulationModule\/Simulation"},{"type":"text","text":" owns a world and a set of schedules, each named by a "},{"type":"reference","isActive":true,"identifier":"doc:\/\/SimulationModule\/documentation\/SimulationModule\/ScheduleLabel"},{"type":"text","text":". You add"},{"type":"text","text":" "},{"type":"text","text":"systems to the schedules by label, then call "},{"type":"reference","isActive":true,"identifier":"doc:\/\/SimulationModule\/documentation\/SimulationModule\/Simulation\/update(elapsed:)"},{"type":"text","text":" once a frame with the"},{"type":"text","text":" "},{"type":"text","text":"time that passed. The simulation decides which schedules run:"}],"type":"paragraph"},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"type":"reference","identifier":"doc:\/\/SimulationModule\/documentation\/SimulationModule\/ScheduleLabel\/startup","isActive":true},{"type":"text","text":" runs once, before the first frame."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"identifier":"doc:\/\/SimulationModule\/documentation\/SimulationModule\/ScheduleLabel\/fixedUpdate","type":"reference","isActive":true},{"type":"text","text":" runs once for every fixed timestep of time that has passed, so"},{"type":"text","text":" "},{"type":"text","text":"physics and other rate-sensitive rules advance by the same amount each run, however uneven the"},{"type":"text","text":" "},{"type":"text","text":"frames are."}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"reference","identifier":"doc:\/\/SimulationModule\/documentation\/SimulationModule\/ScheduleLabel\/update","isActive":true},{"type":"text","text":" runs once a frame."}]}]}]},{"inlineContent":[{"text":"The examples throughout this module use these components, resources and systems:","type":"text"}],"type":"paragraph"},{"code":["struct Position: Component { var x: Double }","struct Velocity: Component { var dx: Double }","struct FixedSteps: Resource { var count = 0 }","enum GameState: States { case menu, playing, paused }","","\/\/\/ Moves each entity by its velocity over one fixed timestep.","@System","struct Physics {","    func run(_ movers: Update<Position>.Over<Velocity>, _ fixedTime: ResourceReader<FixedTime>) {","        let seconds = fixedTime.value.timestep \/ .seconds(1)","        movers { position, row in","            position.x += row.components.dx * seconds","        }","    }","}","","\/\/\/ Counts the runs of the schedule it is in.","@System","struct CountSteps {","    func run(_ steps: ResourceWriter<FixedSteps>) {","        steps.value.count += 1","    }","}","","\/\/\/ Spawns a ball at the origin.","@System","struct SpawnBall {","    func run(commands: inout Commands) {","        commands.spawn(Position(x: 0), Velocity(dx: 64))","    }","}"],"type":"codeListing","syntax":"swift"},{"inlineContent":[{"type":"text","text":"The following example runs "},{"type":"codeVoice","code":"Physics"},{"type":"text","text":" on a fixed timestep of 1\/64 second, the default. A frame"},{"type":"text","text":" "},{"type":"text","text":"of 50 milliseconds covers three whole timesteps, so the ball moves three times:"}],"type":"paragraph"},{"code":["var world = World()","let ball = world.spawn(Position(x: 0), Velocity(dx: 64))","","var simulation = Simulation(world)","simulation.add(to: .fixedUpdate) { Physics() }","simulation.update(elapsed: .milliseconds(50))","","print(simulation.world[Position.self, of: ball])","\/\/ Prints \"Position(x: 3.0)\""],"type":"codeListing","syntax":"swift"},{"anchor":"States","type":"heading","text":"States","level":3},{"inlineContent":[{"type":"text","text":"A state type is a type, usually an enumeration, that conforms to "},{"type":"reference","identifier":"doc:\/\/SimulationModule\/documentation\/SimulationModule\/States","isActive":true},{"type":"text","text":": the screens of a"},{"type":"text","text":" "},{"type":"text","text":"game, or the phases of a simulation. Add one to a simulation with"},{"type":"text","text":" "},{"type":"reference","identifier":"doc:\/\/SimulationModule\/documentation\/SimulationModule\/Simulation\/add(state:)","isActive":true},{"type":"text","text":". The simulation keeps the current state in the "},{"type":"reference","identifier":"doc:\/\/SimulationModule\/documentation\/SimulationModule\/CurrentState","isActive":true},{"type":"text","text":" "},{"type":"text","text":"resource; to change it, a system sets "},{"type":"reference","identifier":"doc:\/\/SimulationModule\/documentation\/SimulationModule\/NextState","isActive":true},{"type":"text","text":", and the change applies at the start of the"},{"type":"text","text":" "},{"type":"text","text":"next frame. Entering, leaving and moving between states run schedules of their own,"},{"type":"text","text":" "},{"type":"reference","identifier":"doc:\/\/SimulationModule\/documentation\/SimulationModule\/ScheduleLabel\/onEnter(_:)","isActive":true},{"type":"text","text":", "},{"type":"reference","identifier":"doc:\/\/SimulationModule\/documentation\/SimulationModule\/ScheduleLabel\/onExit(_:)","isActive":true},{"type":"text","text":" and"},{"type":"text","text":" "},{"type":"reference","identifier":"doc:\/\/SimulationModule\/documentation\/SimulationModule\/ScheduleLabel\/onTransition(from:to:)","isActive":true},{"type":"text","text":", and "},{"type":"reference","identifier":"doc:\/\/SimulationModule\/documentation\/SimulationModule\/inState(_:)","isActive":true},{"type":"text","text":" makes a run condition that holds"},{"type":"text","text":" "},{"type":"text","text":"only in one state."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"The following example spawns a ball on entering the "},{"type":"codeVoice","code":"playing"},{"type":"text","text":" state and moves it only while the"},{"type":"text","text":" "},{"type":"text","text":"game is in that state:"}],"type":"paragraph"},{"code":["var simulation = Simulation()","simulation.add(state: GameState.menu)","simulation.add(to: .onEnter(GameState.playing)) { SpawnBall() }","simulation.add(to: .fixedUpdate) { Physics().runIf(inState(GameState.playing)) }","","simulation.update(elapsed: .milliseconds(50))","print(simulation.world.count)","\/\/ Prints \"0\"","","simulation.world.resources[NextState<GameState>.self].set(.playing)","simulation.update(elapsed: .milliseconds(50))","print(simulation.world.resources[CurrentState<GameState>.self].state)","\/\/ Prints \"playing\"","for (_, position) in simulation.world.query(Position.self) {","    print(position)  \/\/ Prints \"Position(x: 3.0)\"","}"],"type":"codeListing","syntax":"swift"}],"kind":"content"}],"metadata":{"externalID":"SimulationModule","title":"SimulationModule","modules":[{"name":"SimulationModule"}],"roleHeading":"Framework","symbolKind":"module","role":"collection"},"kind":"symbol","abstract":[{"text":"Run a world frame by frame, with schedules for startup, a fixed timestep and each frame, and","type":"text"},{"text":" ","type":"text"},{"text":"with states that switch systems on and off.","type":"text"}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/simulationmodule"]}],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/SimulationModule\/documentation\/SimulationModule"},"references":{"doc://SimulationModule/documentation/SimulationModule/States":{"identifier":"doc:\/\/SimulationModule\/documentation\/SimulationModule\/States","fragments":[{"text":"protocol","kind":"keyword"},{"text":" ","kind":"text"},{"text":"States","kind":"identifier"}],"role":"symbol","kind":"symbol","abstract":[{"type":"text","text":"A type whose values are the states a simulation can be in."}],"type":"topic","title":"States","navigatorTitle":[{"text":"States","kind":"identifier"}],"url":"\/documentation\/simulationmodule\/states"},"doc://SimulationModule/documentation/SimulationModule":{"type":"topic","url":"\/documentation\/simulationmodule","abstract":[{"text":"Run a world frame by frame, with schedules for startup, a fixed timestep and each frame, and","type":"text"},{"text":" ","type":"text"},{"text":"with states that switch systems on and off.","type":"text"}],"kind":"symbol","role":"collection","title":"SimulationModule","identifier":"doc:\/\/SimulationModule\/documentation\/SimulationModule"},"doc://SimulationModule/documentation/SimulationModule/ScheduleLabel/startup":{"role":"symbol","url":"\/documentation\/simulationmodule\/schedulelabel\/startup","fragments":[{"text":"static","kind":"keyword"},{"text":" ","kind":"text"},{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"startup","kind":"identifier"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:16SimulationModule13ScheduleLabelV","kind":"typeIdentifier","text":"ScheduleLabel"}],"title":"startup","type":"topic","kind":"symbol","identifier":"doc:\/\/SimulationModule\/documentation\/SimulationModule\/ScheduleLabel\/startup","abstract":[{"type":"text","text":"The label of the schedule that runs once, before the first frame."}]},"doc://SimulationModule/documentation/SimulationModule/Simulation/add(state:)":{"url":"\/documentation\/simulationmodule\/simulation\/add(state:)","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"add"},{"kind":"text","text":"<"},{"kind":"genericParameter","text":"S"},{"kind":"text","text":">("},{"kind":"externalParam","text":"state"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"S"},{"kind":"text","text":")"}],"role":"symbol","abstract":[{"text":"Adds a state type to the simulation, starting in the given state.","type":"text"}],"kind":"symbol","type":"topic","title":"add(state:)","identifier":"doc:\/\/SimulationModule\/documentation\/SimulationModule\/Simulation\/add(state:)"},"doc://SimulationModule/documentation/SimulationModule/ScheduleLabel":{"url":"\/documentation\/simulationmodule\/schedulelabel","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"ScheduleLabel"}],"role":"symbol","kind":"symbol","abstract":[{"type":"text","text":"The name of a schedule in a simulation."}],"type":"topic","title":"ScheduleLabel","navigatorTitle":[{"kind":"identifier","text":"ScheduleLabel"}],"identifier":"doc:\/\/SimulationModule\/documentation\/SimulationModule\/ScheduleLabel"},"doc://SimulationModule/documentation/SimulationModule/ScheduleLabel/onTransition(from:to:)":{"fragments":[{"text":"static","kind":"keyword"},{"text":" ","kind":"text"},{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"onTransition","kind":"identifier"},{"text":"<","kind":"text"},{"text":"S","kind":"genericParameter"},{"text":">(","kind":"text"},{"text":"from","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"S","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"to","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"S","kind":"typeIdentifier"},{"text":") -> ","kind":"text"},{"text":"ScheduleLabel","kind":"typeIdentifier","preciseIdentifier":"s:16SimulationModule13ScheduleLabelV"}],"type":"topic","url":"\/documentation\/simulationmodule\/schedulelabel\/ontransition(from:to:)","abstract":[{"text":"Returns the label of the schedule that runs when a simulation changes from one given state","type":"text"},{"text":" ","type":"text"},{"text":"to another.","type":"text"}],"kind":"symbol","role":"symbol","title":"onTransition(from:to:)","identifier":"doc:\/\/SimulationModule\/documentation\/SimulationModule\/ScheduleLabel\/onTransition(from:to:)"},"doc://SimulationModule/documentation/SimulationModule/Time":{"navigatorTitle":[{"text":"Time","kind":"identifier"}],"fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Time","kind":"identifier"}],"type":"topic","url":"\/documentation\/simulationmodule\/time","abstract":[{"type":"text","text":"A resource holding the time a simulation has advanced."}],"kind":"symbol","role":"symbol","title":"Time","identifier":"doc:\/\/SimulationModule\/documentation\/SimulationModule\/Time"},"doc://SimulationModule/documentation/SimulationModule/Simulation/update(elapsed:)":{"identifier":"doc:\/\/SimulationModule\/documentation\/SimulationModule\/Simulation\/update(elapsed:)","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"update","kind":"identifier"},{"text":"(","kind":"text"},{"text":"elapsed","kind":"externalParam"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:s8DurationV","text":"Duration","kind":"typeIdentifier"},{"text":")","kind":"text"}],"role":"symbol","abstract":[{"text":"Advances the simulation by one frame.","type":"text"}],"kind":"symbol","type":"topic","title":"update(elapsed:)","url":"\/documentation\/simulationmodule\/simulation\/update(elapsed:)"},"doc://SimulationModule/documentation/SimulationModule/NonPositi