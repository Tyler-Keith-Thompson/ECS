{"variants":[{"paths":["\/documentation\/simulationmodule"],"traits":[{"interfaceLanguage":"swift"}]}],"identifier":{"url":"doc:\/\/SimulationModule\/documentation\/SimulationModule","interfaceLanguage":"swift"},"hierarchy":{"paths":[[]]},"schemaVersion":{"patch":0,"major":0,"minor":3},"primaryContentSections":[{"content":[{"level":2,"anchor":"Overview","type":"heading","text":"Overview"},{"type":"paragraph","inlineContent":[{"type":"text","text":"A "},{"type":"reference","isActive":true,"identifier":"doc:\/\/SimulationModule\/documentation\/SimulationModule\/Simulation"},{"type":"text","text":" owns a world and a set of schedules, each named by a "},{"type":"reference","isActive":true,"identifier":"doc:\/\/SimulationModule\/documentation\/SimulationModule\/ScheduleLabel"},{"type":"text","text":". You add"},{"type":"text","text":" "},{"type":"text","text":"systems to the schedules by label, then call "},{"type":"reference","isActive":true,"identifier":"doc:\/\/SimulationModule\/documentation\/SimulationModule\/Simulation\/update(elapsed:)"},{"type":"text","text":" once a frame with the"},{"type":"text","text":" "},{"type":"text","text":"time that passed. The simulation decides which schedules run:"}]},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"isActive":true,"type":"reference","identifier":"doc:\/\/SimulationModule\/documentation\/SimulationModule\/ScheduleLabel\/startup"},{"text":" runs once, before the first frame.","type":"text"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"reference","identifier":"doc:\/\/SimulationModule\/documentation\/SimulationModule\/ScheduleLabel\/fixedUpdate","isActive":true},{"text":" runs once for every fixed timestep of time that has passed, so","type":"text"},{"text":" ","type":"text"},{"text":"physics and other rate-sensitive rules advance by the same amount each run, however uneven the","type":"text"},{"text":" ","type":"text"},{"text":"frames are.","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"isActive":true,"identifier":"doc:\/\/SimulationModule\/documentation\/SimulationModule\/ScheduleLabel\/update","type":"reference"},{"type":"text","text":" runs once a frame."}]}]}]},{"type":"paragraph","inlineContent":[{"text":"The examples throughout this module use these components, resources and systems:","type":"text"}]},{"syntax":"swift","type":"codeListing","code":["struct Position: Component { var x: Double }","struct Velocity: Component { var dx: Double }","struct FixedSteps: Resource { var count = 0 }","enum GameState: States { case menu, playing, paused }","","\/\/\/ Moves each entity by its velocity over one fixed timestep.","@System","struct Physics {","    func run(_ movers: Update<Position>.Over<Velocity>, _ fixedTime: ResourceReader<FixedTime>) {","        let seconds = fixedTime.value.timestep \/ .seconds(1)","        movers { position, row in","            position.x += row.components.dx * seconds","        }","    }","}","","\/\/\/ Counts the runs of the schedule it is in.","@System","struct CountSteps {","    func run(_ steps: ResourceWriter<FixedSteps>) {","        steps.value.count += 1","    }","}","","\/\/\/ Spawns a ball at the origin.","@System","struct SpawnBall {","    func run(commands: inout Commands) {","        commands.spawn(Position(x: 0), Velocity(dx: 64))","    }","}"]},{"type":"paragraph","inlineContent":[{"type":"text","text":"The following example runs "},{"type":"codeVoice","code":"Physics"},{"type":"text","text":" on a fixed timestep of 1\/64 second, the default. A frame"},{"type":"text","text":" "},{"type":"text","text":"of 50 milliseconds covers three whole timesteps, so the ball moves three times:"}]},{"syntax":"swift","type":"codeListing","code":["var world = World()","let ball = world.spawn(Position(x: 0), Velocity(dx: 64))","","var simulation = Simulation(world)","simulation.add(to: .fixedUpdate) { Physics() }","simulation.update(elapsed: .milliseconds(50))","","print(simulation.world[Position.self, of: ball])","\/\/ Prints \"Position(x: 3.0)\""]},{"level":3,"anchor":"States","type":"heading","text":"States"},{"type":"paragraph","inlineContent":[{"text":"A state type is a type, usually an enumeration, that conforms to ","type":"text"},{"identifier":"doc:\/\/SimulationModule\/documentation\/SimulationModule\/States","type":"reference","isActive":true},{"text":": the screens of a","type":"text"},{"text":" ","type":"text"},{"text":"game, or the phases of a simulation. Add one to a simulation with","type":"text"},{"text":" ","type":"text"},{"identifier":"doc:\/\/SimulationModule\/documentation\/SimulationModule\/Simulation\/add(state:)","type":"reference","isActive":true},{"text":". The simulation keeps the current state in the ","type":"text"},{"identifier":"doc:\/\/SimulationModule\/documentation\/SimulationModule\/CurrentState","type":"reference","isActive":true},{"text":" ","type":"text"},{"text":"resource; to change it, a system sets ","type":"text"},{"identifier":"doc:\/\/SimulationModule\/documentation\/SimulationModule\/NextState","type":"reference","isActive":true},{"text":", and the change applies at the start of the","type":"text"},{"text":" ","type":"text"},{"text":"next frame. Entering, leaving and moving between states run schedules of their own,","type":"text"},{"text":" ","type":"text"},{"identifier":"doc:\/\/SimulationModule\/documentation\/SimulationModule\/ScheduleLabel\/onEnter(_:)","type":"reference","isActive":true},{"text":", ","type":"text"},{"identifier":"doc:\/\/SimulationModule\/documentation\/SimulationModule\/ScheduleLabel\/onExit(_:)","type":"reference","isActive":true},{"text":" and","type":"text"},{"text":" ","type":"text"},{"identifier":"doc:\/\/SimulationModule\/documentation\/SimulationModule\/ScheduleLabel\/onTransition(from:to:)","type":"reference","isActive":true},{"text":", and ","type":"text"},{"identifier":"doc:\/\/SimulationModule\/documentation\/SimulationModule\/inState(_:)","type":"reference","isActive":true},{"text":" makes a run condition that holds","type":"text"},{"text":" ","type":"text"},{"text":"only in one state.","type":"text"}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"The following example spawns a ball on entering the "},{"code":"playing","type":"codeVoice"},{"type":"text","text":" state and moves it only while the"},{"type":"text","text":" "},{"type":"text","text":"game is in that state:"}]},{"syntax":"swift","type":"codeListing","code":["var simulation = Simulation()","simulation.add(state: GameState.menu)","simulation.add(to: .onEnter(GameState.playing)) { SpawnBall() }","simulation.add(to: .fixedUpdate) { Physics().runIf(inState(GameState.playing)) }","","simulation.update(elapsed: .milliseconds(50))","print(simulation.world.count)","\/\/ Prints \"0\"","","simulation.world.resources[NextState<GameState>.self].set(.playing)","simulation.update(elapsed: .milliseconds(50))","print(simulation.world.resources[CurrentState<GameState>.self].state)","\/\/ Prints \"playing\"","for (_, position) in simulation.world.query(Position.self) {","    print(position)  \/\/ Prints \"Position(x: 3.0)\"","}"]}],"kind":"content"}],"topicSections":[{"identifiers":["doc:\/\/SimulationModule\/documentation\/SimulationModule\/Simulation","doc:\/\/SimulationModule\/documentation\/SimulationModule\/ScheduleLabel","doc:\/\/SimulationModule\/documentation\/SimulationModule\/NonPositiveDuration"],"anchor":"Simulations","title":"Simulations"},{"identifiers":["doc:\/\/SimulationModule\/documentation\/SimulationModule\/Time","doc:\/\/SimulationModule\/documentation\/SimulationModule\/FixedTime"],"anchor":"Time","title":"Time"},{"identifiers":["doc:\/\/SimulationModule\/documentation\/SimulationModule\/States","doc:\/\/SimulationModule\/documentation\/SimulationModule\/CurrentState","doc:\/\/SimulationModule\/documentation\/SimulationModule\/NextState","doc:\/\/SimulationModule\/documentation\/SimulationModule\/inState(_:)"],"anchor":"States","title":"States"}],"abstract":[{"text":"Run a world frame by frame, with schedules for startup, a fixed timestep and each frame, and","type":"text"},{"text":" ","type":"text"},{"text":"with states that switch systems on and off.","type":"text"}],"kind":"symbol","metadata":{"modules":[{"name":"SimulationModule"}],"roleHeading":"Framework","externalID":"SimulationModule","role":"collection","symbolKind":"module","title":"SimulationModule"},"sections":[],"references":{"doc://SimulationModule/documentation/SimulationModule/ScheduleLabel":{"role":"symbol","type":"topic","abstract":[{"text":"The name of a schedule in a simulation.","type":"text"}],"kind":"symbol","navigatorTitle":[{"text":"ScheduleLabel","kind":"identifier"}],"url":"\/documentation\/simulationmodule\/schedulelabel","identifier":"doc:\/\/SimulationModule\/documentation\/SimulationModule\/ScheduleLabel","title":"ScheduleLabel","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"ScheduleLabel","kind":"identifier"}]},"doc://SimulationModule/documentation/SimulationModule/ScheduleLabel/onTransition(from:to:)":{"identifier":"doc:\/\/SimulationModule\/documentation\/SimulationModule\/ScheduleLabel\/onTransition(from:to:)","type":"topic","role":"symbol","fragments":[{"text":"static","kind":"keyword"},{"text":" ","kind":"text"},{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"onTransition","kind":"identifier"},{"text":"<","kind":"text"},{"text":"S","kind":"genericParameter"},{"text":">(","kind":"text"},{"text":"from","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"S","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"to","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"S","kind":"typeIdentifier"},{"text":") -> ","kind":"text"},{"preciseIdentifier":"s:16SimulationModule13ScheduleLabelV","text":"ScheduleLabel","kind":"typeIdentifier"}],"url":"\/documentation\/simulationmodule\/schedulelabel\/ontransition(from:to:)","abstract":[{"type":"text","te