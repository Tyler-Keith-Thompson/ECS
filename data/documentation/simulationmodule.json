t"},{"text":"add","kind":"identifier"},{"text":"<","kind":"text"},{"text":"S","kind":"genericParameter"},{"text":">(","kind":"text"},{"text":"state","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"S","kind":"typeIdentifier"},{"text":")","kind":"text"}],"identifier":"doc:\/\/SimulationModule\/documentation\/SimulationModule\/Simulation\/add(state:)","kind":"symbol","role":"symbol","type":"topic"},"doc://SimulationModule/documentation/SimulationModule/FixedTime":{"url":"\/documentation\/simulationmodule\/fixedtime","abstract":[{"type":"text","text":"A resource holding the fixed timestep of a simulation."}],"title":"FixedTime","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"FixedTime","kind":"identifier"}],"identifier":"doc:\/\/SimulationModule\/documentation\/SimulationModule\/FixedTime","navigatorTitle":[{"text":"FixedTime","kind":"identifier"}],"kind":"symbol","role":"symbol","type":"topic"}}}