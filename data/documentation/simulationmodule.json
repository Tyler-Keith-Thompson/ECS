le\/CurrentState","abstract":[{"text":"A resource holding the state a simulation is in.","type":"text"}],"type":"topic","url":"\/documentation\/simulationmodule\/currentstate","role":"symbol","navigatorTitle":[{"text":"CurrentState","kind":"identifier"}],"fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"CurrentState","kind":"identifier"}]},"doc://SimulationModule/documentation/SimulationModule/States":{"url":"\/documentation\/simulationmodule\/states","title":"States","abstract":[{"text":"A type whose values are the states a simulation can be in.","type":"text"}],"fragments":[{"kind":"keyword","text":"protocol"},{"kind":"text","text":" "},{"kind":"identifier","text":"States"}],"identifier":"doc:\/\/SimulationModule\/documentation\/SimulationModule\/States","navigatorTitle":[{"kind":"identifier","text":"States"}],"kind":"symbol","role":"symbol","type":"topic"},"doc://SimulationModule/documentation/SimulationModule/NextState":{"identifier":"doc:\/\/SimulationModule\/documentation\/SimulationModule\/NextState","kind":"symbol","navigatorTitle":[{"kind":"identifier","text":"NextState"}],"type":"topic","url":"\/documentation\/simulationmodule\/nextstate","role":"symbol","abstract":[{"type":"text","text":"A resource holding the state a simulation enters at the start of its next frame."}],"fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"NextState"}],"title":"NextState"},"doc://SimulationModule/documentation/SimulationModule/ScheduleLabel/fixedUpdate":{"title":"fixedUpdate","kind":"symbol","identifier":"doc:\/\/SimulationModule\/documentation\/SimulationModule\/ScheduleLabel\/fixedUpdate","abstract":[{"text":"The label of the schedule that runs once for each fixed timestep of elapsed time.","type":"text"}],"type":"topic","url":"\/documentation\/simulationmodule\/schedulelabel\/fixedupdate","role":"symbol","fragments":[{"text":"static","kind":"keyword"},{"text":" ","kind":"text"},{"text":