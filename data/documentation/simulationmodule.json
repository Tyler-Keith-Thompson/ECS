dule","kind":"symbol","type":"topic","url":"\/documentation\/simulationmodule","identifier":"doc:\/\/SimulationModule\/documentation\/SimulationModule","role":"collection","abstract":[{"type":"text","text":"Run a world frame by frame, with schedules for startup, a fixed timestep and each frame, and"},{"type":"text","text":" "},{"type":"text","text":"with states that switch systems on and off."}]},"doc://SimulationModule/documentation/SimulationModule/CurrentState":{"url":"\/documentation\/simulationmodule\/currentstate","abstract":[{"type":"text","text":"A resource holding the state a simulation is in."}],"title":"CurrentState","navigatorTitle":[{"kind":"identifier","text":"CurrentState"}],"kind":"symbol","type":"topic","role":"symbol","identifier":"doc:\/\/SimulationModule\/documentation\/SimulationModule\/CurrentState","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"CurrentState"}]}}}