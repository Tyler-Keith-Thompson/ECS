{"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/simulationmodule"]}],"primaryContentSections":[{"kind":"content","content":[{"text":"Overview","level":2,"anchor":"Overview","type":"heading"},{"inlineContent":[{"type":"text","text":"A "},{"identifier":"doc:\/\/SimulationModule\/documentation\/SimulationModule\/Simulation","isActive":true,"type":"reference"},{"type":"text","text":" owns a world and a set of schedules, each named by a "},{"identifier":"doc:\/\/SimulationModule\/documentation\/SimulationModule\/ScheduleLabel","isActive":true,"type":"reference"},{"type":"text","text":". You add"},{"type":"text","text":" "},{"type":"text","text":"systems to the schedules by label, then call "},{"identifier":"doc:\/\/SimulationModule\/documentation\/SimulationModule\/Simulation\/update(elapsed:)","isActive":true,"type":"reference"},{"type":"text","text":" once a frame with the"},{"type":"text","text":" "},{"type":"text","text":"time that passed. The simulation decides which schedules run:"}],"type":"paragraph"},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"identifier":"doc:\/\/SimulationModule\/documentation\/SimulationModule\/ScheduleLabel\/startup","isActive":true,"type":"reference"},{"text":" runs once, before the first frame.","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"reference","identifier":"doc:\/\/SimulationModule\/documentation\/SimulationModule\/ScheduleLabel\/fixedUpdate","isActive":true},{"type":"text","text":" runs once for every fixed timestep of time that has passed, so"},{"type":"text","text":" "},{"type":"text","text":"physics and other rate-sensitive rules advance by the same amount each run, however uneven the"},{"type":"text","text":" "},{"type":"text","text":"frames are."}]}]},{"content":[{"inlineContent":[{"type":"reference","isActive":true,"identifier":"doc:\/\/SimulationModule\/documentation\/SimulationModule\/ScheduleLabel\/update"},{"type":"text","text":" runs once a frame."}],"type":"paragraph"}]}],"type":"unorderedList"},{"inlineContent":[{"type":"text","text":"The examples throughout this module use these components, resources and systems:"}],"type":"paragraph"},{"code":["struct Position: Component { var x: Double }","struct Velocity: Component { var dx: Double }","struct FixedSteps: Resource { var count = 0 }","enum GameState: States { case menu, playing, paused }","","\/\/\/ Moves each entity by its velocity over one fixed timestep.","@System","struct Physics {","    func run(_ movers: Update<Position>.Over<Velocity>, _ fixedTime: ResourceReader<FixedTime>) {","        let seconds = fixedTime.value.timestep \/ .seconds(1)","        movers { position, row in","            position.x += row.components.dx * seconds","        }","    }","}","","\/\/\/ Counts the runs of the schedule it is in.","@System","struct CountSteps {","    func run(_ steps: ResourceWriter<FixedSteps>) {","        steps.value.count += 1","    }","}","","\/\/\/ Spawns a ball at the origin.","@System","struct SpawnBall {","    func run(commands: inout Commands) {","        commands.spawn(Position(x: 0), Velocity(dx: 64))","    }","}"],"syntax":"swift","type":"codeListing"},{"inlineContent":[{"text":"The following example runs ","type":"text"},{"code":"Physics","type":"codeVoice"},{"text":" on a fixed timestep of 1\/64 second, the default. A frame","type":"text"},{"text":" ","type":"text"},{"text":"of 50 milliseconds covers three whole timesteps, so the ball moves three times:","type":"text"}],"type":"paragraph"},{"code":["var world = World()","let ball = world.spawn(Position(x: 0), Velocity(dx: 64))","","var simulation = Simulation(world)","simulation.add(to: .fixedUpdate) { Physics() }","simulation.update(elapsed: .milliseconds(50))","","print(simulation.world[Position.self, of: ball])","\/\/ Prints \"Position(x: 3.0)\""],"syntax":"swift","type":"codeListing"},{"text":"States","level":3,"anchor":"States","type":"heading"},{"inlineContent":[{"type":"text","text":"A state type is a type, usually an enumeration, that conforms to "},{"type":"reference","isActive":true,"identifier":"doc:\/\/SimulationModule\/documentation\/SimulationModule\/States"},{"type":"text","text":": the screens of a"},{"type":"text","text":" "},{"type":"text","text":"game, or the phases of a simulation. Add one to a simulation with"},{"type":"text","text":" "},{"type":"reference","isActive":true,"identifier":"doc:\/\/SimulationModule\/documentation\/SimulationModule\/Simulation\/add(state:)"},{"type":"text","text":". The simulation keeps the current state in the "},{"type":"reference","isActive":true,"identifier":"doc:\/\/SimulationModule\/documentation\/SimulationModule\/CurrentState"},{"type":"text","text":" "},{"type":"text","text":"resource; to change it, a system sets "},{"type":"reference","isActive":true,"identifier":"doc:\/\/SimulationModule\/documentation\/SimulationModule\/NextState"},{"type":"text","text":", and the change applies at the start of the"},{"type":"text","text":" "},{"type":"text","text":"next frame. Entering, leaving and moving between states run schedules of their own,"},{"type":"text","text":" "},{"type":"reference","isActive":true,"identifier":"doc:\/\/SimulationModule\/documentation\/SimulationModule\/ScheduleLabel\/onEnter(_:)"},{"type":"text","text":", "},{"type":"reference","isActive":true,"identifier":"doc:\/\/SimulationModule\/documentation\/SimulationModule\/ScheduleLabel\/onExit(_:)"},{"type":"text","text":" and"},{"type":"text","text":" "},{"type":"reference","isActive":true,"identifier":"doc:\/\/SimulationModule\/documentation\/SimulationModule\/ScheduleLabel\/onTransition(from:to:)"},{"type":"text","text":", and "},{"type":"reference","isActive":true,"identifier":"doc:\/\/SimulationModule\/documentation\/SimulationModule\/inState(_:)"},{"type":"text","text":" makes a run condition that holds"},{"type":"text","text":" "},{"type":"text","text":"only in one state."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"The following example spawns a ball on entering the "},{"type":"codeVoice","code":"playing"},{"type":"text","text":" state and moves it only while the"},{"type":"text","text":" "},{"type":"text","text":"game is in that state:"}],"type":"paragraph"},{"code":["var simulation = Simulation()","simulation.add(state: GameState.menu)","simulation.add(to: .onEnter(GameState.playing)) { SpawnBall() }","simulation.add(to: .fixedUpdate) { Physics().runIf(inState(GameState.playing)) }","","simulation.update(elapsed: .milliseconds(50))","print(simulation.world.count)","\/\/ Prints \"0\"","","simulation.world.resources[NextState<GameState>.self].set(.playing)","simulation.update(elapsed: .milliseconds(50))","print(simulation.world.resources[CurrentState<GameState>.self].state)","\/\/ Prints \"playing\"","for (_, position) in simulation.world.query(Position.self) {","    print(position)  \/\/ Prints \"Position(x: 3.0)\"","}"],"syntax":"swift","type":"codeListing"}]}],"abstract":[{"type":"text","text":"Run a world frame by frame, with schedules for startup, a fixed timestep and each frame, and"},{"type":"text","text":" "},{"type":"text","text":"with states that switch systems on and off."}],"schemaVersion":{"major":0,"patch":0,"minor":3},"metadata":{"externalID":"SimulationModule","symbolKind":"module","modules":[{"name":"SimulationModule"}],"role":"collection","title":"SimulationModule","roleHeading":"Framework"},"topicSections":[{"identifiers":["doc:\/\/SimulationModule\/documentation\/SimulationModule\/Simulation","doc:\/\/SimulationModule\/documentation\/SimulationModule\/ScheduleLabel","doc:\/\/SimulationModule\/documentation\/SimulationModule\/NonPositiveDuration"],"anchor":"Simulations","title":"Simulations"},{"identifiers":["doc:\/\/SimulationModule\/documentation\/SimulationModule\/Time","doc:\/\/SimulationModule\/documentation\/SimulationModule\/FixedTime"],"anchor":"Time","title":"Time"},{"identifiers":["doc:\/\/SimulationModule\/documentation\/SimulationModule\/States","doc:\/\/SimulationModule\/documentation\/SimulationModule\/CurrentState","doc:\/\/SimulationModule\/documentation\/SimulationModule\/NextState","doc:\/\/SimulationModule\/documentation\/SimulationModule\/inState(_:)"],"anchor":"States","title":"States"}],"sections":[],"kind":"symbol","identifier":{"interfaceLanguage":"swift","url":"doc:\/\/SimulationModule\/documentation\/SimulationModule"},"hierarchy":{"paths":[[]]},"references":{"doc://SimulationModule/documentation/SimulationModule/Time":{"navigatorTitle":[{"text":"Time","kind":"identifier"}],"role":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Time","kind":"identifier"}],"type":"topic","abstract":[{"text":"A resource holding the time a simulation has advanced.","type":"text"}],"url":"\/documentation\/simulationmodule\/time","kind":"symbol","identifier":"doc:\/\/SimulationModule\/documentation\/SimulationModule\/Time","title":"Time"},"doc://SimulationModule/documentation/SimulationModule/ScheduleLabel/onExit(_:)":{"identifier":"doc:\/\/SimulationModule\/documentation\/SimulationModule\/ScheduleLabel\/onExit(_:)","title":"onExit(_:)","kind":"symbol","role":"symbol","type":"topic","fragments":[{"kind":"keyword","text":"static"},{"kind":"text","text":" "},{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"onExit"},{"kind":"text","text":"<"},{"kind":"genericParameter","text":"S"},{"kind":"text","text":">("},{"kind":"typeIdentifier","text":"S"},{"kind":"text","text":") -> "},{"kind":"typeIdentifier","preciseIdentifier":"s:16SimulationModule13ScheduleLabelV","text":"ScheduleLabel"}],"abstract":[{"text":"Returns the label of the schedule that runs when a simulation leaves the given state.","type":"text"}],"url":"\/documentation\/simulationmodule\/schedulelabel\/onexit(_:)"},"doc://SimulationModule/documentation/SimulationModule/Simulation/update(elapsed:)":{"role":"symbol","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"update","kind":"identifier"},{"text":"(","kind":"text"},{"text":"elapsed","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"Duration","kind":"typeIdentifier","preciseIdentifier":"s:s8DurationV"},{"text":")","kind":"text"}],"type":"topic","abstract":[{"type":"text","text":"Advances the simulation by one frame."}],"url":"\/documentation\/simulationmodule\/simulation\/update(elapsed:)","kind":"symbol","identifier":"doc:\/\/SimulationModule\/documentation\/SimulationModule\/Simulation\/update(elapsed:)","title":"update(elapsed:)"},"doc://SimulationModule/documentation/SimulationModule/CurrentState":{"identifier":"doc:\/\/SimulationModule\/documentation\/SimulationModule\/CurrentState","title":"CurrentState","kind":"symbol","navigatorTitle":[{"text":"CurrentState","kind":"identifier"}],"role":"symbol","type":"topic","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"CurrentState","kind":"identifier"}],"abstract":[{"text":"A resource holding the state a simulation is in.","type":"text"}],"url":"\/documentation\/simulationmodule\/currentstate"},"doc://SimulationModule/documentation/SimulationModule/States":{"kind":"symbol","identifier":"doc:\/\/SimulationModule\/documentation\/SimulationModule\/States","type":"topic","fragments":[{"text":"protocol","kind":"keyword"},{"text":" ","kind":"text"},{"text":"States","kind":"identifier"}],"abstract":[{"type":"text","text":"A type whose values are the states a simulation can be in."}],"navigatorTitle":[{"text":"States","kind":"identifier"}],"url":"\/documentation\/simulationmodule\/states","title":"States","role":"symbol"},"doc://SimulationModule/documentation/SimulationModule/inState(_:)":{"role":"symbol","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"inState","kind":"identifier"},{"text":"<","kind":"text"},{"text":"S","kind":"genericParameter"},{"text":">(","kind":"text"},{"text":"S","kind":"typeIdentifier"},{"text"