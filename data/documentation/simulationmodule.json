{"hierarchy":{"paths":[[]]},"schemaVersion":{"patch":0,"major":0,"minor":3},"topicSections":[{"title":"Simulations","anchor":"Simulations","identifiers":["doc:\/\/SimulationModule\/documentation\/SimulationModule\/Simulation","doc:\/\/SimulationModule\/documentation\/SimulationModule\/ScheduleLabel","doc:\/\/SimulationModule\/documentation\/SimulationModule\/NonPositiveDuration"]},{"title":"Time","anchor":"Time","identifiers":["doc:\/\/SimulationModule\/documentation\/SimulationModule\/Time","doc:\/\/SimulationModule\/documentation\/SimulationModule\/FixedTime"]},{"title":"States","anchor":"States","identifiers":["doc:\/\/SimulationModule\/documentation\/SimulationModule\/States","doc:\/\/SimulationModule\/documentation\/SimulationModule\/CurrentState","doc:\/\/SimulationModule\/documentation\/SimulationModule\/NextState","doc:\/\/SimulationModule\/documentation\/SimulationModule\/inState(_:)"]}],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/SimulationModule\/documentation\/SimulationModule"},"kind":"symbol","primaryContentSections":[{"content":[{"text":"Overview","level":2,"anchor":"Overview","type":"heading"},{"inlineContent":[{"type":"text","text":"A "},{"type":"reference","isActive":true,"identifier":"doc:\/\/SimulationModule\/documentation\/SimulationModule\/Simulation"},{"type":"text","text":" owns a world and a set of schedules, each named by a "},{"type":"reference","isActive":true,"identifier":"doc:\/\/SimulationModule\/documentation\/SimulationModule\/ScheduleLabel"},{"type":"text","text":". You add"},{"type":"text","text":" "},{"type":"text","text":"systems to the schedules by label, then call "},{"type":"reference","isActive":true,"identifier":"doc:\/\/SimulationModule\/documentation\/SimulationModule\/Simulation\/update(elapsed:)"},{"type":"text","text":" once a frame with the"},{"type":"text","text":" "},{"type":"text","text":"time that passed. The simulation decides which schedules run:"}],"type":"paragraph"},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"reference","identifier":"doc:\/\/SimulationModule\/documentation\/SimulationModule\/ScheduleLabel\/startup","isActive":true},{"text":" runs once, before the first frame.","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"identifier":"doc:\/\/SimulationModule\/documentation\/SimulationModule\/ScheduleLabel\/fixedUpdate","type":"reference","isActive":true},{"text":" runs once for every fixed timestep of time that has passed, so","type":"text"},{"text":" ","type":"text"},{"text":"physics and other rate-sensitive rules advance by the same amount each run, however uneven the","type":"text"},{"text":" ","type":"text"},{"text":"frames are.","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"isActive":true,"identifier":"doc:\/\/SimulationModule\/documentation\/SimulationModule\/ScheduleLabel\/update","type":"reference"},{"text":" runs once a frame.","type":"text"}]}]}],"type":"unorderedList"},{"inlineContent":[{"text":"The examples throughout this module use these components, resources and systems:","type":"text"}],"type":"paragraph"},{"syntax":"swift","code":["struct Position: Component { var x: Double }","struct Velocity: Component { var dx: Double }","struct FixedSteps: Resource { var count = 0 }","enum GameState: States { case menu, playing, paused }","","\/\/\/ Moves each entity by its velocity over one fixed timestep.","@System","struct Physics {","    func run(_ movers: Update<Position>.Over<Velocity>, _ fixedTime: ResourceReader<FixedTime>) {","        let seconds = fixedTime.value.timestep \/ .seconds(1)","        movers { position, row in","            position.x += row.components.dx * seconds","        }","    }","}","","\/\/\/ Counts the runs of the schedule it is in.","@System","struct CountSteps {","    func run(_ steps: ResourceWriter<FixedSteps>) {","        steps.value.count += 1","    }","}","","\/\/\/ Spawns a ball at the origin.","@System","struct SpawnBall {","    func run(commands: inout Commands) {","        commands.spawn(Position(x: 0), Velocity(dx: 64))","    }","}"],"type":"codeListing"},{"inlineContent":[{"type":"text","text":"The following example runs "},{"type":"codeVoice","code":"Physics"},{"type":"text","text":" on a fixed timestep of 1\/64 second, the default. A frame"},{"type":"text","text":" "},{"type":"text","text":"of 50 milliseconds covers three whole timesteps, so the ball moves three times:"}],"type":"paragraph"},{"syntax":"swift","code":["var world = World()","let ball = world.spawn(Position(x: 0), Velocity(dx: 64))","","var simulation = Simulation(world)","simulation.add(to: .fixedUpdate) { Physics() }","simulation.update(elapsed: .milliseconds(50))","","print(simulation.world[Position.self, of: ball])","\/\/ Prints \"Position(x: 3.0)\""],"type":"codeListing"},{"text":"States","level":3,"anchor":"States","type":"heading"},{"inlineContent":[{"type":"text","text":"A state type is a type, usually an enumeration, that conforms to "},{"type":"reference","isActive":true,"identifier":"doc:\/\/SimulationModule\/documentation\/SimulationModule\/States"},{"type":"text","text":": the screens of a"},{"type":"text","text":" "},{"type":"text","text":"game, or the phases of a simulation. Add one to a simulation with"},{"type":"text","text":" "},{"type":"reference","isActive":true,"identifier":"doc:\/\/SimulationModule\/documentation\/SimulationModule\/Simulation\/add(state:)"},{"type":"text","text":". The simulation keeps the current state in the "},{"type":"reference","isActive":true,"identifier":"doc:\/\/SimulationModule\/documentation\/SimulationModule\/CurrentState"},{"type":"text","text":" "},{"type":"text","text":"resource; to change it, a system sets "},{"type":"reference","isActive":true,"identifier":"doc:\/\/SimulationModule\/documentation\/SimulationModule\/NextState"},{"type":"text","text":", and the change applies at the start of the"},{"type":"text","text":" "},{"type":"text","text":"next frame. Entering, leaving and moving between states run schedules of their own,"},{"type":"text","text":" "},{"type":"reference","isActive":true,"identifier":"doc:\/\/SimulationModule\/documentation\/SimulationModule\/ScheduleLabel\/onEnter(_:)"},{"type":"text","text":", "},{"type":"reference","isActive":true,"identifier":"doc:\/\/SimulationModule\/documentation\/SimulationModule\/ScheduleLabel\/onExit(_:)"},{"type":"text","text":" and"},{"type":"text","text":" "},{"type":"reference","isActive":true,"identifier":"doc:\/\/SimulationModule\/documentation\/SimulationModule\/ScheduleLabel\/onTransition(from:to:)"},{"type":"text","text":", and "},{"type":"reference","isActive":true,"identifier":"doc:\/\/SimulationModule\/documentation\/SimulationModule\/inState(_:)"},{"type":"text","text":" makes a run condition that holds"},{"type":"text","text":" "},{"type":"text","text":"only in one state."}],"type":"paragraph"},{"inlineContent":[{"text":"The following example spawns a ball on entering the ","type":"text"},{"type":"codeVoice","code":"playing"},{"text":" state and moves it only while the","type":"text"},{"text":" ","type":"text"},{"text":"game is in that state:","type":"text"}],"type":"paragraph"},{"syntax":"swift","code":["var simulation = Simulation()","simulation.add(state: GameState.menu)","simulation.add(to: .onEnter(GameState.playing)) { SpawnBall() }","simulation.add(to: .fixedUpdate) { Physics().runIf(inState(GameState.playing)) }","","simulation.update(elapsed: .milliseconds(50))","print(simulation.world.count)","\/\/ Prints \"0\"","","simulation.world.resources[NextState<GameState>.self].set(.playing)","simulation.update(elapsed: .milliseconds(50))","print(simulation.world.resources[CurrentState<GameState>.self].state)","\/\/ Prints \"playing\"","for (_, position) in simulation.world.query(Position.self) {","    print(position)  \/\/ Prints \"Position(x: 3.0)\"","}"],"type":"codeListing"}],"kind":"content"}],"abstract":[{"text":"Run a world frame by frame, with schedules for startup, a fixed timestep and each frame, and","type":"text"},{"text":" ","type":"text"},{"text":"with states that switch systems on and off.","type":"text"}],"metadata":{"role":"collection","title":"SimulationModule","externalID":"SimulationModule","roleHeading":"Framework","modules":[{"name":"SimulationModule"}],"symbolKind":"module"},"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/simulationmodule"]}],"sections":[],"references":{"doc://SimulationModule/documentation/SimulationModule/inState(_:)":{"title":"inState(_:)","type":"topic","abstract":[{"type":"text","text":"Returns a run condition that holds when a world’s current state is the given state."}],"kind":"symbol","role":"symbol","identifier":"doc:\/\/SimulationModule\/documentation\/SimulationModule\/inState(_:)","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"inState","kind":"identifier"},{"text":"<","kind":"text"},{"text":"S","kind":"genericParameter"},{"text":">(","kind":"text"},{"text":"S","kind":"typeIdentifier"},{"text":") -> (","kind":"text"},{"preciseIdentifier":"s:11WorldModule0A0V","text":"World","kind":"typeIdentifier"},{"text":") -> ","kind":"text"},{"preciseIdentifier":"s:Sb","text":"Bool","kind":"typeIdentifier"}],"url":"\/documentation\/simulationmodule\/instate(_:)"},"doc://SimulationModule/documentation/SimulationModule/Time":{"url":"\/documentation\/simulationmodule\/time","title":"Time","kind":"symbol","identifier":"doc:\/\/SimulationModule\/documentation\/SimulationModule\/Time","type":"topic","abstract":[{"type":"text","text":"A resource holding the time a simulation has advanced."}],"fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Time","kind":"identifier"}],"navigatorTitle":[{"text":"Time","kind":"identifier"}],"role":"symbol"},"doc://SimulationModule/documentation/SimulationModule/ScheduleLabel/startup":{"identifier":"doc:\/\/SimulationModule\/documentation\/SimulationModule\/ScheduleLabel\/startup","fragments":[{"kind":"keyword","text":"static"},{"kind":"text","text":" "},{"kind":"keyword","text":"let"},{"kind":"text","text":" "},{"kind":"identifier","text":"startup"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"ScheduleLabel","preciseIdentifier":"s:16SimulationModule13ScheduleLabelV"}],"kind":"symbol","abstract":[{"text":"The label of the schedule that runs once, before the first frame.","type":"text"}],"role":"symbol","title":"startup","type":"topic","url":"\/documentation\/simulationmodule\/schedulelabel\/startup"},"doc://SimulationModule/documentation/SimulationModule/ScheduleLabel":{"abstract":[{"type":"text","text":"The name of a schedule in a simulation."}],"navigatorTitle":[{"text":"ScheduleLabel","kind":"identifier"}],"title":"ScheduleLabel","identifier":"doc:\/\/SimulationModule\/documentation\/SimulationModule\/ScheduleLabel","url":"\/documentation\/simulationmodule\/schedulelabel","role":"symbol","type":"topic","kind":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"ScheduleLabel","kind":"identifier"}]},"doc://SimulationModule/documentation/SimulationModule":{"title":"SimulationModule","type":"topic","abstract":[{"text":"Run a world frame by frame, with schedules for startup, a fixed timestep and each frame, and","type":"text"},{"text":" ","type":"text"},{"text":"with states that switch systems on and off.","type":"text"}],"kind":"symbol","role":"collection","identifier":"doc:\/\/SimulationModule\/documentation\/SimulationModule","url":"\/documentation\/simulationmodule"},"doc://SimulationModule/documentation/SimulationModule/Simulation/update(elapsed:)":{"abstract":[{"type":"text","text":"Advances the simulation by one frame."}],"title":"update(elapsed:)","identifier":"doc:\/\/SimulationModule\/documentation\/SimulationModule\/Simulation\/update(elapsed:)","url":"\/documentation\/simulationmodule\/simulation\/update(elapsed:)","role":"symbol","type":"topic","kind":"symbol","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"update","kind":"identifier"},{"text":"(","kind":"text"},{"text":"elapsed","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"Duration","preciseIdentifier":"s:s8DurationV","kind":"typeIdentifier"},{"text":")","kind":"text"}]},"doc://SimulationModule/documentation/SimulationModule/ScheduleLabel/onExit(_:)":{"url":"\/documentation\/simulationmodule\/schedulelabel\/onexit(_:)","identifier":"doc:\/\/SimulationModule\/documentation\/SimulationModule\/ScheduleLabel\/onExit(_:)","kind":"symbol","title":"onExit(_:)","abstract":[{"text":"Returns the label of the schedule that runs when a simulation leaves the given state.","type":"text"}],"type":"topic","fragments":[{"text":"static","kind":"keyword"},{"text":" ","kind":"text"},{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"onExit","kind":"identifier"},{"text":"<","kind":"text"},{"text":"S","kind":"genericParameter"},{"text":">(","kind":"text"},{"text":"S","kind":"typeIdentifier"},{"text":") -> ","kind":"text"},{"text":"ScheduleLabel","preciseIdentifier":"s:16SimulationModule13ScheduleLabelV","kind":"typeIdentifier"}],"role":"symbol"},"doc://SimulationModule/documentation/SimulationModule/FixedTime":{"identifier":"doc:\/\/SimulationModule\/documentation\/SimulationModule\/FixedTime","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"FixedTime","kind":"identifier"}],"abstract":[{"text":"A resource holding the fixed timestep of a simulation.","type":"text"}],"kind":"symbol","role":"symbol","title":"FixedTime","navigatorTitle":[{"text":"FixedTime","kind":"identifier"}],"type":"topic","url":"\/documentation\/simulationmodule\/fixedtime"},"doc://SimulationModule/documentation/SimulationModule/ScheduleLabel/update":{"abstract":[{"text":"The label of the schedule that runs once a frame.","type":"text"}],"title":"update","identifier":"doc:\/\/SimulationModule\/documentation\/SimulationModule\/ScheduleLabel\/update","url":"\/documentation\/simulationmodule\/schedulelabel\/update","role":"symbol","type":"topic","kind":"symbol","fragments":[{"text":"static","kind":"keyword"},{"text":" ","kind":"text"},{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"update","kind":"identifier"},{"text":": ","kind":"text"},{"text":"ScheduleLabel","kind":"typeIdentifier","preciseIdentifier":"s:16SimulationModule13ScheduleLabelV"}]},"doc://SimulationModule/documentation/SimulationModule/ScheduleLabel/fixedUpdate":{"identifier":"doc:\/\/SimulationModule\/documentation\/SimulationModule\/ScheduleLabel\/fixedUpdate","fragments":[{"kind":"keyword","text":"static"},{"kind":"text","text":" "},{"kind":"keyword","text":"let"},{"kind":"text","text":" "},{"kind":"identifier","text":"fixedUpdate"},{"kind":"text","text":": "},{"preciseIdentifier":"s:16SimulationModule13ScheduleLabelV","kind":"typeIdentifier","text":"ScheduleLabel"}],"abstract":[{"text":"The label of the schedule that runs once for each fixed timestep of elapsed time.","type":"text"}],"kind":"symbol","role":"symbol","title":"fixedUpdate","type":"topic","url":"\/documentation\/simulationmodule\/schedulelabel\/fixedupdate"},"doc://SimulationModule/documentation/SimulationModule/States":{"url":"\/documentation\/simulationmodule\/states","title":"States","kind":"symbol","identifier":"doc:\/\/SimulationModule\/documentation\/SimulationModule\/States","type":"topic","abstract":[{"type":"text","text":"A type whose values are the states a simulation can be in."}],"fragments":[{"kind":"keyword","text":"protocol"},{"kind":"text","text":" "},{"kind":"identifier","text":"States"}],"navigatorTitle":[{"kind":"identifier","text":"States"}],"role":"symbol"},"doc://SimulationModule/documentation/SimulationModule/NextState":{"title":"NextState","type":"topic","abstract":[{"type":"text","text":"A resource holding the state a simulation enters at the start of its next frame."}],"kind":"symbol","navigatorTitle":[{"text":"NextState","kind":"identifier"}],"role":"symbol","identifier":"doc:\/\/SimulationModule\/documentation\/SimulationModule\/NextState","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"NextState","kind":"identifier"}],"url":"\/documentation\/simulationmodule\/nextstate"},"doc://SimulationModule/documentation/SimulationModule/NonPositiveDuration":{"identifier":"doc:\/\/SimulationModule\/documentation\/SimulationModule\/NonPositiveDuration","url":"\/documentation\/simulationmodule\/nonpositiveduration","kind":"symbol","title":"NonPositiveDuration","type":"topic","abstract":[{"type":"text","text":"An error that indicates a simulation’s fixed timestep or maximum frame time is zero or"},{"type":"text","text":" "},{"type":"text","text":"negative."}],"fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"NonPositiveDuration","kind":"identifier"}],"navigatorTitle":[{"text":"NonPositiveDuration","kind":"identifier"}],"role":"symbol"},"doc://SimulationModule/documentation/SimulationModule/Simulation/add(state:)":{"title":"add(state:)","url":"\/documentation\/simulationmodule\/simulation\/add(state:)","kind":"symbol","identifier":"doc:\/\/SimulationModule\/documentation\/SimulationModule\/Simulation\/add(state:)","abstract":[{"type":"text","text":"Adds a state type to the simulation, starting in the given state."}],"type":"topic","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"add"},{"kind":"text","text":"<"},{"kind":"genericParameter","text":"S"},{"kind":"text","text":">("},{"kind":"externalParam","text":"state"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"S"},{"kind":"text","text":")"}],"role":"symbol"},"doc://SimulationModule/documentation/SimulationModule/ScheduleLabel/onTransition(from:to:)":{"abstract":[{"text":"Returns the label of the schedule that runs when a simulation changes from one given state","type":"text"},{"text":" ","type":"text"},{"text":"to another.","type":"text"}],"title":"onTransition(from:to:)","identifier":"doc:\/\/SimulationModule\/documentation\/SimulationModule\/ScheduleLabel\/onTransition(from:to:)","url":"\/documentation\/simulationmodule\/schedulelabel\/ontransition(from:to:)","role":"symbol","type":"topic","kind":"symbol","fragments":[{"kind":"keyword","text":"static"},{"kind":"text","text":" "},{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"onTransition"},{"kind":"text","text":"<"},{"kind":"genericParameter","text":"S"},{"kind":"text","text":">("},{"kind":"externalParam","text":"from"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"S"},{"kind":"text","text":", "},{"kind":"externalParam","text":"to"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"S"},{"kind":"text","text":") -> "},{"kind":"typeIdentifier","preciseIdentifier":"s:16SimulationModule13ScheduleLabelV","text":"ScheduleLabel"}]},"doc://SimulationModule/documentation/SimulationModule/Simulation":{"title":"Simulation","type":"topic","abstract":[{"type":"text","text":"A world and its schedules by label, advanced one frame at a time."}],"kind":"symbol","navigatorTitle":[{"text":"Simulation","kind":"identifier"}],"role":"symbol","identifier":"doc:\/\/SimulationModule\/documentation\/SimulationModule\/Simulation","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Simulation","kind":"identifier"}],"url":"\/documentation\/simulationmodule\/simulation"},"doc://SimulationModule/documentation/SimulationModule/CurrentState":{"title":"CurrentState","type":"topic","abstract":[{"type":"text","text":"A resource holding the state a simulation is in."}],"kind":"symbol","navigatorTitle":[{"text":"CurrentState","kind":"identifier"}],"role":"symbol","identifier":"doc:\/\/SimulationModule\/documentation\/SimulationModule\/CurrentState","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"CurrentState","kind":"identifier"}],"url":"\/documentation\/simulationmodule\/currentstate"},"doc://SimulationModule/documentation/SimulationModule/ScheduleLabel/onEnter(_:)":{"identifier":"doc:\/\/SimulationModule\/documentation\/SimulationModule\/ScheduleLabel\/onEnter(_:)","fragments":[{"kind":"keyword","text":"static"},{"kind":"text","text":" "},{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"onEnter"},{"kind":"text","text":"<"},{"kind":"genericParameter","text":"S"},{"kind":"text","text":">("},{"kind":"typeIdentifier","text":"S"},{"kind":"text","text":") -> "},{"kind":"typeIdentifier","text":"ScheduleLabel","preciseIdentifier":"s:16SimulationModule13ScheduleLabelV"}],"kind":"symbol","abstract":[{"type":"text","text":"Returns the label of the schedule that runs when a simulation enters the given state."}],"role":"symbol","title":"onEnter(_:)","type":"topic","url":"\/documentation\/simulationmodule\/schedulelabel\/onenter(_:)"}}}