kind":"keyword"},{"text":" ","kind":"text"},{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"onExit","kind":"identifier"},{"text":"<","kind":"text"},{"text":"S","kind":"genericParameter"},{"text":">(","kind":"text"},{"text":"S","kind":"typeIdentifier"},{"text":") -> ","kind":"text"},{"text":"ScheduleLabel","preciseIdentifier":"s:16SimulationModule13ScheduleLabelV","kind":"typeIdentifier"}],"type":"topic","url":"\/documentation\/simulationmodule\/schedulelabel\/onexit(_:)","abstract":[{"text":"Returns the label of the schedule that runs when a simulation leaves the given state.","type":"text"}],"kind":"symbol","role":"symbol","title":"onExit(_:)","identifier":"doc:\/\/SimulationModule\/documentation\/SimulationModule\/ScheduleLabel\/onExit(_:)"},"doc://SimulationModule/documentation/SimulationModule/inState(_:)":{"url":"\/documentation\/simulationmodule\/instate(_:)","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"inState","kind":"identifier"},{"text":"<","kind":"text"},{"text":"S","kind":"genericParameter"},{"text":">(","kind":"text"},{"text":"S","kind":"typeIdentifier"},{"text":") -> (","kind":"text"},{"text":"World","preciseIdentifier":"s:11WorldModule0A0V","kind":"typeIdentifier"},{"text":") -> ","kind":"text"},{"text":"Bool","preciseIdentifier":"s:Sb","kind":"typeIdentifier"}],"role":"symbol","kind":"symbol","abstract":[{"type":"text","text":"Returns a run condition that holds when a world’s current state is the given state."}],"type":"topic","title":"inState(_:)","identifier":"doc:\/\/SimulationModule\/documentation\/SimulationModule\/inState(_:)"},"doc://SimulationModule/documentation/SimulationModule/ScheduleLabel/fixedUpdate":{"url":"\/documentation\/simulationmodule\/schedulelabel\/fixedupdate","fragments":[{"text":"static","kind":"keyword"},{"text":" ","kind":"text"},{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"fixedUpdate","kind":"identifier"},{"text":": ","kind":"text"},{"text":"ScheduleLabel","kind":"typeIdentifier","preciseIdentifier":"s:16SimulationModule13ScheduleLabelV"}],"role":"symbol","abstract":[{"type":"text","text":"The label of the schedule that runs once for each fixed timestep of elapsed time."}],"kind":"symbol","type":"topic","title":"fixedUpdate","identifier":"doc:\/\/SimulationModule\/documentation\/SimulationModule\/ScheduleLabel\/fixedUpdate"},"doc://SimulationModule/documentation/SimulationModule/Simulation":{"fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Simulation","kind":"identifier"}],"identifier":"doc:\/\/SimulationModule\/documentation\/SimulationModule\/Simulation","kind":"symbol","role":"symbol","type":"topic","title":"Simulation","navigatorTitle":[{"text":"Simulation","kind":"identifier"}],"abstract":[{"type":"text","text":"A world and its schedules by label, advanced one frame at a time."}],"url":"\/documentation\/simulationmodule\/simulation"},"doc://SimulationModule/documentation/SimulationModule/ScheduleLabel/onEnter(_:)":{"fragments":[{"text":"static","kind":"keyword"},{"text":" ","kind":"text"},{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"onEnter","kind":"identifier"},{"text":"<","kind":"text"},{"text":"S","kind":"genericParameter"},{"text":">(","kind":"text"},{"text":"S","kind":"typeIdentifier"},{"text":") -> ","kind":"text"},{"text":"ScheduleLabel","preciseIdentifier":"s:16SimulationModule13ScheduleLabelV","kind":"typeIdentifier"}],"type":"topic","url":"\/documentation\/simulationmodule\/schedulelabel\/onenter(_:)","abstract":[{"type":"text","text":"Returns the label of the schedule that runs when a simulation enters the given state."}],"kind":"symbol","role":"symbol","title":"onEnter(_:)","identifier":"doc:\/\/SimulationModule\/documentation\/SimulationModule\/ScheduleLabel\/onEnter(_:)"},"doc://SimulationModule/documentation/SimulationModule/FixedTime":{"role":"symbol","url":"\/documentation\/simulationmodule\/fixedtime","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"FixedTime","kind":"identifier"}],"title":"FixedTime","navigatorTitle":[{"text":"FixedTime","kind":"identifier"}],"type":"topic","kind":"symbol","abstract":[{"type":"text","text":"A resource holding the fixed timestep of a simulation."}],"identifier":"doc:\/\/SimulationModule\/documentation\/SimulationModule\/FixedTime"},"doc://SimulationModule/documentation/SimulationModule/NextState":{"url":"\/documentation\/simulationmodule\/nextstate","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"NextState","kind":"identifier"}],"role":"symbol","abstract":[{"type":"text","text":"A resource holding the state a simulation enters at the start of its next frame."}],"kind":"symbol","type":"topic","title":"NextState","navigatorTitle":[{"text":"NextState","kind":"identifier"}],"identifier":"doc:\/\/SimulationModule\/documentation\/SimulationModule\/NextState"}}}