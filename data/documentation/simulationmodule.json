le":[{"text":"States","kind":"identifier"}],"abstract":[{"text":"A type whose values are the states a simulation can be in.","type":"text"}],"kind":"symbol","identifier":"doc:\/\/SimulationModule\/documentation\/SimulationModule\/States","title":"States","type":"topic","role":"symbol","url":"\/documentation\/simulationmodule\/states","fragments":[{"text":"protocol","kind":"keyword"},{"text":" ","kind":"text"},{"text":"States","kind":"identifier"}]},"doc://SimulationModule/documentation/SimulationModule/Time":{"kind":"symbol","abstract":[{"type":"text","text":"A resource holding the time a simulation has advanced."}],"navigatorTitle":[{"text":"Time","kind":"identifier"}],"identifier":"doc:\/\/SimulationModule\/documentation\/SimulationModule\/Time","type":"topic","role":"symbol","title":"Time","url":"\/documentation\/simulationmodule\/time","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Time","kind":"identifier"}]},"doc://SimulationModule/documentation/SimulationModule/ScheduleLabel/onExit(_:)":{"fragments":[{"text":"static","kind":"keyword"},{"text":" ","kind":"text"},{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"onExit","kind":"identifier"},{"text":"<","kind":"text"},{"text":"S","kind":"genericParameter"},{"text":">(","kind":"text"},{"text":"S","kind":"typeIdentifier"},{"text":") -> ","kind":"text"},{"preciseIdentifier":"s:16SimulationModule13ScheduleLabelV","text":"ScheduleLabel","kind":"typeIdentifier"}],"type":"topic","abstract":[{"text":"Returns the label of the schedule that runs when a simulation leaves the given state.","type":"text"}],"role":"symbol","kind":"symbol","title":"onExit(_:)","identifier":"doc:\/\/SimulationModule\/documentation\/SimulationModule\/ScheduleLabel\/onExit(_:)","url":"\/documentation\/simulationmodule\/schedulelabel\/onexit(_:)"},"doc://SimulationModule/documentation/SimulationModule/FixedTime":{"title":"FixedTime","role":"symbol","abstract":[{"text":"A resource holding the fixed timestep of a simulation.","type":"text"}],"type":"topic","kind":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"FixedTime","kind":"identifier"}],"identifier":"doc:\/\/SimulationModule\/documentation\/SimulationModule\/FixedTime","url":"\/documentation\/simulationmodule\/fixedtime","navigatorTitle":[{"text":"FixedTime","kind":"identifier"}]},"doc://SimulationModule/documentation/SimulationModule/Simulation":{"role":"symbol","type":"topic","url":"\/documentation\/simulationmodule\/simulation","identifier":"doc:\/\/SimulationModule\/documentation\/SimulationModule\/Simulation","abstract":[{"type":"text","text":"A world and its schedules by label, advanced one frame at a time."}],"kind":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Simulation","kind":"identifier"}],"navigatorTitle":[{"text":"Simulation","kind":"identifier"}],"title":"Simulation"}}}