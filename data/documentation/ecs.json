{"kind":"symbol","variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/ecs"]}],"sections":[],"primaryContentSections":[{"content":[{"text":"Overview","anchor":"Overview","type":"heading","level":2},{"type":"paragraph","inlineContent":[{"text":"ECS is an entity component system for Swift. It suits any program that updates many similar","type":"text"},{"text":" ","type":"text"},{"text":"things each step, such as the bodies of a physics simulation or the characters of a game.","type":"text"}]},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Entities are lightweight handles. An "},{"type":"reference","identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/Entity","isActive":true},{"type":"text","text":" holds no data of its own."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Components are plain value types, such as a position or a velocity, attached to entities."}]}]},{"content":[{"inlineContent":[{"type":"text","text":"A "},{"identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/World","isActive":true,"type":"reference"},{"type":"text","text":" holds the entities and their components, along with "},{"type":"emphasis","inlineContent":[{"type":"text","text":"resources"}]},{"type":"text","text":","},{"type":"text","text":" "},{"type":"text","text":"values the world holds once, such as a clock."}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"Systems are rules that read and change the world through queries and updates, and a","type":"text"},{"text":" ","type":"text"},{"isActive":true,"identifier":"doc:\/\/Systems\/documentation\/Systems\/Schedule","type":"reference"},{"text":" runs them in the order you write, at the same time where they don’t","type":"text"},{"text":" ","type":"text"},{"text":"conflict.","type":"text"}]}]},{"content":[{"inlineContent":[{"type":"text","text":"A "},{"type":"reference","identifier":"doc:\/\/SimulationModule\/documentation\/SimulationModule\/Simulation","isActive":true},{"type":"text","text":" runs a world frame by frame, with a fixed timestep and"},{"type":"text","text":" "},{"type":"text","text":"states."}],"type":"paragraph"}]}]},{"type":"paragraph","inlineContent":[{"text":"A world is a copy-on-write value, like an array: copies are cheap and independent, so you can","type":"text"},{"text":" ","type":"text"},{"text":"keep one for a snapshot, an undo step or a rollback.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"The following example, using the ","type":"text"},{"type":"codeVoice","code":"Position"},{"text":" and ","type":"text"},{"type":"codeVoice","code":"Velocity"},{"text":" components from","type":"text"},{"text":" ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/ECS\/documentation\/ECS\/GettingStarted"},{"text":", spawns a ball and moves it one step by its velocity:","type":"text"}]},{"code":["import ECS","","var world = World()","let ball = world.spawn(Position(x: 0, y: 0), Velocity(dx: 1, dy: 2))","world.update(Position.self, reading: Velocity.self) { position, row in","    position.x += row.components.dx","    position.y += row.components.dy","}","print(world[Position.self, of: ball])","\/\/ Prints \"Position(x: 1.0, y: 2.0)\""],"type":"codeListing","syntax":"swift"},{"type":"paragraph","inlineContent":[{"code":"import ECS","type":"codeVoice"},{"text":" imports every module. Each module also has its own documentation, and you can","type":"text"},{"text":" ","type":"text"},{"text":"import one on its own.","type":"text"}]}],"kind":"content"}],"metadata":{"title":"ECS","role":"collection","roleHeading":"Framework","symbolKind":"module","externalID":"ECS","modules":[{"name":"ECS"}]},"abstract":[{"type":"text","text":"Build games and simulations from entities, the components they hold, and systems that update"},{"type":"text","text":" "},{"type":"text","text":"them in a declared order."}],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/ECS\/documentation\/ECS"},"hierarchy":{"paths":[[]]},"schemaVersion":{"patch":0,"minor":3,"major":0},"topicSections":[{"identifiers":["doc:\/\/ECS\/documentation\/ECS\/GettingStarted"],"title":"Essentials","anchor":"Essentials"},{"identifiers":["doc:\/\/WorldModule\/documentation\/WorldModule","doc:\/\/Systems\/documentation\/Systems","doc:\/\/SimulationModule\/documentation\/SimulationModule"],"title":"Modules","anchor":"Modules"}],"references":{"doc://WorldModule/documentation/WorldModule/World":{"abstract":[{"type":"text","text":"A collection of entities, the components they hold, and resources."}],"title":"World","identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/World","type":"topic","url":"\/documentation\/worldmodule\/world","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"World"}],"role":"symbol","kind":"symbol","navigatorTitle":[{"kind":"identifier","text":"World"}]},"doc://Systems/documentation/Systems":{"kind":"symbol","abstract":[{"type":"text","text":"Declare the rules of a simulation as systems, and run them on a world in a schedule."}],"url":"\/documentation\/systems","type":"topic","role":"collection","identifier":"doc:\/\/Systems\/documentation\/Systems","title":"Systems"},"doc://SimulationModule/documentation/SimulationModule":{"kind":"symbol","abstract":[{"type":"text","text":"Run a world frame by frame, with schedules for startup, a fixed timestep and each frame, and"},{"type":"text","text":" "},{"type":"text","text":"with states that switch systems on and off."}],"url":"\/documentation\/simulationmodule","type":"topic","role":"collection","identifier":"doc:\/\/SimulationModule\/documentation\/SimulationModule","title":"SimulationModule"},"doc://WorldModule/documentation/WorldModule":{"kind":"symbol","abstract":[{"text":"Store the state of a game or simulation as entities and components, and read and change it with","type":"