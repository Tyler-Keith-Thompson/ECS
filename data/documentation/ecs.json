{"identifier":{"url":"doc:\/\/ECS\/documentation\/ECS","interfaceLanguage":"swift"},"hierarchy":{"paths":[[]]},"abstract":[{"type":"text","text":"Build games and simulations from entities, the components they hold, and systems that update"},{"type":"text","text":" "},{"type":"text","text":"them in a declared order."}],"kind":"symbol","variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/ecs"]}],"primaryContentSections":[{"content":[{"text":"Overview","anchor":"Overview","type":"heading","level":2},{"inlineContent":[{"type":"text","text":"ECS is an entity component system for Swift. It suits any program that updates many similar"},{"type":"text","text":" "},{"type":"text","text":"things each step, such as the bodies of a physics simulation or the characters of a game."}],"type":"paragraph"},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"text":"Entities are lightweight handles. An ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/Entity"},{"text":" holds no data of its own.","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"Components are plain value types, such as a position or a velocity, attached to entities.","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"A "},{"type":"reference","isActive":true,"identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/World"},{"type":"text","text":" holds the entities and their components, along with "},{"type":"emphasis","inlineContent":[{"type":"text","text":"resources"}]},{"type":"text","text":","},{"type":"text","text":" "},{"type":"text","text":"values the world holds once, such as a clock."}]}]},{"content":[{"inlineContent":[{"type":"text","text":"Systems are rules that read and change the world through queries and updates, and a"},{"type":"text","text":" "},{"type":"reference","identifier":"doc:\/\/Systems\/documentation\/Systems\/Schedule","isActive":true},{"type":"text","text":" runs them in the order you write, at the same time where they don’t"},{"type":"text","text":" "},{"type":"text","text":"conflict."}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"A "},{"isActive":true,"type":"reference","identifier":"doc:\/\/SimulationModule\/documentation\/SimulationModule\/Simulation"},{"type":"text","text":" runs a world frame by frame, with a fixed timestep and"},{"type":"text","text":" "},{"type":"text","text":"states."}]}]}]},{"inlineContent":[{"text":"A world is a copy-on-write value, like an array: copies are cheap and independent, so you can","type":"text"},{"text":" ","type":"text"},{"text":"keep one for a snapshot, an undo step or a rollback.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"The following example, using the ","type":"text"},{"code":"Position","type":"codeVoice"},{"text":" and ","type":"text"},{"code":"Velocity","type":"codeVoice"},{"text":" components from","type":"text"},{"text":" ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/ECS\/documentation\/ECS\/GettingStarted"},{"text":", spawns a ball and moves it one step by its velocity:","type":"text"}],"type":"paragraph"},{"syntax":"swift","code":["import ECS","","var world = World()","let ball = world.spawn(Position(x: 0, y: 0), Velocity(dx: 1, dy: 2))","world.update(Position.self, reading: Velocity.self) { position, row in","    position.x += row.components.dx","    position.y += row.components.dy","}","print(world[Position.self, of: ball])","\/\/ Prints \"Position(x: 1.0, y: 2.0)\""],"type":"codeListing"},{"inlineContent":[{"code":"import ECS","type":"codeVoice"},{"text":" imports every module. Each module also has its own documentation, and you can","type":"text"},{"text":" ","type":"text"},{"text":"import one on its own.","type":"text"}],"type":"paragraph"}],"kind":"content"}],"topicSections":[{"identifiers":["doc:\/\/ECS\/documentation\/ECS\/GettingStarted"],"anchor":"Essentials","title":"Essentials"},{"identifiers":["doc:\/\/WorldModule\/documentation\/WorldModule","doc:\/\/Systems\/documentation\/Systems","doc:\/\/SimulationModule\/documentation\/SimulationModule"],"anchor":"Modules","title":"Modules"}],"schemaVersion":{"patch":0,"major":0,"minor":3},"metadata":{"symbolKind":"module","role":"collection","title":"ECS","modules":[{"name":"ECS"}],"roleHeading":"Framework","externalID":"ECS"},"sections":[],"references":{"doc://WorldModule/documentation/WorldModule/World":{"fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"World","kind":"identifier"}],"kind":"symbol","title":"World","url":"\/documentation\/worldmodule\/world","type":"topic","role":"symbol","abstract":[{"type":"text","text":"A collection of entities, the components they hold, and resources."}],"navigatorTitle":[{"text":"World","kind":"identifier"}],"identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/World"},"doc://ECS/documentation/ECS/GettingStarted":{"identifier":"doc:\/\/ECS\/documentation\/ECS\/GettingStarted","abstract":[{"text":"Define components, spawn entities, and move them with systems that run in a schedule and a","type":"text"},{"text":" ","type":"text"},{"text":"simulation.","type":"text"}],"kind":"article","type":"topic","title":"Getting Started with ECS","url":"\/documentation\/ecs\/gettingstarted","role":"article"},"doc://WorldModule/documentation/WorldModule":{"kind":"symbol","title":"WorldModule","url":"\/documentation\/worldmodule","type":"topic","role":"collection","abstract":[{"text":"Store the state of a game or simulation as entities and components, and read and change it with","type":"text"},{"text":" ","type":"text"},{"text":"queries, updates, and commands.","type":"text"}],"identifier":"doc:\/\/WorldModule\/documentation\/WorldModule"},"doc://Systems/documentation/Systems":{"identifier":"doc:\/\/Systems\/documentation\/Systems","abstract":[{"text":"Declare the rules of a simulation as systems, and run them on a world in a schedule.","type":"text"}],"kind":"symbol","type":"topic","title":"Systems","url":"\/documentation\/systems","role":"collection"},"doc://SimulationModule/documentation/SimulationModule":{"kind":"symbol","title":"SimulationModule","url":"\/documentation\/simulationmodule","type":"topic","role":"collection","abstract":[{"text":"Run a world frame by frame, with schedules for startup, a fixed timestep and each frame, and","type":"text"},{"text":" ","type":"text"},{"text":"with states that switch systems on and off.","type":"text"}],"identifier":"doc:\/\/SimulationModule\/documentation\/SimulationModule"},"doc://ECS/documentation/ECS":{"identifier":"doc:\/\/ECS\/documentation\/ECS","abstract":[{"text":"Build games and simulations from entities, the components they hold, and systems that update","type":"text"},{"text":" ","type":"text"},{"text":"them in a declared order.","type":"text"}],"kind":"symbol","type":"topic","title":"ECS","url":"\/documentation\/ecs","role":"collection"},"doc://WorldModule/documentation/WorldModule/Entity":{"fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Entity","kind":"identifier"}],"kind":"symbol","title":"Entity","url":"\/documentation\/worldmodule\/entity","type":"topic","role":"symbol","abstract":[{"type":"text","text":"A handle that identifies one entity in a world."}],"navigatorTitle":[{"text":"Entity","kind":"identifier"}],"identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/Entity"},"doc://Systems/documentation/Systems/Schedule":{"fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"Schedule"}],"kind":"symbol","title":"Schedule","url":"\/documentation\/systems\/schedule","type":"topic","role":"symbol","abstract":[{"text":"A list of systems that run on a world, in order, and at the same time where they can.","type":"text"}],"navigatorTitle":[{"kind":"identifier","text":"Schedule"}],"identifier":"doc:\/\/Systems\/documentation\/Systems\/Schedule"},"doc://SimulationModule/documentation/SimulationModule/Simulation":{"url":"\/documentation\/simulationmodule\/simulation","identifier":"doc:\/\/SimulationModule\/documentation\/SimulationModule\/Simulation","type":"topic","abstract":[{"text":"A world and its schedules by label, advanced one frame at a time.","type":"text"}],"navigatorTitle":[{"text":"Simulation","kind":"identifier"}],"role":"symbol","kind":"symbol","title":"Simulation","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Simulation","kind":"identifier"}]}}}