{"metadata":{"modules":[{"name":"ECS"}],"roleHeading":"Framework","role":"collection","symbolKind":"module","title":"ECS","externalID":"ECS"},"topicSections":[{"identifiers":["doc:\/\/ECS\/documentation\/ECS\/GettingStarted"],"title":"Essentials","anchor":"Essentials"},{"identifiers":["doc:\/\/WorldModule\/documentation\/WorldModule","doc:\/\/Systems\/documentation\/Systems","doc:\/\/SimulationModule\/documentation\/SimulationModule"],"title":"Modules","anchor":"Modules"}],"hierarchy":{"paths":[[]]},"schemaVersion":{"major":0,"minor":3,"patch":0},"abstract":[{"type":"text","text":"Build games and simulations from entities, the components they hold, and systems that update"},{"type":"text","text":" "},{"type":"text","text":"them in a declared order."}],"sections":[],"identifier":{"url":"doc:\/\/ECS\/documentation\/ECS","interfaceLanguage":"swift"},"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/ecs"]}],"kind":"symbol","primaryContentSections":[{"content":[{"type":"heading","level":2,"anchor":"Overview","text":"Overview"},{"type":"paragraph","inlineContent":[{"type":"text","text":"ECS is an entity component system for Swift. It suits any program that updates many similar"},{"type":"text","text":" "},{"type":"text","text":"things each step, such as the bodies of a physics simulation or the characters of a game."}]},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"text":"Entities are lightweight handles. An ","type":"text"},{"identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/Entity","type":"reference","isActive":true},{"text":" holds no data of its own.","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"Components are plain value types, such as a position or a velocity, attached to entities.","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"A ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/World"},{"text":" holds the entities and their components, along with ","type":"text"},{"inlineContent":[{"type":"text","text":"resources"}],"type":"emphasis"},{"text":",","type":"text"},{"text":" ","type":"text"},{"text":"values the world holds once, such as a clock.","type":"text"}]}]},{"content":[{"inlineContent":[{"type":"text","text":"Systems are rules that read and change the world through queries and updates, and a"},{"type":"text","text":" "},{"type":"reference","identifier":"doc:\/\/Systems\/documentation\/Systems\/Schedule","isActive":true},{"type":"text","text":" runs them in the order you write, at the same time where they don’t"},{"type":"text","text":" "},{"type":"text","text":"conflict."}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"A "},{"isActive":true,"type":"reference","identifier":"doc:\/\/SimulationModule\/documentation\/SimulationModule\/Simulation"},{"type":"text","text":" runs a world frame by frame, with a fixed timestep and"},{"type":"text","text":" "},{"type":"text","text":"states."}]}]}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"A world is a copy-on-write value, like an array: copies are cheap and independent, so you can"},{"type":"text","text":" "},{"type":"text","text":"keep one for a snapshot, an undo step or a rollback."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"The following example, using the "},{"type":"codeVoice","code":"Position"},{"type":"text","text":" and "},{"type":"codeVoice","code":"Velocity"},{"type":"text","text":" components from"},{"type":"text","text":" "},{"type":"reference","isActive":true,"identifier":"doc:\/\/ECS\/documentation\/ECS\/GettingStarted"},{"type":"text","text":", spawns a ball and moves it one step by its velocity:"}]},{"type":"codeListing","syntax":"swift","code":["import ECS","","var world = World()","let ball = world.spawn(Position(x: 0, y: 0), Velocity(dx: 1, dy: 2))","world.update(Position.self, reading: Velocity.self) { position, row in","    position.x += row.components.dx","    position.y += row.components.dy","}","print(world[Position.self, of: ball])","\/\/ Prints \"Position(x: 1.0, y: 2.0)\""]},{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"import ECS"},{"type":"text","text":" imports every module. Each module also has its own documentation, and you can"},{"type":"text","text":" "},{"type":"text","text":"import one on its own."}]}],"kind":"content"}],"references":{"doc://Systems/documentation/Systems":{"role":"collection","identifier":"doc:\/\/Systems\/documentation\/Systems","url":"\/documentation\/systems","title":"Systems","abstract":[{"type":"text","text":"Declare the rules of a simulation as systems, and run them on a world in a schedule."}],"kind":"symbol","type":"topic"},"doc://ECS/documentation/ECS":{"url":"\/documentation\/ecs","abstract":[{"text":"Build games and simulations from entities, the components they hold, and systems that update","type":"text"},{"text":" ","type":"text"},{"text":"them in a declared order.","type":"text"}],"identifier":"doc:\/\/ECS\/documentation\/ECS","type":"topic","title":"ECS","kind":"symbol","role":"collection"},"doc://SimulationModule/documentation/SimulationModule/Simulation":{"role":"symbol","identifier":"doc:\/\/SimulationModule\/documentation\/SimulationModule\/Simulation","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Simulation","kind":"identifier"}],"url":"\/documentation\/simulationmodule\/simulation","title":"Simulation","navigatorTitle":[{"text":"Simulation","kind":"identifier"}],"abstract":[{"type":"text","text":"A world and its schedules by label, advanced one frame at a time."}],"kind":"symbol","type":"topic"},"doc://ECS/documentation/ECS/GettingStarted":{"url":"\/documentation\/ecs\/gettingstarted","abstract":[{"text":"Define components, spawn entities, and move them with systems that run in a schedule and a","type":"text"},{"text":" ","type":"text"},{"text":"simulation.","type":"text"}],"identifier":"doc:\/\/ECS\/documentation\/ECS\/GettingStarted","type":"topic","title":"Getting Started with ECS","kind":"article","role":"article"},"doc://Systems/documentation/Systems/Schedule":{"role":"symbol","identifier":"doc:\/\/Systems\/documentation\/Systems\/Schedule","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Schedule","kind":"identifier"}],"url":"\/documentation\/systems\/schedule","title":"Schedule","navigatorTitle":[{"text":"Schedule","kind":"identifier"}],"abstract":[{"type":"text","text":"A list of systems that run on a world, in order, and at the same time where they can."}],"kind":"symbol","type":"topic"},"doc://SimulationModule/documentation/SimulationModule":{"url":"\/documentation\/simulationmodule","abstract":[{"text":"Run a world frame by frame, with schedules for startup, a fixed timestep and each frame, and","type":"text"},{"text":" ","type":"text"},{"text":"with states that switch systems on and off.","type":"text"}],"identifier":"doc:\/\/SimulationModule\/documentation\/SimulationModule","type":"topic","title":"SimulationModule","kind":"symbol","role":"collection"},"doc://WorldModule/documentation/WorldModule/Entity":{"role":"symbol","identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/Entity","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"Entity"}],"url":"\/documentation\/worldmodule\/entity","title":"Entity","navigatorTitle":[{"kind":"identifier","text":"Entity"}],"abstract":[{"text":"A handle that identifies one entity in a world.","type":"text"}],"kind":"symbol","type":"topic"},"doc://WorldModule/documentation/WorldModule/World":{"role":"symbol","identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/World","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"World"}],"url":"\/documentation\/worldmodule\/world","title":"World","navigatorTitle":[{"kind":"identifier","text":"World"}],"abstract":[{"text":"A collection of entities, the components they hold, and resources.","type":"text"}],"kind":"symbol","type":"topic"},"doc://WorldModule/documentation/WorldModule":{"type":"topic","kind":"symbol","url":"\/documentation\/worldmodule","abstract":[{"type":"text","text":"Store the state of a game or simulation as entities and components, and read and change it with"},{"type":"text","text":" "},{"type":"text","text":"queries, updates, and commands."}],"title":"WorldModule","identifier":"doc:\/\/WorldModule\/documentation\/WorldModule","role":"collection"}}}