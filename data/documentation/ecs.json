{"topicSections":[{"anchor":"Essentials","identifiers":["doc:\/\/ECS\/documentation\/ECS\/GettingStarted"],"title":"Essentials"},{"anchor":"Modules","identifiers":["doc:\/\/WorldModule\/documentation\/WorldModule","doc:\/\/Systems\/documentation\/Systems","doc:\/\/SimulationModule\/documentation\/SimulationModule"],"title":"Modules"}],"schemaVersion":{"patch":0,"major":0,"minor":3},"sections":[],"kind":"symbol","identifier":{"interfaceLanguage":"swift","url":"doc:\/\/ECS\/documentation\/ECS"},"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/ecs"]}],"primaryContentSections":[{"kind":"content","content":[{"level":2,"type":"heading","anchor":"Overview","text":"Overview"},{"inlineContent":[{"type":"text","text":"ECS is an entity component system for Swift. It suits any program that updates many similar"},{"type":"text","text":" "},{"type":"text","text":"things each step, such as the bodies of a physics simulation or the characters of a game."}],"type":"paragraph"},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"text":"Entities are lightweight handles. An ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/Entity"},{"text":" holds no data of its own.","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Components are plain value types, such as a position or a velocity, attached to entities."}]}]},{"content":[{"inlineContent":[{"text":"A ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/World"},{"text":" holds the entities and their components, along with ","type":"text"},{"type":"emphasis","inlineContent":[{"text":"resources","type":"text"}]},{"text":",","type":"text"},{"text":" ","type":"text"},{"text":"values the world holds once, such as a clock.","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"Systems are rules that read and change the world through queries and updates, and a","type":"text"},{"text":" ","type":"text"},{"isActive":true,"identifier":"doc:\/\/Systems\/documentation\/Systems\/Schedule","type":"reference"},{"text":" runs them in the order you write, at the same time where they don’t","type":"text"},{"text":" ","type":"text"},{"text":"conflict.","type":"text"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"A ","type":"text"},{"identifier":"doc:\/\/SimulationModule\/documentation\/SimulationModule\/Simulation","type":"reference","isActive":true},{"text":" runs a world frame by frame, with a fixed timestep and","type":"text"},{"text":" ","type":"text"},{"text":"states.","type":"text"}]}]}],"type":"unorderedList"},{"inlineContent":[{"type":"text","text":"A world is a copy-on-write value, like an array: copies are cheap and independent, so you can"},{"type":"text","text":" "},{"type":"text","text":"keep one for a snapshot, an undo step or a rollback."}],"type":"paragraph"},{"inlineContent":[{"text":"The following example, using the ","type":"text"},{"type":"codeVoice","code":"Position"},{"text":" and ","type":"text"},{"type":"codeVoice","code":"Velocity"},{"text":" components from","type":"text"},{"text":" ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/ECS\/documentation\/ECS\/GettingStarted"},{"text":", spawns a ball and moves it one step by its velocity:","type":"text"}],"type":"paragraph"},{"code":["import ECS","","var world = World()","let ball = world.spawn(Position(x: 0, y: 0), Velocity(dx: 1, dy: 2))","world.update(Position.self, reading: Velocity.self) { position, row in","    position.x += row.components.dx","    position.y += row.components.dy","}","print(world[Position.self, of: ball])","\/\/ Prints \"Position(x: 1.0, y: 2.0)\""],"type":"codeListing","syntax":"swift"},{"inlineContent":[{"type":"codeVoice","code":"import ECS"},{"text":" imports every module. Each module also has its own documentation, and you can","type":"text"},{"text":" ","type":"text"},{"text":"import one on its own.","type":"text"}],"type":"paragraph"}]}],"hierarchy":{"paths":[[]]},"metadata":{"modules":[{"name":"ECS"}],"roleHeading":"Framework","role":"collection","symbolKind":"module","title":"ECS","externalID":"ECS"},"abstract":[{"text":"Build games and simulations from entities, the components they hold, and systems that update","type":"text"},{"text":" ","type":"text"},{"text":"them in a declared order.","type":"text"}],"references":{"doc://SimulationModule/documentation/SimulationModule/Simulation":{"role":"symbol","title":"Simulation","abstract":[{"type":"text","text":"A world and its schedules by label, advanced one frame at a time."}],"type":"topic","kind":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"Simulation"}],"identifier":"doc:\/\/SimulationModule\/documentation\/SimulationModule\/Simulation","navigatorTitle":[{"kind":"identifier","text":"Simulation"}],"url":"\/documentation\/simulationmodule\/simulation"},"doc://SimulationModule/documentation/SimulationModule":{"title":"SimulationModule","url":"\/documentation\/simulationmodule","identifier":"doc:\/\/SimulationModule\/documentation\/SimulationModule","kind":"symbol","type":"topic","abstract":[{"type":"text","text":"Run a world frame by frame, with schedules for startup, a fixed timestep and each frame, and"},{"type":"text","text":" "},{"type":"text","text":"with states that switch systems on and off."}],"role":"collection"},"doc://WorldModule/documentation/WorldModule/Entity":{"role":"symbol","title":"Entity","abstract":[{"type":"text","text":"A handle that identifies one entity in a world."}],"type":"topic","kind":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Entity","kind":"identifier"}],"identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/Entity","navigatorTitle":[{"text":"Entity","kind":"identifier"}],"url":"\/documentation\/worldmodule\/entity"},"doc://ECS/documentation/ECS/GettingStarted":{"title":"Getting Started with ECS","url":"\/documentation\/ecs\/gettingstarted","identifier":"doc:\/\/ECS\/documentation\/ECS\/GettingStarted","kind":"article","type":"topic","abstract":[{"type":"text","text":"Define components, spawn entities, and move them with systems that run in a schedule and a"},{"type":"text","text":" "},{"type":"text","text":"simulation."}],"role":"article"},"doc://WorldModule/documentation/WorldModule/World":{"role":"symbol","title":"World","abstract":[{"type":"text","text":"A collection of entities, the components they hold, and resources."}],"type":"topic","kind":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"World","kind":"identifier"}],"identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/World","navigatorTitle":[{"text":"World","kind":"identifier"}],"url":"\/documentation\/worldmodule\/world"},"doc://Systems/documentation/Systems":{"title":"Systems","url":"\/documentation\/systems","identifier":"doc:\/\/Systems\/documentation\/Systems","kind":"symbol","type":"topic","abstract":[{"type":"text","text":"Declare the rules of a simulation as systems, and run them on a world in a schedule."}],"role":"collection"},"doc://ECS/documentation/ECS":{"role":"collection","title":"ECS","abstract":[{"text":"Build games and simulations from entities, the components they hold, and systems that update","type":"text"},{"text":" ","type":"text"},{"text":"them in a declared order.","type":"text"}],"type":"topic","kind":"symbol","identifier":"doc:\/\/ECS\/documentation\/ECS","url":"\/documentation\/ecs"},"doc://WorldModule/documentation/WorldModule":{"role":"collection","title":"WorldModule","abstract":[{"text":"Store the state of a game or simulation as entities and components, and read and change it with","type":"text"},{"text":" ","type":"text"},{"text":"queries, updates, and commands.","type":"text"}],"type":"topic","kind":"symbol","identifier":"doc:\/\/WorldModule\/documentation\/WorldModule","url":"\/documentation\/worldmodule"},"doc://Systems/documentation/Systems/Schedule":{"title":"Schedule","identifier":"doc:\/\/Systems\/documentation\/Systems\/Schedule","type":"topic","role":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Schedule","kind":"identifier"}],"abstract":[{"type":"text","text":"A list of systems that run on a world, in order, and at the same time where they can."}],"url":"\/documentation\/systems\/schedule","navigatorTitle":[{"text":"Schedule","kind":"identifier"}],"kind":"symbol"}}}