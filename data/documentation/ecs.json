{"sections":[],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/ecs"]}],"abstract":[{"type":"text","text":"Build games and simulations from entities, the components they hold, and systems that update"},{"type":"text","text":" "},{"type":"text","text":"them in a declared order."}],"metadata":{"externalID":"ECS","symbolKind":"module","modules":[{"name":"ECS"}],"role":"collection","title":"ECS","roleHeading":"Framework"},"kind":"symbol","schemaVersion":{"minor":3,"patch":0,"major":0},"topicSections":[{"title":"Essentials","identifiers":["doc:\/\/ECS\/documentation\/ECS\/GettingStarted"],"anchor":"Essentials"},{"title":"Modules","identifiers":["doc:\/\/WorldModule\/documentation\/WorldModule","doc:\/\/Systems\/documentation\/Systems","doc:\/\/SimulationModule\/documentation\/SimulationModule"],"anchor":"Modules"}],"identifier":{"url":"doc:\/\/ECS\/documentation\/ECS","interfaceLanguage":"swift"},"primaryContentSections":[{"kind":"content","content":[{"text":"Overview","level":2,"type":"heading","anchor":"Overview"},{"inlineContent":[{"text":"ECS is an entity component system for Swift. It suits any program that updates many similar","type":"text"},{"text":" ","type":"text"},{"text":"things each step, such as the bodies of a physics simulation or the characters of a game.","type":"text"}],"type":"paragraph"},{"items":[{"content":[{"inlineContent":[{"type":"text","text":"Entities are lightweight handles. An "},{"identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/Entity","type":"reference","isActive":true},{"type":"text","text":" holds no data of its own."}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"Components are plain value types, such as a position or a velocity, attached to entities.","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"A "},{"type":"reference","isActive":true,"identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/World"},{"type":"text","text":" holds the entities and their components, along with "},{"type":"emphasis","inlineContent":[{"type":"text","text":"resources"}]},{"type":"text","text":","},{"type":"text","text":" "},{"type":"text","text":"values the world holds once, such as a clock."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Systems are rules that read and change the world through queries and updates, and a"},{"type":"text","text":" "},{"type":"reference","isActive":true,"identifier":"doc:\/\/Systems\/documentation\/Systems\/Schedule"},{"type":"text","text":" runs them in the order you write, at the same time where they don’t"},{"type":"text","text":" "},{"type":"text","text":"conflict."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"A "},{"type":"reference","identifier":"doc:\/\/SimulationModule\/documentation\/SimulationModule\/Simulation","isActive":true},{"type":"text","text":" runs a world frame by frame, with a fixed timestep and"},{"type":"text","text":" "},{"type":"text","text":"states."}]}]}],"type":"unorderedList"},{"inlineContent":[{"text":"A world is a copy-on-write value, like an array: copies are cheap and independent, so you can","type":"text"},{"text":" ","type":"text"},{"text":"keep one for a snapshot, an undo step or a rollback.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"The following example, using the ","type":"text"},{"code":"Position","type":"codeVoice"},{"text":" and ","type":"text"},{"code":"Velocity","type":"codeVoice"},{"text":" components from","type":"text"},{"text":" ","type":"text"},{"isActive":true,"identifier":"doc:\/\/ECS\/documentation\/ECS\/GettingStarted","type":"reference"},{"text":", spawns a ball and moves it one step by its velocity:","type":"text"}],"type":"paragraph"},{"syntax":"swift","code":["import ECS","","var world = World()","let ball = world.spawn(Position(x: 0, y: 0), Velocity(dx: 1, dy: 2))","world.update(Position.self, reading: Velocity.self) { position, row in","    position.x += row.components.dx","    position.y += row.components.dy","}","print(world[Position.self, of: ball])","\/\/ Prints \"Position(x: 1.0, y: 2.0)\""],"type":"codeListing"},{"inlineContent":[{"code":"import ECS","type":"codeVoice"},{"type":"text","text":" imports every module. Each module also has its own documentation, and you can"},{"type":"text","text":" "},{"type":"text","text":"import one on its own."}],"type":"paragraph"}]}],"hierarchy":{"paths":[[]]},"references":{"doc://SimulationModule/documentation/SimulationModule":{"url":"\/documentation\/simulationmodule","type":"topic","abstract":[{"type":"text","text":"Run a world frame by frame, with schedules for startup, a fixed timestep and each frame, and"},{"type":"text","text":" "},{"type":"text","text":"with states that switch systems on and off."}],"title":"SimulationModule","kind":"symbol","role":"collection","identifier":"doc:\/\/SimulationModule\/documentation\/SimulationModule"},"doc://WorldModule/documentation/WorldModule/Entity":{"identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/Entity","url":"\/documentation\/worldmodule\/entity","title":"Entity","abstract":[{"type":"text","text":"A handle that identifies one entity in a world."}],"fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Entity","kind":"identifier"}],"navigatorTitle":[{"text":"Entity","kind":"identifier"}],"type":"topic","kind":"symbol","role":"symbol"},"doc://WorldModule/documentation/WorldModule/World":{"url":"\/documentation\/worldmodule\/world","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"World"}],"abstract":[{"type":"text","text":"A collection of entities, the components they hold, and resources."}],"title":"World","type":"topic","kind":"symbol","role":"symbol","identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/World","navigatorTitle":[{"kind":"identifier","text":"World"}]},"doc://Systems/documentation/Systems":{"url":"\/documentation\/systems","title":"Systems","type":"topic","abstract":[{"type":"text","text":"Declare the rules of a simulation as systems, and run them on a world in a schedule."}],"kind":"symbol","role":"collection","identifier":"doc:\/\/Systems\/documentation\/Systems"},"doc://SimulationModule/documentation/SimulationModule/Simulation":{"url":"\/documentation\/simulationmodule\/simulation","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"Simulation"}],"type":"topic","abstract":[{"type":"text","text":"A world and its schedules by label, advanced one frame at a time."}],"title":"Simulation","kind":"symbol","role":"symbol","identifier":"doc:\/\/SimulationModule\/documentation\/SimulationModule\/Simulation","navigatorTitle":[{"kind":"identifier","text":"Simulation"}]},"doc://WorldModule/documentation/WorldModule":{"url":"\/documentation\/worldmodule","abstract":[{"text":"Store the state of a game or simulation as entities and components, and read and change it with","type":"text"},{"text":" ","type":"text"},{"text":"queries, updates, and commands.","type":"text"}],"type":"topic","title":"WorldModule","kind":"symbol","role":"collection","identifier":"doc:\/\/WorldModule\/documentation\/WorldModule"},"doc://Systems/documentation/Systems/Schedule":{"identifier":"doc:\/\/Systems\/documentation\/Systems\/Schedule","url":"\/documentation\/systems\/schedule","title":"Schedule","abstract":[{"type":"text","text":"A list of systems that run on a world, in order, and at the same time where they can."}],"fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"Schedule"}],"navigatorTitle":[{"kind":"identifier","text":"Schedule"}],"type":"topic","kind":"symbol","role":"symbol"},"doc://ECS/documentation/ECS/GettingStarted":{"identifier":"doc:\/\/ECS\/documentation\/ECS\/GettingStarted","url":"\/documentation\/ecs\/gettingstarted","title":"Getting Started with ECS","abstract":[{"text":"Define components, spawn entities, and move them with systems that run in a schedule and a","type":"text"},{"text":" ","type":"text"},{"text":"simulation.","type":"text"}],"type":"topic","kind":"article","role":"article"},"doc://ECS/documentation/ECS":{"abstract":[{"type":"text","text":"Build games and simulations from entities, the components they hold, and systems that update"},{"type":"text","text":" "},{"type":"text","text":"them in a declared order."}],"kind":"symbol","type":"topic","role":"collection","url":"\/documentation\/ecs","title":"ECS","identifier":"doc:\/\/ECS\/documentation\/ECS"}}}