{"variants":[{"paths":["\/documentation\/ecs"],"traits":[{"interfaceLanguage":"swift"}]}],"kind":"symbol","sections":[],"primaryContentSections":[{"kind":"content","content":[{"type":"heading","anchor":"Overview","text":"Overview","level":2},{"type":"paragraph","inlineContent":[{"type":"text","text":"ECS is an entity component system for Swift. It suits any program that updates many similar"},{"type":"text","text":" "},{"type":"text","text":"things each step, such as the bodies of a physics simulation or the characters of a game."}]},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"text":"Entities are lightweight handles. An ","type":"text"},{"identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/Entity","isActive":true,"type":"reference"},{"text":" holds no data of its own.","type":"text"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Components are plain value types, such as a position or a velocity, attached to entities."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"A "},{"identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/World","type":"reference","isActive":true},{"type":"text","text":" holds the entities and their components, along with "},{"type":"emphasis","inlineContent":[{"type":"text","text":"resources"}]},{"type":"text","text":","},{"type":"text","text":" "},{"type":"text","text":"values the world holds once, such as a clock."}]}]},{"content":[{"inlineContent":[{"text":"Systems are rules that read and change the world through queries and updates, and a","type":"text"},{"text":" ","type":"text"},{"identifier":"doc:\/\/Systems\/documentation\/Systems\/Schedule","isActive":true,"type":"reference"},{"text":" runs them in the order you write, at the same time where they don’t","type":"text"},{"text":" ","type":"text"},{"text":"conflict.","type":"text"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"A ","type":"text"},{"identifier":"doc:\/\/SimulationModule\/documentation\/SimulationModule\/Simulation","type":"reference","isActive":true},{"text":" runs a world frame by frame, with a fixed timestep and","type":"text"},{"text":" ","type":"text"},{"text":"states.","type":"text"}]}]}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"A world is a copy-on-write value, like an array: copies are cheap and independent, so you can"},{"type":"text","text":" "},{"type":"text","text":"keep one for a snapshot, an undo step or a rollback."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"The following example, using the "},{"type":"codeVoice","code":"Position"},{"type":"text","text":" and "},{"type":"codeVoice","code":"Velocity"},{"type":"text","text":" components from"},{"type":"text","text":" "},{"isActive":true,"type":"reference","identifier":"doc:\/\/ECS\/documentation\/ECS\/GettingStarted"},{"type":"text","text":", spawns a ball and moves it one step by its velocity:"}]},{"type":"codeListing","code":["import ECS","","var world = World()","let ball = world.spawn(Position(x: 0, y: 0), Velocity(dx: 1, dy: 2))","world.update(Position.self, reading: Velocity.self) { position, row in","    position.x += row.components.dx","    position.y += row.components.dy","}","print(world[Position.self, of: ball])","\/\/ Prints \"Position(x: 1.0, y: 2.0)\""],"syntax":"swift"},{"type":"paragraph","inlineContent":[{"code":"import ECS","type":"codeVoice"},{"text":" imports every module. Each module also has its own documentation, and you can","type":"text"},{"text":" ","type":"text"},{"text":"import one on its own.","type":"text"}]}]}],"identifier":{"url":"doc:\/\/ECS\/documentation\/ECS","interfaceLanguage":"swift"},"metadata":{"role":"collection","title":"ECS","externalID":"ECS","symbolKind":"module","roleHeading":"Framework","modules":[{"name":"ECS"}]},"schemaVersion":{"patch":0,"major":0,"minor":3},"hierarchy":{"paths":[[]]},"abstract":[{"text":"Build games and simulations from entities, the components they hold, and systems that update","type":"text"},{"text":" ","type":"text"},{"text":"them in a declared order.","type":"text"}],"topicSections":[{"anchor":"Essentials","identifiers":["doc:\/\/ECS\/documentation\/ECS\/GettingStarted"],"title":"Essentials"},{"anchor":"Modules","identifiers":["doc:\/\/WorldModule\/documentation\/WorldModule","doc:\/\/Systems\/documentation\/Systems","doc:\/\/SimulationModule\/documentation\/SimulationModule"],"title":"Modules"}],"references":{"doc://WorldModule/documentation/WorldModule/World":{"url":"\/documentation\/worldmodule\/world","identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/World","title":"World","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"World","kind":"identifier"}],"role":"symbol","type":"topic","kind":"symbol","navigatorTitle":[{"text":"World","kind":"identifier"}],"abstract":[{"type":"text","text":"A collection of entities, the components they hold, and resources."}]},"doc://Systems/documentation/Systems":{"kind":"symbol","identifier":"doc:\/\/Systems\/documentation\/Systems","role":"collection","abstract":[{"type":"text","text":"Declare the rules of a simulation as systems, and run them on a world in a schedule."}],"type":"topic","title":"Systems","url":"\/documentation\/systems"},"doc://SimulationModule/documentation/SimulationModule":{"url":"\/documentation\/simulationmodule","title":"SimulationModule","identifier":"doc:\/\/SimulationModule\/documentation\/SimulationModule","role":"collection","type":"topic","kind":"symbol","abstract":[{"type":"text","text":"Run a world frame by frame, with schedules for startup, a fixed timestep and each frame, and"},{"type":"text","text":" "},{"type":"text","text":"with states that switch systems on and off."}]},"doc://WorldModule/documentation/WorldModule":{"kind":"symbol","identifier":"doc:\/\/WorldModule\/documentation\/WorldModule","role":"collection","abstract":[{"type":"text","text":"Store the state of a game or simulation as entities and components, and read and change it with"},{"type":"text","text":" "},{"type":"text","text":"queries, updates, and commands."}],"title":"WorldModule","type":"topic","url":"\/documentation\/worldmodule"},"doc://ECS/documentation/ECS/GettingStarted":{"url":"\/documentation\/ecs\/gettingstarted","identifier":"doc:\/\/ECS\/documentation\/ECS\/GettingStarted","title":"Getting Started with ECS","role":"article","type":"topic","kind":"article","abstract":[{"type":"text","text":"Define components, spawn entities, and move them with systems that run in a schedule and a"},{"type":"text","text":" "},{"type":"text","text":"simulation."}]},"doc://WorldModule/documentation/WorldModule/Entity":{"navigatorTitle":[{"kind":"identifier","text":"Entity"}],"kind":"symbol","identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/Entity","role":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Entity","kind":"identifier"}],"abstract":[{"type":"text","text":"A handle that identifies one entity in a world."}],"url":"\/documentation\/worldmodule\/entity","type":"topic","title":"Entity"},"doc://Systems/documentation/Systems/Schedule":{"identifier":"doc:\/\/Systems\/documentation\/Systems\/Schedule","title":"Schedule","url":"\/documentation\/systems\/schedule","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Schedule","kind":"identifier"}],"role":"symbol","type":"topic","kind":"symbol","navigatorTitle":[{"text":"Schedule","kind":"identifier"}],"abstract":[{"text":"A list of systems that run on a world, in order, and at the same time where they can.","type":"text"}]},"doc://SimulationModule/documentation/SimulationModule/Simulation":{"identifier":"doc:\/\/SimulationModule\/documentation\/SimulationModule\/Simulation","title":"Simulation","url":"\/documentation\/simulationmodule\/simulation","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Simulation","kind":"identifier"}],"role":"symbol","type":"topic","kind":"symbol","navigatorTitle":[{"text":"Simulation","kind":"identifier"}],"abstract":[{"text":"A world and its schedules by label, advanced one frame at a time.","type":"text"}]},"doc://ECS/documentation/ECS":{"url":"\/documentation\/ecs","kind":"symbol","role":"collection","identifier":"doc:\/\/ECS\/documentation\/ECS","type":"topic","abstract":[{"text":"Build games and simulations from entities, the components they hold, and systems that update","type":"text"},{"text":" ","type":"text"},{"text":"them in a declared order.","type":"text"}],"title":"ECS"}}}