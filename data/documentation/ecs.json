{"variants":[{"paths":["\/documentation\/ecs"],"traits":[{"interfaceLanguage":"swift"}]}],"kind":"symbol","sections":[],"topicSections":[{"title":"Essentials","identifiers":["doc:\/\/ECS\/documentation\/ECS\/GettingStarted"],"anchor":"Essentials"},{"title":"Modules","identifiers":["doc:\/\/WorldModule\/documentation\/WorldModule","doc:\/\/Systems\/documentation\/Systems","doc:\/\/SimulationModule\/documentation\/SimulationModule"],"anchor":"Modules"}],"identifier":{"url":"doc:\/\/ECS\/documentation\/ECS","interfaceLanguage":"swift"},"schemaVersion":{"minor":3,"patch":0,"major":0},"metadata":{"modules":[{"name":"ECS"}],"title":"ECS","roleHeading":"Framework","role":"collection","symbolKind":"module","externalID":"ECS"},"abstract":[{"text":"Build games and simulations from entities, the components they hold, and systems that update","type":"text"},{"text":" ","type":"text"},{"text":"them in a declared order.","type":"text"}],"primaryContentSections":[{"kind":"content","content":[{"anchor":"Overview","type":"heading","level":2,"text":"Overview"},{"type":"paragraph","inlineContent":[{"text":"ECS is an entity component system for Swift. It suits any program that updates many similar","type":"text"},{"text":" ","type":"text"},{"text":"things each step, such as the bodies of a physics simulation or the characters of a game.","type":"text"}]},{"items":[{"content":[{"inlineContent":[{"type":"text","text":"Entities are lightweight handles. An "},{"isActive":true,"type":"reference","identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/Entity"},{"type":"text","text":" holds no data of its own."}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Components are plain value types, such as a position or a velocity, attached to entities."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"A "},{"identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/World","type":"reference","isActive":true},{"type":"text","text":" holds the entities and their components, along with "},{"type":"emphasis","inlineContent":[{"type":"text","text":"resources"}]},{"type":"text","text":","},{"type":"text","text":" "},{"type":"text","text":"values the world holds once, such as a clock."}]}]},{"content":[{"inlineContent":[{"type":"text","text":"Systems are rules that read and change the world through queries and updates, and a"},{"type":"text","text":" "},{"type":"reference","identifier":"doc:\/\/Systems\/documentation\/Systems\/Schedule","isActive":true},{"type":"text","text":" runs them in the order you write, at the same time where they don’t"},{"type":"text","text":" "},{"type":"text","text":"conflict."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"A "},{"type":"reference","isActive":true,"identifier":"doc:\/\/SimulationModule\/documentation\/SimulationModule\/Simulation"},{"type":"text","text":" runs a world frame by frame, with a fixed timestep and"},{"type":"text","text":" "},{"type":"text","text":"states."}],"type":"paragraph"}]}],"type":"unorderedList"},{"type":"paragraph","inlineContent":[{"text":"A world is a copy-on-write value, like an array: copies are cheap and independent, so you can","type":"text"},{"text":" ","type":"text"},{"text":"keep one for a snapshot, an undo step or a rollback.","type":"text"}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"The following example, using the "},{"type":"codeVoice","code":"Position"},{"type":"text","text":" and "},{"type":"codeVoice","code":"Velocity"},{"type":"text","text":" components from"},{"type":"text","text":" "},{"type":"reference","isActive":true,"identifier":"doc:\/\/ECS\/documentation\/ECS\/GettingStarted"},{"type":"text","text":", spawns a ball and moves it one step by its velocity:"}]},{"type":"codeListing","code":["import ECS","","var world = World()","let ball = world.spawn(Position(x: 0, y: 0), Velocity(dx: 1, dy: 2))","world.update(Position.self, reading: Velocity.self) { position, row in","    position.x += row.components.dx","    position.y += row.components.dy","}","print(world[Position.self, of: ball])","\/\/ Prints \"Position(x: 1.0, y: 2.0)\""],"syntax":"swift"},{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"import ECS"},{"type":"text","text":" imports every module. Each module also has its own documentation, and you can"},{"type":"text","text":" "},{"type":"text","text":"import one on its own."}]}]}],"hierarchy":{"paths":[[]]},"references":{"doc://ECS/documentation/ECS/GettingStarted":{"abstract":[{"type":"text","text":"Define components, spawn entities, and move them with systems that run in a schedule and a"},{"type":"text","text":" "},{"type":"text","text":"simulation."}],"kind":"article","url":"\/documentation\/ecs\/gettingstarted","identifier":"doc:\/\/ECS\/documentation\/ECS\/GettingStarted","title":"Getting Started with ECS","type":"topic","role":"article"},"doc://WorldModule/documentation/WorldModule/World":{"navigatorTitle":[{"kind":"identifier","text":"World"}],"kind":"symbol","role":"symbol","identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/World","abstract":[{"text":"A collection of entities, the components they hold, and resources.","type":"text"}],"url":"\/documentation\/worldmodule\/world","type":"topic","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"World"}],"title":"World"},"doc://WorldModule/documentation/WorldModule":{"title":"WorldModule","kind":"symbol","type":"topic","identifier":"doc:\/\/WorldModule\/documentation\/WorldModule","url":"\/documentation\/worldmodule","abstract":[{"text":"Store the state of a game or simulation as entities and components, and read and change it with","type":"text"},{"text":" ","type":"text"},{"text":"queries, updates, and commands.","type":"text"}],"role":"collection"},"doc://Systems/documentation/Systems/Schedule":{"navigatorTitle":[{"kind":"identifier","text":"Schedule"}],"kind":"symbol","role":"symbol","identifier":"doc:\/\/Systems\/documentation\/Systems\/Schedule","abstract":[{"type":"text","text":"A list of systems that run on a world, in order, and at the same time where they can."}],"url":"\/documentation\/systems\/schedule","type":"topic","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"Schedule"}],"title":"Schedule"},"doc://Systems/documentation/Systems":{"kind":"symbol","role":"collection","identifier":"doc:\/\/Systems\/documentation\/Systems","abstract":[{"type":"text","text":"Declare the rules of a simulation as systems, and run them on a world in a schedule."}],"url":"\/documentation\/systems","type":"topic","title":"Systems"},"doc://WorldModule/documentation/WorldModule/Entity":{"title":"Entity","kind":"symbol","type":"topic","navigatorTitle":[{"kind":"identifier","text":"Entity"}],"url":"\/documentation\/worldmodule\/entity","abstract":[{"type":"text","text":"A handle that identifies one entity in a world."}],"identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/Entity","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"Entity"}],"role":"symbol"},"doc://SimulationModule/documentation/SimulationModule":{"kind":"symbol","abstract":[{"type":"text","text":"Run a world frame by frame, with schedules for startup, a fixed timestep and each frame, and"},{"type":"text","text":" "},{"type":"text","text":"with states that switch systems on and off."}],"url":"\/documentation\/simulationmodule","identifier":"doc:\/\/SimulationModule\/documentation\/SimulationModule","title":"SimulationModule","type":"topic","role":"collection"},"doc://SimulationModule/documentation/SimulationModule/Simulation":{"navigatorTitle":[{"text":"Simulation","kind":"identifier"}],"kind":"symbol","role":"symbol","identifier":"doc:\/\/SimulationModule\/documentation\/SimulationModule\/Simulation","abstract":[{"type":"text","text":"A world and its schedules by label, advanced one frame at a time."}],"url":"\/documentation\/simulationmodule\/simulation","type":"topic","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Simulation","kind":"identifier"}],"title":"Simulation"},"doc://ECS/documentation/ECS":{"kind":"symbol","role":"collection","identifier":"doc:\/\/ECS\/documentation\/ECS","abstract":[{"text":"Build games and simulations from entities, the components they hold, and systems that update","type":"text"},{"text":" ","type":"text"},{"text":"them in a declared order.","type":"text"}],"url":"\/documentation\/ecs","type":"topic","title":"ECS"}}}