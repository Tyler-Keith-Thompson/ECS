{"sections":[],"topicSections":[{"title":"Essentials","anchor":"Essentials","identifiers":["doc:\/\/ECS\/documentation\/ECS\/GettingStarted"]},{"title":"Modules","anchor":"Modules","identifiers":["doc:\/\/WorldModule\/documentation\/WorldModule","doc:\/\/Systems\/documentation\/Systems","doc:\/\/SimulationModule\/documentation\/SimulationModule"]}],"kind":"symbol","metadata":{"modules":[{"name":"ECS"}],"roleHeading":"Framework","role":"collection","title":"ECS","symbolKind":"module","externalID":"ECS"},"primaryContentSections":[{"kind":"content","content":[{"level":2,"anchor":"Overview","type":"heading","text":"Overview"},{"inlineContent":[{"type":"text","text":"ECS is an entity component system for Swift. It suits any program that updates many similar"},{"type":"text","text":" "},{"type":"text","text":"things each step, such as the bodies of a physics simulation or the characters of a game."}],"type":"paragraph"},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"text":"Entities are lightweight handles. An ","type":"text"},{"isActive":true,"identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/Entity","type":"reference"},{"text":" holds no data of its own.","type":"text"}]}]},{"content":[{"inlineContent":[{"type":"text","text":"Components are plain value types, such as a position or a velocity, attached to entities."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"A "},{"type":"reference","isActive":true,"identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/World"},{"type":"text","text":" holds the entities and their components, along with "},{"type":"emphasis","inlineContent":[{"text":"resources","type":"text"}]},{"type":"text","text":","},{"type":"text","text":" "},{"type":"text","text":"values the world holds once, such as a clock."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"Systems are rules that read and change the world through queries and updates, and a"},{"type":"text","text":" "},{"type":"reference","identifier":"doc:\/\/Systems\/documentation\/Systems\/Schedule","isActive":true},{"type":"text","text":" runs them in the order you write, at the same time where they don’t"},{"type":"text","text":" "},{"type":"text","text":"conflict."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"A "},{"isActive":true,"type":"reference","identifier":"doc:\/\/SimulationModule\/documentation\/SimulationModule\/Simulation"},{"type":"text","text":" runs a world frame by frame, with a fixed timestep and"},{"type":"text","text":" "},{"type":"text","text":"states."}],"type":"paragraph"}]}]},{"inlineContent":[{"type":"text","text":"A world is a copy-on-write value, like an array: copies are cheap and independent, so you can"},{"type":"text","text":" "},{"type":"text","text":"keep one for a snapshot, an undo step or a rollback."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"The following example, using the "},{"type":"codeVoice","code":"Position"},{"type":"text","text":" and "},{"type":"codeVoice","code":"Velocity"},{"type":"text","text":" components from"},{"type":"text","text":" "},{"type":"reference","identifier":"doc:\/\/ECS\/documentation\/ECS\/GettingStarted","isActive":true},{"type":"text","text":", spawns a ball and moves it one step by its velocity:"}],"type":"paragraph"},{"syntax":"swift","type":"codeListing","code":["import ECS","","var world = World()","let ball = world.spawn(Position(x: 0, y: 0), Velocity(dx: 1, dy: 2))","world.update(Position.self, reading: Velocity.self) { position, row in","    position.x += row.components.dx","    position.y += row.components.dy","}","print(world[Position.self, of: ball])","\/\/ Prints \"Position(x: 1.0, y: 2.0)\""]},{"inlineContent":[{"code":"import ECS","type":"codeVoice"},{"text":" imports every module. Each module also has its own documentation, and you can","type":"text"},{"text":" ","type":"text"},{"text":"import one on its own.","type":"text"}],"type":"paragraph"}]}],"identifier":{"url":"doc:\/\/ECS\/documentation\/ECS","interfaceLanguage":"swift"},"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/ecs"]}],"abstract":[{"type":"text","text":"Build games and simulations from entities, the components they hold, and systems that update"},{"type":"text","text":" "},{"type":"text","text":"them in a declared order."}],"schemaVersion":{"minor":3,"patch":0,"major":0},"hierarchy":{"paths":[[]]},"references":{"doc://Systems/documentation/Systems":{"identifier":"doc:\/\/Systems\/documentation\/Systems","role":"collection","kind":"symbol","title":"Systems","type":"topic","url":"\/documentation\/systems","abstract":[{"text":"Declare the rules of a simulation as systems, and run them on a world in a schedule.","type":"text"}]},"doc://ECS/documentation/ECS/GettingStarted":{"url":"\/documentation\/ecs\/gettingstarted","type":"topic","kind":"article","role":"article","title":"Getting Started with ECS","identifier":"doc:\/\/ECS\/documentation\/ECS\/GettingStarted","abstract":[{"type":"text","text":"Define components, spawn entities, and move them with systems that run in a schedule and a"},{"type":"text","text":" "},{"type":"text","text":"simulation."}]},"doc://WorldModule/documentation/WorldModule":{"identifier":"doc:\/\/WorldModule\/documentation\/WorldModule","role":"collection","kind":"symbol","type":"topic","title":"WorldModule","url":"\/documentation\/worldmodule","abstract":[{"text":"Store the state of a game or simulation as entities and components, and read and change it with","type":"text"},{"text":" ","type":"text"},{"text":"queries, updates, and commands.","type":"text"}]},"doc://WorldModule/documentation/WorldModule/Entity":{"fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"Entity"}],"url":"\/documentation\/worldmodule\/entity","type":"topic","kind":"symbol","role":"symbol","title":"Entity","identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/Entity","navigatorTitle":[{"kind":"identifier","text":"Entity"}],"abstract":[{"type":"text","text":"A handle that identifies one entity in a world."}]},"doc://ECS/documentation/ECS":{"identifier":"doc:\/\/ECS\/documentation\/ECS","role":"collection","kind":"symbol","type":"topic","title":"ECS","url":"\/documentation\/ecs","abstract":[{"type":"text","text":"Build games and simulations from entities, the components they hold, and systems that update"},{"type":"text","text":" "},{"type":"text","text":"them in a declared order."}]},"doc://SimulationModule/documentation/SimulationModule":{"url":"\/documentation\/simulationmodule","type":"topic","kind":"symbol","role":"collection","identifier":"doc:\/\/SimulationModule\/documentation\/SimulationModule","title":"SimulationModule","abstract":[{"type":"text","text":"Run a world frame by frame, with schedules for startup, a fixed timestep and each frame, and"},{"type":"text","text":" "},{"type":"text","text":"with states that switch systems on and off."}]},"doc://Systems/documentation/Systems/Schedule":{"identifier":"doc:\/\/Systems\/documentation\/Systems\/Schedule","role":"symbol","navigatorTitle":[{"text":"Schedule","kind":"identifier"}],"kind":"symbol","title":"Schedule","type":"topic","url":"\/documentation\/systems\/schedule","abstract":[{"text":"A list of systems that run on a world, in order, and at the same time where they can.","type":"text"}],"fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Schedule","kind":"identifier"}]},"doc://WorldModule/documentation/WorldModule/World":{"identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/World","role":"symbol","navigatorTitle":[{"kind":"identifier","text":"World"}],"kind":"symbol","title":"World","type":"topic","url":"\/documentation\/worldmodule\/world","abstract":[{"type":"text","text":"A collection of entities, the components they hold, and resources."}],"fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"World"}]},"doc://SimulationModule/documentation/SimulationModule/Simulation":{"role":"symbol","kind":"symbol","title":"Simulation","navigatorTitle":[{"kind":"identifier","text":"Simulation"}],"abstract":[{"text":"A world and its schedules by label, advanced one frame at a time.","type":"text"}],"url":"\/documentation\/simulationmodule\/simulation","type":"topic","identifier":"doc:\/\/SimulationModule\/documentation\/SimulationModule\/Simulation","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"Simulation"}]}}}