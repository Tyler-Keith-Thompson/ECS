{"primaryContentSections":[{"content":[{"level":2,"text":"Overview","type":"heading","anchor":"Overview"},{"inlineContent":[{"type":"text","text":"ECS is an entity component system for Swift. It suits any program that updates many similar"},{"type":"text","text":" "},{"type":"text","text":"things each step, such as the bodies of a physics simulation or the characters of a game."}],"type":"paragraph"},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Entities are lightweight handles. An "},{"isActive":true,"type":"reference","identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/Entity"},{"type":"text","text":" holds no data of its own."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Components are plain value types, such as a position or a velocity, attached to entities."}]}]},{"content":[{"inlineContent":[{"text":"A ","type":"text"},{"isActive":true,"identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/World","type":"reference"},{"text":" holds the entities and their components, along with ","type":"text"},{"inlineContent":[{"text":"resources","type":"text"}],"type":"emphasis"},{"text":",","type":"text"},{"text":" ","type":"text"},{"text":"values the world holds once, such as a clock.","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"Systems are rules that read and change the world through queries and updates, and a","type":"text"},{"text":" ","type":"text"},{"isActive":true,"identifier":"doc:\/\/Systems\/documentation\/Systems\/Schedule","type":"reference"},{"text":" runs them in the order you write, at the same time where they don’t","type":"text"},{"text":" ","type":"text"},{"text":"conflict.","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"A ","type":"text"},{"isActive":true,"identifier":"doc:\/\/SimulationModule\/documentation\/SimulationModule\/Simulation","type":"reference"},{"text":" runs a world frame by frame, with a fixed timestep and","type":"text"},{"text":" ","type":"text"},{"text":"states.","type":"text"}],"type":"paragraph"}]}]},{"inlineContent":[{"type":"text","text":"A world is a copy-on-write value, like an array: copies are cheap and independent, so you can"},{"type":"text","text":" "},{"type":"text","text":"keep one for a snapshot, an undo step or a rollback."}],"type":"paragraph"},{"inlineContent":[{"text":"The following example, using the ","type":"text"},{"code":"Position","type":"codeVoice"},{"text":" and ","type":"text"},{"code":"Velocity","type":"codeVoice"},{"text":" components from","type":"text"},{"text":" ","type":"text"},{"identifier":"doc:\/\/ECS\/documentation\/ECS\/GettingStarted","type":"reference","isActive":true},{"text":", spawns a ball and moves it one step by its velocity:","type":"text"}],"type":"paragraph"},{"syntax":"swift","type":"codeListing","code":["import ECS","","var world = World()","let ball = world.spawn(Position(x: 0, y: 0), Velocity(dx: 1, dy: 2))","world.update(Position.self, reading: Velocity.self) { position, row in","    position.x += row.components.dx","    position.y += row.components.dy","}","print(world[Position.self, of: ball])","\/\/ Prints \"Position(x: 1.0, y: 2.0)\""]},{"inlineContent":[{"type":"codeVoice","code":"import ECS"},{"text":" imports every module. Each module also has its own documentation, and you can","type":"text"},{"text":" ","type":"text"},{"text":"import one on its own.","type":"text"}],"type":"paragraph"}],"kind":"content"}],"sections":[],"kind":"symbol","variants":[{"paths":["\/documentation\/ecs"],"traits":[{"interfaceLanguage":"swift"}]}],"hierarchy":{"paths":[[]]},"metadata":{"roleHeading":"Framework","title":"ECS","modules":[{"name":"ECS"}],"symbolKind":"module","role":"collection","externalID":"ECS"},"identifier":{"url":"doc:\/\/ECS\/documentation\/ECS","interfaceLanguage":"swift"},"schemaVersion":{"major":0,"patch":0,"minor":3},"abstract":[{"type":"text","text":"Build games and simulations from entities, the components they hold, and systems that update"},{"type":"text","text":" "},{"type":"text","text":"them in a declared order."}],"topicSections":[{"anchor":"Essentials","title":"Essentials","identifiers":["doc:\/\/ECS\/documentation\/ECS\/GettingStarted"]},{"anchor":"Modules","title":"Modules","identifiers":["doc:\/\/WorldModule\/documentation\/WorldModule","doc:\/\/Systems\/documentation\/Systems","doc:\/\/SimulationModule\/documentation\/SimulationModule"]}],"references":{"doc://Systems/documentation/Systems":{"url":"\/documentation\/systems","identifier":"doc:\/\/Systems\/documentation\/Systems","kind":"symbol","title":"Systems","role":"collection","type":"topic","abstract":[{"type":"text","text":"Declare the rules of a simulation as systems, and run them on a world in a schedule."}]},"doc://WorldModule/documentation/WorldModule/World":{"role":"symbol","navigatorTitle":[{"kind":"identifier","text":"World"}],"fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"World"}],"kind":"symbol","title":"World","url":"\/documentation\/worldmodule\/world","identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/World","type":"topic","abstract":[{"text":"A collection of entities, the components they hold, and resources.","type":"text"}]},"doc://SimulationModule/documentation/SimulationModule":{"url":"\/documentation\/simulationmodule","identifier":"doc:\/\/SimulationModule\/documentation\/SimulationModule","kind":"symbol","title":"SimulationModule","role":"collection","type":"topic","abstract":[{"type":"text","text":"Run a world frame by frame, with schedules for startup, a fixed timestep and each frame, and"},{"type":"text","text":" "},{"type":"text","text":"with states that switch systems on and off."}]},"doc://SimulationModule/documentation/SimulationModule/Simulation":{"role":"symbol","navigatorTitle":[{"text":"Simulation","kind":"identifier"}],"fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Simulation","kind":"identifier"}],"kind":"symbol","title":"Simulation","url":"\/documentation\/simulationmodule\/simulation","identifier":"doc:\/\/SimulationModule\/documentation\/SimulationModule\/Simulation","type":"topic","abstract":[{"text":"A world and its schedules by label, advanced one frame at a time.","type":"text"}]},"doc://ECS/documentation/ECS/GettingStarted":{"url":"\/documentation\/ecs\/gettingstarted","identifier":"doc:\/\/ECS\/documentation\/ECS\/GettingStarted","kind":"article","title":"Getting Started with ECS","role":"article","type":"topic","abstract":[{"type":"text","text":"Define components, spawn entities, and move them with systems that run in a schedule and a"},{"type":"text","text":" "},{"type":"text","text":"simulation."}]},"doc://Systems/documentation/Systems/Schedule":{"role":"symbol","navigatorTitle":[{"kind":"identifier","text":"Schedule"}],"fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"Schedule"}],"kind":"symbol","title":"Schedule","url":"\/documentation\/systems\/schedule","identifier":"doc:\/\/Systems\/documentation\/Systems\/Schedule","type":"topic","abstract":[{"text":"A list of systems that run on a world, in order, and at the same time where they can.","type":"text"}]},"doc://ECS/documentation/ECS":{"url":"\/documentation\/ecs","identifier":"doc:\/\/ECS\/documentation\/ECS","kind":"symbol","title":"ECS","role":"collection","type":"topic","abstract":[{"type":"text","text":"Build games and simulations from entities, the components they hold, and systems that update"},{"type":"text","text":" "},{"type":"text","text":"them in a declared order."}]},"doc://WorldModule/documentation/WorldModule":{"url":"\/documentation\/worldmodule","identifier":"doc:\/\/WorldModule\/documentation\/WorldModule","kind":"symbol","title":"WorldModule","role":"collection","type":"topic","abstract":[{"type":"text","text":"Store the state of a game or simulation as entities and components, and read and change it with"},{"type":"text","text":" "},{"type":"text","text":"queries, updates, and commands."}]},"doc://WorldModule/documentation/WorldModule/Entity":{"identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/Entity","url":"\/documentation\/worldmodule\/entity","role":"symbol","navigatorTitle":[{"kind":"identifier","text":"Entity"}],"type":"topic","title":"Entity","abstract":[{"type":"text","text":"A handle that identifies one entity in a world."}],"fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"Entity"}],"kind":"symbol"}}}