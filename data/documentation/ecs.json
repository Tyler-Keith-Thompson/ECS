{"hierarchy":{"paths":[[]]},"kind":"symbol","sections":[],"identifier":{"url":"doc:\/\/ECS\/documentation\/ECS","interfaceLanguage":"swift"},"abstract":[{"type":"text","text":"Build games and simulations from entities, the components they hold, and systems that update"},{"type":"text","text":" "},{"type":"text","text":"them in a declared order."}],"schemaVersion":{"minor":3,"patch":0,"major":0},"primaryContentSections":[{"content":[{"type":"heading","text":"Overview","level":2,"anchor":"Overview"},{"inlineContent":[{"text":"ECS is an entity component system for Swift. It suits any program that updates many similar","type":"text"},{"text":" ","type":"text"},{"text":"things each step, such as the bodies of a physics simulation or the characters of a game.","type":"text"}],"type":"paragraph"},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"text":"Entities are lightweight handles. An ","type":"text"},{"type":"reference","isActive":true,"identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/Entity"},{"text":" holds no data of its own.","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Components are plain value types, such as a position or a velocity, attached to entities."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"A ","type":"text"},{"identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/World","isActive":true,"type":"reference"},{"text":" holds the entities and their components, along with ","type":"text"},{"inlineContent":[{"type":"text","text":"resources"}],"type":"emphasis"},{"text":",","type":"text"},{"text":" ","type":"text"},{"text":"values the world holds once, such as a clock.","type":"text"}]}]},{"content":[{"inlineContent":[{"type":"text","text":"Systems are rules that read and change the world through queries and updates, and a"},{"type":"text","text":" "},{"type":"reference","identifier":"doc:\/\/Systems\/documentation\/Systems\/Schedule","isActive":true},{"type":"text","text":" runs them in the order you write, at the same time where they don’t"},{"type":"text","text":" "},{"type":"text","text":"conflict."}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"A "},{"type":"reference","identifier":"doc:\/\/SimulationModule\/documentation\/SimulationModule\/Simulation","isActive":true},{"type":"text","text":" runs a world frame by frame, with a fixed timestep and"},{"type":"text","text":" "},{"type":"text","text":"states."}]}]}]},{"inlineContent":[{"type":"text","text":"A world is a copy-on-write value, like an array: copies are cheap and independent, so you can"},{"type":"text","text":" "},{"type":"text","text":"keep one for a snapshot, an undo step or a rollback."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"The following example, using the "},{"type":"codeVoice","code":"Position"},{"type":"text","text":" and "},{"type":"codeVoice","code":"Velocity"},{"type":"text","text":" components from"},{"type":"text","text":" "},{"identifier":"doc:\/\/ECS\/documentation\/ECS\/GettingStarted","type":"reference","isActive":true},{"type":"text","text":", spawns a ball and moves it one step by its velocity:"}],"type":"paragraph"},{"type":"codeListing","syntax":"swift","code":["import ECS","","var world = World()","let ball = world.spawn(Position(x: 0, y: 0), Velocity(dx: 1, dy: 2))","world.update(Position.self, reading: Velocity.self) { position, row in","    position.x += row.components.dx","    position.y += row.components.dy","}","print(world[Position.self, of: ball])","\/\/ Prints \"Position(x: 1.0, y: 2.0)\""]},{"inlineContent":[{"type":"codeVoice","code":"import ECS"},{"text":" imports every module. Each module also has its own documentation, and you can","type":"text"},{"text":" ","type":"text"},{"text":"import one on its own.","type":"text"}],"type":"paragraph"}],"kind":"content"}],"topicSections":[{"anchor":"Essentials","identifiers":["doc:\/\/ECS\/documentation\/ECS\/GettingStarted"],"title":"Essentials"},{"anchor":"Modules","identifiers":["doc:\/\/WorldModule\/documentation\/WorldModule","doc:\/\/Systems\/documentation\/Systems","doc:\/\/SimulationModule\/documentation\/SimulationModule"],"title":"Modules"}],"metadata":{"roleHeading":"Framework","role":"collection","externalID":"ECS","title":"ECS","symbolKind":"module","modules":[{"name":"ECS"}]},"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/ecs"]}],"references":{"doc://SimulationModule/documentation/SimulationModule":{"url":"\/documentation\/simulationmodule","abstract":[{"type":"text","text":"Run a world frame by frame, with schedules for startup, a fixed timestep and each frame, and"},{"type":"text","text":" "},{"type":"text","text":"with states that switch systems on and off."}],"role":"collection","type":"topic","identifier":"doc:\/\/SimulationModule\/documentation\/SimulationModule","title":"SimulationModule","kind":"symbol"},"doc://SimulationModule/documentation/SimulationModule/Simulation":{"fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Simulation","kind":"identifier"}],"kind":"symbol","abstract":[{"text":"A world and its schedules by label, advanced one frame at a time.","type":"text"}],"identifier":"doc:\/\/SimulationModule\/documentation\/SimulationModule\/Simulation","title":"Simulation","type":"topic","role":"symbol","url":"\/documentation\/simulationmodule\/simulation","navigatorTitle":[{"text":"Simulation","kind":"identifier"}]},"doc://WorldModule/documentation/WorldModule":{"url":"\/documentation\/worldmodule","abstract":[{"type":"text","text":"Store the state of a game or simulation as entities and components, and read and change it with"},{"type":"text","text":" "},{"type":"text","text":"queries, updates, and commands."}],"role":"collection","type":"topic","identifier":"doc:\/\/WorldModule\/documentation\/WorldModule","title":"WorldModule","kind":"symbol"},"doc://WorldModule/documentation/WorldModule/Entity":{"fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"Entity"}],"kind":"symbol","abstract":[{"type":"text","text":"A handle that identifies one entity in a world."}],"identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/Entity","title":"Entity","type":"topic","role":"symbol","url":"\/documentation\/worldmodule\/entity","navigatorTitle":[{"kind":"identifier","text":"Entity"}]},"doc://WorldModule/documentation/WorldModule/World":{"url":"\/documentation\/worldmodule\/world","abstract":[{"type":"text","text":"A collection of entities, the components they hold, and resources."}],"role":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"World","kind":"identifier"}],"type":"topic","identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/World","title":"World","navigatorTitle":[{"text":"World","kind":"identifier"}],"kind":"symbol"},"doc://ECS/documentation/ECS/GettingStarted":{"kind":"article","abstract":[{"type":"text","text":"Define components, spawn entities, and move them with systems that run in a schedule and a"},{"type":"text","text":" "},{"type":"text","text":"simulation."}],"identifier":"doc:\/\/ECS\/documentation\/ECS\/GettingStarted","title":"Getting Started with ECS","type":"topic","role":"article","url":"\/documentation\/ecs\/gettingstarted"},"doc://Systems/documentation/Systems":{"url":"\/documentation\/systems","abstract":[{"type":"text","text":"Declare the rules of a simulation as systems, and run them on a world in a schedule."}],"role":"collection","type":"topic","identifier":"doc:\/\/Systems\/documentation\/Systems","title":"Systems","kind":"symbol"},"doc://Systems/documentation/Systems/Schedule":{"url":"\/documentation\/systems\/schedule","abstract":[{"type":"text","text":"A list of systems that run on a world, in order, and at the same time where they can."}],"role":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Schedule","kind":"identifier"}],"type":"topic","identifier":"doc:\/\/Systems\/documentation\/Systems\/Schedule","title":"Schedule","navigatorTitle":[{"text":"Schedule","kind":"identifier"}],"kind":"symbol"},"doc://ECS/documentation/ECS":{"type":"topic","title":"ECS","role":"collection","identifier":"doc:\/\/ECS\/documentation\/ECS","kind":"symbol","url":"\/documentation\/ecs","abstract":[{"type":"text","text":"Build games and simulations from entities, the components they hold, and systems that update"},{"type":"text","text":" "},{"type":"text","text":"them in a declared order."}]}}}