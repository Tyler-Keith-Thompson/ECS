{"sections":[],"metadata":{"roleHeading":"Framework","externalID":"ECS","symbolKind":"module","role":"collection","modules":[{"name":"ECS"}],"title":"ECS"},"kind":"symbol","abstract":[{"type":"text","text":"Build games and simulations from entities, the components they hold, and systems that update"},{"type":"text","text":" "},{"type":"text","text":"them in a declared order."}],"variants":[{"paths":["\/documentation\/ecs"],"traits":[{"interfaceLanguage":"swift"}]}],"hierarchy":{"paths":[[]]},"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/ECS\/documentation\/ECS"},"schemaVersion":{"patch":0,"minor":3,"major":0},"topicSections":[{"anchor":"Essentials","title":"Essentials","identifiers":["doc:\/\/ECS\/documentation\/ECS\/GettingStarted"]},{"anchor":"Modules","title":"Modules","identifiers":["doc:\/\/WorldModule\/documentation\/WorldModule","doc:\/\/Systems\/documentation\/Systems","doc:\/\/SimulationModule\/documentation\/SimulationModule"]}],"primaryContentSections":[{"kind":"content","content":[{"text":"Overview","anchor":"Overview","type":"heading","level":2},{"type":"paragraph","inlineContent":[{"type":"text","text":"ECS is an entity component system for Swift. It suits any program that updates many similar"},{"type":"text","text":" "},{"type":"text","text":"things each step, such as the bodies of a physics simulation or the characters of a game."}]},{"items":[{"content":[{"inlineContent":[{"text":"Entities are lightweight handles. An ","type":"text"},{"type":"reference","identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/Entity","isActive":true},{"text":" holds no data of its own.","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"Components are plain value types, such as a position or a velocity, attached to entities.","type":"text"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"A ","type":"text"},{"identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/World","type":"reference","isActive":true},{"text":" holds the entities and their components, along with ","type":"text"},{"type":"emphasis","inlineContent":[{"type":"text","text":"resources"}]},{"text":",","type":"text"},{"text":" ","type":"text"},{"text":"values the world holds once, such as a clock.","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Systems are rules that read and change the world through queries and updates, and a"},{"type":"text","text":" "},{"isActive":true,"type":"reference","identifier":"doc:\/\/Systems\/documentation\/Systems\/Schedule"},{"type":"text","text":" runs them in the order you write, at the same time where they don’t"},{"type":"text","text":" "},{"type":"text","text":"conflict."}]}]},{"content":[{"inlineContent":[{"type":"text","text":"A "},{"identifier":"doc:\/\/SimulationModule\/documentation\/SimulationModule\/Simulation","type":"reference","isActive":true},{"type":"text","text":" runs a world frame by frame, with a fixed timestep and"},{"type":"text","text":" "},{"type":"text","text":"states."}],"type":"paragraph"}]}],"type":"unorderedList"},{"type":"paragraph","inlineContent":[{"type":"text","text":"A world is a copy-on-write value, like an array: copies are cheap and independent, so you can"},{"type":"text","text":" "},{"type":"text","text":"keep one for a snapshot, an undo step or a rollback."}]},{"type":"paragraph","inlineContent":[{"text":"The following example, using the ","type":"text"},{"type":"codeVoice","code":"Position"},{"text":" and ","type":"text"},{"type":"codeVoice","code":"Velocity"},{"text":" components from","type":"text"},{"text":" ","type":"text"},{"isActive":true,"identifier":"doc:\/\/ECS\/documentation\/ECS\/GettingStarted","type":"reference"},{"text":", spawns a ball and moves it one step by its velocity:","type":"text"}]},{"type":"codeListing","syntax":"swift","code":["import ECS","","var world = World()","let ball = world.spawn(Position(x: 0, y: 0), Velocity(dx: 1, dy: 2))","world.update(Position.self, reading: Velocity.self) { position, row in","    position.x += row.components.dx","    position.y += row.components.dy","}","print(world[Position.self, of: ball])","\/\/ Prints \"Position(x: 1.0, y: 2.0)\""]},{"type":"paragraph","inlineContent":[{"code":"import ECS","type":"codeVoice"},{"text":" imports every module. Each module also has its own documentation, and you can","type":"text"},{"text":" ","type":"text"},{"text":"import one on its own.","type":"text"}]}]}],"references":{"doc://SimulationModule/documentation/SimulationModule/Simulation":{"role":"symbol","abstract":[{"type":"text","text":"A world and its schedules by label, advanced one frame at a time."}],"navigatorTitle":[{"kind":"identifier","text":"Simulation"}],"kind":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"Simulation"}],"title":"Simulation","identifier":"doc:\/\/SimulationModule\/documentation\/SimulationModule\/Simulation","type":"topic","url":"\/documentation\/simulationmodule\/simulation"},"doc://ECS/documentation/ECS/GettingStarted":{"title":"Getting Started with ECS","abstract":[{"type":"text","text":"Define components, spawn entities, and move them with systems that run in a schedule and a"},{"type":"text","text":" "},{"type":"text","text":"simulation."}],"url":"\/documentation\/ecs\/gettingstarted","kind":"article","type":"topic","role":"article","identifier":"doc:\/\/ECS\/documentation\/ECS\/GettingStarted"},"doc://Systems/documentation/Systems/Schedule":{"role":"symbol","abstract":[{"type":"text","text":"A list of systems that run on a world, in order, and at the same time where they can."}],"navigatorTitle":[{"text":"Schedule","kind":"identifier"}],"kind":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Schedule","kind":"identifier"}],"title":"Schedule","identifier":"doc:\/\/Systems\/documentation\/Systems\/Schedule","type":"topic","url":"\/documentation\/systems\/schedule"},"doc://Systems/documentation/Systems":{"abstract":[{"type":"text","text":"Declare the rules of a simulation as systems, and run them on a world in a schedule."}],"kind":"symbol","title":"Systems","url":"\/documentation\/systems","type":"topic","role":"collection","identifier":"doc:\/\/Systems\/documentation\/Systems"},"doc://ECS/documentation/ECS":{"role":"collection","abstract":[{"type":"text","text":"Build games and simulations from entities, the components they hold, and systems that update"},{"type":"text","text":" "},{"type":"text","text":"them in a declared order."}],"kind":"symbol","title":"ECS","identifier":"doc:\/\/ECS\/documentation\/ECS","type":"topic","url":"\/documentation\/ecs"},"doc://WorldModule/documentation/WorldModule/World":{"title":"World","abstract":[{"text":"A collection of entities, the components they hold, and resources.","type":"text"}],"url":"\/documentation\/worldmodule\/world","kind":"symbol","type":"topic","navigatorTitle":[{"text":"World","kind":"identifier"}],"role":"symbol","identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/World","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"World","kind":"identifier"}]},"doc://SimulationModule/documentation/SimulationModule":{"role":"collection","abstract":[{"text":"Run a world frame by frame, with schedules for startup, a fixed timestep and each frame, and","type":"text"},{"text":" ","type":"text"},{"text":"with states that switch systems on and off.","type":"text"}],"kind":"symbol","title":"SimulationModule","identifier":"doc:\/\/SimulationModule\/documentation\/SimulationModule","type":"topic","url":"\/documentation\/simulationmodule"},"doc://WorldModule/documentation/WorldModule/Entity":{"role":"symbol","abstract":[{"type":"text","text":"A handle that identifies one entity in a world."}],"navigatorTitle":[{"text":"Entity","kind":"identifier"}],"kind":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Entity","kind":"identifier"}],"title":"Entity","identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/Entity","type":"topic","url":"\/documentation\/worldmodule\/entity"},"doc://WorldModule/documentation/WorldModule":{"identifier":"doc:\/\/WorldModule\/documentation\/WorldModule","url":"\/documentation\/worldmodule","type":"topic","kind":"symbol","role":"collection","abstract":[{"type":"text","text":"Store the state of a game or simulation as entities and components, and read and change it with"},{"type":"text","text":" "},{"type":"text","text":"queries, updates, and commands."}],"title":"WorldModule"}}}