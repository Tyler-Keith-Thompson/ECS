{"primaryContentSections":[{"kind":"content","content":[{"type":"heading","text":"Overview","level":2,"anchor":"Overview"},{"type":"paragraph","inlineContent":[{"type":"text","text":"ECS is an entity component system for Swift. It suits any program that updates many similar"},{"type":"text","text":" "},{"type":"text","text":"things each step, such as the bodies of a physics simulation or the characters of a game."}]},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"text":"Entities are lightweight handles. An ","type":"text"},{"isActive":true,"identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/Entity","type":"reference"},{"text":" holds no data of its own.","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"Components are plain value types, such as a position or a velocity, attached to entities.","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"A "},{"identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/World","type":"reference","isActive":true},{"type":"text","text":" holds the entities and their components, along with "},{"inlineContent":[{"text":"resources","type":"text"}],"type":"emphasis"},{"type":"text","text":","},{"type":"text","text":" "},{"type":"text","text":"values the world holds once, such as a clock."}]}]},{"content":[{"inlineContent":[{"text":"Systems are rules that read and change the world through queries and updates, and a","type":"text"},{"text":" ","type":"text"},{"type":"reference","identifier":"doc:\/\/Systems\/documentation\/Systems\/Schedule","isActive":true},{"text":" runs them in the order you write, at the same time where they don’t","type":"text"},{"text":" ","type":"text"},{"text":"conflict.","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"A "},{"isActive":true,"type":"reference","identifier":"doc:\/\/SimulationModule\/documentation\/SimulationModule\/Simulation"},{"type":"text","text":" runs a world frame by frame, with a fixed timestep and"},{"type":"text","text":" "},{"type":"text","text":"states."}],"type":"paragraph"}]}]},{"type":"paragraph","inlineContent":[{"text":"A world is a copy-on-write value, like an array: copies are cheap and independent, so you can","type":"text"},{"text":" ","type":"text"},{"text":"keep one for a snapshot, an undo step or a rollback.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"The following example, using the ","type":"text"},{"code":"Position","type":"codeVoice"},{"text":" and ","type":"text"},{"code":"Velocity","type":"codeVoice"},{"text":" components from","type":"text"},{"text":" ","type":"text"},{"isActive":true,"identifier":"doc:\/\/ECS\/documentation\/ECS\/GettingStarted","type":"reference"},{"text":", spawns a ball and moves it one step by its velocity:","type":"text"}]},{"code":["import ECS","","var world = World()","let ball = world.spawn(Position(x: 0, y: 0), Velocity(dx: 1, dy: 2))","world.update(Position.self, reading: Velocity.self) { position, row in","    position.x += row.components.dx","    position.y += row.components.dy","}","print(world[Position.self, of: ball])","\/\/ Prints \"Position(x: 1.0, y: 2.0)\""],"type":"codeListing","syntax":"swift"},{"type":"paragraph","inlineContent":[{"code":"import ECS","type":"codeVoice"},{"type":"text","text":" imports every module. Each module also has its own documentation, and you can"},{"type":"text","text":" "},{"type":"text","text":"import one on its own."}]}]}],"metadata":{"symbolKind":"module","roleHeading":"Framework","externalID":"ECS","title":"ECS","role":"collection","modules":[{"name":"ECS"}]},"schemaVersion":{"patch":0,"major":0,"minor":3},"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/ECS\/documentation\/ECS"},"variants":[{"paths":["\/documentation\/ecs"],"traits":[{"interfaceLanguage":"swift"}]}],"kind":"symbol","hierarchy":{"paths":[[]]},"abstract":[{"text":"Build games and simulations from entities, the components they hold, and systems that update","type":"text"},{"text":" ","type":"text"},{"text":"them in a declared order.","type":"text"}],"topicSections":[{"identifiers":["doc:\/\/ECS\/documentation\/ECS\/GettingStarted"],"anchor":"Essentials","title":"Essentials"},{"identifiers":["doc:\/\/WorldModule\/documentation\/WorldModule","doc:\/\/Systems\/documentation\/Systems","doc:\/\/SimulationModule\/documentation\/SimulationModule"],"anchor":"Modules","title":"Modules"}],"sections":[],"references":{"doc://ECS/documentation/ECS/GettingStarted":{"kind":"article","title":"Getting Started with ECS","abstract":[{"type":"text","text":"Define components, spawn entities, and move them with systems that run in a schedule and a"},{"type":"text","text":" "},{"type":"text","text":"simulation."}],"role":"article","type":"topic","url":"\/documentation\/ecs\/gettingstarted","identifier":"doc:\/\/ECS\/documentation\/ECS\/GettingStarted"},"doc://SimulationModule/documentation/SimulationModule":{"title":"SimulationModule","kind":"symbol","abstract":[{"text":"Run a world frame by frame, with schedules for startup, a fixed timestep and each frame, and","type":"text"},{"text":" ","type":"text"},{"text":"with states that switch systems on and off.","type":"text"}],"role":"collection","type":"topic","url":"\/documentation\/simulationmodule","identifier":"doc:\/\/SimulationModule\/documentation\/SimulationModule"},"doc://WorldModule/documentation/WorldModule":{"title":"WorldModule","kind":"symbol","abstract":[{"text":"Store the state of a game or simulation as entities and components, and read and change it with","type":"text"},{"text":" ","type":"text"},{"text":"queries, updates, and commands.","type":"text"}],"role":"collection","type":"topic","url":"\/documentation\/worldmodule","identifier":"doc:\/\/WorldModule\/documentation\/WorldModule"},"doc://Systems/documentation/Systems":{"title":"Systems","url":"\/documentation\/systems","identifier":"doc:\/\/Systems\/documentation\/Systems