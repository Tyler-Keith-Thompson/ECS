{"primaryContentSections":[{"content":[{"level":2,"type":"heading","text":"Overview","anchor":"Overview"},{"inlineContent":[{"type":"text","text":"ECS is an entity component system for Swift. It suits any program that updates many similar"},{"type":"text","text":" "},{"type":"text","text":"things each step, such as the bodies of a physics simulation or the characters of a game."}],"type":"paragraph"},{"items":[{"content":[{"inlineContent":[{"type":"text","text":"Entities are lightweight handles. An "},{"type":"reference","identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/Entity","isActive":true},{"type":"text","text":" holds no data of its own."}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"Components are plain value types, such as a position or a velocity, attached to entities.","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"A "},{"identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/World","type":"reference","isActive":true},{"type":"text","text":" holds the entities and their components, along with "},{"type":"emphasis","inlineContent":[{"type":"text","text":"resources"}]},{"type":"text","text":","},{"type":"text","text":" "},{"type":"text","text":"values the world holds once, such as a clock."}]}]},{"content":[{"inlineContent":[{"text":"Systems are rules that read and change the world through queries and updates, and a","type":"text"},{"text":" ","type":"text"},{"type":"reference","identifier":"doc:\/\/Systems\/documentation\/Systems\/Schedule","isActive":true},{"text":" runs them in the order you write, at the same time where they don’t","type":"text"},{"text":" ","type":"text"},{"text":"conflict.","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"A ","type":"text"},{"identifier":"doc:\/\/SimulationModule\/documentation\/SimulationModule\/Simulation","isActive":true,"type":"reference"},{"text":" runs a world frame by frame, with a fixed timestep and","type":"text"},{"text":" ","type":"text"},{"text":"states.","type":"text"}],"type":"paragraph"}]}],"type":"unorderedList"},{"inlineContent":[{"type":"text","text":"A world is a copy-on-write value, like an array: copies are cheap and independent, so you can"},{"type":"text","text":" "},{"type":"text","text":"keep one for a snapshot, an undo step or a rollback."}],"type":"paragraph"},{"inlineContent":[{"text":"The following example, using the ","type":"text"},{"type":"codeVoice","code":"Position"},{"text":" and ","type":"text"},{"type":"codeVoice","code":"Velocity"},{"text":" components from","type":"text"},{"text":" ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/ECS\/documentation\/ECS\/GettingStarted"},{"text":", spawns a ball and moves it one step by its velocity:","type":"text"}],"type":"paragraph"},{"type":"codeListing","syntax":"swift","code":["import ECS","","var world = World()","let ball = world.spawn(Position(x: 0, y: 0), Velocity(dx: 1, dy: 2))","world.update(Position.self, reading: Velocity.self) { position, row in","    position.x += row.components.dx","    position.y += row.components.dy","}","print(world[Position.self, of: ball])","\/\/ Prints \"Position(x: 1.0, y: 2.0)\""]},{"inlineContent":[{"type":"codeVoice","code":"import ECS"},{"type":"text","text":" imports every module. Each module also has its own documentation, and you can"},{"type":"text","text":" "},{"type":"text","text":"import one on its own."}],"type":"paragraph"}],"kind":"content"}],"kind":"symbol","abstract":[{"text":"Build games and simulations from entities, the components they hold, and systems that update","type":"text"},{"text":" ","type":"text"},{"text":"them in a declared order.","type":"text"}],"topicSections":[{"identifiers":["doc:\/\/ECS\/documentation\/ECS\/GettingStarted"],"title":"Essentials","anchor":"Essentials"},{"identifiers":["doc:\/\/WorldModule\/documentation\/WorldModule","doc:\/\/Systems\/documentation\/Systems","doc:\/\/SimulationModule\/documentation\/SimulationModule"],"title":"Modules","anchor":"Modules"}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/ecs"]}],"hierarchy":{"paths":[[]]},"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/ECS\/documentation\/ECS"},"schemaVersion":{"minor":3,"major":0,"patch":0},"metadata":{"roleHeading":"Framework","symbolKind":"module","role":"collection","title":"ECS","modules":[{"name":"ECS"}],"externalID":"ECS"},"sections":[],"references":{"doc://ECS/documentation/ECS":{"type":"topic","role":"collection","kind":"symbol","abstract":[{"type":"text","text":"Build games and simulations from entities, the components they hold, and systems that update"},{"type":"text","text":" "},{"type":"text","text":"them in a declared order."}],"title":"ECS","identifier":"doc:\/\/ECS\/documentation\/ECS","url":"\/documentation\/ecs"},"doc://WorldModule/documentation/WorldModule":{"type":"topic","abstract":[{"text":"Store the state of a game or simulation as entities and components, and read and change it with","type":"text"},{"text":" ","type":"text"},{"text":"queries, updates, and commands.","type":"text"}],"kind":"symbol","identifier":"doc:\/\/WorldModule\/documentation\/WorldModule","url":"\/documentation\/worldmodule","title":"WorldModule","role":"collection"},"doc://WorldModule/documentation/WorldModule/World":{"type":"topic","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"World","kind":"identifier"}],"role":"symbol","kind":"symbol","abstract":[{"type":"text","text":"A collection of entities, the components they hold, and resources."}],"title":"World","identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/World","navigatorTitle":[{"text":"World","kind":"identifier"}],"url":"\/documentation\/worldmodule\/world"},"doc://ECS/documentation/ECS/GettingStarted":{"type":"topic","abstract":[{"type":"text","text":"Define components, spawn entities, and move them with systems that run in a schedule and a"},{"type":"text","text":" "},{"type":"text","text":"simulation."}],"kind":"article","identifier":"doc:\/\/ECS\/documentation\/ECS\/GettingStarted","url":"\/documentation\/ecs\/gettingstarted","title":"Getting Started with ECS","role":"article"},"doc://WorldModule/documentation/WorldModule/Entity":{"type":"topic","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Entity","kind":"identifier"}],"role":"symbol","kind":"symbol","title":"Entity","abstract":[{"text":"A handle that identifies one entity in a world.","type":"text"}],"identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/Entity","navigatorTitle":[{"text":"Entity","kind":"identifier"}],"url":"\/documentation\/worldmodule\/entity"},"doc://Systems/documentation/Systems":{"type":"topic","abstract":[{"text":"Declare the rules of a simulation as systems, and run them on a world in a schedule.","type":"text"}],"kind":"symbol","identifier":"doc:\/\/Systems\/documentation\/Systems","url":"\/documentation\/systems","title":"Systems","role":"collection"},"doc://Systems/documentation/Systems/Schedule":{"type":"topic","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Schedule","kind":"identifier"}],"role":"symbol","kind":"symbol","title":"Schedule","abstract":[{"type":"text","text":"A list of systems that run on a world, in order, and at the same time where they can."}],"identifier":"doc:\/\/Systems\/documentation\/Systems\/Schedule","navigatorTitle":[{"text":"Schedule","kind":"identifier"}],"url":"\/documentation\/systems\/schedule"},"doc://SimulationModule/documentation/SimulationModule":{"type":"topic","role":"collection","kind":"symbol","title":"SimulationModule","abstract":[{"text":"Run a world frame by frame, with schedules for startup, a fixed timestep and each frame, and","type":"text"},{"text":" ","type":"text"},{"text":"with states that switch systems on and off.","type":"text"}],"identifier":"doc:\/\/SimulationModule\/documentation\/SimulationModule","url":"\/documentation\/simulationmodule"},"doc://SimulationModule/documentation/SimulationModule/Simulation":{"navigatorTitle":[{"text":"Simulation","kind":"identifier"}],"url":"\/documentation\/simulationmodule\/simulation","type":"topic","kind":"symbol","title":"Simulation","identifier":"doc:\/\/SimulationModule\/documentation\/SimulationModule\/Simulation","abstract":[{"text":"A world and its schedules by label, advanced one frame at a time.","type":"text"}],"role":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Simulation","kind":"identifier"}]}}}