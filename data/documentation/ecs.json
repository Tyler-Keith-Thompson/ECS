{"kind":"symbol","metadata":{"title":"ECS","externalID":"ECS","modules":[{"name":"ECS"}],"roleHeading":"Framework","role":"collection","symbolKind":"module"},"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/ecs"]}],"identifier":{"url":"doc:\/\/ECS\/documentation\/ECS","interfaceLanguage":"swift"},"hierarchy":{"paths":[[]]},"schemaVersion":{"major":0,"minor":3,"patch":0},"abstract":[{"type":"text","text":"Build games and simulations from entities, the components they hold, and systems that update"},{"type":"text","text":" "},{"type":"text","text":"them in a declared order."}],"topicSections":[{"identifiers":["doc:\/\/ECS\/documentation\/ECS\/GettingStarted"],"anchor":"Essentials","title":"Essentials"},{"identifiers":["doc:\/\/WorldModule\/documentation\/WorldModule","doc:\/\/Systems\/documentation\/Systems","doc:\/\/SimulationModule\/documentation\/SimulationModule"],"anchor":"Modules","title":"Modules"}],"sections":[],"primaryContentSections":[{"kind":"content","content":[{"level":2,"type":"heading","text":"Overview","anchor":"Overview"},{"inlineContent":[{"text":"ECS is an entity component system for Swift. It suits any program that updates many similar","type":"text"},{"text":" ","type":"text"},{"text":"things each step, such as the bodies of a physics simulation or the characters of a game.","type":"text"}],"type":"paragraph"},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Entities are lightweight handles. An "},{"type":"reference","isActive":true,"identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/Entity"},{"type":"text","text":" holds no data of its own."}]}]},{"content":[{"inlineContent":[{"type":"text","text":"Components are plain value types, such as a position or a velocity, attached to entities."}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"A "},{"identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/World","type":"reference","isActive":true},{"type":"text","text":" holds the entities and their components, along with "},{"inlineContent":[{"text":"resources","type":"text"}],"type":"emphasis"},{"type":"text","text":","},{"type":"text","text":" "},{"type":"text","text":"values the world holds once, such as a clock."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Systems are rules that read and change the world through queries and updates, and a"},{"type":"text","text":" "},{"isActive":true,"type":"reference","identifier":"doc:\/\/Systems\/documentation\/Systems\/Schedule"},{"type":"text","text":" runs them in the order you write, at the same time where they don’t"},{"type":"text","text":" "},{"type":"text","text":"conflict."}]}]},{"content":[{"inlineContent":[{"text":"A ","type":"text"},{"identifier":"doc:\/\/SimulationModule\/documentation\/SimulationModule\/Simulation","type":"reference","isActive":true},{"text":" runs a world frame by frame, with a fixed timestep and","type":"text"},{"text":" ","type":"text"},{"text":"states.","type":"text"}],"type":"paragraph"}]}],"type":"unorderedList"},{"inlineContent":[{"text":"A world is a copy-on-write value, like an array: copies are cheap and independent, so you can","type":"text"},{"text":" ","type":"text"},{"text":"keep one for a snapshot, an undo step or a rollback.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"The following example, using the ","type":"text"},{"code":"Position","type":"codeVoice"},{"text":" and ","type":"text"},{"code":"Velocity","type":"codeVoice"},{"text":" components from","type":"text"},{"text":" ","type":"text"},{"identifier":"doc:\/\/ECS\/documentation\/ECS\/GettingStarted","isActive":true,"type":"reference"},{"text":", spawns a ball and moves it one step by its velocity:","type":"text"}],"type":"paragraph"},{"type":"codeListing","code":["import ECS","","var world = World()","let ball = world.spawn(Position(x: 0, y: 0), Velocity(dx: 1, dy: 2))","world.update(Position.self, reading: Velocity.self) { position, row in","    position.x += row.components.dx","    position.y += row.components.dy","}","print(world[Position.self, of: ball])","\/\/ Prints \"Position(x: 1.0, y: 2.0)\""],"syntax":"swift"},{"inlineContent":[{"code":"import ECS","type":"codeVoice"},{"type":"text","text":" imports every module. Each module also has its own documentation, and you can"},{"type":"text","text":" "},{"type":"text","text":"import one on its own."}],"type":"paragraph"}]}],"references":{"doc://SimulationModule/documentation/SimulationModule/Simulation":{"title":"Simulation","url":"\/documentation\/simulationmodule\/simulation","role":"symbol","type":"topic","kind":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"Simulation"}],"abstract":[{"type":"text","text":"A world and its schedules by label, advanced one frame at a time."}],"navigatorTitle":[{"kind":"identifier","text":"Simulation"}],"identifier":"doc:\/\/SimulationModule\/documentation\/SimulationModule\/Simulation"},"doc://ECS/documentation/ECS":{"kind":"symbol","title":"ECS","identifier":"doc:\/\/ECS\/documentation\/ECS","url":"\/documentation\/ecs","role":"collection","abstract":[{"text":"Build games and simulations from entities, the components they hold, and systems that update","type":"text"},{"text":" ","type":"text"},{"text":"them in a declared order.","type":"text"}],"type":"topic"},"doc://SimulationModule/documentation/SimulationModule":{"title":"SimulationModule","url":"\/documentation\/simulationmodule","role":"collection","type":"topic","kind":"symbol","abstract":[{"text":"Run a world frame by frame, with schedules for startup, a fixed timestep and each frame, and","type":"text"},{"text":" ","type":"text"},{"text":"with states that switch systems on and off.","type":"text"}],"identifier":"doc:\/\/SimulationModule\/documentation\/SimulationModule"},"doc://ECS/documentation/ECS/GettingStarted":{"kind":"article","title":"Getting Started with ECS","url":"\/documentation\/ecs\/gettingstarted","identifier":"doc:\/\/ECS\/documentation\/ECS\/GettingStarted","role":"article","abstract":[{"text":"Define components, spawn entities, and move them with systems that run in a schedule and a","type":"text"},{"text":" ","type":"text"},{"text":"simulation.","type":"text"}],"type":"topic"},"doc://WorldModule/documentation/WorldModule/World":{"title":"World","url":"\/documentation\/worldmodule\/world","role":"symbol","type":"topic","kind":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"World","kind":"identifier"}],"abstract":[{"text":"A collection of entities, the components they hold, and resources.","type":"text"}],"navigatorTitle":[{"text":"World","kind":"identifier"}],"identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/World"},"doc://Systems/documentation/Systems/Schedule":{"kind":"symbol","navigatorTitle":[{"text":"Schedule","kind":"identifier"}],"title":"Schedule","url":"\/documentation\/systems\/schedule","identifier":"doc:\/\/Systems\/documentation\/Systems\/Schedule","role":"symbol","abstract":[{"text":"A list of systems that run on a world, in order, and at the same time where they can.","type":"text"}],"fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Schedule","kind":"identifier"}],"type":"topic"},"doc://Systems/documentation/Systems":{"title":"Systems","url":"\/documentation\/systems","role":"collection","type":"topic","kind":"symbol","abstract":[{"text":"Declare the rules of a simulation as systems, and run them on a world in a schedule.","type":"text"}],"identifier":"doc:\/\/Systems\/documentation\/Systems"},"doc://WorldModule/documentation/WorldModule":{"title":"WorldModule","url":"\/documentation\/worldmodule","role":"collection","type":"topic","kind":"symbol","abstract":[{"type":"text","text":"Store the state of a game or simulation as entities and components, and read and change it with"},{"type":"text","text":" "},{"type":"text","text":"queries, updates, and commands."}],"identifier":"doc:\/\/WorldModule\/documentation\/WorldModule"},"doc://WorldModule/documentation/WorldModule/Entity":{"url":"\/documentation\/worldmodule\/entity","navigatorTitle":[{"text":"Entity","kind":"identifier"}],"kind":"symbol","title":"Entity","abstract":[{"text":"A handle that identifies one entity in a world.","type":"text"}],"type":"topic","role":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Entity","kind":"identifier"}],"identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/Entity"}}}