xt","text":" "},{"identifier":"doc:\/\/SimulationModule\/documentation\/SimulationModule\/ScheduleLabel\/onExit(_:)","type":"reference","isActive":true},{"type":"text","text":" schedule of the state left, the"},{"type":"text","text":" "},{"identifier":"doc:\/\/SimulationModule\/documentation\/SimulationModule\/ScheduleLabel\/onTransition(from:to:)","type":"reference","isActive":true},{"type":"text","text":" schedule, and the "},{"identifier":"doc:\/\/SimulationModule\/documentation\/SimulationModule\/ScheduleLabel\/onEnter(_:)","type":"reference","isActive":true},{"type":"text","text":" "},{"type":"text","text":"schedule of the state entered. Setting the state the simulation is already in changes"},{"type":"text","text":" "},{"type":"text","text":"nothing."}],"type":"paragraph"},{"inlineContent":[{"text":"The following example pauses a game and records the schedules the change runs:","type":"text"}],"type":"paragraph"},{"code":["var world = World()","world.resources.insert(FixedSteps())","","var simulation = Simulation(world)","simulation.add(state: GameState.playing)","simulation.add(to: .onExit(GameState.playing)) { CountSteps() }","simulation.add(to: .onEnter(GameState.paused)) { CountSteps() }","simulation.update(elapsed: .zero)","","simulation.world.resources[NextState<GameState>.self].set(.paused)","simulation.update(elapsed: .zero)","print(simulation.world.resources[CurrentState<GameState>.self].state)","\/\/ Prints \"paused\"","print(simulation.world.resources[FixedSteps.self].count)","\/\/ Prints \"2\""],"type":"codeListing","syntax":"swift"},{"content":[{"inlineContent":[{"text":"The simulation doesn’t already have the state type ","type":"text"},{"type":"codeVoice","code":"S"},{"text":".","type":"text"}],"type":"paragraph"}],"style":"note","name":"Precondition","type":"aside"}]}],"abstract":[{"type":"text","text":"Adds a state type to the simulation, starting in the given state."}],"sections":[],"hierarchy":{"paths":[["doc:\/\/SimulationModule\/documentat