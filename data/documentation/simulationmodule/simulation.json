xt"},{"text":"Simulation","kind":"identifier"}]}],"kind":"declarations"},{"content":[{"type":"heading","level":2,"text":"Overview","anchor":"overview"},{"type":"paragraph","inlineContent":[{"text":"Use a simulation to drive a world from a game loop, a timer or a test. You add systems to","type":"text"},{"text":" ","type":"text"},{"text":"schedules named by ","type":"text"},{"identifier":"doc:\/\/SimulationModule\/documentation\/SimulationModule\/ScheduleLabel","isActive":true,"type":"reference"},{"text":", then call ","type":"text"},{"identifier":"doc:\/\/SimulationModule\/documentation\/SimulationModule\/Simulation\/update(elapsed:)","isActive":true,"type":"reference"},{"text":" once a frame with the time","type":"text"},{"text":" ","type":"text"},{"text":"that passed since the last one.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"The following example counts the runs of the fixed-timestep schedule. With a timestep of 10","type":"text"},{"text":" ","type":"text"},{"text":"milliseconds, a frame of 25 milliseconds runs it twice and carries the remaining 5","type":"text"},{"text":" ","type":"text"},{"text":"milliseconds over to the next frame:","type":"text"}]},{"syntax":"swift","type":"codeListing","code":["var world = World()","world.resources.insert(FixedSteps())","","var simulation = Simulation(world, fixedTimestep: .milliseconds(10))","simulation.add(to: .fixedUpdate) { CountSteps() }","","simulation.update(elapsed: .milliseconds(25))","print(simulation.world.resources[FixedSteps.self].count)","\/\/ Prints \"2\"","print(simulation.world.resources[FixedTime.self].overstep)","\/\/ Prints \"0.005 seconds\"","","simulation.update(elapsed: .milliseconds(25))","print(simulation.world.resources[FixedSteps.self].count)","\/\/ Prints \"5\""]},{"type":"heading","level":3,"text":"The Order of a Frame","anchor":"The-Order-of-a-Frame"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Each call to "},{"type":"reference","isActive":true,"identifie