{"schemaVersion":{"major":0,"patch":0,"minor":3},"sections":[],"metadata":{"title":"Simulation","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Simulation","kind":"identifier"}],"remoteSource":{"url":"https:\/\/github.com\/Tyler-Keith-Thompson\/ECS\/blob\/main\/Sources\/SimulationModule\/Simulation.swift#L59","fileName":"Simulation.swift"},"modules":[{"name":"SimulationModule"}],"navigatorTitle":[{"kind":"identifier","text":"Simulation"}],"roleHeading":"Structure","role":"symbol","externalID":"s:16SimulationModule0A0V","symbolKind":"struct"},"topicSections":[{"anchor":"Creating-a-Simulation","identifiers":["doc:\/\/SimulationModule\/documentation\/SimulationModule\/Simulation\/init(_:fixedTimestep:maximumDelta:)","doc:\/\/SimulationModule\/documentation\/SimulationModule\/Simulation\/init(_:checkedFixedTimestep:maximumDelta:)"],"title":"Creating a Simulation"},{"anchor":"Adding-Systems-and-States","identifiers":["doc:\/\/SimulationModule\/documentation\/SimulationModule\/Simulation\/add(to:_:)","doc:\/\/SimulationModule\/documentation\/SimulationModule\/Simulation\/add(state:)"],"title":"Adding Systems and States"},{"anchor":"Running-Frames","identifiers":["doc:\/\/SimulationModule\/documentation\/SimulationModule\/Simulation\/update(elapsed:)","doc:\/\/SimulationModule\/documentation\/SimulationModule\/Simulation\/run(_:)","doc:\/\/SimulationModule\/documentation\/SimulationModule\/Simulation\/maximumDelta"],"title":"Running Frames"},{"anchor":"Inspecting-a-Simulation","identifiers":["doc:\/\/SimulationModule\/documentation\/SimulationModule\/Simulation\/world","doc:\/\/SimulationModule\/documentation\/SimulationModule\/Simulation\/schedules"],"title":"Inspecting a Simulation"}],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/SimulationModule\/documentation\/SimulationModule\/Simulation"},"hierarchy":{"paths":[["doc:\/\/SimulationModule\/documentation\/SimulationModule"]]},"variants":[{"paths":["\/documentation\/simulationmodule\/simulation"],"traits":[{"interfaceLanguage":"swift"}]}],"seeAlsoSections":[{"anchor":"Simulations","identifiers":["doc:\/\/SimulationModule\/documentation\/SimulationModule\/ScheduleLabel","doc:\/\/SimulationModule\/documentation\/SimulationModule\/NonPositiveDuration"],"generated":true,"title":"Simulations"}],"primaryContentSections":[{"declarations":[{"tokens":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"Simulation"}],"platforms":["Linux"],"languages":["swift"]}],"kind":"declarations"},{"content":[{"level":2,"anchor":"overview","text":"Overview","type":"heading"},{"inlineContent":[{"type":"text","text":"Use a simulation to drive a world from a game loop, a timer or a test. You add systems to"},{"type":"text","text":" "},{"type":"text","text":"schedules named by "},{"type":"reference","identifier":"doc:\/\/SimulationModule\/documentation\/SimulationModule\/ScheduleLabel","isActive":true},{"type":"text","text":", then call "},{"type":"reference","identifier":"doc:\/\/SimulationModule\/documentation\/SimulationModule\/Simulation\/update(elapsed:)","isActive":true},{"type":"text","text":" once a frame with the time"},{"type":"text","text":" "},{"type":"text","text":"that passed since the last one."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"The following example counts the runs of the fixed-timestep schedule. With a timestep of 10"},{"type":"text","text":" "},{"type":"text","text":"milliseconds, a frame of 25 milliseconds runs it twice and carries the remaining 5"},{"type":"text","text":" "},{"type":"text","text":"milliseconds over to the next frame:"}],"type":"paragraph"},{"code":["var world = World()","world.resources.insert(FixedSteps())","","var simulation = Simulation(world, fixedTimestep: .milliseconds(10))","simulation.add(to: .fixedUpdate) { CountSteps() }","","simulation.update(elapsed: .milliseconds(25))","print(simulation.world.resources[FixedSteps.self].count)","\/\/ Prints \"2\"","print(simulation.world.resources[FixedTime.self].overstep)","\/\/ Prints \"0.005 seconds\"","","simulation.update(elapsed: .milliseconds(25))","print(simulation.world.resources[FixedSteps.self].count)","\/\/ Prints \"5\""],"syntax":"swift","type":"codeListing"},{"level":3,"anchor":"The-Order-of-a-Frame","text":"The Order of a Frame","type":"heading"},{"inlineContent":[{"type":"text","text":"Each call to "},{"type":"reference","isActive":true,"identifier":"doc:\/\/SimulationModule\/documentation\/SimulationModule\/Simulation\/update(elapsed:)"},{"type":"text","text":" is one frame, which runs in this order:"}],"type":"paragraph"},{"items":[{"content":[{"inlineContent":[{"type":"text","text":"On the first frame only, the "},{"identifier":"doc:\/\/SimulationModule\/documentation\/SimulationModule\/ScheduleLabel\/startup","isActive":true,"type":"reference"},{"type":"text","text":" schedule."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"The world’s events update, dropping events older than the previous frame.","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"The "},{"type":"reference","identifier":"doc:\/\/SimulationModule\/documentation\/SimulationModule\/Time","isActive":true},{"type":"text","text":" resource advances by the frame’s time, at most "},{"type":"reference","identifier":"doc:\/\/SimulationModule\/documentation\/SimulationModule\/Simulation\/maximumDelta","isActive":true},{"type":"text","text":"."}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Each state type’s pending change applies, in the order the types were added, running its"},{"type":"text","text":" "},{"identifier":"doc:\/\/SimulationModule\/documentation\/SimulationModule\/ScheduleLabel\/onExit(_:)","type":"reference","isActive":true},{"type":"text","text":", "},{"identifier":"doc:\/\/SimulationModule\/documentation\/SimulationModule\/ScheduleLabel\/onTransition(from:to:)","type":"reference","isActive":true},{"type":"text","text":" and"},{"type":"text","text":" "},{"identifier":"doc:\/\/SimulationModule\/documentation\/SimulationModule\/ScheduleLabel\/onEnter(_:)","type":"reference","isActive":true},{"type":"text","text":" schedules."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The "},{"type":"reference","isActive":true,"identifier":"doc:\/\/SimulationModule\/documentation\/SimulationModule\/ScheduleLabel\/fixedUpdate"},{"type":"text","text":" schedule, once for each whole fixed timestep of time not"},{"type":"text","text":" "},{"type":"text","text":"yet stood for, which "},{"type":"reference","isActive":true,"identifier":"doc:\/\/SimulationModule\/documentation\/SimulationModule\/FixedTime"},{"type":"text","text":" tracks."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The "},{"type":"reference","isActive":true,"identifier":"doc:\/\/SimulationModule\/documentation\/SimulationModule\/ScheduleLabel\/update"},{"type":"text","text":" schedule."}]}]}],"type":"orderedList"},{"inlineContent":[{"text":"A label with no systems added is skipped. Systems read the frame’s time through the","type":"text"},{"text":" ","type":"text"},{"isActive":true,"identifier":"doc:\/\/SimulationModule\/documentation\/SimulationModule\/Time","type":"reference"},{"text":" and ","type":"text"},{"isActive":true,"identifier":"doc:\/\/SimulationModule\/documentation\/SimulationModule\/FixedTime","type":"reference"},{"text":" resources, which the simulation’s world always holds.","type":"text"}],"type":"paragraph"}],"kind":"content"}],"relationshipsSections":[{"type":"conformsTo","identifiers":["doc:\/\/SimulationModule\/s8SendableP","doc:\/\/SimulationModule\/s16SendableMetatypeP"],"title":"Conforms To","kind":"relationships"}],"abstract":[{"type":"text","text":"A world and its schedules by label, advanced one frame at a time."}],"kind":"symbol","references":{"doc://SimulationModule/documentation/SimulationModule/Simulat