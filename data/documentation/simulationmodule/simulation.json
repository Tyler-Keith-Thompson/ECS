{"sections":[],"primaryContentSections":[{"declarations":[{"languages":["swift"],"tokens":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Simulation","kind":"identifier"}],"platforms":["Linux"]}],"kind":"declarations"},{"content":[{"level":2,"type":"heading","text":"Overview","anchor":"overview"},{"type":"paragraph","inlineContent":[{"text":"Use a simulation to drive a world from a game loop, a timer or a test. You add systems to","type":"text"},{"text":" ","type":"text"},{"text":"schedules named by ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/SimulationModule\/documentation\/SimulationModule\/ScheduleLabel"},{"text":", then call ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/SimulationModule\/documentation\/SimulationModule\/Simulation\/update(elapsed:)"},{"text":" once a frame with the time","type":"text"},{"text":" ","type":"text"},{"text":"that passed since the last one.","type":"text"}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"The following example counts the runs of the fixed-timestep schedule. With a timestep of 10"},{"type":"text","text":" "},{"type":"text","text":"milliseconds, a frame of 25 milliseconds runs it twice and carries the remaining 5"},{"type":"text","text":" "},{"type":"text","text":"milliseconds over to the next frame:"}]},{"type":"codeListing","syntax":"swift","code":["var world = World()","world.resources.insert(FixedSteps())","","var simulation = Simulation(world, fixedTimestep: .milliseconds(10))","simulation.add(to: .fixedUpdate) { CountSteps() }","","simulation.update(elapsed: .milliseconds(25))","print(simulation.world.resources[FixedSteps.self].count)","\/\/ Prints \"2\"","print(simulation.world.resources[FixedTime.self].overstep)","\/\/ Prints \"0.005 seconds\"","","simulation.update(elapsed: .milliseconds(25))","print(simulation.world.resources[FixedSteps.self].count)","\/\/ Prints \"5\""]},{"level":3,"type":"heading","text":"The Order of a Frame","anchor":"The-Order-of-a-Frame"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Each call to "},{"type":"reference","identifier":"doc:\/\/SimulationModule\/documentation\/SimulationModule\/Simulation\/update(elapsed:)","isActive":true},{"type":"text","text":" is one frame, which runs in this order:"}]},{"type":"orderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"On the first frame only, the "},{"type":"reference","identifier":"doc:\/\/SimulationModule\/documentation\/SimulationModule\/ScheduleLabel\/startup","isActive":true},{"type":"text","text":" schedule."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The world’s events update, dropping events older than the previous frame."}]}]},{"content":[{"inlineContent":[{"type":"text","text":"The "},{"isActive":true,"type":"reference","identifier":"doc:\/\/SimulationModule\/documentation\/SimulationModule\/Time"},{"type":"text","text":" resource advances by the frame’s time, at most "},{"isActive":true,"type":"reference","identifier":"doc:\/\/SimulationModule\/documentation\/SimulationModule\/Simulation\/maximumDelta"},{"type":"text","text":"."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"Each state type’s pending change applies, in the order the types were added, running its","type":"text"},{"text":" ","type":"text"},{"isActive":true,"identifier":"doc:\/\/SimulationModule\/documentation\/SimulationModule\/ScheduleLabel\/onExit(_:)","type":"reference"},{"text":", ","type":"text"},{"isActive":true,"identifier":"doc:\/\/SimulationModule\/documentation\/SimulationModule\/ScheduleLabel\/onTransition(from:to:)","type":"reference"},{"text":" and","type":"text"},{"text":" ","type":"text"},{"isActive":true,"identifier":"doc:\/\/SimulationModule\/documentation\/SimulationModule\/ScheduleLabel\/onEnter(_:)","type":"reference"},{"text":" schedules.","type":"text"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The "},{"type":"reference","isActive":true,"identifier":"doc:\/\/SimulationModule\/documentation\/SimulationModule\/ScheduleLabel\/fixedUpdate"},{"type":"text","text":" schedule, once for each whole fixed timestep of time not"},{"type":"text","text":" "},{"type":"text","text":"yet stood for, which "},{"type":"reference","isActive":true,"identifier":"doc:\/\/SimulationModule\/documentation\/SimulationModule\/FixedTime"},{"type":"text","text":" tracks."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The "},{"type":"reference","identifier":"doc:\/\/SimulationModule\/documentation\/SimulationModule\/ScheduleLabel\/update","isActive":true},{"type":"text","text":" schedule."}]}]}]},{"type":"paragraph","inlineContent":[{"text":"A label with no systems added is skipped. Systems read the frame’s time through the","type":"text"},{"text":" ","type":"text"},{"isActive":true,"identifier":"doc:\/\/SimulationModule\/documentation\/SimulationModule\/Time","type":"reference"},{"text":" and ","type":"text"},{"isActive":true,"identifier":"doc:\/\/SimulationModule\/documentation\/SimulationModule\/FixedTime","type":"reference"},{"text":" resources, which the simulation’s world always holds.","type":"text"}]}],"kind":"content"}],"seeAlsoSections":[{"title":"Simulations","generated":true,"identifiers":["doc:\/\/SimulationModule\/documentation\/SimulationModule\/ScheduleLabel","doc:\/\/SimulationModule\/documentation\/SimulationModule\/NonPositiveDuration"],"anchor":"Simulations"}],"metadata":{"symbolKind":"struct","externalID":"s:16SimulationModule0A0V","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Simulation","kind":"identifier"}],"remoteSource":{"url":"https:\/\/github.com\/Tyler-Keith-Thompson\/ECS\/blob\/main\/Sources\/SimulationModule\/Simulation.swift#L59","fileName":"Simulation.swift"},"roleHeading":"Structure","navigatorTitle":[{"kind":"identifier","text":"Simulation"}],"t