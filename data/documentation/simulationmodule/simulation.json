xt":" ","kind":"text"},{"text":"Simulation","kind":"identifier"}],"languages":["swift"]}]},{"kind":"content","content":[{"level":2,"text":"Overview","anchor":"overview","type":"heading"},{"inlineContent":[{"type":"text","text":"Use a simulation to drive a world from a game loop, a timer or a test. You add systems to"},{"type":"text","text":" "},{"type":"text","text":"schedules named by "},{"identifier":"doc:\/\/SimulationModule\/documentation\/SimulationModule\/ScheduleLabel","type":"reference","isActive":true},{"type":"text","text":", then call "},{"identifier":"doc:\/\/SimulationModule\/documentation\/SimulationModule\/Simulation\/update(elapsed:)","type":"reference","isActive":true},{"type":"text","text":" once a frame with the time"},{"type":"text","text":" "},{"type":"text","text":"that passed since the last one."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"The following example counts the runs of the fixed-timestep schedule. With a timestep of 10"},{"type":"text","text":" "},{"type":"text","text":"milliseconds, a frame of 25 milliseconds runs it twice and carries the remaining 5"},{"type":"text","text":" "},{"type":"text","text":"milliseconds over to the next frame:"}],"type":"paragraph"},{"code":["var world = World()","world.resources.insert(FixedSteps())","","var simulation = Simulation(world, fixedTimestep: .milliseconds(10))","simulation.add(to: .fixedUpdate) { CountSteps() }","","simulation.update(elapsed: .milliseconds(25))","print(simulation.world.resources[FixedSteps.self].count)","\/\/ Prints \"2\"","print(simulation.world.resources[FixedTime.self].overstep)","\/\/ Prints \"0.005 seconds\"","","simulation.update(elapsed: .milliseconds(25))","print(simulation.world.resources[FixedSteps.self].count)","\/\/ Prints \"5\""],"type":"codeListing","syntax":"swift"},{"level":3,"text":"The Order of a Frame","anchor":"The-Order-of-a-Frame","type":"heading"},{"inlineContent":[{"type":"text","text":"Each call to "},{"type":"reference","isActive":true,"identifier":"doc:\/\/SimulationModule\/documentation\/SimulationModule\/Simulation\/update(elapsed:)"},{"type":"text","text":" is one frame, which runs in this order:"}],"type":"paragraph"},{"type":"orderedList","items":[{"content":[{"inlineContent":[{"text":"On the first frame only, the ","type":"text"},{"isActive":true,"identifier":"doc:\/\/SimulationModule\/documentation\/SimulationModule\/ScheduleLabel\/startup","type":"reference"},{"text":" schedule.","type":"text"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The world’s events update, dropping events older than the previous frame."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"The ","type":"text"},{"identifier":"doc:\/\/SimulationModule\/documentation\/SimulationModule\/Time","isActive":true,"type":"reference"},{"text":" resource advances by the frame’s time, at most ","type":"text"},{"identifier":"doc:\/\/SimulationModule\/documentation\/SimulationModule\/Simulation\/maximumDelta","isActive":true,"type":"reference"},{"text":".","type":"text"}]}]},{"content":[{"inlineContent":[{"type":"text","text":"Each state type’s pending change applies, in the order the types were added, running its"},{"type":"text","text":" "},{"identifier":"doc:\/\/SimulationModule\/documentation\/SimulationModule\/ScheduleLabel\/onExit(_:)","type":"reference","isActive":true},{"type":"text","text":", "},{"identifier":"doc:\/\/SimulationModule\/documentation\/SimulationModule\/ScheduleLabel\/onTransition(from:to:)","type":"reference","isActive":true},{"type":"text","text":" and"},{"type":"text","text":" "},{"identifier":"doc:\/\/SimulationModule\/documentation\/SimulationModule\/ScheduleLabel\/onEnter(_:)","type":"reference","isActive":true},{"type":"text","text":" schedules."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"The "},{"isActive":true,"type":"reference","identifier":"doc:\/\/SimulationModule\/documentation\/SimulationModule\/ScheduleLabel\/fixedUpdate"},{"type":"text","text":" schedule, once for each whole fixed timestep of time not"},{"type":"text","text":" "},{"type":"text","text":"yet stood for, which "},{"isActive":true,"type":"reference","identifier":"doc:\/\/SimulationModule\/documentation\/SimulationModule\/FixedTime"},{"type":"text","text":" tracks."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"The "},{"identifier":"doc:\/\/SimulationModule\/documentation\/SimulationModule\/ScheduleLabel\/update","isActive":true,"type":"reference"},{"type":"text","text":" schedule."}],"type":"paragraph"}]}]},{"inlineContent":[{"type":"text","text":"A label with no systems added is skipped. Systems read the frame’s time through the"},{"type":"text","text":" "},{"type":"reference","identifier":"doc:\/\/SimulationModule\/documentation\/SimulationModule\/Time","isActive":true},{"type":"text","text":" and "},{"type":"reference","identifier":"doc:\/\/SimulationModule\/documentation\/SimulationModule\/FixedTime","isActive":true},{"type":"text","text":" resources, which the simulation’s world always holds."}],"type":"paragraph"}]}],"metadata":{"fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"Simulation"}],"symbolKind":"struct","remoteSource":{"fileName":"Simulation.swift","url":"https:\/\/github.com\/Tyler-Keith-Thompson\/ECS\/blob\/main\/Sources\/SimulationModule\/Simulation.swift#L59"},"role":"symbol","roleHeading":"Structure","externalID":"s:16SimulationModule0A0V","title":"Simulation","navigatorTitle":[{"text":"Simulation","kind":"identifier"}],"modules":[{"name":"SimulationModule"}]},"seeAlsoSections":[{"title":"Simulations","generated":true,"anchor":"Simulations","identifiers":["doc:\/\/SimulationModule\/documentation\/SimulationModule\/ScheduleLabel","doc:\/\/SimulationModule\/documentation\/SimulationModule\/NonPositiveDuration"]}],"references":{"doc://SimulationModule/documentation/SimulationModule/NonPosi