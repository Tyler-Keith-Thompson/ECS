rld, fixedTimestep: .milliseconds(10))","simulation.add(to: .fixedUpdate) { CountSteps() }","","simulation.update(elapsed: .milliseconds(25))","print(simulation.world.resources[FixedSteps.self].count)","\/\/ Prints \"2\"","print(simulation.world.resources[FixedTime.self].overstep)","\/\/ Prints \"0.005 seconds\"","","simulation.update(elapsed: .milliseconds(25))","print(simulation.world.resources[FixedSteps.self].count)","\/\/ Prints \"5\""],"syntax":"swift","type":"codeListing"},{"anchor":"The-Order-of-a-Frame","level":3,"text":"The Order of a Frame","type":"heading"},{"inlineContent":[{"type":"text","text":"Each call to "},{"type":"reference","identifier":"doc:\/\/SimulationModule\/documentation\/SimulationModule\/Simulation\/update(elapsed:)","isActive":true},{"type":"text","text":" is one frame, which runs in this order:"}],"type":"paragraph"},{"items":[{"content":[{"inlineContent":[{"text":"On the first frame only, the ","type":"text"},{"identifier":"doc:\/\/SimulationModule\/documentation\/SimulationModule\/ScheduleLabel\/startup","type":"reference","isActive":true},{"text":" schedule.","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"The world’s events update, dropping events older than the previous frame."}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The "},{"isActive":true,"type":"reference","identifier":"doc:\/\/SimulationModule\/documentation\/SimulationModule\/Time"},{"type":"text","text":" resource advances by the frame’s time, at most "},{"isActive":true,"type":"reference","identifier":"doc:\/\/SimulationModule\/documentation\/SimulationModule\/Simulation\/maximumDelta"},{"type":"text","text":"."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Each state type’s pending change applies, in the order the types were added, running its"},{"type":"text","text":" "},{"identifier":"doc:\/\/SimulationModule\/documentation\/SimulationModule\/