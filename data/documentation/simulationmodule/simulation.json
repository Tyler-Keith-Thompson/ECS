{"metadata":{"navigatorTitle":[{"text":"Simulation","kind":"identifier"}],"remoteSource":{"fileName":"Simulation.swift","url":"https:\/\/github.com\/Tyler-Keith-Thompson\/ECS\/blob\/main\/Sources\/SimulationModule\/Simulation.swift#L59"},"title":"Simulation","externalID":"s:16SimulationModule0A0V","roleHeading":"Structure","modules":[{"name":"SimulationModule"}],"fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Simulation","kind":"identifier"}],"symbolKind":"struct","role":"symbol"},"primaryContentSections":[{"kind":"declarations","declarations":[{"tokens":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"Simulation"}],"platforms":["Linux"],"languages":["swift"]}]},{"kind":"content","content":[{"text":"Overview","type":"heading","level":2,"anchor":"overview"},{"type":"paragraph","inlineContent":[{"text":"Use a simulation to drive a world from a game loop, a timer or a test. You add systems to","type":"text"},{"text":" ","type":"text"},{"text":"schedules named by ","type":"text"},{"identifier":"doc:\/\/SimulationModule\/documentation\/SimulationModule\/ScheduleLabel","type":"reference","isActive":true},{"text":", then call ","type":"text"},{"identifier":"doc:\/\/SimulationModule\/documentation\/SimulationModule\/Simulation\/update(elapsed:)","type":"reference","isActive":true},{"text":" once a frame with the time","type":"text"},{"text":" ","type":"text"},{"text":"that passed since the last one.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"The following example counts the runs of the fixed-timestep schedule. With a timestep of 10","type":"text"},{"text":" ","type":"text"},{"text":"milliseconds, a frame of 25 milliseconds runs it twice and carries the remaining 5","type":"text"},{"text":" ","type":"text"},{"text":"milliseconds over to the next frame:","type":"text"}]},{"type":"codeListing","syntax":"swift","code":["var world = World()","world.resources.insert(FixedSteps())",