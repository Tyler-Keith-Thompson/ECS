{"schemaVersion":{"major":0,"minor":3,"patch":0},"sections":[],"hierarchy":{"paths":[["doc:\/\/SimulationModule\/documentation\/SimulationModule"]]},"topicSections":[{"title":"Creating a Simulation","anchor":"Creating-a-Simulation","identifiers":["doc:\/\/SimulationModule\/documentation\/SimulationModule\/Simulation\/init(_:fixedTimestep:maximumDelta:)","doc:\/\/SimulationModule\/documentation\/SimulationModule\/Simulation\/init(_:checkedFixedTimestep:maximumDelta:)"]},{"title":"Adding Systems and States","anchor":"Adding-Systems-and-States","identifiers":["doc:\/\/SimulationModule\/documentation\/SimulationModule\/Simulation\/add(to:_:)","doc:\/\/SimulationModule\/documentation\/SimulationModule\/Simulation\/add(state:)"]},{"title":"Running Frames","anchor":"Running-Frames","identifiers":["doc:\/\/SimulationModule\/documentation\/SimulationModule\/Simulation\/update(elapsed:)","doc:\/\/SimulationModule\/documentation\/SimulationModule\/Simulation\/run(_:)","doc:\/\/SimulationModule\/documentation\/SimulationModule\/Simulation\/maximumDelta"]},{"title":"Inspecting a Simulation","anchor":"Inspecting-a-Simulation","identifiers":["doc:\/\/SimulationModule\/documentation\/SimulationModule\/Simulation\/world","doc:\/\/SimulationModule\/documentation\/SimulationModule\/Simulation\/schedules"]}],"primaryContentSections":[{"kind":"declarations","declarations":[{"platforms":["Linux"],"tokens":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Simulation","kind":"identifier"}],"languages":["swift"]}]},{"kind":"content","content":[{"text":"Overview","level":2,"anchor":"overview","type":"heading"},{"inlineContent":[{"type":"text","text":"Use a simulation to drive a world from a game loop, a timer or a test. You add systems to"},{"type":"text","text":" "},{"type":"text","text":"schedules named by "},{"isActive":true,"type":"reference","identifier":"doc:\/\/SimulationModule\/documentation\/SimulationModule\/ScheduleLabel"},{"type":"text","text":", then call "