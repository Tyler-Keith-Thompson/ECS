ries"},{"title":"Speeding Up Queries","identifiers":["doc:\/\/WorldModule\/documentation\/WorldModule\/GroupError"],"anchor":"Speeding-Up-Queries","abstract":[{"text":"Groups are made with ","type":"text"},{"type":"codeVoice","code":"group(_:)"},{"text":", cached queries with ","type":"text"},{"type":"codeVoice","code":"cache(_:)"},{"text":" and indexes by value with","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"index(_:)"},{"text":" on ","type":"text"},{"identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/World","type":"reference","isActive":true},{"text":"; ","type":"text"},{"type":"codeVoice","code":"lookup(_:)"},{"text":" finds the entities holding a value, and","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"lookup(_:equals:)"},{"text":" the entities whose property at a key path equals one.","type":"text"}]},{"title":"Deferring Changes","identifiers":["doc:\/\/WorldModule\/documentation\/WorldModule\/Commands"],"anchor":"Deferring-Changes"},{"title":"Working with Resources","identifiers":["doc:\/\/WorldModule\/documentation\/WorldModule\/Resources"],"anchor":"Working-with-Resources"},{"title":"Detecting Changes and Removals","identifiers":["doc:\/\/WorldModule\/documentation\/WorldModule\/ChangeTick","doc:\/\/WorldModule\/documentation\/WorldModule\/RemovedComponent"],"anchor":"Detecting-Changes-and-Removals"},{"title":"Disabling Entities and Using Prefabs","identifiers":["doc:\/\/WorldModule\/documentation\/WorldModule\/Disabled","doc:\/\/WorldModule\/documentation\/WorldModule\/Prefab"],"anchor":"Disabling-Entities-and-Using-Prefabs"},{"title":"Building Hierarchies","identifiers":["doc:\/\/WorldModule\/documentation\/WorldModule\/ChildOf","doc:\/\/WorldModule\/documentation\/WorldModule\/AncestorsView","doc:\/\/WorldModule\/documentation\/WorldModule\/DescendantsView","doc:\/\/WorldModule\/documentation\/WorldModule\/CyclicHierarchy","doc:\/\/WorldModule\/documentation\/WorldModule\/HierarchyError"],"anchor":"Building-Hierarchies"},{"title":"Relating Entities","identifiers":["doc:\/\/WorldModule\/documentation\/WorldModule\/Relation","doc:\/\/WorldModule\/documentation\/WorldModule\/Targets","doc:\/\/WorldModule\/documentation\/WorldModule\/CleanupAction"],"anchor":"Relating-Entities"},{"title":"Sending Events","identifiers":["doc:\/\/WorldModule\/documentation\/WorldModule\/Event","doc:\/\/WorldModule\/documentation\/WorldModule\/Events","doc:\/\/WorldModule\/documentation\/WorldModule\/EventsView"],"anchor":"Sending-Events"},{"title":"Reacting to Changes with Hooks and Observers","identifiers":["doc:\/\/WorldModule\/documentation\/WorldModule\/EntityEvent","doc:\/\/WorldModule\/documentation\/WorldModule\/Trigger"],"anchor":"Reacting-to-Changes-with-Hooks-and-Observers","abstract":[{"text":"Hooks are registered with ","type":"text"},{"code":"onAdd","type":"codeVoice"},{"text":", ","type":"text"},{"code":"onInsert","type":"codeVoice"},{"text":" and ","type":"text"},{"code":"onRemove","type":"codeVoice"},{"text":" on ","type":"text"},{"isActive":true,"identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/World","type":"reference"},{"text":", for a component type","type":"text"},{"text":" ","type":"text"},{"text":"or a query. Observers are registered with ","type":"text"},{"code":"observe","type":"codeVoice"},{"text":".","type":"text"}]},{"title":"Saving and Loading Worlds","identifiers":["doc:\/\/WorldModule\/documentation\/WorldModule\/SavingAndLoadingWorlds","doc:\/\/WorldModule\/documentation\/WorldModule\/WorldSnapshot","doc:\/\/WorldModule\/documentation\/WorldModule\/Scene","doc:\/\/WorldModule\/documentation\/WorldModule\/TypeRegistry","doc:\/\/WorldModule\/documentation\/WorldModule\/TypeRegistryError","doc:\/\/WorldModule\/documentation\/WorldModule\/TypeRegistryLookupError","doc:\/\/WorldModule\/documentation\/WorldModule\/MapEntities"],"anchor":"Saving-and-Loading-Worlds"},{"title":"Running Changes Concurrently","identifiers":["doc:\/\/WorldModule\/documentation\/WorldModule\/Access","doc:\/\/WorldModule\/documentation\/WorldModule\/ConcurrentChange"],"anchor":"Running-Changes-Concurrently"},{"title":"Errors","identifiers":["doc:\/\/WorldModule\/documentation\/WorldModule\/StaleEntity","doc:\/\/WorldModule\/documentation\/WorldModule\/MissingComponent","doc:\/\/WorldModule\/documentation\/WorldModule\/MissingResource"],"anchor":"Errors"},{"title":"Extended Modules","identifiers":["doc:\/\/WorldModule\/documentation\/WorldModule\/Swift"],"generated":true,"anchor":"Extended-Modules"}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/worldmodule"]}],"hierarchy":{"paths":[[]]},"sections":[],"abstract":[{"text":"Store the state of a game or simulation as entities and components, and read and change it with","type":"text"},{"text":" ","type":"text"},{"text":"queries, updates, and commands.","type":"text"}],"schemaVersion":{"major":0,"patch":0,"minor":3},"primaryContentSections":[{"content":[{"text":"Overview","type":"heading","anchor":"Overview","level":2},{"type":"paragraph","inlineContent":[{"text":"WorldModule is built around a ","type":"text"},{"type":"reference","isActive":true,"identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/World"},{"text":", a value that holds everything your game or simulation","type":"text"},{"text":" ","type":"text"},{"text":"knows. The world organizes that state with a few simple ideas:","type":"text"}]},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"text":"An ","type":"text"},{"inlineContent":[{"text":"entity","type":"text"}],"type":"strong"},{"text":" is one thing in the world, such as a ball, a player or a particle. It has no data","type":"text"},{"text":" ","type":"text"},{"text":"of its own; you refer to it by its handle, an ","type":"text"},{"identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/Entity","isActive":true,"type":"reference"},{"text":".","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"A "},{"type":"strong","inlineContent":[{"type":"text","text":"component"}]},{"type":"text","text":" is a plain value that an entity holds, such as a position or a health total."},{"type":"text","text":" "},{"type":"text","text":"Any type that conforms to "},{"isActive":true,"type":"reference","identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/Component"},{"type":"text","text":" can be a component, and an entity holds at most one"},{"type":"text","text":" "},{"type":"text","text":"component of each type."}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"A "},{"inlineContent":[{"type":"text","text":"resource"}],"type":"strong"},{"type":"text","text":" is a value the world holds once, outside any entity, such as a clock or a score."},{"type":"text","text":" "},{"type":"text","text":"Any type that conforms to "},{"identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/Resource","type":"reference","isActive":true},{"type":"text","text":" can be a resource."}]}]}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"The examples throughout this module’s documentation use these components:"}]},{"code":["struct Position: Component { var x: Double, y: Double }","struct Velocity: Component { var dx: Double, dy: Double }","struct Health: Component { var current: Int }","struct Frozen: Component {}","struct Name: Component, Hashable { var value: String }"],"type":"codeListing","syntax":"swift"},{"text":"Spawn Entities and Work with Their Components","type":"heading","anchor":"Spawn-Entities-and-Work-with-Their-Components","level":3},{"type":"paragraph","inlineContent":[{"text":"Spawn an entity with the components it starts with. The world returns the entity’s handle, which","type":"text"},{"text":" ","type":"text"},{"text":"you use to read and change its components:","type":"text"}]},{"code":["var world = World()","let hero = world.spawn(Name(value: \"Ada\"), Position(x: 0, y: 0), Health(current: 100))","","world[Health.self, of: hero].current -= 30","world.insert(Velocity(dx: 1, dy: 0), into: hero)","world.remove(Position.self, from: hero)","","print(world[Health.self, of: hero].current)","\/\/ Prints \"70\""],"type":"codeListing","syntax":"swift"},{"text":"Query and Update Many Entities","type":"heading","anchor":"Query-and-Update-Many-Entities","level":3},{"type":"paragraph","inlineContent":[{"type":"text","text":"Most of the work in a game applies to every entity that holds some set of components: every"},{"type":"text","text":" "},{"type":"text","text":"entity with a position and a velocity moves, every entity with health can take damage. A query"},{"type":"text","text":" "},{"type":"text","text":"visits those entities and reads their components, and an update changes one component of each in"},{"type":"text","text":" "},{"type":"text","text":"place:"}]},{"code":["var world = World()","world.spawn(Position(x: 0, y: 0), Velocity(dx: 1, dy: 0))","world.spawn(Position(x: 5, y: 5), Velocity(dx: 0, dy: -1), Frozen())","","world.update(Position.self, reading: Velocity.self, where: .without(Frozen.self)) { position, row in","    position.x += row.components.dx","    position.y += row.components.dy","}","","var coordinates: [(Double, Double)] = []","for (_, position) in world.query(Position.self) {","    coordinates.append((position.x, position.y))","}","print(coordinates)","\/\/ Prints \"[(1.0, 0.0), (5.0, 5.0)]\""],"type":"codeListing","syntax":"swift"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Filters such as "},{"type":"codeVoice","code":".without(Frozen.self)"},{"type":"text","text":" narrow which entities a query or update visits. To learn"},{"type":"text","text":" "},{"type":"text","text":"more, see "},{"type":"reference","isActive":true,"identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/QueryingAWorld"},{"type":"text","text":"."}]},{"text":"Defer Structural Changes with Commands","type":"heading","anchor":"Defer-Structural-Changes-with-Commands","level":3},{"type":"paragraph","inlineContent":[{"type":"text","text":"While a query or update is visiting entities, you can’t spawn or despawn entities or add and"},{"type":"text","text":" "},{"type":"text","text":"remove their components. Record those changes in "},{"type":"reference","identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/Commands","isActive":true},{"type":"text","text":" instead, and apply them when the"},{"type":"text","text":" "},{"type":"text","text":"visit is over:"}]},{"code":["var world = World()","world.spawn(Health(current: 0))","world.spawn(Health(current: 40))","","var commands = Commands()","for (entity, health) in world.query(Health.self) where health.current <= 0 {","    commands.despawn(entity)","}","world.apply(commands)","","print(world.count)","\/\/ Prints \"1\""],"type":"codeListing","syntax":"swift"},{"text":"Keep World-Wide State in Resources","type":"heading","anchor":"Keep-World-Wide-State-in-Resources","level":3},{"type":"paragraph","inlineContent":[{"type":"text","text":"A resource holds state that belongs to the whole world rather than to any entity:"}]},{"code":["struct Elapsed: Resource { var seconds: Double }","","var world = World()","world.resources.insert(Elapsed(seconds: 0))","world.resources[Elapsed.self].seconds += 0.5","","print(world.resources[Elapsed.self].seconds)","\/\/ Prints \"0.5\""],"type":"codeListing","syntax":"swift"},{"text":"Copy Worlds Freely","type":"heading","anchor":"Copy-Worlds-Freely","level":3},{"type":"paragraph","inlineContent":[{"text":"A world is a value: assigning it to another variable makes an independent copy. Copies share","type":"text"},{"text":" ","type":"text"},{"text":"storage until one of them changes, so copying is cheap, and keeping an earlier state for undo, a","type":"text"},{"text":" ","type":"text"},{"text":"replay or a comparison takes one assignment.","type":"text"}]}],"kind":"content"}],"references":{"doc://WorldModule/documentation/WorldModule/World/addChild(_:checkedTo:)":{"abstract":[{"type":"text","text":"Adds an entity to the end of another entity’s children, throwing if either entity is"},{"type":"text","text":" "},{"type":"text","text":"stale."}],"url":"\/documentation\/worldmodule\/world\/addchild(_:checkedto:)","identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/World\/addChild(_:checkedTo:)","role":"symbol","kind":"symbol","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"addChild","kind":"identifier"},{"text":"(","kind":"text"},{"text":"Entity","preciseIdentifier":"s:11WorldModule6EntityV","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"checkedTo","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"Entity","preciseIdentifier":"s:11WorldModule6EntityV","kind":"typeIdentifier"},{"text":") ","kind":"text"},{"text":"throws","kind":"keyword"},{"text":"(","kind":"text"},{"text":"HierarchyError","preciseIdentifier":"s:11WorldModule14HierarchyErrorO","kind":"typeIdentifier"},{"text":")","kind":"text"}],"title":"addChild(_:checkedTo:)","type":"topic"},"doc://WorldModule/documentation/WorldModule/Swift":{"type":"topic","abstract":[],"role":"collection","identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/Swift","url":"\/documentation\/worldmodule\/swift","kind":"symbol","title":"Swift"},"doc://WorldModule/documentation/WorldModule/ChildOf":{"type":"topic","abstract":[{"type":"text","text":"The relation that links a child entity to its parent."}],"role":"symbol","navigatorTitle":[{"text":"ChildOf","kind":"identifier"}],"identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/ChildOf","url":"\/documentation\/worldmodule\/childof","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"ChildOf","kind":"identifier"}],"kind":"symbol","title":"ChildOf"},"doc://WorldModule/documentation/WorldModule/EntityEvent":{"type":"topic","abstract":[{"type":"text","text":"A type that describes something that happens to a particular entity, which its observers"},{"type":"text","text":" "},{"type":"text","text":"respond to at once."}],"role":"symbol","navigatorTitle":[{"kind":"identifier","text":"EntityEvent"}],"identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/EntityEvent","url":"\/documentation\/worldmodule\/entityevent","fragments":[{"kind":"keyword","text":"protocol"},{"kind":"text","text":" "},{"kind":"identifier","text":"EntityEvent"}],"kind":"symbol","title":"EntityEvent"},"doc://WorldModule/documentation/WorldModule/Without":{"kind":"symbol","abstract":[{"text":"A filter type that passes the entities holding no component of type ","type":"text"},{"type":"codeVoice","code":"C"},{"text":".","type":"text"}],"identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/Without","url":"\/documentation\/worldmodule\/without","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"Without"}],"title":"Without","navigatorTitle":[{"kind":"identifier","text":"Without"}],"role":"symbol","type":"topic"},"doc://WorldModule/documentation/WorldModule/EntitiesView":{"url":"\/documentation\/worldmodule\/entitiesview","title":"EntitiesView","role":"symbol","type":"topic","kind":"symbol","abstract":[{"text":"A sequence of the live entities of a world, in slot order.","type":"text"}],"identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/EntitiesView","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"EntitiesView"}],"navigatorTitle":[{"kind":"identifier","text":"EntitiesView"}]},"doc://WorldModule/documentation/WorldModule/WorldSnapshot":{"url":"\/documentation\/worldmodule\/worldsnapshot","kind":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"WorldSnapshot","kind":"identifier"}],"type":"topic","identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/WorldSnapshot","title":"WorldSnapshot"