hey were"},{"type":"text","text":" "},{"type":"text","text":"recorded."}],"identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/Commands"},"doc://WorldModule/documentation/WorldModule/Event":{"kind":"symbol","type":"topic","title":"Event","fragments":[{"kind":"keyword","text":"protocol"},{"kind":"text","text":" "},{"kind":"identifier","text":"Event"}],"url":"\/documentation\/worldmodule\/event","abstract":[{"text":"A type that describes a message one part of a program sends and other parts read later.","type":"text"}],"role":"symbol","navigatorTitle":[{"kind":"identifier","text":"Event"}],"identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/Event"},"doc://WorldModule/documentation/WorldModule/FilterTerm":{"type":"topic","role":"symbol","abstract":[{"text":"A type that stands for a query filter, so a system’s parameter can name the filter in its type.","type":"text"}],"identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/FilterTerm","title":"FilterTerm","fragments":[{"text":"protocol","kind":"keyword"},{"text":" ","kind":"text"},{"text":"FilterTerm","kind":"identifier"}],"url":"\/documentation\/worldmodule\/filterterm","navigatorTitle":[{"text":"FilterTerm","kind":"identifier"}],"kind":"symbol"},"doc://WorldModule/documentation/WorldModule/Targets":{"abstract":[{"type":"text","text":"The component that holds a source entity’s targets of a relation, with the relation’s value"},{"type":"text","text":" "},{"type":"text","text":"for each."}],"type":"topic","kind":"symbol","role":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Targets","kind":"identifier"}],"title":"Targets","navigatorTitle":[{"text":"Targets","kind":"identifier"}],"identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/Targets","url":"\/documentation\/worldmodule\/targets"},"doc://WorldModule/documentation/WorldModule/Bundle":{"kind":"symbol","type":"topic","title":"Bundle","fragments":[{"text":"protocol","kind":"keyword"},{"