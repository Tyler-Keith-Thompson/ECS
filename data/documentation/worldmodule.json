{"abstract":[{"type":"text","text":"Store the state of a game or simulation as entities and components, and read and change it with"},{"text":" ","type":"text"},{"text":"queries, updates, and commands.","type":"text"}],"topicSections":[{"title":"Essentials","anchor":"Essentials","identifiers":["doc:\/\/WorldModule\/documentation\/WorldModule\/World","doc:\/\/WorldModule\/documentation\/WorldModule\/Entity","doc:\/\/WorldModule\/documentation\/WorldModule\/Component","doc:\/\/WorldModule\/documentation\/WorldModule\/Resource"]},{"title":"Grouping Components","anchor":"Grouping-Components","identifiers":["doc:\/\/WorldModule\/documentation\/WorldModule\/Bundle","doc:\/\/WorldModule\/documentation\/WorldModule\/BundleBuilder","doc:\/\/WorldModule\/documentation\/WorldModule\/TupleBundle","doc:\/\/WorldModule\/documentation\/WorldModule\/EitherBundle"]},{"title":"Querying and Updating Entities","anchor":"Querying-and-Updating-Entities","identifiers":["doc:\/\/WorldModule\/documentation\/WorldModule\/QueryingAWorld","doc:\/\/WorldModule\/documentation\/WorldModule\/Query","doc:\/\/WorldModule\/documentation\/WorldModule\/QueryView","doc:\/\/WorldModule\/documentation\/WorldModule\/EntityQueryView","doc:\/\/WorldModule\/documentation\/WorldModule\/QueryRow","doc:\/\/WorldModule\/documentation\/WorldModule\/QueryTerm","doc:\/\/WorldModule\/documentation\/WorldModule\/AnyOf","doc:\/\/WorldModule\/documentation\/WorldModule\/EntitiesView"]},{"title":"Filtering Queries","anchor":"Filtering-Queries","identifiers":["doc:\/\/WorldModule\/documentation\/WorldModule\/QueryFilter","doc:\/\/WorldModule\/documentation\/WorldModule\/FilterTerm","doc:\/\/WorldModule\/documentation\/WorldModule\/With","doc:\/\/WorldModule\/documentation\/WorldModule\/Without","doc:\/\/WorldModule\/documentation\/WorldModule\/Added","doc:\/\/WorldModule\/documentation\/WorldModule\/Changed","doc:\/\/WorldModule\/documentation\/WorldModule\/Allows"]},{"abstract":[{"type":"text","text":"Groups are made with "},{"code":"group(_:)","type":"codeVoice"},{"text":", cached queries with ","type":"text"},{"code":"cache(_:)","type":"codeVoice"},{"text":" and indexes by value with","type":"text"},{"text":" ","type":"text"},{"code":"index(_:)","type":"codeVoice"},{"text":" on ","type":"text"},{"isActive":true,"identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/World","type":"reference"},{"text":"; ","type":"text"},{"code":"lookup(_:)","type":"codeVoice"},{"text":" finds the entities holding a value.","type":"text"}],"title":"Speeding Up Queries","anchor":"Speeding-Up-Queries","identifiers":["doc:\/\/WorldModule\/documentation\/WorldModule\/GroupError"]},{"title":"Deferring Changes","anchor":"Deferring-Changes","identifiers":["doc:\/\/WorldModule\/documentation\/WorldModule\/Commands"]},{"title":"Working with Resources","anchor":"Working-with-Resources","identifiers":["doc:\/\/WorldModule\/documentation\/WorldModule\/Resources"]},{"title":"Detecting Changes and Removals","anchor":"Detecting-Changes-and-Removals","identifiers":["doc:\/\/WorldModule\/documentation\/WorldModule\/ChangeTick","doc:\/\/WorldModule\/documentation\/WorldModule\/RemovedComponent"]},{"title":"Disabling Entities and Using Prefabs","anchor":"Disabling-Entities-and-Using-Prefabs","identifiers":["doc:\/\/WorldModule\/documentation\/WorldModule\/Disabled","doc:\/\/WorldModule\/documentation\/WorldModule\/Prefab"]},{"title":"Building Hierarchies","anchor":"Building-Hierarchies","identifiers":["doc:\/\/WorldModule\/documentation\/WorldModule\/ChildOf","doc:\/\/WorldModule\/documentation\/WorldModule\/AncestorsView","doc:\/\/WorldModule\/documentation\/WorldModule\/DescendantsView","doc:\/\/WorldModule\/documentation\/WorldModule\/CyclicHierarchy","doc:\/\/WorldModule\/documentation\/WorldModule\/HierarchyError"]},{"title":"Relating Entities","anchor":"Relating-Entities","identifiers":["doc:\/\/WorldModule\/documentation\/WorldModule\/Relation","doc:\/\/WorldModule\/documentation\/WorldModule\/Targets","doc:\/\/WorldModule\/documentation\/WorldModule\/CleanupAction"]},{"title":"Sending Events","anchor":"Sending-Events","identifiers":["doc:\/\/WorldModule\/documentation\/WorldModule\/Event","doc:\/\/WorldModule\/documentation\/WorldModule\/Events","doc:\/\/WorldModule\/documentation\/WorldModule\/EventsView"]},{"abstract":[{"text":"Hooks are registered with ","type":"text"},{"code":"onAdd","type":"codeVoice"},{"text":", ","type":"text"},{"code":"onInsert","type":"codeVoice"},{"text":" and ","type":"text"},{"code":"onRemove","type":"codeVoice"},{"text":" on ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/World"},{"text":", for a component type","type":"text"},{"text":" ","type":"text"},{"text":"or a query. Observers are registered with ","type":"text"},{"code":"observe","type":"codeVoice"},{"text":".","type":"text"}],"title":"Reacting to Changes with Hooks and Observers","anchor":"Reacting-to-Changes-with-Hooks-and-Observers","identifiers":["doc:\/\/WorldModule\/documentation\/WorldModule\/EntityEvent","doc:\/\/WorldModule\/documentation\/WorldModule\/Trigger"]},{"title":"Saving and Loading Worlds","anchor":"Saving-and-Loading-Worlds","identifiers":["doc:\/\/WorldModule\/documentation\/WorldModule\/SavingAndLoadingWorlds","doc:\/\/WorldModule\/documentation\/WorldModule\/WorldSnapshot","doc:\/\/WorldModule\/documentation\/WorldModule\/Scene","doc:\/\/WorldModule\/documentation\/WorldModule\/TypeRegistry","doc:\/\/WorldModule\/documentation\/WorldModule\/TypeRegistryError","doc:\/\/WorldModule\/documentation\/WorldModule\/MapEntities"]},{"title":"Running Changes Concurrently","anchor":"Running-Changes-Concurrently","identifiers":["doc:\/\/WorldModule\/documentation\/WorldModule\/Access","doc:\/\/WorldModule\/documentation\/WorldModule\/ConcurrentChange"]},{"title":"Errors","anchor":"Errors","identifiers":["doc:\/\/WorldModule\/documentation\/WorldModule\/StaleEntity","doc:\/\/WorldModule\/documentation\/WorldModule\/MissingComponent","doc:\/\/WorldModule\/documentation\/WorldModule\/MissingResource"]},{"generated":true,"title":"Extended Modules","anchor":"Extended-Modules","identifiers":["doc:\/\/WorldModule\/documentation\/WorldModule\/Swift"]}],"sections":[],"primaryContentSections":[{"kind":"content","content":[{"type":"heading","text":"Overview","level":2,"anchor":"Overview"},{"type":"paragraph","inlineContent":[{"type":"text","text":"WorldModule is built around a "},{"type":"reference","identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/World","isActive":true},{"type":"text","text":", a value that holds everything your game or simulation"},{"type":"text","text":" "},{"type":"text","text":"knows. The world organizes that state with a few simple ideas:"}]},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"An "},{"inlineContent":[{"text":"entity","type":"text"}],"type":"strong"},{"type":"text","text":" is one thing in the world, such as a ball, a player or a particle. It has no data"},{"type":"text","text":" "},{"type":"text","text":"of its own; you refer to it by its handle, an "},{"type":"reference","identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/Entity","isActive":true},{"type":"text","text":"."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"A ","type":"text"},{"type":"strong","inlineContent":[{"text":"component","type":"text"}]},{"text":" is a plain value that an entity holds, such as a position or a health total.","type":"text"},{"text":" ","type":"text"},{"text":"Any type that conforms to ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/Component"},{"text":" can be a component, and an entity holds at most one","type":"text"},{"text":" ","type":"text"},{"text":"component of each type.","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"A "},{"inlineContent":[{"type":"text","text":"resource"}],"type":"strong"},{"type":"text","text":" is a value the world holds once, outside any entity, such as a clock or a score."},{"type":"text","text":" "},{"type":"text","text":"Any type that conforms to "},{"type":"reference","isActive":true,"identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/Resource"},{"type":"text","text":" can be a resource."}]}]}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"The examples throughout this module’s documentation use these components:"}]},{"type":"codeListing","syntax":"swift","code":["struct Position: Component { var x: Double, y: Double }","struct Velocity: Component { var dx: Double, dy: Double }","struct Health: Component { var current: Int }","struct Frozen: Component {}","struct Name: Component, Hashable { var value: String }"]},{"type":"heading","text":"Spawn Entities and Work with Their Components","level":3,"anchor":"Spawn-Entities-and-Work-with-Their-Components"},{"type":"paragraph","inlineContent":[{"text":"Spawn an entity with the components it starts with. The world returns the entity’s handle, which","type":"text"},{"text":" ","type":"text"},{"text":"you use to read and change its components:","type":"text"}]},{"type":"codeListing","syntax":"swift","code":["var world = World()","let hero = world.spawn(Name(value: \"Ada\"), Position(x: 0, y: 0), Health(current: 100))","","world[Health.self, of: hero].current -= 30","world.insert(Velocity(dx: 1, dy: 0), into: hero)","world.remove(Position.self, from: hero)","","print(world[Health.self, of: hero].current)","\/\/ Prints \"70\""]},{"type":"heading","text":"Query and Update Many Entities","level":3,"anchor":"Query-and-Update-Many-Entities"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Most of the work in a game applies to every entity that holds some set of components: every"},{"type":"text","text":" "},{"type":"text","text":"entity with a position and a velocity moves, every entity with health can take damage. A query"},{"type":"text","text":" "},{"type":"text","text":"visits those entities and reads their components, and an update changes one component of each in"},{"type":"text","text":" "},{"type":"text","text":"place:"}]},{"type":"codeListing","syntax":"swift","code":["var world = World()","world.spawn(Position(x: 0, y: 0), Velocity(dx: 1, dy: 0))","world.spawn(Position(x: 5, y: 5), Velocity(dx: 0, dy: -1), Frozen())","","world.update(Position.self, reading: Velocity.self, where: .without(Frozen.self)) { position, row in","    position.x += row.components.dx","    position.y += row.components.dy","}","","var coordinates: [(Double, Double)] = []","for (_, position) in world.query(Position.self) {","    coordinates.append((position.x, position.y))","}","print(coordinates)","\/\/ Prints \"[(1.0, 0.0), (5.0, 5.0)]\""]},{"type":"paragraph","inlineContent":[{"text":"Filters such as ","type":"text"},{"type":"codeVoice","code":".without(Frozen.self)"},{"text":" narrow which entities a query or update visits. To learn","type":"text"},{"text":" ","type":"text"},{"text":"more, see ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/QueryingAWorld"},{"text":".","type":"text"}]},{"type":"heading","text":"Defer Structural Changes with Commands","level":3,"anchor":"Defer-Structural-Changes-with-Commands"},{"type":"paragraph","inlineContent":[{"text":"While a query or update is visiting entities, you can’t spawn or despawn entities or add and","type":"text"},{"text":" ","type":"text"},{"text":"remove their components. Record those changes in ","type":"text"},{"type":"reference","identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/Commands","isActive":true},{"text":" instead, and apply them when the","type":"text"},{"text":" ","type":"text"},{"text":"visit is over:","type":"text"}]},{"type":"codeListing","syntax":"swift","code":["var world = World()","world.spawn(Health(current: 0))","world.spawn(Health(current: 40))","","var commands = Commands()","for (entity, health) in world.query(Health.self) where health.current <= 0 {","    commands.despawn(entity)","}","world.apply(commands)","","print(world.count)","\/\/ Prints \"1\""]},{"type":"heading","text":"Keep World-Wide State in Resources","level":3,"anchor":"Keep-World-Wide-State-in-Resources"},{"type":"paragraph","inlineContent":[{"text":"A resource holds state that belongs to the whole world rather than to any entity:","type":"text"}]},{"type":"codeListing","syntax":"swift","code":["struct Elapsed: Resource { var seconds: Double }","","var world = World()","world.resources.insert(Elapsed(seconds: 0))","world.resources[Elapsed.self].seconds += 0.5","","print(world.resources[Elapsed.self].seconds)","\/\/ Prints \"0.5\""]},{"type":"heading","text":"Copy Worlds Freely","level":3,"anchor":"Copy-Worlds-Freely"},{"type":"paragraph","inlineContent":[{"type":"text","text":"A world is a value: assigning it to another variable makes an independent copy. Copies share"},{"type":"text","text":" "},{"type":"text","text":"storage until one of them changes, so copying is cheap, and keeping an earlier state for undo, a"},{"type":"text","text":" "},{"type":"text","text":"replay or a comparison takes one assignment."}]}]}],"kind":"symbol","hierarchy":{"paths":[[]]},"identifier":{"url":"doc:\/\/WorldModule\/documentation\/WorldModule","interfaceLanguage":"swift"},"schemaVersion":{"major":0,"minor":3,"patch":0},"variants":[{"paths":["\/documentation\/worldmodule"],"traits":[{"interfaceLanguage":"swift"}]}],"metadata":{"modules":[{"name":"WorldModule"}],"title":"WorldModule","symbolKind":"module","roleHeading":"Framework","role":"collection","externalID":"WorldModule"},"references":{"doc://WorldModule/documentation/WorldModule/Added":{"abstract":[{"text":"A filter type that passes the entities whose component of type ","type":"text"},{"code":"C","type":"codeVoice"},{"text":" was added since the","type":"text"},{"text":" ","ty