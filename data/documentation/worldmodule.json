{"abstract":[{"type":"text","text":"Store the state of a game or simulation as entities and components, and read and change it with"},{"type":"text","text":" "},{"type":"text","text":"queries, updates, and commands."}],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/WorldModule\/documentation\/WorldModule"},"hierarchy":{"paths":[[]]},"topicSections":[{"title":"Essentials","identifiers":["doc:\/\/WorldModule\/documentation\/WorldModule\/World","doc:\/\/WorldModule\/documentation\/WorldModule\/Entity","doc:\/\/WorldModule\/documentation\/WorldModule\/Component","doc:\/\/WorldModule\/documentation\/WorldModule\/Resource"],"anchor":"Essentials"},{"title":"Grouping Components","identifiers":["doc:\/\/WorldModule\/documentation\/WorldModule\/Bundle","doc:\/\/WorldModule\/documentation\/WorldModule\/BundleBuilder","doc:\/\/WorldModule\/documentation\/WorldModule\/TupleBundle","doc:\/\/WorldModule\/documentation\/WorldModule\/EitherBundle"],"anchor":"Grouping-Components"},{"title":"Querying and Updating Entities","identifiers":["doc:\/\/WorldModule\/documentation\/WorldModule\/QueryingAWorld","doc:\/\/WorldModule\/documentation\/WorldModule\/Query","doc:\/\/WorldModule\/documentation\/WorldModule\/QueryView","doc:\/\/WorldModule\/documentation\/WorldModule\/EntityQueryView","doc:\/\/WorldModule\/documentation\/WorldModule\/QueryRow","doc:\/\/WorldModule\/documentation\/WorldModule\/QueryTerm","doc:\/\/WorldModule\/documentation\/WorldModule\/AnyOf","doc:\/\/WorldModule\/documentation\/WorldModule\/EntitiesView"],"anchor":"Querying-and-Updating-Entities"},{"title":"Filtering Queries","identifiers":["doc:\/\/WorldModule\/documentation\/WorldModule\/QueryFilter","doc:\/\/WorldModule\/documentation\/WorldModule\/FilterTerm","doc:\/\/WorldModule\/documentation\/WorldModule\/With","doc:\/\/WorldModule\/documentation\/WorldModule\/Without","doc:\/\/WorldModule\/documentation\/WorldModule\/Added","doc:\/\/WorldModule\/documentation\/WorldModule\/Changed","doc:\/\/WorldModule\/documentation\/WorldModule\/Allows"],"anchor":"Filtering-Queries"},{"title":"Speeding Up Queries","abstract":[{"type":"text","text":"Groups are made with "},{"type":"codeVoice","code":"group(_:)"},{"type":"text","text":", cached queries with "},{"type":"codeVoice","code":"cache(_:)"},{"type":"text","text":" and indexes by value with"},{"type":"text","text":" "},{"type":"codeVoice","code":"index(_:)"},{"type":"text","text":" on "},{"identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/World","type":"reference","isActive":true},{"type":"text","text":"; "},{"type":"codeVoice","code":"lookup(_:)"},{"type":"text","text":" finds the entities holding a value, and"},{"type":"text","text":" "},{"type":"codeVoice","code":"lookup(_:equals:)"},{"type":"text","text":" the entities whose property at a key path equals one."}],"identifiers":["doc:\/\/WorldModule\/documentation\/WorldModule\/GroupError"],"anchor":"Speeding-Up-Queries"},{"title":"Deferring Changes","identifiers":["doc:\/\/WorldModule\/documentation\/WorldModule\/Commands"],"anchor":"Deferring-Changes"},{"title":"Working with Resources","identifiers":["doc:\/\/WorldModule\/documentation\/WorldModule\/Resources"],"anchor":"Working-with-Resources"},{"title":"Detecting Changes and Removals","identifiers":["doc:\/\/WorldModule\/documentation\/WorldModule\/ChangeTick","doc:\/\/WorldModule\/documentation\/WorldModule\/RemovedComponent"],"anchor":"Detecting-Changes-and-Removals"},{"title":"Disabling Entities and Using Prefabs","identifiers":["doc:\/\/WorldModule\/documentation\/WorldModule\/Disabled","doc:\/\/WorldModule\/documentation\/WorldModule\/Prefab"],"anchor":"Disabling-Entities-and-Using-Prefabs"},{"title":"Building Hierarchies","identifiers":["doc:\/\/WorldModule\/documentation\/WorldModule\/ChildOf","doc:\/\/WorldModule\/documentation\/WorldModule\/AncestorsView","doc:\/\/WorldModule\/documentation\/WorldModule\/DescendantsView","doc:\/\/WorldModule\/documentation\/WorldModule\/CyclicHierarchy","doc:\/\/WorldModule\/documentation\/WorldModule\/HierarchyError"],"anchor":"Building-Hierarchies"},{"title":"Relating Entities","identifiers":["doc:\/\/WorldModule\/documentation\/WorldModule\/Relation","doc:\/\/WorldModule\/documentation\/WorldModule\/Targets","doc:\/\/WorldModule\/documentation\/WorldModule\/CleanupAction"],"anchor":"Relating-Entities"},{"title":"Sending Events","identifiers":["doc:\/\/WorldModule\/documentation\/WorldModule\/Event","doc:\/\/WorldModule\/documentation\/WorldModule\/Events","doc:\/\/WorldModule\/documentation\/WorldModule\/EventsView"],"anchor":"Sending-Events"},{"title":"Reacting to Changes with Hooks and Observers","abstract":[{"type":"text","text":"Hooks are registered with "},{"type":"codeVoice","code":"onAdd"},{"type":"text","text":", "},{"type":"codeVoice","code":"onInsert"},{"type":"text","text":" and "},{"type":"codeVoice","code":"onRemove"},{"type":"text","text":" on "},{"identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/World","type":"reference","isActive":true},{"type":"text","text":", for a component type"},{"type":"text","text":" "},{"type":"text","text":"or a query. Observers are registered with "},{"type":"codeVoice","code":"observe"},{"type":"text","text":"."}],"identifiers":["doc:\/\/WorldModule\/documentation\/WorldModule\/EntityEvent","doc:\/\/WorldModule\/documentation\/WorldModule\/Trigger"],"anchor":"Reacting-to-Changes-with-Hooks-and-Observers"},{"title":"Saving and Loading Worlds","identifiers":["doc:\/\/WorldModule\/documentation\/WorldModule\/SavingAndLoadingWorlds","doc:\/\/WorldModule\/documentation\/WorldModule\/WorldSnapshot","doc:\/\/WorldModule\/documentation\/WorldModule\/Scene","doc:\/\/WorldModule\/documentation\/WorldModule\/TypeRegistry","doc:\/\/WorldModule\/documentation\/WorldModule\/TypeRegistryError","doc:\/\/WorldModule\/documentation\/WorldModule\/TypeRegistryLookupError","doc:\/\/WorldModule\/documentation\/WorldModule\/MapEntities"],"anchor":"Saving-and-Loading-Worlds"},{"title":"Running Changes Concurrently","identifiers":["doc:\/\/WorldModule\/documentation\/WorldModule\/Access","doc:\/\/WorldModule\/documentation\/WorldModule\/ConcurrentChange"],"anchor":"Running-Changes-Concurrently"},{"title":"Errors","identifiers":["doc:\/\/WorldModule\/documentation\/WorldModule\/StaleEntity","doc:\/\/WorldModule\/documentation\/WorldModule\/MissingComponent","doc:\/\/WorldModule\/documentation\/WorldModule\/MissingResource"],"anchor":"Errors"},{"title":"Extended Modules","generated":true,"identifiers":["doc:\/\/WorldModule\/documentation\/WorldModule\/Swift"],"anchor":"Extended-Modules"}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/worldmodule"]}],"metadata":{"roleHeading":"Framework","title":"WorldModule","symbolKind":"module","modules":[{"name":"WorldModule"}],"role":"collection","externalID":"WorldModule"},"primaryContentSections":[{"content":[{"type":"heading","anchor":"Overview","text":"Overview","level":2},{"type":"paragraph","inlineContent":[{"type":"text","text":"WorldModule is built around a "},{"type":"reference","isActive":true,"identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/World"},{"type":"text","text":", a value that holds everything your game or simulation"},{"type":"text","text":" "},{"type":"text","text":"knows. The world organizes that state with a few simple ideas:"}]},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"text":"An ","type":"text"},{"inlineContent":[{"type":"text","text":"entity"}],"type":"strong"},{"text":" is one thing in the world, such as a ball, a player or a particle. It has no data","type":"text"},{"text":" ","type":"text"},{"text":"of its own; you refer to it by its handle, an ","type":"text"},{"isActive":true,"identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/Entity","type":"reference"},{"text":".","type":"text"}]}]},{"content":[{"inlineContent":[{"text":"A ","type":"text"},{"type":"strong","inlineContent":[{"type":"text","text":"component"}]},{"text":" is a plain value that an entity holds, such as a position or a health total.","type":"text"},{"text":" ","type":"text"},{"text":"Any type that conforms to ","type":"text"},{"identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/Component","type":"reference","isActive":true},{"text":" can be a component, and an entity holds at most one","type":"text"},{"text":" ","type":"text"},{"text":"component of each type.","type":"text"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"A "},{"type":"strong","inlineContent":[{"type":"text","text":"resource"}]},{"type":"text","text":" is a value the world holds once, outside any entity, such as a clock or a score."},{"type":"text","text":" "},{"type":"text","text":"Any type that conforms to "},{"type":"reference","identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/Resource","isActive":true},{"type":"text","text":" can be a resource."}]}]}]},{"type":"paragraph","inlineContent":[{"text":"The examples throughout this module’s documentation use these components:","type":"text"}]},{"type":"codeListing","code":["struct Position: Component { var x: Double, y: Double }","struct Velocity: Component { var dx: Double, dy: Double }","struct Health: Component { var current: Int }","struct Frozen: Component {}","struct Name: Component, Hashable { var value: String }"],"syntax":"swift"},{"type":"heading","anchor":"Spawn-Entities-and-Work-with-Their-Components","text":"Spawn Entities and Work with Their Components","level":3},{"type":"paragraph","inlineContent":[{"text":"Spawn an entity with the components it starts with. The world returns the entity’s handle, which","type":"text"},{"text":" ","type":"text"},{"text":"you use to read and change its components:","type":"text"}]},{"type":"codeListing","code":["var world = World()","let hero = world.spawn(Name(value: \"Ada\"), Position(x: 0, y: 0), Health(current: 100))","","world[Health.self, of: hero].current -= 30","world.insert(Velocity(dx: 1, dy: 0), into: hero)","world.remove(Position.self, from: hero)","","print(world[Health.self, of: hero].current)","\/\/ Prints \"70\""],"syntax":"swift"},{"type":"heading","anchor":"Query-and-Update-Many-Entities","text":"Query and Update Many Entities","level":3},{"type":"paragraph","inlineContent":[{"type":"text","text":"Most of the work in a game applies to every entity that holds some set of components: every"},{"type":"text","text":" "},{"type":"text","text":"entity with a position and a velocity moves, every entity with health can take damage. A query"},{"type":"text","text":" "},{"type":"text","text":"visits those entities and reads their components, and an update changes one component of each in"},{"type":"text","text":" "},{"type":"text","text":"place:"}]},{"type":"codeListing","code":["var world = World()","world.spawn(Position(x: 0, y: 0), Velocity(dx: 1, dy: 0))","world.spawn(Position(x: 5, y: 5), Velocity(dx: 0, dy: -1), Frozen())","","world.update(Position.self, reading: Velocity.self, where: .without(Frozen.self)) { position, row in","    position.x += row.components.dx","    position.y += row.components.dy","}","","var coordinates: [(Double, Double)] = []","for (_, position) in world.query(Position.self) {","    coordinates.append((position.x, position.y))","}","print(coordinates)","\/\/ Prints \"[(1.0, 0.0), (5.0, 5.0)]\""],"syntax":"swift"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Filters such as "},{"code":".without(Frozen.self)","type":"codeVoice"},{"type":"text","text":" narrow which entities a query or update visits. To learn"},{"type":"text","text":" "},{"type":"text","text":"more, see "},{"identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/QueryingAWorld","isActive":true,"type":"reference"},{"type":"text","text":"."}]},{"type":"heading","anchor":"Defer-Structural-Changes-with-Commands","text":"Defer Structural Changes with Commands","level":3},{"type":"paragraph","inlineContent":[{"text":"While a query or update is visiting entities, you can’t spawn or despawn entities or add and","type":"text"},{"text":" ","type":"text"},{"text":"remove their components. Record those changes in ","type":"text"},{"type":"reference","identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/Commands","isActive":true},{"text":" instead, and apply them when the","type":"text"},{"text":" ","type":"text"},{"text":"visit is over:","type":"text"}]},{"type":"codeListing","code":["var world = World()","world.spawn(Health(current: 0))","world.spawn(Health(current: 40))","","var commands = Commands()","for (entity, health) in world.query(Health.self) where health.current <= 0 {","    commands.despawn(entity)","}","world.apply(commands)","","print(world.count)","\/\/ Prints \"1\""],"syntax":"swift"},{"type":"heading","anchor":"Keep-World-Wide-State-in-Resources","text":"Keep World-Wide State in Resources","level":3},{"type":"paragraph","inlineContent":[{"type":"text","text":"A resource holds state that belongs to the whole world rather than to any entity:"}]},{"type":"codeListing","code":["struct Elapsed: Resource { var seconds: Double }","","var world = World()","world.resources.insert(Elapsed(seconds: 0))","world.resources[Elapsed.self].seconds += 0.5","","print(world.resources[Elapsed.self].seconds)","\/\/ Prints \"0.5\""],"syntax":"swift"},{"type":"heading","anchor":"Copy-Worlds-Freely","text":"Copy Worlds Freely","level":3},{"type":"paragraph","inlineContent":[{"text":"A world is a value: assigning it to another variable makes an independent copy. Copies share","type":"text"},{"text":" ","type":"text"},{"text":"storage until one of them changes, so copying is cheap, and keeping an earlier state for undo, a","type":"text"},{"text":" ","type":"text"},{"text":"replay or a comparison takes one assignment.","type":"text"}]}],"kind":"content"}],"sections":[],"schemaVersion":{"minor":3,"patch":0,"major":0},"kind":"symbol","references":{"doc://WorldModule/documentation/WorldModule/BundleBuilder":{"identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/BundleBuilder","title":"BundleBuilder","kind":"symbol","role":"symbol","fragments":[{"text":"enum","kind":"keyword"},{"text":" ","kind":"text"},{"text":"BundleBuilder","kind":"identifier"}],"navigatorTitle":[{"text":"BundleBuilder","kind":"identifier"}],"abstract":[{"text":"A result builder that creates a bundle from the components and bundles listed in a closure.","type":"text"}],"url":"\/documentation\/worldmodule\/bundlebuilder","type":"topic"},"doc://WorldModule/documentation/WorldModule/Query":{"role":"symbol","type":"topic","abstract":[{"type":"text","text":"A description of the entities to visit and the components to read from each."}],"identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/Query","url":"\/documentation\/worldmodule\/query","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"Query"}],"kind":"symbol","navigatorTitle":[{"kind":"identifier","text":"Query"}],"title":"Query"},"doc://WorldModule/documentation/WorldModule/TupleBundle":{"fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"TupleBundle","kind":"identifier"}],"abstract":[{"type":"text","text":"A bundle made of other bundles, inserted in order."}],"identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/TupleBundle","title":"TupleBundle","role":"symbol","url":"\/documentation\/worldmodule\/tuplebundle","navigatorTitle":[{"text":"TupleBundle","kind":"identifier"}],"type":"topic","kind":"symbol"},"doc://WorldModule/documentation/WorldModule/TypeRegistryError":{"fragments":[{"text":"enum","kind":"keyword"},{"text":" ","kind":"text"},{"text":"TypeRegistryError","kind":"identifier"}],"abstract":[{"type":"text","text":"An error that indicates why a type couldn’t be registered in a "},{"identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/TypeRegistry","type":"reference","isActive":true},{"type":"text","text":"."}],"identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/TypeRegistryError","title":"TypeRegistryError","role":"symbol","url":"\/documentation\/worldmodule\/typeregistryerror","navigatorTitle":[{"text":"TypeRegistryError","kind":"identifier"}],"type":"topic","kind":"symbol"},"doc://WorldModule/documentation/WorldModule":{"role":"collection","type":"topic","abstract":[{"text":"Store the state of a game or simulation as entities and components, and read and change it with","type":"text"},{"text":" ","type":"text"},{"text":"queries, updates, and commands.","type":"text"}],"identifier":"doc:\/\/WorldModule\/documentation\/WorldModule","url":"\/documentation\/worldmodule","kind":"symbol","title":"WorldModule"},"doc://WorldModule/documentation/WorldModule/Allows":{"fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"Allows"}],"abstract":[{"text":"A filter type that also passes the entities holding a disabling component of type ","type":"text"},{"code":"C","type":"codeVoice"},{"text":".","type":"text"}],"identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/Allows","title":"Allows","role":"symbol","url":"\/documentation\/worldmodule\/allows","navigatorTitle":[{"kind":"identifier","text":"Allows"}],"type":"topic","kind":"symbol"},"doc://WorldModule/documentation/WorldModule/CyclicHierarchy":{"title":"CyclicHierarchy","identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/CyclicHierarchy","kind":"symbol","role":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"CyclicHierarchy","kind":"identifier"}],"navigatorTitle":[{"text":"CyclicHierarchy","kind":"identifier"}],"abstract":[{"type":"text","text":"An error that indicates a link would make an entity its own ancestor."}],"url":"\/documentation\/worldmodule\/cyclichierarchy","type":"topic"},"doc://WorldModule/documentation/WorldModule/ChangeTick":{"identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/ChangeTick","title":"ChangeTick","kind":"symbol","role":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"ChangeTick"}],"navigatorTitle":[{"kind":"identifier","text":"ChangeTick"}],"abstract":[{"type":"text","text":"A point in a world’s history of changes."}],"url":"\/documentation\/worldmodule\/changetick","type":"topic"},"doc://WorldModule/documentation/WorldModule/FilterTerm":{"kind":"symbol","identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/FilterTerm","title":"FilterTerm","role":"symbol","fragments":[{"text":"protocol","kind":"keyword"},{"text":" ","kind":"text"},{"text":"FilterTerm","kind":"identifier"}],"navigatorTitle":[{"text":"FilterTerm","kind":"identifier"}],"abstract":[{"type":"text","text":"A type that stands for a query filter, so a system’s parameter can name the filter in its type."}],"url":"\/documentation\/worldmodule\/filterterm","type":"topic"},"doc://WorldModule/documentation/WorldModule/Scene":{"role":"symbol","abstract":[{"text":"A saved copy of a world’s entities, hierarchy, and the components and resources of the types","type":"text"},{"text":" ","type":"text"},{"text":"a registry names.","type":"text"}],"type":"topic","identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/Scene","url":"\/documentation\/worldmodule\/scene","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Scene","kind":"identifier"}],"kind":"symbol","navigatorTitle":[{"text":"Scene","kind":"identifier"}],"title":"Scene"},"doc://WorldModule/documentation/WorldModule/EntitiesView":{"role":"symbol","type":"topic","abstract":[{"type":"text","text":"A sequence of the live entities of a world, in slot order."}],"identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/EntitiesView","url":"\/documentation\/worldmodule\/entitiesview","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"EntitiesView","kind":"identifier"}],"kind":"symbol","navigatorTitle":[{"text":"EntitiesView","kind":"identifier"}],"title":"EntitiesView"},"doc://WorldModule/documentation/WorldModule/EntityQueryView":{"kind":"symbol","identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/EntityQueryView","title":"EntityQueryView","role":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"EntityQueryView"}],"navigatorTitle":[{"kind":"identifier","text":"EntityQueryView"}],"abstract":[{"text":"A lazy sequence of the entities that pass a filter, without reading any of their components.","type":"text"}],"url":"\/documentation\/worldmodule\/entityqueryview","type":"topic"},"doc://WorldModule/documentation/WorldModule/CleanupAction":{"abstract":[{"text":"What despawning a relation’s target does to the sources related to it.","type":"text"}],"title":"CleanupAction","navigatorTitle":[{"text":"CleanupAction","kind":"identifier"}],"fragments":[{"text":"enum","kind":"keyword"},{"text":" ","kind":"text"},{"text":"CleanupAction","kind":"identifier"}],"kind":"symbol","identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/CleanupAction","url":"\/documentation\/worldmodule\/cleanupaction","role":"symbol","type":"topic"},"doc://WorldModule/documentation/WorldModule/Changed":{"title":"Changed","kind":"symbol","identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/Changed","role":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"text":"Changed","kind":"identifier"}],"navigatorTitle":[{"text":"Changed","kind":"identifier"}],"abstract":[{"type":"text","text":"A filter type that passes the entities whose component of type "},{"type":"codeVoice","code":"C"},{"type":"text","text":" was added or changed since"},{"type":"text","text":" "},{"type":"text","text":"the world’s last run."}],"url":"\/documentation\/worldmodule\/changed","type":"topic"},"doc://WorldModule/documentation/WorldModule/Disabled":{"