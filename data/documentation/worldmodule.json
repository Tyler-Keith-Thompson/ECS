":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"addChild"},{"kind":"text","text":"("},{"kind":"typeIdentifier","preciseIdentifier":"s:11WorldModule6EntityV","text":"Entity"},{"kind":"text","text":", "},{"kind":"externalParam","text":"checkedTo"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:11WorldModule6EntityV","text":"Entity"},{"kind":"text","text":") "},{"kind":"keyword","text":"throws"},{"kind":"text","text":"("},{"kind":"typeIdentifier","preciseIdentifier":"s:11WorldModule14HierarchyErrorO","text":"HierarchyError"},{"kind":"text","text":")"}],"type":"topic"},"doc://WorldModule/documentation/WorldModule/QueryTerm":{"title":"QueryTerm","identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/QueryTerm","type":"topic","kind":"symbol","role":"symbol","url":"\/documentation\/worldmodule\/queryterm","navigatorTitle":[{"text":"QueryTerm","kind":"identifier"}],"abstract":[{"type":"text","text":"A type that can be a term of a query, deciding which entities match and what the query reads"},{"type":"text","text":" "},{"type":"text","text":"from each."}],"fragments":[{"text":"protocol","kind":"keyword"},{"text":" ","kind":"text"},{"text":"QueryTerm","kind":"identifier"}]},"doc://WorldModule/documentation/WorldModule/Query":{"url":"\/documentation\/worldmodule\/query","kind":"symbol","abstract":[{"text":"A description of the entities to visit and the components to read from each.","type":"text"}],"navigatorTitle":[{"text":"Query","kind":"identifier"}],"identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/Query","title":"Query","role":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Query","kind":"identifier"}],"type":"topic"},"doc://WorldModule/documentation/WorldModule":{"type":"topic","abstract":[{"type":"text","text":"Store the state of a game or simulation as entities and components, and read and change it with"},{"type":"text","text":" "},{"type":"text","text":"queries, updates, and commands."}],"identifier":"doc:\/\/WorldModule\/documentation\/WorldModule","kind":"symbol","role":"collection","title":"WorldModule","url":"\/documentation\/worldmodule"},"doc://WorldModule/documentation/WorldModule/Targets":{"title":"Targets","identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/Targets","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Targets","kind":"identifier"}],"type":"topic","kind":"symbol","abstract":[{"type":"text","text":"The component that holds a source entity’s targets of a relation, with the relation’s value"},{"type":"text","text":" "},{"type":"text","text":"for each."}],"url":"\/documentation\/worldmodule\/targets","role":"symbol","navigatorTitle":[{"text":"Targets","kind":"identifier"}]},"doc://WorldModule/documentation/WorldModule/TupleBundle":{"url":"\/documentation\/worldmodule\/tuplebundle","abstract":[{"type":"text","text":"A bundle made of other bundles, inserted in order."}],"kind":"symbol","navigatorTitle":[{"kind":"identifier","text":"TupleBundle"}],"identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/TupleBundle","title":"TupleBundle","role":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"TupleBundle"}],"type":"topic"},"doc://WorldModule/documentation/WorldModule/Trigger":{"fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Trigger","kind":"identifier"}],"navigatorTitle":[{"text":"Trigger","kind":"identifier"}],"abstract":[{"type":"text","text":"The event an observer receives, with the entity it’s being observed on and the entity it was"},{"type":"text","text":" "},{"type":"text","text":"triggered on."}],"type":"topic","url":"\/documentation\/worldmodule\/trigger","title":"Trigger","role":"symbol","identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/Trigger","kind":"symbol"},"doc://WorldModule/documentation/WorldModule/FilterT