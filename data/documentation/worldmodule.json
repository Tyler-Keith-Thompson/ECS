{"metadata":{"symbolKind":"module","externalID":"WorldModule","role":"collection","title":"WorldModule","modules":[{"name":"WorldModule"}],"roleHeading":"Framework"},"identifier":{"url":"doc:\/\/WorldModule\/documentation\/WorldModule","interfaceLanguage":"swift"},"abstract":[{"type":"text","text":"Store the state of a game or simulation as entities and components, and read and change it with"},{"type":"text","text":" "},{"type":"text","text":"queries, updates, and commands."}],"kind":"symbol","schemaVersion":{"minor":3,"major":0,"patch":0},"primaryContentSections":[{"kind":"content","content":[{"text":"Overview","anchor":"Overview","type":"heading","level":2},{"type":"paragraph","inlineContent":[{"type":"text","text":"WorldModule is built around a "},{"type":"reference","isActive":true,"identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/World"},{"type":"text","text":", a value that holds everything your game or simulation"},{"type":"text","text":" "},{"type":"text","text":"knows. The world organizes that state with a few simple ideas:"}]},{"items":[{"content":[{"inlineContent":[{"type":"text","text":"An "},{"type":"strong","inlineContent":[{"type":"text","text":"entity"}]},{"type":"text","text":" is one thing in the world, such as a ball, a player or a particle. It has no data"},{"type":"text","text":" "},{"type":"text","text":"of its own; you refer to it by its handle, an "},{"type":"reference","identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/Entity","isActive":true},{"type":"text","text":"."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"A ","type":"text"},{"inlineContent":[{"type":"text","text":"component"}],"type":"strong"},{"text":" is a plain value that an entity holds, such as a position or a health total.","type":"text"},{"text":" ","type":"text"},{"text":"Any type that conforms to ","type":"text"},{"isActive":true,"identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/Component","type":"reference"},{"text":" can be a component, and an entity holds at most one","type":"text"},{"text":" ","type":"text"},{"text":"component of each type.","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"A ","type":"text"},{"type":"strong","inlineContent":[{"text":"resource","type":"text"}]},{"text":" is a value the world holds once, outside any entity, such as a clock or a score.","type":"text"},{"text":" ","type":"text"},{"text":"Any type that conforms to ","type":"text"},{"identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/Resource","type":"reference","isActive":true},{"text":" can be a resource.","type":"text"}],"type":"paragraph"}]}],"type":"unorderedList"},{"type":"paragraph","inlineContent":[{"text":"The examples throughout this module’s documentation use these components:","type":"text"}]},{"syntax":"swift","code":["struct Position: Component { var x: Double, y: Double }","struct Velocity: Component { var dx: Double, dy: Double }","struct Health: Component { var current: Int }","struct Frozen: Component {}","struct Name: Component, Hashable { var value: String }"],"type":"codeListing"},{"text":"Spawn Entities and Work with Their Components","anchor":"Spawn-Entities-and-Work-with-Their-Components","type":"heading","level":3},{"type":"paragraph","inlineContent":[{"text":"Spawn an entity with the components it starts with. The world returns the entity’s handle, which","type":"text"},{"text":" ","type":"text"},{"text":"you use to read and change its components:","type":"text"}]},{"syntax":"swift","code":["var world = World()","let hero = world.spawn(Name(value: \"Ada\"), Position(x: 0, y: 0), Health(current: 100))","","world[Health.self, of: hero].current -= 30","world.insert(Velocity(dx: 1, dy: 0), into: hero)","world.remove(Position.self, from: hero)","","print(world[Health.self, of: hero].current)","\/\/ Prints \"70\""],"type":"codeListing"},{"text":"Query and Update Many Entities","anchor":"Query-and-Update-Many-Entities","type":"heading","level":3},{"type":"paragraph","inlineContent":[{"type":"text","text":"Most of the work in a game applies to every entity that holds some set of components: every"},{"type":"text","text":" "},{"type":"text","text":"entity with a position and a velocity moves, every entity with health can take damage. A query"},{"type":"text","text":" "},{"type":"text","text":"visits those entities and reads their components, and an update changes one component of each in"},{"type":"text","text":" "},{"type":"text","text":"place:"}]},{"syntax":"swift","code":["var world = World()","world.spawn(Position(x: 0, y: 0), Velocity(dx: 1, dy: 0))","world.spawn(Position(x: 5, y: 5), Velocity(dx: 0, dy: -1), Frozen())","","world.update(Position.self, reading: Velocity.self, where: .without(Frozen.self)) { position, row in","    position.x += row.components.dx","    position.y += row.components.dy","}","","var coordinates: [(Double, Double)] = []","for (_, position) in world.query(Position.self) {","    coordinates.append((position.x, position.y))","}","print(coordinates)","\/\/ Prints \"[(1.0, 0.0), (5.0, 5.0)]\""],"type":"codeListing"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Filters such as "},{"type":"codeVoice","code":".without(Frozen.self)"},{"type":"text","text":" narrow which entities a query or update visits. To learn"},{"type":"text","text":" "},{"type":"text","text":"more, see "},{"type":"reference","identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/QueryingAWorld","isActive":true},{"type":"text","text":"."}]},{"text":"Defer Structural Changes with Commands","anchor":"Defer-Structural-Changes-with-Commands","type":"heading","level":3},{"type":"paragraph","inlineContent":[{"text":"While a query or update is visiting entities, you can’t spawn or despawn entities or add and","type":"text"},{"text":" ","type":"text"},{"text":"remove their components. Record those changes in ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/Commands"},{"text":" instead, and apply them when the","type":"text"},{"text":" ","type":"text"},{"text":"visit is over:","type":"text"}]},{"syntax":"swift","code":["var world = World()","world.spawn(Health(current: 0))","world.spawn(Health(current: 40))","","var commands = Commands()","for (entity, health) in world.query(Health.self) where health.current <= 0 {","    commands.despawn(entity)","}","world.apply(commands)","","print(world.count)","\/\/ Prints \"1\""],"type":"codeListing"},{"text":"Keep World-Wide State in Resources","anchor":"Keep-World-Wide-State-in-Resources","type":"heading","level":3},{"type":"paragraph","inlineContent":[{"text":"A resource holds state that belongs to the whole world rather than to any entity:","type":"text"}]},{"syntax":"swift","code":["struct Elapsed: Resource { var seconds: Double }","","var world = World()","world.resources.insert(Elapsed(seconds: 0))","world.resources[Elapsed.self].seconds += 0.5","","print(world.resources[Elapsed.self].seconds)","\/\/ Prints \"0.5\""],"type":"codeListing"},{"text":"Copy Worlds Freely","anchor":"Copy-Worlds-Freely","type":"heading","level":3},{"type":"paragraph","inlineContent":[{"type":"text","text":"A world is a value: assigning it to another variable makes an independent copy. Copies share"},{"type":"text","text":" "},{"type":"text","text":"storage until one of them changes, so copying is cheap, and keeping an earlier state for undo, a"},{"type":"text","text":" "},{"type":"text","text":"replay or a comparison takes one assignment."}]}]}],"topicSections":[{"identifiers":["doc:\/\/WorldModule\/documentation\/WorldModule\/World","doc:\/\/WorldModule\/documentation\/WorldModule\/Entity","doc:\/\/WorldModule\/documentation\/WorldModule\/Component","doc:\/\/WorldModule\/documentation\/WorldModule\/Resource"],"title":"Essentials","anchor":"Essentials"},{"identifiers":["doc:\/\/WorldModule\/documentation\/WorldModule\/Bundle","doc:\/\/WorldModule\/documentation\/WorldModule\/BundleBuilder","doc:\/\/WorldModule\/documentation\/WorldModule\/TupleBundle","doc:\/\/WorldModule\/documentation\/WorldModule\/EitherBundle"],"title":"Grouping Components","anchor":"Grouping-Components"},{"identifiers":["doc:\/\/WorldModule\/documentation\/WorldModule\/QueryingAWorld","doc:\/\/WorldModule\/documentation\/WorldModule\/Query","doc:\/\/WorldModule\/documentation\/WorldModule\/QueryView","doc:\/\/WorldModule\/documentation\/WorldModule\/EntityQueryView","doc:\/\/WorldModule\/documentation\/WorldModule\/QueryRow","doc:\/\/WorldModule\/documentation\/WorldModule\/QueryTerm","doc:\/\/WorldModule\/documentation\/WorldModule\/AnyOf","doc:\/\/WorldModule\/documentation\/WorldModule\/EntitiesView"],"title":"Querying and Updating Entities","anchor":"Querying-and-Updating-Entities"},{"identifiers":["doc:\/\/WorldModule\/documentation\/WorldModule\/QueryFilter","doc:\/\/WorldModule\/documentation\/WorldModule\/FilterTerm","doc:\/\/WorldModule\/documentation\/WorldModule\/With","doc:\/\/WorldModule\/documentation\/WorldModule\/Without","doc:\/\/WorldModule\/documentation\/WorldModule\/Added","doc:\/\/WorldModule\/documentation\/WorldModule\/Changed","doc:\/\/WorldModule\/documentation\/WorldModule\/Allows"],"title":"Filtering Queries","anchor":"Filtering-Queries"},{"identifiers":["doc:\/\/WorldModule\/documentation\/WorldModule\/GroupError"],"title":"Speeding Up Queries","abstract":[{"text":"Groups are made with ","type":"text"},{"type":"codeVoice","code":"group(_:)"},{"text":", cached queries with ","type":"text"},{"type":"codeVoice","code":"cache(_:)"},{"text":" and indexes by value with","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"index(_:)"},{"text":" on ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/World"},{"text":"; ","type":"text"},{"type":"codeVoice","code":"lookup(_:)"},{"text":" finds the entities holding a value.","type":"text"}],"anchor":"Speeding-Up-Q