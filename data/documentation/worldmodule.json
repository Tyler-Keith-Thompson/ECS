"text":" ","kind":"text"},{"text":"Resources","kind":"identifier"}],"url":"\/documentation\/worldmodule\/resources"},"doc://WorldModule/documentation/WorldModule/Trigger":{"identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/Trigger","role":"symbol","title":"Trigger","kind":"symbol","navigatorTitle":[{"kind":"identifier","text":"Trigger"}],"url":"\/documentation\/worldmodule\/trigger","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"Trigger"}],"abstract":[{"type":"text","text":"The event an observer receives, with the entity it’s being observed on and the entity it was"},{"type":"text","text":" "},{"type":"text","text":"triggered on."}],"type":"topic"},"doc://WorldModule/documentation/WorldModule/TypeRegistryError":{"title":"TypeRegistryError","abstract":[{"text":"An error that indicates why a type couldn’t be registered in a ","type":"text"},{"isActive":true,"identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/TypeRegistry","type":"reference"},{"text":".","type":"text"}],"fragments":[{"text":"enum","kind":"keyword"},{"text":" ","kind":"text"},{"text":"TypeRegistryError","kind":"identifier"}],"identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/TypeRegistryError","kind":"symbol","type":"topic","role":"symbol","url":"\/documentation\/worldmodule\/typeregistryerror","navigatorTitle":[{"text":"TypeRegistryError","kind":"identifier"}]},"doc://WorldModule/documentation/WorldModule/ChildOf":{"navigatorTitle":[{"text":"ChildOf","kind":"identifier"}],"abstract":[{"text":"The relation that links a child entity to its parent.","type":"text"}],"title":"ChildOf","type":"topic","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"ChildOf","kind":"identifier"}],"identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/ChildOf","url":"\/documentation\/worldmodule\/childof","role":"symbol","kind":"symbol"},"doc://WorldModule/documentation/WorldModule/TypeRegistry