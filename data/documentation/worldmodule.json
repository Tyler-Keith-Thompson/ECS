t","type":"codeVoice"},{"type":"text","text":" and "},{"code":"onRemove","type":"codeVoice"},{"type":"text","text":" on "},{"isActive":true,"type":"reference","identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/World"},{"type":"text","text":", for a component type"},{"type":"text","text":" "},{"type":"text","text":"or a query. Observers are registered with "},{"code":"observe","type":"codeVoice"},{"type":"text","text":"."}],"anchor":"Reacting-to-Changes-with-Hooks-and-Observers"},{"identifiers":["doc:\/\/WorldModule\/documentation\/WorldModule\/SavingAndLoadingWorlds","doc:\/\/WorldModule\/documentation\/WorldModule\/WorldSnapshot","doc:\/\/WorldModule\/documentation\/WorldModule\/Scene","doc:\/\/WorldModule\/documentation\/WorldModule\/TypeRegistry","doc:\/\/WorldModule\/documentation\/WorldModule\/TypeRegistryError","doc:\/\/WorldModule\/documentation\/WorldModule\/MapEntities"],"title":"Saving and Loading Worlds","anchor":"Saving-and-Loading-Worlds"},{"identifiers":["doc:\/\/WorldModule\/documentation\/WorldModule\/Access","doc:\/\/WorldModule\/documentation\/WorldModule\/ConcurrentChange"],"title":"Running Changes Concurrently","anchor":"Running-Changes-Concurrently"},{"identifiers":["doc:\/\/WorldModule\/documentation\/WorldModule\/StaleEntity","doc:\/\/WorldModule\/documentation\/WorldModule\/MissingComponent","doc:\/\/WorldModule\/documentation\/WorldModule\/MissingResource"],"title":"Errors","anchor":"Errors"},{"generated":true,"identifiers":["doc:\/\/WorldModule\/documentation\/WorldModule\/Swift"],"title":"Extended Modules","anchor":"Extended-Modules"}],"sections":[],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/worldmodule"]}],"hierarchy":{"paths":[[]]},"references":{"doc://WorldModule/documentation/WorldModule/World/addChild(_:checkedTo:)":{"abstract":[{"type":"text","text":"Adds an entity to the end of another entity’s children, throwing if either entity is"},{"type":"text","text":" "},{"type":"text","text":