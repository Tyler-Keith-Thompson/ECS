tle":"EntityQueryView","url":"\/documentation\/worldmodule\/entityqueryview","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"EntityQueryView","kind":"identifier"}],"navigatorTitle":[{"text":"EntityQueryView","kind":"identifier"}],"identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/EntityQueryView"},"doc://WorldModule/documentation/WorldModule/StaleEntity":{"kind":"symbol","title":"StaleEntity","url":"\/documentation\/worldmodule\/staleentity","identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/StaleEntity","role":"symbol","navigatorTitle":[{"kind":"identifier","text":"StaleEntity"}],"type":"topic","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"StaleEntity"}],"abstract":[{"text":"An error that indicates an entity isn’t live in the world.","type":"text"}]},"doc://WorldModule/documentation/WorldModule/Access":{"kind":"symbol","title":"Access","identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/Access","url":"\/documentation\/worldmodule\/access","role":"symbol","navigatorTitle":[{"kind":"identifier","text":"Access"}],"type":"topic","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"Access"}],"abstract":[{"type":"text","text":"A description of the component and resource types that a change to a world reads and writes."}]},"doc://WorldModule/documentation/WorldModule/Without":{"kind":"symbol","title":"Without","identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/Without","url":"\/documentation\/worldmodule\/without","role":"symbol","navigatorTitle":[{"kind":"identifier","text":"Without"}],"type":"topic","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"Without"}],"abstract":[{"text":"A filter type that passes the entities holding no component of type ","type":"text"},{"type":"codeVoice","code":"C"},{"text":".","type":"text"}]},"doc: