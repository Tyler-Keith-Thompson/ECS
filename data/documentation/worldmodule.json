","navigatorTitle":[{"text":"Component","kind":"identifier"}],"abstract":[{"type":"text","text":"A type that can be stored as a component of an entity."}],"fragments":[{"text":"protocol","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Component","kind":"identifier"}]},"doc://WorldModule/documentation/WorldModule/Added":{"title":"Added","kind":"symbol","type":"topic","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Added","kind":"identifier"}],"abstract":[{"type":"text","text":"A filter type that passes the entities whose component of type "},{"type":"codeVoice","code":"C"},{"type":"text","text":" was added since the"},{"type":"text","text":" "},{"type":"text","text":"world’s last run."}],"navigatorTitle":[{"text":"Added","kind":"identifier"}],"role":"symbol","url":"\/documentation\/worldmodule\/added","identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/Added"},"doc://WorldModule/documentation/WorldModule/AncestorsView":{"title":"AncestorsView","identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/AncestorsView","type":"topic","kind":"symbol","role":"symbol","url":"\/documentation\/worldmodule\/ancestorsview","navigatorTitle":[{"kind":"identifier","text":"AncestorsView"}],"abstract":[{"text":"A lazy sequence of an entity’s ancestors, from its parent up to the root of its tree.","type":"text"}],"fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"AncestorsView"}]},"doc://WorldModule/documentation/WorldModule/Resources":{"url":"\/documentation\/worldmodule\/resources","title":"Resources","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Resources","kind":"identifier"}],"type":"topic","role":"symbol","kind":"symbol","abstract":[{"type":"text","text":"A collection of resources, holding at most one value of each type."}],"navigatorTitle":[{"text":"Resources","kind":"identifier"}],"identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/Resources"},"doc://WorldModule/documentation/WorldModule/TypeRegistryError":{"url":"\/documentation\/worldmodule\/typeregistryerror","abstract":[{"text":"An error that indicates why a type couldn’t be registered in a ","type":"text"},{"identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/TypeRegistry","isActive":true,"type":"reference"},{"text":".","type":"text"}],"kind":"symbol","navigatorTitle":[{"text":"TypeRegistryError","kind":"identifier"}],"identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/TypeRegistryError","title":"TypeRegistryError","role":"symbol","fragments":[{"text":"enum","kind":"keyword"},{"text":" ","kind":"text"},{"text":"TypeRegistryError","kind":"identifier"}],"type":"topic"},"doc://WorldModule/documentation/WorldModule/RemovedComponent":{"title":"RemovedComponent","identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/RemovedComponent","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"RemovedComponent","kind":"identifier"}],"type":"topic","kind":"symbol","abstract":[{"text":"The event a world sends when an entity loses a component of type ","type":"text"},{"code":"C","type":"codeVoice"},{"text":".","type":"text"}],"url":"\/documentation\/worldmodule\/removedcomponent","role":"symbol","navigatorTitle":[{"text":"RemovedComponent","kind":"identifier"}]},"doc://WorldModule/documentation/WorldModule/Bundle":{"title":"Bundle","type":"topic","identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/Bundle","kind":"symbol","role":"symbol","url":"\/documentation\/worldmodule\/bundle","navigatorTitle":[{"text":"Bundle","kind":"identifier"}],"abstract":[{"text":"A type that groups components to be spawned, inserted, and removed together.","type":"text"}],"fragments":[{"text":"protocol","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Bundle","kind":"identifier"}]},"doc://WorldModule/documentation/WorldModule/EntitiesView":{"type":"topic","navigatorTitle":[{"kind":"identif