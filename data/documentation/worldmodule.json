{"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/worldmodule"]}],"kind":"symbol","schemaVersion":{"minor":3,"patch":0,"major":0},"identifier":{"url":"doc:\/\/WorldModule\/documentation\/WorldModule","interfaceLanguage":"swift"},"topicSections":[{"identifiers":["doc:\/\/WorldModule\/documentation\/WorldModule\/World","doc:\/\/WorldModule\/documentation\/WorldModule\/Entity","doc:\/\/WorldModule\/documentation\/WorldModule\/Component","doc:\/\/WorldModule\/documentation\/WorldModule\/Resource"],"title":"Essentials","anchor":"Essentials"},{"identifiers":["doc:\/\/WorldModule\/documentation\/WorldModule\/Bundle","doc:\/\/WorldModule\/documentation\/WorldModule\/BundleBuilder","doc:\/\/WorldModule\/documentation\/WorldModule\/TupleBundle","doc:\/\/WorldModule\/documentation\/WorldModule\/EitherBundle"],"title":"Grouping Components","anchor":"Grouping-Components"},{"identifiers":["doc:\/\/WorldModule\/documentation\/WorldModule\/QueryingAWorld","doc:\/\/WorldModule\/documentation\/WorldModule\/Query","doc:\/\/WorldModule\/documentation\/WorldModule\/QueryView","doc:\/\/WorldModule\/documentation\/WorldModule\/EntityQueryView","doc:\/\/WorldModule\/documentation\/WorldModule\/QueryRow","doc:\/\/WorldModule\/documentation\/WorldModule\/QueryTerm","doc:\/\/WorldModule\/documentation\/WorldModule\/AnyOf","doc:\/\/WorldModule\/documentation\/WorldModule\/EntitiesView"],"title":"Querying and Updating Entities","anchor":"Querying-and-Updating-Entities"},{"identifiers":["doc:\/\/WorldModule\/documentation\/WorldModule\/QueryFilter","doc:\/\/WorldModule\/documentation\/WorldModule\/FilterTerm","doc:\/\/WorldModule\/documentation\/WorldModule\/With","doc:\/\/WorldModule\/documentation\/WorldModule\/Without","doc:\/\/WorldModule\/documentation\/WorldModule\/Added","doc:\/\/WorldModule\/documentation\/WorldModule\/Changed","doc:\/\/WorldModule\/documentation\/WorldModule\/Allows"],"title":"Filtering Queries","anchor":"Filtering-Queries"},{"anchor":"Speeding-Up-Queries","identifiers":["doc:\/\/WorldModule\/documentation\/WorldModule\/GroupError"],"title":"Speeding Up Queries","abstract":[{"text":"Groups are made with ","type":"text"},{"code":"group(_:)","type":"codeVoice"},{"text":", cached queries with ","type":"text"},{"code":"cache(_:)","type":"codeVoice"},{"text":" and indexes by value with","type":"text"},{"text":" ","type":"text"},{"code":"index(_:)","type":"codeVoice"},{"text":" on ","type":"text"},{"identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/World","type":"reference","isActive":true},{"text":"; ","type":"text"},{"code":"lookup(_:)","type":"codeVoice"},{"text":" finds the entities holding a value, and","type":"text"},{"text":" ","type":"text"},{"code":"lookup(_:equals:)","type":"codeVoice"},{"text":" the entities whose property at a key path equals one.","type":"text"}]},{"identifiers":["doc:\/\/WorldModule\/documentation\/WorldModule\/Commands"],"title":"Deferring Changes","anchor":"Deferring-Changes"},{"identifiers":["doc:\/\/WorldModule\/documentation\/WorldModule\/Resources"],"title":"Working with Resources","anchor":"Working-with-Resources"},{"identifiers":["doc:\/\/WorldModule\/documentation\/WorldModule\/ChangeTick","doc:\/\/WorldModule\/documentation\/WorldModule\/RemovedComponent"],"title":"Detecting Changes and Removals","anchor":"Detecting-Changes-and-Removals"},{"identifiers":["doc:\/\/WorldModule\/documentation\/WorldModule\/Disabled","doc:\/\/WorldModule\/documentation\/WorldModule\/Prefab"],"title":"Disabling Entities and Using Prefabs","anchor":"Disabling-Entities-and-Using-Prefabs"},{"identifiers":["doc:\/\/WorldModule\/documentation\/WorldModule\/ChildOf","doc:\/\/WorldModule\/documentation\/WorldModule\/AncestorsView","doc:\/\/WorldModule\/documentation\/WorldModule\/DescendantsView","doc:\/\/WorldModule\/documentation\/WorldModule\/CyclicHierarchy","doc:\/\/WorldModule\/documentation\/WorldModule\/HierarchyError"],"title":"Building Hierarchies","anchor":"Building-Hierarchies"},{"identifiers":["doc:\/\/WorldModule\/documentation\/WorldModule\/Relation","doc:\/\/WorldModule\/documentation\/WorldModule\/Targets","doc:\/\/WorldModule\/documentation\/WorldModule\/CleanupAction"],"title":"Relating Entities","anchor":"Relating-Entities"},{"identifiers":["doc:\/\/WorldModule\/documentation\/WorldModule\/Event","doc:\/\/WorldModule\/documentation\/WorldModule\/Events","doc:\/\/WorldModule\/documentation\/WorldModule\/EventsView"],"title":"Sending Events","anchor":"Sending-Events"},{"anchor":"Reacting-to-Changes-with-Hooks-and-Observers","identifiers":["doc:\/\/WorldModule\/documentation\/WorldModule\/EntityEvent","doc:\/\/WorldModule\/documentation\/WorldModule\/Trigger"],"title":"Reacting to Changes with Hooks and Observers","abstract":[{"text":"Hooks are registered with ","type":"text"},{"code":"onAdd","type":"codeVoice"},{"text":", ","type":"text"},{"code":"onInsert","type":"codeVoice"},{"text":" and ","type":"text"},{"code":"onRemove","type":"codeVoice"},{"text":" on ","type":"text"},{"identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/World","isActive":true,"type":"reference"},{"text":", for a component type","type":"text"},{"text":" ","type":"text"},{"text":"or a query. Observers are registered with ","type":"text"},{"code":"observe","type":"codeVoice"},{"text":".","type":"text"}]},{"identifiers":["doc:\/\/WorldModule\/documentation\/WorldModule\/SavingAndLoadingWorlds","doc:\/\/WorldModule\/documentation\/WorldModule\/WorldSnapshot","doc:\/\/WorldModule\/documentation\/WorldModule\/Scene","doc:\/\/WorldModule\/documentation\/WorldModule\/TypeRegistry","doc:\/\/WorldModule\/documentation\/WorldModule\/TypeRegistryError","doc:\/\/WorldModule\/documentation\/WorldModule\/TypeRegistryLookupError","doc:\/\/WorldModule\/documentation\/WorldModule\/MapEntities"],"title":"Saving and Loading Worlds","anchor":"Saving-and-Loading-Worlds"},{"identifiers":["doc:\/\/WorldModule\/documentation\/WorldModule\/Access","doc:\/\/WorldModule\/documentation\/WorldModule\/ConcurrentChange"],"title":"Running Changes Concurrently","anchor":"Running-Changes-Concurrently"},{"identifiers":["doc:\/\/WorldModule\/documentation\/WorldModule\/StaleEntity","doc:\/\/WorldModule\/documentation\/WorldModule\/MissingComponent","doc:\/\/WorldModule\/documentation\/WorldModule\/MissingResource"],"title":"Errors","anchor":"Errors"},{"anchor":"Extended-Modules","identifiers":["doc:\/\/WorldModule\/documentation\/WorldModule\/Swift"],"title":"Extended Modules","generated":true}],"sections":[],"metadata":{"symbolKind":"module","role":"collection","title":"WorldModule","modules":[{"name":"WorldModule"}],"roleHeading":"Framework","externalID":"WorldModule"},"primaryContentSections":[{"kind":"content","content":[{"anchor":"Overview","type":"heading","level":2,"text":"Overview"},{"inlineContent":[{"type":"text","text":"WorldModule is built around a "},{"identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/World","isActive":true,"type":"reference"},{"type":"text","text":", a value that holds everything your game or simulation"},{"type":"text","text":" "},{"type":"text","text":"knows. The world organizes that state with a few simple ideas:"}],"type":"paragraph"},{"items":[{"content":[{"inlineContent":[{"text":"An ","type":"text"},{"inlineContent":[{"type":"text","text":"entity"}],"type":"strong"},{"text":" is one thing in the world, such as a ball, a player or a particle. It has no data","type":"text"},{"text":" ","type":"text"},{"text":"of its own; you refer to it by its handle, an ","type":"text"},{"identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/Entity","isActive":true,"type":"reference"},{"text":".","type":"text"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"A ","type":"text"},{"type":"strong","inlineContent":[{"type":"text","text":"component"}]},{"text":" is a plain value that an entity holds, such as a position or a health total.","type":"text"},{"text":" ","type":"text"},{"text":"Any type that conforms to ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/Component"},{"text":" can be a component, and an entity holds at most one","type":"text"},{"text":" ","type":"text"},{"text":"component of each type.","type":"text"}]}]},{"content":[{"inlineContent":[{"type":"text","text":"A "},{"type":"strong","inlineContent":[{"text":"resource","type":"text"}]},{"type":"text","text":" is a value the world holds once, outside any entity, such as a clock or a score."},{"type":"text","text":" "},{"type":"text","text":"Any type that conforms to "},{"identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/Resource","isActive":true,"type":"reference"},{"type":"text","text":" can be a resource."}],"type":"paragraph"}]}],"type":"unorderedList"},{"inlineContent":[{"type":"text","text":"The examples throughout this module’s documentation use these components:"}],"type":"paragraph"},{"code":["struct Position: Component { var x: Double, y: Double }","struct Velocity: Component { var dx: Double, dy: Double }","struct Health: Component { var current: Int }","struct Frozen: Component {}","struct Name: Component, Hashable { var value: String }"],"type":"codeListing","syntax":"swift"},{"anchor":"Spawn-Entities-and-Work-with-Their-Components","type":"heading","level":3,"text":"Spawn Entities and Work with Their Components"},{"inlineContent":[{"type":"text","text":"Spawn an entity with the components it starts with. The world returns the entity’s handle, which"},{"type":"text","text":" "},{"type":"text","text":"you use to read and change its components:"}],"type":"paragraph"},{"code":["var world = World()","let hero = world.spawn(Name(value: \"Ada\"), Position(x: 0, y: 0), Health(current: 100))","","world[Health.self, of: hero].current -= 30","world.insert(Velocity(dx: 1, dy: 0), into: hero)","world.remove(Position.self, from: hero)","","print(world[Health.self, of: hero].current)","\/\/ Prints \"70\""],"type":"codeListing","syntax":"swift"},{"anchor":"Query-and-Update-Many-Entities","type":"heading","level":3,"text":"Query and Update Many Entities"},{"inlineContent":[{"type":"text","text":"Most of the work in a game applies to every entity that holds some set of components: every"},{"type":"text","text":" "},{"type":"text","text":"entity with a position and a velocity moves, every entity with health can take damage. A query"},{"type":"text","text":" "},{"type":"text","text":"visits those entities and reads their components, and an update changes one component of each in"},{"type":"text","text":" "},{"type":"text","text":"place:"}],"type":"paragraph"},{"code":["var world = World()","world.spawn(Position(x: 0, y: 0), Velocity(dx: 1, dy: 0))","world.spawn(Position(x: 5, y: 5), Velocity(dx: 0, dy: -1), Frozen())","","world.update(Position.self, reading: Velocity.self, where: .without(Frozen.self)) { position, row in","    position.x += row.components.dx","    position.y += row.components.dy","}","","var coordinates: [(Double, Double)] = []","for (_, position) in world.query(Position.self) {","    coordinates.append((position.x, position.y))","}","print(coordinates)","\/\/ Prints \"[(1.0, 0.0), (5.0, 5.0)]\""],"type":"codeListing","syntax":"swift"},{"inlineContent":[{"text":"Filters such as ","type":"text"},{"code":".without(Frozen.self)","type":"codeVoice"},{"type":"text","text":" narrow which entities a query or update visits. To learn"},{"type":"text","text":" "},{"type":"text","text":"more, see "},{"identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/QueryingAWorld","isActive":true,"type":"reference"},{"text":".","type":"text"}],"type":"paragraph"},{"anchor":"Defer-Structural-Changes-with-Commands","type":"heading","level":3,"text":"Defer Structural Changes with Commands"},{"inlineContent":[{"type":"text","text":"While a query or update is visiting entities, you can’t spawn or despawn entities or add and"},{"type":"text","text":" "},{"type":"text","text":"remove their components. Record those changes in "},{"isActive":true,"identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/Commands","type":"reference"},{"type":"text","text":" instead, and apply them when the"},{"type":"text","text":" "},{"type":"text","text":"visit is over:"}],"type":"paragraph"},{"code":["var world = World()","world.spawn(Health(current: 0))","world.spawn(Health(current: 40))","","var commands = Commands()","for (entity, health) in world.query(Health.self) where health.current <= 0 {","    commands.despawn(entity)","}","world.apply(commands)","","print(world.count)","\/\/ Prints \"1\""],"type":"codeListing","syntax":"swift"},{"anchor":"Keep-World-Wide-State-in-Resources","type":"heading","level":3,"text":"Keep World-Wide State in Resources"},{"inlineContent":[{"text":"A resource holds state that belongs to the whole world rather than to any entity:","type":"text"}],"type":"paragraph"},{"code":["struct Elapsed: Resource { var seconds: Double }","","var world = World()","world.resources.insert(Elapsed(seconds: 0))","world.resources[Elapsed.self].seconds += 0.5","","print(world.resources[Elapsed.self].seconds)","\/\/ Prints \"0.5\""],"type":"codeListing","syntax":"swift"},{"anchor":"Copy-Worlds-Freely","type":"heading","level":3,"text":"Copy Worlds Freely"},{"inlineContent":[{"text":"A world is a value: assigning it to another variable makes an independent copy. Copies share","type":"text"},{"text":" ","type":"text"},{"text":"storage until one of them changes, so copying is cheap, and keeping an earlier state for undo, a","type":"text"},{"text":" ","type":"text"},{"text":"replay or a comparison takes one assignment.","type":"text"}],"type":"paragraph"}]}],"hierarchy":{"paths":[[]]},"abstract":[{"type":"text","text":"Store the state of a game or simulation as entities and components, and read and change it with"},{"type":"text","text":" "},{"type":"text","text":"queries, updates, and commands."}],"references":{"doc://WorldModule/documentation/WorldModule/Changed":{"kind":"symbol","url":"\/documentation\/worldmodule\/changed","identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/Changed","title":"Changed","role":"symbol","navigatorTitle":[{"text":"Changed","kind":"identifier"}],"type":"topic","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Changed","kind":"identifier"}],"abstract":[{"type":"text","text":"A filter type that passes the entities whose component of type "},{"type":"codeVoice","code":"C"},{"type":"text","text":" was added or changed since"},{"type":"text","text":" "},{"type":"text","text":"the world’s last run."}]},"doc://WorldModule/documentation/WorldModule/Allows":{"role":"symbol","type":"topic","abstract":[{"type":"text","text":"A filter type that also passes the entities holding a disabling component of type "},{"code":"C","type":"codeVoice"},{"type":"text","text":"."}],"kind":"symbol","title":"Allows","url":"\/documentation\/worldmodule\/allows","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Allows","kind":"identifier"}],"navigatorTitle":[{"text":"Allows","kind":"identifier"}],"identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/Allows"},"doc://WorldModule/documentation/WorldModule/TypeRegistry":{"kind":"symbol","title":"TypeRegistry","identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/TypeRegistry","url":"\/documentation\/worldmodule\/typeregistry","role":"symbol","navigatorTitle":[{"text":"TypeRegistry","kind":"identifier"}],"type":"topic","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"TypeRegistry","kind":"identifier"}],"abstract":[{"text":"A list of the component and resource types that a scene saves, each under a name that","type":"text"},{"text":" ","type":"text"},{"text":"identifies it in saved data.","type":"text"}]},"doc://WorldModule/documentation/WorldModule":{"identifier":"doc:\/\/WorldModule\/documentation\/WorldModule","role":"collection","kind":"symbol","type":"topic","abstract":[{"type":"text","text":"Store the state of a game or simulation as entities and components, and read and change it with"},{"type":"text","text":" "},{"type":"text","text":"queries, updates, and commands."}],"url":"\/documentation\/worldmodule","title":"WorldModule"},"doc://WorldModule/documentation/WorldModule/RemovedComponent":{"identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/RemovedComponent","role":"symbol","kind":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"RemovedComponent","kind":"identifier"}],"type":"topic","abstract":[{"type":"text","text":"The event a world sends when an entity loses a component of type "},{"code":"C","type":"codeVoice"},{"type":"text","text":"."}],"navigatorTitle":[{"text":"RemovedComponent","kind":"identifier"}],"url":"\/documentation\/worldmodule\/removedcomponent","title":"RemovedComponent"},"doc://WorldModule/documentation/WorldModule/TupleBundle":{"role":"symbol","abstract":[{"type":"text","text":"A bundle made of other bundles, inserted in order."}],"type":"topic","kind":"symbol","title":"TupleBundle","url":"\/documentation\/worldmodule\/tuplebundle","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"TupleBundle"}],"navigatorTitle":[{"kind":"identifier","text":"TupleBundle"}],"identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/TupleBundle"},"doc://WorldModule/documentation/WorldModule/TypeRegistryLookupError":{"kind":"symbol","url":"\/documentation\/worldmodule\/typeregistrylookuperror","identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/TypeRegistryLookupError","title":"TypeRegistryLookupError","role":"symbol","navigatorTitle":[{"kind":"identifier","text":"TypeRegistryLookupError"}],"type":"topic","fragments":[{"text":"enum","kind":"keyword"},{"text":" ","kind":"text"},{"kind":"identifier","text":"TypeRegistryLookupError"}],"abstract":[{"text":"An error that indicates why a ","type":"text"},{"identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/TypeRegistry","type":"reference","isActive":true},{"text":" couldn’t reach a component or resource by","type":"text"},{"text":" ","type":"text"},{"text":"name.","type":"text"}]},"doc://WorldModule/documentation/WorldModule/Added":{"role":"symbol","abstract":[{"text":"A filter type that passes the entities whose component of type ","type":"text"},{"code":"C","type":"codeVoice"},{"text":" was added since the","type":"text"},{"text":" ","type":"text"},{"text":"world’s last run.","type":"text"}],"type":"topic","kind":"symbol","title":"Added","url":"\/documentation\/worldmodule\/added","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"kind":"identifier","text":"Added"}],"navigatorTitle":[{"kind":"identifier","text":"Added"}],"identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/Added"},"doc://WorldModule/documentation/WorldModule/Disabled":{"kind":"symbol","title":"Disabled","identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/Disabled","url":"\/documentation\/worldmodule\/disabled","role":"symbol","navigatorTitle":[{"text":"Disabled","kind":"identifier"}],"type":"topic","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Disabled","kind":"identifier"}],"abstract":[{"type":"text","text":"A component that makes queries and updates skip an entity, unless they ask for it."}]},"doc://WorldModule/documentation/WorldModule/CyclicHierarchy":{"kind":"symbol","url":"\/documentation\/worldmodule\/cyclichierarchy","identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/CyclicHierarchy","title":"CyclicHierarchy","role":"symbol","navigatorTitle":[{"text":"CyclicHierarchy","kind":"identifier"}],"type":"topic","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"CyclicHierarchy","kind":"identifier"}],"abstract":[{"type":"text","text":"An error that in