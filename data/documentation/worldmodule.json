ldSnapshot","role":"symbol","url":"\/documentation\/worldmodule\/worldsnapshot","navigatorTitle":[{"text":"WorldSnapshot","kind":"identifier"}],"type":"topic","kind":"symbol"},"doc://WorldModule/documentation/WorldModule/Added":{"title":"Added","identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/Added","kind":"symbol","role":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"text":"Added","kind":"identifier"}],"navigatorTitle":[{"text":"Added","kind":"identifier"}],"abstract":[{"text":"A filter type that passes the entities whose component of type ","type":"text"},{"code":"C","type":"codeVoice"},{"text":" was added since the","type":"text"},{"text":" ","type":"text"},{"text":"world’s last run.","type":"text"}],"url":"\/documentation\/worldmodule\/added","type":"topic"},"doc://WorldModule/documentation/WorldModule/QueryView":{"fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"QueryView"}],"abstract":[{"text":"A lazy sequence of the entities that match a query, with the components the query reads.","type":"text"}],"identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/QueryView","title":"QueryView","role":"symbol","url":"\/documentation\/worldmodule\/queryview","navigatorTitle":[{"kind":"identifier","text":"QueryView"}],"type":"topic","kind":"symbol"},"doc://WorldModule/documentation/WorldModule/Bundle":{"kind":"symbol","identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/Bundle","title":"Bundle","role":"symbol","fragments":[{"kind":"keyword","text":"protocol"},{"kind":"text","text":" "},{"kind":"identifier","text":"Bundle"}],"navigatorTitle":[{"kind":"identifier","text":"Bundle"}],"abstract":[{"text":"A type that groups components to be spawned, inserted, and removed together.","type":"text"}],"url":"\/documentation\/worldmodule\/bundle","type":"topic"},"doc://WorldModule/documentation/WorldModule/Commands":{"role":"symbol","abstract":[{"type":"text","