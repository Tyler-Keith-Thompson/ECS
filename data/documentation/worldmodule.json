{"schemaVersion":{"patch":0,"minor":3,"major":0},"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/WorldModule\/documentation\/WorldModule"},"hierarchy":{"paths":[[]]},"sections":[],"topicSections":[{"identifiers":["doc:\/\/WorldModule\/documentation\/WorldModule\/World","doc:\/\/WorldModule\/documentation\/WorldModule\/Entity","doc:\/\/WorldModule\/documentation\/WorldModule\/Component","doc:\/\/WorldModule\/documentation\/WorldModule\/Resource"],"anchor":"Essentials","title":"Essentials"},{"identifiers":["doc:\/\/WorldModule\/documentation\/WorldModule\/Bundle","doc:\/\/WorldModule\/documentation\/WorldModule\/BundleBuilder","doc:\/\/WorldModule\/documentation\/WorldModule\/TupleBundle","doc:\/\/WorldModule\/documentation\/WorldModule\/EitherBundle"],"anchor":"Grouping-Components","title":"Grouping Components"},{"identifiers":["doc:\/\/WorldModule\/documentation\/WorldModule\/QueryingAWorld","doc:\/\/WorldModule\/documentation\/WorldModule\/Query","doc:\/\/WorldModule\/documentation\/WorldModule\/QueryView","doc:\/\/WorldModule\/documentation\/WorldModule\/EntityQueryView","doc:\/\/WorldModule\/documentation\/WorldModule\/QueryRow","doc:\/\/WorldModule\/documentation\/WorldModule\/QueryTerm","doc:\/\/WorldModule\/documentation\/WorldModule\/AnyOf","doc:\/\/WorldModule\/documentation\/WorldModule\/EntitiesView"],"anchor":"Querying-and-Updating-Entities","title":"Querying and Updating Entities"},{"identifiers":["doc:\/\/WorldModule\/documentation\/WorldModule\/QueryFilter","doc:\/\/WorldModule\/documentation\/WorldModule\/FilterTerm","doc:\/\/WorldModule\/documentation\/WorldModule\/With","doc:\/\/WorldModule\/documentation\/WorldModule\/Without","doc:\/\/WorldModule\/documentation\/WorldModule\/Added","doc:\/\/WorldModule\/documentation\/WorldModule\/Changed","doc:\/\/WorldModule\/documentation\/WorldModule\/Allows"],"anchor":"Filtering-Queries","title":"Filtering Queries"},{"identifiers":["doc:\/\/WorldModule\/documentation\/WorldModule\/GroupError"],"abstract":[{"type":"text","text":"Groups are made with "},{"type":"codeVoice","code":"group(_:)"},{"type":"text","text":", cached queries with "},{"type":"codeVoice","code":"cache(_:)"},{"type":"text","text":" and indexes by value with"},{"type":"text","text":" "},{"type":"codeVoice","code":"index(_:)"},{"type":"text","text":" on "},{"type":"reference","isActive":true,"identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/World"},{"type":"text","text":"; "},{"type":"codeVoice","code":"lookup(_:)"},{"type":"text","text":" finds the entities holding a value."}],"anchor":"Speeding-Up-Queries","title":"Speeding Up Queries"},{"identifiers":["doc:\/\/WorldModule\/documentation\/WorldModule\/Commands"],"anchor":"Deferring-Changes","title":"Deferring Changes"},{"identifiers":["doc:\/\/WorldModule\/documentation\/WorldModule\/Resources"],"anchor":"Working-with-Resources","title":"Working with Resources"},{"identifiers":["doc:\/\/WorldModule\/documentation\/WorldModule\/ChangeTick","doc:\/\/WorldModule\/documentation\/WorldModule\/RemovedComponent"],"anchor":"Detecting-Changes-and-Removals","title":"Detecting Changes and Removals"},{"identifiers":["doc:\/\/WorldModule\/documentation\/WorldModule\/Disabled","doc:\/\/WorldModule\/documentation\/WorldModule\/Prefab"],"anchor":"Disabling-Entities-and-Using-Prefabs","title":"Disabling Entities and Using Prefabs"},{"identifiers":["doc:\/\/WorldModule\/documentation\/WorldModule\/ChildOf","doc:\/\/WorldModule\/documentation\/WorldModule\/AncestorsView","doc:\/\/WorldModule\/documentation\/WorldModule\/DescendantsView","doc:\/\/WorldModule\/documentation\/WorldModule\/CyclicHierarchy","doc:\/\/WorldModule\/documentation\/WorldModule\/HierarchyError"],"anchor":"Building-Hierarchies","title":"Building Hierarchies"},{"identifiers":["doc:\/\/WorldModule\/documentation\/WorldModule\/Relation","doc:\/\/WorldModule\/documentation\/WorldModule\/Targets","doc:\/\/WorldModule\/documentation\/WorldModule\/CleanupAction"],"anchor":"Relating-Entities","title":"Relating Entities"},{"identifiers":["doc:\/\/WorldModule\/documentation\/WorldModule\/Event","doc:\/\/WorldModule\/documentation\/WorldModule\/Events","doc:\/\/WorldModule\/documentation\/WorldModule\/EventsView"],"anchor":"Sending-Events","title":"Sending Events"},{"identifiers":["doc:\/\/WorldModule\/documentation\/WorldModule\/EntityEvent","doc:\/\/WorldModule\/documentation\/WorldModule\/Trigger"],"abstract":[{"type":"text","text":"Hooks are registered with "},{"type":"codeVoice","code":"onAdd"},{"type":"text","text":", "},{"type":"codeVoice","code":"onInsert"},{"type":"text","text":" and "},{"type":"codeVoice","code":"onRemove"},{"type":"text","text":" on "},{"isActive":true,"identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/World","type":"reference"},{"type":"text","text":", for a component type"},{"type":"text","text":" "},{"type":"text","text":"or a query. Observers are registered with "},{"type":"codeVoice","code":"observe"},{"type":"text","text":"."}],"anchor":"Reacting-to-Changes-with-Hooks-and-Observers","title":"Reacting to Changes with Hooks and Observers"},{"identifiers":["doc:\/\/WorldModule\/documentation\/WorldModule\/SavingAndLoadingWorlds","doc:\/\/WorldModule\/documentation\/WorldModule\/WorldSnapshot","doc:\/\/WorldModule\/documentation\/WorldModule\/Scene","doc:\/\/WorldModule\/documentation\/WorldModule\/TypeRegistry","doc:\/\/WorldModule\/documentation\/WorldModule\/TypeRegistryError","doc:\/\/WorldModule\/documentation\/WorldModule\/TypeRegistryLookupError","doc:\/\/WorldModule\/documentation\/WorldModule\/MapEntities"],"anchor":"Saving-and-Loading-Worlds","title":"Saving and Loading Worlds"},{"identifiers":["doc:\/\/WorldModule\/documentation\/WorldModule\/Access","doc:\/\/WorldModule\/documentation\/WorldModule\/ConcurrentChange"],"anchor":"Running-Changes-Concurrently","title":"Running Changes Concurrently"},{"identifiers":["doc:\/\/WorldModule\/documentation\/WorldModule\/StaleEntity","doc:\/\/WorldModule\/documentation\/WorldModule\/MissingComponent","doc:\/\/WorldModule\/documentation\/WorldModule\/MissingResource"],"anchor":"Errors","title":"Errors"},{"identifiers":["doc:\/\/WorldModule\/documentation\/WorldModule\/Swift"],"anchor":"Extended-Modules","title":"Extended Modules","generated":true}],"primaryContentSections":[{"content":[{"type":"heading","level":2,"text":"Overview","anchor":"Overview"},{"type":"paragraph","inlineContent":[{"type":"text","text":"WorldModule is built around a "},{"type":"reference","identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/World","isActive":true},{"type":"text","text":", a value that holds everything your game or simulation"},{"type":"text","text":" "},{"type":"text","text":"knows. The world organizes that state with a few simple ideas:"}]},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"An "},{"type":"strong","inlineContent":[{"type":"text","text":"entity"}]},{"type":"text","text":" is one thing in the world, such as a ball, a player or a particle. It has no data"},{"type":"text","text":" "},{"type":"text","text":"of its own; you refer to it by its handle, an "},{"type":"reference","isActive":true,"identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/Entity"},{"type":"text","text":"."}]}]},{"content":[{"inlineContent":[{"type":"text","text":"A "},{"type":"strong","inlineContent":[{"type":"text","text":"component"}]},{"type":"text","text":" is a plain value that an entity holds, such as a position or a health total."},{"type":"text","text":" "},{"type":"text","text":"Any type that conforms to "},{"type":"reference","identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/Component","isActive":true},{"type":"text","text":" can be a component, and an entity holds at most one"},{"type":"text","text":" "},{"type":"text","text":"component of each type."}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"A "},{"type":"strong","inlineContent":[{"text":"resource","type":"text"}]},{"type":"text","text":" is a value the world holds once, outside any entity, such as a clock or a score."},{"type":"text","text":" "},{"type":"text","text":"Any type that conforms to "},{"type":"reference","identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/Resource","isActive":true},{"type":"text","text":" can be a resource."}]}]}]},{"type":"paragraph","inlineContent":[{"text":"The examples throughout this module’s documentation use these components:","type":"text"}]},{"type":"codeListing","code":["struct Position: Component { var x: Double, y: Double }","struct Velocity: Component { var dx: Double, dy: Double }","struct Health: Component { var current: Int }","struct Frozen: Component {}","struct Name: Component, Hashable { var value: String }"],"syntax":"swift"},{"type":"heading","level":3,"text":"Spawn Entities and Work with Their Components","anchor":"Spawn-Entities-and-Work-with-Their-Components"},{"type":"paragraph","inlineContent":[{"text":"Spawn an entity with the components it starts with. The world returns the entity’s handle, which","type":"text"},{"text":" ","type":"text"},{"text":"you use to read and change its components:","type":"text"}]},{"type":"codeListing","code":["var world = World()","let hero = world.spawn(Name(value: \"Ada\"), Position(x: 0, y: 0), Health(current: 100))","","world[Health.self, of: hero].current -= 30","world.insert(Velocity(dx: 1, dy: 0), into: hero)","world.remove(Position.self, from: hero)","","print(world[Health.self, of: hero].current)","\/\/ Prints \"70\""],"syntax":"swift"},{"type":"heading","level":3,"text":"Query and Update Many Entities","anchor":"Query-and-Update-Many-Entities"},{"type":"paragraph","inlineContent":[{"text":"Most of the work in a game applies to every entity that holds some set of components: every","type":"text"},{"text":" ","type":"text"},{"text":"entity with a position and a velocity moves, every entity with health can take damage. A query","type":"text"},{"text":" ","type":"text"},{"text":"visits those entities and reads their components, and an update changes one component of each in","type":"text"},{"text":" ","type":"text"},{"text":"place:","type":"text"}]},{"type":"codeListing","code":["var world = World()","world.spawn(Position(x: 0, y: 0), Velocity(dx: 1, dy: 0))","world.spawn(Position(x: 5, y: 5), Velocity(dx: 0, dy: -1), Frozen())","","world.update(Position.self, reading: Velocity.self, where: .without(Frozen.self)) { position, row in","    position.x += row.components.dx","    position.y += row.components.dy","}","","var coordinates: [(Double, Double)] = []","for (_, position) in world.query(Position.self) {","    coordinates.append((position.x, position.y))","}","print(coordinates)","\/\/ Prints \"[(1.0, 0.0), (5.0, 5.0)]\""],"syntax":"swift"},{"type":"paragraph","inlineContent":[{"text":"Filters such as ","type":"text"},{"code":".without(Frozen.self)","type":"codeVoice"},{"text":" narrow which entities a query or update visits. To learn","type":"text"},{"text":" ","type":"text"},{"text":"more, see ","type":"text"},{"identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/QueryingAWorld","isActive":true,"type":"reference"},{"text":".","type":"text"}]},{"type":"heading","level":3,"text":"Defer Structural Changes with Commands","anchor":"Defer-Structural-Changes-with-Commands"},{"type":"paragraph","inlineContent":[{"text":"While a query or update is visiting entities, you can’t spawn or despawn entities or add and","type":"text"},{"text":" ","type":"text"},{"text":"remove their components. Record those changes in ","type":"text"},{"identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/Commands","isActive":true,"type":"reference"},{"text":" instead, and apply them when the","type":"text"},{"text":" ","type":"text"},{"text":"visit is over:","type":"text"}]},{"type":"codeListing","code":["var world = World()","world.spawn(Health(current: 0))","world.spawn(Health(current: 40))","","var commands = Commands()","for (entity, health) in world.query(Health.self) where health.current <= 0 {","    commands.despawn(entity)","}","world.apply(commands)","","print(world.count)","\/\/ Prints \"1\""],"syntax":"swift"},{"type":"heading","level":3,"text":"Keep World-Wide State in Resources","anchor":"Keep-World-Wide-State-in-Resources"},{"type":"paragraph","inlineContent":[{"text":"A resource holds state that belongs to the whole world rather than to any entity:","type":"text"}]},{"type":"codeListing","code":["struct Elapsed: Resource { var seconds: Double }","","var world = World()","world.resources.insert(Elapsed(seconds: 0))","world.resources[Elapsed.self].seconds += 0.5","","print(world.resources[Elapsed.self].seconds)","\/\/ Prints \"0.5\""],"syntax":"swift"},{"type":"heading","level":3,"text":"Copy Worlds Freely","anchor":"Copy-Worlds-Freely"},{"type":"paragraph","inlineContent":[{"type":"text","text":"A world is a value: assigning it to another variable makes an independent copy. Copies share"},{"type":"text","text":" "},{"type":"text","text":"storage until one of them changes, so copying is cheap, and keeping an earlier state for undo, a"},{"type":"text","text":" "},{"type":"text","text":"replay or a comparison takes one assignment."}]}],"kind":"content"}],"metadata":{"symbolKind":"module","externalID":"WorldModule","roleHeading":"Framework","role":"collection","modules":[{"name":"WorldModule"}],"title":"WorldModule"},"kind":"symbol","abstract":[{"type":"text","text":"Store the state of a game or simulation as entities and components, and read and change it with"},{"type":"text","text":" "},{"type":"text","text":"queries, updates, and commands."}],"variants":[{"paths":["\/documentation\/worldmodule"],"traits":[{"interfaceLanguage":"swift"}]}],"references":{"doc://WorldModule/documentation/WorldModule/FilterTerm":{"fragments":[{"kind":"keyword","text":"protocol"},{"kind":"text","text":" "},{"kind":"identifier","text":"FilterTe