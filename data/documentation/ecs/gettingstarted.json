{"kind":"article","schemaVersion":{"major":0,"minor":3,"patch":0},"hierarchy":{"paths":[["doc:\/\/ECS\/documentation\/ECS"]]},"identifier":{"url":"doc:\/\/ECS\/documentation\/ECS\/GettingStarted","interfaceLanguage":"swift"},"primaryContentSections":[{"kind":"content","content":[{"level":2,"type":"heading","text":"Overview","anchor":"Overview"},{"inlineContent":[{"type":"text","text":"In an entity component system, the things your program tracks are "},{"type":"emphasis","inlineContent":[{"text":"entities","type":"text"}]},{"type":"text","text":": plain handles that"},{"type":"text","text":" "},{"type":"text","text":"own nothing themselves. The data lives in "},{"type":"emphasis","inlineContent":[{"text":"components","type":"text"}]},{"type":"text","text":", small value types attached to entities,"},{"type":"text","text":" "},{"type":"text","text":"such as a position or a health bar. The behavior lives in "},{"type":"emphasis","inlineContent":[{"type":"text","text":"systems"}]},{"type":"text","text":", functions that run over"},{"type":"text","text":" "},{"type":"text","text":"every entity holding a particular set of components. A "},{"type":"emphasis","inlineContent":[{"text":"world","type":"text"}]},{"type":"text","text":" holds the entities and their"},{"type":"text","text":" "},{"type":"text","text":"components, and a "},{"type":"emphasis","inlineContent":[{"type":"text","text":"schedule"}]},{"type":"text","text":" runs systems on it."}],"type":"paragraph"},{"inlineContent":[{"text":"This article builds a tiny game step by step: balls that move, and that disappear when their","type":"text"},{"text":" ","type":"text"},{"text":"health runs out.","type":"text"}],"type":"paragraph"},{"level":3,"type":"heading","text":"Define Components","anchor":"Define-Components"},{"inlineContent":[{"type":"text","text":"A component is a value type that conforms to "},{"identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/Component","type":"reference","isActive":true},{"type":"text","text":". It needs no other"},{"type":"text","text":" "},{"type":"text","text":"requirements; a struct with stored properties is enough. A component can also be empty, to mark"},{"type":"text","text":" "},{"type":"text","text":"the entities that have it."}],"type":"paragraph"},{"inlineContent":[{"text":"The following components describe where an entity is, how fast it moves, and how much health it","type":"text"},{"text":" ","type":"text"},{"text":"has:","type":"text"}],"type":"paragraph"},{"syntax":"swift","type":"codeListing","code":["struct Position: Component { var x: Double, y: Double }","struct Velocity: Component { var dx: Double, dy: Double }","struct Health: Component { var current: Int }"]},{"level":3,"type":"heading","text":"Spawn Entities","anchor":"Spawn-Entities"},{"inlineContent":[{"text":"A ","type":"text"},{"isActive":true,"identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/World","type":"reference"},{"text":" holds entities and their components. Create an empty world, then call","type":"text"},{"text":" ","type":"text"},{"code":"spawn(_:)","type":"codeVoice"},{"text":" with the components a new entity starts with. Spawning returns an","type":"text"},{"text":" ","type":"text"},{"isActive":true,"identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/Entity","type":"reference"},{"text":", the handle you use to read and change that entity later:","type":"text"}],"type":"paragraph"},{"syntax":"swift","type":"codeListing","code":["var world = World()","let ball = world.spawn(Position(x: 0, y: 0), Velocity(dx: 1, dy: 2))","let rock = world.spawn(Position(x: 5, y: 5))","print(world.count)","\/\/ Prints \"2\"","","world[Position.self, of: ball].x = 10","print(world[Position.self, of: ball])","\/\/ Prints \"Position(x: 10.0, y: 0.0)\"","","world.insert(Health(current: 3), into: rock)","print(world.contains(Health.self, in: rock))","\/\/ Prints \"true\""]},{"inlineContent":[{"type":"text","text":"The subscript reads one component of one entity, and changes it in place when you assign through"},{"type":"text","text":" "},{"type":"text","text":"it. Use "},{"code":"insert(_:into:)","type":"codeVoice"},{"type":"text","text":" to add a component to an entity, "},{"code":"remove(_:from:)","type":"codeVoice"},{"type":"text","text":" to take one away,"},{"type":"text","text":" "},{"type":"text","text":"and "},{"code":"despawn(_:)","type":"codeVoice"},{"type":"text","text":" to remove the entity and all of its components."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"A world is a value: assigning it to another variable makes an independent copy, and the two"},{"type":"text","text":" "},{"type":"text","text":"share their storage until one of them changes."}],"type":"paragraph"},{"style":"important","content":[{"inlineContent":[{"text":"Like an array subscript, the subscript traps if the entity doesn’t hold the","type":"text"},{"text":" ","type":"text"},{"text":"component, or has been despawned. Each such operation has a ","type":"text"},{"code":"checked","type":"codeVoice"},{"text":" spelling, such as","type":"text"},{"text":" ","type":"text"},{"code":"world[checked: Position.self, of: ball]","type":"codeVoice"},{"text":", that throws an error instead.","type":"text"}],"type":"paragraph"}],"type":"aside","name":"Important"},{"level":3,"type":"heading","text":"Query and Update Many Entities","anchor":"Query-and-Update-Many-Entities"},{"inlineContent":[{"text":"A query visits every entity holding a set of component types. Call ","type":"text"},{"type":"codeVoice","code":"query(_:)"},{"text":" with the types,","type":"text"},{"text":" ","type":"text"},{"text":"and iterate over the result; each row holds the entity followed by its components. Narrow a","type":"text"},{"text":" ","type":"text"},{"text":"query with ","type":"text"},{"type":"codeVoice","code":"with(_:)"},{"text":" and ","type":"text"},{"type":"codeVoice","code":"without(_:)"},{"text":":","type":"text"}],"type":"paragraph"},{"syntax":"swift","type":"codeListing","code":["var world = World()","world.spawn(Position(x: 0, y: 0), Velocity(dx: 1, dy: 2))","world.spawn(Position(x: 5, y: 5))","","for (_, position) in world.query(Position.self).without(Velocity.self) {","    print(position)  \/\/ Prints \"Position(x: 5.0, y: 5.0)\"","}"]},{"inlineContent":[{"text":"To change components across many entities, use ","type":"text"},{"code":"update(_:reading:body:)","type":"codeVoice"},{"text":". It visits every","type":"text"},{"text":" ","type":"text"},{"text":"entity holding the written type and the read types, and passes the written component ","type":"text"},{"code":"inout","type":"codeVoice"},{"text":" ","type":"text"},{"text":"along with a row of the others. This is the fastest way to change many entities:","type":"text"}],"type":"paragraph"},{"syntax":"swift","type":"codeListing","code":["var world = World()","let ball = world.spawn(Position(x: 0, y: 0), Velocity(dx: 1, dy: 2))","let rock = world.spawn(Position(x: 5, y: 5))","","world.update(Position.self, reading: Velocity.self) { position, row in","    position.x += row.components.dx","    position.y += row.components.dy","}","print(world[Position.self, of: ball])","\/\/ Prints \"Position(x: 1.0, y: 2.0)\"","print(world[Position.self, of: rock])","\/\/ Prints \"Position(x: 5.0, y: 5.0)\""]},{"inlineContent":[{"type":"text","text":"The rock has no velocity, so the update skips it."}],"type":"paragraph"},{"level":3,"type":"heading","text":"Write Systems","anchor":"Write-Systems"},{"inlineContent":[{"text":"A system is a rule your program applies over and over, such as moving everything that has a","type":"text"},{"text":" ","type":"text"},{"text":"velocity. Declare one with the ","type":"text"},{"identifier":"doc:\/\/Systems\/documentation\/Systems\/System()","isActive":true,"type":"reference"},{"text":" macro on a type with a ","type":"text"},{"code":"run","type":"codeVoice"},{"text":" method. The","type":"text"},{"text":" ","type":"text"},{"text":"types of the method’s parameters say what the system reads and writes:","type":"text"},{"text":" ","type":"text"},{"identifier":"doc:\/\/Systems\/documentation\/Systems\/Update","isActive":true,"type":"reference"},{"text":" writes components, ","type":"text"},{"identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/Query","isActive":true,"type":"reference"},{"text":" reads them, and an ","type":"text"},{"code":"inout","type":"codeVoice"},{"text":" ","type":"text"},{"identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/Commands","isActive":true,"type":"reference"},{"text":" records spawns and despawns to apply once the system, and the systems","type":"text"},{"text":" ","type":"text"},{"text":"running alongside it, finish.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"The following systems move each entity by its velocity, and despawn each entity whose health has"},{"type":"text","text":" "},{"type":"text","text":"run out:"}],"type":"paragraph"},{"syntax":"swift","type":"codeListing","code":["@System","struct Movement {","    func run(_ movers: Update<Position>.Over<Velocity>) {","        movers { position, row in","            position.x += row.components.dx","            position.y += row.components.dy","        }","    }","}","","@System","struct Reaper {","    func run(_ living: Query<Health>, commands: inout Commands) {","        for (entity, health) in living where health.current <= 0 {","            commands.despawn(entity)","        }","    }","}"]},{"inlineContent":[{"type":"text","text":"Because a system states what it touches, a schedule knows which systems can run at the same"},{"type":"text","text":" "},{"type":"text","text":"time. Two parameters that name the same component, one of them writing it, such as two updates"},{"type":"text","text":" "},{"type":"text","text":"of "},{"type":"codeVoice","code":"Position"},{"type":"text","text":", are a compile-time error."}],"type":"paragraph"},{"level":3,"type":"heading","text":"Run a Schedule","anchor":"Run-a-Schedule"},{"inlineContent":[{"text":"A ","type":"text"},{"isActive":true,"identifier":"doc:\/\/Systems\/documentation\/Systems\/Schedule","type":"reference"},{"text":" runs systems in the order you write them. Call","type":"text"},{"text":" ","type":"text"},{"isActive":true,"identifier":"doc:\/\/Systems\/documentation\/Systems\/Schedule\/run(on:)","type":"reference"},{"text":" to run every system once on a world:","type":"text"}],"type":"paragraph"},{"syntax":"swift","type":"codeListing","code":["var world = World()","let ball = world.spawn(Position(x: 0, y: 0), Velocity(dx: 1, dy: 2), Health(current: 3))","let ghost = world.spawn(Position(x: 0, y: 0), Health(current: 0))","","let frame = Schedule {","    Movement()","    Reaper()","}","frame.run(on: &world)","","print(world[Position.self, of: ball])","\/\/ Prints \"Position(x: 1.0, y: 2.0)\"","print(world.contains(ghost))","\/\/ Prints \"false\""]},{"inlineContent":[{"type":"text","text":"Systems that don’t conflict, like these two, run at the same time. Neither reads what the other"},{"type":"text","text":" "},{"type":"text","text":"writes, so the result doesn’t depend on which runs first, and the commands they record apply once"},{"type":"text","text":" "},{"type":"text","text":"both finish. To order systems differently, add"},{"type":"text","text":" "},{"type":"text","text":"a constraint such as "},{"code":"Reaper().after(Movement.self)","type":"codeVoice"},{"type":"text","text":", and to skip a system unless a condition"},{"type":"text","text":" "},{"type":"text","text":"holds, add "},{"code":"runIf(_:)","type":"codeVoice"},{"type":"text","text":"."}],"type":"paragraph"},{"level":3,"type":"heading","text":"Run a Simulation","anchor":"Run-a-Simulation"},{"inlineContent":[{"text":"A game or simulation runs its systems every frame. A ","type":"text"},{"isActive":true,"identifier":"doc:\/\/SimulationModule\/documentation\/SimulationModule\/Simulation","type":"reference"},{"text":" owns a world","type":"text"},{"text":" ","type":"text"},{"text":"and schedules named by label, and you call ","type":"text"},{"isActive":true,"identifier":"doc:\/\/SimulationModule\/documentation\/SimulationModule\/Simulation\/update(elapsed:)","type":"reference"},{"text":" once a","type":"text"},{"text":" ","type":"text"},{"text":"frame with the time that passed. Systems added to the","type":"text"},{"text":" ","type":"text"},{"isActive":true,"identifier":"doc:\/\/SimulationModule\/documentation\/SimulationModule\/ScheduleLabel\/fixedUpdate","type":"reference"},{"text":" label run once for every fixed timestep of that","type":"text"},{"text":" ","type":"text"},{"text":"time, so they advance at the same rate however long each frame takes:","type":"text"}],"type":"paragraph"},{"syntax":"swift","type":"codeListing","code":["var world = World()","let ball = world.spawn(Position(x: 0, y: 0), Velocity(dx: 1, dy: 2), Health(current: 3))","","var simulation = Simulation(world, fixedTimestep: .milliseconds(10))","simulation.add(to: .fixedUpdate) { Movement() }","simulation.add(to: .update) { Reaper() }","","simulation.update(elapsed: .milliseconds(30))","print(simulation.world[Position.self, of: ball])","\/\/ Prints \"Position(x: 3.0, y: 6.0)\""]},{"inlineContent":[{"type":"text","text":"The 30-millisecond frame covers three timesteps, so "},{"type":"codeVoice","code":"Movement"},{"type":"text","text":" runs three times. Because it"},{"type":"text","text":" "},{"type":"text","text":"moves each entity by its velocity once a run, the velocity here is a distance per timestep. A"},{"type":"text","text":" "},{"type":"text","text":"system that needs the length of a step reads the "},{"type":"reference","isActive":true,"identifier":"doc:\/\/SimulationModule\/documentation\/SimulationModule\/FixedTime"},{"type":"text","text":" resource, and one"},{"type":"text","text":" "},{"type":"text","text":"that needs the length of a frame reads "},{"type":"reference","isActive":true,"identifier":"doc:\/\/SimulationModule\/documentation\/SimulationModule\/Time"},{"type":"text","text":"."}],"type":"paragraph"},{"level":3,"type":"heading","text":"Next Steps","anchor":"Next-Steps"},{"items":[{"content":[{"inlineContent":[{"text":"Learn about the world in depth, including bundles, relations, hierarchies, events and change","type":"text"},{"text":" ","type":"text"},{"text":"detection, in ","type":"text"},{"identifier":"doc:\/\/WorldModule\/documentation\/WorldModule","type":"reference","isActive":true},{"text":".","type":"text"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"Learn about system parameters, ordering and system sets in ","type":"text"},{"identifier":"doc:\/\/Systems\/documentation\/Systems","isActive":true,"type":"reference"},{"text":".","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Learn about states and the order of a frame in "},{"type":"reference","identifier":"doc:\/\/SimulationModule\/documentation\/SimulationModule","isActive":true},{"type":"text","text":"."}]}]}],"type":"unorderedList"}]}],"abstract":[{"type":"text","text":"Define components, spawn entities, and move them with systems that run in a schedule and a"},{"type":"text","text":" "},{"type":"text","text":"simulation."}],"sections":[],"variants":[{"paths":["\/documentation\/ecs\/gettingstarted"],"traits":[{"interfaceLanguage":"swift"}]}],"metadata":{"modules":[{"name":"ECS"}],"title":"Getting Started with ECS","role":"article","roleHeading":"Article"},"references":{"doc://WorldModule/documentation/WorldModule/Component":{"abstract":[{"type":"text","text":"A type that can be stored as a component of an entity."}],"url":"\/documentation\/worldmodule\/component","kind":"symbol","navigatorTitle":[{"text":"Component","kind":"identifier"}],"role":"symbol","identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/Component","type":"topic","title":"Component","fragments":[{"text":"protocol","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Component","kind":"identifier"}]},"doc://SimulationModule/documentation/SimulationModule/Simulation/update(elapsed:)":{"kind":"symbol","type":"topic","identifier":"doc:\/\/SimulationModule\/documentation\/SimulationModule\/Simulation\/update(elapsed:)","title":"update(elapsed:)","role":"symbol","abstract":[{"text":"Advances the simulation by one frame.","type":"text"}],"url":"\/documentation\/simulationmodule\/simulation\/update(elapsed:)","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"update"},{"kind":"text","text":"("},{"kind":"externalParam","text":"elapsed"},{"kind":"text","text":": "},{"preciseIdentifier":"s:s8DurationV","kind":"typeIdentifier","text":"Duration"},{"kind":"text","text":")"}]},"doc://SimulationModule/documentation/SimulationModule/Time":{"abstract":[{"type":"text","text":"A resource holding the time a simulation has advanced."}],"url":"\/documentation\/simulationmodule\/time","kind":"symbol","navigatorTitle":[{"kind":"identifier","text":"Time"}],"role":"symbol","identifier":"doc:\/\/SimulationModule\/documentation\/SimulationModule\/Time","type":"topic","title":"Time","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"Time"}]},"doc://SimulationModule/documentation/SimulationModule/Simulation":{"kind":"symbol","type":"topic","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Simulation","kind":"identifier"}],"navigatorTitle":[{"text":"Simulation","kind":"identifier"}],"abstract":[{"type":"text","text":"A world and its schedules by label, advanced one frame at a time."}],"url":"\/documentation\/simulationmodule\/simulation","role":"symbol","identifier":"doc:\/\/SimulationModule\/documentation\/SimulationModule\/Simulation","title":"Simulation"},"doc://SimulationModule/documentation/SimulationModule/ScheduleLabel/fixedUpdate":{"kind":"symbol","type":"topic","identifier":"doc:\/\/SimulationModule\/documentation\/SimulationModule\/ScheduleLabel\/fixedUpdate","title":"fixedUpdate","role":"symbol","abstract":[{"text":"The label of the schedule that runs once for each fixed timestep of elapsed time.","type":"text"}],"url":"\/documentation\/simulationmodule\/schedulelabel\/fixedupdate","fragments":[{"kind":"keyword","text":"static"},{"kind":"text","text":" "},{"kind":"keyword","text":"let"},{"kind":"text","text":" "},{"kind":"identifier","text":"fixedUpdate"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"ScheduleLabel","preciseIdentifier":"s:16SimulationModule13ScheduleLabelV"}]},"doc://WorldModule/documentation/WorldModule":{"kind":"symbol","type":"topic","identifier":"doc:\/\/WorldModule\/documentation\/WorldModule","title":"WorldModule","role":"collection","abstract":[{"text":"Store the state of a game or simulation as entities and components, and read and change it with","type":"text"},{"text":" ","type":"text"},{"text":"queries, updates, and commands.","type":"text"}],"url":"\/documentation\/worldmodule"},"doc://SimulationModule/documentation/SimulationModule":{"abstract":[{"text":"Run a world frame by frame, with schedules for startup, a fixed timestep and each frame, and","type":"text"},{"text":" ","type":"text"},{"text":"with states that switch systems on and off.","type":"text"}],"url":"\/documentation\/simulationmodule","kind":"symbol","role":"collection","identifier":"doc:\/\/SimulationModule\/documentation\/SimulationModule","title":"SimulationModule","type":"topic"},"doc://WorldModule/documentation/WorldModule/Entity":{"kind":"symbol","type":"topic","identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/Entity","title":"Entity","role":"symbol","abstract":[{"type":"text","text":"A handle that identifies one entity in a world."}],"url":"\/documentation\/worldmodule\/entity","navigatorTitle":[{"text":"Entity","kind":"identifier"}],"fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Entity","kind":"identifier"}]},"doc://Systems/documentation/Systems/Update":{"kind":"symbol","type":"topic","fragments":[{"kind":"keyword","text":"class"},{"kind":"text","text":" "},{"kind":"identifier","text":"Update"}],"navigatorTitle":[{"kind":"identifier","text":"Update"}],"abstract":[{"text":"A system parameter that changes a component of every entity that holds it.","type":"text"}],"url":"\/documentation\/systems\/update","role":"symbol","identifier":"doc:\/\/Systems\/documentation\/Systems\/Update","title":"Update"},"doc://Systems/documentation/Systems/System()":{"abstract":[{"text":"Makes a type a system whose access comes from the parameters of its ","type":"text"},{"code":"run","type":"codeVoice"},{"text":" method.","type":"text"}],"url":"\/documentation\/systems\/system()","kind":"symbol","role":"symbol","identifier":"doc:\/\/Systems\/documentation\/Systems\/System()","type":"topic","title":"System()","fragments":[{"kind":"keyword","text":"macro"},{"kind":"text","text":" "},{"kind":"identifier","text":"System"},{"kind":"text","text":"()"}]},"doc://SimulationModule/documentation/SimulationModule/FixedTime":{"kind":"symbol","type":"topic","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"FixedTime"}],"navigatorTitle":[{"kind":"identifier","text":"FixedTime"}],"abstract":[{"text":"A resource holding the fixed timestep of a simulation.","type":"text"}],"url":"\/documentation\/simulationmodule\/fixedtime","role":"symbol","identifier":"doc:\/\/SimulationModule\/documentation\/SimulationModule\/FixedTime","title":"FixedTime"},"doc://WorldModule/documentation/WorldModule/Commands":{"abstract":[{"type":"text","text":"A buffer of changes to a world, recorded now and applied later in the order they were"},{"type":"text","text":" "},{"type":"text","text":"recorded."}],"url":"\/documentation\/worldmodule\/commands","kind":"symbol","navigatorTitle":[{"kind":"identifier","text":"Commands"}],"role":"symbol","identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/Commands","title":"Commands","type":"topic","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"Commands"}]},"doc://WorldModule/documentation/WorldModule/World":{"kind":"symbol","type":"topic","identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/World","title":"World","role":"symbol","abstract":[{"text":"A collection of entities, the components they hold, and resources.","type":"text"}],"url":"\/documentation\/worldmodule\/world","navigatorTitle":[{"text":"World","kind":"identifier"}],"fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"World","kind":"identifier"}]},"doc://Systems/documentation/Systems/Schedule/run(on:)":{"kind":"symbol","type":"topic","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"run"},{"kind":"text","text":"("},{"kind":"externalParam","text":"on"},{"kind":"text","text":": "},{"kind":"keyword","text":"inout"},{"kind":"text","text":" "},{"kind":"typeIdentifier","text":"World","preciseIdentifier":"s:11WorldModule0A0V"},{"kind":"text","text":")"}],"abstract":[{"text":"Runs each system once on a world, running systems that don’t depend on each other at the","type":"text"},{"text":" ","type":"text"},{"text":"same time.","type":"text"}],"url":"\/documentation\/systems\/schedule\/run(on:)","role":"symbol","identifier":"doc:\/\/Systems\/documentation\/Systems\/Schedule\/run(on:)","title":"run(on:)"},"doc://ECS/documentation/ECS":{"kind":"symbol","type":"topic","abstract":[{"text":"Build games and simulations from entities, the components they hold, and systems that update","type":"text"},{"text":" ","type":"text"},{"text":"them in a declared order.","type":"text"}],"url":"\/documentation\/ecs","role":"collection","identifier":"doc:\/\/ECS\/documentation\/ECS","title":"ECS"},"doc://WorldModule/documentation/WorldModule/Query":{"abstract":[{"type":"text","text":"A description of the entities to visit and the components to read from each."}],"url":"\/documentation\/worldmodule\/query","kind":"symbol","navigatorTitle":[{"kind":"identifier","text":"Query"}],"role":"symbol","type":"topic","title":"Query","identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/Query","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"Query"}]},"doc://Systems/documentation/Systems":{"kind":"symbol","type":"topic","identifier":"doc:\/\/Systems\/documentation\/Systems","title":"Systems","role":"collection","abstract":[{"text":"Declare the rules of a simulation as systems, and run them on a world in a schedule.","type":"text"}],"url":"\/documentation\/systems"},"doc://Systems/documentation/Systems/Schedule":{"kind":"symbol","type":"topic","identifier":"doc:\/\/Systems\/documentation\/Systems\/Schedule","title":"Schedule","role":"symbol","abstract":[{"text":"A list of systems that run on a world, in order, and at the same time where they can.","type":"text"}],"url":"\/documentation\/systems\/schedule","navigatorTitle":[{"kind":"identifier","text":"Schedule"}],"fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"Schedule"}]}}}