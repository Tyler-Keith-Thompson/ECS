{"sections":[],"schemaVersion":{"major":0,"minor":3,"patch":0},"variants":[{"paths":["\/documentation\/ecs\/gettingstarted"],"traits":[{"interfaceLanguage":"swift"}]}],"abstract":[{"type":"text","text":"Define components, spawn entities, and move them with systems that run in a schedule and a"},{"type":"text","text":" "},{"type":"text","text":"simulation."}],"kind":"article","identifier":{"interfaceLanguage":"swift","url":"doc:\/\/ECS\/documentation\/ECS\/GettingStarted"},"hierarchy":{"paths":[["doc:\/\/ECS\/documentation\/ECS"]]},"primaryContentSections":[{"kind":"content","content":[{"text":"Overview","anchor":"Overview","type":"heading","level":2},{"inlineContent":[{"type":"text","text":"In an entity component system, the things your program tracks are "},{"type":"emphasis","inlineContent":[{"type":"text","text":"entities"}]},{"type":"text","text":": plain handles that"},{"type":"text","text":" "},{"type":"text","text":"own nothing themselves. The data lives in "},{"type":"emphasis","inlineContent":[{"type":"text","text":"components"}]},{"type":"text","text":", small value types attached to entities,"},{"type":"text","text":" "},{"type":"text","text":"such as a position or a health bar. The behavior lives in "},{"type":"emphasis","inlineContent":[{"text":"systems","type":"text"}]},{"type":"text","text":", functions that run over"},{"type":"text","text":" "},{"type":"text","text":"every entity holding a particular set of components. A "},{"type":"emphasis","inlineContent":[{"type":"text","text":"world"}]},{"type":"text","text":" holds the entities and their"},{"type":"text","text":" "},{"type":"text","text":"components, and a "},{"type":"emphasis","inlineContent":[{"text":"schedule","type":"text"}]},{"type":"text","text":" runs systems on it."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"This article builds a tiny game step by step: balls that move, and that disappear when their"},{"type":"text","text":" "},{"type":"text","text":"health runs out."}],"type":"paragraph"},{"text":"Define Components","anchor":"Define-Components","type":"heading","level":3},{"inlineContent":[{"text":"A component is a value type that conforms to ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/Component"},{"text":". It needs no other","type":"text"},{"text":" ","type":"text"},{"text":"requirements; a struct with stored properties is enough. A component can also be empty, to mark","type":"text"},{"text":" ","type":"text"},{"text":"the entities that have it.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"The following components describe where an entity is, how fast it moves, and how much health it"},{"type":"text","text":" "},{"type":"text","text":"has:"}],"type":"paragraph"},{"syntax":"swift","code":["struct Position: Component { var x: Double, y: Double }","struct Velocity: Component { var dx: Double, dy: Double }","struct Health: Component { var current: Int }"],"type":"codeListing"},{"text":"Spawn Entities","anchor":"Spawn-Entities","type":"heading","level":3},{"inlineContent":[{"text":"A ","type":"text"},{"isActive":true,"identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/World","type":"reference"},{"text":" holds entities and their components. Create an empty world, then call","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"spawn(_:)"},{"text":" with the components a new entity starts with. Spawning returns an","type":"text"},{"text":" ","type":"text"},{"isActive":true,"identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/Entity","type":"reference"},{"text":", the handle you use to read and change that entity later:","type":"text"}],"type":"paragraph"},{"syntax":"swift","code":["var world = World()","let ball = world.spawn(Position(x: 0, y: 0), Velocity(dx: 1, dy: 2))","let rock = world.spawn(Position(x: 5, y: 5))","print(world.count)","\/\/ Prints \"2\"","","world[Position.self, of: ball].x = 10","print(world[Position.self, of: ball])","\/\/ Prints \"Position(x: 10.0, y: 0.0)\"","","world.insert(Health(current: 3), into: rock)","print(world.contains(Health.self, in: rock))","\/\/ Prints \"true\""],"type":"codeListing"},{"inlineContent":[{"text":"The subscript reads one component of one entity, and changes it in place when you assign through","type":"text"},{"text":" ","type":"text"},{"text":"it. Use ","type":"text"},{"code":"insert(_:into:)","type":"codeVoice"},{"text":" to add a component to an entity, ","type":"text"},{"code":"remove(_:from:)","type":"codeVoice"},{"text":" to take one away,","type":"text"},{"text":" ","type":"text"},{"text":"and ","type":"text"},{"code":"despawn(_:)","type":"codeVoice"},{"text":" to remove the entity and all of its components.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"A world is a value: assigning it to another variable makes an independent copy, and the two"},{"type":"text","text":" "},{"type":"text","text":"share their storage until one of them changes."}],"type":"paragraph"},{"name":"Important","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Like an array subscript, the subscript traps if the entity doesn’t hold the"},{"type":"text","text":" "},{"type":"text","text":"component, or has been despawned. Each such operation has a "},{"type":"codeVoice","code":"checked"},{"type":"text","text":" spelling, such as"},{"type":"text","text":" "},{"type":"codeVoice","code":"world[checked: Position.self, of: ball]"},{"type":"text","text":", that throws an error instead."}]}],"style":"important","type":"aside"},{"text":"Query and Update Many Entities","anchor":"Query-and-Update-Many-Entities","type":"heading","level":3},{"inlineContent":[{"text":"A query visits every entity holding a set of component types. Call ","type":"text"},{"type":"codeVoice","code":"query(_:)"},{"text":" with the types,","type":"text"},{"text":" ","type":"text"},{"text":"and iterate over the result; each row holds the entity followed by its components. Narrow a","type":"text"},{"text":" ","type":"text"},{"text":"query with ","type":"text"},{"type":"codeVoice","code":"with(_:)"},{"text":" and ","type":"text"},{"type":"codeVoice","code":"without(_:)"},{"text":":","type":"text"}],"type":"paragraph"},{"syntax":"swift","code":["var world = World()","world.spawn(Position(x: 0, y: 0), Velocity(dx: 1, dy: 2))","world.spawn(Position(x: 5, y: 5))","","for (_, position) in world.query(Position.self).without(Velocity.self) {","    print(position)  \/\/ Prints \"Position(x: 5.0, y: 5.0)\"","}"],"type":"codeListing"},{"inlineContent":[{"text":"To change components across many entities, use ","type":"text"},{"code":"update(_:reading:body:)","type":"codeVoice"},{"text":". It visits every","type":"text"},{"text":" ","type":"text"},{"text":"entity holding the written type and the read types, and passes the written component ","type":"text"},{"code":"inout","type":"codeVoice"},{"text":" ","type":"text"},{"text":"along with a row of the others. This is the fastest way to change many entities:","type":"text"}],"type":"paragraph"},{"syntax":"swift","code":["var world = World()","let ball = world.spawn(Position(x: 0, y: 0), Velocity(dx: 1, dy: 2))","let rock = world.spawn(Position(x: 5, y: 5))","","world.update(Position.self, reading: Velocity.self) { position, row in","    position.x += row.components.dx","    position.y += row.components.dy","}","print(world[Position.self, of: ball])","\/\/ Prints \"Position(x: 1.0, y: 2.0)\"","print(world[Position.self, of: rock])","\/\/ Prints \"Position(x: 5.0, y: 5.0)\""],"type":"codeListing"},{"inlineContent":[{"type":"text","text":"The rock has no velocity, so the update skips it."}],"type":"paragraph"},{"text":"Write Systems","anchor":"Write-Systems","type":"heading","level":3},{"inlineContent":[{"text":"A system is a rule your program applies over and over, such as moving everything that has a","type":"text"},{"text":" ","type":"text"},{"text":"velocity. Declare one with the ","type":"text"},{"type":"reference","isActive":true,"identifier":"doc:\/\/Systems\/documentation\/Systems\/System()"},{"text":" macro on a type with a ","type":"text"},{"type":"codeVoice","code":"run"},{"text":" method. The","type":"text"},{"text":" ","type":"text"},{"text":"types of the method’s parameters say what the system reads and writes:","type":"text"},{"text":" ","type":"text"},{"type":"reference","isActive":true,"identifier":"doc:\/\/Systems\/documentation\/Systems\/Update"},{"text":" writes components, ","type":"text"},{"type":"reference","isActive":true,"identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/Query"},{"text":" reads them, and an ","type":"text"},{"type":"codeVoice","code":"inout"},{"text":" ","type":"text"},{"type":"reference","isActive":true,"identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/Commands"},{"text":" records spawns and despawns to apply once the system, and the systems","type":"text"},{"text":" ","type":"text"},{"text":"running alongside it, finish.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"The following systems move each entity by its velocity, and despawn each entity whose health has","type":"text"},{"text":" ","type":"text"},{"text":"run out:","type":"text"}],"type":"paragraph"},{"syntax":"swift","code":["@System","struct Movement {","    func run(_ movers: Update<Position>.Over<Velocity>) {","        movers { position, row in","            position.x += row.components.dx","            position.y += row.components.dy","        }","    }","}","","@System","struct Reaper {","    func run(_ living: Query<Health>, commands: inout Commands) {","        for (entity, health) in living where health.current <= 0 {","            commands.despawn(entity)","        }","    }","}"],"type":"codeListing"},{"inlineContent":[{"text":"Because a system states what it touches, a schedule knows which systems can run at the same","type":"text"},{"text":" ","type":"text"},{"text":"time. Two parameters that name the same component, one of them writing it, such as two updates","type":"text"},{"text":" ","type":"text"},{"text":"of ","type":"text"},{"code":"Position","type":"codeVoice"},{"text":", are a compile-time error.","type":"text"}],"type":"paragraph"},{"text":"Run a Schedule","anchor":"Run-a-Schedule","type":"heading","level":3},{"inlineContent":[{"type":"text","text":"A "},{"type":"reference","identifier":"doc:\/\/Systems\/documentation\/Systems\/Schedule","isActive":true},{"type":"text","text":" runs systems in the order you write them. Call"},{"type":"text","text":" "},{"type":"reference","identifier":"doc:\/\/Systems\/documentation\/Systems\/Schedule\/run(on:)","isActive":true},{"type":"text","text":" to run every system once on a world:"}],"type":"paragraph"},{"syntax":"swift","code":["var world = World()","let ball = world.spawn(Position(x: 0, y: 0), Velocity(dx: 1, dy: 2), Health(current: 3))","let ghost = world.spawn(Position(x: 0, y: 0), Health(current: 0))","","let frame = Schedule {","    Movement()","    Reaper()","}","frame.run(on: &world)","","print(world[Position.self, of: ball])","\/\/ Prints \"Position(x: 1.0, y: 2.0)\"","print(world.contains(ghost))","\/\/ Prints \"false\""],"type":"codeListing"},{"inlineContent":[{"type":"text","text":"Systems that don’t conflict, like these two, run at the same time. Neither reads what the other"},{"type":"text","text":" "},{"type":"text","text":"writes, so the result doesn’t depend on which runs first, and the commands they record apply once"},{"type":"text","text":" "},{"type":"text","text":"both finish. To order systems differently, add"},{"type":"text","text":" "},{"type":"text","text":"a constraint such as "},{"type":"codeVoice","code":"Reaper().after(Movement.self)"},{"type":"text","text":", and to skip a system unless a condition"},{"type":"text","text":" "},{"type":"text","text":"holds, add "},{"type":"codeVoice","code":"runIf(_:)"},{"type":"text","text":"."}],"type":"paragraph"},{"text":"Run a Simulation","anchor":"Run-a-Simulation","type":"heading","level":3},{"inlineContent":[{"type":"text","text":"A game or simulation runs its systems every frame. A "},{"identifier":"doc:\/\/SimulationModule\/documentation\/SimulationModule\/Simulation","type":"reference","isActive":true},{"type":"text","text":" owns a world"},{"type":"text","text":" "},{"type":"text","text":"and schedules named by label, and you call "},{"identifier":"doc:\/\/SimulationModule\/documentation\/SimulationModule\/Simulation\/update(elapsed:)","type":"reference","isActive":true},{"type":"text","text":" once a"},{"type":"text","text":" "},{"type":"text","text":"frame with the time that passed. Systems added to the"},{"type":"text","text":" "},{"identifier":"doc:\/\/SimulationModule\/documentation\/SimulationModule\/ScheduleLabel\/fixedUpdate","type":"reference","isActive":true},{"type":"text","text":" label run once for every fixed timestep of that"},{"type":"text","text":" "},{"type":"text","text":"time, so they advance at the same rate however long each frame takes:"}],"type":"paragraph"},{"syntax":"swift","code":["var world = World()","let ball = world.spawn(Position(x: 0, y: 0), Velocity(dx: 1, dy: 2), Health(current: 3))","","var simulation = Simulation(world, fixedTimestep: .milliseconds(10))","simulation.add(to: .fixedUpdate) { Movement() }","simulation.add(to: .update) { Reaper() }","","simulation.update(elapsed: .milliseconds(30))","print(simulation.world[Position.self, of: ball])","\/\/ Prints \"Position(x: 3.0, y: 6.0)\""],"type":"codeListing"},{"inlineContent":[{"text":"The 30-millisecond frame covers three timesteps, so ","type":"text"},{"code":"Movement","type":"codeVoice"},{"text":" runs three times. Because it","type":"text"},{"text":" ","type":"text"},{"text":"moves each entity by its velocity once a run, the velocity here is a distance per timestep. A","type":"text"},{"text":" ","type":"text"},{"text":"system that needs the length of a step reads the ","type":"text"},{"type":"reference","identifier":"doc:\/\/SimulationModule\/documentation\/SimulationModule\/FixedTime","isActive":true},{"text":" resource, and one","type":"text"},{"text":" ","type":"text"},{"text":"that needs the length of a frame reads ","type":"text"},{"type":"reference","identifier":"doc:\/\/SimulationModule\/documentation\/SimulationModule\/Time","isActive":true},{"text":".","type":"text"}],"type":"paragraph"},{"text":"Next Steps","anchor":"Next-Steps","type":"heading","level":3},{"items":[{"content":[{"inlineContent":[{"type":"text","text":"Learn about the world in depth, including bundles, relations, hierarchies, events and change"},{"type":"text","text":" "},{"type":"text","text":"detection, in "},{"identifier":"doc:\/\/WorldModule\/documentation\/WorldModule","type":"reference","isActive":true},{"type":"text","text":"."}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Learn about system parameters, ordering and system sets in "},{"identifier":"doc:\/\/Systems\/documentation\/Systems","isActive":true,"type":"reference"},{"type":"text","text":"."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"Learn about states and the order of a frame in ","type":"text"},{"isActive":true,"identifier":"doc:\/\/SimulationModule\/documentation\/SimulationModule","type":"reference"},{"text":".","type":"text"}]}]}],"type":"unorderedList"}]}],"metadata":{"title":"Getting Started with ECS","role":"article","roleHeading":"Article","modules":[{"name":"ECS"}]},"references":{"doc://SimulationModule/documentation/SimulationModule/ScheduleLabel/fixedUpdate":{"title":"fixedUpdate","identifier":"doc:\/\/SimulationModule\/documentation\/SimulationModule\/ScheduleLabel\/fixedUpdate","type":"topic","role":"symbol","fragments":[{"kind":"keyword","text":"static"},{"kind":"text","text":" "},{"kind":"keyword","text":"let"},{"kind":"text","text":" "},{"kind":"identifier","text":"fixedUpdate"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"ScheduleLabel","preciseIdentifier":"s:16SimulationModule13ScheduleLabelV"}],"url":"\/documentation\/simulationmodule\/schedulelabel\/fixedupdate","abstract":[{"type":"text","text":"The label of the schedule that runs once for each fixed timestep of elapsed time."}],"kind":"symbol"},"doc://Systems/documentation/Systems/System()":{"role":"symbol","title":"System()","abstract":[{"type":"text","text":"Makes a type a system whose access comes from the parameters of its "},{"type":"codeVoice","code":"run"},{"type":"text","text":" method."}],"type":"topic","kind":"symbol","fragments":[{"text":"macro","kind":"keyword"},{"text":" ","kind":"text"},{"text":"System","kind":"identifier"},{"text":"()","kind":"text"}],"identifier":"doc:\/\/Systems\/documentation\/Systems\/System()","url":"\/documentation\/systems\/system()"},"doc://WorldModule/documentation/WorldModule/Query":{"title":"Query","identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/Query","type":"topic","role":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"Query"}],"url":"\/documentation\/worldmodule\/query","abstract":[{"type":"text","text":"A description of the entities to visit and the components to read from each."}],"navigatorTitle":[{"kind":"identifier","text":"Query"}],"kind":"symbol"},"doc://SimulationModule/documentation/SimulationModule/Simulation":{"role":"symbol","title":"Simulation","abstract":[{"type":"text","text":"A world and its schedules by label, advanced one frame at a time."}],"type":"topic","kind":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"Simulation"}],"identifier":"doc:\/\/SimulationModule\/documentation\/SimulationModule\/Simulation","navigatorTitle":[{"kind":"identifier","text":"Simulation"}],"url":"\/documentation\/simulationmodule\/simulation"},"doc://Systems/documentation/Systems/Update":{"role":"symbol","title":"Update","abstract":[{"type":"text","text":"A system parameter that changes a component of every entity that holds it."}],"type":"topic","kind":"symbol","fragments":[{"text":"class","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Update","kind":"identifier"}],"identifier":"doc:\/\/Systems\/documentation\/Systems\/Update","navigatorTitle":[{"text":"Update","kind":"identifier"}],"url":"\/documentation\/systems\/update"},"doc://Systems/documentation/Systems":{"title":"Systems","url":"\/documentation\/systems","identifier":"doc:\/\/Systems\/documentation\/Systems","kind":"symbol","type":"topic","abstract":[{"type":"text","text":"Declare the rules of a simulation as systems, and run them on a world in a schedule."}],"role":"collection"},"doc://Systems/documentation/Systems/Schedule/run(on:)":{"fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"run"},{"kind":"text","text":"("},{"kind":"externalParam","text":"on"},{"kind":"text","text":": "},{"kind":"keyword","text":"inout"},{"kind":"text","text":" "},{"preciseIdentifier":"s:11WorldModule0A0V","kind":"typeIdentifier","text":"World"},{"kind":"text","text":")"}],"title":"run(on:)","url":"\/documentation\/systems\/schedule\/run(on:)","identifier":"doc:\/\/Systems\/documentation\/Systems\/Schedule\/run(on:)","kind":"symbol","type":"topic","abstract":[{"type":"text","text":"Runs each system once on a world, running systems that don’t depend on each other at the"},{"type":"text","text":" "},{"type":"text","text":"same time."}],"role":"symbol"},"doc://SimulationModule/documentation/SimulationModule/Simulation/update(elapsed:)":{"title":"update(elapsed:)","identifier":"doc:\/\/SimulationModule\/documentation\/SimulationModule\/Simulation\/update(elapsed:)","type":"topic","role":"symbol","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"update"},{"kind":"text","text":"("},{"kind":"externalParam","text":"elapsed"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:s8DurationV","text":"Duration"},{"kind":"text","text":")"}],"url":"\/documentation\/simulationmodule\/simulation\/update(elapsed:)","abstract":[{"text":"Advances the simulation by one frame.","type":"text"}],"kind":"symbol"},"doc://WorldModule/documentation/WorldModule/Entity":{"role":"symbol","title":"Entity","abstract":[{"type":"text","text":"A handle that identifies one entity in a world."}],"type":"topic","kind":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Entity","kind":"identifier"}],"identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/Entity","navigatorTitle":[{"text":"Entity","kind":"identifier"}],"url":"\/documentation\/worldmodule\/entity"},"doc://WorldModule/documentation/WorldModule/Component":{"fragments":[{"kind":"keyword","text":"protocol"},{"kind":"text","text":" "},{"kind":"identifier","text":"Component"}],"title":"Component","navigatorTitle":[{"kind":"identifier","text":"Component"}],"url":"\/documentation\/worldmodule\/component","kind":"symbol","identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/Component","type":"topic","abstract":[{"type":"text","text":"A type that can be stored as a component of an entity."}],"role":"symbol"},"doc://SimulationModule/documentation/SimulationModule/Time":{"title":"Time","identifier":"doc:\/\/SimulationModule\/documentation\/SimulationModule\/Time","type":"topic","role":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Time","kind":"identifier"}],"url":"\/documentation\/simulationmodule\/time","abstract":[{"text":"A resource holding the time a simulation has advanced.","type":"text"}],"navigatorTitle":[{"text":"Time","kind":"identifier"}],"kind":"symbol"},"doc://SimulationModule/documentation/SimulationModule":{"title":"SimulationModule","url":"\/documentation\/simulationmodule","identifier":"doc:\/\/SimulationModule\/documentation\/SimulationModule","kind":"symbol","type":"topic","abstract":[{"type":"text","text":"Run a world frame by frame, with schedules for startup, a fixed timestep and each frame, and"},{"type":"text","text":" "},{"type":"text","text":"with states that switch systems on and off."}],"role":"collection"},"doc://WorldModule/documentation/WorldModule/Commands":{"fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"Commands"}],"title":"Commands","navigatorTitle":[{"kind":"identifier","text":"Commands"}],"url":"\/documentation\/worldmodule\/commands","kind":"symbol","identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/Commands","type":"topic","abstract":[{"type":"text","text":"A buffer of changes to a world, recorded now and applied later in the order they were"},{"type":"text","text":" "},{"type":"text","text":"recorded."}],"role":"symbol"},"doc://WorldModule/documentation/WorldModule":{"role":"collection","title":"WorldModule","abstract":[{"text":"Store the state of a game or simulation as entities and components, and read and change it with","type":"text"},{"text":" ","type":"text"},{"text":"queries, updates, and commands.","type":"text"}],"type":"topic","kind":"symbol","identifier":"doc:\/\/WorldModule\/documentation\/WorldModule","url":"\/documentation\/worldmodule"},"doc://ECS/documentation/ECS":{"role":"collection","title":"ECS","abstract":[{"text":"Build games and simulations from entities, the components they hold, and systems that update","type":"text"},{"text":" ","type":"text"},{"text":"them in a declared order.","type":"text"}],"type":"topic","kind":"symbol","identifier":"doc:\/\/ECS\/documentation\/ECS","url":"\/documentation\/ecs"},"doc://WorldModule/documentation/WorldModule/World":{"role":"symbol","title":"World","abstract":[{"type":"text","text":"A collection of entities, the components they hold, and resources."}],"type":"topic","kind":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"World","kind":"identifier"}],"identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/World","navigatorTitle":[{"text":"World","kind":"identifier"}],"url":"\/documentation\/worldmodule\/world"},"doc://SimulationModule/documentation/SimulationModule/FixedTime":{"title":"FixedTime","identifier":"doc:\/\/SimulationModule\/documentation\/SimulationModule\/FixedTime","type":"topic","role":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"FixedTime"}],"url":"\/documentation\/simulationmodule\/fixedtime","abstract":[{"type":"text","text":"A resource holding the fixed timestep of a simulation."}],"navigatorTitle":[{"kind":"identifier","text":"FixedTime"}],"kind":"symbol"},"doc://Systems/documentation/Systems/Schedule":{"title":"Schedule","identifier":"doc:\/\/Systems\/documentation\/Systems\/Schedule","type":"topic","role":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Schedule","kind":"identifier"}],"abstract":[{"type":"text","text":"A list of systems that run on a world, in order, and at the same time where they can."}],"url":"\/documentation\/systems\/schedule","navigatorTitle":[{"text":"Schedule","kind":"identifier"}],"kind":"symbol"}}}