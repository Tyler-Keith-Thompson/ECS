{"schemaVersion":{"major":0,"patch":0,"minor":3},"metadata":{"roleHeading":"Article","role":"article","title":"Getting Started with ECS","modules":[{"name":"ECS"}]},"sections":[],"kind":"article","variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/ecs\/gettingstarted"]}],"hierarchy":{"paths":[["doc:\/\/ECS\/documentation\/ECS"]]},"abstract":[{"type":"text","text":"Define components, spawn entities, and move them with systems that run in a schedule and a"},{"type":"text","text":" "},{"type":"text","text":"simulation."}],"primaryContentSections":[{"content":[{"anchor":"Overview","level":2,"type":"heading","text":"Overview"},{"type":"paragraph","inlineContent":[{"text":"In an entity component system, the things your program tracks are ","type":"text"},{"type":"emphasis","inlineContent":[{"type":"text","text":"entities"}]},{"text":": plain handles that","type":"text"},{"text":" ","type":"text"},{"text":"own nothing themselves. The data lives in ","type":"text"},{"type":"emphasis","inlineContent":[{"type":"text","text":"components"}]},{"text":", small value types attached to entities,","type":"text"},{"text":" ","type":"text"},{"text":"such as a position or a health bar. The behavior lives in ","type":"text"},{"type":"emphasis","inlineContent":[{"type":"text","text":"systems"}]},{"text":", functions that run over","type":"text"},{"text":" ","type":"text"},{"text":"every entity holding a particular set of components. A ","type":"text"},{"type":"emphasis","inlineContent":[{"text":"world","type":"text"}]},{"text":" holds the entities and their","type":"text"},{"text":" ","type":"text"},{"text":"components, and a ","type":"text"},{"type":"emphasis","inlineContent":[{"type":"text","text":"schedule"}]},{"text":" runs systems on it.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"This article builds a tiny game step by step: balls that move, and that disappear when their","type":"text"},{"text":" ","type":"text"},{"text":"health runs out.","type":"text"}]},{"anchor":"Define-Components","level":3,"type":"heading","text":"Define Components"},{"type":"paragraph","inlineContent":[{"type":"text","text":"A component is a value type that conforms to "},{"identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/Component","type":"reference","isActive":true},{"type":"text","text":". It needs no other"},{"type":"text","text":" "},{"type":"text","text":"requirements; a struct with stored properties is enough. A component can also be empty, to mark"},{"type":"text","text":" "},{"type":"text","text":"the entities that have it."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"The following components describe where an entity is, how fast it moves, and how much health it"},{"type":"text","text":" "},{"type":"text","text":"has:"}]},{"syntax":"swift","code":["struct Position: Component { var x: Double, y: Double }","struct Velocity: Component { var dx: Double, dy: Double }","struct Health: Component { var current: Int }"],"type":"codeListing"},{"anchor":"Spawn-Entities","level":3,"type":"heading","text":"Spawn Entities"},{"type":"paragraph","inlineContent":[{"type":"text","text":"A "},{"identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/World","isActive":true,"type":"reference"},{"type":"text","text":" holds entities and their components. Create an empty world, then call"},{"type":"text","text":" "},{"code":"spawn(_:)","type":"codeVoice"},{"type":"text","text":" with the components a new entity starts with. Spawning returns an"},{"type":"text","text":" "},{"identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/Entity","isActive":true,"type":"reference"},{"type":"text","text":", the handle you use to read and change that entity later:"}]},{"syntax":"swift","code":["var world = World()","let ball = world.spawn(Position(x: 0, y: 0), Velocity(dx: 1, dy: 2))","let rock = world.spawn(Position(x: 5, y: 5))","print(world.count)","\/\/ Prints \"2\"","","world[Position.self, of: ball].x = 10","print(world[Position.self, of: ball])","\/\/ Prints \"Position(x: 10.0, y: 0.0)\"","","world.insert(Health(current: 3), into: rock)","print(world.contains(Health.self, in: rock))","\/\/ Prints \"true\""],"type":"codeListing"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The subscript reads one component of one entity, and changes it in place when you assign through"},{"type":"text","text":" "},{"type":"text","text":"it. Use "},{"code":"insert(_:into:)","type":"codeVoice"},{"type":"text","text":" to add a component to an entity, "},{"code":"remove(_:from:)","type":"codeVoice"},{"type":"text","text":" to take one away,"},{"type":"text","text":" "},{"type":"text","text":"and "},{"code":"despawn(_:)","type":"codeVoice"},{"type":"text","text":" to remove the entity and all of its components."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"A world is a value: assigning it to another variable makes an independent copy, and the two"},{"type":"text","text":" "},{"type":"text","text":"share their storage until one of them changes."}]},{"style":"important","name":"Important","type":"aside","content":[{"type":"paragraph","inlineContent":[{"text":"Like an array subscript, the subscript traps if the entity doesn’t hold the","type":"text"},{"text":" ","type":"text"},{"text":"component, or has been despawned. Each such operation has a ","type":"text"},{"code":"checked","type":"codeVoice"},{"text":" spelling, such as","type":"text"},{"text":" ","type":"text"},{"code":"world[checked: Position.self, of: ball]","type":"codeVoice"},{"text":", that throws an error instead.","type":"text"}]}]},{"anchor":"Query-and-Update-Many-Entities","level":3,"type":"heading","text":"Query and Update Many Entities"},{"type":"paragraph","inlineContent":[{"type":"text","text":"A query visits every entity holding a set of component types. Call "},{"type":"codeVoice","code":"query(_:)"},{"type":"text","text":" with the types,"},{"type":"text","text":" "},{"type":"text","text":"and iterate over the result; each row holds the entity followed by its components. Narrow a"},{"type":"text","text":" "},{"type":"text","text":"query with "},{"type":"codeVoice","code":"with(_:)"},{"type":"text","text":" and "},{"type":"codeVoice","code":"without(_:)"},{"type":"text","text":":"}]},{"syntax":"swift","code":["var world = World()","world.spawn(Position(x: 0, y: 0), Velocity(dx: 1, dy: 2))","world.spawn(Position(x: 5, y: 5))","","for (_, position) in world.query(Position.self).without(Velocity.self) {","    print(position)  \/\/ Prints \"Position(x: 5.0, y: 5.0)\"","}"],"type":"codeListing"},{"type":"paragraph","inlineContent":[{"type":"text","text":"To change components across many entities, use "},{"code":"update(_:reading:body:)","type":"codeVoice"},{"type":"text","text":". It visits every"},{"type":"text","text":" "},{"type":"text","text":"entity holding the written type and the read types, and passes the written component "},{"code":"inout","type":"codeVoice"},{"type":"text","text":" "},{"type":"text","text":"along with a row of the others. This is the fastest way to change many entities:"}]},{"syntax":"swift","code":["var world = World()","let ball = world.spawn(Position(x: 0, y: 0), Velocity(dx: 1, dy: 2))","let rock = world.spawn(Position(x: 5, y: 5))","","world.update(Position.self, reading: Velocity.self) { position, row in","    position.x += row.components.dx","    position.y += row.components.dy","}","print(world[Position.self, of: ball])","\/\/ Prints \"Position(x: 1.0, y: 2.0)\"","print(world[Position.self, of: rock])","\/\/ Prints \"Position(x: 5.0, y: 5.0)\""],"type":"codeListing"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The rock has no velocity, so the update skips it."}]},{"anchor":"Write-Systems","level":3,"type":"heading","text":"Write Systems"},{"type":"paragraph","inlineContent":[{"type":"text","text":"A system is a rule your program applies over and over, such as moving everything that has a"},{"type":"text","text":" "},{"type":"text","text":"velocity. Declare one with the "},{"type":"reference","identifier":"doc:\/\/Systems\/documentation\/Systems\/System()","isActive":true},{"type":"text","text":" macro on a type with a "},{"type":"codeVoice","code":"run"},{"type":"text","text":" method. The"},{"type":"text","text":" "},{"type":"text","text":"types of the method’s parameters say what the system reads and writes:"},{"type":"text","text":" "},{"type":"reference","identifier":"doc:\/\/Systems\/documentation\/Systems\/Update","isActive":true},{"type":"text","text":" writes components, "},{"type":"reference","identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/Query","isActive":true},{"type":"text","text":" reads them, and an "},{"type":"codeVoice","code":"inout"},{"type":"text","text":" "},{"type":"reference","identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/Commands","isActive":true},{"type":"text","text":" records spawns and despawns to apply once the system, and the systems"},{"type":"text","text":" "},{"type":"text","text":"running alongside it, finish."}]},{"type":"paragraph","inlineContent":[{"text":"The following systems move each entity by its velocity, and despawn each entity whose health has","type":"text"},{"text":" ","type":"text"},{"text":"run out:","type":"text"}]},{"syntax":"swift","code":["@System","struct Movement {","    func run(_ movers: Update<Position>.Over<Velocity>) {","        movers { position, row in","            position.x += row.components.dx","            position.y += row.components.dy","        }","    }","}","","@System","struct Reaper {","    func run(_ living: Query<Health>, commands: inout Commands) {","        for (entity, health) in living where health.current <= 0 {","            commands.despawn(entity)","        }","    }","}"],"type":"codeListing"},{"type":"paragraph","inlineContent":[{"text":"Because a system states what it touches, a schedule knows which systems can run at the same","type":"text"},{"text":" ","type":"text"},{"text":"time. Two parameters that name the same component, one of them writing it, such as two updates","type":"text"},{"text":" ","type":"text"},{"text":"of ","type":"text"},{"code":"Position","type":"codeVoice"},{"text":", are a compile-time error.","type":"text"}]},{"anchor":"Run-a-Schedule","level":3,"type":"heading","text":"Run a Schedule"},{"type":"paragraph","inlineContent":[{"text":"A ","type":"text"},{"identifier":"doc:\/\/Systems\/documentation\/Systems\/Schedule","type":"reference","isActive":true},{"text":" runs systems in the order you write them. Call","type":"text"},{"text":" ","type":"text"},{"identifier":"doc:\/\/Systems\/documentation\/Systems\/Schedule\/run(on:)","type":"reference","isActive":true},{"text":" to run every system once on a world:","type":"text"}]},{"syntax":"swift","code":["var world = World()","let ball = world.spawn(Position(x: 0, y: 0), Velocity(dx: 1, dy: 2), Health(current: 3))","let ghost = world.spawn(Position(x: 0, y: 0), Health(current: 0))","","let frame = Schedule {","    Movement()","    Reaper()","}","frame.run(on: &world)","","print(world[Position.self, of: ball])","\/\/ Prints \"Position(x: 1.0, y: 2.0)\"","print(world.contains(ghost))","\/\/ Prints \"false\""],"type":"codeListing"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Systems that don’t conflict, like these two, run at the same time. Neither reads what the other"},{"type":"text","text":" "},{"type":"text","text":"writes, so the result doesn’t depend on which runs first, and the commands they record apply once"},{"type":"text","text":" "},{"type":"text","text":"both finish. To order systems differently, add"},{"type":"text","text":" "},{"type":"text","text":"a constraint such as "},{"code":"Reaper().after(Movement.self)","type":"codeVoice"},{"type":"text","text":", and to skip a system unless a condition"},{"type":"text","text":" "},{"type":"text","text":"holds, add "},{"code":"runIf(_:)","type":"codeVoice"},{"type":"text","text":"."}]},{"anchor":"Run-a-Simulation","level":3,"type":"heading","text":"Run a Simulation"},{"type":"paragraph","inlineContent":[{"text":"A game or simulation runs its systems every frame. A ","type":"text"},{"type":"reference","identifier":"doc:\/\/SimulationModule\/documentation\/SimulationModule\/Simulation","isActive":true},{"text":" owns a world","type":"text"},{"text":" ","type":"text"},{"text":"and schedules named by label, and you call ","type":"text"},{"type":"reference","identifier":"doc:\/\/SimulationModule\/documentation\/SimulationModule\/Simulation\/update(elapsed:)","isActive":true},{"text":" once a","type":"text"},{"text":" ","type":"text"},{"text":"frame with the time that passed. Systems added to the","type":"text"},{"text":" ","type":"text"},{"type":"reference","identifier":"doc:\/\/SimulationModule\/documentation\/SimulationModule\/ScheduleLabel\/fixedUpdate","isActive":true},{"text":" label run once for every fixed timestep of that","type":"text"},{"text":" ","type":"text"},{"text":"time, so they advance at the same rate however long each frame takes:","type":"text"}]},{"syntax":"swift","code":["var world = World()","let ball = world.spawn(Position(x: 0, y: 0), Velocity(dx: 1, dy: 2), Health(current: 3))","","var simulation = Simulation(world, fixedTimestep: .milliseconds(10))","simulation.add(to: .fixedUpdate) { Movement() }","simulation.add(to: .update) { Reaper() }","","simulation.update(elapsed: .milliseconds(30))","print(simulation.world[Position.self, of: ball])","\/\/ Prints \"Position(x: 3.0, y: 6.0)\""],"type":"codeListing"},{"type":"paragraph","inlineContent":[{"text":"The 30-millisecond frame covers three timesteps, so ","type":"text"},{"type":"codeVoice","code":"Movement"},{"text":" runs three times. Because it","type":"text"},{"text":" ","type":"text"},{"text":"moves each entity by its velocity once a run, the velocity here is a distance per timestep. A","type":"text"},{"text":" ","type":"text"},{"text":"system that needs the length of a step reads the ","type":"text"},{"type":"reference","isActive":true,"identifier":"doc:\/\/SimulationModule\/documentation\/SimulationModule\/FixedTime"},{"text":" resource, and one","type":"text"},{"text":" ","type":"text"},{"text":"that needs the length of a frame reads ","type":"text"},{"type":"reference","isActive":true,"identifier":"doc:\/\/SimulationModule\/documentation\/SimulationModule\/Time"},{"text":".","type":"text"}]},{"anchor":"Next-Steps","level":3,"type":"heading","text":"Next Steps"},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"text":"Learn about the world in depth, including bundles, relations, hierarchies, events and change","type":"text"},{"text":" ","type":"text"},{"text":"detection, in ","type":"text"},{"identifier":"doc:\/\/WorldModule\/documentation\/WorldModule","type":"reference","isActive":true},{"text":".","type":"text"}]}]},{"content":[{"inlineContent":[{"type":"text","text":"Learn about system parameters, ordering and system sets in "},{"isActive":true,"type":"reference","identifier":"doc:\/\/Systems\/documentation\/Systems"},{"type":"text","text":"."}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"Learn about states and the order of a frame in ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/SimulationModule\/documentation\/SimulationModule"},{"text":".","type":"text"}]}]}],"type":"unorderedList"}],"kind":"content"}],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/ECS\/documentation\/ECS\/GettingStarted"},"references":{"doc://SimulationModule/documentation/SimulationModule":{"title":"SimulationModule","url":"\/documentation\/simulationmodule","role":"collection","type":"topic","kind":"symbol","abstract":[{"text":"Run a world frame by frame, with schedules for startup, a fixed timestep and each frame, and","type":"text"},{"text":" ","type":"text"},{"text":"with states that switch systems on and off.","type":"text"}],"identifier":"doc:\/\/SimulationModule\/documentation\/SimulationModule"},"doc://Systems/documentation/Systems/Update":{"url":"\/documentation\/systems\/update","navigatorTitle":[{"kind":"identifier","text":"Update"}],"kind":"symbol","title":"Update","abstract":[{"type":"text","text":"A system parameter that changes a component of every entity that holds it."}],"type":"topic","role":"symbol","fragments":[{"kind":"keyword","text":"class"},{"kind":"text","text":" "},{"kind":"identifier","text":"Update"}],"identifier":"doc:\/\/Systems\/documentation\/Systems\/Update"},"doc://Systems/documentation/Systems/Schedule/run(on:)":{"title":"run(on:)","url":"\/documentation\/systems\/schedule\/run(on:)","role":"symbol","type":"topic","kind":"symbol","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"run","kind":"identifier"},{"text":"(","kind":"text"},{"text":"on","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"inout","kind":"keyword"},{"text":" ","kind":"text"},{"preciseIdentifier":"s:11WorldModule0A0V","text":"World","kind":"typeIdentifier"},{"text":")","kind":"text"}],"abstract":[{"type":"text","text":"Runs each system once on a world, running systems that don’t depend on each other at the"},{"type":"text","text":" "},{"type":"text","text":"same time."}],"identifier":"doc:\/\/Systems\/documentation\/Systems\/Schedule\/run(on:)"},"doc://Systems/documentation/Systems/System()":{"url":"\/documentation\/systems\/system()","kind":"symbol","title":"System()","type":"topic","abstract":[{"text":"Makes a type a system whose access comes from the parameters of its ","type":"text"},{"code":"run","type":"codeVoice"},{"text":" method.","type":"text"}],"role":"symbol","fragments":[{"text":"macro","kind":"keyword"},{"text":" ","kind":"text"},{"text":"System","kind":"identifier"},{"text":"()","kind":"text"}],"identifier":"doc:\/\/Systems\/documentation\/Systems\/System()"},"doc://WorldModule/documentation/WorldModule/World":{"title":"World","url":"\/documentation\/worldmodule\/world","role":"symbol","type":"topic","kind":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"World","kind":"identifier"}],"abstract":[{"text":"A collection of entities, the components they hold, and resources.","type":"text"}],"navigatorTitle":[{"text":"World","kind":"identifier"}],"identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/World"},"doc://WorldModule/documentation/WorldModule/Query":{"title":"Query","url":"\/documentation\/worldmodule\/query","role":"symbol","type":"topic","kind":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Query","kind":"identifier"}],"abstract":[{"type":"text","text":"A description of the entities to visit and the components to read from each."}],"navigatorTitle":[{"text":"Query","kind":"identifier"}],"identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/Query"},"doc://WorldModule/documentation/WorldModule/Entity":{"url":"\/documentation\/worldmodule\/entity","navigatorTitle":[{"text":"Entity","kind":"identifier"}],"kind":"symbol","title":"Entity","abstract":[{"text":"A handle that identifies one entity in a world.","type":"text"}],"type":"topic","role":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Entity","kind":"identifier"}],"identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/Entity"},"doc://SimulationModule/documentation/SimulationModule/Time":{"kind":"symbol","navigatorTitle":[{"kind":"identifier","text":"Time"}],"title":"Time","identifier":"doc:\/\/SimulationModule\/documentation\/SimulationModule\/Time","url":"\/documentation\/simulationmodule\/time","role":"symbol","abstract":[{"text":"A resource holding the time a simulation has advanced.","type":"text"}],"fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"Time"}],"type":"topic"},"doc://Systems/documentation/Systems":{"title":"Systems","url":"\/documentation\/systems","role":"collection","type":"topic","kind":"symbol","abstract":[{"text":"Declare the rules of a simulation as systems, and run them on a world in a schedule.","type":"text"}],"identifier":"doc:\/\/Systems\/documentation\/Systems"},"doc://ECS/documentation/ECS":{"kind":"symbol","title":"ECS","identifier":"doc:\/\/ECS\/documentation\/ECS","url":"\/documentation\/ecs","role":"collection","abstract":[{"text":"Build games and simulations from entities, the components they hold, and systems that update","type":"text"},{"text":" ","type":"text"},{"text":"them in a declared order.","type":"text"}],"type":"topic"},"doc://SimulationModule/documentation/SimulationModule/Simulation/update(elapsed:)":{"url":"\/documentation\/simulationmodule\/simulation\/update(elapsed:)","kind":"symbol","title":"update(elapsed:)","type":"topic","abstract":[{"text":"Advances the simulation by one frame.","type":"text"}],"role":"symbol","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"update"},{"kind":"text","text":"("},{"kind":"externalParam","text":"elapsed"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"Duration","preciseIdentifier":"s:s8DurationV"},{"kind":"text","text":")"}],"identifier":"doc:\/\/SimulationModule\/documentation\/SimulationModule\/Simulation\/update(elapsed:)"},"doc://Systems/documentation/Systems/Schedule":{"kind":"symbol","navigatorTitle":[{"text":"Schedule","kind":"identifier"}],"title":"Schedule","url":"\/documentation\/systems\/schedule","identifier":"doc:\/\/Systems\/documentation\/Systems\/Schedule","role":"symbol","abstract":[{"text":"A list of systems that run on a world, in order, and at the same time where they can.","type":"text"}],"fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Schedule","kind":"identifier"}],"type":"topic"},"doc://WorldModule/documentation/WorldModule":{"title":"WorldModule","url":"\/documentation\/worldmodule","role":"collection","type":"topic","kind":"symbol","abstract":[{"type":"text","text":"Store the state of a game or simulation as entities and components, and read and change it with"},{"type":"text","text":" "},{"type":"text","text":"queries, updates, and commands."}],"identifier":"doc:\/\/WorldModule\/documentation\/WorldModule"},"doc://WorldModule/documentation/WorldModule/Component":{"kind":"symbol","navigatorTitle":[{"text":"Component","kind":"identifier"}],"url":"\/documentation\/worldmodule\/component","identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/Component","title":"Component","role":"symbol","abstract":[{"type":"text","text":"A type that can be stored as a component of an entity."}],"fragments":[{"text":"protocol","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Component","kind":"identifier"}],"type":"topic"},"doc://SimulationModule/documentation/SimulationModule/Simulation":{"title":"Simulation","url":"\/documentation\/simulationmodule\/simulation","role":"symbol","type":"topic","kind":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"Simulation"}],"abstract":[{"type":"text","text":"A world and its schedules by label, advanced one frame at a time."}],"navigatorTitle":[{"kind":"identifier","text":"Simulation"}],"identifier":"doc:\/\/SimulationModule\/documentation\/SimulationModule\/Simulation"},"doc://SimulationModule/documentation/SimulationModule/FixedTime":{"url":"\/documentation\/simulationmodule\/fixedtime","navigatorTitle":[{"kind":"identifier","text":"FixedTime"}],"kind":"symbol","title":"FixedTime","abstract":[{"text":"A resource holding the fixed timestep of a simulation.","type":"text"}],"type":"topic","role":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"FixedTime"}],"identifier":"doc:\/\/SimulationModule\/documentation\/SimulationModule\/FixedTime"},"doc://SimulationModule/documentation/SimulationModule/ScheduleLabel/fixedUpdate":{"kind":"symbol","title":"fixedUpdate","identifier":"doc:\/\/SimulationModule\/documentation\/SimulationModule\/ScheduleLabel\/fixedUpdate","url":"\/documentation\/simulationmodule\/schedulelabel\/fixedupdate","role":"symbol","abstract":[{"text":"The label of the schedule that runs once for each fixed timestep of elapsed time.","type":"text"}],"fragments":[{"text":"static","kind":"keyword"},{"text":" ","kind":"text"},{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"fixedUpdate","kind":"identifier"},{"text":": ","kind":"text"},{"text":"ScheduleLabel","preciseIdentifier":"s:16SimulationModule13ScheduleLabelV","kind":"typeIdentifier"}],"type":"topic"},"doc://WorldModule/documentation/WorldModule/Commands":{"url":"\/documentation\/worldmodule\/commands","navigatorTitle":[{"kind":"identifier","text":"Commands"}],"kind":"symbol","title":"Commands","type":"topic","abstract":[{"text":"A buffer of changes to a world, recorded now and applied later in the order they were","type":"text"},{"text":" ","type":"text"},{"text":"recorded.","type":"text"}],"role":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"Commands"}],"identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/Commands"}}}