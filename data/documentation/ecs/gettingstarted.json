{"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/ECS\/documentation\/ECS\/GettingStarted"},"metadata":{"modules":[{"name":"ECS"}],"roleHeading":"Article","title":"Getting Started with ECS","role":"article"},"hierarchy":{"paths":[["doc:\/\/ECS\/documentation\/ECS"]]},"abstract":[{"type":"text","text":"Define components, spawn entities, and move them with systems that run in a schedule and a"},{"type":"text","text":" "},{"type":"text","text":"simulation."}],"variants":[{"paths":["\/documentation\/ecs\/gettingstarted"],"traits":[{"interfaceLanguage":"swift"}]}],"sections":[],"schemaVersion":{"patch":0,"major":0,"minor":3},"kind":"article","primaryContentSections":[{"kind":"content","content":[{"level":2,"anchor":"Overview","type":"heading","text":"Overview"},{"inlineContent":[{"type":"text","text":"In an entity component system, the things your program tracks are "},{"type":"emphasis","inlineContent":[{"text":"entities","type":"text"}]},{"type":"text","text":": plain handles that"},{"type":"text","text":" "},{"type":"text","text":"own nothing themselves. The data lives in "},{"type":"emphasis","inlineContent":[{"text":"components","type":"text"}]},{"type":"text","text":", small value types attached to entities,"},{"type":"text","text":" "},{"type":"text","text":"such as a position or a health bar. The behavior lives in "},{"type":"emphasis","inlineContent":[{"text":"systems","type":"text"}]},{"type":"text","text":", functions that run over"},{"type":"text","text":" "},{"type":"text","text":"every entity holding a particular set of components. A "},{"type":"emphasis","inlineContent":[{"type":"text","text":"world"}]},{"type":"text","text":" holds the entities and their"},{"type":"text","text":" "},{"type":"text","text":"components, and a "},{"type":"emphasis","inlineContent":[{"type":"text","text":"schedule"}]},{"type":"text","text":" runs systems on it."}],"type":"paragraph"},{"inlineContent":[{"text":"This article builds a tiny game step by step: balls that move, and that disappear when their","type":"text"},{"text":" ","type":"text"},{"text":"health runs out.","type":"text"}],"type":"paragraph"},{"level":3,"anchor":"Define-Components","type":"heading","text":"Define Components"},{"inlineContent":[{"text":"A component is a value type that conforms to ","type":"text"},{"isActive":true,"identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/Component","type":"reference"},{"text":". It needs no other","type":"text"},{"text":" ","type":"text"},{"text":"requirements; a struct with stored properties is enough. A component can also be empty, to mark","type":"text"},{"text":" ","type":"text"},{"text":"the entities that have it.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"The following components describe where an entity is, how fast it moves, and how much health it","type":"text"},{"text":" ","type":"text"},{"text":"has:","type":"text"}],"type":"paragraph"},{"syntax":"swift","type":"codeListing","code":["struct Position: Component { var x: Double, y: Double }","struct Velocity: Component { var dx: Double, dy: Double }","struct Health: Component { var current: Int }"]},{"level":3,"anchor":"Spawn-Entities","type":"heading","text":"Spawn Entities"},{"inlineContent":[{"text":"A ","type":"text"},{"type":"reference","isActive":true,"identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/World"},{"text":" holds entities and their components. Create an empty world, then call","type":"text"},{"text":" ","type":"text"},{"code":"spawn(_:)","type":"codeVoice"},{"text":" with the components a new entity starts with. Spawning returns an","type":"text"},{"text":" ","type":"text"},{"type":"reference","isActive":true,"identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/Entity"},{"text":", the handle you use to read and change that entity later:","type":"text"}],"type":"paragraph"},{"syntax":"swift","type":"codeListing","code":["var world = World()","let ball = world.spawn(Position(x: 0, y: 0), Velocity(dx: 1, dy: 2))","let rock = world.spawn(Position(x: 5, y: 5))","print(world.count)","\/\/ Prints \"2\"","","world[Position.self, of: ball].x = 10","print(world[Position.self, of: ball])","\/\/ Prints \"Position(x: 10.0, y: 0.0)\"","","world.insert(Health(current: 3), into: rock)","print(world.contains(Health.self, in: rock))","\/\/ Prints \"true\""]},{"inlineContent":[{"text":"The subscript reads one component of one entity, and changes it in place when you assign through","type":"text"},{"text":" ","type":"text"},{"text":"it. Use ","type":"text"},{"type":"codeVoice","code":"insert(_:into:)"},{"text":" to add a component to an entity, ","type":"text"},{"type":"codeVoice","code":"remove(_:from:)"},{"text":" to take one away,","type":"text"},{"text":" ","type":"text"},{"text":"and ","type":"text"},{"type":"codeVoice","code":"despawn(_:)"},{"text":" to remove the entity and all of its components.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"A world is a value: assigning it to another variable makes an independent copy, and the two","type":"text"},{"text":" ","type":"text"},{"text":"share their storage until one of them changes.","type":"text"}],"type":"paragraph"},{"style":"important","type":"aside","name":"Important","content":[{"type":"paragraph","inlineContent":[{"text":"Like an array subscript, the subscript traps if the entity doesn’t hold the","type":"text"},{"text":" ","type":"text"},{"text":"component, or has been despawned. Each such operation has a ","type":"text"},{"type":"codeVoice","code":"checked"},{"text":" spelling, such as","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"world[checked: Position.self, of: ball]"},{"text":", that throws an error instead.","type":"text"}]}]},{"level":3,"anchor":"Query-and-Update-Many-Entities","type":"heading","text":"Query and Update Many Entities"},{"inlineContent":[{"type":"text","text":"A query visits every entity holding a set of component types. Call "},{"type":"codeVoice","code":"query(_:)"},{"type":"text","text":" with the types,"},{"type":"text","text":" "},{"type":"text","text":"and iterate over the result; each row holds the entity followed by its components. Narrow a"},{"type":"text","text":" "},{"type":"text","text":"query with "},{"type":"codeVoice","code":"with(_:)"},{"type":"text","text":" and "},{"type":"codeVoice","code":"without(_:)"},{"type":"text","text":":"}],"type":"paragraph"},{"syntax":"swift","type":"codeListing","code":["var world = World()","world.spawn(Position(x: 0, y: 0), Velocity(dx: 1, dy: 2))","world.spawn(Position(x: 5, y: 5))","","for (_, position) in world.query(Position.self).without(Velocity.self) {","    print(position)  \/\/ Prints \"Position(x: 5.0, y: 5.0)\"","}"]},{"inlineContent":[{"type":"text","text":"To change components across many entities, use "},{"code":"update(_:reading:body:)","type":"codeVoice"},{"type":"text","text":". It visits every"},{"type":"text","text":" "},{"type":"text","text":"entity holding the written type and the read types, and passes the written component "},{"code":"inout","type":"codeVoice"},{"type":"text","text":" "},{"type":"text","text":"along with a row of the others. This is the fastest way to change many entities:"}],"type":"paragraph"},{"syntax":"swift","type":"codeListing","code":["var world = World()","let ball = world.spawn(Position(x: 0, y: 0), Velocity(dx: 1, dy: 2))","let rock = world.spawn(Position(x: 5, y: 5))","","world.update(Position.self, reading: Velocity.self) { position, row in","    position.x += row.components.dx","    position.y += row.components.dy","}","print(world[Position.self, of: ball])","\/\/ Prints \"Position(x: 1.0, y: 2.0)\"","print(world[Position.self, of: rock])","\/\/ Prints \"Position(x: 5.0, y: 5.0)\""]},{"inlineContent":[{"type":"text","text":"The rock has no velocity, so the update skips it."}],"type":"paragraph"},{"level":3,"anchor":"Write-Systems","type":"heading","text":"Write Systems"},{"inlineContent":[{"text":"A system is a rule your program applies over and over, such as moving everything that has a","type":"text"},{"text":" ","type":"text"},{"text":"velocity. Declare one with the ","type":"text"},{"type":"reference","isActive":true,"identifier":"doc:\/\/Systems\/documentation\/Systems\/System()"},{"text":" macro on a type with a ","type":"text"},{"type":"codeVoice","code":"run"},{"text":" method. The","type":"text"},{"text":" ","type":"text"},{"text":"types of the method’s parameters say what the system reads and writes:","type":"text"},{"text":" ","type":"text"},{"type":"reference","isActive":true,"identifier":"doc:\/\/Systems\/documentation\/Systems\/Update"},{"text":" writes components, ","type":"text"},{"type":"reference","isActive":true,"identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/Query"},{"text":" reads them, and an ","type":"text"},{"type":"codeVoice","code":"inout"},{"text":" ","type":"text"},{"type":"reference","isActive":true,"identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/Commands"},{"text":" records spawns and despawns to apply once the system, and the systems","type":"text"},{"text":" ","type":"text"},{"text":"running alongside it, finish.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"The following systems move each entity by its velocity, and despawn each entity whose health has"},{"type":"text","text":" "},{"type":"text","text":"run out:"}],"type":"paragraph"},{"syntax":"swift","type":"codeListing","code":["@System","struct Movement {","    func run(_ movers: Update<Position>.Over<Velocity>) {","        movers { position, row in","            position.x += row.components.dx","            position.y += row.components.dy","        }","    }","}","","@System","struct Reaper {","    func run(_ living: Query<Health>, commands: inout Commands) {","        for (entity, health) in living where health.current <= 0 {","            commands.despawn(entity)","        }","    }","}"]},{"inlineContent":[{"text":"Because a system states what it touches, a schedule knows which systems can run at the same","type":"text"},{"text":" ","type":"text"},{"text":"time. Two parameters that name the same component, one of them writing it, such as two updates","type":"text"},{"text":" ","type":"text"},{"text":"of ","type":"text"},{"type":"codeVoice","code":"Position"},{"text":", are a compile-time error.","type":"text"}],"type":"paragraph"},{"level":3,"anchor":"Run-a-Schedule","type":"heading","text":"Run a Schedule"},{"inlineContent":[{"type":"text","text":"A "},{"type":"reference","identifier":"doc:\/\/Systems\/documentation\/Systems\/Schedule","isActive":true},{"type":"text","text":" runs systems in the order you write them. Call"},{"type":"text","text":" "},{"type":"reference","identifier":"doc:\/\/Systems\/documentation\/Systems\/Schedule\/run(on:)","isActive":true},{"type":"text","text":" to run every system once on a world:"}],"type":"paragraph"},{"syntax":"swift","type":"codeListing","code":["var world = World()","let ball = world.spawn(Position(x: 0, y: 0), Velocity(dx: 1, dy: 2), Health(current: 3))","let ghost = world.spawn(Position(x: 0, y: 0), Health(current: 0))","","let frame = Schedule {","    Movement()","    Reaper()","}","frame.run(on: &world)","","print(world[Position.self, of: ball])","\/\/ Prints \"Position(x: 1.0, y: 2.0)\"","print(world.contains(ghost))","\/\/ Prints \"false\""]},{"inlineContent":[{"text":"Systems that don’t conflict, like these two, run at the same time. Neither reads what the other","type":"text"},{"text":" ","type":"text"},{"text":"writes, so the result doesn’t depend on which runs first, and the commands they record apply once","type":"text"},{"text":" ","type":"text"},{"text":"both finish. To order systems differently, add","type":"text"},{"text":" ","type":"text"},{"text":"a constraint such as ","type":"text"},{"code":"Reaper().after(Movement.self)","type":"codeVoice"},{"text":", and to skip a system unless a condition","type":"text"},{"text":" ","type":"text"},{"text":"holds, add ","type":"text"},{"code":"runIf(_:)","type":"codeVoice"},{"text":".","type":"text"}],"type":"paragraph"},{"level":3,"anchor":"Run-a-Simulation","type":"heading","text":"Run a Simulation"},{"inlineContent":[{"text":"A game or simulation runs its systems every frame. A ","type":"text"},{"identifier":"doc:\/\/SimulationModule\/documentation\/SimulationModule\/Simulation","isActive":true,"type":"reference"},{"text":" owns a world","type":"text"},{"text":" ","type":"text"},{"text":"and schedules named by label, and you call ","type":"text"},{"identifier":"doc:\/\/SimulationModule\/documentation\/SimulationModule\/Simulation\/update(elapsed:)","isActive":true,"type":"reference"},{"text":" once a","type":"text"},{"text":" ","type":"text"},{"text":"frame with the time that passed. Systems added to the","type":"text"},{"text":" ","type":"text"},{"identifier":"doc:\/\/SimulationModule\/documentation\/SimulationModule\/ScheduleLabel\/fixedUpdate","isActive":true,"type":"reference"},{"text":" label run once for every fixed timestep of that","type":"text"},{"text":" ","type":"text"},{"text":"time, so they advance at the same rate however long each frame takes:","type":"text"}],"type":"paragraph"},{"syntax":"swift","type":"codeListing","code":["var world = World()","let ball = world.spawn(Position(x: 0, y: 0), Velocity(dx: 1, dy: 2), Health(current: 3))","","var simulation = Simulation(world, fixedTimestep: .milliseconds(10))","simulation.add(to: .fixedUpdate) { Movement() }","simulation.add(to: .update) { Reaper() }","","simulation.update(elapsed: .milliseconds(30))","print(simulation.world[Position.self, of: ball])","\/\/ Prints \"Position(x: 3.0, y: 6.0)\""]},{"inlineContent":[{"type":"text","text":"The 30-millisecond frame covers three timesteps, so "},{"type":"codeVoice","code":"Movement"},{"type":"text","text":" runs three times. Because it"},{"type":"text","text":" "},{"type":"text","text":"moves each entity by its velocity once a run, the velocity here is a distance per timestep. A"},{"type":"text","text":" "},{"type":"text","text":"system that needs the length of a step reads the "},{"type":"reference","identifier":"doc:\/\/SimulationModule\/documentation\/SimulationModule\/FixedTime","isActive":true},{"type":"text","text":" resource, and one"},{"type":"text","text":" "},{"type":"text","text":"that needs the length of a frame reads "},{"type":"reference","identifier":"doc:\/\/SimulationModule\/documentation\/SimulationModule\/Time","isActive":true},{"type":"text","text":"."}],"type":"paragraph"},{"level":3,"anchor":"Next-Steps","type":"heading","text":"Next Steps"},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Learn about the world in depth, including bundles, relations, hierarchies, events and change"},{"type":"text","text":" "},{"type":"text","text":"detection, in "},{"type":"reference","isActive":true,"identifier":"doc:\/\/WorldModule\/documentation\/WorldModule"},{"type":"text","text":"."}]}]},{"content":[{"inlineContent":[{"text":"Learn about system parameters, ordering and system sets in ","type":"text"},{"identifier":"doc:\/\/Systems\/documentation\/Systems","isActive":true,"type":"reference"},{"text":".","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"Learn about states and the order of a frame in "},{"isActive":true,"type":"reference","identifier":"doc:\/\/SimulationModule\/documentation\/SimulationModule"},{"type":"text","text":"."}],"type":"paragraph"}]}],"type":"unorderedList"}]}],"references":{"doc://SimulationModule/documentation/SimulationModule/FixedTime":{"title":"FixedTime","identifier":"doc:\/\/SimulationModule\/documentation\/SimulationModule\/FixedTime","abstract":[{"type":"text","text":"A resource holding the fixed timestep of a simulation."}],"kind":"symbol","url":"\/documentation\/simulationmodule\/fixedtime","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"FixedTime"}],"navigatorTitle":[{"kind":"identifier","text":"FixedTime"}],"type":"topic","role":"symbol"},"doc://WorldModule/documentation/WorldModule/World":{"identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/World","title":"World","url":"\/documentation\/worldmodule\/world","abstract":[{"text":"A collection of entities, the components they hold, and resources.","type":"text"}],"fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"World","kind":"identifier"}],"navigatorTitle":[{"text":"World","kind":"identifier"}],"kind":"symbol","role":"symbol","type":"topic"},"doc://WorldModule/documentation/WorldModule/Entity":{"title":"Entity","identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/Entity","abstract":[{"type":"text","text":"A handle that identifies one entity in a world."}],"url":"\/documentation\/worldmodule\/entity","kind":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Entity","kind":"identifier"}],"navigatorTitle":[{"text":"Entity","kind":"identifier"}],"type":"topic","role":"symbol"},"doc://SimulationModule/documentation/SimulationModule":{"title":"SimulationModule","identifier":"doc:\/\/SimulationModule\/documentation\/SimulationModule","abstract":[{"text":"Run a world frame by frame, with schedules for startup, a fixed timestep and each frame, and","type":"text"},{"text":" ","type":"text"},{"text":"with states that switch systems on and off.","type":"text"}],"url":"\/documentation\/simulationmodule","kind":"symbol","role":"collection","type":"topic"},"doc://ECS/documentation/ECS":{"identifier":"doc:\/\/ECS\/documentation\/ECS","url":"\/documentation\/ecs","type":"topic","role":"collection","abstract":[{"type":"text","text":"Build games and simulations from entities, the components they hold, and systems that update"},{"type":"text","text":" "},{"type":"text","text":"them in a declared order."}],"title":"ECS","kind":"symbol"},"doc://SimulationModule/documentation/SimulationModule/Simulation/update(elapsed:)":{"title":"update(elapsed:)","identifier":"doc:\/\/SimulationModule\/documentation\/SimulationModule\/Simulation\/update(elapsed:)","url":"\/documentation\/simulationmodule\/simulation\/update(elapsed:)","abstract":[{"text":"Advances the simulation by one frame.","type":"text"}],"fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"update","kind":"identifier"},{"text":"(","kind":"text"},{"text":"elapsed","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"Duration","preciseIdentifier":"s:s8DurationV","kind":"typeIdentifier"},{"text":")","kind":"text"}],"kind":"symbol","role":"symbol","type":"topic"},"doc://SimulationModule/documentation/SimulationModule/Time":{"title":"Time","identifier":"doc:\/\/SimulationModule\/documentation\/SimulationModule\/Time","abstract":[{"type":"text","text":"A resource holding the time a simulation has advanced."}],"kind":"symbol","url":"\/documentation\/simulationmodule\/time","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Time","kind":"identifier"}],"navigatorTitle":[{"text":"Time","kind":"identifier"}],"type":"topic","role":"symbol"},"doc://Systems/documentation/Systems/Update":{"identifier":"doc:\/\/Systems\/documentation\/Systems\/Update","title":"Update","url":"\/documentation\/systems\/update","abstract":[{"type":"text","text":"A system parameter that changes a component of every entity that holds it."}],"fragments":[{"text":"class","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Update","kind":"identifier"}],"navigatorTitle":[{"text":"Update","kind":"identifier"}],"kind":"symbol","role":"symbol","type":"topic"},"doc://SimulationModule/documentation/SimulationModule/Simulation":{"type":"topic","identifier":"doc:\/\/SimulationModule\/documentation\/SimulationModule\/Simulation","url":"\/documentation\/simulationmodule\/simulation","abstract":[{"text":"A world and its schedules by label, advanced one frame at a time.","type":"text"}],"fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Simulation","kind":"identifier"}],"navigatorTitle":[{"text":"Simulation","kind":"identifier"}],"kind":"symbol","role":"symbol","title":"Simulation"},"doc://Systems/documentation/Systems/Schedule":{"identifier":"doc:\/\/Systems\/documentation\/Systems\/Schedule","url":"\/documentation\/systems\/schedule","type":"topic","role":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Schedule","kind":"identifier"}],"abstract":[{"text":"A list of systems that run on a world, in order, and at the same time where they can.","type":"text"}],"title":"Schedule","kind":"symbol","navigatorTitle":[{"text":"Schedule","kind":"identifier"}]},"doc://Systems/documentation/Systems/System()":{"identifier":"doc:\/\/Systems\/documentation\/Systems\/System()","url":"\/documentation\/systems\/system()","type":"topic","role":"symbol","fragments":[{"text":"macro","kind":"keyword"},{"text":" ","kind":"text"},{"text":"System","kind":"identifier"},{"text":"()","kind":"text"}],"abstract":[{"text":"Makes a type a system whose access comes from the parameters of its ","type":"text"},{"type":"codeVoice","code":"run"},{"text":" method.","type":"text"}],"kind":"symbol","title":"System()"},"doc://WorldModule/documentation/WorldModule":{"identifier":"doc:\/\/WorldModule\/documentation\/WorldModule","url":"\/documentation\/worldmodule","type":"topic","role":"collection","abstract":[{"text":"Store the state of a game or simulation as entities and components, and read and change it with","type":"text"},{"text":" ","type":"text"},{"text":"queries, updates, and commands.","type":"text"}],"kind":"symbol","title":"WorldModule"},"doc://WorldModule/documentation/WorldModule/Query":{"title":"Query","identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/Query","url":"\/documentation\/worldmodule\/query","abstract":[{"type":"text","text":"A description of the entities to visit and the components to read from each."}],"kind":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"Query"}],"navigatorTitle":[{"kind":"identifier","text":"Query"}],"type":"topic","role":"symbol"},"doc://WorldModule/documentation/WorldModule/Commands":{"identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/Commands","url":"\/documentation\/worldmodule\/commands","type":"topic","role":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Commands","kind":"identifier"}],"abstract":[{"text":"A buffer of changes to a world, recorded now and applied later in the order they were","type":"text"},{"text":" ","type":"text"},{"text":"recorded.","type":"text"}],"kind":"symbol","title":"Commands","navigatorTitle":[{"text":"Commands","kind":"identifier"}]},"doc://Systems/documentation/Systems/Schedule/run(on:)":{"title":"run(on:)","identifier":"doc:\/\/Systems\/documentation\/Systems\/Schedule\/run(on:)","abstract":[{"type":"text","text":"Runs each system once on a world, running systems that don’t depend on each other at the"},{"type":"text","text":" "},{"type":"text","text":"same time."}],"url":"\/documentation\/systems\/schedule\/run(on:)","kind":"symbol","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"run"},{"kind":"text","text":"("},{"kind":"externalParam","text":"on"},{"kind":"text","text":": "},{"kind":"keyword","text":"inout"},{"kind":"text","text":" "},{"preciseIdentifier":"s:11WorldModule0A0V","kind":"typeIdentifier","text":"World"},{"kind":"text","text":")"}],"type":"topic","role":"symbol"},"doc://Systems/documentation/Systems":{"identifier":"doc:\/\/Systems\/documentation\/Systems","type":"topic","url":"\/documentation\/systems","abstract":[{"type":"text","text":"Declare the rules of a simulation as systems, and run them on a world in a schedule."}],"kind":"symbol","role":"collection","title":"Systems"},"doc://WorldModule/documentation/WorldModule/Component":{"identifier":"doc:\/\/WorldModule\/documentation\/WorldModule\/Component","url":"\/documentation\/worldmodule\/component","type":"topic","role":"symbol","fragments":[{"text":"protocol","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Component","kind":"identifier"}],"abstract":[{"text":"A type that can be stored as a component of an entity.","type":"text"}],"kind":"symbol","title":"Component","navigatorTitle":[{"text":"Component","kind":"identifier"}]},"doc://SimulationModule/documentation/SimulationModule/ScheduleLabel/fixedUpdate":{"title":"fixedUpdate","identifier":"doc:\/\/SimulationModule\/documentation\/SimulationModule\/ScheduleLabel\/fixedUpdate","url":"\/documentation\/simulationmodule\/schedulelabel\/fixedupdate","kind":"symbol","abstract":[{"type":"text","text":"The label of the schedule that runs once for each fixed timestep of elapsed time."}],"fragments":[{"text":"static","kind":"keyword"},{"text":" ","kind":"text"},{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"fixedUpdate","kind":"identifier"},{"text":": ","kind":"text"},{"text":"ScheduleLabel","kind":"typeIdentifier","preciseIdentifier":"s:16SimulationModule13ScheduleLabelV"}],"type":"topic","role":"symbol"}}}